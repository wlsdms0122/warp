(test 1)
(name "a-constant-read-at-an-index-holds-its-slot-under-the-frames-constants")
(note "A constant read at an index the run reads holds slot 1 from the body's start, written under the frame's `constants` as the value it folded to, so the `return` is the body's first instruction.")

(program
  (warp 1)
  (const K (array 1 2))
  (procedure entry
    (access public)
    (parameter i (type Int))
    (returns Int)
    (body
      (return (path K (index i))))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false) (array 1 (array (array 3 0 false (array))) false))) (entry "claims" (array)) (entry "constants" (array "K")) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"ac780d467a4231d4c28a1064c039f00fc363e6682acc7f8e4e57ac05681fe9ba")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 1) (array 13 0 (array 0)))) (entry "rows" (array (array "entry" (array (array (array "i" (array 0))) 1 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array) 1)) (array 2 (array 0) (array) (array (array 2 1)) (array) (array "i" "K")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 1) (array 2 2) (array 6 (array 0 1)))) (entry "variables" (array)))))
