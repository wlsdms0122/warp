(test 1)
(name "a-module-variable-whose-start-cannot-fold-refuses")
(note "Whatever stops a variable's start folding refuses at the build, whether or not anything reads it. `c` is a module variable whose start divides by zero, and nothing reads it.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (var c (type Double) (call Standard.Numeric.dividedBy 1 0))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
