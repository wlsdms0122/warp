(test 1)
(name "a-constant-folding-from-a-procedure-the-host-brought-refuses")
(note "A constant folds at the build and what it folds to is written into the compiled document, so it folds from what every implementation returns the same way: a body in the link, and the procedures this specification names. `App.seat` returns what the host's code returns, and the compiled document says nothing about which code that was, so folding through it would write a value nothing can be read against.")

(vocabulary
  (procedure App.seat
    (const)
    (isolated)
    (returns Int)
    (answers 7)))

(program
  (warp 1)
  (import App.seat)
  (const seat (call App.seat))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return seat))))
(expect (refuses build))
