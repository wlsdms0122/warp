(test 1)
(name "a-constant-folding-through-a-body-that-calls-a-host-procedure-refuses")
(note "A fold refuses where it calls a procedure the host brought, whether the constant's own expression calls it or a body the fold runs does. `K.seated` is a body in another document, and it calls the host's `App.seat` on every run.")

(documents
  (document
    (warp 1)
    (import App.seat)
    (procedure K.seated
      (const)
      (isolated)
      (returns Int)
      (body
        (return (call App.seat))))))

(vocabulary
  (procedure App.seat
    (const)
    (isolated)
    (returns Int)
    (answers 7)))

(program
  (warp 1)
  (import K.seated)
  (const seat (call K.seated))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return seat))))
(expect (refuses build))
