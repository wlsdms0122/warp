(test 1)
(name "a-value-calls-callee-is-evaluated-before-its-arguments")
(note "A call of a value evaluates its callee and then its arguments. Here the callee and the argument each fail, and the catch sees the callee's failure.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure App.make
    (const)
    (returns (procedure (parameters String) (returns String)))
    (failing aborted)
    (body
      (return (call Standard.Control.abort "callee"))))
  (procedure entry
    (access public)
    (returns (optional String))
    (body
      (var seen)
      (let caught
        (try
          (body
            (let made (apply (call App.make) (call Standard.Control.abort "argument"))))
          (catch
            (set seen (path caught (field message))))))
      (return seen))))
(expect (answers "callee"))
