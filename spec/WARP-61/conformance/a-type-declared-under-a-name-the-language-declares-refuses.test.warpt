(test 1)
(name "a-type-declared-under-a-name-the-language-declares-refuses")
(note "The language declares `Hashable`, `Failure`, `Round` and `Some` itself, ahead of every document, so a document declaring a type under one of them is refused where it is read.")

(program
  (warp 1)
  (struct Round
    (field index Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
