(test 1)
(name "absolute-drops-the-sign-of-negative-zero")
(note "`absolute` drops the sign, and a negative zero carries one that text spells. Arithmetic reaches a negative zero without any literal writing it.")

(program
  (warp 1)
  (import Standard.Math.absolute)
  (import Standard.Numeric.times)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let zero (call Standard.Numeric.times -1.0 0.0))
      (return (call Standard.Text.text (call Standard.Math.absolute zero))))))
(expect (answers "0.0"))
