(test 1)
(name "rounded-just-below-a-half-goes-down")
(note "rounded goes to the nearest integer and away from zero only at the exact halfway. 0.49999999999999994 is below the half and rounds to 0, where floored of the number plus 0.5 gives 1; 0.5 and -0.5 are halfway and go away from zero.")

(program
  (warp 1)
  (import Standard.Math.rounded)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (array (call Standard.Math.rounded 0.49999999999999994) (call Standard.Math.rounded 0.5) (call Standard.Math.rounded -0.5))))))
(expect (answers (array 0 1 -1)))
