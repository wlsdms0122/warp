warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-onto-a-shape-the-types-prove-is-refused"
  note "A cast opens a shape the types do not prove. Where they already do, the claim says nothing. Refused at the build, the way a needless `?.` is."
  program {
    imports []
    procedures {
      entry {
        parameters {
          count {
            type "int"
          }
        }
        result {
          as "int"
          of {
            ref "count"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}
