warpt 1
{
  expect {
    refuses "build"
  }
  name "a-slot-of-a-type-takes-no-value-read-as-a-contract-refuses"
  note "A value read as a contract is of whichever type answers it, and the build does not know which, so a slot of a type takes it only through a cast. `Int` answers `App.Marked`, and handing a value read as `App.Marked` where `Int` is declared still refuses at the build."
  program {
    contracts {
      "App.Marked" {}
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "Int"
          }
        ]
        result 1
        returns "Int"
      }
      "App.g" {
        parameters [
          {
            name "x"
            type "App.Marked"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
            ]
            procedure "App.f"
          }
        }
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "App.g"
          }
        }
        returns "Int"
      }
    }
    satisfies {
      Int [
        "App.Marked"
      ]
    }
    warp 1
  }
  test 1
}

