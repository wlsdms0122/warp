warpt 1
{
  expect {
    refuses "build"
  }
  name "an-asking-cast-onto-a-linear-type-refuses"
  note "A reading that may answer nothing does not take a linear value, since null would be a way through with nothing to hand on. `as?` onto such a type is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "Any"
          }
        ]
        result {
          "as?" {
            of {
              ref "item"
            }
            type "App.Handle"
          }
        }
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

