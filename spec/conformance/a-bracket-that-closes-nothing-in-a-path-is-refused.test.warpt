warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bracket-that-closes-nothing-in-a-path-is-refused"
  note "A `]` in a path closes a `[` written before it. One that closes nothing is no part of a name, so `a]` is refused though `a` is declared."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "a"
            value 1
          }
        ]
        result {
          ref "a]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

