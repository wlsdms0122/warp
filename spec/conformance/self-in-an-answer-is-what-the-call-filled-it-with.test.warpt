(test 1)
(name "self-in-an-answer-is-what-the-call-filled-it-with")
(note "A contract's answer written `Self` is read as what the call filled `Self` with, as any type parameter's is. Handed a whole number, the call answers a whole number, and a name declared `Int` takes it at the build.")

(program
  (warp 1)
  (contract App.Copyable
    (procedure copy
      (parameter of (type Self))
      (returns Self)))
  (extension
    (head Int)
    (satisfies App.Copyable)
    (procedure copy
      (parameter of (type Int))
      (returns Int)
      (result of)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let n (type Int) (call App.Copyable.copy 5)))
    (result n)))
(expect (answers 5))
