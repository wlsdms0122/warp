warpt 1
{
  expect {
    refuses "link"
  }
  name "a-constant-outside-a-range-refuses-at-the-link"
  note "A range is judged wherever an argument is settled against the parameter — for a constant argument, at the link. The declared type says which whole numbers fit, and 300 is provably not among them."
  program {
    imports []
    procedures {
      entry {
        result {
          call {
            arguments {
              level 300
            }
            procedure "paint"
          }
        }
      }
      paint {
        parameters {
          level "int(0...255)"
        }
        result {
          ref "level"
        }
      }
    }
    warp 2
  }
  test 1
}
