warpt 1
{
  expect {
    refuses "run"
  }
  name "a-generic-answer-of-any-is-judged-where-the-call-reads-it-refuses"
  note "app.gen answers some T, and its body answers a variable declared any that holds an int. The call fills T with string, so the answer is judged as text where the call reads it."
  program {
    imports [
      "std.text.uppercased"
    ]
    procedures {
      "app.gen" {
        body [
          {
            type "any"
            value 5
            var "y"
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  "s"
                ]
                procedure "app.gen"
              }
            }
          }
          {
            let "u"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "std.text.uppercased"
              }
            }
          }
        ]
        result {
          ref "u"
        }
      }
    }
    warp 1
  }
  test 1
}

