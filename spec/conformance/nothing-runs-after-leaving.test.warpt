warpt 1
{
  expect {
    refuses "load"
  }
  name "nothing-runs-after-leaving"
  note "A statement after one that leaves never runs, so the name it was going to bind never binds."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            value {
              return "here"
            }
          }
          {
            let "unreachable"
            value "never"
          }
        ]
        returns "string"
      }
    }
    warp 2
  }
  test 1
}
