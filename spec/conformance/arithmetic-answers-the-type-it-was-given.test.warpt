(test 1)
(name "arithmetic-answers-the-type-it-was-given")
(note "A whole number added to a whole number answers a whole number, so the answer fits a slot asking for one. The two sides and the answer are one type parameter bounded by `Standard.Numeric`.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (result (call wants (call Standard.Numeric.plus 1 2))))
  (procedure wants
    (parameter it (type Int))
    (returns Int)
    (result it)))
(expect (answers 3))
