warpt 1
{
  expect {
    refuses "run"
  }
  name "a-value-applied-through-any-is-judged-at-the-run"
  note "A value the text opens to `any` carries its type with it, so an application through such a name is judged where it runs: an argument the closure's parameter refuses is refused at the run, and the body never sees it."
  program {
    imports []
    procedures {
      "app.blind" {
        parameters [
          {
            name "of"
            type "any"
          }
        ]
        receiver "of"
        result {
          ref "of"
        }
        returns "any"
      }
      entry {
        access "public"
        body [
          {
            let "double"
            value {
              closure {
                parameters [
                  {
                    name "n"
                    type "int"
                  }
                ]
                result {
                  ref "n"
                }
                returns "int"
              }
            }
          }
          {
            let "held"
            value {
              call {
                of {
                  ref "double"
                }
                procedure "app.blind"
              }
            }
          }
          {
            let "made"
            value {
              apply {
                arguments [
                  "not a number"
                ]
                procedure {
                  ref "held"
                }
              }
            }
          }
        ]
        result {
          ref "made"
        }
        returns "any"
      }
    }
    warp 1
  }
  test 1
}

