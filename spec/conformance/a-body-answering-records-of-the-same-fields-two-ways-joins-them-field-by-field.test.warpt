warpt 1
{
  expect {
    answers 1
  }
  name "a-body-answering-records-of-the-same-fields-two-ways-joins-them-field-by-field"
  note "`App.pick` writes no `returns`, and its two ways out answer records of the same fields, so they join field by field: `a` reads `Int` both ways and `b` reads `Any`, and `r.a` is held at `Int`."
  program {
    imports []
    procedures {
      "App.pick" {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return {
                        record {
                          a 1
                          b "x"
                        }
                      }
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "Bool"
          }
        ]
        result {
          record {
            a 2
            b 3
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  true
                ]
                procedure "App.pick"
              }
            }
          }
        ]
        result {
          ref "r.a"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

