(test 1)
(name "a-struct-field-holding-a-procedure-of-its-type-parameter-is-called")
(note "A field may write a procedure type naming the struct's parameter. `App.Holder<Int>` holds a procedure taking and returning `Int`, and calling what the field holds returns one.")

(program
  (warp 1)
  (struct App.Holder
    (typeParameter T)
    (field run (procedure (parameters (some T)) (returns (some T)))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let h
        (type (named App.Holder Int))
        (struct
          (field run
            (closure
              (parameter x (type Int))
              (returns Int)
              (body
                (return x))))))
      (return (apply (path h (field run)) 2)))))
(expect (answers 2))
