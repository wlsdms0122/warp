(test 1)
(name "a-claim-about-null-taking-null-where-the-contract-takes-the-optional-of-self-refuses")
(note "For a claim about `Null`, `Self?` is the Optional of `Null`, whose values `Null` does not all take, so `Null.pick` writing `Null` where the contract writes `Self?` does not back the claim, which refuses at the build, at the claim.")

(program
  (warp 1)
  (contract App.Pick
    (procedure pick
      (parameter s (type Self))
      (parameter t (type (optional Self)))
      (returns Int)))
  (extension
    (head Null)
    (satisfies App.Pick)
    (procedure pick
      (parameter s (type Null))
      (parameter t (type Null))
      (returns Int)
      (body
        (return 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.Pick.pick null null)))))
(expect (refuses build))
