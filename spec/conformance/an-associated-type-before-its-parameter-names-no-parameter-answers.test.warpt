(test 1)
(name "an-associated-type-before-its-parameter-names-no-parameter-answers")
(note "Only `some T` names `T`. `i` writes `some C.Item` before `c` writes `some C`, so the `some C` of `c` is the first naming of `C` and the bound beside it is where it is introduced.")

(program
  (warp 1)
  (contract App.Container
    (type Item))
  (procedure App.f
    (parameter i (type (some C.Item)))
    (parameter c (type (some C App.Container)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (answers 1))
