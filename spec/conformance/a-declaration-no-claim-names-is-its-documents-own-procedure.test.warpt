warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      imports []
      procedures {
        "App.ask" {
          result 1
          returns "Int"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 1
  }
  name "a-declaration-no-claim-names-is-its-documents-own-procedure"
  note "A procedure spelled like a member of a type and declared among the document's procedures is its document's procedure and nothing else. A contract asking that procedure beside it reserves nothing, and the document builds the same."
  program {
    imports []
    procedures {
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                as {
                  of {
                    struct {
                      balance 1
                    }
                  }
                  type "Bank.Account"
                }
              }
            ]
            procedure "Bank.Account.describe"
          }
        }
        returns "Int"
      }
    }
    types {
      "Bank.Account" {
        struct {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

