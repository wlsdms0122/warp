warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          describe {
            parameters [
              {
                name "of"
                type "App.Describable"
              }
            ]
            returns "String"
          }
        }
      }
      imports []
      procedures {
        "App.ask" {
          result 1
        }
      }
      warp 1
    }
  ]
  expect {
    answers 1
  }
  name "a-declaration-no-claim-names-is-its-documents-own-procedure"
  note "A declaration named for a type and a procedure that no claim names is its document's procedure and nothing else. A contract asking that procedure beside it reserves nothing, and the document builds the same."
  program {
    imports []
    procedures {
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    record {
                      balance 1
                    }
                  }
                  type "Bank.Account"
                }
              }
            ]
            procedure "Bank.Account.describe"
          }
        }
      }
    }
    types {
      "Bank.Account" {
        record {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

