(test 1)
(name "the-object-of-a-struct-built-from-parts")
(note "A struct built from parts carries its layout, the field names ascending, and one operation per field in that order. The row writes under answers what the declaration's `returns` says.")

(program
  (warp 1)
  (struct App.P
    (field a Int)
    (field b Int))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter n (type Int))
    (returns App.P)
    (body
      (let p (type App.P) (struct (field a n) (field b 2))))
    (result p)))
