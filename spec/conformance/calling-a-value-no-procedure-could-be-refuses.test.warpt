warpt 1
{
  expect {
    refuses "build"
  }
  name "calling-a-value-no-procedure-could-be-refuses"
  note "A `call` whose procedure is a value calls whatever the run holds there, and a value read as `Int` is never a procedure. Every run would refuse the call, so the build does, where it is written."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value 5
          }
        ]
        failing "anything"
        result {
          call {
            procedure {
              ref "held"
            }
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

