          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
        "Lib.Container.first"
      ]
      procedures {
        "Use.pick" {
          access "public"
          body [
            {
              let "x"
              value {
                call {
                  arguments [
                    {
                      ref "d"
                    }
                  ]
                  procedure "Lib.Container.first"
                }
              }
            }
          ]
          bounds {
            C "Lib.Container"
            D "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
            {
              name "d"
              type "some D"
            }
          ]
          result {
            ref "x"
          }
          returns "some C.Item"
          sameTypes {
            "C.Item" "some D.Item"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "two-members-said-one-type-refuse-two-types-refuses"
  note "`Use.pick` says `C.Item` is `D.Item`, and a box of Int and a box of text give two types, so the call refuses at the build."
  program {
    imports [
      "App.Box"
      "Use.pick"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "e"
            type "App.Box<String>"
            value {
              struct {
                item "x"
              }
            }
          }
          {
            let "x"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "e"
                  }
                ]
                procedure "Use.pick"
              }
            }
          }
        ]
        result {
          ref "x"
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

