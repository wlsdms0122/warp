warpt 1
{
  expect {
    refuses "load"
  }
  name "a-read-at-an-index-past-what-an-int-holds-refuses"
  note "`d[99999999999999999999]` writes digits between the brackets, which are a whole number past what an `Int` holds and no position, though a name of the same spelling is bound, so the path refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "99999999999999999999"
            value 1
          }
          {
            type "Array<Int>"
            value [
              10
              20
            ]
            var "d"
          }
        ]
        result {
          ref "d[99999999999999999999]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

