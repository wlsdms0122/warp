warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item: Hashable"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T: Hashable>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T: Hashable"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    answers 1
  }
  name "a-struct-bounding-its-parameter-gives-an-item-the-contract-bounds-answers"
  note "Box lists `T: Hashable` and claims the contract in its declaration with `Item` its `T`; the struct's own bound holds `Item` to Hashable."
  program {
    imports [
      "App.Box"
      "Lib.firstOf"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "Lib.firstOf"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

