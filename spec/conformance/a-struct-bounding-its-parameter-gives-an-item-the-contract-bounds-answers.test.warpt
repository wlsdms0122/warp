(test 1)
(name "a-struct-bounding-its-parameter-gives-an-item-the-contract-bounds-answers")
(note "Box lists `T: Hashable` and claims the contract in its declaration with `Item` its `T`; the struct's own bound holds `Item` to Hashable.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item Hashable)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T Hashable)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T Hashable))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import App.Box)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call Lib.firstOf b)))))
(expect (answers 1))
