(test 1)
(name "the-object-of-a-dispatch")
(note "A call through a contract carries the contract, the procedure, the type each of its positions reads as, its first argument apart and the rest by position, and no row: which row it dispatches to is the link's.")

(program
  (warp 1)
  (struct Bank.Card
    (satisfies App.Describable)
    (field last String)
    (procedure describe
      (const)
      (isolated)
      (parameter of (type Bank.Card))
      (returns String)
      (body
        (return "a card"))))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (parameter it (type App.Describable))
    (returns String)
    (body
      (return (call App.Describable.describe it))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let card (as (struct (field last "42")) Bank.Card))
      (return (call App.tell card)))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false) (array 0 (array) false))) (entry "claims" (array (array "Bank.Card" (array "App.Describable")))) (entry "constants" (array)) (entry "contracts" (array (array "App.Describable" (array (array) (array) (array (array "describe" (array (array (array "of" (array 1))) 2 (array 1 (array)) 0 0 (array) (array)))))))) (entry "dependencies" (array)) (entry "document" (array x"758fbc15d49d7e98fc77718bfc4c93392ba7a68d14d17b5e1cefa0fbf1352c7b")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 16 (array "App.Describable")) (array 14 0) (array 14 0) (array 16 (array "App.Describable")))) (entry "members" (array (array "Bank.Card" (array "describe")))) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 12 (array "App.Describable" "describe" (array 0) (array 1 0) (array))) (array 13 0 (array 0)) (array 0 0) (array 13 0 (array 2)) (array 0 1) (array 3 (array (array "Bank.Card" (array "last")) (array 4))) (array 6 5 1 false) (array 1 1) (array 15 7 (array 0 2 3)) (array 11 (array 0 (array (array 8)) (array) (array))) (array 13 0 (array 9)))) (entry "rows" (array (array "App.tell" (array (array (array "it" (array 3))) 4 (array 1 (array)) 0 0 (array) (array)) 1 (array 0 (array (array (array) 1 "[0]")) (array 1 (array 0) (array) (array) (array "it")))) (array "Bank.Card.describe" (array (array (array "of" (array 5))) 6 (array 1 (array)) 1 1 (array) (array)) 1 (array 0 (array (array (array) 3 "[0]")) (array 1 (array 0) (array) (array) (array "of")))) (array "entry" (array (array) 7 (array 1 (array "cast_refused")) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 6 "card") (array (array) 10 "[1]")) (array 1 (array) (array) (array) (array "card")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array "Bank.Card")) (entry "typeTable" (array (array 6) (array 18) (array 6) (array 14 "App.Describable") (array 6) (array 14 "Bank.Card") (array 6) (array 6))) (entry "types" (array (array "Bank.Card" (array 9 (array (array "last" 0)))))) (entry "valueTable" (array (array 4 "a card") (array 4 "42"))) (entry "variables" (array)))))
