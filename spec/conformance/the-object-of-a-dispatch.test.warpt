  name "the-object-of-a-dispatch"
  note "A call through a contract carries the contract, the procedure, its first argument apart and the rest by position, and no row: which row answers is the link's. The claim the body leans on stands under leaned with the place it was written."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        parameters [
          {
            name "it"
            type "App.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "string"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
