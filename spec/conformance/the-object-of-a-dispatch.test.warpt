  name "the-object-of-a-dispatch"
  note "A call through a contract carries the contract, the procedure, the receiver and its arguments, and no row: which row answers is the link's. The claim the body leans on stands under leaned with the place it was written."
  program {
    contracts {
      "app.Describable" {
        describe {
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.tell" {
        parameters {
          it {
            type "app.Describable"
          }
        }
        receiver "it"
        result {
          call {
            of {
              ref "it"
            }
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
      "bank.Card.describe" {
        parameters {
          of {
            type "bank.Card"
          }
        }
        receiver "of"
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
