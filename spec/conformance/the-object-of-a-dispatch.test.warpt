(test 1)
(name "the-object-of-a-dispatch")
(note "A call through a contract carries the contract, the procedure, its first argument apart and the rest by position, and no row: which row answers is the link's.")

(program
  (warp 1)
  (struct Bank.Card
    (satisfies App.Describable)
    (field last String)
    (procedure describe
      (const)
      (isolated)
      (parameter of (type Bank.Card))
      (returns String)
      (body
        (return "a card"))))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (parameter it (type App.Describable))
    (returns String)
    (body
      (return (call App.Describable.describe it))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let card (as (struct (field last "42")) Bank.Card))
      (return (call App.tell card)))))
