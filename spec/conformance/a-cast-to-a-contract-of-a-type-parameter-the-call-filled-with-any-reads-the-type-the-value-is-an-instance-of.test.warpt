(test 1)
(name "a-cast-to-a-contract-of-a-type-parameter-the-call-filled-with-any-reads-the-type-the-value-is-an-instance-of")
(note "`App.show` is called with `a`, read as `Any` and holding `5`, so its `T` is `Any`. The cast of `x` to `App.Described` is of a reading of `Any` as the call filled it, so it holds the type the value is an instance of, `Int`, and the call through the contract reaches `Int`'s `describe`.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a number"))))
  (extension
    (head (optional Int))
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (optional Int)))
      (returns String)
      (body
        (return "a number or none"))))
  (procedure App.show
    (parameter x (type (some T)))
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.Described.describe (as x App.Described)))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let a (type Any) 5)
      (return (call App.show a)))))
(expect (answers "a number"))
