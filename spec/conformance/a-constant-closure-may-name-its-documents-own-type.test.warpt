warpt 1
{
  expect {
    answers 1
  }
  name "a-constant-closure-may-name-its-documents-own-type"
  note "A closure a constant holds is a procedure of the document that declared the constant, so its body reads the types that document declares, here a cast to one, the way a body written in a declaration does."
  program {
    const {
      k {
        closure {
          body [
            {
              let "c"
              value {
                as {
                  of {
                    struct {
                      x 1
                    }
                  }
                  type "App.Box"
                }
              }
            }
          ]
          failing [
            "cast_refused"
          ]
          result {
            ref "c.x"
          }
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "a"
            value {
              call {
                procedure {
                  ref "k"
                }
              }
            }
          }
        ]
        failing "anything"
        result {
          ref "a"
        }
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

