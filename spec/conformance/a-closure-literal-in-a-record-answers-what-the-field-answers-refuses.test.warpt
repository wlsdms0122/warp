warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-literal-in-a-record-answers-what-the-field-answers-refuses"
  note "`c` declares a record whose `f` is `{ procedure: { returns: App.Point } }`, and the closure literal written as that field writes no `returns`, so it answers what the field answers. Its body answers `{ x: 1, y: 2 }`, which is no `App.Point`, so it refuses at the build as the same closure written at a name declaring that type does."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "App.Holder"
            value {
              record {
                f {
                  closure {
                    result {
                      record {
                        x 1
                        y 2
                      }
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c.f"
            }
          }
        }
      }
    }
    types {
      "App.Holder" {
        record {
          f {
            procedure {
              returns "App.Point"
            }
          }
        }
      }
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

