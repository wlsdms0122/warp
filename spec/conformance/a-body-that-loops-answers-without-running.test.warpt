(test 1)
(name "a-body-that-loops-answers-without-running")
(note "A construct reaches nothing on its own. The closure handed to `asking` declares `const`, and a loop is read as far as its round is, so a body that loops and returns from the round holds to `const` and stands in the `const` slot.")

(program
  (warp 1)
  (procedure asking
    (const)
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body)))
    (result answered))
  (procedure entry
    (access public)
    (const)
    (returns String)
    (body
      (let given
        (closure
          (const)
          (isolated)
          (returns String)
          (body
            (loop
              (while true)
              (body
                (return "counted"))))
          (result "never reached"))))
    (result (call asking given))))
(expect (answers "counted"))
