warpt 1
{
  expect {
    answers true
  }
  name "a-string-holding-another-is-a-text-question"
  note "A string is not an array here, so whether it holds another string is asked of the text bundle. The answer reads characters, not positions."
  program {
    imports [
      "Standard.Text.contains"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                arguments [
                  "hello, spec"
                  "lo, sp"
                ]
                procedure "Standard.Text.contains"
              }
            }
          }
        ]
        result {
          ref "held"
        }
      }
    }
    warp 1
  }
  test 1
}

