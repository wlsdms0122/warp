(test 1)
(name "a-declaration-answering-a-contract-may-answer-a-type-answering-it-where-it-promises-it-or-null")
(note "The contract answers App.Sized? and the declaration answering it answers Bank.Card, which a document says answers App.Sized.")

(program
  (warp 1)
  (struct Bank.Box
    (satisfies App.Shown)
    (field n Int)
    (procedure show
      (parameter of (type Bank.Box))
      (parameter n (type App.Sized))
      (returns Bank.Card)
      (failing cast_refused)
      (body
        (let k (as (struct (field last "9")) Bank.Card)))
      (result k)))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (result 4)))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Shown
    (procedure show
      (parameter of (type Self))
      (parameter n (type App.Sized))
      (returns (nullable App.Sized))
      (failing cast_refused)))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let b (as (struct (field n 1)) Bank.Box))
      (let c (as (struct (field last "4")) Bank.Card))
      (let s (call App.Shown.show b c)))
    (result "ok")))
(expect (answers "ok"))
