warpt 1
{
  expect {
    answers "ok"
  }
  name "a-declaration-answering-a-contract-may-answer-a-type-answering-it-where-it-promises-it-or-null"
  note "The contract answers App.Sized? and the declaration answering it answers Bank.Card, which a document says answers App.Sized."
  program {
    contracts {
      "App.Shown" {
        show {
          failing [
            "cast_refused"
          ]
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "App.Sized"
            }
          ]
          returns "App.Sized?"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Box.show" {
        body [
          {
            let "k"
            value {
              as {
                of {
                  struct {
                    last "9"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "Bank.Box"
          }
          {
            name "n"
            type "App.Sized"
          }
        ]
        result {
          ref "k"
        }
        returns "Bank.Card"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  struct {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result "ok"
      }
    }
    satisfies {
      "Bank.Box" [
        "App.Shown"
      ]
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        struct {
          n "Int"
        }
      }
      "Bank.Card" {
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

