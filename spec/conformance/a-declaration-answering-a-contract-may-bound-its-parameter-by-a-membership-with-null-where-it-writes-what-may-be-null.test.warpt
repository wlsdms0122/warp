warpt 1
{
  expect {
    answers 1
  }
  name "a-declaration-answering-a-contract-may-bound-its-parameter-by-a-membership-with-null-where-it-writes-what-may-be-null"
  note "The contract takes int? at x, and the declaration answering it takes some V there, bounded by App.MaybeNum, which admits int and null."
  program {
    constraints {
      "App.MaybeNum" [
        "Int"
        "Null"
      ]
    }
    contracts {
      "App.Use" {
        use {
          parameters [
            {
              name "of"
              type "App.Use"
            }
            {
              name "x"
              type "Int?"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.use" {
        bounds {
          V "App.MaybeNum"
        }
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "x"
            type "some V"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  null
                ]
                procedure "App.Use.use"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Use"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

