warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-naming-a-linear-type-does-not-go-into-a-list"
  note "Where nothing inside a cast holds a value written `linear`, the type the cast names is what says the value is one, and such a value written into a list refuses like any other."
  program {
    imports [
      "app.Handle"
    ]
    procedures {
      entry {
        access "public"
        result [
          {
            as {
              of {
                record {
                  name "f"
                }
              }
              type "app.Handle"
            }
          }
        ]
        returns "any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

