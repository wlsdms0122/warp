(test 1)
(name "a-call-fills-a-type-parameter-through-a-struct-applied-to-it-answers")
(note "`App.unwrap` takes `App.Box<some T>` and answers `some T`. A call walks into what the struct is applied to as into a list's element, so handing an `App.Box<String>` fills `T` with `String`.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure App.unwrap
    (parameter b (type (named App.Box (some T))))
    (returns (some T))
    (result (path b (field item))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box String)) (struct (field item "x"))))
    (result (call App.unwrap b))))
(expect (answers "x"))
