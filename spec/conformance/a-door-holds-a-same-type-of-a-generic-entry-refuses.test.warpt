warpt 1
{
  arguments {
    c App.Box {
      item "a"
    }
  }
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      extensions {
        "App.Box<some T: Hashable>" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          types {
            Item "some T"
          }
        }
      }
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
        }
        "App.Plain" {
          struct {
            x "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "run"
  }
  name "a-door-holds-a-same-type-of-a-generic-entry-refuses"
  note "The entry says `C.Item` is Int and adds 1 to it. A box of text arrives at the door: the type the box gives at `Item` is String, not Int, so the door refuses."
  program {
    imports [
      "Int.plus"
      "Lib.Container"
      "Lib.Container.first"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "Lib.Container.first"
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "some C: Lib.Container"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
              1
            ]
            procedure "Int.plus"
          }
        }
        returns "Int"
        sameTypes {
          "C.Item" "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

