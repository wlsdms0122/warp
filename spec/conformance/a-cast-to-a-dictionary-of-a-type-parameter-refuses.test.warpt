warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-to-a-dictionary-of-a-type-parameter-refuses"
  note "app.g reads a value of any as dictionary<some T>. A type parameter inside a cast's type names no type to settle what arrives against, so the build refuses the cast."
  program {
    imports []
    procedures {
      "app.g" {
        body [
          {
            let "a"
            type "any"
            value {
              record {
                k "s"
              }
            }
          }
          {
            let "y"
            value {
              as {
                of {
                  ref "a"
                }
                type "dictionary<some T>"
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "dictionary<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

