(test 1)
(name "a-cast-to-a-dictionary-of-a-type-parameter-refuses")
(note "App.g reads a value of Any as Dictionary<String, some T>. A type parameter inside a cast's type names no type to judge what arrives against, so the cast refuses at the load.")

(program
  (warp 1)
  (procedure App.g
    (parameter n (type (some T)))
    (returns (dictionary String (some T)))
    (body
      (let a (type Any) (struct (field k "s")))
      (let y (as a (dictionary String (some T))))
      (return y)))
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (body
      (let r (call App.g 1))
      (return r))))
(expect (refuses load))
