warpt 1
{
  expect {
    answers 3
  }
  name "arithmetic-answers-the-kind-it-was-given"
  note "A whole number added to a whole number answers a whole number, so the answer fits a slot asking for one. The two sides and the answer are one type parameter bounded by `std.Numeric`."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    1
                    2
                  ]
                  procedure "std.math.plus"
                }
              }
            ]
            procedure "wants"
          }
        }
        returns "int"
      }
      wants {
        parameters [
          {
            name "it"
            type "int"
          }
        ]
        result {
          ref "it"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

