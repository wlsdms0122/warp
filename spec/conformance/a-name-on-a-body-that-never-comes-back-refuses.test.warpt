warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-on-a-body-that-never-comes-back-refuses"
  note "`app.giveUp` writes no `returns`, and its body answers by calling `std.control.abort`, so what a call of it answers is read off a body that never finishes. A name on that call promises a binding that cannot happen, and the build refuses it."
  program {
    imports [
      "std.control.abort"
    ]
    procedures {
      "app.giveUp" {
        result {
          call {
            arguments [
              "done"
            ]
            procedure "std.control.abort"
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "gone"
            value {
              call {
                procedure "app.giveUp"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

