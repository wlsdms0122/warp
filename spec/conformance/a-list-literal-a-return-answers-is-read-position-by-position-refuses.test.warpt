warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-return-answers-is-read-position-by-position-refuses"
  note "App.g declares it answers Array<Dictionary<String, Array<String>>>, and one way through returns a list of two map literals, one holding `[]` under `a` and one holding `[1]`. A return writes into the declared answer as the result does, so the build refuses it."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      "App.g" {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return [
                        {
                          dictionary [
                            [
                              "a"
                              []
                            ]
                          ]
                        }
                        {
                          dictionary [
                            [
                              "a"
                              [
                                1
                              ]
                            ]
                          ]
                        }
                      ]
                    }
                  }
                ]
                when {
                  ref "x"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "Bool"
          }
        ]
        result [
          {
            dictionary [
              [
                "a"
                []
              ]
            ]
          }
          {
            dictionary [
              [
                "a"
                [
                  "s"
                ]
              ]
            ]
          }
        ]
        returns "Array<Dictionary<String, Array<String>>>"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  true
                ]
                procedure "App.g"
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

