warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-return-answers-is-read-position-by-position-refuses"
  note "App.g declares it answers Array<Dictionary<Array<String>>>, and one way through returns [{ a: [] }, { a: [1] }]. A return writes into the declared answer as the result does, so the build refuses it."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      "App.g" {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return [
                        {
                          record {
                            a []
                          }
                        }
                        {
                          record {
                            a [
                              1
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
                when {
                  ref "x"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "Bool"
          }
        ]
        result [
          {
            record {
              a []
            }
          }
          {
            record {
              a [
                "s"
              ]
            }
          }
        ]
        returns "Array<Dictionary<Array<String>>>"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  true
                ]
                procedure "App.g"
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

