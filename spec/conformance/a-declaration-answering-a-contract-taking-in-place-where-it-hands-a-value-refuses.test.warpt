warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-taking-in-place-where-it-hands-a-value-refuses"
  note "The contract takes an int as a value and the declaration answering it takes inout int there. A call through the contract hands a value, which has no box for the declaration to write, so the claim holds nothing and the call refuses."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
            {
              name "n"
              type "Int"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.size" {
        body [
          {
            set "n"
            value 9
          }
        ]
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "n"
            type "inout Int"
          }
        ]
        result 7
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "k"
            value 4
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  {
                    ref "k"
                  }
                ]
                procedure "App.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

