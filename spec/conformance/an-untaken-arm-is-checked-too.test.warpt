warpt 1
{
  arguments {
    ready true
  }
  expect {
    refuses "load"
  }
  name "an-untaken-arm-is-checked-too"
  note "A program that arrived from elsewhere has branches nobody ran before sending it, and the one that matters is often the one that only fires in production. An interpreter that reports a defect on the path taken is sampling, not checking."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            value {
              conditional {
                else [
                  {
                    let "missed"
                    value {
                      ref "nobodyEverBoundThis"
                    }
                  }
                ]
                then [
                  {
                    let "taken"
                    value "taken"
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters {
          ready "bool"
        }
      }
    }
    warp 1
  }
  test 2
}
