warpt 1
{
  arguments {
    ready true
  }
  expect {
    refuses "load"
  }
  name "an-untaken-arm-is-checked-too"
  note "A program is checked whole before any of it runs, so a defect in an arm no run takes is refused all the same."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              conditional {
                else [
                  {
                    let "missed"
                    value {
                      ref "nobodyEverBoundThis"
                    }
                  }
                ]
                then [
                  {
                    let "taken"
                    value "taken"
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "ready"
            type "Bool"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

