(test 1)
(name "an-untaken-arm-is-checked-too")
(note "A program is checked whole before any of it runs, so a defect in an arm no run takes is refused all the same.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (body
      (conditional
        (when ready)
        (then
          (let taken "taken"))
        (else
          (let missed nobodyEverBoundThis))))))
(arguments (argument ready true))
(expect (refuses load))
