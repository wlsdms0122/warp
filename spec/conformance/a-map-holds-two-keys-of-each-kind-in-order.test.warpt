(test 1)
(name "a-map-holds-two-keys-of-each-kind-in-order")
(note "Within a kind, keys ascend part by part: false before true, numbers by worth, text by its bytes, a list element by element, a map entry by entry and each entry by its key before its value, a struct by its name and then field by field, each field by its name before its value, and of two that share a start the shorter first. So `{1: 9}` comes before `{2: 0}` and before `{1: 9, 2: 0}`, and a struct with field `a` before one with field `b`, whatever the values say.")
(bytes x"574152500107110003000103020203040302030603040308050161030a050162030c06010302030e0602030203040310060103040312070003140701030203120316070203020312030403000318070103040300031a0903412e500101610312031c0903412e500101620300031e0903412e51000320")
(expect (spells (dictionary (entry null 0) (entry false 1) (entry true 2) (entry 1 3) (entry 2 4) (entry "a" 5) (entry "b" 6) (entry (array 1) 7) (entry (array 1 2) 8) (entry (array 2) 9) (entry (dictionary) 10) (entry (dictionary (entry 1 9)) 11) (entry (dictionary (entry 1 9) (entry 2 0)) 12) (entry (dictionary (entry 2 0)) 13) (entry (struct A.P (field a 9)) 14) (entry (struct A.P (field b 0)) 15) (entry (struct A.Q) 16))))
