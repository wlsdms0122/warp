warpt 1
{
  expect {
    answers 2
  }
  name "a-struct-field-holding-a-procedure-of-its-type-parameter-is-called-answers"
  note "A field may write a procedure type naming the struct's parameter. `App.Holder<Int>` holds a procedure taking and answering `Int`, and calling what the field holds answers one."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            type "App.Holder<Int>"
            value {
              struct {
                run {
                  closure {
                    parameters [
                      {
                        name "x"
                        type "Int"
                      }
                    ]
                    result {
                      ref "x"
                    }
                    returns "Int"
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              2
            ]
            procedure {
              ref "h.run"
            }
          }
        }
        returns "Int"
      }
    }
    types {
      "App.Holder" {
        struct {
          run {
            procedure {
              parameters [
                "some T"
              ]
              returns "some T"
            }
          }
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

