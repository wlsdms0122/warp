warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-answering-anything-that-passed-a-record-slot-and-an-any-slot-reads-null-answers"
  note "The closure writes `returns any`, is held at `procedure() -> bank.A`, then at `procedure() -> any`, and travels through `any`. The `any` slot takes the closure's `bank.A` answer without saying it, so the closure keeps `bank.A`, and `bank.B` never takes a `bank.A`: the asking cast to `procedure() -> bank.B` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
                returns "any"
              }
            }
          }
          {
            let "x"
            type {
              procedure {
                returns "any"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "a"
            type "any"
            value {
              ref "x"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    returns "bank.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
      "bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

