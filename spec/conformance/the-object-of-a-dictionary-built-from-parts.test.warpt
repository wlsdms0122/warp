(test 1)
(name "the-object-of-a-dictionary-built-from-parts")
(note "A dictionary literal holding a part the run computes is built from parts, operation 14: its entries as written, each a key's operation and a value's.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter n (type Int))
    (returns (dictionary String Int))
    (body
      (return (dictionary (entry "b" n) (entry "a" 1))))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"f03085ab12b413aaee84155b9a242488efc23c17d6784285a37c786a3181a8d5")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 0 1) (array 0 2) (array 14 (array (array 0 1) (array 2 3))) (array 13 0 (array 4)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 0))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 5 "[0]")) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 6) (array 4) (array 8 1 2))) (entry "types" (array)) (entry "valueTable" (array (array 4 "b") (array 4 "a") (array 2 1))) (entry "variables" (array)))))
