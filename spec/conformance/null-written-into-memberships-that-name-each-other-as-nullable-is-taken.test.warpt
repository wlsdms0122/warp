warpt 1
{
  expect {
    answers 0
  }
  name "null-written-into-memberships-that-name-each-other-as-nullable-is-taken"
  note "`App.M` admits `int` and `App.N`, and `App.N` admits `string` and `App.M?`. A variable declared `App.M` starts with a name read as null. Asking `App.N` of it reaches `App.M?`, which takes null as every `T?` does, without asking `App.M` of it again, so the value is one of `App.N` and so of `App.M`, and the run answers 0."
  program {
    constraints {
      "App.M" [
        "int"
        "App.N"
      ]
      "App.N" [
        "string"
        "App.M?"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "n"
            value null
          }
          {
            type "App.M"
            value {
              ref "n"
            }
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

