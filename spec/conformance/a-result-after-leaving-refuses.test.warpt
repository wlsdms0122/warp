(test 1)
(name "a-result-after-leaving-refuses")
(note "A body's result is read after its statements, so a result after a `return` would never be read. The leave is text, so the document alone says so.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1)
      (return 2))))
(expect (refuses load))
