(test 1)
(name "a-taken-variable-a-loop-writes-is-read-after-it-as-written")
(note "A loop's round writes an int into a variable that started null and lets a closure capture it. After the loop the variable reads Int?, which an answer declared Null does not take.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (import Standard.Comparable.lessThan)
  (procedure entry
    (access public)
    (body
      (var x)
      (var i 0)
      (var fs (array))
      (let w
        (loop
          (while (call Standard.Comparable.lessThan i 1))
          (body
            (set x 1)
            (call Standard.Collection.append fs
              (closure
                (returns Int)
                (result x)))
            (set i 1)))))
    (result x)))
(expect (refuses build))
