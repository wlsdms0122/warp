warpt 1
{
  expect {
    answers 5
  }
  name "a-declaration-answering-a-contract-may-write-another-name-for-the-struct-the-contract-names"
  note "The contract's procedure takes an `App.Point` second, and the declaration answering it for `App.Box` writes `App.Spot`, which names `App.Point`. A name that stands for a declared struct names that struct's type, so the two signatures agree and the claim holds."
  program {
    contracts {
      "App.Placing" {
        procedures {
          place {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "at"
                type "App.Point"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "box"
            value {
              as {
                of {
                  struct {
                    v 1
                  }
                }
                type "App.Box"
              }
            }
          }
          {
            let "point"
            value {
              as {
                of {
                  struct {
                    x 5
                  }
                }
                type "App.Point"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                ref "box"
              }
              {
                ref "point"
              }
            ]
            procedure "App.Placing.place"
          }
        }
        returns "Int"
      }
    }
    types {
      "App.Box" {
        procedures {
          place {
            parameters [
              {
                name "of"
                type "App.Box"
              }
              {
                name "at"
                type "App.Spot"
              }
            ]
            result {
              ref "at.x"
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Placing"
        ]
        struct {
          v "Int"
        }
      }
      "App.Point" {
        struct {
          x "Int"
        }
      }
      "App.Spot" "App.Point"
    }
    warp 1
  }
  test 1
}

