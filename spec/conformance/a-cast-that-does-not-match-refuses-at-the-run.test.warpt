warpt 1
{
  arguments {
    payload "not a whole number"
  }
  expect {
    refuses "run"
  }
  name "a-cast-that-does-not-match-refuses-at-the-run"
  note "A cast is a claim about what will arrive, and the run is where what arrived is known. A value that is not the named type refuses there. A failure like any other, so an `attempt` catches it."
  program {
    imports []
    procedures {
      entry {
        parameters {
          payload {
            type "any"
          }
        }
        result {
          as "int"
          of {
            ref "payload"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}
