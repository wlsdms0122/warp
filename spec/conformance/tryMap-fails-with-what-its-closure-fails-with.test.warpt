warpt 1
{
  expect {
    answers "aborted"
  }
  name "tryMap-fails-with-what-its-closure-fails-with"
  note "`Standard.Collection.tryMap` takes a procedure that may fail and touches nothing, so it may fail with anything and is `isolated`: an isolated body hands it a closure that aborts on the third element, and the rescue reads the failure."
  program {
    imports [
      "Standard.Collection.tryMap"
      "Standard.Comparable.lessThan"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "failed"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          [
                            1
                            2
                            3
                          ]
                          {
                            closure {
                              body [
                                {
                                  value {
                                    conditional {
                                      then [
                                        {
                                          value {
                                            call {
                                              arguments [
                                                "too big"
                                              ]
                                              procedure "Standard.Control.abort"
                                            }
                                          }
                                        }
                                      ]
                                      when {
                                        call {
                                          arguments [
                                            2
                                            {
                                              ref "x"
                                            }
                                          ]
                                          procedure "Standard.Comparable.lessThan"
                                        }
                                      }
                                    }
                                  }
                                }
                              ]
                              const true
                              failing [
                                "aborted"
                              ]
                              isolated true
                              parameters [
                                {
                                  name "x"
                                  type "Int"
                                }
                              ]
                              result {
                                ref "x"
                              }
                              returns "Int"
                            }
                          }
                        ]
                        procedure "Standard.Collection.tryMap"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "failed.type"
                  }
                }
              }
            }
          }
        ]
        const true
        isolated true
        result {
          ref "failed"
        }
        returns "String?"
      }
    }
    warp 1
  }
  test 1
}

