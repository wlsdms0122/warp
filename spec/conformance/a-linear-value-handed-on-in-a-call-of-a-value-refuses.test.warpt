warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-value-handed-on-in-a-call-of-a-value-refuses"
  note "Which procedure a call of a value reaches is the run's answer, so handing a value written `linear` to one is not something the text says happens once. The build refuses the call."
  program {
    imports [
      "app.Handle"
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            let "drop"
            value {
              closure {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "x"
                          }
                        ]
                        procedure "app.close"
                      }
                    }
                  }
                ]
                parameters [
                  {
                    name "x"
                    type "consuming app.Handle"
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure {
                  ref "drop"
                }
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.look" {
        answers 1
        parameters [
          {
            name "first"
            type "borrowing app.Handle"
          }
        ]
        returns "int"
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

