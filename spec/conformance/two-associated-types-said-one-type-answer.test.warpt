(test 1)
(name "two-associated-types-said-one-type-answer")
(note "`Use.pick` says `C.Item` is `D.Item`, so what `Lib.Container.first` answers for D stands where `some C.Item` is answered.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item))))))
  (document
    (warp 1)
    (import Lib.Container)
    (import Lib.Container.first)
    (procedure Use.pick
      (access public)
      (parameter c (type (some C Lib.Container)))
      (parameter d (type (some D Lib.Container)))
      (returns (some C.Item))
      (sameType C.Item (some D.Item))
      (body
        (let x (call Lib.Container.first d)))
      (result x))))

(program
  (warp 1)
  (import App.Box)
  (import Use.pick)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (let e (type (named App.Box Int)) (struct (field item 1)))
      (let x (call Use.pick b e)))
    (result x)))
(expect (answers 1))
