(test 1)
(name "a-cast-of-a-closure-writing-a-generic-answer-carried-through-another-fails")
(note "App.h keeps n in cell and writes a closure that sets cell from its own some T, held as Any. App.g answers what App.h answers. The cast reading the closure as taking text fails with cast_refused, since only App.h's call filled its T, so nothing outside T reaches cell and the attempt in the entry catches the failure.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure App.g
    (parameter n (type (some T)))
    (parameter junk)
    (returns (some T))
    (failing (anything))
    (result (call App.h n junk)))
  (procedure App.h
    (parameter n (type (some T)))
    (parameter junk)
    (returns (some T))
    (failing (anything))
    (body
      (var cell n)
      (let c
        (closure
          (parameter y (type (some T)))
          (returns Int)
          (body
            (set cell y))
          (result 0)))
      (let a (type Any) c)
      (let w (as a (procedure (parameters String) (returns Int))))
      (let z (apply w (as junk String))))
    (result cell))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let tried
        (attempt
          (body
            (let r (call App.g 1 "s"))
            (let y (call Standard.Numeric.plus r 1)))
          (result y)
          (rescue
            (result (path tried (field type)))))))
    (result tried)))
(expect (answers "cast_refused"))
