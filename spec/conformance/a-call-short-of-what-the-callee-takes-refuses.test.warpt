warpt 1
{
  expect {
    refuses "build"
  }
  name "a-call-short-of-what-the-callee-takes-refuses"
  note "A call hands exactly what the callee takes. `App.pick` takes two, and a call handing one is refused where it is written, whatever the one it hands was read as."
  program {
    imports []
    procedures {
      "App.pick" {
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result {
          ref "a"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "x"
            type "Int?"
            value 1
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
            ]
            procedure "App.pick"
          }
        }
        returns "Int?"
      }
    }
    warp 1
  }
  test 1
}

