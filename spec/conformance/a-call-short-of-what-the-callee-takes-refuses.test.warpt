(test 1)
(name "a-call-short-of-what-the-callee-takes-refuses")
(note "A call hands exactly what the callee takes. `App.pick` takes two, and a call handing one is refused where it is written, whatever the one it hands was read as.")

(program
  (warp 1)
  (procedure App.pick
    (parameter a (type (some T)))
    (parameter b (type (some T)))
    (returns (some T))
    (result a))
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (let x (type (nullable Int)) 1))
    (result (call App.pick x))))
(expect (refuses build))
