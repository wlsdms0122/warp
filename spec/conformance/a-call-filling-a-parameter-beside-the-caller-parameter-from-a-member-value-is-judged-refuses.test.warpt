warpt 1
{
  expect {
    refuses "run"
  }
  name "a-call-filling-a-parameter-beside-the-caller-parameter-from-a-member-value-is-judged-refuses"
  note "app.g, bounded by std.Numeric, answers app.pick(n, 5), which fills E from n and from 5. 5 is a value every member takes and not a value of T, so the call judges the answer, and T filled with int(0...3) refuses 5 at the run."
  program {
    imports [
      "std.Numeric"
    ]
    procedures {
      "app.g" {
        body [
          {
            let "p"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                  5
                ]
                procedure "app.pick"
              }
            }
          }
        ]
        bounds {
          T "std.Numeric"
        }
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          ref "p"
        }
        returns "some T"
      }
      "app.pick" {
        parameters [
          {
            name "a"
            type "some E"
          }
          {
            name "b"
            type "some E"
          }
        ]
        result {
          ref "b"
        }
        returns "some E"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            type "int(0...3)"
            value 2
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

