warpt 1
{
  expect {
    refuses "build"
  }
  name "a-reading-beside-any-at-a-bounded-parameter-is-held-where-it-stands-refuses"
  note "`App.f` bounds `T` by `App.Nums`, which admits `Int` and `Double`, and takes two of `some T`. The call hands a name read as `String` and a name read as `Any`, so `T` reads `Any`, which every bound passes. What each argument hands is held to the bounds where it stands before the two are joined, and no member takes text, so the call refuses at the build."
  program {
    constraints {
      "App.Nums" [
        "Int"
        "Double"
      ]
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.Nums"
        }
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result {
          ref "a"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "s"
            type "String"
            value "x"
          }
          {
            let "u"
            type "Any"
            value 1
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  {
                    ref "u"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

