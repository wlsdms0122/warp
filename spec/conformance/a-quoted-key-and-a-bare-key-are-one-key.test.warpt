warpt 1
{
  expect {
    reads {
      a 1
      "b c" 2
    }
  }
  name "a-quoted-key-and-a-bare-key-are-one-key"
  note "A key is written bare or quoted and is one key either way. Quoting an identifier changes the layout and not the field."
  test 1
  text "warpt 1\n{\n  \"a\" 1\n  \"b c\" 2\n}\n"
}

