warpt 1
{
  arguments {
    payload 1
  }
  expect {
    refuses "build"
  }
  name "a-cast-onto-never-refuses"
  note "A cast names the type a value is read as. `Never` is the type nothing arrives as, so a cast onto it is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "payload"
            type "Any"
          }
        ]
        result {
          as {
            of {
              ref "payload"
            }
            type "Never"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

