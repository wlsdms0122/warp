warpt 1
{
  expect {
    refuses "build"
  }
  name "a-field-of-a-struct-applied-to-int-read-as-text-refuses"
  note "A mention of a struct applied to `Int` reads its field as `Int`, so answering that field where the declaration promises `String` is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
        ]
        result {
          ref "b.item"
        }
        returns "String"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

