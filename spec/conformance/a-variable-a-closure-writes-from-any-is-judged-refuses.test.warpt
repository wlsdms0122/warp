warpt 1
{
  expect {
    refuses "run"
  }
  name "a-variable-a-closure-writes-from-any-is-judged-refuses"
  note "App.g keeps x in cell, and a closure it calls writes junk, read as any, into cell. The body reads cell as T after the call, so it proves nothing and the call judges its answer, and the string refuses at the run."
  program {
    imports []
    procedures {
      "App.g" {
        body [
          {
            value {
              ref "x"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "junk"
                    }
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
          {
            let "z"
            value {
              call {
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  "s"
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

