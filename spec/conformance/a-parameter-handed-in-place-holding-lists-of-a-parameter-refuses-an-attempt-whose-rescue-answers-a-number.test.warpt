warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-handed-in-place-holding-lists-of-a-parameter-refuses-an-attempt-whose-rescue-answers-a-number"
  note "A parameter handed in place as `Array<Array<some T>>`, with `T` bounded by `Standard.Numeric`, is set to an attempt whose body answers `[[], [x]]` and whose rescue `[[5]]`. Each way is judged on its own, and `5` is a whole number rather than a value of the parameter, so the rescue refuses at the build."
  program {
    imports [
      "Standard.Control.abort"
      "Standard.Numeric"
    ]
    procedures {
      "App.g" {
        body [
          {
            set "xs"
            value {
              attempt {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              call {
                                arguments [
                                  "x"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        when false
                      }
                    }
                  }
                ]
                rescue {
                  result [
                    [
                      5
                    ]
                  ]
                }
                result [
                  []
                  [
                    {
                      ref "x"
                    }
                  ]
                ]
              }
            }
          }
        ]
        parameters [
          {
            name "xs"
            type "inout Array<Array<some T: Standard.Numeric>>"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            value {
              as {
                of []
                type "Array<Array<Int>>"
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  1
                ]
                procedure "App.g"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          ref "s"
        }
        returns "Array<Array<Int>>"
      }
    }
    warp 1
  }
  test 1
}

