(test 1)
(name "a-parameter-handed-in-place-holding-lists-of-a-parameter-refuses-an-attempt-whose-rescue-answers-a-number")
(note "A parameter handed in place as `Array<Array<some T>>`, with `T` bounded by `Standard.Numeric`, is set to an attempt whose body answers `[[], [x]]` and whose rescue `[[5]]`. Each way is judged on its own, and `5` is a whole number rather than a value of the parameter, so the rescue refuses at the build.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (import Standard.Numeric)
  (procedure App.g
    (parameter xs (type (inout (array (array (some T Standard.Numeric))))))
    (parameter x (type (some T)))
    (returns Int)
    (body
      (set xs
        (attempt
          (body
            (conditional
              (when false)
              (then
                (call Standard.Control.abort "x"))))
          (result (array (array) (array x)))
          (rescue
            (result (array (array 5)))))))
    (result 0))
  (procedure entry
    (access public)
    (returns (array (array Int)))
    (failing cast_refused)
    (body
      (var s (as (array) (array (array Int))))
      (call App.g s 1))
    (result s)))
(expect (refuses build))
