(test 1)
(name "a-cast-of-a-closure-over-a-type-parameter-its-making-call-filled-fails")
(note "`App.mk` answers a closure taking its own `some T`, which only the call that made it fills, and `a` holds it as `Any`. No value says what filled `T`, so the closure is a value of no procedure type here, and the cast to one fails with cast_refused, which the attempt catches.")

(program
  (warp 1)
  (import Standard.Numeric)
  (procedure App.mk
    (parameter x (type (some T Standard.Numeric)))
    (returns (procedure (parameters (some T)) (returns Int)))
    (result
      (closure
        (parameter y (type (some T)))
        (returns Int)
        (result 0))))
  (procedure entry
    (access public)
    (returns (nullable String))
    (body
      (let a (type Any) (call App.mk 5))
      (var r)
      (let caught
        (attempt
          (body
            (let f (as a (procedure (parameters Double) (returns Int)))))
          (rescue
            (set r (path caught (field type)))))))
    (result r)))
(expect (answers "cast_refused"))
