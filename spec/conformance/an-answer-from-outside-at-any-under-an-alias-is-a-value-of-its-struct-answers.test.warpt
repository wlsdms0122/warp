warpt 1
{
  expect {
    answers "App.P {\"a\":1}"
  }
  name "an-answer-from-outside-at-any-under-an-alias-is-a-value-of-its-struct-answers"
  note "`App.v` is a procedure the host answers declaring it answers `Any`, and it answers `App.Q { a: 1 }`, `App.Q` an alias of the struct `App.P`. Its answer comes in through the door at `Any`, which holds every name a value carries to the struct the name declares, so `r` is an `App.P` and `text` spells it so."
  program {
    imports [
      "App.v"
      "Standard.Text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                procedure "App.v"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "r"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    imports []
    procedures {
      "App.v" {
        answers App.Q {
          a 1
        }
        isolated true
        returns "Any"
      }
    }
    types {
      "App.P" {
        struct {
          a "Int"
        }
      }
      "App.Q" "App.P"
    }
  }
}

