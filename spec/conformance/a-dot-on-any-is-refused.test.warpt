warpt 1
{
  expect {
    refuses "build"
  }
  name "a-dot-on-any-is-refused"
  note "`Any` declares nothing, so a dot on one has nothing to be judged against, and a dot nothing declares is the one thing a run would have to decide for itself. The type is read by naming it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "payload"
          }
        ]
        result {
          ref "payload.name"
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

