warpt 1
{
  expect {
    refuses "build"
  }
  name "a-dot-on-any-is-refused"
  note "`any` declares nothing, so a dot on one has nothing to be judged against, and a dot no declaration proves is the one thing a run would have to decide for itself. The type is read by naming it."
  program {
    imports []
    procedures {
      entry {
        parameters {
          payload {
            type "any"
          }
        }
        result {
          ref "payload.name"
        }
      }
    }
    warp 1
  }
  test 2
}

