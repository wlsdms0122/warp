warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-does-not-carry-a-held-name-into-a-list"
  note "A cast answers what it read, so a cast of a held name written into a list carries the name there, and it refuses like the bare name would. `handle` is closed after the list, so carrying it there is the only thing to refuse."
  program {
    constraints {
      "app.Openable" [
        "app.Handle"
      ]
    }
    imports [
      "app.Handle"
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            let "listed"
            value [
              {
                as {
                  of {
                    ref "handle"
                  }
                  type "app.Openable"
                }
              }
            ]
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
        result {
          ref "listed"
        }
        returns "any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

