warpt 1
{
  expect {
    answers 1
  }
  name "a-record-built-where-a-declared-record-is-read-keeps-its-closure"
  note "A record built from parts where a declared record is read takes the name where it is built, so the closure written in one of its fields stays where it was judged and the record answers through it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "m"
            type "Int"
            value 2
          }
          {
            let "h"
            type "App.G"
            value {
              record {
                f {
                  closure {
                    result 1
                  }
                }
                n {
                  ref "m"
                }
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "h.f"
            }
          }
        }
        returns "Int"
      }
    }
    types {
      "App.G" {
        record {
          f {
            procedure {
              returns "Int"
            }
          }
          n "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

