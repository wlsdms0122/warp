warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-read-as-a-dictionary-after-any-at-a-bounded-parameter-refuses"
  note "`App.f` bounds `T` by `App.Nums`, which `Int` and `Double` answer, and takes `some T` and then `Dictionary<some T>`. The call hands a name read as `Any` and then a record whose field is text, so `T` reads `Any`, which every bound passes. The record's field is held to the bounds before the two are joined, whichever comes first, and text answers no bound, so the call refuses at the build."
  program {
    contracts {
      "App.Nums" {}
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.Nums"
        }
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "d"
            type "Dictionary<some T>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "rec"
            value {
              record {
                k "x"
              }
            }
          }
          {
            let "u"
            type "Any"
            value 1
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "u"
                  }
                  {
                    ref "rec"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      Double [
        "App.Nums"
      ]
      Int [
        "App.Nums"
      ]
    }
    warp 1
  }
  test 1
}

