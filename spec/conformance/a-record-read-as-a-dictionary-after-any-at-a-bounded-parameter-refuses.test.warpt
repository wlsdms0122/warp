warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-read-as-a-dictionary-after-any-at-a-bounded-parameter-refuses"
  note "`App.f` bounds `T` by `App.Nums`, which admits `int` and `double`, and takes `some T` and then `dictionary<some T>`. The call hands a name read as `any` and then a record whose field is text, so `T` reads `any`, which every bound passes. The record's field is held to the bounds before the two are joined, whichever comes first, and no member takes text, so the call refuses at the build."
  program {
    constraints {
      "App.Nums" [
        "int"
        "double"
      ]
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.Nums"
        }
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "d"
            type "dictionary<some T>"
          }
        ]
        result 0
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "rec"
            value {
              record {
                k "x"
              }
            }
          }
          {
            let "u"
            type "any"
            value 1
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "u"
                  }
                  {
                    ref "rec"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

