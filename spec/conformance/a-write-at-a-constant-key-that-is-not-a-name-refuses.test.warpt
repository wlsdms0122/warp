warpt 1
{
  expect {
    refuses "build"
  }
  name "a-write-at-a-constant-key-that-is-not-a-name-refuses"
  note "A constant between the brackets of a write settles at the build, and empty text names no entry, so the write refuses there rather than at the run."
  program {
    const {
      K ""
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "Dictionary<Int>"
            value {
              record {
                a 1
              }
            }
            var "d"
          }
          {
            set "d[K]"
            value 2
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

