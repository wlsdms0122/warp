warpt 1
{
  expect {
    refuses "run"
  }
  name "an-unsaid-generic-answer-carried-through-another-is-judged-where-the-call-reads-it-refuses"
  note "App.g writes no returns, and what was read off its body is its some T, carried from App.h, whose closure writes cell from its own some T and is called through a cast with text. App.g proves nothing, so the call reading Int judges the answer, and the text refuses at the run."
  program {
    imports []
    procedures {
      "App.g" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "n"
              }
              {
                ref "junk"
              }
            ]
            procedure "App.h"
          }
        }
      }
      "App.h" {
        body [
          {
            value {
              ref "n"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "w"
            value {
              as {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      "String"
                    ]
                    returns "Int"
                  }
                }
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        ref "junk"
                      }
                      type "String"
                    }
                  }
                ]
                procedure {
                  ref "w"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  "s"
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

