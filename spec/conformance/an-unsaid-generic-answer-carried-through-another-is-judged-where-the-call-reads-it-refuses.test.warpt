warpt 1
{
  expect {
    refuses "run"
  }
  name "an-unsaid-generic-answer-carried-through-another-is-judged-where-the-call-reads-it-refuses"
  note "app.g writes no returns, and what was read off its body is its some T, carried from app.f, which answers its any. app.g proves nothing, so the call reading int judges the answer, and the text refuses at the run."
  program {
    imports []
    procedures {
      "app.g" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "n"
              }
              {
                ref "junk"
              }
            ]
            procedure "app.h"
          }
        }
      }
      "app.h" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "any"
          }
        ]
        result {
          ref "junk"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  "s"
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

