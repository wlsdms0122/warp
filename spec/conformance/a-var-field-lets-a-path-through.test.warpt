(test 1)
(name "a-var-field-lets-a-path-through")
(note "The same write through a field declared `var` passes, and the field holds the inner type.")

(program
  (warp 1)
  (struct Account
    (field balance (var Int))
    (field owner String))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (var a (as (struct (field balance 1) (field owner "kim")) Account))
      (set (path a (field balance)) 5)
      (return (path a (field balance))))))
(expect (answers 5))
