warpt 1
{
  expect {
    answers 5
  }
  name "a-var-field-lets-a-path-through"
  note "The same write through a field declared `var` passes, and the field holds the inner type."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              as {
                of {
                  record {
                    balance 1
                    owner "kim"
                  }
                }
                type "Account"
              }
            }
            var "a"
          }
          {
            set "a.balance"
            value 5
          }
        ]
        result {
          ref "a.balance"
        }
        returns "Int"
      }
    }
    types {
      Account {
        record {
          balance "var Int"
          owner "String"
        }
      }
    }
    warp 1
  }
  test 1
}

