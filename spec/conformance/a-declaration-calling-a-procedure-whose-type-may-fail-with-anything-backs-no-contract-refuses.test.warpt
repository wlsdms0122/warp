warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-calling-a-procedure-whose-type-may-fail-with-anything-backs-no-contract-refuses"
  note "`step`'s type writes `throws` with no list, so a call of it may fail with anything, and no list a contract names holds that: `Int.run` backs no claim of `run`, whatever `run` lets fail."
  program {
    contracts {
      "App.Runner" {
        procedures {
          run {
            failing [
              "aborted"
              "cast_refused"
              "concurrent_failed"
            ]
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "step"
                type "const (Int) throws -> Int"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          run {
            failing "anything"
            parameters [
              {
                name "of"
                type "Int"
              }
              {
                name "step"
                type "const (Int) throws -> Int"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure {
                  ref "step"
                }
              }
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Runner"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        failing [
          "aborted"
          "cast_refused"
          "concurrent_failed"
        ]
        result {
          call {
            arguments [
              1
              {
                closure {
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    ref "x"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "App.Runner.run"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

