warpt 1
{
  expect {
    refuses "run"
  }
  name "setting-refuses-a-key-that-is-not-a-name"
  note "The key setting writes becomes a field's name, and an empty text names nothing."
  program {
    imports [
      "Standard.Collection.setting"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                record {
                  a 1
                }
              }
              ""
              2
            ]
            procedure "Standard.Collection.setting"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

