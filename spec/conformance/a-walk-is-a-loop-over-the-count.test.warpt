warpt 1
{
  expect {
    answers {
      tally 6
    }
  }
  name "a-walk-is-a-loop-over-the-count"
  note "Walking a collection is the one repetition the language has: the round read against the material's count, with the element read at that index. A round's contribution is what it writes outward. A mapping that answers without running is Standard.Collection.map's to say, and an effectful round with something to keep writes an outer variable."
  program {
    imports [
      "Standard.Collection.count"
      "Standard.Comparable.lessThan"
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "items"
            value [
              1
              2
              3
            ]
          }
          {
            value 0
            var "tally"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "item"
                    value {
                      ref "items[walk.index]"
                    }
                  }
                  {
                    set "tally"
                    value {
                      call {
                        arguments [
                          {
                            ref "tally"
                          }
                          {
                            ref "item"
                          }
                        ]
                        procedure "Standard.Numeric.plus"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "items"
                            }
                          ]
                          procedure "Standard.Collection.count"
                        }
                      }
                    ]
                    procedure "Standard.Comparable.lessThan"
                  }
                }
              }
            }
          }
        ]
        result {
          dictionary [
            [
              "tally"
              {
                ref "tally"
              }
            ]
          ]
        }
        returns "Dictionary<String, Int>"
      }
    }
    warp 1
  }
  test 1
}

