(test 1)
(name "a-walk-is-a-loop-over-the-count")
(note "Walking a collection is the one repetition the language has: the round read against the material's count, with the element read at that index. A round's contribution is what it writes outward. A mapping that answers without running is Standard.Collection.map's to say, and an effectful round with something to keep writes an outer variable.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (import Standard.Comparable.lessThan)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (body
      (let items (array 1 2 3))
      (var tally 0)
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count items)))
          (body
            (let item (path items (index (path walk (field index)))))
            (set tally (call Standard.Numeric.plus tally item))))))
    (result (dictionary (entry "tally" tally)))))
(expect (answers (dictionary (entry "tally" 6))))
