(test 1)
(name "a-map-type-written-with-one-type-refuses")
(note "A map type says two types between its brackets, its key's and its value's, as `Dictionary<String, Int>`. One type there is no spelling of a map, so a type written that way refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter m (type (named Dictionary Int)))
    (result 1))
  (procedure entry
    (access public)
    (result 1)))
(expect (refuses load))
