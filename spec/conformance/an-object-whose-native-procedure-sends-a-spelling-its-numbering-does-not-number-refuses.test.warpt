(test 1)
(name "an-object-whose-native-procedure-sends-a-spelling-its-numbering-does-not-number-refuses")
(note "The row `lone`, of a native procedure, sends `Standard.Numeric.plus` while the object's numbering numbers no send. Where such a row's sends stand is a fact of the object alone, so the reading refuses it.")
(object (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"8af75591dda024dd54e03c9956e36ec1f1a655130299736cfaf4ba6828377f10")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 13 0 (array 1)))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 0 "n") (array (array) 2 "[1]")) (array 1 (array) (array) (array) (array "n")))) (array "lone" (array (array) 1 (array 0) 0 0 (array) (array)) 0 (array 1 (array (array 0 "Standard.Numeric.plus" 2)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 0))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
