warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-value-does-not-go-into-a-list-unbound"
  note "Nothing holds this one yet, and writing it straight into the list is the same loss: the obligation is neither handed on nor still held. It is bound to a name and handed on from there."
  program {
    imports [
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        result [
          {
            call {
              procedure "App.open"
            }
          }
        ]
        returns "any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

