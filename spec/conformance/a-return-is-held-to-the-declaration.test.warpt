(test 1)
(name "a-return-is-held-to-the-declaration")
(note "A procedure answers two ways, its result and every return, and each is held to what it declared. A result that fits does not excuse a return on one way through that carries something else, so the mismatch is refused where the return is written and never reaches a run.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (returns Int)
    (body
      (conditional
        (when ready)
        (then
          (return "x")))
      (return 0))))
(expect (refuses build))
