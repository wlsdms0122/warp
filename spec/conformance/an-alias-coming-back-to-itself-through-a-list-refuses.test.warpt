warpt 1
{
  expect {
    refuses "load"
  }
  name "an-alias-coming-back-to-itself-through-a-list-refuses"
  note "`App.L` names `Array<App.L>`, a list of itself. A name that is no record and comes back to itself spells no type, so the document refuses at the load before any cast is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "xs"
            type "App.L"
            value []
          }
          {
            let "g"
            value {
              as {
                of {
                  ref "xs"
                }
                type "Array<App.L>"
              }
            }
          }
        ]
        result {
          ref "g"
        }
      }
    }
    types {
      "App.L" "Array<App.L>"
    }
    warp 1
  }
  test 1
}

