warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-record-literal-reads-a-whole-number-in-it-as-an-int-refuses"
  note "A cast reads a value and is no place a literal is written into, so the whole number in `{ x: 1 }` is the Int it is, as it is in `1 as Double`. No value of `{ x: Int }` is one of `{ x: Double }`, so the cast refuses at the build."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              as {
                of {
                  record {
                    x 1
                  }
                }
                type {
                  record {
                    x "Double"
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "r.x"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

