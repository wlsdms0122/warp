(test 1)
(name "a-call-filling-a-parameter-from-a-variable-held-in-place-takes-no-other-value-refuses")
(note "App.gen takes a list of its own some T, bounded by App.Real, in place and appends 2.5 to it through Standard.Collection.append. The call fills the element type from the list held in place, so the 2.5 beside it has to be a value of T, and a `Double` is not one: T may be filled with any type conforming to App.Real. The build refuses it, the way it refuses writing 2.5 directly.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (contract App.Real)
  (extension
    (head Double)
    (satisfies App.Real))
  (procedure App.gen
    (parameter xs (type (inout (array (some T App.Real)))))
    (returns Int)
    (body
      (call Standard.Collection.append xs 2.5)
      (return 0)))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (var ns (array 1))
      (let r (call App.gen ns))
      (return ns))))
(expect (refuses build))
