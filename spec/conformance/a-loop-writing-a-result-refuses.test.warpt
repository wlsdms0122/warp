warpt 1
{
  expect {
    refuses "load"
  }
  name "a-loop-writing-a-result-refuses"
  note "A loop answers nothing, so it has no `result` to write, and one written refuses at the load. What a round keeps it writes to an outer variable."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              loop {
                body []
                result 1
                while false
              }
            }
          }
        ]
        result null
      }
    }
    warp 1
  }
  test 1
}

