warpt 1
{
  expect {
    answers 5
  }
  name "a-name-introduced-after-a-block-that-handed-on-its-spelling-is-a-new-name"
  note "The block's `h` handed its handle to `App.close` and is read nowhere after the block. The `h` the body introduces after it is a new name holding a number, so the body answers 5."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              block {
                body [
                  {
                    let "h"
                    type "App.Handle"
                    value {
                      record {
                        name "f"
                      }
                    }
                  }
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "h"
                          }
                        ]
                        procedure "App.close"
                      }
                    }
                  }
                ]
              }
            }
          }
          {
            let "h"
            type "Int"
            value 5
          }
        ]
        result {
          ref "h"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

