warpt 1
{
  expect {
    refuses "build"
  }
  name "a-piece-calling-a-host-procedure-that-is-not-isolated-refuses"
  note "A procedure the host answers says whether it is isolated, and `App.count` says only `const`. A piece declaring `isolated` calls only declarations that say they are isolated, so the build refuses it and `Standard.Concurrent.map` never takes it."
  program {
    imports [
      "App.count"
      "Standard.Concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    call {
                      procedure "App.count"
                    }
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    imports []
    procedures {
      "App.count" {
        access "public"
        answers 1
        const true
        returns "Int"
      }
    }
  }
}

