warpt 1
{
  expect {
    refuses "build"
  }
  name "a-piece-calling-a-host-procedure-that-is-not-isolated-refuses"
  note "A procedure the host answers says whether it is isolated, and one that says it is not strikes every body that reaches it. A closure calling one is not isolated, and `std.concurrent.map` refuses it as a piece."
  program {
    imports [
      "app.count"
      "std.concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "int"
                    }
                    {
                      name "index"
                      type "int"
                    }
                  ]
                  result {
                    call {
                      procedure "app.count"
                    }
                  }
                }
              }
            ]
            procedure "std.concurrent.map"
          }
        }
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.count" {
        access "public"
        answers 1
        isolated false
        returns "int"
      }
    }
  }
}

