warpt 1
{
  expect {
    answers [
      "1"
      "2"
    ]
  }
  name "a-contract-asking-isolated-lets-its-call-stand-in-an-isolated-slot"
  note "A contract's procedure writing `isolated` touches no name another body could touch at once, so a closure sending it is isolated and stands in the isolated slot concurrent map asks."
  program {
    contracts {
      "App.Named" {
        name {
          isolated true
          parameters [
            {
              name "of"
              type "App.Named"
            }
          ]
          returns "string"
        }
      }
    }
    imports [
      "Standard.Concurrent.map"
      "Standard.Text.text"
    ]
    procedures {
      "App.Thing.name" {
        parameters [
          {
            name "of"
            type "App.Thing"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of.id"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
        returns "string"
      }
      "App.names" {
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "of"
            type "array<some T>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of"
              }
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "some T"
                    }
                    {
                      name "index"
                      type "int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                      ]
                      procedure "App.Named.name"
                    }
                  }
                  returns "string"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "array<string>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  as {
                    of {
                      record {
                        id 1
                      }
                    }
                    type "App.Thing"
                  }
                }
                {
                  as {
                    of {
                      record {
                        id 2
                      }
                    }
                    type "App.Thing"
                  }
                }
              ]
            ]
            procedure "App.names"
          }
        }
        returns "array<string>"
      }
    }
    satisfies {
      "App.Thing" [
        "App.Named"
      ]
    }
    types {
      "App.Thing" {
        record {
          id "int"
        }
      }
    }
    warp 1
  }
  test 1
}

