warpt 1
{
  expect {
    answers [
      "1"
      "2"
    ]
  }
  name "a-contract-asking-isolated-lets-its-call-stand-in-an-isolated-slot"
  note "A contract's procedure writing `isolated` touches no name another body could touch at once, so a call through it stands where a call to a declaration saying `isolated` does: the closure in `App.names` declares `isolated` and sends it, and stands in the isolated slot concurrent map asks."
  program {
    contracts {
      "App.Named" {
        procedures {
          name {
            isolated true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports [
      "Standard.Concurrent.map"
      "Standard.Text.text"
    ]
    procedures {
      "App.names" {
        failing [
          "concurrent_failed"
        ]
        isolated true
        parameters [
          {
            name "of"
            type "Array<some T: App.Named>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of"
              }
              {
                closure {
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "some T"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                      ]
                      procedure "App.Named.name"
                    }
                  }
                  returns "String"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<String>"
      }
      entry {
        access "public"
        failing [
          "cast_refused"
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              [
                {
                  as {
                    of {
                      struct {
                        id 1
                      }
                    }
                    type "App.Thing"
                  }
                }
                {
                  as {
                    of {
                      struct {
                        id 2
                      }
                    }
                    type "App.Thing"
                  }
                }
              ]
            ]
            procedure "App.names"
          }
        }
        returns "Array<String>"
      }
    }
    types {
      "App.Thing" {
        procedures {
          name {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "App.Thing"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "of.id"
                  }
                ]
                procedure "Standard.Text.text"
              }
            }
            returns "String"
          }
        }
        satisfies [
          "App.Named"
        ]
        struct {
          id "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

