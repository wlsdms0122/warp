warpt 1
{
  expect {
    answers x"6869"
  }
  name "encoded-writes-text-as-bytes-in-a-named-encoding"
  note "`decoded` and `encoded` are the two directions of one mapping. Text is Unicode and utf8 spells all of it, so this cannot refuse the text it was given."
  program {
    imports [
      "std.byte"
      "std.text.encoded"
    ]
    procedures {
      entry {
        result {
          call {
            of "hi"
            procedure "std.text.encoded"
          }
        }
        returns "array<std.byte>"
      }
    }
    warp 1
  }
  test 2
}

