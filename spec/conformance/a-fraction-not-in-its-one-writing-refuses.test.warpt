warpt 1
{
  expect {
    refuses "load"
  }
  name "a-fraction-not-in-its-one-writing-refuses"
  note "A double is spelled as the shortest decimal that reads back to the same value. `1.50` and `1.5` are two texts for one value, and only the short one is a document."
  test 5
  text "warpt 1\n1.50\n"
}

