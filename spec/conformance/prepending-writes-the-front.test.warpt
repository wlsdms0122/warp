(test 1)
(name "prepending-writes-the-front")
(note "prepending returns a new array with the value at the front, the mirror of appending.")

(program
  (warp 1)
  (import Standard.Collection.prepending)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call Standard.Collection.prepending (array 1 2) 0)))))
(expect (answers (array 0 1 2)))
