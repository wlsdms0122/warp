(test 1)
(name "a-closure-answering-a-whole-number-does-not-fit-a-slot-answering-a-fraction-refuses")
(note "A value's type is fixed at the build, and a whole number is no fraction. A closure that writes `returns Int` answers whole numbers, so it does not fit a slot whose procedure type answers `Double`: nothing turns the one answer into the other.")

(program
  (warp 1)
  (import Standard.Text.text)
  (procedure App.run
    (parameter c (type (procedure (parameters) (returns (some T)))))
    (returns (some T))
    (body
      (return (apply c))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let c
        (type (procedure (parameters) (returns Double)))
        (closure
          (returns Int)
          (body
            (return 1))))
      (let v (call App.run c))
      (return (call Standard.Text.text v)))))
(expect (refuses build))
