(test 1)
(name "satisfies-written-empty-refuses")
(note "A struct adopting no contract writes no `satisfies`, so `satisfies: []` says it a second way.")

(program
  (warp 1)
  (struct App.P
    (satisfies)
    (field x Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
