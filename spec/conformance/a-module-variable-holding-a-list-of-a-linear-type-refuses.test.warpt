warpt 1
{
  expect {
    refuses "build"
  }
  name "a-module-variable-holding-a-list-of-a-linear-type-refuses"
  note "A module variable saying what it holds is held to that type the way a name inside a body is, so a list of a type written linear refuses there as it does anywhere."
  program {
    imports [
      "App.Handle"
    ]
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    var {
      mv {
        type "Array<App.Handle>"
        value []
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.mk" {
        answers {
          name "h"
        }
        returns "App.Handle"
        runs true
      }
      "App.name" {
        answers "f"
        parameters [
          {
            name "first"
            type "borrowing App.Handle"
          }
        ]
        returns "String"
      }
    }
    types {
      "App.H2" "App.Handle"
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

