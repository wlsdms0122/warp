(test 1)
(name "an-operand-of-and-that-answers-no-bool-refuses")
(note "`and` and `or` take an array of procedures each declared as answering `Bool`. One answering anything else is refused at the build where it is handed.")

(program
  (warp 1)
  (import Standard.Logic.and)
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (return
        (call Standard.Logic.and
          (array
            (closure
              (const)
              (isolated)
              (returns Int)
              (body
                (return 1)))))))))
(expect (refuses build))
