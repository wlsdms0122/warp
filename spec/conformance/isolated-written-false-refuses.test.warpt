warpt 1
{
  expect {
    refuses "load"
  }
  name "isolated-written-false-refuses"
  note "Leaving `isolated` out is the declaration making no claim, so `isolated: false` written out refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        isolated false
      }
    }
    warp 1
  }
  test 1
}

