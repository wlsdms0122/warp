(test 1)
(name "a-map-key-that-is-the-array-of-the-bytes-before-refuses")
(note "Bytes and the array of their numbers are one value and stand at one place in the key order, so a map keyed by both writes its second key as a duplicate and is refused.")
(bytes x"574152500107020801010302060103020304")
(expect (refuses load))
