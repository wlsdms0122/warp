(test 1)
(name "a-constant-calls-a-value-its-type-says-is-const")
(note "A constant folds at the build, so what it is written from is read rather than run, as an operand is. `one` holds a closure whose literal declares `const () -> Int`, and that type is what says the procedure is const, so `c` folds by calling it.")

(program
  (warp 1)
  (const c (apply one))
  (const one
    (closure
      (const)
      (returns Int)
      (body
        (return 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return c))))
(expect (answers 1))
