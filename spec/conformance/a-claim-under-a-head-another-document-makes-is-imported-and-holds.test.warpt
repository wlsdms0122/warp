(test 1)
(name "a-claim-under-a-head-another-document-makes-is-imported-and-holds")
(note "The claim under `App.Box<some T: Hashable>` is made in a document the program names nothing of, and the program imports it, so a box of `Int`, which the head takes, conforms to App.Describable.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (import App.Box)
    (import App.Describable)
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns String)
        (body
          (return "box"))))))

(program
  (warp 1)
  (import App.Box)
  (import App.Box App.Describable)
  (import App.Describable.describe)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (answers "box"))
