(test 1)
(name "an-object-writing-any-as-a-parameter-type-refuses")
(note "A parameter taking anything writes no type. An object writing `Any` there writes one signature a second way, and the reading refuses it.")
(object (dictionary (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"b0852757e83340f4c3cbfe1fda87e41e6831a2a73d69db31876c301594d7f56b")) (entry "document" (array x"54d4b03c4db4199a1fe9c6589788b4b6824d406982fe382d46519365ce6d7545")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Numeric.plus") (array))) (entry "object" 1) (entry "rows" (array (array "entry" (array (array (array "n" (array (array 0)) (array))) (array 4) (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array (array 12 (array "Standard.Numeric" "plus" (array 1 (array 0 (array))) (array (array 0 (array 0 (array 2 1)))))))) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "types" (array)) (entry "variables" (array))))
