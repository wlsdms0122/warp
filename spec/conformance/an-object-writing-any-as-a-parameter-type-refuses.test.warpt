(test 1)
(name "an-object-writing-any-as-a-parameter-type-refuses")
(note "A parameter taking anything writes no type. An object writing `Any` there writes one signature a second way, and the reading refuses it.")
(object (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"a5732dc98a9098112838793ee3bc74983ef772acd039ef92ff67a167c57fe995")) (entry "document" (array x"54d4b03c4db4199a1fe9c6589788b4b6824d406982fe382d46519365ce6d7545")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Numeric.plus") (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 12 (array "Standard.Numeric" "plus" 0 (array (array 0 1)))) (array 13 0 (array) (array 2)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 0) (array))) 1 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 3 "[0]")) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 0) (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
