(test 1)
(name "an-inout-type-parameter-a-variable-fills-first-reads-the-value")
(note "The same two slots in the other order: the variable fills `T` first, the closure's `inout Int` reads it the same way, and the call returns what it would in either order.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure App.once
    (parameter x (type (inout (some T))))
    (parameter f (type (procedure (parameters (inout (some T))) (returns Any))))
    (returns Int)
    (body
      (apply f x)
      (return 0)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var n 0)
      (call App.once n
        (closure
          (parameter c (type (inout Int)))
          (returns Any)
          (body
            (set c (call Standard.Numeric.plus c 1))
            (return))))
      (return n))))
(expect (answers 1))
