warpt 1
{
  expect {
    answers "οδος σας σ"
  }
  name "lowercased-ends-a-word-with-final-sigma"
  note "Unicode's full default case mapping lowers a capital sigma by where it stands: after a cased letter and with none following it, it is the final sigma. Everywhere else it is the plain one."
  program {
    imports [
      "Standard.Text.lowercased"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "ΟΔΟΣ ΣΑΣ Σ"
            ]
            procedure "Standard.Text.lowercased"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

