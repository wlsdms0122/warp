(test 1)
(name "max-answers-rhs-on-a-tie")
(note "Two values that order the same are a tie, and on a tie max answers rhs as it arrived: 0.0 and -0.0 are one worth, and their text tells which came back.")

(program
  (warp 1)
  (import Standard.Math.max)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call Standard.Text.text (call Standard.Math.max 0.0 -0.0))))))
(expect (answers "-0.0"))
