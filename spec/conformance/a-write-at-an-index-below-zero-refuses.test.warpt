warpt 1
{
  expect {
    refuses "build"
  }
  name "a-write-at-an-index-below-zero-refuses"
  note "`set d[-1]` on a list writes a whole number below zero between the brackets, which is no position, so the write refuses at the build, where what is written into is known."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "Array<Int>"
            value [
              1
            ]
            var "d"
          }
          {
            set "d[-1]"
            value 2
          }
        ]
        result {
          ref "d[0]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

