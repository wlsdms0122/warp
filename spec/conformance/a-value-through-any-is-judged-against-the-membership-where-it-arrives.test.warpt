warpt 1
{
  arguments {
    left true
  }
  expect {
    refuses "run"
  }
  name "a-value-through-any-is-judged-against-the-membership-where-it-arrives"
  note "A reading the text says nothing about passes the build, and the value that arrived is judged against the membership where it arrives. `lessThan` takes what `Standard.Comparable` admits, and a bool is not among it."
  program {
    imports [
      "Standard.Math.lessThan"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "left"
            type "Any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "left"
              }
              1
            ]
            procedure "Standard.Math.lessThan"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

