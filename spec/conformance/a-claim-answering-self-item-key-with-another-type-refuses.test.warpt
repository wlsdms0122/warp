warpt 1
{
  documents [
    {
      contracts {
        "Lib.Keyed" {
          procedures {
            key {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Key"
            }
          }
          types [
            "Key"
          ]
        }
        "Lib.Outer" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item: Lib.Keyed"
          ]
        }
      }
      imports []
      warp 1
    }
    {
      imports [
        "Lib.Keyed"
        "Lib.Outer"
      ]
      types {
        "App.Card" {
          procedures {
            key {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Card"
                }
              ]
              result {
                ref "of.k"
              }
              returns "Int"
            }
          }
          satisfies [
            "Lib.Keyed"
          ]
          struct {
            k "Int"
          }
          types {
            Key "Int"
          }
        }
        "App.Shelf" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Shelf"
                }
              ]
              result {
                ref "of.card"
              }
              returns "App.Card"
            }
          }
          satisfies [
            "Lib.Outer"
          ]
          struct {
            card "App.Card"
          }
          types {
            Item "App.Card"
          }
        }
      }
      warp 1
    }
    {
      contracts {
        "Lib.Deep" {
          procedures {
            firstKey {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item.Key"
            }
            keyPlus {
              parameters [
                {
                  name "of"
                  type "Self"
                }
                {
                  name "k"
                  type "Self.Item.Key"
                }
              ]
              returns "Int"
            }
          }
          types [
            "Item: Lib.Keyed"
          ]
        }
      }
      imports [
        "Lib.Keyed"
      ]
      warp 1
    }
    {
      imports [
        "App.Card"
        "Int.plus"
        "Lib.Deep"
      ]
      types {
        "App.DShelf" {
          procedures {
            firstKey {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.DShelf"
                }
              ]
              result "x"
              returns "String"
            }
            keyPlus {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.DShelf"
                }
                {
                  name "k"
                  type "Int"
                }
              ]
              result {
                call {
                  arguments [
                    {
                      ref "k"
                    }
                    1
                  ]
                  procedure "Int.plus"
                }
              }
              returns "Int"
            }
          }
          satisfies [
            "Lib.Deep"
          ]
          struct {
            card "App.Card"
          }
          types {
            Item "App.Card"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-claim-answering-self-item-key-with-another-type-refuses"
  note "App.DShelf gives Item as App.Card, whose Key is Int, and answers `firstKey`, which the contract writes as answering `Self.Item.Key`, with a String, so the claim refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

