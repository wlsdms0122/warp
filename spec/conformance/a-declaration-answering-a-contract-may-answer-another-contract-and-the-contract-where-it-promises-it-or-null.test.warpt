warpt 1
{
  expect {
    answers "ok"
  }
  name "a-declaration-answering-a-contract-may-answer-another-contract-and-the-contract-where-it-promises-it-or-null"
  note "The contract answers App.Sized? and the declaration answering it answers App.Pockets & App.Sized, which answers App.Sized by what it writes, whatever type answering both it is."
  program {
    contracts {
      "App.Pockets" {}
      "App.Shown" {
        show {
          failing [
            "cast_refused"
          ]
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "App.Sized"
            }
          ]
          returns "App.Sized?"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
      "App.Wallets" {}
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  struct {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result "ok"
      }
    }
    types {
      "Bank.Box" {
        procedures {
          show {
            body [
              {
                let "k"
                value {
                  as {
                    of {
                      struct {
                        last "9"
                      }
                    }
                    type "Bank.Card"
                  }
                }
              }
            ]
            parameters [
              {
                name "of"
                type "Bank.Box"
              }
              {
                name "n"
                type "App.Sized"
              }
            ]
            result {
              ref "k"
            }
            returns "App.Pockets & App.Sized"
          }
        }
        satisfies [
          "App.Shown"
        ]
        struct {
          n "Int"
        }
      }
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result 4
            returns "Int"
          }
        }
        satisfies [
          "App.Pockets"
          "App.Sized"
          "App.Wallets"
        ]
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        satisfies [
          "App.Pockets"
          "App.Wallets"
        ]
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

