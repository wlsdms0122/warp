warpt 1
{
  expect {
    refuses "run"
  }
  name "a-nameless-record-judged-where-a-declared-record-was-filled-refuses"
  note "App.h keeps n in cell, and a closure writing cell from its own some T is read as Any and called through a cast with a nameless record. The entry fills T with App.R, so the call judges the answer against App.R, and a judgement writes no name: the nameless record refuses at the run."
  program {
    imports []
    procedures {
      "App.h" {
        body [
          {
            value {
              ref "n"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "w"
            value {
              as {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      {
                        record {
                          x "Int"
                        }
                      }
                    ]
                    returns "Int"
                  }
                }
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    record {
                      x 7
                    }
                  }
                ]
                procedure {
                  ref "w"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "p"
            type "App.R"
            value {
              record {
                x 1
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "p"
                  }
                ]
                procedure "App.h"
              }
            }
          }
        ]
        result {
          ref "r.x"
        }
      }
    }
    types {
      "App.R" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

