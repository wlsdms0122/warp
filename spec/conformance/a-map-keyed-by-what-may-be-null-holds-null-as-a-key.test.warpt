(test 1)
(name "a-map-keyed-by-what-may-be-null-holds-null-as-a-key")
(note "`Int?` answers `Hashable`, because `Int` and `Null` both do, so it is a map's key type, and `null` is one of its keys like any other: the entry under it is read by a name holding null.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let d (type (dictionary (nullable Int) String)) (dictionary (entry 1 "one") (entry null "none")))
      (let k (type (nullable Int)) null))
    (result (path d (index k)))))
(expect (answers "none"))
