warpt 1
{
  arguments {
    x App.Shelf {
      item true
    }
  }
  expect {
    refuses "run"
  }
  name "a-struct-from-outside-at-any-holding-what-its-bound-does-not-take-refuses"
  note "A struct from outside at a slot that applies it to nothing is applied to what its fields fill its parameters with, as a door fills a slot's. `App.Shelf` bounds `T` by `App.Shown`, and a `Bool` in its field answers no procedure of it, so the door refuses the value."
  program {
    contracts {
      "App.Described" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
      "App.Shown" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result "int"
            returns "String"
          }
        }
        satisfies [
          "App.Shown"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "x"
          }
        ]
        result {
          call {
            arguments [
              {
                as {
                  of {
                    ref "x"
                  }
                  type "App.Described"
                }
              }
            ]
            procedure "App.Described.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Shelf" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Shelf<some T: App.Shown>"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "of.item"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
            returns "String"
          }
        }
        satisfies [
          "App.Described"
        ]
        struct {
          item "some T"
        }
        typeParameters [
          "T: App.Shown"
        ]
      }
    }
    warp 1
  }
  test 1
}

