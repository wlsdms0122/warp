warpt 1
{
  expect {
    refuses "run"
  }
  name "a-value-called-through-any-is-judged-by-its-own-type"
  note "A value the text opens to `Any` carries its type with it, so a call through such a name is judged where it runs: an argument the closure's parameter refuses is refused at the run, and the body never sees it."
  program {
    imports []
    procedures {
      "App.blind" {
        parameters [
          {
            name "of"
            type "Any"
          }
        ]
        result {
          ref "of"
        }
        returns "Any"
      }
      entry {
        access "public"
        body [
          {
            let "double"
            value {
              closure {
                parameters [
                  {
                    name "n"
                    type "Int"
                  }
                ]
                result {
                  ref "n"
                }
                returns "Int"
              }
            }
          }
          {
            let "held"
            value {
              call {
                arguments [
                  {
                    ref "double"
                  }
                ]
                procedure "App.blind"
              }
            }
          }
          {
            let "made"
            value {
              call {
                arguments [
                  "not a number"
                ]
                procedure {
                  ref "held"
                }
              }
            }
          }
        ]
        result {
          ref "made"
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

