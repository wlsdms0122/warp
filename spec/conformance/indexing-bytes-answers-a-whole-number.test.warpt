warpt 1
{
  expect {
    answers 105
  }
  name "indexing-bytes-answers-a-whole-number"
  note "An element of bytes is an ordinary whole number. A byte, the range std declares. There is no separate byte kind, so reading one needs no conversion and no special procedure."
  program {
    const {
      data x"6869"
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          ref "data[1]"
        }
      }
    }
    warp 1
  }
  test 2
}

