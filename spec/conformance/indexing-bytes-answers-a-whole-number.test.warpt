(test 1)
(name "indexing-bytes-answers-a-whole-number")
(note "An element of bytes is an `Int`, so reading one needs no conversion and no special procedure.")

(program
  (warp 1)
  (const data x"6869")
  (procedure entry
    (access public)
    (returns Int)
    (result (path data (index 1)))))
(expect (answers 105))
