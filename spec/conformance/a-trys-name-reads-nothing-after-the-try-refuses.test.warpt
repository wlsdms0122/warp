(test 1)
(name "a-trys-name-reads-nothing-after-the-try-refuses")
(note "A try has no value, and its name is its failure's, read in the catch. After the try the name reads nothing, so reading it there refuses at the load.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let tried
        (try
          (body
            (call Standard.Control.abort "stop"))
          (catch
            (let seen (path tried (field message))))))
      (return tried))))
(expect (refuses load))
