(test 1)
(name "a-write-reaches-into-what-a-variable-holds")
(note "A `set` names a path. The head is the variable; the rest says where inside its value the new value goes, and the rest of the value is kept.")

(program
  (warp 1)
  (struct App.Point
    (field x (var Int))
    (field y Int))
  (procedure entry
    (access public)
    (returns App.Point)
    (body
      (var p (type App.Point) (struct (field x 1) (field y 2)))
      (set (path p (field x)) 5))
    (result p)))
(expect (answers (struct App.Point (field x 5) (field y 2))))
