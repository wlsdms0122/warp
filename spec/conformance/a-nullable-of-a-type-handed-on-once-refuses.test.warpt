warpt 1
{
  expect {
    refuses "build"
  }
  name "a-nullable-of-a-type-handed-on-once-refuses"
  note "A value handed on once needs a name holding it on every way through, and a `?` says there is a way through where nothing is there. `app.Handle?` is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          item {
            type "app.Handle?"
          }
        }
        result 1
        returns "int"
      }
    }
    types {
      "app.Handle" {
        linear {
          name "string"
        }
      }
    }
    warp 1
  }
  test 2
}

