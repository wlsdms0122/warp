warpt 1
{
  bytes x"5741525001030200"
  expect {
    refuses "load"
  }
  name "bytes-after-the-document-ends-refuse"
  note "A document is exactly one value, then the end of the input. Bytes after it are either a second document nobody asked for or a document that was tampered with, and a reader that stopped at the first value would not be able to tell which."
  test 4
}

