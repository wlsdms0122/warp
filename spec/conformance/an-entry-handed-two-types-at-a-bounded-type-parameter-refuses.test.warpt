(test 1)
(name "an-entry-handed-two-types-at-a-bounded-type-parameter-refuses")
(note "`x` and `y` are both `some T`, bounded by `App.C`, which `Int` and `String` both answer, and the host hands `5` and `\"s\"`. The door fills `T` from what the values read as, the way a call fills it, and a type parameter is one type, so the run refuses before anything runs.")

(program
  (warp 1)
  (import Standard.Text.joined)
  (import Standard.Text.text)
  (contract App.C
    (procedure f
      (parameter s (type Self))
      (parameter o (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.C)
    (procedure f
      (parameter s (type Int))
      (parameter o (type Int))
      (returns String)
      (body
        (let m (type Int) o)
        (return (call Standard.Text.joined (array "Int.f got" (call Standard.Text.text m)) " ")))))
  (extension
    (head String)
    (satisfies App.C)
    (procedure f
      (parameter s (type String))
      (parameter o (type String))
      (returns String)
      (body
        (return "String.f"))))
  (procedure entry
    (access public)
    (parameter x (type (some T App.C)))
    (parameter y (type (some T)))
    (returns String)
    (body
      (let r (call App.C.f x y))
      (return r))))
(arguments (argument x 5) (argument y "s"))
(expect (refuses run))
