(test 1)
(name "a-claim-in-a-document-the-program-names-nothing-of-refuses")
(note "Whether a type answers a contract is judged against the claims made within what the asking document stands on. The program names the contract and the type, and nothing of the document making the claim, so the claim is not within its reach and the call refuses at the build.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (result "card"))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))

(program
  (warp 1)
  (import App.Describable.describe)
  (import T.Card)
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let card (as (struct (field rank 1)) T.Card)))
    (result (call App.Describable.describe card))))
(expect (refuses build))
