warpt 1
{
  expect {
    answers false
  }
  name "a-string-not-holding-another-answers-false"
  note "A part longer than the whole, and a part the whole never spells, both answer false rather than refusing."
  program {
    imports [
      "std.text.contains"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                arguments [
                  "spec"
                  "specification"
                ]
                procedure "std.text.contains"
              }
            }
          }
        ]
        result {
          ref "held"
        }
      }
    }
    warp 1
  }
  test 1
}

