(test 1)
(name "an-object-whose-native-procedure-sends-from-a-place-past-the-first-refuses")
(note "A native procedure sends one procedure to a place, from the first. The row `Host.twice` sends `Standard.Collection.appending` at place 1 and nothing at place 0, and the reading refuses it.")
(object (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"4037d56fccec235930cb114e818ce6bc5617a9254d947496a8f29cfe1eff412c")) (entry "document" (array)) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Collection.appending") (array))) (entry "object" 1) (entry "operationTable" (array)) (entry "rows" (array (array "Host.twice" (array (array) 0 (array 1 (array)) 1 1 (array) (array)) 1 (array 1 (array (array 1 "Standard.Collection.appending" 2)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array)) (entry "variables" (array))))
(expect (refuses load))
