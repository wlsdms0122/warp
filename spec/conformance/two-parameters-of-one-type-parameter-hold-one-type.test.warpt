warpt 1
{
  expect {
    answers 2
  }
  name "two-parameters-of-one-type-parameter-hold-one-type"
  note "Two parameters written `some T` hold the one type the call filled, so the same field of either is the same field. A name holding that field through one parameter or the other holds one type, and a dot after it stands."
  program {
    imports [
      "Standard.Logic.equal"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "also"
            type "App.Outer"
            value {
              record {
                inner {
                  record {
                    count 2
                  }
                }
              }
            }
          }
          {
            let "of"
            type "App.Outer"
            value {
              record {
                inner {
                  record {
                    count 1
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "also"
              }
              true
              {
                ref "of"
              }
            ]
            procedure "peek"
          }
        }
      }
      peek {
        body [
          {
            value {
              ref "of.inner"
            }
            var "seen"
          }
          {
            value {
              conditional {
                then [
                  {
                    set "seen"
                    value {
                      ref "also.inner"
                    }
                  }
                ]
                when {
                  call {
                    arguments [
                      {
                        ref "flag"
                      }
                      true
                    ]
                    procedure "Standard.Logic.equal"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "also"
            type "some T"
          }
          {
            name "flag"
            type "Bool"
          }
          {
            name "of"
            type "some T"
          }
        ]
        result {
          ref "seen.count"
        }
      }
    }
    types {
      "App.Inner" {
        record {
          count "Int"
        }
      }
      "App.Outer" {
        record {
          inner "App.Inner"
        }
      }
    }
    warp 1
  }
  test 1
}

