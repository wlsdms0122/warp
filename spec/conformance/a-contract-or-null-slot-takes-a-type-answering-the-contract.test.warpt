(test 1)
(name "a-contract-or-null-slot-takes-a-type-answering-the-contract")
(note "App.f takes App.Sized? and is handed a Bank.Card, which a document says answers App.Sized.")

(program
  (warp 1)
  (struct Bank.Box
    (field n Int))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (result 4)))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure App.f
    (parameter n (type (nullable App.Sized)))
    (returns String)
    (result "took"))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "4")) Bank.Card))
      (let s (call App.f c)))
    (result s)))
(expect (answers "took"))
