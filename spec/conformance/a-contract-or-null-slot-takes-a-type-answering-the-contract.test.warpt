warpt 1
{
  expect {
    answers "took"
  }
  name "a-contract-or-null-slot-takes-a-type-answering-the-contract"
  note "App.f takes App.Sized? and is handed a Bank.Card, which a document says answers App.Sized."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized?"
          }
        ]
        result "took"
        returns "String"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        record {
          n "Int"
        }
      }
      "Bank.Card" {
        record {
          last "String"
        }
      }
      "Bank.Coin" {
        record {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

