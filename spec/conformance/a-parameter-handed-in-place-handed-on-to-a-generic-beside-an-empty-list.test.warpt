(test 1)
(name "a-parameter-handed-in-place-handed-on-to-a-generic-beside-an-empty-list")
(note "App.g hands xs, a list of T handed in place, on to App.put beside []. An empty list holds no element, so it is a value of Array<some T>, and the caller's list is empty before it appends b.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (procedure App.g
    (parameter xs (type (inout (array (some T)))))
    (returns Int)
    (body
      (call App.put xs (array))
      (return 0)))
  (procedure App.put
    (parameter a (type (inout (some U))))
    (parameter b (type (some U)))
    (returns Int)
    (body
      (set a b)
      (return 0)))
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (var s (array "a"))
      (call App.g s)
      (call Standard.Collection.append s "b")
      (return s))))
(expect (answers (array "b")))
