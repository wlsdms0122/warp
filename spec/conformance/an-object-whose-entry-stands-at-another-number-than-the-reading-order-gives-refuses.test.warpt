(test 1)
(name "an-object-whose-entry-stands-at-another-number-than-the-reading-order-gives-refuses")
(note "Each table numbers its entries in the order they are finished. The call reads `n` at operation 0 before the literal at operation 1, and a call holding them the other way round holds operation 1 while operation 0 is the one finished next, so the reading refuses it.")
(object (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"4037d56fccec235930cb114e818ce6bc5617a9254d947496a8f29cfe1eff412c")) (entry "document" (array x"4e397fd69d6c8c4a876ea129f0d76bc74924b3d25abd0aeaaace549c1d53aeba")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Collection.appending") (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 11 (array 0 (array (array 1) (array 0)) (array))) (array 13 0 (array) (array 2)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 1))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 3 "[0]")) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 7 0) (array 4) (array 7 2))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
