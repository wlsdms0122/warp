(test 1)
(name "a-parameter-may-take-a-constants-spelling")
(note "A procedure's body is inside its module, so its parameter may take the spelling of a constant beside it, and in the body the name is the parameter. `App.f` answers what it was handed and not the constant.")

(program
  (warp 1)
  (const limit 3)
  (procedure App.f
    (parameter limit (type Int))
    (returns Int)
    (body
      (return limit)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.f 7)))))
(expect (answers 7))
