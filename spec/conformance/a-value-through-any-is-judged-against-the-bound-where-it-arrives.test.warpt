warpt 1
{
  arguments {
    left true
  }
  expect {
    refuses "build"
  }
  name "a-value-through-any-is-judged-against-the-bound-where-it-arrives"
  note "`left` is read as `Any`, which stands where `lessThan` asks `Standard.Comparable` only through a cast, so the build refuses, whatever arrives."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "left"
            type "Any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "left"
              }
              1
            ]
            procedure "Standard.Comparable.lessThan"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

