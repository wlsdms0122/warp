(test 1)
(name "a-claim-about-array-answered-for-a-list-of-ints-alone-refuses")
(note "A claim about `Array` is about every list, whatever it holds, since a value does not say which elements a slot declared it to hold. `Array.total` is given under `Array<Int>`, for lists of whole numbers alone, so a list of text handed through the contract would reach a slot that refuses it, and the claim does not hold.")

(program
  (warp 1)
  (contract App.Totalable
    (procedure total
      (parameter of (type Self))
      (returns Int)))
  (extension
    (head Array)
    (satisfies App.Totalable))
  (extension
    (head (array Int))
    (procedure total
      (parameter of (type (array Int)))
      (returns Int)
      (result 0)))
  (procedure entry
    (access public)
    (returns Int)
    (result (call App.Totalable.total (array "s")))))
(expect (refuses build))
