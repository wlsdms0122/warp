(test 1)
(name "a-declared-name-is-a-type")
(note "A module declares types under names, and a declared name is a type wherever a type is written.")

(program
  (warp 1)
  (struct Task
    (field done Bool)
    (field id String))
  (procedure entry
    (access public)
    (parameter task (type Task))
    (returns Bool)
    (result (path task (field done)))))
(arguments (argument task (struct Task (field done true) (field id "a"))))
(expect (answers true))
