warpt 1
{
  arguments {
    task {
      done true
      id "a"
    }
  }
  expect {
    answers true
  }
  name "a-declared-name-is-a-type"
  note "A module declares types under names, and a declared name is a type wherever a type is written."
  program {
    imports []
    procedures {
      entry {
        parameters {
          task {
            type "Task"
          }
        }
        result {
          ref "task.done"
        }
      }
    }
    types {
      Task {
        done "bool"
        id "string"
      }
    }
    warp 1
  }
  test 2
}

