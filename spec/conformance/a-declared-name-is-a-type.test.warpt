warpt 1
{
  arguments {
    task Task {
      done true
      id "a"
    }
  }
  expect {
    answers true
  }
  name "a-declared-name-is-a-type"
  note "A module declares types under names, and a declared name is a type wherever a type is written."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "task"
            type "Task"
          }
        ]
        result {
          ref "task.done"
        }
      }
    }
    types {
      Task {
        record {
          done "Bool"
          id "String"
        }
      }
    }
    warp 1
  }
  test 1
}

