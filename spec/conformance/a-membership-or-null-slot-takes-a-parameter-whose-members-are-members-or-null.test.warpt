warpt 1
{
  expect {
    answers "took"
  }
  name "a-membership-or-null-slot-takes-a-parameter-whose-members-are-members-or-null"
  note "App.g hands its some T, bounded by App.MaybeNum, whose one member is int?, to App.f, which takes App.Num?, App.Num admitting int. Each value is an int or null."
  program {
    constraints {
      "App.MaybeNum" [
        "Int?"
      ]
      "App.Num" [
        "Int"
      ]
    }
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Num?"
          }
        ]
        result "took"
        returns "String"
      }
      "App.g" {
        body [
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "m"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        bounds {
          T "App.MaybeNum"
        }
        parameters [
          {
            name "m"
            type "some T"
          }
        ]
        result {
          ref "s"
        }
        returns "String"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value 3
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
      "Bank.Coin" {
        record {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

