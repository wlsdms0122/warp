(test 1)
(name "tryFilter-fails-with-what-its-closure-fails-with")
(note "`Standard.Collection.tryFilter` takes a procedure that may fail and declares `failing: anything`, so the procedure's failure is the call's: the closure aborts with `side` on the first element, and the catch reads its message.")

(program
  (warp 1)
  (import Standard.Collection.tryFilter)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns (optional String))
    (body
      (var failed)
      (let caught
        (try
          (body
            (call Standard.Collection.tryFilter
              (array 1 2)
              (closure
                (const)
                (isolated)
                (parameter x (type Int))
                (returns Bool)
                (failing aborted)
                (body
                  (call Standard.Control.abort "side")))))
          (catch
            (set failed (path caught (field message))))))
      (return failed))))
(expect (answers "side"))
