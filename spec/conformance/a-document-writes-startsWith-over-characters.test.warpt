warpt 1
{
  expect {
    answers true
  }
  name "a-document-writes-startsWith-over-characters"
  note "Text read as an array of its characters is what lets a document write the procedures that scan text. Each character is a string of its own, so the comparison is the value model's one sameness and reads as a person reads."
  program {
    imports [
      "std.collection.count"
      "std.logic.equal"
      "std.math.lessThan"
      "std.text.characters"
    ]
    procedures {
      "app.startsWith" {
        body [
          {
            let "held"
            value {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure "std.text.characters"
              }
            }
          }
          {
            let "wanted"
            value {
              call {
                arguments [
                  {
                    ref "value"
                  }
                ]
                procedure "std.text.characters"
              }
            }
          }
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return false
                    }
                  }
                ]
                when {
                  call {
                    arguments [
                      {
                        call {
                          arguments [
                            {
                              ref "held"
                            }
                          ]
                          procedure "std.collection.count"
                        }
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "wanted"
                            }
                          ]
                          procedure "std.collection.count"
                        }
                      }
                    ]
                    procedure "std.math.lessThan"
                  }
                }
              }
            }
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "same"
                    value {
                      call {
                        arguments [
                          {
                            ref "held[walk.index]"
                          }
                          {
                            ref "wanted[walk.index]"
                          }
                        ]
                        procedure "std.logic.equal"
                      }
                    }
                  }
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              return false
                            }
                          }
                        ]
                        when {
                          call {
                            arguments [
                              {
                                ref "same"
                              }
                              false
                            ]
                            procedure "std.logic.equal"
                          }
                        }
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "wanted"
                            }
                          ]
                          procedure "std.collection.count"
                        }
                      }
                    ]
                    procedure "std.math.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "string"
          }
          {
            name "value"
            type "string"
          }
        ]
        result true
        returns "bool"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              "warp runtime"
              "warp"
            ]
            procedure "app.startsWith"
          }
        }
        returns "bool"
      }
    }
    warp 1
  }
  test 1
}

