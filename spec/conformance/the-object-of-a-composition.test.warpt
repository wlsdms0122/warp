(test 1)
(name "the-object-of-a-composition")
(note "A slot declaring a composition of contracts writes the composition as the document did, its names ascending, and lowers to the bounds a body stands on.")

(program
  (warp 1)
  (contract App.A
    (procedure a
      (parameter of (type Self))
      (returns Int)))
  (contract App.B
    (procedure b
      (parameter of (type Self))
      (returns Int)))
  (procedure entry
    (access public)
    (parameter v (type (composition App.A App.B)))
    (returns Int)
    (result (call App.A.a v))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array (array "App.A" (array (array) (array) (array (array "a" (array (array (array "of" (array 0) (array))) 1 (array 1 (array)) 0 0 (array) (array)))))) (array "App.B" (array (array) (array) (array (array "b" (array (array (array "of" (array 2) (array))) 3 (array 1 (array)) 0 0 (array) (array)))))))) (entry "dependencies" (array)) (entry "document" (array x"9a63fcf84811790f930a4ce7bd22d81496efb1282331b3bd7405f31d20d7e628")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 12 (array "App.A" "a" 0 (array))))) (entry "rows" (array (array "entry" (array (array (array "v" (array 4) (array))) 5 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array) (array 1)) (array 1 (array 0) (array) (array) (array "v")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 18) (array 4) (array 18) (array 4) (array 16 (array "App.A" "App.B")) (array 4))) (entry "types" (array)) (entry "valueTable" (array)) (entry "variables" (array)))))
