warpt 1
{
  arguments {
    ratio 1
  }
  expect {
    refuses "run"
  }
  name "a-fraction-range-takes-no-whole-number-from-outside-refuses"
  note "A range names the kind it refines, and a fraction range takes fractions alone. A whole number handed in from outside is no fraction, whatever it is worth, so the boundary refuses it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "ratio"
            type "Double(0.0...1.0)"
          }
        ]
        result {
          ref "ratio"
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

