warpt 1
{
  expect {
    answers "hi"
  }
  name "decoded-reads-bytes-as-text-in-a-named-encoding"
  note "Bytes are not text and no encoding is assumed. Reading them as text is a procedure that names its encoding. decoded and encoded are the two directions of one mapping, utf8 first."
  program {
    imports [
      "std.text.decoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              x"6869"
            ]
            procedure "std.text.decoded"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

