(test 1)
(name "a-claim-under-a-head-bounding-its-parameter-holds-for-a-value-it-takes")
(note "The extension of `App.Box<some T: Hashable>` says every box of something that conforms to `Hashable` conforms to App.Describable, and a box of `Int` is one, so the call through the contract reaches the member.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some T Hashable)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (answers "box"))
