warpt 1
{
  expect {
    answers "done"
  }
  name "a-break-does-not-strand-what-the-body-holds"
  note "Only leaving the procedure ends the body. A `break` leaves the loop, and the body still holds its value written `linear` on the other side and hands it on there."
  program {
    imports [
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            let "spin"
            value {
              loop {
                body [
                  {
                    value {
                      break null
                    }
                  }
                ]
                while true
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        result "done"
        returns "String"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

