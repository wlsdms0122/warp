(test 1)
(name "a-claim-about-null-takes-null-where-the-contract-takes-self-or-null")
(note "For a claim about `Null`, `Self?` is `Null` or null, which is `Null`, so `Null.pick` writes `Null` at the position where the contract writes `Self?`, and the claim holds.")

(program
  (warp 1)
  (contract App.Pick
    (procedure pick
      (parameter s (type Self))
      (parameter t (type (nullable Self)))
      (returns Int)))
  (extension
    (head Null)
    (satisfies App.Pick)
    (procedure pick
      (parameter s (type Null))
      (parameter t (type Null))
      (returns Int)
      (result 1)))
  (procedure entry
    (access public)
    (returns Int)
    (result (call App.Pick.pick null null))))
(expect (answers 1))
