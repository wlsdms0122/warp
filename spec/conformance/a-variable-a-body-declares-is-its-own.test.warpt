(test 1)
(name "a-variable-a-body-declares-is-its-own")
(note "A name the body introduces is the body's own. The closure handed to `asking` declares `const`, and declaring the variable `held` and writing it says nothing about what the body reaches, so the build holds the closure to `const` and it stands.")

(program
  (warp 1)
  (procedure asking
    (const)
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body))
      (return answered)))
  (procedure entry
    (access public)
    (const)
    (returns String)
    (body
      (let given
        (closure
          (const)
          (isolated)
          (returns String)
          (body
            (var held "first")
            (set held "second")
            (return held))))
      (return (call asking given)))))
(expect (answers "second"))
