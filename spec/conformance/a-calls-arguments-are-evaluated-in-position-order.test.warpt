(test 1)
(name "a-calls-arguments-are-evaluated-in-position-order")
(note "A call's arguments are evaluated in position order, whether the callee is a body, the host's or a value. An argument may call anything, so the order is observable. Each call here writes two arguments that would both fail, and the first one's failure surfaces: `zulu` for `App.pair`, which declares it before `alpha`, `map` for `Standard.Collection.setting`, and `first` for a closure called through the name holding it.")

(program
  (warp 1)
  (import Standard.Collection.setting)
  (import Standard.Control.abort)
  (procedure App.pair
    (parameter zulu (type String))
    (parameter alpha (type String))
    (returns String)
    (result zulu))
  (procedure entry
    (access public)
    (returns (array (nullable String)))
    (body
      (let declared
        (attempt
          (body
            (let paired (call App.pair (call Standard.Control.abort "zulu") (call Standard.Control.abort "alpha"))))
          (rescue
            (result (path declared (field message))))))
      (let hosted
        (attempt
          (body
            (let set (call Standard.Collection.setting (call Standard.Control.abort "map") (call Standard.Control.abort "key") 1)))
          (rescue
            (result (path hosted (field message))))))
      (let applied
        (attempt
          (body
            (let f
              (closure
                (parameter first (type String))
                (parameter second (type String))
                (returns String)
                (result first)))
            (let made (apply f (call Standard.Control.abort "first") (call Standard.Control.abort "second"))))
          (rescue
            (result (path applied (field message)))))))
    (result (array declared hosted applied))))
(expect (answers (array "zulu" "map" "first")))
