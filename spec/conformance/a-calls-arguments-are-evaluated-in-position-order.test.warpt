warpt 1
{
  expect {
    answers [
      "zulu"
      "map"
      "first"
    ]
  }
  name "a-calls-arguments-are-evaluated-in-position-order"
  note "A call's arguments are evaluated in position order, whether the callee is a body, the host's or a value. An argument may call anything, so the order is observable. Each call here writes two arguments that would both fail, and the first one's failure surfaces: `zulu` for `App.pair`, which declares it before `alpha`, `map` for `Standard.Collection.setting`, and `first` for a closure called through the name holding it."
  program {
    imports [
      "Standard.Collection.setting"
      "Standard.Control.abort"
    ]
    procedures {
      "App.pair" {
        parameters [
          {
            name "zulu"
            type "String"
          }
          {
            name "alpha"
            type "String"
          }
        ]
        result {
          ref "zulu"
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "declared"
            value {
              attempt {
                body [
                  {
                    let "paired"
                    value {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                "zulu"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                          {
                            call {
                              arguments [
                                "alpha"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                        ]
                        procedure "App.pair"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "declared.message"
                  }
                }
              }
            }
          }
          {
            let "hosted"
            value {
              attempt {
                body [
                  {
                    let "set"
                    value {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                "map"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                          {
                            call {
                              arguments [
                                "key"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                          1
                        ]
                        procedure "Standard.Collection.setting"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "hosted.message"
                  }
                }
              }
            }
          }
          {
            let "applied"
            value {
              attempt {
                body [
                  {
                    let "f"
                    value {
                      closure {
                        parameters [
                          {
                            name "first"
                            type "String"
                          }
                          {
                            name "second"
                            type "String"
                          }
                        ]
                        result {
                          ref "first"
                        }
                        returns "String"
                      }
                    }
                  }
                  {
                    let "made"
                    value {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                "first"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                          {
                            call {
                              arguments [
                                "second"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                        ]
                        procedure {
                          ref "f"
                        }
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "applied.message"
                  }
                }
              }
            }
          }
        ]
        result [
          {
            ref "declared"
          }
          {
            ref "hosted"
          }
          {
            ref "applied"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

