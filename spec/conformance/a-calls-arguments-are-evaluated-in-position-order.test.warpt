warpt 1
{
  expect {
    answers [
      "zulu"
      "map"
    ]
  }
  name "a-calls-arguments-are-evaluated-in-position-order"
  note "A call's arguments are evaluated in position order, whether the callee is a body or the host's. An argument may call anything, so the order is observable. Each call here writes two arguments that would both fail, and the first one's failure surfaces: `zulu` for `app.pair`, which declares it before `alpha`, and `map` for `std.collection.setting`."
  program {
    imports [
      "std.collection.setting"
      "std.control.abort"
    ]
    procedures {
      "app.pair" {
        parameters [
          {
            name "zulu"
            type "string"
          }
          {
            name "alpha"
            type "string"
          }
        ]
        result {
          ref "zulu"
        }
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "declared"
            value {
              attempt {
                body [
                  {
                    let "paired"
                    value {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                "zulu"
                              ]
                              procedure "std.control.abort"
                            }
                          }
                          {
                            call {
                              arguments [
                                "alpha"
                              ]
                              procedure "std.control.abort"
                            }
                          }
                        ]
                        procedure "app.pair"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "declared.message"
                  }
                }
              }
            }
          }
          {
            let "hosted"
            value {
              attempt {
                body [
                  {
                    let "set"
                    value {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                "map"
                              ]
                              procedure "std.control.abort"
                            }
                          }
                          {
                            call {
                              arguments [
                                "key"
                              ]
                              procedure "std.control.abort"
                            }
                          }
                          1
                        ]
                        procedure "std.collection.setting"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "hosted.message"
                  }
                }
              }
            }
          }
        ]
        result [
          {
            ref "declared"
          }
          {
            ref "hosted"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

