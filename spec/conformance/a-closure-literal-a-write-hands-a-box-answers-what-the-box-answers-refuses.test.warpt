warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-literal-a-write-hands-a-box-answers-what-the-box-answers-refuses"
  note "`c` holds `{ procedure: { returns: App.Point } }`, and the closure literal the write hands it writes no `returns`, so it answers what the box answers. Its body answers `{ x: 1, y: 2 }`, which is no `App.Point`, so it refuses at the build as the same closure written at a name declaring that type does."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type {
              procedure {
                returns "App.Point"
              }
            }
            value {
              closure {
                result {
                  record {
                    x 0
                  }
                }
                returns "App.Point"
              }
            }
            var "c"
          }
          {
            set "c"
            value {
              closure {
                result {
                  record {
                    x 1
                    y 2
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

