warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-of-memberships-that-name-each-other-cast-to-a-type-no-member-holds-refuses"
  note "`app.M` admits `app.N` and `int`, and `app.N` admits `app.M` and `bool`, so a value of `app.M` is an int or a bool, each membership met again adding no member. No member could also be a string, so a cast of a name read as `app.M` to `string` refuses at the build."
  program {
    constraints {
      "app.M" [
        "app.N"
        "int"
      ]
      "app.N" [
        "app.M"
        "bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "app.M"
            value 1
            var "x"
          }
        ]
        result {
          as {
            of {
              ref "x"
            }
            type "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

