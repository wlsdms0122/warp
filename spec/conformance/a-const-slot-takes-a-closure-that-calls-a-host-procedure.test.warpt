(test 1)
(name "a-const-slot-takes-a-closure-that-calls-a-host-procedure")
(note "A slot asking a `const` procedure type takes a closure whose body sends only procedures that answer without running, and a procedure the host answers says which it is.")

(vocabulary
  (procedure App.yes
    (const)
    (isolated)
    (returns Bool)
    (answers true)))

(program
  (warp 1)
  (import App.yes)
  (import Standard.Logic.and)
  (procedure entry
    (access public)
    (const)
    (returns Bool)
    (failing (anything))
    (result
      (call Standard.Logic.and
        (array
          (closure
            (const)
            (isolated)
            (returns Bool)
            (result (call App.yes))))))))
(expect (answers true))
