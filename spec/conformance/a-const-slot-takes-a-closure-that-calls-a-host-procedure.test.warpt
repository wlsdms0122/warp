warpt 1
{
  expect {
    answers true
  }
  name "a-const-slot-takes-a-closure-that-calls-a-host-procedure"
  note "A slot asking `const procedure` takes a closure whose body sends only procedures that answer without running, and a procedure the host answers says which it is."
  program {
    imports [
      "app.yes"
      "std.logic.and"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result {
                      call {
                        procedure "app.yes"
                      }
                    }
                    returns "bool"
                  }
                }
              ]
            ]
            procedure "std.logic.and"
          }
        }
        returns "bool"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.yes" {
        answers true
        returns "bool"
      }
    }
  }
}

