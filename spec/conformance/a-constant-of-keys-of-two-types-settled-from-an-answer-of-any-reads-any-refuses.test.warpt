(test 1)
(name "a-constant-of-keys-of-two-types-settled-from-an-answer-of-any-reads-any-refuses")
(note "`K.make` declares it answers `Any`, and the map it answers holds `1` and `\"a\"`. Keys of two types join to `Any`, which keys no map, and nothing written says which key the map has, so the constant reads `Any` whole, as two maps keyed apart do, and handing it to `count` without `as` refuses at the build.")

(documents
  (document
    (warp 1)
    (procedure K.make
      (returns Any)
      (body
        (let m (type (dictionary Hashable Int)) (dictionary (entry 1 1) (entry "a" 2))))
      (result m))))

(program
  (warp 1)
  (import K.make)
  (import Standard.Collection.count)
  (const made (call K.make))
  (procedure entry
    (access public)
    (returns Int)
    (result (call Standard.Collection.count made))))
(expect (refuses build))
