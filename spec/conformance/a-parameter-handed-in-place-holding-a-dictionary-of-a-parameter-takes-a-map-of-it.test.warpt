(test 1)
(name "a-parameter-handed-in-place-holding-a-dictionary-of-a-parameter-takes-a-map-of-it")
(note "App.gen takes Dictionary<String, some T> in place and writes a map literal of its own some T into it. A map literal whose every value the entry takes is such a dictionary.")

(program
  (warp 1)
  (procedure App.gen
    (parameter x (type (inout (dictionary String (some T)))))
    (parameter y (type (some T)))
    (returns Int)
    (body
      (set x (dictionary (entry "a" y))))
    (result 0))
  (procedure entry
    (access public)
    (returns (dictionary String String))
    (body
      (var s (type (dictionary String String)) (dictionary (entry "a" "z")))
      (let r (call App.gen s "b")))
    (result s)))
(expect (answers (dictionary (entry "a" "b"))))
