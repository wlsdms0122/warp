warpt 1
{
  expect {
    refuses "build"
  }
  name "a-member-that-is-never-refuses"
  note "A member of a membership is a concrete type. `Never` is the type nothing arrives as, so a membership listing it admits no value through it."
  program {
    constraints {
      Loose [
        "Never"
        "Int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

