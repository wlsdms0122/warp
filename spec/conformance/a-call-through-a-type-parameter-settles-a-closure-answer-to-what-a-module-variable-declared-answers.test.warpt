warpt 1
{
  expect {
    answers "1.0"
  }
  name "a-call-through-a-type-parameter-settles-a-closure-answer-to-what-a-module-variable-declared-answers"
  note "The module variable `cv` declares `procedure() -> double` and starts as a closure answering the whole number 1. `App.run` takes `procedure() -> some T`, so `v` reads as `double`. The start settled into what the variable declared, so the closure keeps that answer, and the call inside `App.run` settles it to the fraction 1.0."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "cv"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
      }
    }
    var {
      cv {
        type {
          procedure {
            returns "double"
          }
        }
        value {
          closure {
            result 1
          }
        }
      }
    }
    warp 1
  }
  test 1
}

