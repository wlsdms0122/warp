(test 1)
(name "a-type-member-under-a-bare-head-writing-a-parameter-refuses")
(note "Under the bare name a type member is about every value of the type and writes none of its parameters, so `some T` there refuses at the load.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))))

(program
  (warp 1)
  (import App.Box)
  (extension
    (head App.Box)
    (type Item (some T)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
