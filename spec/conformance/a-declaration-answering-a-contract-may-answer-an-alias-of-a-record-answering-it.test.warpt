warpt 1
{
  expect {
    answers "a card"
  }
  name "a-declaration-answering-a-contract-may-answer-an-alias-of-a-record-answering-it"
  note "The contract answers App.Describable and the declaration answering it answers Bank.Alias, which names Bank.Card, and a document says Bank.Card answers App.Describable."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
      "App.Pick" {
        pick {
          parameters [
            {
              name "of"
              type "App.Pick"
            }
          ]
          returns "App.Describable"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      "Bank.Card.pick" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result {
          ref "of"
        }
        returns "Bank.Alias"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "p"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Pick.pick"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "p"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
        "App.Pick"
      ]
    }
    types {
      "Bank.Alias" "Bank.Card"
      "Bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

