warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-dictionary-is-read-by-a-key-the-run-reads"
  note "A dictionary's keys are data, so a key the run reads finds an entry the way a written key does. That is what lets a document walk a dictionary at all, and `values` is what walking one is for."
  program {
    imports [
      "Standard.Collection.appending"
      "Standard.Collection.count"
      "Standard.Collection.keys"
      "Standard.Comparable.lessThan"
    ]
    procedures {
      "App.values" {
        body [
          {
            let "names"
            value {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure "Standard.Collection.keys"
              }
            }
          }
          {
            value []
            var "held"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "name"
                    value {
                      ref "names[walk.index]"
                    }
                  }
                  {
                    set "held"
                    value {
                      call {
                        arguments [
                          {
                            ref "held"
                          }
                          {
                            ref "of[name]"
                          }
                        ]
                        procedure "Standard.Collection.appending"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "names"
                            }
                          ]
                          procedure "Standard.Collection.count"
                        }
                      }
                    ]
                    procedure "Standard.Comparable.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "Dictionary<String, Int>"
          }
        ]
        result {
          ref "held"
        }
        returns "Array<Int>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    "first"
                    1
                  ]
                  [
                    "second"
                    2
                  ]
                ]
              }
            ]
            procedure "App.values"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

