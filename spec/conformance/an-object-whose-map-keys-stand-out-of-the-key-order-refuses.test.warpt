(test 1)
(name "an-object-whose-map-keys-stand-out-of-the-key-order-refuses")
(note "A map value writes its keys in the key order, the order the writing puts them in. Here `seen` starts a run holding a map written with the key `\"b\"` before `\"a\"`, which a reading refuses: one that took the keys in any order would read two writings as one object.")
(object (dictionary (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"2d98360a9bf8b855985d60a4daf3c44cc544dce8c9fde99304f20a2e18f7bfca")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "rows" (array (array "entry" (array (array) (array 8 (array 6) (array 4)) (array 1 (array)) 0 1 (array) (array)) 2 (array 0 (array (array) (array (array 1 (array 0 (array))))) (array 1 (array) (array (array 0 0)) (array) (array "seen")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "types" (array)) (entry "variables" (array (array "seen" (array 9 (array (array 4 "b") (array 4 "a")) (array (array 2 2) (array 2 1))))))))
(expect (refuses load))
