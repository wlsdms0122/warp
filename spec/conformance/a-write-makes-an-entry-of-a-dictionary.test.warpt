warpt 1
{
  expect {
    answers 2
  }
  name "a-write-makes-an-entry-of-a-dictionary"
  note "A map's keys are data, so a write under a key it does not hold yet makes the entry."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "Dictionary<String, Int>"
            value {
              dictionary [
                [
                  "a"
                  1
                ]
              ]
            }
            var "held"
          }
          {
            set "held[\"b\"]"
            value 2
          }
        ]
        result {
          ref "held[\"b\"]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

