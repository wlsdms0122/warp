(test 1)
(name "an-attempt-under-a-set-binds-no-failure")
(note "A `set` introduces no name, so an attempt under it binds no failure: the rescue reads `r` as the variable the statement writes.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var r (type Int) 5)
      (set r
        (attempt
          (body
            (call Standard.Control.abort "stop"))
          (rescue
            (result (call Standard.Numeric.plus r 1))))))
    (result r)))
(expect (answers 6))
