warpt 1
{
  expect {
    answers "a-b-c"
  }
  name "split-cuts-and-joined-writes"
  note "split answers the text cut on a separator; joined writes strings one after another with one between."
  program {
    imports [
      "std.text.joined"
      "std.text.split"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "pieces"
            value {
              call {
                arguments {
                  value ","
                }
                of "a,b,c"
                procedure "std.text.split"
              }
            }
          }
          {
            let "line"
            value {
              call {
                arguments {
                  value "-"
                }
                of {
                  ref "pieces"
                }
                procedure "std.text.joined"
              }
            }
          }
        ]
        result {
          ref "line"
        }
      }
    }
    warp 1
  }
  test 2
}

