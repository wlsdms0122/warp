warpt 1
{
  expect {
    answers "a-b-c"
  }
  name "split-cuts-and-joined-writes"
  note "split answers the text cut on a separator; joined writes strings one after another with one between."
  program {
    imports [
      "Standard.Text.joined"
      "Standard.Text.split"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "pieces"
            value {
              call {
                arguments [
                  "a,b,c"
                  ","
                ]
                procedure "Standard.Text.split"
              }
            }
          }
          {
            let "line"
            value {
              call {
                arguments [
                  {
                    ref "pieces"
                  }
                  "-"
                ]
                procedure "Standard.Text.joined"
              }
            }
          }
        ]
        failing [
          "aborted"
        ]
        result {
          ref "line"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

