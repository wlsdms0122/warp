warpt 1
{
  expect {
    refuses "build"
  }
  name "a-contract-slot-refuses-a-name-for-what-may-be-null"
  note "App.f takes App.Sized and is handed a variable declared Bank.MaybeCard, which names Bank.Card?. The name stands for what may be null, which answers no contract."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized"
          }
        ]
        result "took"
        returns "string"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type "Bank.MaybeCard"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        record {
          n "int"
        }
      }
      "Bank.Card" {
        record {
          last "string"
        }
      }
      "Bank.Coin" {
        record {
          cents "int"
        }
      }
      "Bank.MaybeCard" "Bank.Card?"
    }
    warp 1
  }
  test 1
}

