(test 1)
(name "the-object-of-a-field-read-past-a-possible-absence")
(note "A dot after `?.` or after `?[` reads a field of the declared struct the walk reached past the absence, so its step stands at the field's place with the mark riding on it, as a dot after a plain segment does. `p?.y`, `xs?[0].y` and `q.y` each read `y` at place 1.")

(program
  (warp 1)
  (struct App.P
    (field x Int)
    (field y Int))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter p (type (nullable App.P)))
    (parameter q (type App.P))
    (parameter xs (type (nullable (array App.P))))
    (returns Int)
    (body
      (let a (path p (field? y)))
      (let b (path xs (index? 0) (field y))))
    (result (path q (field y)))))
(expect (builds (dictionary (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"23b1e62e2e252442ff234d0ed3ef46ae174a920b1eb41510a4bc08b1cc0ae881")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "rows" (array (array "entry" (array (array (array "p" (array (array 13 (array 14 "App.P"))) (array)) (array "q" (array (array 14 "App.P")) (array)) (array "xs" (array (array 13 (array 7 (array 14 "App.P")))) (array))) (array 4) (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array (array 0 3)) (array 1 (array 0 (array (array 0 1 "y" true)))) "a") (array (array (array 0 4)) (array 1 (array 2 (array (array 2 (array 2 0) true) (array 0 1 "y" false)))) "b")) (array (array 1 (array 1 (array (array 0 1 "y" false)))))) (array 5 (array 0 1 2) (array) (array) (array "p" "q" "xs" "a" "b")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "types" (array (array "App.P" (array 9 (array (array "x" (array 4)) (array "y" (array 4))))))) (entry "variables" (array)))))
