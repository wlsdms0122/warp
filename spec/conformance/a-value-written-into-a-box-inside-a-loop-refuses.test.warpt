warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-written-into-a-box-inside-a-loop-refuses"
  note "A round runs no fixed number of times, so whether a box written inside one holds a value written `linear` afterwards is not something the text says. The write refuses even where the body hands on what the box holds after the loop."
  program {
    imports [
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "App.open"
              }
            }
            var "handle"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
          {
            let "spin"
            value {
              loop {
                body [
                  {
                    set "handle"
                    value {
                      call {
                        procedure "App.open"
                      }
                    }
                  }
                ]
                while false
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

