warpt 1
{
  expect {
    answers 3
  }
  name "a-constraint-is-named-by-its-qualified-spelling"
  note "A constraint name is its declared spelling with the declaring module in front. `std` declares Comparable, so a bound that means it writes `std.Comparable`."
  program {
    imports [
      "std.Comparable"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              value 3
            }
            procedure "keep"
          }
        }
        returns "int"
      }
      keep {
        bounds {
          T "std.Comparable"
        }
        parameters {
          value {
            type "some T"
          }
        }
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 1
}

