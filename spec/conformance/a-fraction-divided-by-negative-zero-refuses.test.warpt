(test 1)
(name "a-fraction-divided-by-negative-zero-refuses")
(note "`-0.0` is a zero divisor as `0.0` is, so `1.5` divided by it refuses at the run.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.dividedBy 1.5 -0.0)))))
(expect (refuses run))
