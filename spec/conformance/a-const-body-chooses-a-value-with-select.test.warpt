warpt 1
{
  arguments {
    item 3
  }
  expect {
    answers "small"
  }
  name "a-const-body-chooses-a-value-with-select"
  note "A conditional answers nothing, so a body that answers without running chooses with a procedure. The side not chosen goes unasked, which is why both sides are procedures."
  program {
    imports [
      "Standard.Logic.select"
      "Standard.Math.lessThan"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "int"
          }
        ]
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      ref "item"
                    }
                    10
                  ]
                  procedure "Standard.Math.lessThan"
                }
              }
              {
                closure {
                  result "small"
                  returns "string"
                }
              }
              {
                closure {
                  result "large"
                  returns "string"
                }
              }
            ]
            procedure "Standard.Logic.select"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

