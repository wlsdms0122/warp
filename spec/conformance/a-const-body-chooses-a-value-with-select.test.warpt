warpt 1
{
  arguments {
    item 3
  }
  expect {
    answers "small"
  }
  name "a-const-body-chooses-a-value-with-select"
  note "A conditional answers nothing, so a body that answers without running chooses with a procedure. The side not chosen goes unasked, which is why both sides are procedures."
  program {
    imports [
      "std.logic.select"
      "std.math.lessThan"
    ]
    procedures {
      entry {
        access "public"
        parameters {
          item {
            type "int"
          }
        }
        result {
          call {
            arguments {
              else {
                closure {
                  result "large"
                  returns "string"
                }
              }
              then {
                closure {
                  result "small"
                  returns "string"
                }
              }
            }
            of {
              call {
                arguments {
                  value 10
                }
                of {
                  ref "item"
                }
                procedure "std.math.lessThan"
              }
            }
            procedure "std.logic.select"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 2
}

