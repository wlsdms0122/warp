warpt 1
{
  expect {
    refuses "build"
  }
  name "what-is-written-fits-the-type-the-path-reaches"
  note "A path write is judged against the type it reaches: writing a string into a field declared `var Int` refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "App.P"
            value {
              record {
                x 1
              }
            }
            var "p"
          }
          {
            set "p.x"
            value "five"
          }
        ]
        result {
          ref "p.x"
        }
        returns "Int"
      }
    }
    types {
      "App.P" {
        record {
          x "var Int"
        }
      }
    }
    warp 1
  }
  test 1
}

