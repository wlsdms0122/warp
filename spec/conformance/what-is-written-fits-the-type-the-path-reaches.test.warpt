(test 1)
(name "what-is-written-fits-the-type-the-path-reaches")
(note "A path write is judged against the type it reaches: writing a string into a field declared `var Int` refuses at the build.")

(program
  (warp 1)
  (struct App.P
    (field x (var Int)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var p (type App.P) (struct (field x 1)))
      (set (path p (field x)) "five")
      (return (path p (field x))))))
(expect (refuses build))
