(test 1)
(name "a-const-map-rewrites-in-order")
(note "Standard.Collection.map reads each element through a closure that answers without running and answers the rewrites in the collection's order.")

(program
  (warp 1)
  (import Standard.Collection.map)
  (import Standard.Numeric.times)
  (procedure entry
    (access public)
    (const)
    (returns (array Int))
    (result
      (call Standard.Collection.map
        (array 1 2 3)
        (closure
          (const)
          (isolated)
          (parameter item (type Int))
          (returns Int)
          (result (call Standard.Numeric.times item 2)))))))
(expect (answers (array 2 4 6)))
