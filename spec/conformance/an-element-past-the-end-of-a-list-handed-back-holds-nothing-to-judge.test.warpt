warpt 1
{
  expect {
    answers []
  }
  name "an-element-past-the-end-of-a-list-handed-back-holds-nothing-to-judge"
  note "app.g takes a list and its first element in place, at its own type parameters, and proves nothing, so the call judges what it hands back. It empties the list and leaves the element, which is now past the end, so there is nothing there to judge, and the list answers empty."
  program {
    imports []
    procedures {
      "app.g" {
        body [
          {
            let "y"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "j"
                  }
                ]
                procedure "app.h"
              }
            }
          }
          {
            set "a"
            value []
          }
        ]
        parameters [
          {
            name "a"
            type "inout array<some T>"
          }
          {
            name "b"
            type "inout some T"
          }
          {
            name "j"
            type "any"
          }
        ]
        result 0
      }
      "app.h" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "j"
            type "any"
          }
        ]
        result {
          ref "j"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            value [
              1
            ]
            var "xs"
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  {
                    ref "xs[0]"
                  }
                  5
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
      }
    }
    warp 1
  }
  test 1
}

