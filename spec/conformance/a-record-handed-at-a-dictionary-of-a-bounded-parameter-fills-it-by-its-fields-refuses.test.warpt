warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-handed-at-a-dictionary-of-a-bounded-parameter-fills-it-by-its-fields-refuses"
  note "`App.g` bounds `T` by `App.M`, which admits `Int` and `String`, and takes `Dictionary<some T>`. The record `{ b: true }` handed there is read as a dictionary, so its field fills `T` with `Bool`, which no member admits, and the call refuses at the build."
  program {
    constraints {
      "App.M" [
        "Int"
        "String"
      ]
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "Dictionary<some T>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      b true
                    }
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

