warpt 1
{
  expect {
    refuses "run"
  }
  name "times-off-the-ints-edge-refuses"
  note "Whole-number arithmetic with no whole answer refuses at the run. `times` past the int's edge does not wrap and does not widen."
  program {
    imports [
      "Standard.Math.times"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              4611686018427387904
              2
            ]
            procedure "Standard.Math.times"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

