warpt 1
{
  expect {
    refuses "build"
  }
  name "a-write-into-an-entry-of-a-declared-dictionary-is-judged-against-its-entry-type-refuses"
  note "`r` declares `Dictionary<String, Int>`, and `set r.x` writes text into an entry. A write is judged against the type its path reaches, an entry's included, so the write refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "Dictionary<String, Int>"
            value {
              record {
                x 0
              }
            }
            var "r"
          }
          {
            set "r.x"
            value "nine"
          }
        ]
        result {
          ref "r.x"
        }
      }
    }
    warp 1
  }
  test 1
}

