(test 1)
(name "floored-past-the-int-refuses")
(note "floored and rounded answer an int, and a fraction whose whole part is past the int has no int to answer. The refusal is the overflow rule, the same one arithmetic holds at the int's edge.")

(program
  (warp 1)
  (import Standard.Math.floored)
  (procedure entry
    (access public)
    (returns Int)
    (result (call Standard.Math.floored 1e+30))))
(expect (refuses run))
