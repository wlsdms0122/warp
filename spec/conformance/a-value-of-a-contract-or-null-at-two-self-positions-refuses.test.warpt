(test 1)
(name "a-value-of-a-contract-or-null-at-two-self-positions-refuses")
(note "A value read as `App.Same?` is of whichever type answers the contract, or `Null`, and `Self` is one type wherever it stands, so handing two such readings at `lhs` and `rhs` refuses at the build.")

(program
  (warp 1)
  (contract App.Same
    (procedure same
      (parameter lhs (type Self))
      (parameter rhs (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Same)
    (procedure same
      (parameter lhs (type Int))
      (parameter rhs (type Int))
      (returns String)
      (result "ii")))
  (extension
    (head Null)
    (satisfies App.Same)
    (procedure same
      (parameter lhs (type Null))
      (parameter rhs (type Null))
      (returns String)
      (result "nn")))
  (extension
    (head String)
    (satisfies App.Same)
    (procedure same
      (parameter lhs (type String))
      (parameter rhs (type String))
      (returns String)
      (result "ss")))
  (procedure App.pair
    (parameter a (type (nullable App.Same)))
    (parameter b (type (nullable App.Same)))
    (returns String)
    (result (call App.Same.same a b)))
  (procedure entry
    (access public)
    (returns String)
    (result (call App.pair 1 "s"))))
(expect (refuses build))
