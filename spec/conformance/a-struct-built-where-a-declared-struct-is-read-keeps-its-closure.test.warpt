(test 1)
(name "a-struct-built-where-a-declared-struct-is-read-keeps-its-closure")
(note "A struct built from parts where a declared struct is read takes the name where it is built, so the closure written in one of its fields stays where it was judged and a call through its field returns 1.")

(program
  (warp 1)
  (struct App.G
    (field f (procedure (parameters) (returns Int)))
    (field n Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let m (type Int) 2)
      (let h
        (type App.G)
        (struct
          (field f
            (closure
              (returns Int)
              (body
                (return 1))))
          (field n m)))
      (return (apply (path h (field f)))))))
(expect (answers 1))
