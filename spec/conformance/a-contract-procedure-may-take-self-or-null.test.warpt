(test 1)
(name "a-contract-procedure-may-take-self-or-null")
(note "`App.Pick.pick` takes `Self` and then `Self?`. The claim about `Int` reads the second as `Int?`, which `Int.pick` takes, and the call fills `Self` with `Int` from its first argument and hands null at the second.")

(program
  (warp 1)
  (contract App.Pick
    (procedure pick
      (parameter lhs (type Self))
      (parameter rhs (type (nullable Self)))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Pick)
    (procedure pick
      (parameter lhs (type Int))
      (parameter rhs (type (nullable Int)))
      (returns String)
      (result "ip")))
  (procedure entry
    (access public)
    (returns String)
    (result (call App.Pick.pick 1 null))))
(expect (answers "ip"))
