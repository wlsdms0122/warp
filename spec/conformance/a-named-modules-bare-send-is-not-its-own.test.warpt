warpt 1
{
  expect {
    refuses "load"
  }
  name "a-named-modules-bare-send-is-not-its-own"
  note "A document named `wallet` declares `wallet.fee` and sends `fee`. That spelling is not one the document declares, so it is a word the document imports, and a list that leaves it out is refused when the module is made."
  program {
    imports []
    name "wallet"
    procedures {
      entry {
        result {
          call {
            procedure "fee"
          }
        }
        returns "int"
      }
      fee {
        result 7
        returns "int"
      }
    }
    warp 1
  }
  test 1
}
