(test 1)
(name "a-generic-body-handing-a-value-its-bounds-do-not-put-under-a-head-refuses")
(note "A procedure bounding `T` by nothing hands a box of `T` where App.Describable is asked, and `App.Box<some T: Hashable>` takes only a box of what answers `Hashable`, so the build refuses the call.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some T Hashable)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call relay (struct (field item 1))))))
  (procedure relay
    (parameter b (type (named App.Box (some T))))
    (returns String)
    (body
      (return (call App.Describable.describe b)))))
(expect (refuses build))
