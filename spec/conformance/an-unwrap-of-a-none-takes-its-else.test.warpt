(test 1)
(name "an-unwrap-of-a-none-takes-its-else")
(note "`o` holds `null`, the none, so the unwrap takes its `else` way and `then` does not run. Handed `null`, `else` writes 7.")

(program
  (warp 1)
  (procedure App.f
    (parameter o (type (optional Int)))
    (returns Int)
    (body
      (var n 0)
      (let x
        (unwrap o
          (then
            (set n x))
          (else
            (set n 7))))
      (return n)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.f null)))))
(expect (answers 7))
