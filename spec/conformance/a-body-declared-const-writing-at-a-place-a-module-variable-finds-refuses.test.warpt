(test 1)
(name "a-body-declared-const-writing-at-a-place-a-module-variable-finds-refuses")
(note "`App.read` is declared const and writes its own list at `a[count]`, where `count` is a module variable. Writing a place reads what finds it, so the body reads the module variable, and a body declared const reads nothing outside the run.")

(program
  (warp 1)
  (var count 1)
  (procedure App.read
    (const)
    (returns (array Int))
    (body
      (var a (array 0 0))
      (set (path a (index count)) 5))
    (result a))
  (procedure entry
    (access public)
    (returns (array Int))
    (result (call App.read))))
(expect (refuses build))
