warpt 1
{
  expect {
    answers [
      [
        1
      ]
      2
    ]
  }
  name "a-nested-list-literal-handed-at-a-parameter-bounded-by-a-recursive-membership-answers"
  note "`App.g` takes `some T` bounded by `App.M`, which admits `Int` and `Array<App.M>`. The call hands `[[1], 2]`, each part one of `App.M`, so the build takes it read part by part and the run answers it back."
  program {
    constraints {
      "App.M" [
        "Int"
        "Array<App.M>"
      ]
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    [
                      1
                    ]
                    2
                  ]
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

