warpt 1
{
  expect {
    refuses "run"
  }
  name "a-write-into-an-entry-of-a-declared-dictionary-settles-to-its-entry-type-refuses"
  note "`r` declares `dictionary<int(0...3)>`, and `set r.x` writes 9 into an entry. A write settles to the type its path reaches, an entry's included, and 9 is outside `int(0...3)`, so the run refuses the write."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "dictionary<int(0...3)>"
            value {
              record {
                x 0
              }
            }
            var "r"
          }
          {
            set "r.x"
            value {
              call {
                arguments [
                  4
                  5
                ]
                procedure "std.math.plus"
              }
            }
          }
        ]
        result {
          ref "r.x"
        }
      }
    }
    warp 1
  }
  test 1
}

