warpt 1
{
  expect {
    answers 7
  }
  name "a-constant-settles-from-a-host-procedure"
  note "A constant settles at the build from procedures that answer without running. The runner brings the one this asks for, and the answer is in the image before anything runs."
  program {
    const {
      seat {
        call {
          procedure "app.seat"
        }
      }
    }
    imports [
      "app.seat"
    ]
    procedures {
      entry {
        result {
          ref "seat"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 3
  vocabulary {
    procedures {
      "app.seat" {
        answers 7
        returns "int"
      }
    }
  }
}
