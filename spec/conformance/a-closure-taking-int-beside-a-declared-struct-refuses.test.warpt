(test 1)
(name "a-closure-taking-int-beside-a-declared-struct-refuses")
(note "The point fills `T` with `App.Point`, and the closure taking `Int` does not take the `App.Point` the slot hands it, so the call refuses at the build.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (procedure App.make
    (parameter x (type (some T)))
    (parameter f (type (procedure (parameters (some T)) (returns Any))))
    (returns (procedure (parameters (some T)) (returns Any)))
    (body
      (return f)))
  (procedure entry
    (access public)
    (returns Any)
    (failing (anything))
    (body
      (let h
        (call App.make
          (as (struct (field x 1)) App.Point)
          (closure
            (parameter p (type Int))
            (returns Any)
            (body
              (return p)))))
      (return (apply h (as (struct (field x 3)) App.Point))))))
(expect (refuses build))
