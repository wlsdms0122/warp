warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-taking-int-beside-a-declared-struct-refuses"
  note "The point fills `T` with `App.Point`, and the closure taking `Int` does not take the `App.Point` the slot hands it, so the call refuses at the build."
  program {
    imports []
    procedures {
      "App.make" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "f"
            type "(some T) -> Any"
          }
        ]
        result {
          ref "f"
        }
        returns "(some T) -> Any"
      }
      entry {
        access "public"
        body [
          {
            let "h"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        struct {
                          x 1
                        }
                      }
                      type "App.Point"
                    }
                  }
                  {
                    closure {
                      parameters [
                        {
                          name "p"
                          type "Int"
                        }
                      ]
                      result {
                        ref "p"
                      }
                      returns "Any"
                    }
                  }
                ]
                procedure "App.make"
              }
            }
          }
        ]
        failing "anything"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    struct {
                      x 3
                    }
                  }
                  type "App.Point"
                }
              }
            ]
            procedure {
              ref "h"
            }
          }
        }
        returns "Any"
      }
    }
    types {
      "App.Point" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

