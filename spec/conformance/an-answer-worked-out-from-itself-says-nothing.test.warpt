warpt 1
{
  expect {
    refuses "link"
  }
  name "an-answer-worked-out-from-itself-says-nothing"
  note "Reading what `ping` answers needs what `pong` answers, and reading that needs `ping` again. An answer worked out from itself is not one the text states, so the reading is `any` — and a dot on `any` is refused. Writing `returns` says more, and removes the circle by saying it."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            call {
              procedure "ping"
            }
            id "said"
          }
        ]
        result {
          ref "said.total"
        }
      }
      ping {
        result {
          call {
            procedure "pong"
          }
        }
      }
      pong {
        result {
          call {
            procedure "ping"
          }
        }
      }
    }
    warp 1
  }
  test 1
}
