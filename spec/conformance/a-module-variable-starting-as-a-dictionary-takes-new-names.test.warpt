warpt 1
{
  expect {
    answers [
      "a"
      "b"
    ]
  }
  name "a-module-variable-starting-as-a-dictionary-takes-new-names"
  note "A module variable's type is the type of its settled value, and a dictionary's names are data: what it reads as is what its entries hold, whatever names hold them today. So a variable started as an empty dictionary is written under new names."
  program {
    imports [
      "std.collection.keys"
      "std.collection.setting"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "a"
                  1
                ]
                procedure "std.collection.setting"
              }
            }
          }
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "b"
                  2
                ]
                procedure "std.collection.setting"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "seen"
              }
            ]
            procedure "std.collection.keys"
          }
        }
        returns "array<string>"
      }
    }
    var {
      seen {
        as {
          of {
            record {}
          }
          type "dictionary<int>"
        }
      }
    }
    warp 1
  }
  test 1
}

