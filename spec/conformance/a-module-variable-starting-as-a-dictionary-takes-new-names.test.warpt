warpt 1
{
  expect {
    answers [
      "a"
      "b"
    ]
  }
  name "a-module-variable-starting-as-a-dictionary-takes-new-names"
  note "A module variable that declares no type holds the type its start reads as, and the start here is an empty map cast to `Dictionary<Int>`, which says what the box will hold. A dictionary's names are data, so what it reads as is what its entries hold, whatever names hold them today, and the variable is written under new names."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Collection.setting"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "a"
                  1
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "b"
                  2
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "seen"
              }
            ]
            procedure "Standard.Collection.keys"
          }
        }
        returns "Array<String>"
      }
    }
    var {
      seen {
        as {
          of {
            record {}
          }
          type "Dictionary<Int>"
        }
      }
    }
    warp 1
  }
  test 1
}

