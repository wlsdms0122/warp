(test 1)
(name "the-object-of-a-conditional")
(note "A conditional carries its condition and two instruction lists, and a write into a variable each arm makes is an assignment binding to the variable's slot.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter flag (type Bool))
    (returns Int)
    (body
      (var chosen 0)
      (conditional
        (when flag)
        (then
          (set chosen 1))
        (else
          (set chosen 2))))
    (result chosen)))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)) (array 1 (array)) (array 1 (array)) (array 1 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"8d9a9cd577a9bf458fa729c5e0f4f3af21ca9e9d0b8ad1f090e0220c2007c79c")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 0 1) (array 0 2) (array 8 1 (array (array (array (array 2 1)) 2 "chosen")) (array (array (array (array (array 2 2)) 3 "chosen")))) (array 1 3))) (entry "rows" (array (array "entry" (array (array (array "flag" (array 0) (array))) 1 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array (array 1 1)) 0 "chosen") (array (array) 4 "[1]")) (array 5)) (array 2 (array 0) (array) (array) (array "flag" "chosen")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 3) (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 0) (array 2 1) (array 2 2))) (entry "variables" (array)))))
