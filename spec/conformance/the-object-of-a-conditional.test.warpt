  name "the-object-of-a-conditional"
  note "A conditional carries its condition and two instruction lists, and a write into a variable each arm makes is an assignment binding to the variable's slot."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "chosen"
          }
          {
            value {
              conditional {
                else [
                  {
                    set "chosen"
                    value 2
                  }
                ]
                then [
                  {
                    set "chosen"
                    value 1
                  }
                ]
                when {
                  ref "flag"
