warpt 1
{
  expect {
    answers 0
  }
  name "a-record-of-member-fields-handed-at-a-dictionary-of-a-bounded-parameter-answers"
  note "`app.g` bounds `T` by `app.M`, which admits `int` and `string`, and takes `dictionary<some T>`. The record `{ a: 1, b: \"s\" }` handed there is read as a dictionary: its fields joined fill `T`, as a list's elements do, and each field is a member, so it builds and answers 0."
  program {
    constraints {
      "app.M" [
        "int"
        "string"
      ]
    }
    imports []
    procedures {
      "app.g" {
        bounds {
          T "app.M"
        }
        parameters [
          {
            name "x"
            type "dictionary<some T>"
          }
        ]
        result 0
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      a 1
                      b "s"
                    }
                  }
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

