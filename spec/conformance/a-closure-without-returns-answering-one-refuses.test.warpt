warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-without-returns-answering-one-refuses"
  note "A body carried as a value may not answer a value written `linear`, and the rule turns on what the walk finds rather than on whether `returns` was written."
  program {
    imports [
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "made"
            value {
              closure {
                result {
                  call {
                    procedure "App.open"
                  }
                }
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

