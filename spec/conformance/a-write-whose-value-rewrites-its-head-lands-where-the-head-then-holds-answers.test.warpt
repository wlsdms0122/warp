warpt 1
{
  expect {
    answers 1
  }
  name "a-write-whose-value-rewrites-its-head-lands-where-the-head-then-holds-answers"
  note "The value is computed before the write lands, and may itself write the head, so a path write lands where the head holds after the value. `w` holds an `App.A`, whose map is keyed by `Double`; the value writes an `App.B` into `w`, whose map is keyed by `Int`, so the key `1` is written as an `Int` and the map holds two `Int` keys."
  program {
    imports [
      "Standard.Collection.keys"
    ]
    procedures {
      "App.mkA" {
        result {
          record {
            p {
              dictionary [
                [
                  2.5
                  1
                ]
              ]
            }
          }
        }
        returns "App.A"
      }
      "App.mkB" {
        result {
          record {
            p {
              dictionary [
                [
                  2
                  1
                ]
              ]
            }
          }
        }
        returns "App.B"
      }
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "App.mkA"
              }
            }
            var "w"
          }
          {
            set "w.p[1]"
            value {
              block {
                body [
                  {
                    set "w"
                    value {
                      call {
                        procedure "App.mkB"
                      }
                    }
                  }
                ]
                result 5
              }
            }
          }
          {
            let "ks"
            type "Array<Int>"
            value {
              call {
                arguments [
                  {
                    ref "w.p"
                  }
                ]
                procedure "Standard.Collection.keys"
              }
            }
          }
        ]
        result {
          ref "ks[0]"
        }
        returns "Int"
      }
    }
    types {
      "App.A" {
        record {
          p "var Dictionary<Double, Int>"
        }
      }
      "App.B" {
        record {
          p "var Dictionary<Int, Int>"
        }
      }
    }
    warp 1
  }
  test 1
}

