(test 1)
(name "a-constant-closure-called-with-another-count-refuses")
(note "A constant holds the type its expression was judged at, so `f` reads as the procedure type its closure literal wrote. A call handing it two arguments where that type takes one refuses at the build, the callee being known there.")

(program
  (warp 1)
  (const f
    (closure
      (parameter x (type Int))
      (returns Int)
      (result x)))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let a (apply f 1 2)))
    (result a)))
(expect (refuses build))
