(test 1)
(name "a-list-holding-a-list-that-breaks-spells-as-text")
(note "A list breaks when it is a block holding a list, or holds a list that breaks, keeping the atoms it begins with on its first line. The call holds a closure, a block that breaks, so the call breaks after its callee, and the `result` around it breaks too.")
(text "(warp 1)\n\n(procedure App.g\n  (parameter f (type (procedure (parameters) (returns Int))))\n  (returns Int)\n  (result (apply f)))\n\n(procedure entry\n  (access public)\n  (returns Int)\n  (result\n    (call App.g\n      (closure\n        (returns Int)\n        (result 1)))))\n")
(expect (spells (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "App.g" (dictionary (entry "parameters" (array (dictionary (entry "name" "f") (entry "type" "() -> Int")))) (entry "result" (dictionary (entry "call" (dictionary (entry "procedure" (dictionary (entry "ref" "f"))))))) (entry "returns" "Int"))) (entry "entry" (dictionary (entry "access" "public") (entry "result" (dictionary (entry "call" (dictionary (entry "arguments" (array (dictionary (entry "closure" (dictionary (entry "result" 1) (entry "returns" "Int")))))) (entry "procedure" "App.g"))))) (entry "returns" "Int"))))) (entry "warp" 1))))
