warpt 1
{
  expect {
    answers "a card"
  }
  name "a-value-of-a-membership-answers-a-contract-every-member-satisfies"
  note "A value of a membership is one of its members and nothing says which, so it stands where a contract is asked when every member satisfies the contract, and the run reads the name the value wears."
  program {
    constraints {
      "app.Paying" [
        "bank.Account"
        "bank.Card"
      ]
    }
    contracts {
      "app.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.pick" {
        parameters [
          {
            name "of"
            type "app.Paying"
          }
        ]
        result {
          ref "of"
        }
        returns "app.Paying"
      }
      "app.tell" {
        parameters [
          {
            name "it"
            type "app.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
      "bank.Account.describe" {
        parameters [
          {
            name "of"
            type "bank.Account"
          }
        ]
        result "an account"
        returns "string"
      }
      "bank.Card.describe" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "paying"
            value {
              call {
                arguments [
                  {
                    ref "card"
                  }
                ]
                procedure "app.pick"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "paying"
              }
            ]
            procedure "app.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "bank.Account" [
        "app.Describable"
      ]
      "bank.Card" [
        "app.Describable"
      ]
    }
    types {
      "bank.Account" {
        record {
          number "string"
        }
      }
      "bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

