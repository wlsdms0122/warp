warpt 1
{
  expect {
    answers "a card"
  }
  name "a-value-of-a-membership-answers-a-contract-every-member-satisfies"
  note "A value of a membership is one of its members and nothing says which, so it stands where a contract is asked when every member satisfies the contract, and the run reads the name the value wears."
  program {
    constraints {
      "App.Paying" [
        "Bank.Account"
        "Bank.Card"
      ]
    }
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.pick" {
        parameters [
          {
            name "of"
            type "App.Paying"
          }
        ]
        result {
          ref "of"
        }
        returns "App.Paying"
      }
      "App.tell" {
        parameters [
          {
            name "it"
            type "App.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
        ]
        result "an account"
        returns "String"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "paying"
            value {
              call {
                arguments [
                  {
                    ref "card"
                  }
                ]
                procedure "App.pick"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "paying"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    satisfies {
      "Bank.Account" [
        "App.Describable"
      ]
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Account" {
        record {
          number "String"
        }
      }
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

