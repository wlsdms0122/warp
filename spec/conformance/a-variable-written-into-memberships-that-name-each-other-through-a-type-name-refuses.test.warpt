warpt 1
{
  expect {
    refuses "build"
  }
  name "a-variable-written-into-memberships-that-name-each-other-through-a-type-name-refuses"
  note "`App.AN` is a name for `App.N`. `App.M` admits `App.AN` and `array<int>`, and `App.N` admits `App.M` and `bool`. A variable declared `App.M` starts with a name read as `array<string>`. Through the name, `App.N` asks `App.M` of the same reading again, which takes nothing, so the build refuses."
  program {
    constraints {
      "App.M" [
        "App.AN"
        "array<int>"
      ]
      "App.N" [
        "App.M"
        "bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "s"
            type "array<string>"
            value [
              "a"
            ]
          }
          {
            type "App.M"
            value {
              ref "s"
            }
            var "x"
          }
        ]
        result 0
      }
    }
    types {
      "App.AN" "App.N"
    }
    warp 1
  }
  test 1
}

