warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bare-array-refuses"
  note "A list says what it holds. `array<any>` is a list of anything, and the bare word `array` is not a second spelling of it, so a type written that way is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          items {
            type "array"
          }
        }
        result {
          ref "items"
        }
      }
    }
    warp 1
  }
  test 2
}

