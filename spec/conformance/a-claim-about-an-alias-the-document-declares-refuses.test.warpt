warpt 1
{
  expect {
    refuses "load"
  }
  name "a-claim-about-an-alias-the-document-declares-refuses"
  note "App.Num names Int, and the document that declares it gives it a contract. A value of App.Num is an instance of `Int` and of no other name, and a document gives a type it declares what it gives it in the declaration, which an alias has none of, so the load refuses it."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      "App.Num" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Num"
              }
            ]
            result "a number"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "n"
            value {
              call {
                procedure "make"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
      make {
        result 3
        returns "App.Num"
      }
    }
    types {
      "App.Num" "Int"
    }
    warp 1
  }
  test 1
}

