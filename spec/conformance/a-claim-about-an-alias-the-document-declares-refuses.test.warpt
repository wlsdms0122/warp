(test 1)
(name "a-claim-about-an-alias-the-document-declares-refuses")
(note "App.Num names Int, and the document that declares it gives it a contract. A value of App.Num is an instance of `Int` and of no other name, and a document gives a type it declares what it gives it in the declaration, which an alias has none of, so the load refuses it.")

(program
  (warp 1)
  (type App.Num Int)
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head App.Num)
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type App.Num))
      (returns String)
      (result "a number")))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let n (call make))
      (let s (call App.Describable.describe n)))
    (result s))
  (procedure make
    (returns App.Num)
    (result 3)))
(expect (refuses load))
