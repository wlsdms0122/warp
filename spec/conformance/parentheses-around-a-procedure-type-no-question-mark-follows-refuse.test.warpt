(test 1)
(name "parentheses-around-a-procedure-type-no-question-mark-follows-refuse")
(note "Parentheses group a type, and a document writes them where a `?` after them makes a whole procedure type nullable. `((Int) -> Int)` says what `(Int) -> Int` says, and one type is written one way, so the parentheses refuse at the load.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "f") (entry "type" "((Int) -> Int)") (entry "value" (dictionary (entry "closure" (dictionary (entry "parameters" (array (dictionary (entry "name" "x") (entry "type" "Int")))) (entry "result" (dictionary (entry "ref" "x"))) (entry "returns" "Int")))))))) (entry "result" 1) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
