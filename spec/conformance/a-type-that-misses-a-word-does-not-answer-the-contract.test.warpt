warpt 1
{
  expect {
    refuses "link"
  }
  name "a-type-that-misses-a-word-does-not-answer-the-contract"
  note "What puts a type under a contract is that it declares every word the contract asks, under its own name. A type declaring none of them does not stand where the contract bounds a parameter, and the link says so where the value is handed over."
  program {
    contracts {
      "app.Describable" {
        describe {
          returns "string"
        }
      }
    }
    imports []
    procedures {
      entry {
        body [
          {
            let "plain"
            value {
              as "bank.Plain"
              of {
                note "x"
              }
            }
          }
        ]
        result {
          call {
            of {
              ref "plain"
            }
            procedure "app.tell"
          }
        }
        returns "string"
      }
      "app.tell" {
        bounds {
          T "app.Describable"
        }
        parameters {
          it "some T"
        }
        receiver "it"
        result {
          call {
            of {
              ref "it"
            }
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
      "bank.Account.describe" {
        parameters {
          of "bank.Account"
        }
        receiver "of"
        result "an account"
        returns "string"
      }
    }
    types {
      "bank.Account" {
        balance "int"
      }
      "bank.Plain" {
        note "string"
      }
    }
    warp 1
  }
  test 1
}
