warpt 1
{
  expect {
    answers 2.0
  }
  name "a-whole-number-is-a-fraction"
  note "A whole number handed to a `Double` slot settles to the fraction it names. The reverse refuses."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              2
            ]
            procedure "wants"
          }
        }
        returns "Double"
      }
      wants {
        parameters [
          {
            name "it"
            type "Double"
          }
        ]
        result {
          ref "it"
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

