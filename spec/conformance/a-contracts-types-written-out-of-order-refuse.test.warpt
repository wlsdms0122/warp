(test 1)
(name "a-contracts-types-written-out-of-order-refuse")
(note "A contract lists the types it asks in name order, so `[B, A]` says `[A, B]` a second way.")

(program
  (warp 1)
  (contract App.C
    (type B)
    (type A))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
