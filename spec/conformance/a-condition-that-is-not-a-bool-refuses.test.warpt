(test 1)
(name "a-condition-that-is-not-a-bool-refuses")
(note "A condition chooses a way through a body, so what it reads is a bool. The build knows what the condition reads, so the refusal is the build's rather than the run's.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (body
      (conditional
        (when 1)
        (then
          (let kept 1))))))
(expect (refuses build))
