warpt 1
{
  expect {
    answers [
      {
        a 1
        b 2
      }
      {
        a 1
      }
    ]
  }
  name "setting-answers-a-new-record"
  note "setting answers a record with the field written — and a new record: the one it was given still holds what it held."
  program {
    needs [
      "std.collection.setting"
    ]
    procedures {
      entry {
        body [
          {
            id "data"
            value {
              a 1
            }
          }
          {
            call {
              arguments {
                key "b"
                value 2
              }
              of {
                ref "data"
              }
              procedure "std.collection.setting"
            }
            id "grown"
          }
        ]
        result [
          {
            ref "grown"
          }
          {
            ref "data"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}
