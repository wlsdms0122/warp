(test 1)
(name "a-contract-declared-twice-refuses")
(note "One name has one declarer. `App.C` is declared as a contract by the program and by the document beside it, and the build refuses.")

(documents
  (document
    (warp 1)
    (contract App.C)
    (extension
      (head Int)
      (satisfies App.C))
    (procedure Lib.f
      (returns Int)
      (result 1))))

(program
  (warp 1)
  (contract App.C)
  (extension
    (head Int)
    (satisfies App.C))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses build))
