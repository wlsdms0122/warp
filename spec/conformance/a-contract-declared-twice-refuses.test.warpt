warpt 1
{
  documents [
    {
      contracts {
        "App.C" {}
      }
      imports []
      procedures {
        "Lib.f" {
          result 1
        }
      }
      satisfies {
        Int [
          "App.C"
        ]
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-contract-declared-twice-refuses"
  note "One name has one declarer. `App.C` is declared as a contract by the program and by the document beside it, and the build refuses."
  program {
    contracts {
      "App.C" {}
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    satisfies {
      Int [
        "App.C"
      ]
    }
    warp 1
  }
  test 1
}

