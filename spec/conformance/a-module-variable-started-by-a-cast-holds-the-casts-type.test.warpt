warpt 1
{
  expect {
    answers [
      "a"
      "b"
    ]
  }
  name "a-module-variable-started-by-a-cast-holds-the-casts-type"
  note "A module variable that declares no type holds the type its start reads as, and the start here is an empty map cast to `Dictionary<String, Int>`, so the variable holds the cast's type and is written under new keys, a map's keys being data."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Collection.setting"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "a"
                  1
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "b"
                  2
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "seen"
              }
            ]
            procedure "Standard.Collection.keys"
          }
        }
        returns "Array<String>"
      }
    }
    var {
      seen {
        as {
          of {
            dictionary []
          }
          type "Dictionary<String, Int>"
        }
      }
    }
    warp 1
  }
  test 1
}

