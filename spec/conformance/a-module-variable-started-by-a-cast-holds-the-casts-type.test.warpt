(test 1)
(name "a-module-variable-started-by-a-cast-holds-the-casts-type")
(note "A module variable that declares no type holds the type its start reads as, and the start here is an empty dictionary cast to `Dictionary<String, Int>`, so the variable holds the cast's type and is written under new keys, a dictionary's keys being data.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (import Standard.Collection.setting)
  (var seen (as (dictionary) (dictionary String Int)))
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (set seen (call Standard.Collection.setting seen "a" 1))
      (set seen (call Standard.Collection.setting seen "b" 2))
      (return (call Standard.Collection.keys seen)))))
(expect (answers (array "a" "b")))
