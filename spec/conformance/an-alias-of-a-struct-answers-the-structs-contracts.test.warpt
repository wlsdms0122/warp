(test 1)
(name "an-alias-of-a-struct-answers-the-structs-contracts")
(note "Bank.Alias names the struct Bank.Card, which a document says answers App.Describable, so a value of Bank.Alias is handed where App.Describable is asked.")

(program
  (warp 1)
  (type Bank.Alias Bank.Card)
  (struct Bank.Card
    (satisfies App.Describable)
    (field last String)
    (procedure describe
      (parameter of (type Bank.Card))
      (returns String)
      (result "a card")))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "1")) Bank.Alias))
      (let s (call App.Describable.describe c)))
    (result s)))
(expect (answers "a card"))
