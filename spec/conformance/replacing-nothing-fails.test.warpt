(test 1)
(name "replacing-nothing-fails")
(note "A target with no characters matches everywhere and consumes nothing, so there is nothing `replacing` could swap. It fails with `aborted`, and an attempt around it catches it because it is a failure and not a refusal.")

(program
  (warp 1)
  (import Standard.Text.replacing)
  (procedure entry
    (access public)
    (returns (nullable (dictionary String String)))
    (body
      (let tried
        (attempt
          (body
            (call Standard.Text.replacing "abc" "" "x"))
          (rescue
            (result (dictionary (entry "message" (path tried (field message))) (entry "type" (path tried (field type)))))))))
    (result tried)))
(expect (answers (dictionary (entry "message" "replacing asks an empty piece") (entry "type" "aborted"))))
