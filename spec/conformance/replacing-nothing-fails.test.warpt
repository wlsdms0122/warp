(test 1)
(name "replacing-nothing-fails")
(note "A target with no characters matches everywhere and consumes nothing, so there is nothing `replacing` could swap. It fails with `aborted`, and a try around it catches it because it is a failure and not a refusal.")

(program
  (warp 1)
  (import Standard.Text.replacing)
  (procedure entry
    (access public)
    (returns (optional (dictionary String String)))
    (body
      (var tried)
      (let caught
        (try
          (body
            (call Standard.Text.replacing "abc" "" "x"))
          (catch
            (set tried (dictionary (entry "message" (path caught (field message))) (entry "type" (path caught (field type))))))))
      (return tried))))
(expect (answers (dictionary (entry "message" "replacing asks an empty piece") (entry "type" "aborted"))))
