warpt 1
{
  expect {
    answers {
      message "replacing asks an empty piece"
      type "aborted"
    }
  }
  name "replacing-nothing-fails"
  note "A target with no characters matches everywhere and consumes nothing, so there is nothing `replacing` could swap. It fails with `aborted`, and an attempt around it catches it because it is a failure and not a refusal."
  program {
    imports [
      "Standard.Text.replacing"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          "abc"
                          ""
                          "x"
                        ]
                        procedure "Standard.Text.replacing"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    dictionary [
                      [
                        "message"
                        {
                          ref "tried.message"
                        }
                      ]
                      [
                        "type"
                        {
                          ref "tried.type"
                        }
                      ]
                    ]
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

