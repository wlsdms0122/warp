warpt 1
{
  expect {
    answers 1.5
  }
  name "arithmetic-whole-widens-to-fraction"
  note "Every whole number is a fraction and the reverse is false, so the conversion that cannot lose anything is the one that happens."
  program {
    imports [
      "Standard.Math.plus"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              0.5
            ]
            procedure "Standard.Math.plus"
          }
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

