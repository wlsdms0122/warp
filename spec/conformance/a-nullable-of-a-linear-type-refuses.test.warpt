warpt 1
{
  expect {
    refuses "build"
  }
  name "a-nullable-of-a-linear-type-refuses"
  note "A linear value needs a name holding it on every way through, and a `?` says there is a way through where nothing is there. `app.Handle?` is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "app.Handle?"
          }
        ]
        result 1
        returns "int"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

