warpt 1
{
  expect {
    refuses "build"
  }
  name "a-claim-about-procedure-answered-for-one-procedure-type-alone-refuses"
  note "A claim about `Procedure` is about every procedure, whatever it takes and answers, so a declaration answering it takes `Procedure`. `Procedure.describe` takes only a procedure from `Int` to `Int`, so the claim does not hold, and the call leaning on it refuses at the build."
  program {
    contracts {
      "App.Described" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Procedure.describe" {
        parameters [
          {
            name "of"
            type {
              procedure {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
          }
        ]
        result "x"
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                closure {
                  parameters [
                    {
                      name "n"
                      type "Int"
                    }
                  ]
                  result {
                    ref "n"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "App.Described.describe"
          }
        }
        returns "String"
      }
    }
    satisfies {
      Procedure [
        "App.Described"
      ]
    }
    warp 1
  }
  test 1
}

