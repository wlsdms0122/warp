(test 1)
(name "a-statement-after-a-call-answering-an-alias-of-never-refuses")
(note "`App.f` declares `App.N`, a name for `Never`, so a statement after its call would never run, and the build refuses it as it refuses one after a call declaring `Never`.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (type App.N Never)
  (procedure App.f
    (returns App.N)
    (failing aborted)
    (body
      (call Standard.Control.abort "no")))
  (procedure entry
    (access public)
    (returns Never)
    (failing aborted)
    (body
      (call App.f)
      (let y 2)
      (return 1))))
(expect (refuses build))
