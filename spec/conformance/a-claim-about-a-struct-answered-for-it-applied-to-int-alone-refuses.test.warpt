warpt 1
{
  documents [
    {
      imports []
      types {
        "App.Box" {
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-claim-about-a-struct-answered-for-it-applied-to-int-alone-refuses"
  note "A claim about `App.Box` is about every value of it, and a call through the contract hands the declaration any of them. `App.Box.describe` is given under `App.Box<Int>`, for boxes of whole numbers alone, so the claim does not hold and refuses at the build, at the claim."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      "App.Box" {
        satisfies [
          "App.Describable"
        ]
      }
      "App.Box<Int>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Box<Int>"
              }
            ]
            result "box"
            returns "String"
          }
        }
      }
    }
    imports [
      "App.Box"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

