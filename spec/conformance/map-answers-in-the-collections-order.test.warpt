warpt 1
{
  expect {
    answers [
      1
      2
      3
    ]
  }
  name "map-answers-in-the-collections-order"
  note "The concurrent reading of what each walks. Arrival order decides nothing: the answer sits where its element sat."
  program {
    imports [
      "std.concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "walked"
            value {
              call {
                arguments {
                  by {
                    closure {
                      parameters [
                        {
                          name "item"
                          type "int"
                        }
                        {
                          name "index"
                          type "int"
                        }
                      ]
                      result {
                        ref "item"
                      }
                    }
                  }
                }
                of [
                  1
                  2
                  3
                ]
                procedure "std.concurrent.map"
              }
            }
          }
        ]
        result {
          ref "walked"
        }
      }
    }
    warp 1
  }
  test 1
}

