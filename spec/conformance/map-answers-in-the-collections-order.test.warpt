warpt 1
{
  expect {
    answers [
      1
      2
      3
    ]
  }
  name "map-answers-in-the-collections-order"
  note "The concurrent reading of what each walks. Arrival order decides nothing: the answer sits where its element sat."
  program {
    imports [
      "Standard.Concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "walked"
            value {
              call {
                arguments [
                  [
                    1
                    2
                    3
                  ]
                  {
                    closure {
                      const true
                      isolated true
                      parameters [
                        {
                          name "item"
                          type "Int"
                        }
                        {
                          name "index"
                          type "Int"
                        }
                      ]
                      result {
                        ref "item"
                      }
                      returns "Int"
                    }
                  }
                ]
                procedure "Standard.Concurrent.map"
              }
            }
          }
        ]
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          ref "walked"
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

