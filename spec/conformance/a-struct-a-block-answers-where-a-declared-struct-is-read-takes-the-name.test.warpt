warpt 1
{
  expect {
    answers 1
  }
  name "a-struct-a-block-answers-where-a-declared-struct-is-read-takes-the-name"
  note "What a block answers stands where the name bound to it is read, so a struct it builds there takes the declared struct's name where it is built, and a slot of that struct takes it."
  program {
    imports []
    procedures {
      "App.useP" {
        parameters [
          {
            name "p"
            type "App.Point"
          }
        ]
        result {
          ref "p.x"
        }
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "n"
            type "Int"
            value 1
          }
          {
            let "p"
            type "App.Point"
            value {
              block {
                body [
                  {
                    let "m"
                    value 0
                  }
                ]
                result {
                  struct {
                    x {
                      ref "n"
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "p"
              }
            ]
            procedure "App.useP"
          }
        }
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          ps "Array<App.Point>"
        }
      }
      "App.Idx" "Int"
      "App.Key" "String"
      "App.O" {
        struct {
          p "Int"
        }
      }
      "App.Outer" {
        struct {
          p "App.Point"
        }
      }
      "App.Outer2" {
        struct {
          p "var App.Point"
        }
      }
      "App.P2" "App.Point"
      "App.Point" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

