warpt 1
{
  expect {
    refuses "load"
  }
  name "a-claim-about-a-type-the-language-names-refuses"
  note "A claim is about a declared type. A value of a type the language names wears no name a run could read, so no declaration could answer a contract for it, and a document claiming one does is refused where it is read."
  program {
    contracts {
      "App.Described" {
        describe {
          parameters [
            {
              name "of"
              type "App.Described"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "Int.describe" {
        parameters [
          {
            name "of"
            type "Int"
          }
        ]
        result "int"
        returns "string"
      }
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    satisfies {
      Int [
        "App.Described"
      ]
    }
    warp 1
  }
  test 1
}

