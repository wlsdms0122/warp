(test 1)
(name "a-map-literal-whose-keys-read-as-any-handed-through-a-contract-refuses")
(note "`Standard.Collection.count` is a call through a contract, answered for every map by a row whose key is bounded by `Hashable`. A map literal whose keys read as `Any` is refused where it is written, before any row could be entered with a key no bound holds.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call Standard.Collection.count (dictionary (entry 1 "a") (entry "b" 2)))))))
(expect (refuses build))
