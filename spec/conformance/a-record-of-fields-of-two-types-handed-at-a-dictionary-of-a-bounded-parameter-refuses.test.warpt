warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-of-fields-of-two-types-handed-at-a-dictionary-of-a-bounded-parameter-refuses"
  note "`App.g` bounds `T` by `App.M`, which `Int` and `String` answer, and takes `Dictionary<String, some T>`. The map literal holding `1` under `a` and `\"s\"` under `b` handed there fills `T` with its values joined, `Any`, which answers no contract, so the build refuses though each value answers. A bounded parameter is one type."
  program {
    contracts {
      "App.M" {}
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "Dictionary<String, some T>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    dictionary [
                      [
                        "a"
                        1
                      ]
                      [
                        "b"
                        "s"
                      ]
                    ]
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      Int [
        "App.M"
      ]
      String [
        "App.M"
      ]
    }
    warp 1
  }
  test 1
}

