warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-piece-calling-an-isolated-module-variable-stands"
  note "A module variable that declared its type `isolated Procedure` is a slot that said so. A piece that captured it and calls it writes only its own names, so `Standard.Concurrent.map` runs it."
  program {
    imports [
      "Standard.Concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      value {
                        call {
                          procedure {
                            ref "h"
                          }
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    ref "item"
                  }
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
      }
    }
    var {
      h {
        type "isolated Procedure"
        value {
          closure {
            result 0
          }
        }
      }
    }
    warp 1
  }
  test 1
}

