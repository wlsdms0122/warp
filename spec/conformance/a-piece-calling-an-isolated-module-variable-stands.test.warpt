(test 1)
(name "a-piece-calling-an-isolated-module-variable-stands")
(note "A module variable that declared its type an `isolated` procedure type is a slot that said so. A piece declaring `isolated` that calls `h` is held to that and stands, so `Standard.Concurrent.map` runs it.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (var h
    (type (procedure (isolated) (parameters) (returns Int)))
    (closure
      (const)
      (isolated)
      (returns Int)
      (result 0)))
  (procedure entry
    (access public)
    (isolated)
    (returns (array Int))
    (failing concurrent_failed)
    (result
      (call Standard.Concurrent.map
        (array 1 2)
        (closure
          (isolated)
          (parameter item (type Int))
          (parameter index (type Int))
          (returns Int)
          (body
            (apply h))
          (result item))))))
(expect (answers (array 1 2)))
