warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-piece-calling-an-isolated-module-variable-stands"
  note "A module variable that declared its type an `isolated` procedure type is a slot that said so. A piece declaring `isolated` that calls `h` is held to that and stands, so `Standard.Concurrent.map` runs it."
  program {
    imports [
      "Standard.Concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      value {
                        call {
                          procedure {
                            ref "h"
                          }
                        }
                      }
                    }
                  ]
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    ref "item"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<Int>"
      }
    }
    var {
      h {
        type "isolated () -> Int"
        value {
          closure {
            const true
            isolated true
            result 0
            returns "Int"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

