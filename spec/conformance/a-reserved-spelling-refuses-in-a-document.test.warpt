warpt 1
{
  expect {
    refuses "load"
  }
  name "a-reserved-spelling-refuses-in-a-document"
  note "`format`/`with` are a front end's spelling, spent before the document leaves. A document that writes them was written for a spelled notation, and reading them as data would run a program nobody wrote."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "line"
            value {
              format "${x}"
              with {
                x {
                  value 1
                }
              }
            }
          }
        ]
        result {
          ref "line"
        }
      }
    }
    warp 1
  }
  test 2
}

