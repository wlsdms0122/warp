warpt 1
{
  arguments {
    items [
      "a"
      "b"
      "c"
    ]
  }
  expect {
    answers 3
  }
  name "a-path-reaches-a-pure-word"
  note "A path only ever reaches a word that answers without running, so nothing a path reaches escapes the program. A path writes the word's last segment alone, so the document states which declaration it meant."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        parameters {
          items "array<string>"
        }
        result {
          ref "items.count"
        }
      }
    }
    warp 1
  }
  test 2
}
