warpt 1
{
  expect {
    answers 7
  }
  name "a-module-declares-a-constraint"
  note "A constraint is a declared membership: the module says which types Scalar admits, a slot writes only the parameter, the signature binds it in bounds, and the judgment a bounded parameter gets is the same one the standard procedures get."
  program {
    constraints {
      Scalar [
        "int"
        "string"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              value 7
            }
            procedure "keep"
          }
        }
        returns "int"
      }
      keep {
        bounds {
          T "Scalar"
        }
        parameters {
          value {
            type "some T"
          }
        }
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 2
}

