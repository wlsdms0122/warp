warpt 1
{
  arguments {
    it null
  }
  expect {
    refuses "run"
  }
  name "an-argument-is-held-to-its-parameter-at-the-run"
  note "An argument is held to its parameter at the run where the build could not judge it. `uppercased` declares `of: string`; a null that arrives there through `any` is not a string, and the run says so instead of reading it as nothing."
  program {
    imports [
      "std.text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "it"
            type "any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "std.text.uppercased"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

