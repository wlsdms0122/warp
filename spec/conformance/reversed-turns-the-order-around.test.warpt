warpt 1
{
  expect {
    answers [
      [
        3
        2
        1
      ]
      [
        1
        2
        3
      ]
    ]
  }
  name "reversed-turns-the-order-around"
  note "reversed answers the same elements back to front, and answers a new array rather than turning the one it was given."
  program {
    imports [
      "std.collection.reversed"
    ]
    procedures {
      entry {
        body [
          {
            let "items"
            value [
              1
              2
              3
            ]
          }
          {
            let "backwards"
            value {
              call {
                of {
                  ref "items"
                }
                procedure "std.collection.reversed"
              }
            }
          }
        ]
        result [
          {
            ref "backwards"
          }
          {
            ref "items"
          }
        ]
      }
    }
    warp 2
  }
  test 1
}
