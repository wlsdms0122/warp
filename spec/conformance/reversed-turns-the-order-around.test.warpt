(test 1)
(name "reversed-turns-the-order-around")
(note "reversed answers the same elements back to front, and answers a new array rather than turning the one it was given.")

(program
  (warp 1)
  (import Standard.Collection.reversed)
  (procedure entry
    (access public)
    (returns (array (array Int)))
    (body
      (let items (array 1 2 3))
      (let backwards (call Standard.Collection.reversed items))
      (return (array backwards items)))))
(expect (answers (array (array 3 2 1) (array 1 2 3))))
