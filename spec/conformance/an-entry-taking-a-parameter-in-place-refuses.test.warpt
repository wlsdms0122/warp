warpt 1
{
  arguments {
    count 1
  }
  expect {
    refuses "run"
  }
  name "an-entry-taking-a-parameter-in-place-refuses"
  note "A run hands its entry values, and a parameter handed in place takes a variable, so an entry taking one refuses at the run before anything runs, whatever value the run gives under its name."
  program {
    imports [
      "Standard.Math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "count"
            value {
              call {
                arguments [
                  {
                    ref "count"
                  }
                  1
                ]
                procedure "Standard.Math.plus"
              }
            }
          }
        ]
        parameters [
          {
            name "count"
            type "inout int"
          }
        ]
        result {
          ref "count"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

