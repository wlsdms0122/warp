(test 1)
(name "a-constant-closure-called-with-another-type-refuses")
(note "A constant holds the type its expression was judged at, so `f` reads as the procedure type its closure literal wrote. A string handed where that type takes an int refuses at the build.")

(program
  (warp 1)
  (const f
    (closure
      (parameter x (type Int))
      (returns Int)
      (result x)))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let a (apply f "s")))
    (result a)))
(expect (refuses build))
