warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-another-answer-refuses"
  note "The build holds a claim to the type's members: the member of the procedure's name takes the contract's signature with the type first. One answering an int where the contract writes a string backs no claim, and the claim refuses at the build, at the claim."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        bounds {
          T "App.Describable"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  struct {
                    balance 1
                  }
                }
                type "Bank.Account"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.Account" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Account"
              }
            ]
            result 1
            returns "Int"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

