(test 1)
(name "overflow-inside-a-try-refuses")
(note "Overflow is the program's own defect and not a failure of the work, so a `try` around it does not catch it: the run refuses, the way it does for an index past the end. The body carries a failure it never reaches, so that the try is one the build admits.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (parameter loud (type Bool))
    (returns Any)
    (body
      (var tried)
      (try
        (body
          (let sum (call Standard.Numeric.plus 9223372036854775807 1))
          (conditional
            (when loud)
            (then
              (call Standard.Control.abort "loud")))
          (set tried sum))
        (catch
          (set tried "caught")))
      (return tried))))
(arguments (argument loud false))
(expect (refuses run))
