(test 1)
(name "a-claim-about-procedure-refuses")
(note "A claim is about a type a value is an instance of by name. `Procedure` names a structure, what a procedure takes and returns, and no declaration, so a claim about it is refused where the document is read, and a closure conforms to no contract.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Procedure)
    (satisfies App.Described))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return
        (call App.Described.describe
          (closure
            (returns Int)
            (body
              (return 1))))))))
(expect (refuses load))
