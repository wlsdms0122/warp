warpt 1
{
  expect {
    answers "a card"
  }
  name "an-alias-of-a-record-answers-the-records-contracts"
  note "Bank.Alias names the record Bank.Card, which a document says answers App.Describable, so a value of Bank.Alias is handed where App.Describable is asked."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "1"
                  }
                }
                type "Bank.Alias"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Alias" "Bank.Card"
      "Bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

