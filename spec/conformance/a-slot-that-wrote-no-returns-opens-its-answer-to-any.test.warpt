warpt 1
{
  expect {
    answers 1
  }
  name "a-slot-that-wrote-no-returns-opens-its-answer-to-any"
  note "Calling a value answers what the slot holding it wrote under `returns`; a slot that wrote none opens to `any`, so the answer stands at the build and is settled where it arrives at the run. The cast to `int` stands for that reason: an answer the build read as `int` would make it a cast naming what the reading already is."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "one"
            value {
              closure {
                result 1
              }
            }
          }
          {
            let "got"
            value {
              call {
                procedure {
                  ref "one"
                }
              }
            }
          }
        ]
        result {
          as {
            of {
              ref "got"
            }
            type "int"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

