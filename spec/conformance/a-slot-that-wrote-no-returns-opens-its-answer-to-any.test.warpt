warpt 1
{
  expect {
    answers 1
  }
  name "a-slot-that-wrote-no-returns-opens-its-answer-to-any"
  note "Calling a value answers what the slot holding it wrote under `returns`, and `one` is declared a procedure type taking nothing that wrote none, so the call answers `Any` whatever the closure in it answers. The cast to `Int` says what it is and is judged at the run; an answer the build read as `Int` would make it a cast naming what the reading already is."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "one"
            type "() -> Any"
            value {
              closure {
                result 1
              }
            }
          }
          {
            let "got"
            value {
              call {
                procedure {
                  ref "one"
                }
              }
            }
          }
        ]
        result {
          as {
            of {
              ref "got"
            }
            type "Int"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

