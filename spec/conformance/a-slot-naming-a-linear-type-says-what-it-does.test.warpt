warpt 1
{
  expect {
    refuses "build"
  }
  name "a-slot-naming-a-linear-type-says-what-it-does"
  note "A parameter naming a type written `linear` says what it does with the value: `consuming` takes the obligation and `borrowing` reads and leaves it. One writing neither refuses at the build, even where the body answers what it took, as `App.look` does here."
  program {
    imports []
    procedures {
      "App.look" {
        parameters [
          {
            name "of"
            type "App.Handle"
          }
        ]
        result {
          ref "of"
        }
        returns "App.Handle"
      }
      "App.open" {
        result {
          as {
            of {
              record {
                name "f"
              }
            }
            type "App.Handle"
          }
        }
        returns "App.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
        ]
        result {
          ref "handle"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

