warpt 1
{
  expect {
    refuses "build"
  }
  name "a-module-variable-holding-a-linear-value-refuses"
  note "Every run starts a module variable holding its value, and nothing hands that value on, so a module variable whose type is written linear refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    var {
      mv {
        type "App.Handle"
        value {
          record {
            name "f"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

