warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bound-beside-a-later-naming-of-a-type-parameter-refuses"
  note "A signature bounds a type parameter beside the first `some T` its slots write. `x` names `T` first, so a bound beside the `some T` of `y` refuses at the load."
  program {
    imports [
      "Standard.Comparable"
    ]
    procedures {
      "App.f" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T: Standard.Comparable"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

