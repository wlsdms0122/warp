(test 1)
(name "a-declared-type-nothing-declares-refuses")
(note "A name may say what it holds, and a type nothing in the link declares says nothing. `let y` declaring `App.Nope` refuses at the build.")

(program
  (warp 1)
  (import App.Nope)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let y (type App.Nope) 1))
    (result 1)))
(expect (refuses build))
