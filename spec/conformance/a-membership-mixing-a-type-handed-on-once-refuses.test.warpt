warpt 1
{
  expect {
    refuses "build"
  }
  name "a-membership-mixing-a-type-handed-on-once-refuses"
  note "A membership admitting a value handed on once beside one that is not would carry an obligation on some readings and not on others, and which it was is what a membership does not say. It is refused where it is declared."
  program {
    constraints {
      Mixed [
        "app.Handle"
        "int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "int"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

