warpt 1
{
  expect {
    answers "answered"
  }
  name "a-variable-declared-const-procedure-carries-that-into-a-capture"
  note "A variable that declared what it holds is held to that through every write, so a closure that captured it applies what the declaration said, the way a captured slot's word stands. A variable that declared nothing may be retyped after the capture and says nothing a closure can hold on to."
  program {
    imports []
    procedures {
      "app.asking" {
        body [
          {
            let "answered"
            value {
              apply {
                procedure {
                  ref "body"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type {
              "const procedure" {
                returns "string"
              }
            }
          }
        ]
        result {
          ref "answered"
        }
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            type {
              "const procedure" {
                returns "string"
              }
            }
            value {
              closure {
                result "answered"
                returns "string"
              }
            }
            var "answering"
          }
          {
            let "relaying"
            value {
              closure {
                body [
                  {
                    let "answered"
                    value {
                      apply {
                        procedure {
                          ref "answering"
                        }
                      }
                    }
                  }
                ]
                result {
                  ref "answered"
                }
                returns "string"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "relaying"
              }
            ]
            procedure "app.asking"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

