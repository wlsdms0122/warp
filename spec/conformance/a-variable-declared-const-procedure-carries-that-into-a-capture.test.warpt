warpt 1
{
  expect {
    answers "answered"
  }
  name "a-variable-declared-const-procedure-carries-that-into-a-capture"
  note "A variable that declared what it holds is held to that through every write, so a closure that captured it calls what the declaration said, the way what a captured slot says stands. A variable that declared nothing is held to the type it read as at the capture, which is a reading the build worked out, so it says nothing a closure can hold on to."
  program {
    imports []
    procedures {
      "App.asking" {
        body [
          {
            let "answered"
            value {
              call {
                procedure {
                  ref "body"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type {
              "const procedure" {
                returns "String"
              }
            }
          }
        ]
        result {
          ref "answered"
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            type {
              "const procedure" {
                returns "String"
              }
            }
            value {
              closure {
                result "answered"
                returns "String"
              }
            }
            var "answering"
          }
          {
            let "relaying"
            value {
              closure {
                body [
                  {
                    let "answered"
                    value {
                      call {
                        procedure {
                          ref "answering"
                        }
                      }
                    }
                  }
                ]
                result {
                  ref "answered"
                }
                returns "String"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "relaying"
              }
            ]
            procedure "App.asking"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

