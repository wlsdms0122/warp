(test 1)
(name "a-variable-declared-const-procedure-carries-that-into-a-capture")
(note "A variable that declared what it holds is held to that through every write, so a closure that captured it calls what the declaration said, the way what a captured slot says stands. A variable that declared nothing is held to the type it read as at the capture, which is a reading the build worked out, so it says nothing a closure can hold on to.")

(program
  (warp 1)
  (procedure App.asking
    (const)
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body)))
    (result answered))
  (procedure entry
    (access public)
    (const)
    (returns String)
    (body
      (var answering
        (type (procedure (const) (parameters) (returns String)))
        (closure
          (const)
          (isolated)
          (returns String)
          (result "answered")))
      (let relaying
        (closure
          (const)
          (returns String)
          (body
            (let answered (apply answering)))
          (result answered))))
    (result (call App.asking relaying))))
(expect (answers "answered"))
