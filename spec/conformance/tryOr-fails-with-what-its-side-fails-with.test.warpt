(test 1)
(name "tryOr-fails-with-what-its-side-fails-with")
(note "`Standard.Logic.tryOr` takes sides that may fail and declares `failing: anything`, so a side's failure is the call's: the first side answers false, the second aborts with `side`, and the rescue reads its message.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (import Standard.Logic.tryOr)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns (nullable String))
    (body
      (var failed)
      (let caught
        (attempt
          (body
            (call Standard.Logic.tryOr
              (array
                (closure
                  (const)
                  (isolated)
                  (returns Bool)
                  (body
                    (return false)))
                (closure
                  (const)
                  (isolated)
                  (returns Bool)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "side"))))))
          (rescue
            (set failed (path caught (field message))))))
      (return failed))))
(expect (answers "side"))
