(test 1)
(name "keys-return-a-dictionarys-own-keys-in-the-key-order")
(note "keys returns the keys a dictionary holds as the values they are, in the key order: a dictionary keyed by integers returns integers, ascending by worth.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call Standard.Collection.keys (dictionary (entry 3 "c") (entry 1 "a") (entry 2 "b")))))))
(expect (answers (array 1 2 3)))
