(test 1)
(name "a-struct-literal-a-cast-reads-is-the-struct-the-cast-names")
(note "A cast's type is a place a struct literal is read as the declared struct it names: the literal `as` reads takes the declared name.")

(program
  (warp 1)
  (struct Bank.Account
    (field balance Int))
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (return (as (struct (field balance 1)) Bank.Account)))))
(expect (answers (struct Bank.Account (field balance 1))))
