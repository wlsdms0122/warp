warpt 1
{
  arguments {
    c false
  }
  expect {
    answers 1
  }
  name "a-body-ending-in-a-call-answering-an-alias-of-never-answers-as-declared"
  note "`App.k` declares `Int` and its body ends in a call of `App.f`, which declares `App.N`, a name for `Never`. No way through the body comes back, so nothing it answers disagrees with `Int`, and the program runs."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      "App.f" {
        body [
          {
            value {
              call {
                arguments [
                  "no"
                ]
                procedure "Standard.Control.abort"
              }
            }
          }
        ]
        parameters [
          {
            name "go"
            type "Bool"
          }
        ]
        returns "App.N"
      }
      "App.k" {
        body [
          {
            value {
              call {
                arguments [
                  true
                ]
                procedure "App.f"
              }
            }
          }
        ]
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      call {
                        procedure "App.k"
                      }
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "Bool"
          }
        ]
        result 1
      }
    }
    types {
      "App.N" "Never"
    }
    warp 1
  }
  test 1
}

