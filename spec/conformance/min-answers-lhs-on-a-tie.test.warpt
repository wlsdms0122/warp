warpt 1
{
  expect {
    answers 1
  }
  name "min-answers-lhs-on-a-tie"
  note "Two values that order the same are a tie, and on a tie min answers lhs as it arrived: 1 and 1.0 are one worth in two kinds, so which side came back shows."
  program {
    imports [
      "Standard.Math.min"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              1.0
            ]
            procedure "Standard.Math.min"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

