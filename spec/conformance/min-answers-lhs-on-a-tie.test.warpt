warpt 1
{
  expect {
    answers "0.0"
  }
  name "min-answers-lhs-on-a-tie"
  note "Two values that order the same are a tie, and on a tie min answers lhs as it arrived: 0.0 and -0.0 are one worth, and their text tells which came back."
  program {
    imports [
      "Standard.Math.min"
      "Standard.Text.text"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    0.0
                    -0.0
                  ]
                  procedure "Standard.Math.min"
                }
              }
            ]
            procedure "Standard.Text.text"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

