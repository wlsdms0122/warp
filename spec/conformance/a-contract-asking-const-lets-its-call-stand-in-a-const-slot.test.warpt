warpt 1
{
  expect {
    answers [
      "1"
      "2"
    ]
  }
  name "a-contract-asking-const-lets-its-call-stand-in-a-const-slot"
  note "A contract's procedure writing `const` and `isolated` answers without running and touches nothing, so a call through it stands where a call to a declaration saying both does: the closure in `App.names` declares both and sends it, and stands in the `const isolated` slot map asks. Every declaration answering the contract is held to that where its claim is checked."
  program {
    contracts {
      "App.Named" {
        procedures {
          name {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports [
      "Standard.Collection.map"
      "Standard.Text.text"
    ]
    procedures {
      "App.names" {
        const true
        isolated true
        parameters [
          {
            name "of"
            type "Array<some T: App.Named>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of"
              }
              {
                closure {
                  const true
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "some T"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                      ]
                      procedure "App.Named.name"
                    }
                  }
                  returns "String"
                }
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
        returns "Array<String>"
      }
      entry {
        access "public"
        const true
        failing "anything"
        result {
          call {
            arguments [
              [
                {
                  as {
                    of {
                      struct {
                        id 1
                      }
                    }
                    type "App.Thing"
                  }
                }
                {
                  as {
                    of {
                      struct {
                        id 2
                      }
                    }
                    type "App.Thing"
                  }
                }
              ]
            ]
            procedure "App.names"
          }
        }
        returns "Array<String>"
      }
    }
    types {
      "App.Thing" {
        procedures {
          name {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "App.Thing"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "of.id"
                  }
                ]
                procedure "Standard.Text.text"
              }
            }
            returns "String"
          }
        }
        satisfies [
          "App.Named"
        ]
        struct {
          id "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

