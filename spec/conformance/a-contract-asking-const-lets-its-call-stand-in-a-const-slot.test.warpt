warpt 1
{
  expect {
    answers [
      "1"
      "2"
    ]
  }
  name "a-contract-asking-const-lets-its-call-stand-in-a-const-slot"
  note "A contract's procedure writing `const` answers without running, so a call through it reads as one does: a closure sending it is const, and stands in the const slot map asks. Every declaration answering the contract is held to that where its claim is checked."
  program {
    contracts {
      "app.Named" {
        name {
          const true
          parameters [
            {
              name "of"
              type "app.Named"
            }
          ]
          returns "string"
        }
      }
    }
    imports [
      "std.collection.map"
      "std.text.text"
    ]
    procedures {
      "app.Thing.name" {
        parameters [
          {
            name "of"
            type "app.Thing"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of.id"
              }
            ]
            procedure "std.text.text"
          }
        }
        returns "string"
      }
      "app.names" {
        bounds {
          T "app.Named"
        }
        parameters [
          {
            name "of"
            type "array<some T>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of"
              }
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "some T"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                      ]
                      procedure "app.Named.name"
                    }
                  }
                  returns "string"
                }
              }
            ]
            procedure "std.collection.map"
          }
        }
        returns "array<string>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  as "app.Thing"
                  of {
                    id 1
                  }
                }
                {
                  as "app.Thing"
                  of {
                    id 2
                  }
                }
              ]
            ]
            procedure "app.names"
          }
        }
        returns "array<string>"
      }
    }
    satisfies {
      "app.Thing" [
        "app.Named"
      ]
    }
    types {
      "app.Thing" {
        id "int"
      }
    }
    warp 1
  }
  test 1
}

