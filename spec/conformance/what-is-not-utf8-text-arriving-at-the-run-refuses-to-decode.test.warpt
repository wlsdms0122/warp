warpt 1
{
  expect {
    refuses "run"
  }
  name "what-is-not-utf8-text-arriving-at-the-run-refuses-to-decode"
  note "Bytes carry no promise of being text, and completing a broken sequence with replacement characters would answer a text nobody sent. The bytes a variable holds are not UTF-8, so the run refuses the call."
  program {
    imports [
      "Standard.Text.decoded"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value x"ff"
            var "bytes"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "bytes"
              }
              "utf8"
            ]
            procedure "Standard.Text.decoded"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

