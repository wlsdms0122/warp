warpt 1
{
  expect {
    answers 1
  }
  name "a-variable-a-closure-writes-with-a-value-of-the-parameter-answers"
  note "A closure in app.g writes its parameter into cell, and the body calls it with x. The call judges the answer, which holds 1."
  program {
    imports []
    procedures {
      "app.g" {
        body [
          {
            value {
              ref "x"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "int"
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    ref "x"
                  }
                ]
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

