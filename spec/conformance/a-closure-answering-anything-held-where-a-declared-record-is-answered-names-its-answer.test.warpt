warpt 1
{
  expect {
    answers App.Point {
      x 1
    }
  }
  name "a-closure-answering-anything-held-where-a-declared-record-is-answered-names-its-answer"
  note "`f` writes no `returns` and answers what it is handed, which it reads as `Any`. Held at a slot whose procedure type answers `App.Point`, a call of it reads the answer as `App.Point`, and the nameless record of that type's fields it answers crosses out of `Any` there and takes the name, as a cast from `Any` would."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            value {
              closure {
                parameters [
                  {
                    name "a"
                    type "Any"
                  }
                ]
                result {
                  ref "a"
                }
              }
            }
          }
          {
            let "c"
            type {
              procedure {
                parameters [
                  "Any"
                ]
                returns "App.Point"
              }
            }
            value {
              ref "f"
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      x 1
                    }
                  }
                ]
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

