  name "the-object-of-a-loop"
  note "A loop carries its condition, its body, the slot its round stands in, and the run of slots its result reads, or none."
  program {
    imports [
      "Standard.Comparable.lessThan"
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "total"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    set "total"
                    value {
                      call {
                        arguments [
                          {
                            ref "total"
                          }
                          1
                        ]
                        procedure "Standard.Numeric.plus"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      3
                    ]
                    procedure "Standard.Comparable.lessThan"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "total"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

