  name "the-object-of-a-loop"
  note "A loop carries its condition, its body, the slot its round stands in, and the run of slots its result reads, or none."
  program {
    imports [
      "Standard.Math.lessThan"
      "Standard.Math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "total"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    set "total"
                    value {
                      call {
                        arguments [
                          {
                            ref "total"
                          }
                          1
                        ]
                        procedure "Standard.Math.plus"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      3
                    ]
                    procedure "Standard.Math.lessThan"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "total"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
