  name "the-object-of-a-loop"
  note "A loop carries its condition, its body, the slot its round stands in, and the run of slots its result reads, or none."
  program {
    imports [
      "std.math.lessThan"
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "total"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    set "total"
                    value {
                      call {
                        arguments {
                          value 1
                        }
                        of {
                          ref "total"
                        }
                        procedure "std.math.plus"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments {
                      value 3
                    }
                    of {
                      ref "walk.index"
                    }
                    procedure "std.math.lessThan"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "total"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 6
