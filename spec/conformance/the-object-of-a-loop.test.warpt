(test 1)
(name "the-object-of-a-loop")
(note "A loop carries its condition, its round, and the slot its round's name stands in, or none.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (var total 0)
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) 3))
          (body
            (set total (call Standard.Numeric.plus total 1)))))
      (return total))))
(expect (builds (dictionary (entry "addressTable" (array (array 1 (array (array 0 0 "index" false)) false) (array 0 (array) false) (array 0 (array) false) (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"833b17b2b39b071a3ece4dcc87b48fc567a34d3d6d63890e5c781e3a090678a6")) (entry "document" (array x"f49045e20ec89db2c6dff8294c11362917d39779d7dbb385b2e8c8682b490e72")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 4) (array 4) (array 4) (array 4))) (entry "members" (array)) (entry "numbering" (array (array "Standard.Comparable.lessThan" "Standard.Numeric.plus") (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 0 1) (array 12 (array "Standard.Comparable" "lessThan" (array 0 1) (array 1 0) (array (array 0 1)))) (array 0 2) (array 12 (array "Standard.Numeric" "plus" (array 2 3) (array 1 2) (array (array 0 3)))) (array 9 2 (array (array (array (array 2 1)) 4 "total")) (array 1)) (array 1 3) (array 13 0 (array 6)))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 1 0)) 0 "total") (array (array) 5 "walk") (array (array) 7 "[2]")) (array 2 (array) (array) (array) (array "total" "walk")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 0) (array 2 3) (array 2 1))) (entry "variables" (array)))))
