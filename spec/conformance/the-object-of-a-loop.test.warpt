(test 1)
(name "the-object-of-a-loop")
(note "A loop carries its condition, its round, and the slot its round's name stands in, or none.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (var total 0)
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) 3))
          (body
            (set total (call Standard.Numeric.plus total 1))))))
    (result total)))
(expect (builds (dictionary (entry "addressTable" (array (array 1 (array (array 0 0 "index" false))) (array 0 (array)) (array 0 (array)) (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"a5732dc98a9098112838793ee3bc74983ef772acd039ef92ff67a167c57fe995")) (entry "document" (array x"c5798a5b61a0c8c98402b3f3432dc70b4d54a2c7404c71430c90ab7f94dd365d")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Comparable.lessThan" "Standard.Numeric.plus") (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 0 1) (array 12 (array "Standard.Comparable" "lessThan" 1 (array (array 0 2)))) (array 1 2) (array 0 2) (array 12 (array "Standard.Numeric" "plus" 4 (array (array 0 5)))) (array 9 3 (array (array (array (array 2 1)) 6 "total")) (array 1)) (array 1 3))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array (array 1 0)) 0 "total") (array (array) 7 "walk")) (array 8)) (array 2 (array) (array) (array) (array "total" "walk")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 0) (array 2 3) (array 2 1))) (entry "variables" (array)))))
