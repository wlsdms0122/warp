warpt 1
{
  expect {
    refuses "build"
  }
  name "an-optional-dot-on-a-field-that-is-there-refuses-at-the-build"
  note "`?.` reads a segment that may be absent as null. On a field the reading already proves is there it says nothing, the way a `?` that says nothing new refuses on a type spelling, and is refused at the build."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "point"
            value {
              x 1
            }
          }
        ]
        result {
          ref "point?.x"
        }
      }
    }
    warp 1
  }
  test 2
}

