warpt 1
{
  expect {
    answers "a"
  }
  name "break-ends-the-walk"
  note "`break` ends the whole walk; rounds after it never start."
  program {
    imports [
      "std.logic.equal"
      "std.text.joined"
    ]
    procedures {
      entry {
        body [
          {
            value ""
            var "seen"
          }
          {
            let "walk"
            value {
              each {
                body [
                  {
                    value {
                      branch {
                        then [
                          {
                            value {
                              break null
                            }
                          }
                        ]
                        when {
                          call {
                            arguments {
                              value 1
                            }
                            of {
                              ref "walk.index"
                            }
                            procedure "std.logic.equal"
                          }
                        }
                      }
                    }
                  }
                  {
                    set "seen"
                    value {
                      call {
                        of [
                          {
                            ref "seen"
                          }
                          {
                            ref "walk.item"
                          }
                        ]
                        procedure "std.text.joined"
                      }
                    }
                  }
                ]
                in [
                  "a"
                  "b"
                  "c"
                ]
              }
            }
          }
        ]
        result {
          ref "seen"
        }
      }
    }
    warp 1
  }
  test 1
}
