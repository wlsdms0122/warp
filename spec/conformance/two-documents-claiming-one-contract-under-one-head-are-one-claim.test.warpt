(test 1)
(name "two-documents-claiming-one-contract-under-one-head-are-one-claim")
(note "Two documents writing the same head and contract say one thing, so the claim stands once and the call reaches the member.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String)))
    (extension
      (head (array Int))
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (parameter of (type (array Int)))
        (returns String)
        (result "ints")))))

(program
  (warp 1)
  (import App.Describable)
  (import App.Describable.describe)
  (extension
    (head (array Int))
    (satisfies App.Describable))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (array Int)) (array 1)))
    (result (call App.Describable.describe b))))
(expect (answers "ints"))
