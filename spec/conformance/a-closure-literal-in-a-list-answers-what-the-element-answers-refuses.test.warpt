warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-literal-in-a-list-answers-what-the-element-answers-refuses"
  note "`c` declares a list of `Procedure() -> App.Point`, and the closure literal written as its element writes no `returns`, so it answers what the element answers. Its body answers `{ x: 1, y: 2 }`, which is no `App.Point`, so it refuses at the build as the same closure written at a name declaring that type does."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              array {
                procedure {
                  returns "App.Point"
                }
              }
            }
            value [
              {
                closure {
                  result {
                    record {
                      x 1
                      y 2
                    }
                  }
                }
              }
            ]
          }
        ]
        result {
          call {
            procedure {
              ref "c[0]"
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

