warpt 1
{
  expect {
    answers "shown"
  }
  name "a-declaration-answering-a-contract-may-fill-a-bounded-parameter-with-what-the-bound-takes"
  note "The contract takes an int at n, and the declaration answering it takes some U there, bounded by App.Whole, which admits int."
  program {
    constraints {
      "App.Whole" [
        "Int"
      ]
    }
    contracts {
      "App.Shown" {
        show {
          parameters [
            {
              name "of"
              type "App.Shown"
            }
            {
              name "n"
              type "Int"
            }
          ]
          returns "String"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.show" {
        bounds {
          U "App.Whole"
        }
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "n"
            type "some U"
          }
        ]
        result "shown"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  3
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Shown"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
      "Bank.Coin" {
        record {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

