warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-record-holding-a-declared-record-to-a-dictionary-of-a-membership-of-another-refuses"
  note "`Bank.A` and `Bank.B` are both declared `{ k: string }`, and `App.M2` admits `Bank.B` and `Int`. The record `{ f: a }`, where `a` is a `Bank.A`, is a dictionary of `App.M2` only if its field is a `Bank.B` or a whole number, and it is neither. No value is both, so the cast `as Dictionary<App.M2>` refuses at the build."
  program {
    constraints {
      "App.M2" [
        "Bank.B"
        "Int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "a"
            type "Bank.A"
            value {
              record {
                k "x"
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  record {
                    f {
                      ref "a"
                    }
                  }
                }
                type "Dictionary<App.M2>"
              }
            }
          }
        ]
        result 0
      }
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
      "Bank.B" {
        record {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

