(test 1)
(name "a-claim-about-a-struct-taking-a-type-parameter-holds-for-every-value-of-it-answers")
(note "A claim names a struct taking type parameters bare, and is about every value of it whatever it is applied to. `App.Box.describe` takes `App.Box<some T>`, so the call through the contract reaches it for an `App.Box<Int>`.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (satisfies App.Describable)
    (field item (some T))
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (answers "box"))
