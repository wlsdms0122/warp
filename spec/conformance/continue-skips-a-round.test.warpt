(test 1)
(name "continue-skips-a-round")
(note "`continue` ends the round and the loop goes on to the next.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (import Standard.Comparable.lessThan)
  (import Standard.Logic.equal)
  (import Standard.Text.joined)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let items (array "a" "b" "c"))
      (var seen "")
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count items)))
          (body
            (let item (path items (index (path walk (field index)))))
            (conditional
              (when (call Standard.Logic.equal (path walk (field index)) 1))
              (then
                (continue)))
            (set seen (call Standard.Text.joined (array seen item) ""))))))
    (result seen)))
(expect (answers "ac"))
