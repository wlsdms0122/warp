warpt 1
{
  expect {
    answers "a"
  }
  name "a-cast-of-a-list-of-nameless-records-to-a-list-of-a-declared-record-names-them"
  note "`xs` is a list of the nameless record `{ k: \"x\" }`, and `Bank.A` is declared `{ k: string }`. Casting `xs` as `Array<Bank.A>` attaches the name to each element, so it is no cast of what the reading already is, and `App.P.show`, which `Bank.A` answers, is sent to an element."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.P"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "xs"
            value [
              {
                record {
                  k "x"
                }
              }
            ]
          }
          {
            let "ys"
            value {
              as {
                of {
                  ref "xs"
                }
                type "Array<Bank.A>"
              }
            }
          }
          {
            let "i"
            value 0
          }
        ]
        result {
          call {
            arguments [
              {
                ref "ys[i]"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "App.KR" {
        record {
          k "String"
        }
      }
      "App.NK" "App.KR?"
      "Bank.A" {
        record {
          k "String"
        }
      }
      "Bank.B" {
        record {
          k "String"
        }
      }
      "Bank.NA" "Bank.A?"
      "Bank.NB" "Bank.B?"
    }
    warp 1
  }
  test 1
}

