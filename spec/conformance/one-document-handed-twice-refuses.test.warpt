(test 1)
(name "one-document-handed-twice-refuses")
(note "A build holds each document once. The document beside the program is laid twice, one identity handed a second time, and the build refuses it, though all it declares is `private` and two documents may each declare a `private` name under one spelling.")

(documents
  (document
    (warp 1)
    (procedure Lib.helper
      (access private)
      (returns Int)
      (body
        (return 1))))
  (document
    (warp 1)
    (procedure Lib.helper
      (access private)
      (returns Int)
      (body
        (return 1)))))

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
