warpt 1
{
  expect {
    answers {
      ref "nowhere"
      value 1
    }
  }
  name "a-record-field-may-carry-a-tags-name"
  note "A record is written under `record`, and what stands under it are its fields, each an expression. A field may be called `ref` or `value`, and its value is still read as the expression it is."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "n"
            value 1
          }
        ]
        result {
          record {
            ref "nowhere"
            value {
              ref "n"
            }
          }
        }
      }
    }
    warp 1
  }
  test 1
}

