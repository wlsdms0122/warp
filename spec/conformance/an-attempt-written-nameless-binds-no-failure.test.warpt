(test 1)
(name "an-attempt-written-nameless-binds-no-failure")
(note "An attempt written with no naming key binds no failure and rescues the same.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns String)
    (body
      (var said (type String) "ran")
      (attempt
        (body
          (call Standard.Control.abort "stop"))
        (rescue
          (set said "rescued"))))
    (result said)))
(expect (answers "rescued"))
