warpt 1
{
  expect {
    refuses "run"
  }
  name "a-generic-answer-carried-through-another-generic-is-judged-where-the-call-reads-it-refuses"
  note "App.h answers its some T with a value of any. App.g answers what App.h answers, so App.g proves nothing of its answer either, and the call App.g(1, \"s\") reads it as an int where it stands."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.g" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "n"
              }
              {
                ref "junk"
              }
            ]
            procedure "App.h"
          }
        }
        returns "some T"
      }
      "App.h" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
        ]
        result {
          ref "junk"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  "s"
                ]
                procedure "App.g"
              }
            }
          }
          {
            let "y"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                  1
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        result {
          ref "y"
        }
      }
    }
    warp 1
  }
  test 1
}

