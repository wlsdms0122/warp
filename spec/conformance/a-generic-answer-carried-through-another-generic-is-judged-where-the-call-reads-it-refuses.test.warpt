warpt 1
{
  expect {
    refuses "run"
  }
  name "a-generic-answer-carried-through-another-generic-is-judged-where-the-call-reads-it-refuses"
  note "App.h keeps n in cell, and a closure writing cell from its own some T is read as Any and called through a cast with text, which the run cannot hold to what filled T. App.h proves nothing of its answer, App.g answers what App.h answers and proves nothing either, and the call App.g(1, \"s\") reads it as an int where it stands, so the text refuses at the run."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.g" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "n"
              }
              {
                ref "junk"
              }
            ]
            procedure "App.h"
          }
        }
        returns "some T"
      }
      "App.h" {
        body [
          {
            value {
              ref "n"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "w"
            value {
              as {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      "String"
                    ]
                    returns "Int"
                  }
                }
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        ref "junk"
                      }
                      type "String"
                    }
                  }
                ]
                procedure {
                  ref "w"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  "s"
                ]
                procedure "App.g"
              }
            }
          }
          {
            let "y"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                  1
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        result {
          ref "y"
        }
      }
    }
    warp 1
  }
  test 1
}

