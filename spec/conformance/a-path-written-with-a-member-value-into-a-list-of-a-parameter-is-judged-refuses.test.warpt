warpt 1
{
  expect {
    refuses "run"
  }
  name "a-path-written-with-a-member-value-into-a-list-of-a-parameter-is-judged-refuses"
  note "App.g, bounded by Standard.Numeric, writes 5 into cell[0], where cell is a list of T. 5 is not a value of T, so the call judges the answer, and T filled with int(0...3) refuses 5 at the run."
  program {
    imports [
      "Standard.Numeric"
    ]
    procedures {
      "App.g" {
        body [
          {
            value [
              {
                ref "x"
              }
            ]
            var "cell"
          }
          {
            set "cell[0]"
            value 5
          }
        ]
        bounds {
          T "Standard.Numeric"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "cell"
        }
        returns "array<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            type "int(0...3)"
            value 2
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

