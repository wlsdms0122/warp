(test 1)
(name "sorted-orders-what-it-was-given")
(note "sorted answers the elements in order and leaves what it was given as it was.")

(program
  (warp 1)
  (import Standard.Collection.sorted)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (let ordered (call Standard.Collection.sorted (array 3 1 2))))
    (result ordered)))
(expect (answers (array 1 2 3)))
