(test 1)
(name "all-keyed-answers-under-keys-of-any-type")
(note "allKeyed takes a map of closures under keys of any type that answers Hashable and answers each piece's answer under the key it stood under, here whole numbers in the key order.")

(program
  (warp 1)
  (import Standard.Concurrent.allKeyed)
  (procedure entry
    (access public)
    (isolated)
    (returns (dictionary Int String))
    (failing concurrent_failed)
    (body
      (return
        (call Standard.Concurrent.allKeyed
          (dictionary
            (entry 2
              (closure
                (const)
                (isolated)
                (returns String)
                (body
                  (return "b"))))
            (entry 1
              (closure
                (const)
                (isolated)
                (returns String)
                (body
                  (return "a"))))))))))
(expect (answers (dictionary (entry 1 "a") (entry 2 "b"))))
