warpt 1
{
  expect {
    answers {
      1 "a"
      2 "b"
    }
  }
  name "all-keyed-answers-under-keys-of-any-type"
  note "allKeyed takes a map of closures under keys of any type that answers Hashable and answers each piece's answer under the key it stood under, here whole numbers in the key order."
  program {
    imports [
      "Standard.Concurrent.allKeyed"
    ]
    procedures {
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    2
                    {
                      closure {
                        const true
                        isolated true
                        result "b"
                        returns "String"
                      }
                    }
                  ]
                  [
                    1
                    {
                      closure {
                        const true
                        isolated true
                        result "a"
                        returns "String"
                      }
                    }
                  ]
                ]
              }
            ]
            procedure "Standard.Concurrent.allKeyed"
          }
        }
        returns "Dictionary<Int, String>"
      }
    }
    warp 1
  }
  test 1
}

