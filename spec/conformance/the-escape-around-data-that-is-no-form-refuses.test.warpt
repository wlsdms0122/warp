warpt 1
{
  expect {
    refuses "load"
  }
  name "the-escape-around-data-that-is-no-form-refuses"
  note "`{ value: … }` quotes data that could be read as a form, and only a record can be. A whole number is written as itself, so the escape around one is a second spelling of the same literal and is refused where it is read."
  program {
    imports []
    procedures {
      entry {
        result {
          value 1
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

