(test 1)
(name "a-value-cast-from-any-to-a-contract-it-does-not-answer-fails")
(note "The cast reads `left` as `App.Described`, and the run holds the value to the contract by the type it is an instance of. A bool answers no claim of it, so the cast fails with cast_refused before `App.Described.describe` is asked, which the attempt catches.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (result "a whole number")))
  (procedure entry
    (access public)
    (parameter left)
    (returns (nullable String))
    (body
      (let tried
        (attempt
          (body
            (let got (call App.Described.describe (as left App.Described))))
          (rescue
            (result (path tried (field type)))))))
    (result tried)))
(arguments (argument left true))
(expect (answers "cast_refused"))
