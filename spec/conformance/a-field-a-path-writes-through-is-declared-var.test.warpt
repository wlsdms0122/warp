warpt 1
{
  expect {
    refuses "build"
  }
  name "a-field-a-path-writes-through-is-declared-var"
  note "A declared type says which of its fields a path may write through: `var Int` opens the field, and a field written without `var` stops the path at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              as {
                of {
                  struct {
                    balance 1
                    owner "kim"
                  }
                }
                type "Account"
              }
            }
            var "a"
          }
          {
            set "a.balance"
            value 5
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          ref "a.balance"
        }
        returns "Int"
      }
    }
    types {
      Account {
        struct {
          balance "Int"
          owner "String"
        }
      }
    }
    warp 1
  }
  test 1
}

