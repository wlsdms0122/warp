warpt 1
{
  expect {
    answers 0
  }
  name "a-record-with-a-var-field-handed-at-a-dictionary-fills-a-parameter-by-its-values-answers"
  note "`app.Box` declares `var a: int` and `b: int?`. `app.f` bounds `T` by `app.M`, which admits `int?` and `string`, and answers the `dictionary<some T>` it takes. Handed a box, the record is read as a dictionary by its fields' values, the `var` off, joined part by part, so `T` reads `int?`, the answer fits the name declaring `dictionary<int?>`, and the run answers 0."
  program {
    constraints {
      "app.M" [
        "int?"
        "string"
      ]
    }
    imports []
    procedures {
      "app.f" {
        bounds {
          T "app.M"
        }
        parameters [
          {
            name "d"
            type "dictionary<some T>"
          }
        ]
        result {
          ref "d"
        }
        returns "dictionary<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "app.Box"
            value {
              record {
                a 1
                b null
              }
            }
          }
          {
            let "r"
            type "dictionary<int?>"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "app.f"
              }
            }
          }
        ]
        result 0
      }
    }
    types {
      "app.Box" {
        record {
          a "var int"
          b "int?"
        }
      }
    }
    warp 1
  }
  test 1
}

