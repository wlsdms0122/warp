warpt 1
{
  documents [
    {
      imports [
        "std.math.times"
      ]
      procedures {
        "k.twice" {
          parameters [
            {
              name "of"
              type "int"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "of"
                }
                2
              ]
              procedure "std.math.times"
            }
          }
          returns "int"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 12
  }
  name "a-constant-settles-from-a-body-of-another-document"
  note "A constant settles from a body in another document of the link, since the document it is written in is what the compiled document is made from. The body runs at the build and the constant is the answer."
  program {
    const {
      twelve {
        call {
          arguments [
            6
          ]
          procedure "k.twice"
        }
      }
    }
    imports [
      "k.twice"
    ]
    procedures {
      entry {
        access "public"
        result {
          ref "twelve"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

