warpt 1
{
  expect {
    refuses "build"
  }
  name "a-piece-calling-a-procedure-that-hands-a-module-variable-in-place-to-a-value-refuses"
  note "A body handing a module variable in place to a value writes it through that value, the way it would through a declaration, so it is not isolated. A piece of `Standard.Concurrent.map` calling such a procedure refuses at the build."
  program {
    imports [
      "Standard.Concurrent.map"
      "Standard.Numeric.plus"
    ]
    procedures {
      adding {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "total"
                  }
                ]
                procedure {
                  ref "f"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "f"
            type "isolated (inout Int) -> Any"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            let "bump"
            value {
              closure {
                body [
                  {
                    set "count"
                    value {
                      call {
                        arguments [
                          {
                            ref "count"
                          }
                          1
                        ]
                        procedure "Standard.Numeric.plus"
                      }
                    }
                  }
                ]
                parameters [
                  {
                    name "count"
                    type "inout Int"
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  [
                    1
                    2
                  ]
                  {
                    closure {
                      body [
                        {
                          value {
                            call {
                              arguments [
                                {
                                  ref "bump"
                                }
                              ]
                              procedure "adding"
                            }
                          }
                        }
                      ]
                      parameters [
                        {
                          name "item"
                          type "Int"
                        }
                        {
                          name "index"
                          type "Int"
                        }
                      ]
                      result {
                        ref "item"
                      }
                    }
                  }
                ]
                procedure "Standard.Concurrent.map"
              }
            }
          }
        ]
        result {
          ref "total"
        }
        returns "Int"
      }
    }
    var {
      total 0
    }
    warp 1
  }
  test 1
}

