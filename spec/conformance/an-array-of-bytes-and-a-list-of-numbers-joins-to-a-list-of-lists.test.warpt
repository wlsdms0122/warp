warpt 1
{
  expect {
    refuses "build"
  }
  name "an-array-of-bytes-and-a-list-of-numbers-joins-to-a-list-of-lists"
  note "An array literal's elements join where their readings meet. Bytes stand as a list of whole numbers, so bytes beside a list of ints join to a list of lists of ints, and a slot asking a list of text is refused at the build rather than waved through as `Any`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "mixed"
            value [
              x"6869"
              [
                1
                2
              ]
            ]
          }
        ]
        result {
          call {
            arguments [
              {
                ref "mixed"
              }
            ]
            procedure "wants"
          }
        }
        returns "Int"
      }
      wants {
        parameters [
          {
            name "texts"
            type "Array<String>"
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

