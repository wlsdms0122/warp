warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-held-at-a-contract-slot-answers-the-struct-it-answers-answers"
  note "`c` is declared `() -> Bank.A`, and its closure writes `returns Bank.A`, the struct literal `{ k: \"x\" }` it answers taking the name. `d` holds it again at `() -> App.P`, which `Bank.A` answers, and a slot hands a value on as it is, so the call inside `App.run` answers a `Bank.A` and `App.P.show` reaches `Bank.A.show`."
  program {
    contracts {
      "App.P" {
        procedures {
          show {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type "() -> some T"
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type "() -> Bank.A"
            value {
              closure {
                const true
                isolated true
                result {
                  struct {
                    k "x"
                  }
                }
                returns "Bank.A"
              }
            }
          }
          {
            let "d"
            type "() -> App.P"
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.A" {
        procedures {
          show {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "Bank.A"
              }
            ]
            result "a"
            returns "String"
          }
        }
        satisfies [
          "App.P"
        ]
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

