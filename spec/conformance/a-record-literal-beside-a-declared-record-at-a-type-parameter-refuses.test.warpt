warpt 1
{
  expect {
    answers App.P {
      x 2
    }
  }
  name "a-record-literal-beside-a-declared-record-at-a-type-parameter-refuses"
  note "A type parameter a call fills beside is a place a literal is read at. `App.same` takes `some T` twice, the `App.P` handed first fills it, and the record literal handed beside it is read as that record once the readings join, so the call answers the literal as an `App.P`."
  program {
    imports []
    procedures {
      "App.same" {
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result {
          ref "b"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "p"
            type "App.P"
            value {
              record {
                x 1
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "p"
              }
              {
                record {
                  x 2
                }
              }
            ]
            procedure "App.same"
          }
        }
        returns "App.P"
      }
    }
    types {
      "App.P" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

