warpt 1
{
  expect {
    refuses "build"
  }
  name "a-body-writing-a-value-into-its-own-type-parameter-refuses"
  note "A declaration takes a variable in place as some T and writes 5 into it. Inside the declaration only a value of T fits T, so a caller handing a variable declared String would be left holding an int."
  program {
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      "App.gen" {
        body [
          {
            set "y"
            value 5
          }
        ]
        parameters [
          {
            name "y"
            type "inout some T"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            type "String"
            value "a"
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                ]
                procedure "App.gen"
              }
            }
          }
          {
            let "u"
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                ]
                procedure "Standard.Text.uppercased"
              }
            }
          }
        ]
        result {
          ref "u"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

