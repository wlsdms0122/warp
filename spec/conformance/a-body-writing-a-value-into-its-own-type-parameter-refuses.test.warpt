(test 1)
(name "a-body-writing-a-value-into-its-own-type-parameter-refuses")
(note "A declaration takes a variable in place as some T and writes 5 into it. Inside the declaration only a value of T fits T, so a caller handing a variable declared String would be left holding an int.")

(program
  (warp 1)
  (import Standard.Text.uppercased)
  (procedure App.gen
    (parameter y (type (inout (some T))))
    (returns Int)
    (body
      (set y 5))
    (result 0))
  (procedure entry
    (access public)
    (returns String)
    (body
      (var s (type String) "a")
      (call App.gen s)
      (let u (call Standard.Text.uppercased s)))
    (result u)))
(expect (refuses build))
