(test 1)
(name "a-constant-of-keys-of-two-types-settled-from-a-hashable-keyed-map-answers")
(note "`K.make` answers `Dictionary<Hashable, Int>`, and the map it answers holds `1` and `\"a\"`. The constant settled from it takes the key its call was read as, since keys of two types join to `Any`, which keys no map, so it stands where `Dictionary<Hashable, Int>` is declared and `count` answers 2.")

(documents
  (document
    (warp 1)
    (procedure K.make
      (const)
      (isolated)
      (returns (dictionary Hashable Int))
      (body
        (let m (type (dictionary Hashable Int)) (dictionary (entry 1 1) (entry "a" 2))))
      (result m))))

(program
  (warp 1)
  (import K.make)
  (import Standard.Collection.count)
  (const made (call K.make))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (let d (type (dictionary Hashable Int)) made))
    (result (call Standard.Collection.count d))))
(expect (answers 2))
