warpt 1
{
  expect {
    refuses "build"
  }
  name "a-range-that-admits-nothing-refuses"
  note "The bounds are the declaration's own claim, so an order the numbers refuse is refused where it was written: no whole number is at once at least 9 and at most 1, and a slot admitting nothing fits no call."
  program {
    imports []
    procedures {
      entry {
        parameters {
          level {
            type "int(9...1)"
          }
        }
        result {
          ref "level"
        }
      }
    }
    warp 1
  }
  test 2
}

