warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-record-with-a-var-field-to-a-record-it-never-is-refuses"
  note "`App.Box` declares `var a: Int`. A box cast `as { a: String }` names a record whose `a` holds text, and the box's `a` holds a whole number; the field's `var` is a fact about the field and not about its value, so no value is both and the cast refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box"
            value {
              record {
                a 1
              }
            }
          }
        ]
        result {
          as {
            of {
              ref "b"
            }
            type {
              record {
                a "String"
              }
            }
          }
        }
      }
    }
    types {
      "App.Box" {
        record {
          a "var Int"
        }
      }
    }
    warp 1
  }
  test 1
}

