warpt 1
{
  expect {
    answers [
      1
      3
    ]
  }
  name "first-and-last-read-the-ends"
  note "first and last answer the elements at the ends of an array, in the order the array holds."
  program {
    imports [
      "Standard.Collection.first"
      "Standard.Collection.last"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "items"
            value [
              1
              2
              3
            ]
          }
          {
            let "front"
            value {
              call {
                arguments [
                  {
                    ref "items"
                  }
                ]
                procedure "Standard.Collection.first"
              }
            }
          }
          {
            let "back"
            value {
              call {
                arguments [
                  {
                    ref "items"
                  }
                ]
                procedure "Standard.Collection.last"
              }
            }
          }
        ]
        result [
          {
            ref "front"
          }
          {
            ref "back"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

