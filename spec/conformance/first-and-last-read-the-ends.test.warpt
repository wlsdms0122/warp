warpt 1
{
  expect {
    answers [
      1
      3
    ]
  }
  name "first-and-last-read-the-ends"
  note "first and last answer the elements at the ends of an array, in the order the array holds."
  program {
    imports [
      "std.collection.first"
      "std.collection.last"
    ]
    procedures {
      entry {
        body [
          {
            let "items"
            value [
              1
              2
              3
            ]
          }
          {
            let "front"
            value {
              call {
                of {
                  ref "items"
                }
                procedure "std.collection.first"
              }
            }
          }
          {
            let "back"
            value {
              call {
                of {
                  ref "items"
                }
                procedure "std.collection.last"
              }
            }
          }
        ]
        result [
          {
            ref "front"
          }
          {
            ref "back"
          }
        ]
      }
    }
    warp 1
  }
  test 2
}
