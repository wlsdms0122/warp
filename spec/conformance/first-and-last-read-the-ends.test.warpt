(test 1)
(name "first-and-last-read-the-ends")
(note "first and last answer the elements at the ends of an array, in the order the array holds.")

(program
  (warp 1)
  (import Standard.Collection.first)
  (import Standard.Collection.last)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (let items (array 1 2 3))
      (let front (call Standard.Collection.first items))
      (let back (call Standard.Collection.last items)))
    (result (array front back))))
(expect (answers (array 1 3)))
