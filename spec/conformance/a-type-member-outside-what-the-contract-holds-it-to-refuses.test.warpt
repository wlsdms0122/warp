(test 1)
(name "a-type-member-outside-what-the-contract-holds-it-to-refuses")
(note "`Lib.Keyed` holds Item to Hashable, and App.Card gives App.Plain, which no claim makes Hashable, so the claim refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Keyed
      (type Item Hashable)
      (procedure key
        (parameter of (type Self))
        (returns Self.Item))))
  (document
    (warp 1)
    (import Lib.Keyed)
    (struct App.Card
      (satisfies Lib.Keyed)
      (field plain App.Plain)
      (type Item App.Plain)
      (procedure key
        (access public)
        (parameter of (type App.Card))
        (returns App.Plain)
        (result (path of (field plain)))))
    (struct App.Plain
      (field x Int))))

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses build))
