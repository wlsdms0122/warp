(test 1)
(name "a-declaration-failing-with-anything-may-fail-with-any-failure")
(note "`failing: anything` lets a body fail with any failure, `aborted` included, and a call of it may fail with anything, which the rescue around it catches.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure App.go
    (returns Never)
    (failing (anything))
    (body
      (return (call Standard.Control.abort "no"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (var tried)
      (attempt
        (body
          (call App.go))
        (rescue
          (set tried "caught")))
      (return tried))))
(expect (answers "caught"))
