warpt 1
{
  expect {
    answers "a card"
  }
  name "an-alias-of-a-membership-answers-as-the-membership"
  note "App.AnyCard names App.Cards, whose one member is Bank.Card, which answers App.Describable. A value of App.AnyCard is a Bank.Card, so it is handed where App.Describable is asked."
  program {
    constraints {
      "App.Cards" [
        "Bank.Card"
      ]
    }
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "1"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "c"
              }
            ]
            procedure "show"
          }
        }
      }
      show {
        body [
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "App.AnyCard"
          }
        ]
        result {
          ref "s"
        }
        returns "String"
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "App.AnyCard" "App.Cards"
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

