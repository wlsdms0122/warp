warpt 1
{
  expect {
    refuses "run"
  }
  name "a-variable-handed-in-place-that-a-closure-writes-is-judged-refuses"
  note "A closure in app.g writes x, handed in place, from its own parameter, and is called through a cast with a string. The body proves nothing, so the caller's variable is judged once the call is over, and the string refuses at the run."
  program {
    imports []
    procedures {
      "app.g" {
        body [
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "x"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "int"
              }
            }
          }
          {
            let "a"
            type "any"
            value {
              ref "c"
            }
          }
          {
            let "h"
            value {
              as {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      "string"
                    ]
                    returns "int"
                  }
                }
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  "s"
                ]
                procedure {
                  ref "h"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "inout some T"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value 1
            var "v"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    warp 1
  }
  test 1
}

