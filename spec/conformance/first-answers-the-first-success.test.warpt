warpt 1
{
  expect {
    answers 1
  }
  name "first-answers-the-first-success"
  note "`firstKeyed` answers the first piece that succeeds and asks the rest to stop. A piece that fails is not a success, so with one piece failing and one answering, the answer is the one that answered."
  program {
    imports [
      "Standard.Concurrent.firstKeyed"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    "fine"
                    {
                      closure {
                        const true
                        isolated true
                        result 1
                        returns "Int"
                      }
                    }
                  ]
                  [
                    "fragile"
                    {
                      closure {
                        body [
                          {
                            value {
                              call {
                                arguments [
                                  "on purpose"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        const true
                        failing [
                          "aborted"
                        ]
                        isolated true
                        returns "Never"
                      }
                    }
                  ]
                ]
              }
            ]
            procedure "Standard.Concurrent.firstKeyed"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

