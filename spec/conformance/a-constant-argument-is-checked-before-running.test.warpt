warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-argument-is-checked-before-running"
  note "What is knowable before running is decided before running. A constant's type is knowable, so a call passing one that does not fit is refused where declarations are checked rather than where values arrive."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              it "not a number"
            }
            procedure "wants"
          }
        }
      }
      wants {
        parameters [
          {
            name "it"
            type "int"
          }
        ]
        result {
          ref "it"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

