warpt 1
{
  arguments {
    items [
      "first"
      "second"
    ]
  }
  expect {
    answers "first"
  }
  name "the-optional-bracket-reads-through-a-nullable"
  note "`?[` unwraps a nullable array: an array that arrived reads its element, and the null the caller left would answer null for the whole path. The path's own answer is nullable for the same reason."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          items {
            default null
            type "array<string>?"
          }
        }
        result {
          ref "items?[0]"
        }
        returns "string?"
      }
    }
    warp 1
  }
  test 1
}

