(test 1)
(name "the-optional-bracket-reads-through-a-nullable")
(note "`?[` unwraps a nullable array: an array that arrived reads its element, and a null the host handed would answer null for the whole path. The path's own answer is nullable for the same reason.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter items (type (nullable (array String))))
    (returns (nullable String))
    (body
      (return (path items (index? 0))))))
(arguments (argument items (array "first" "second")))
(expect (answers "first"))
