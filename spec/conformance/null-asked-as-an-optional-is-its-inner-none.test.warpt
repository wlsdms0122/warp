(test 1)
(name "null-asked-as-an-optional-is-its-inner-none")
(note "`as?` reads exactly the Optional of the type it names, and a match is its some. The literal `null` read as `Int?` is that Optional's none, so `as? Int?` answers its some, `Some` holding `null`.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (return (as? null (optional Int))))))
(expect (answers (struct Some (field wrapped null))))
