warpt 1
{
  expect {
    refuses "load"
  }
  name "a-text-format-header-not-in-its-one-writing-refuses"
  note "The format number on the first line is a whole number in its one spelling, the same as a whole number anywhere in the text. `warpt 01` would be a second text for a document the reader already has one for."
  test 1
  text "warpt 01\n1\n"
}

