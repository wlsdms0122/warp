warpt 1
{
  expect {
    answers {
      a 9
    }
  }
  name "a-parameter-read-as-a-declared-record-with-a-var-field-and-a-nameless-one-is-handed-in-place-beside-a-nameless-record-answers"
  note "`App.Box` is declared `{ a: var Int }`. `r` is what `App.f` answers given a name read as `App.Box` and `{ a: 2 }`, so it is read as `{ a: Int }`, as `s` is. `App.g` takes two of `inout some U`, so handing `r` and `s` in place reads `U` as `{ a: Int }` both ways, and the call answers."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      "App.g" {
        parameters [
          {
            name "x"
            type "inout some U"
          }
          {
            name "y"
            type "inout some U"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box"
            value {
              record {
                a 1
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    record {
                      a 2
                    }
                  }
                ]
                procedure "App.f"
              }
            }
            var "r"
          }
          {
            value {
              record {
                a 9
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                  {
                    ref "s"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "App.Box" {
        record {
          a "var Int"
        }
      }
    }
    warp 1
  }
  test 1
}

