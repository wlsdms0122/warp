warpt 1
{
  expect {
    answers {
      a 9
    }
  }
  name "a-parameter-read-as-a-declared-record-with-a-var-field-and-a-nameless-one-is-handed-in-place-beside-a-nameless-record-answers"
  note "`app.Box` is declared `{ a: var int }`. `r` is what `app.f` answers given a name read as `app.Box` and `{ a: 2 }`, so it is read as `{ a: int }`, as `s` is. `app.g` takes two of `inout some U`, so handing `r` and `s` in place reads `U` as `{ a: int }` both ways, and the call answers."
  program {
    imports []
    procedures {
      "app.f" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      "app.g" {
        parameters [
          {
            name "x"
            type "inout some U"
          }
          {
            name "y"
            type "inout some U"
          }
        ]
        result 0
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "app.Box"
            value {
              record {
                a 1
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    record {
                      a 2
                    }
                  }
                ]
                procedure "app.f"
              }
            }
            var "r"
          }
          {
            value {
              record {
                a 9
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                  {
                    ref "s"
                  }
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "app.Box" {
        record {
          a "var int"
        }
      }
    }
    warp 1
  }
  test 1
}

