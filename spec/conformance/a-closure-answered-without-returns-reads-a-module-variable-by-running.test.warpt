warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-answered-without-returns-reads-a-module-variable-by-running"
  note "A declaration that writes no returns answers a closure reading a module variable. Its answer is read as a procedure that runs, so handing it to a const Procedure slot refuses, whichever walk read the declaration first."
  program {
    imports []
    procedures {
      asking {
        body [
          {
            let "answered"
            value {
              call {
                procedure {
                  ref "body"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type "const Procedure"
          }
        ]
        result {
          ref "answered"
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "given"
            value {
              call {
                procedure "make"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "given"
              }
            ]
            procedure "asking"
          }
        }
      }
      make {
        result {
          closure {
            result {
              ref "standing"
            }
            returns "String"
          }
        }
      }
    }
    var {
      standing "held"
    }
    warp 1
  }
  test 1
}

