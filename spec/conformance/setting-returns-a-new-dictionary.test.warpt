(test 1)
(name "setting-returns-a-new-dictionary")
(note "setting returns a dictionary with the entry written, and a new dictionary: the one it was given still holds what it held.")

(program
  (warp 1)
  (import Standard.Collection.setting)
  (procedure entry
    (access public)
    (returns (array (dictionary String Int)))
    (body
      (let data (dictionary (entry "a" 1)))
      (let grown (call Standard.Collection.setting data "b" 2))
      (return (array grown data)))))
(expect (answers (array (dictionary (entry "a" 1) (entry "b" 2)) (dictionary (entry "a" 1)))))
