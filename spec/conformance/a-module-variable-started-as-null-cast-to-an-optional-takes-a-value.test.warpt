(test 1)
(name "a-module-variable-started-as-null-cast-to-an-optional-takes-a-value")
(note "A start of null says nothing the cast does not, so a module variable started by null cast to Int? holds Int? and takes an integer afterwards.")

(program
  (warp 1)
  (var v (as null (optional Int)))
  (procedure entry
    (access public)
    (returns (optional Int))
    (body
      (set v 1)
      (return v))))
(expect (answers 1))
