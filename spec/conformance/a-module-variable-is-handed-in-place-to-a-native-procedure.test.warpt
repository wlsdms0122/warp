warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-module-variable-is-handed-in-place-to-a-native-procedure"
  note "A module variable is handed in place to a native procedure the way it is to any body: the procedure writes through the path it was handed, and the write is in the variable when the procedure answers."
  program {
    imports [
      "std.collection.append"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "items"
                  }
                  2
                ]
                procedure "std.collection.append"
              }
            }
          }
        ]
        result {
          ref "items"
        }
        returns "array<int>"
      }
    }
    var {
      items [
        1
      ]
    }
    warp 1
  }
  test 1
}

