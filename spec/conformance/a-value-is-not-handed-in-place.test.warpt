warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-is-not-handed-in-place"
  note "A literal has no box to write, so handing one in place refuses at the build."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments {
                  value 1
                }
                of {
                  ref "count"
                }
                procedure "std.math.plus"
              }
            }
          }
        ]
        parameters {
          count "inout int"
        }
      }
      entry {
        body [
          {
            value {
              call {
                arguments {
                  count 10
                }
                procedure "bump"
              }
            }
          }
        ]
        returns "null"
      }
    }
    warp 1
  }
  test 1
}
