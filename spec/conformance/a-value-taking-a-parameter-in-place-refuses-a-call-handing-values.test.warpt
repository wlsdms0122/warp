warpt 1
{
  expect {
    refuses "run"
  }
  name "a-value-taking-a-parameter-in-place-refuses-a-call-handing-values"
  note "A call of a value whose type says nothing of its parameters hands values, since the build had nothing to hold a variable against. A value it reaches that takes a parameter in place refuses at the run before its body runs."
  program {
    imports []
    procedures {
      calling {
        body [
          {
            let "answered"
            value {
              call {
                arguments [
                  10
                ]
                procedure {
                  ref "read"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "read"
            type "Procedure"
          }
        ]
        result {
          ref "answered"
        }
      }
      entry {
        access "public"
        body [
          {
            let "reading"
            value {
              closure {
                parameters [
                  {
                    name "count"
                    type "inout Int"
                  }
                ]
                result {
                  ref "count"
                }
                returns "Int"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "reading"
              }
            ]
            procedure "calling"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

