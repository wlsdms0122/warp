(test 1)
(name "an-interface-spells-as-text")
(note "An interface is written in a document's nodes, `(interface 1)` in the place of `(warp 1)`, and its tree is a document's tree with the language version under `interface`.")
(text "(interface 1)\n(import Standard.Comparable)\n\n(struct App.Range\n  (field high Int)\n  (field low Int))\n\n(contract App.Named\n  (procedure name\n    (parameter of (type Self))\n    (returns String)))\n\n(extension\n  (head Int)\n  (satisfies App.Named)\n  (procedure name\n    (parameter of (type Int))\n    (returns String)))\n\n(procedure App.largest\n  (parameter of (type (array (some T Standard.Comparable))))\n  (returns (optional (some T))))\n")
(expect (spells (dictionary (entry "contracts" (dictionary (entry "App.Named" (dictionary (entry "procedures" (dictionary (entry "name" (dictionary (entry "parameters" (array (dictionary (entry "name" "of") (entry "type" "Self")))) (entry "returns" "String"))))))))) (entry "extensions" (dictionary (entry "Int" (dictionary (entry "procedures" (dictionary (entry "name" (dictionary (entry "parameters" (array (dictionary (entry "name" "of") (entry "type" "Int")))) (entry "returns" "String"))))) (entry "satisfies" (array "App.Named")))))) (entry "imports" (array "Standard.Comparable")) (entry "interface" 1) (entry "procedures" (dictionary (entry "App.largest" (dictionary (entry "parameters" (array (dictionary (entry "name" "of") (entry "type" "Array<some T: Standard.Comparable>")))) (entry "returns" "some T?"))))) (entry "types" (dictionary (entry "App.Range" (dictionary (entry "struct" (dictionary (entry "high" "Int") (entry "low" "Int"))))))))))
