(test 1)
(name "a-loop-reads-a-closure-reading-a-module-variable-as-one-that-runs")
(note "A loop's round hands a variable to a slot of a `const` procedure type and then writes into it a closure reading a module variable. The round after reads that closure as one that runs, so the hand refuses.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (var standing "held")
  (procedure asking
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body)))
    (result answered))
  (procedure entry
    (access public)
    (returns String)
    (body
      (var g
        (closure
          (returns String)
          (result "x")))
      (let r
        (loop
          (while (call Standard.Comparable.lessThan (path r (field index)) 2))
          (body
            (let a (call asking g))
            (set g
              (closure
                (returns String)
                (result standing)))))))
    (result "done")))
(expect (refuses build))
