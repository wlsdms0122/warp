(test 1)
(name "a-struct-bounding-its-key-parameter-holds-a-map-answers")
(note "`App.Cache` holds `Dictionary<some K, some V>` and bounds `K` by `Hashable`, which is what a map's key answers, so the struct is declared and a value of `App.Cache<String, Int>` reads its map.")

(program
  (warp 1)
  (struct App.Cache
    (typeParameter K Hashable)
    (typeParameter V)
    (field table (dictionary (some K) (some V))))
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (let c (type (named App.Cache String Int)) (struct (field table (dictionary (entry "a" 2))))))
    (result (path c (field table) (index "a")))))
(expect (answers 2))
