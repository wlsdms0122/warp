warpt 1
{
  expect {
    answers [
      104.0
      105.0
    ]
  }
  name "an-array-slot-that-changes-a-byte-reads-them-out"
  note "The compact spelling crosses only where the element declaration would leave a byte as it is. `Array<Double>` widens every one of them, so the elements are read out through the equation and settle one by one. The same widening a `Double` slot does to a whole number, one collection up."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              x"6869"
            ]
            procedure "keep"
          }
        }
      }
      keep {
        parameters [
          {
            name "value"
            type "Array<Double>"
          }
        ]
        result {
          ref "value"
        }
        returns "Array<Double>"
      }
    }
    warp 1
  }
  test 1
}

