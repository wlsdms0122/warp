(test 1)
(name "a-cast-to-a-list-of-a-type-parameter-refuses")
(note "App.decode answers raw as Array<some T>. A type parameter inside a cast's type names no type, since nothing in a body fills one, so the cast refuses at the load as a name saying it holds Array<some T> does.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure App.decode
    (parameter sample (type (some T)))
    (parameter raw)
    (returns (array (some T)))
    (body
      (return (as raw (array (some T))))))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (let raw (type Any) (array "7" "8"))
      (let xs (call App.decode 0 raw))
      (let ys (call Standard.Collection.appending xs 9))
      (return ys))))
(expect (refuses load))
