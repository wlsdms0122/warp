warpt 1
{
  expect {
    answers App.B {
      a "x"
    }
  }
  name "a-cast-of-a-membership-of-a-record-to-another-nullable-record-answers"
  note "`App.A` and `App.B` are both declared `{ a: string }`, and `App.M` admits `App.A` and `Int`. A nameless record written into `App.M` stays nameless, so a value read as `App.M` may be one `App.B?` takes. The cast `m as App.B?` builds, and the run settles the record under `App.B`."
  program {
    constraints {
      "App.M" [
        "App.A"
        "Int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "m"
            type "App.M"
            value {
              record {
                a "x"
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "m"
                }
                type "App.B?"
              }
            }
          }
        ]
        result {
          ref "b"
        }
      }
    }
    types {
      "App.A" {
        record {
          a "String"
        }
      }
      "App.AA" "App.A"
      "App.B" {
        record {
          a "String"
        }
      }
      "App.NA" "App.A?"
      "App.NB" "App.B?"
    }
    warp 1
  }
  test 1
}

