(test 1)
(name "an-undeclared-procedure-only-an-untaken-arm-sends-refuses")
(note "The same rule one layer out: a procedure reached only from an arm nobody takes still has to be there, because whether the arm is taken is not known until it runs and by then the refusal is too late.")

(program
  (warp 1)
  (import nobodyDeclaresThis)
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (failing (anything))
    (body
      (conditional
        (when ready)
        (then
          (let taken "taken"))
        (else
          (call nobodyDeclaresThis))))))
(arguments (argument ready true))
(expect (refuses build))
