warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-of-two-types-handed-where-a-contract-is-asked-is-read-element-by-element-refuses"
  note "`App.g` takes `array<App.Describable>` and is handed a list of a `Bank.Account`, which answers the contract, and a `Bank.Other`, which does not. Each element is held to the contract on its own, so `Bank.Other` refuses at the build."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.g" {
        parameters [
          {
            name "xs"
            type "array<App.Describable>"
          }
        ]
        result 0
        returns "int"
      }
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
        ]
        result "acct"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "a"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "Bank.Account"
              }
            }
          }
          {
            let "o"
            value {
              as {
                of {
                  record {
                    n 1
                  }
                }
                type "Bank.Other"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    {
                      ref "a"
                    }
                    {
                      ref "o"
                    }
                  ]
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      "Bank.Account" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Account" {
        record {
          balance "int"
        }
      }
      "Bank.Other" {
        record {
          n "int"
        }
      }
    }
    warp 1
  }
  test 1
}

