(test 1)
(name "a-list-of-two-types-handed-where-a-contract-is-asked-is-read-element-by-element-refuses")
(note "`App.g` takes `Array<App.Describable>` and is handed a list of a `Bank.Account`, which answers the contract, and a `Bank.Other`, which does not. Each element is held to the contract on its own, so `Bank.Other` refuses at the build.")

(program
  (warp 1)
  (struct Bank.Account
    (satisfies App.Describable)
    (field balance Int)
    (procedure describe
      (parameter of (type Bank.Account))
      (returns String)
      (body
        (return "acct"))))
  (struct Bank.Other
    (field n Int))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure App.g
    (parameter xs (type (array App.Describable)))
    (returns Int)
    (body
      (return 0)))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let a (as (struct (field balance 1)) Bank.Account))
      (let o (as (struct (field n 1)) Bank.Other))
      (let r (call App.g (array a o)))
      (return r))))
(expect (refuses build))
