(test 1)
(name "a-member-under-a-bare-name-taking-some-of-its-values-refuses")
(note "Under its type's bare name a member takes every value of the type first. `size` takes `Array<Int>`, some lists only, so it refuses at the build; it is given under the head `Array<Int>`.")

(program
  (warp 1)
  (extension
    (head Array)
    (procedure size
      (parameter of (type (array Int)))
      (returns Int)
      (body
        (return 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
