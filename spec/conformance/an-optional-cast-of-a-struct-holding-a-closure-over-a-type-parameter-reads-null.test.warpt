(test 1)
(name "an-optional-cast-of-a-struct-holding-a-closure-over-a-type-parameter-reads-null")
(note "`App.wrap` builds a struct holding a closure its body wrote over `T`. Read as `Any` and cast with `as?` to `App.Fn<Int>`, the closure is no value of `(Int) -> Int` outside the call that made it, so the cast answers null.")

(documents
  (document
    (warp 1)
    (struct App.Fn
      (typeParameter T)
      (field run (procedure (parameters (some T)) (returns (some T)))))
    (procedure App.wrap
      (access public)
      (parameter x (type (some T)))
      (returns (named App.Fn (some T)))
      (body
        (return
          (struct
            (field run
              (closure
                (parameter y (type (some T)))
                (returns (some T))
                (body
                  (return y))))))))))

(program
  (warp 1)
  (import App.Fn)
  (import App.wrap)
  (procedure entry
    (access public)
    (returns (nullable (named App.Fn Int)))
    (body
      (let a (type Any) (call App.wrap 1))
      (return (as? a (named App.Fn Int))))))
(expect (answers null))
