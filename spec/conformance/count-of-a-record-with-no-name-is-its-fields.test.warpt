warpt 1
{
  expect {
    answers 2
  }
  name "count-of-a-record-with-no-name-is-its-fields"
  note "A record with no name holds its names as data, so it is a map, an instance of `Dictionary`, and `Standard.Collection` is claimed for `Dictionary`: count reads its fields."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                record {
                  balance 1
                  owner "a"
                }
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

