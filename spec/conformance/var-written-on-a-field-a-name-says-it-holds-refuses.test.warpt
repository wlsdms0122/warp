warpt 1
{
  expect {
    refuses "load"
  }
  name "var-written-on-a-field-a-name-says-it-holds-refuses"
  note "`var` is written on a field of a type declared in `types` and nowhere else. A `let` saying it holds an inline record whose field is written `var Int` refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "x"
            type {
              record {
                a "var Int"
              }
            }
            value {
              record {
                a 1
              }
            }
          }
        ]
        result 1
      }
    }
    warp 1
  }
  test 1
}

