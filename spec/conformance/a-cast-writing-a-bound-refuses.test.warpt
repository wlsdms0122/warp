(test 1)
(name "a-cast-writing-a-bound-refuses")
(note "A cast names a type and introduces none, so a bound beside its `some T` refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (some T)))
    (returns (some T))
    (result (as x (some T Hashable))))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses load))
