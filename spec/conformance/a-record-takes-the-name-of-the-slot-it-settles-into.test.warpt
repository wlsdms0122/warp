warpt 1
{
  expect {
    answers Bank.Account {
      balance 1
    }
  }
  name "a-record-takes-the-name-of-the-slot-it-settles-into"
  note "A declared record is nominal. A record with no name settles into a slot declaring the type and comes out carrying the name; the answer is written with it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          record {
            balance 1
          }
        }
        returns "Bank.Account"
      }
    }
    types {
      "Bank.Account" {
        record {
          balance "int"
        }
      }
    }
    warp 1
  }
  test 1
}

