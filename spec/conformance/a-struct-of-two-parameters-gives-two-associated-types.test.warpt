(test 1)
(name "a-struct-of-two-parameters-gives-two-associated-types")
(note "A pair claims a contract asking `Key: Hashable` and `Value` under `App.Pair<some A: Hashable, some B>`, its parameters in order. A call of `Lib.valueOf` on a pair of an Int and a string returns its string.")

(documents
  (document
    (warp 1)
    (contract Lib.Keyed
      (type Key Hashable)
      (type Value)
      (procedure value
        (parameter of (type Self))
        (returns Self.Value)))
    (procedure Lib.valueOf
      (access public)
      (parameter p (type (some P Lib.Keyed)))
      (returns (some P.Value))
      (body
        (return (call Lib.Keyed.value p)))))
  (document
    (warp 1)
    (import Lib.Keyed)
    (struct App.Pair
      (typeParameter A)
      (typeParameter B)
      (field a (some A))
      (field b (some B)))
    (extension
      (head (named App.Pair (some A Hashable) (some B)))
      (satisfies Lib.Keyed)
      (type Key (some A))
      (type Value (some B))
      (procedure value
        (access public)
        (parameter of (type (named App.Pair (some A) (some B))))
        (returns (some B))
        (body
          (return (path of (field b))))))))

(program
  (warp 1)
  (import App.Pair)
  (import Lib.valueOf)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let p (type (named App.Pair Int String)) (struct (field a 1) (field b "b")))
      (return (call Lib.valueOf p)))))
(expect (answers "b"))
