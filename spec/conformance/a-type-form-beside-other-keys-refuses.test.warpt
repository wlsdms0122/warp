warpt 1
{
  expect {
    refuses "load"
  }
  name "a-type-form-beside-other-keys-refuses"
  note "A type written as a mapping is a form by its one key, and `struct` beside another key is no form. A struct type with a field called `struct` is written under `struct`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    types {
      "App.Pair" {
        id "Int"
        struct {
          name "String"
        }
      }
    }
    warp 1
  }
  test 1
}

