(test 1)
(name "rounded-past-the-int-refuses")
(note "`rounded` answers an int only when an int holds the answer. A fraction whose whole part is past the int has no whole answer, and the read refuses at the run rather than wrapping or widening.")

(program
  (warp 1)
  (import Standard.Math.rounded)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call Standard.Math.rounded 1e+19)))))
(expect (refuses run))
