(test 1)
(name "inout-written-on-returns-refuses")
(note "`inout` is written on a parameter's type and nowhere else. A `returns` written `inout Int` refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (returns (inout Int))
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
