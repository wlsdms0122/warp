(test 1)
(name "a-contract-written-with-brackets-refuses")
(note "Only a struct listing type parameters is applied to types. A contract's name written with brackets is refused at the build, where the name resolves.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (parameter x (type (named App.Described Int)))
    (returns Int)
    (body
      (return 1))))
(arguments (argument x 1))
(expect (refuses build))
