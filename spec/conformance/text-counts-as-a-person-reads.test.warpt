(test 1)
(name "text-counts-as-a-person-reads")
(note "Text is counted by extended grapheme cluster under canonical equivalence: a letter written as letter-plus-combining-mark is one character.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (parameter text (type String))
    (returns Int)
    (body
      (return (call Standard.Collection.count text)))))
(arguments (argument text "café"))
(expect (answers 4))
