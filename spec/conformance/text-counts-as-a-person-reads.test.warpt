warpt 1
{
  arguments {
    text "café"
  }
  expect {
    answers 4
  }
  name "text-counts-as-a-person-reads"
  note "Text is counted by extended grapheme cluster under canonical equivalence: a letter written as letter-plus-combining-mark is one character."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "text"
            type "string"
          }
        ]
        result {
          call {
            of {
              ref "text"
            }
            procedure "std.collection.count"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

