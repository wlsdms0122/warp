(test 1)
(name "a-type-member-may-be-an-associated-type-of-its-heads-parameter")
(note "App.Wrapper gives Item as `some B.Item`, the associated type of what it wraps. A wrapper of a box of Int gives Int.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item)))))))
  (document
    (warp 1)
    (import Lib.Container)
    (import Lib.Container.first)
    (struct App.Wrapper
      (typeParameter B Lib.Container)
      (satisfies Lib.Container)
      (field base (some B))
      (type Item (some B.Item))
      (procedure first
        (access public)
        (parameter of (type (named App.Wrapper (some B Lib.Container))))
        (returns (some B.Item))
        (body
          (let base (path of (field base)))
          (let x (call Lib.Container.first base))
          (return x))))))

(program
  (warp 1)
  (import App.Box)
  (import App.Wrapper)
  (import Int.plus)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (let w (type (named App.Wrapper (named App.Box Int))) (struct (field base b)))
      (let x (call Lib.firstOf w))
      (return (call Int.plus x 1)))))
(expect (answers 2))
