(test 1)
(name "an-unwrap-spells-as-text")
(note "An unwrap is a block, and so are its `then` and `else`; what it takes apart stands on its first line, and its name is the statement's.")
(text "(warp 1)\n\n(procedure entry\n  (access public)\n  (parameter o (type (optional Int)))\n  (returns Int)\n  (body\n    (var n 0)\n    (let x\n      (unwrap o\n        (then\n          (set n x))\n        (else\n          (set n 2))))\n    (return n)))\n")
(expect (spells (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" 0) (entry "var" "n")) (dictionary (entry "let" "x") (entry "value" (dictionary (entry "unwrap" (dictionary (entry "else" (array (dictionary (entry "set" "n") (entry "value" 2)))) (entry "of" (dictionary (entry "ref" "o"))) (entry "then" (array (dictionary (entry "set" "n") (entry "value" (dictionary (entry "ref" "x"))))))))))) (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "ref" "n")))))))) (entry "parameters" (array (dictionary (entry "name" "o") (entry "type" "Int?")))) (entry "returns" "Int"))))) (entry "warp" 1))))
