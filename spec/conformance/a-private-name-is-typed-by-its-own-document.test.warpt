warpt 1
{
  documents [
    {
      imports []
      procedures {
        "App.helper" {
          access "private"
          result "seven"
        }
        "Lib.spell" {
          result {
            call {
              procedure "App.helper"
            }
          }
          returns "String"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 7
  }
  name "a-private-name-is-typed-by-its-own-document"
  note "Two documents may each declare a private name, and each is typed by its own: what the build read off the other document's body under that spelling says nothing about this one's, whose declaration writes what it answers."
  program {
    imports []
    procedures {
      "App.helper" {
        access "private"
        result 7
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.helper"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

