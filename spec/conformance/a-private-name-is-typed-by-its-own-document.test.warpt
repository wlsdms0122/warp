warpt 1
{
  documents [
    {
      imports []
      procedures {
        "App.helper" {
          access "private"
          const true
          isolated true
          result "seven"
          returns "String"
        }
        "Lib.spell" {
          const true
          isolated true
          result {
            call {
              procedure "App.helper"
            }
          }
          returns "String"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 7
  }
  name "a-private-name-is-typed-by-its-own-document"
  note "Two documents may each declare a private name, and each is typed by its own declaration: what the other document's declaration under that spelling answers says nothing about this one's."
  program {
    imports []
    procedures {
      "App.helper" {
        access "private"
        const true
        isolated true
        result 7
        returns "Int"
      }
      entry {
        access "public"
        const true
        isolated true
        result {
          call {
            procedure "App.helper"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

