warpt 1
{
  expect {
    answers {
      first 1
      kids 2
    }
  }
  name "a-declared-type-names-itself-in-its-fields"
  note "A type declared in `types` may name itself in a field, nullable or as a list's element, and a value of it is built and read like any other."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "leaf"
            value {
              as "t.Node"
              of {
                kids []
                left null
                n 1
              }
            }
          }
          {
            let "root"
            value {
              as "t.Node"
              of {
                kids [
                  {
                    ref "leaf"
                  }
                  {
                    ref "leaf"
                  }
                ]
                left {
                  ref "leaf"
                }
                n 2
              }
            }
          }
        ]
        result {
          first {
            ref "root.kids[0].n"
          }
          kids {
            call {
              arguments [
                {
                  ref "root.kids"
                }
              ]
              procedure "std.collection.count"
            }
          }
        }
        returns {
          first "int"
          kids "int"
        }
      }
    }
    types {
      "t.Node" {
        kids "array<t.Node>"
        left "t.Node?"
        n "int"
      }
    }
    warp 1
  }
  test 1
}

