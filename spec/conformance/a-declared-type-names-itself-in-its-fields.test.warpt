warpt 1
{
  expect {
    answers {
      first 1
      kids 2
    }
  }
  name "a-declared-type-names-itself-in-its-fields"
  note "A type declared in `types` may name itself in a field, nullable or as a list's element, and a value of it is built and read like any other."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "leaf"
            value {
              as {
                of {
                  record {
                    kids []
                    left null
                    n 1
                  }
                }
                type "T.Node"
              }
            }
          }
          {
            let "root"
            value {
              as {
                of {
                  record {
                    kids [
                      {
                        ref "leaf"
                      }
                      {
                        ref "leaf"
                      }
                    ]
                    left {
                      ref "leaf"
                    }
                    n 2
                  }
                }
                type "T.Node"
              }
            }
          }
        ]
        result {
          record {
            first {
              ref "root.kids[0].n"
            }
            kids {
              call {
                arguments [
                  {
                    ref "root.kids"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        }
        returns {
          record {
            first "Int"
            kids "Int"
          }
        }
      }
    }
    types {
      "T.Node" {
        record {
          kids "Array<T.Node>"
          left "T.Node?"
          n "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

