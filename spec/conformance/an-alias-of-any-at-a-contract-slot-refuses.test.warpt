warpt 1
{
  expect {
    refuses "build"
  }
  name "an-alias-of-any-at-a-contract-slot-refuses"
  note "App.Loose stands for Any, and an alias is judged by what it stands for. A value read as Any stands nowhere a contract is asked, so the call refuses at the build however the reading is spelled."
  program {
    contracts {
      "App.Shape" {}
    }
    imports []
    procedures {
      "App.g" {
        parameters [
          {
            name "p"
            type "App.Shape"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "App.Loose"
            value 5
          }
        ]
        result {
          call {
            arguments [
              {
                ref "d"
              }
            ]
            procedure "App.g"
          }
        }
        returns "Int"
      }
    }
    satisfies {
      "App.Point" [
        "App.Shape"
      ]
    }
    types {
      "App.Loose" "Any"
      "App.Point" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

