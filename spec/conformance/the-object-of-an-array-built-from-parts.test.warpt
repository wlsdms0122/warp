(test 1)
(name "the-object-of-an-array-built-from-parts")
(note "An array whose elements are not all constants is built at the run from its parts, under operation tag 2; one that is all constants would be a literal.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter n (type Int))
    (returns (array Int))
    (result (array n 2))))
