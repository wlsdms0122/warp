warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-handed-at-a-parameter-bounded-by-a-membership-of-lists-is-read-part-by-part-refuses"
  note "`App.g` takes `some T` bounded by `App.M`, which admits `array<int>` and `array<string>`. The call hands `[1, \"s\"]`. Its parts joined read as `array<any>`, which a member takes, but the literal is one of the members part by part, as one written into a slot declaring `App.M` is, and neither takes both an int and a string. So the build refuses."
  program {
    constraints {
      "App.M" [
        "array<int>"
        "array<string>"
      ]
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    1
                    "s"
                  ]
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

