warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-literal-a-return-carries-answers-what-its-declaration-answers-refuses"
  note "`App.make` answers `{ procedure: { returns: App.Point } }`, and the closure literal a `return` in its body carries writes no `returns`, so it answers what that procedure type answers. Its body answers `{ x: 1, y: 2 }`, which is no `App.Point`, so it refuses at the build as the same closure written at a name declaring that type does."
  program {
    imports []
    procedures {
      "App.make" {
        body [
          {
            value {
              return {
                closure {
                  result {
                    struct {
                      x 1
                      y 2
                    }
                  }
                }
              }
            }
          }
        ]
        returns {
          procedure {
            returns "App.Point"
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              call {
                procedure "App.make"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

