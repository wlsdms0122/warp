warpt 1
{
  expect {
    answers App.Point {
      x 1
    }
  }
  name "a-closure-literal-in-a-list-of-procedures-answering-a-declared-struct-names-what-it-answers"
  note "`c` declares a list of `() -> App.Point`, and the closure literal written as its element writes no `returns`, so it answers `App.Point`: the struct literal it answers is written where `App.Point` is read and takes the name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "Array<() -> App.Point>"
            value [
              {
                closure {
                  result {
                    struct {
                      x 1
                    }
                  }
                }
              }
            ]
          }
        ]
        result {
          call {
            procedure {
              ref "c[0]"
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

