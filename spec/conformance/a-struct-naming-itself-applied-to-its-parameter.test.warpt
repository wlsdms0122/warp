(test 1)
(name "a-struct-naming-itself-applied-to-its-parameter")
(note "`App.List` names itself in a field, applied to its own parameter, so a list of two is one declaration and its second head reads as `Int`.")

(program
  (warp 1)
  (struct App.List
    (typeParameter T)
    (field head (some T))
    (field tail (optional (named App.List (some T)))))
  (procedure entry
    (access public)
    (returns (optional Int))
    (body
      (let l (type (named App.List Int)) (struct (field head 1) (field tail (struct (field head 2) (field tail null)))))
      (return (path l (field tail) (field? head))))))
(expect (answers 2))
