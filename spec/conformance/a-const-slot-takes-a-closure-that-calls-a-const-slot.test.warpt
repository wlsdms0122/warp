warpt 1
{
  expect {
    answers true
  }
  name "a-const-slot-takes-a-closure-that-calls-a-const-slot"
  note "A procedure that calls a name its own slot said holds a procedure answering without running answers without running itself. So a closure sending it fits a slot asking a `const` procedure type."
  program {
    imports [
      "Standard.Logic.and"
    ]
    procedures {
      "App.asking" {
        body [
          {
            let "answered"
            value {
              call {
                procedure {
                  ref "body"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type "const () -> Bool"
          }
        ]
        result {
          ref "answered"
        }
        returns "Bool"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result {
                      call {
                        arguments [
                          {
                            closure {
                              result true
                              returns "Bool"
                            }
                          }
                        ]
                        procedure "App.asking"
                      }
                    }
                    returns "Bool"
                  }
                }
              ]
            ]
            procedure "Standard.Logic.and"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

