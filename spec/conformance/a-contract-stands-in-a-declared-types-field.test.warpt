(test 1)
(name "a-contract-stands-in-a-declared-types-field")
(note "A contract's name stands where a type is written, a declared type's field included. A value of the declared type holds a value of whatever type satisfies the contract there, and the body calls the contract's procedure on it.")

(program
  (warp 1)
  (struct Bank.Card
    (satisfies App.Describable)
    (field limit Int)
    (procedure describe
      (const)
      (isolated)
      (parameter of (type Bank.Card))
      (returns String)
      (body
        (return "a card"))))
  (struct Bank.Wallet
    (field cards (array App.Describable)))
  (contract App.Describable
    (procedure describe
      (const)
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (const)
    (returns String)
    (failing cast_refused)
    (body
      (let wallet (as (struct (field cards (array (as (struct (field limit 5)) Bank.Card)))) Bank.Wallet))
      (return (call App.Describable.describe (path wallet (field cards) (index 0)))))))
(expect (answers "a card"))
