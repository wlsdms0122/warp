warpt 1
{
  expect {
    answers "a card"
  }
  name "a-contract-stands-in-a-declared-types-field"
  note "A contract's name stands where a type is written, a declared type's field included. A value of the declared type holds a value of whatever type satisfies the contract there, and the body calls the contract's procedure on it."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            const true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "wallet"
            value {
              as {
                of {
                  struct {
                    cards [
                      {
                        as {
                          of {
                            struct {
                              limit 5
                            }
                          }
                          type "Bank.Card"
                        }
                      }
                    ]
                  }
                }
                type "Bank.Wallet"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "wallet.cards[0]"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          limit "Int"
        }
      }
      "Bank.Wallet" {
        struct {
          cards "Array<App.Describable>"
        }
      }
    }
    warp 1
  }
  test 1
}

