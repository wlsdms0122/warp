warpt 1
{
  expect {
    answers "a card"
  }
  name "a-contract-stands-in-a-declared-types-field"
  note "A contract's name stands where a type is written, a declared type's field included. A record settling into the declared type holds a value of whatever type satisfies the contract there, and the body calls the contract's procedure on it."
  program {
    contracts {
      "app.Describable" {
        describe {
          const true
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.Card.describe" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "wallet"
            value {
              as {
                of {
                  record {
                    cards [
                      {
                        as {
                          of {
                            record {
                              limit 5
                            }
                          }
                          type "bank.Card"
                        }
                      }
                    ]
                  }
                }
                type "bank.Wallet"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "wallet.cards[0]"
              }
            ]
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "bank.Card" [
        "app.Describable"
      ]
    }
    types {
      "bank.Card" {
        record {
          limit "int"
        }
      }
      "bank.Wallet" {
        record {
          cards "array<app.Describable>"
        }
      }
    }
    warp 1
  }
  test 1
}

