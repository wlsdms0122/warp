warpt 1
{
  expect {
    refuses "load"
  }
  name "an-access-written-as-what-its-absence-means-refuses"
  note "A declaration that writes no `access` is `internal`, so writing `access \"internal\"` is a second spelling of it. A document says each thing one way, and this one is refused where it is read."
  program {
    imports []
    procedures {
      "App.one" {
        access "internal"
        result 1
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.one"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

