(test 1)
(name "a-call-fills-an-associated-type-only-a-cast-in-the-body-names")
(note "App.g bounds C by App.Container, which asks `Item`, and names `some C.Item` only in a cast its body writes, never in its signature. The call fills `C.Item` all the same, once it fills C: filled with App.Words the cast matches a string and reads an integer as the none, and filled with App.Box, whose `Item` is `Int`, the other way round.")

(program
  (warp 1)
  (struct App.Box
    (satisfies App.Container)
    (field x Int)
    (type Item Int)
    (procedure first
      (parameter of (type App.Box))
      (returns Int)
      (body
        (return 0))))
  (struct App.Words
    (satisfies App.Container)
    (field x Int)
    (type Item String)
    (procedure first
      (parameter of (type App.Words))
      (returns String)
      (body
        (return "w"))))
  (contract App.Container
    (type Item)
    (procedure first
      (parameter of (type Self))
      (returns Self.Item)))
  (procedure App.g
    (parameter c (type (some C App.Container)))
    (parameter a)
    (returns Any)
    (body
      (return (as? a (some C.Item)))))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let w (type App.Words) (struct (field x 1)))
      (let b (type App.Box) (struct (field x 1)))
      (return (array (call App.g w "s") (call App.g w 1) (call App.g b 1) (call App.g b "s"))))))
(expect (answers (array "s" null 1 null)))
