(test 1)
(name "a-claim-import-whose-type-is-no-types-name-refuses")
(note "A claim among the imports is written as the type's name and the contract's. `T.Card<Int>` is a mention applying a type and no type's name, so the import refuses at the load.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (result "card"))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))
(tree (dictionary (entry "imports" (array "App.Describable.describe" "T.Card" "T.Card<Int>: App.Describable")) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "card") (entry "value" (dictionary (entry "as" (dictionary (entry "of" (dictionary (entry "struct" (dictionary (entry "rank" 1))))) (entry "type" "T.Card")))))))) (entry "result" (dictionary (entry "call" (dictionary (entry "arguments" (array (dictionary (entry "ref" "card")))) (entry "procedure" "App.Describable.describe"))))) (entry "returns" "String"))))) (entry "warp" 1)))
(expect (refuses load))
