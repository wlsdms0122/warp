(test 1)
(name "a-cast-onto-a-type-parameter-refuses")
(note "A cast names a type to read a value as. A type parameter names no type here, only what a call fills in, so a cast onto `some T` refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (some T)))
    (returns (some T))
    (body
      (return (as x (some T)))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.f 1)))))
(expect (refuses load))
