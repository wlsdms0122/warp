warpt 1
{
  expect {
    refuses "build"
  }
  name "a-bare-constraint-name-refuses-at-the-build"
  note "`Comparable` is not the spelling of any declaration in the link: `std` declares `std.Comparable`, and this document declares no constraint of its own. A name is looked up as written, so the bound refuses at the build."
  program {
    imports []
    procedures {
      entry {
        result {
          call {
            arguments {
              value 3
            }
            procedure "keep"
          }
        }
        returns "int"
      }
      keep {
        bounds {
          T "Comparable"
        }
        parameters {
          value {
            type "some T"
          }
        }
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 2
}

