warpt 1
{
  expect {
    refuses "build"
  }
  name "a-struct-literal-at-a-type-parameter-nothing-fills-with-a-struct-refuses"
  note "A struct literal at a type parameter reads as the declared struct the call's other arguments fill it with. `App.same` is handed an `Int` beside it, so the literal is written where no declared struct is read, and it refuses at the build."
  program {
    imports []
    procedures {
      "App.same" {
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result {
          ref "b"
        }
        returns "some T"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              {
                struct {
                  x 2
                }
              }
            ]
            procedure "App.same"
          }
        }
      }
    }
    types {
      "App.P" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

