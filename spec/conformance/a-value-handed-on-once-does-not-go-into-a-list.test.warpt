warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-handed-on-once-does-not-go-into-a-list"
  note "What follows the value is the name that holds it, and a name does not follow it into a type. Written into a list the obligation would be neither handed on nor still held."
  program {
    imports [
      "app.open"
    ]
    procedures {
      entry {
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
        ]
        result [
          {
            ref "handle"
          }
        ]
        returns "any"
      }
    }
    warp 1
  }
  test 3
  vocabulary {
    procedures {
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          name "string"
        }
      }
    }
  }
}

