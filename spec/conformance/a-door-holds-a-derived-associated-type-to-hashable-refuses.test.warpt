(test 1)
(name "a-door-holds-a-derived-associated-type-to-hashable-refuses")
(note "The entry bounds `C.Item` by Hashable and keys a map by it, and the run hands a box of a struct no claim makes Hashable, so the door refuses it.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))
    (struct App.Plain
      (field x Int))))

(program
  (warp 1)
  (import Lib.Container)
  (import Lib.Container.first)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Container)))
    (returns (dictionary (some C.Item) Int))
    (bound C.Item Hashable)
    (body
      (let y (call Lib.Container.first c))
      (return (dictionary (entry y 1))))))
(arguments (argument c (struct App.Box (field item (struct App.Plain (field x 1))))))
(expect (refuses run))
