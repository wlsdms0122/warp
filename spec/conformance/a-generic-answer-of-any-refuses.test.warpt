(test 1)
(name "a-generic-answer-of-any-refuses")
(note "App.gen answers some T, and its body answers a variable declared Any. A body does not know what filled its parameter, so a reading of Any is no value of it, and the answer refuses at the build.")

(program
  (warp 1)
  (import Standard.Text.uppercased)
  (procedure App.gen
    (parameter x (type (some T)))
    (returns (some T))
    (body
      (var y (type Any) 5))
    (result y))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let r (call App.gen "s"))
      (let u (call Standard.Text.uppercased r)))
    (result u)))
(expect (refuses build))
