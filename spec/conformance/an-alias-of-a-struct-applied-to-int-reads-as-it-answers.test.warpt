warpt 1
{
  expect {
    answers 1
  }
  name "an-alias-of-a-struct-applied-to-int-reads-as-it-answers"
  note "An alias takes no type parameters, and what it stands for may be a struct applied to types. `App.IntBox` stands for `App.Box<Int>`, and a mention of it reads that way."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.IntBox"
            value {
              struct {
                item 1
              }
            }
          }
        ]
        result {
          ref "b.item"
        }
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
      "App.IntBox" "App.Box<Int>"
    }
    warp 1
  }
  test 1
}

