warpt 1
{
  expect {
    answers 1
  }
  name "a-closure-writes-what-it-captured"
  note "A variable's box is one thing under one name everywhere the name is visible, and a closure's body is one of those places. Calling the closure writes the box the enclosing body reads."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "tally"
          }
          {
            let "held"
            value {
              closure {
                body [
                  {
                    set "tally"
                    value 1
                  }
                ]
              }
            }
          }
          {
            value {
              apply {
                procedure {
                  ref "held"
                }
              }
            }
          }
        ]
        result {
          ref "tally"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

