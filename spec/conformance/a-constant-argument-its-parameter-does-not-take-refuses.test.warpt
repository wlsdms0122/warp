warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-argument-its-parameter-does-not-take-refuses"
  note "What is knowable before running is decided before running. A constant's type is knowable, so a call passing one that does not fit is refused where declarations are checked rather than where values arrive."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "not a number"
            ]
            procedure "wants"
          }
        }
      }
      wants {
        parameters [
          {
            name "it"
            type "Int"
          }
        ]
        result {
          ref "it"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

