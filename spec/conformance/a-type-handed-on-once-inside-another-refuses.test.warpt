warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-handed-on-once-inside-another-refuses"
  note "A linear value is followed by the name holding it, and nothing follows one into a list. A slot naming a list of such a type is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "array<app.Handle>"
          }
        ]
        result 1
        returns "int"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

