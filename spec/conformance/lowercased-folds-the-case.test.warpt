warpt 1
{
  expect {
    answers "warp"
  }
  name "lowercased-folds-the-case"
  note "lowercased answers new text with the case folded down, leaving what it was given unchanged."
  program {
    imports [
      "Standard.Text.lowercased"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "WaRp"
            ]
            procedure "Standard.Text.lowercased"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

