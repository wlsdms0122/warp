(test 1)
(name "lowercased-folds-the-case")
(note "lowercased answers new text with the case folded down, leaving what it was given unchanged.")

(program
  (warp 1)
  (import Standard.Text.lowercased)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call Standard.Text.lowercased "WaRp")))))
(expect (answers "warp"))
