(test 1)
(name "a-return-value-the-declaration-does-not-take-refuses")
(note "A return value is held to the return type the declaration writes: the string it returns is no `Int`.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return "three hundred"))))
(expect (refuses build))
