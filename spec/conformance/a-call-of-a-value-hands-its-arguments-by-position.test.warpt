warpt 1
{
  expect {
    answers App.Pair {
      first 1
      second "x"
    }
  }
  name "a-call-of-a-value-hands-its-arguments-by-position"
  note "Calling a value hands its arguments as a list, each landing at the position it is written at, in the order the closure declared its parameters. A value carries no names, so there is nothing to hand by."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "pair"
            value {
              closure {
                parameters [
                  {
                    name "first"
                    type "Int"
                  }
                  {
                    name "second"
                    type "String"
                  }
                ]
                result {
                  record {
                    first {
                      ref "first"
                    }
                    second {
                      ref "second"
                    }
                  }
                }
                returns "App.Pair"
              }
            }
          }
          {
            let "made"
            value {
              call {
                arguments [
                  1
                  "x"
                ]
                procedure {
                  ref "pair"
                }
              }
            }
          }
        ]
        result {
          ref "made"
        }
        returns "App.Pair"
      }
    }
    types {
      "App.Pair" {
        record {
          first "Int"
          second "String"
        }
      }
    }
    warp 1
  }
  test 1
}

