warpt 1
{
  expect {
    answers {
      first 1
      second "x"
    }
  }
  name "a-call-of-a-value-hands-its-arguments-by-position"
  note "Calling a value hands its arguments as a list, each landing at the position it is written at, in the order the closure declared its parameters. A value carries no names, so there is nothing to hand by."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "pair"
            value {
              closure {
                parameters [
                  {
                    name "first"
                    type "int"
                  }
                  {
                    name "second"
                    type "string"
                  }
                ]
                result {
                  first {
                    ref "first"
                  }
                  second {
                    ref "second"
                  }
                }
                returns {
                  first "int"
                  second "string"
                }
              }
            }
          }
          {
            let "made"
            value {
              call {
                arguments [
                  1
                  "x"
                ]
                procedure {
                  ref "pair"
                }
              }
            }
          }
        ]
        result {
          ref "made"
        }
        returns {
          first "int"
          second "string"
        }
      }
    }
    warp 1
  }
  test 1
}

