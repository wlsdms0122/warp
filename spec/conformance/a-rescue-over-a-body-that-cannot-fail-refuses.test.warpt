warpt 1
{
  expect {
    refuses "build"
  }
  name "a-rescue-over-a-body-that-cannot-fail-refuses"
  note "What a rescue catches is what the body casts and calls. A body that casts nothing and calls nothing that fails leaves the rescue a body no run reaches, and the build says so rather than letting it stand."
  program {
    imports [
      "Standard.Math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body []
                rescue {
                  result 0
                }
                result {
                  call {
                    arguments [
                      1
                      2
                    ]
                    procedure "Standard.Math.plus"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

