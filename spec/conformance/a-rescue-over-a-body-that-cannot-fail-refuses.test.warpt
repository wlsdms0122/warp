warpt 1
{
  expect {
    refuses "link"
  }
  name "a-rescue-over-a-body-that-cannot-fail-refuses"
  note "What a rescue catches is what the body casts and calls. A body that casts nothing and calls nothing that fails leaves the rescue a body no run reaches, and the link says so rather than letting it stand."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        body [
          {
            let "tried"
            value {
              attempt {
                body []
                result {
                  call {
                    arguments {
                      value 2
                    }
                    of 1
                    procedure "std.math.plus"
                  }
                }
                rescue {
                  result 0
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}
