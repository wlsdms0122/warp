warpt 1
{
  expect {
    refuses "build"
  }
  name "a-dictionary-key-that-is-not-text-refuses"
  note "A key stands where a String is read, and `k` reads `Int`, so `d[k]` refuses at the build."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "d"
            type "Dictionary<String, Int>"
          }
          {
            name "k"
            type "Int"
          }
        ]
        result {
          ref "d[k]"
        }
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                record {
                  a 1
                }
              }
              0
            ]
            procedure "App.f"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

