warpt 1
{
  expect {
    refuses "run"
  }
  name "a-path-written-from-any-into-a-list-of-a-parameter-is-judged-refuses"
  note "app.g writes junk, read as any, into cell[0], where cell is a list of T. A write through a path leaves cell reading as a list of T, so the body proves nothing and the call judges its answer, and the string refuses at the run."
  program {
    imports []
    procedures {
      "app.g" {
        body [
          {
            value [
              {
                ref "x"
              }
            ]
            var "cell"
          }
          {
            set "cell[0]"
            value {
              ref "junk"
            }
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "junk"
            type "any"
          }
        ]
        result {
          ref "cell"
        }
        returns "array<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  "s"
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

