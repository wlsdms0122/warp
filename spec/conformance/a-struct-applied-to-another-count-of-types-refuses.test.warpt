(test 1)
(name "a-struct-applied-to-another-count-of-types-refuses")
(note "`App.Box` lists one type parameter, so a mention applying it to two is refused at the build where the name resolves.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int Int)) (struct (field item 1))))
    (result 1)))
(expect (refuses build))
