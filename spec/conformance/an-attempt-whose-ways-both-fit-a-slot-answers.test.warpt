warpt 1
{
  expect {
    answers 1
  }
  name "an-attempt-whose-ways-both-fit-a-slot-answers"
  note "An Int variable is set to an attempt whose body and rescue both answer an int. Each way fits, and the body finishes, so the variable holds its answer."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "Int"
            value 0
            var "x"
          }
          {
            set "x"
            value {
              attempt {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              call {
                                arguments [
                                  "x"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        when false
                      }
                    }
                  }
                ]
                rescue {
                  result 2
                }
                result 1
              }
            }
          }
        ]
        result {
          ref "x"
        }
      }
    }
    warp 1
  }
  test 1
}

