warpt 1
{
  arguments {
    it null
  }
  expect {
    refuses "run"
  }
  name "an-argument-through-any-is-held-to-its-parameter"
  note "An argument is held to its parameter at the run where the build could not judge it. `uppercased` declares `of: String`; a null that arrives there through `Any` is not a string, and the run says so instead of reading it as nothing."
  program {
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "it"
            type "Any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "Standard.Text.uppercased"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

