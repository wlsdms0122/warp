warpt 1
{
  expect {
    refuses "build"
  }
  name "a-membership-holding-a-list-of-itself-refuses-a-nested-list-of-other-kinds"
  note "`App.M` admits `Int` and `Array<App.M>`. In `[[1, \"s\"]]` the inner list is asked of `App.M` as a literal of its own, and `\"s\"` is neither an int nor a list, so the build refuses."
  program {
    constraints {
      "App.M" [
        "Int"
        "Array<App.M>"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "App.M"
            value [
              [
                1
                "s"
              ]
            ]
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

