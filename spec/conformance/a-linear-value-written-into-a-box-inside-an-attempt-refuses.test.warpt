warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-value-written-into-a-box-inside-an-attempt-refuses"
  note "An attempt's body may fail before or after a write, so whether a box written inside one holds a value written `linear` afterwards is not something the text says. The build refuses the write."
  program {
    imports [
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "app.open"
              }
            }
            var "h"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "app.close"
              }
            }
          }
          {
            value {
              attempt {
                body [
                  {
                    let "checked"
                    value {
                      as {
                        of 0
                        type "int(0...255)"
                      }
                    }
                  }
                  {
                    set "h"
                    value {
                      call {
                        procedure "app.open"
                      }
                    }
                  }
                ]
                rescue {
                  result 1
                }
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.look" {
        answers 1
        parameters [
          {
            name "first"
            type "borrowing app.Handle"
          }
        ]
        returns "int"
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

