(test 1)
(name "the-object-of-an-attempt")
(note "An attempt carries its body, its rescue and the slot the failure is bound in for the rescue to read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter payload)
    (returns String)
    (body
      (let tried
        (attempt
          (body
            (let read (as payload String)))
          (result read)
          (rescue
            (result "caught")))))
    (result tried)))
