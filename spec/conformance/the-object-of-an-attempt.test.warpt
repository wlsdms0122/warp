(test 1)
(name "the-object-of-an-attempt")
(note "An attempt carries its body, its rescue and the slot the failure is bound in for the rescue to read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter payload)
    (returns String)
    (body
      (var tried)
      (attempt
        (body
          (let read (as payload String))
          (set tried read))
        (rescue
          (set tried "caught"))))
    (result tried)))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)) (array 1 (array)) (array 2 (array)) (array 1 (array)) (array 1 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"218f6bc01d697ebfeae5f6f4b83c294003d81a63f1e1cacd91c6bc39b229c538")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 6))) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 6 1 0 false) (array 1 2) (array 0 1) (array 10 (array (array (array (array 0 2)) 2 "read") (array (array (array 2 1)) 3 "tried")) (array (array (array (array 2 3)) 4 "tried")) (array)) (array 1 4))) (entry "rows" (array (array "entry" (array (array (array "payload" (array) (array))) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array (array 1 1)) 0 "tried") (array (array) 5 "[1]")) (array 6)) (array 3 (array 0) (array) (array) (array "payload" "tried" "read")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 6))) (entry "types" (array)) (entry "valueTable" (array (array 0) (array 4 "caught"))) (entry "variables" (array)))))
