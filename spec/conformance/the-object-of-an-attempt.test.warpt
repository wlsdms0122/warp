(test 1)
(name "the-object-of-an-attempt")
(note "An attempt carries its body, its rescue and the slot the failure is bound in for the rescue to read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter payload)
    (returns String)
    (body
      (var tried)
      (attempt
        (body
          (let read (as payload String))
          (set tried read))
        (rescue
          (set tried "caught")))
      (return tried))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)) (array 1 (array)) (array 2 (array)) (array 1 (array)) (array 1 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"84247b5f1f93335d42c792d246827f6086698723165063960bb0906af6a473d3")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 6))) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 6 1 0 false) (array 1 2) (array 0 1) (array 10 (array (array (array (array 0 2)) 2 "read") (array (array (array 2 1)) 3 "tried")) (array (array (array (array 2 3)) 4 "tried")) (array)) (array 1 4) (array 13 0 (array) (array 6)))) (entry "rows" (array (array "entry" (array (array (array "payload" (array))) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 1 1)) 0 "tried") (array (array) 5 "[1]") (array (array) 7 "[2]")) (array 3 (array 0) (array) (array) (array "payload" "tried" "read")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 6))) (entry "types" (array)) (entry "valueTable" (array (array 0) (array 4 "caught"))) (entry "variables" (array)))))
