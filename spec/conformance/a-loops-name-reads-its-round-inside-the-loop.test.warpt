warpt 1
{
  expect {
    answers "f"
  }
  name "a-loops-name-reads-its-round-inside-the-loop"
  note "A loop's statement name is the round inside the loop. `h` read there is the round, which has an `index`, and the text `h` around the block is another name that keeps its value."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value "f"
          }
          {
            value {
              block {
                body [
                  {
                    let "h"
                    value {
                      loop {
                        body [
                          {
                            let "z"
                            value {
                              ref "h.index"
                            }
                          }
                          {
                            value {
                              conditional {
                                then [
                                  {
                                    value {
                                      break null
                                    }
                                  }
                                ]
                                when true
                              }
                            }
                          }
                        ]
                        result 0
                        while true
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
        result {
          ref "h"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

