warpt 1
{
  expect {
    answers 1
  }
  name "a-loops-name-reads-its-round-inside-the-loop"
  note "A loop's statement name is the round inside the loop. `h` read bare there is the round, so the outer `h` keeps its handle until `App.close` takes it."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      "App.f" {
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
          {
            value {
              block {
                body [
                  {
                    let "h"
                    value {
                      loop {
                        body [
                          {
                            let "z"
                            value {
                              ref "h"
                            }
                          }
                          {
                            value {
                              conditional {
                                then [
                                  {
                                    value {
                                      break null
                                    }
                                  }
                                ]
                                when true
                              }
                            }
                          }
                        ]
                        result 0
                        while true
                      }
                    }
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.f"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

