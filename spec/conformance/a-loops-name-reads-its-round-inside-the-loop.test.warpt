warpt 1
{
  expect {
    answers {
      inner 1
      outer "f"
    }
  }
  name "a-loops-name-reads-its-round-inside-the-loop"
  note "A loop's statement name is the round inside the loop: `h.index` in the condition and the body reads the round, and the last round to run is 1. The `h` around the arm is another name and keeps its value."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value "f"
          }
          {
            value 0
            var "inner"
          }
          {
            value {
              conditional {
                then [
                  {
                    let "h"
                    value {
                      loop {
                        body [
                          {
                            set "inner"
                            value {
                              ref "h.index"
                            }
                          }
                        ]
                        while {
                          call {
                            arguments [
                              {
                                ref "h.index"
                              }
                              2
                            ]
                            procedure "Standard.Comparable.lessThan"
                          }
                        }
                      }
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
        result {
          dictionary [
            [
              "inner"
              {
                ref "inner"
              }
            ]
            [
              "outer"
              {
                ref "h"
              }
            ]
          ]
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

