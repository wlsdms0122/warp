warpt 1
{
  expect {
    answers {
      inner 2
      outer "f"
    }
  }
  name "a-loops-name-reads-its-round-inside-the-loop"
  note "A loop's statement name is the round inside the loop: `h.index` in the condition and the result reads the round, and after rounds 0 and 1 have finished it is 2, where the condition stops the loop. After the loop the name reads what the loop answered, and the text `h` around the block is another name that keeps its value."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value "f"
          }
          {
            let "inner"
            value {
              block {
                body [
                  {
                    let "h"
                    value {
                      loop {
                        body []
                        result {
                          ref "h.index"
                        }
                        while {
                          call {
                            arguments [
                              {
                                ref "h.index"
                              }
                              2
                            ]
                            procedure "Standard.Comparable.lessThan"
                          }
                        }
                      }
                    }
                  }
                ]
                result {
                  ref "h"
                }
              }
            }
          }
        ]
        result {
          record {
            inner {
              ref "inner"
            }
            outer {
              ref "h"
            }
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

