warpt 1
{
  expect {
    answers 1
  }
  name "a-whole-key-and-a-fraction-of-its-worth-are-one-key"
  note "A map's keys are found by the value model's sameness, so `1` and `1.0` are one key: the second entry writes over the first, and the map holds one."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    1
                    "a"
                  ]
                  [
                    1.0
                    "b"
                  ]
                ]
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

