(test 1)
(name "a-whole-literal-at-a-fraction-slot-is-the-fraction")
(note "A whole number written as a literal at a `Double` slot is the fraction it names. A fraction is no whole number, and the reverse refuses.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call wants 2))))
  (procedure wants
    (parameter it (type Double))
    (returns Double)
    (body
      (return it))))
(expect (answers 2.0))
