(test 1)
(name "a-struct-holding-an-empty-list-written-into-one-handed-in-place-answers")
(note "A box handed in place takes what reads as its own type, and a struct applied to a list of nothing reads as applied to a list of the parameter.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure App.clear
    (parameter b (type (inout (named App.Box (array (some T))))))
    (returns Int)
    (body
      (set b (call App.wrap (array))))
    (result 1))
  (procedure App.wrap
    (parameter x (type (some T)))
    (returns (named App.Box (some T)))
    (result (struct (field item x))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var b (type (named App.Box (array Int))) (struct (field item (array 1)))))
    (result (call App.clear b))))
(expect (answers 1))
