warpt 1
{
  expect {
    answers [
      3
      2
      -3
      3
      -3
    ]
  }
  name "absolute-floored-and-rounded-answer-a-whole"
  note "absolute drops the sign and keeps the kind; floored goes toward the smaller whole even below zero; rounded goes to the nearest whole, away from zero at the halfway."
  program {
    imports [
      "Standard.Math.absolute"
      "Standard.Math.floored"
      "Standard.Math.rounded"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "sized"
            value {
              call {
                arguments [
                  -3
                ]
                procedure "Standard.Math.absolute"
              }
            }
          }
          {
            let "down"
            value {
              call {
                arguments [
                  2.9
                ]
                procedure "Standard.Math.floored"
              }
            }
          }
          {
            let "below"
            value {
              call {
                arguments [
                  -2.1
                ]
                procedure "Standard.Math.floored"
              }
            }
          }
          {
            let "near"
            value {
              call {
                arguments [
                  2.5
                ]
                procedure "Standard.Math.rounded"
              }
            }
          }
          {
            let "nearBelow"
            value {
              call {
                arguments [
                  -2.5
                ]
                procedure "Standard.Math.rounded"
              }
            }
          }
        ]
        result [
          {
            ref "sized"
          }
          {
            ref "down"
          }
          {
            ref "below"
          }
          {
            ref "near"
          }
          {
            ref "nearBelow"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

