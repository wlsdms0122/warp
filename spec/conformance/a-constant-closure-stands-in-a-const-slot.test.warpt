warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-constant-closure-stands-in-a-const-slot"
  note "A constant keeps the one value it settled to, so the closure it holds reads as the procedure type its literal declares, `const` included. `Standard.Collection.map` takes it in its slot of a `const` procedure type."
  program {
    const {
      f {
        closure {
          const true
          isolated true
          parameters [
            {
              name "x"
              type "Int"
            }
          ]
          result {
            ref "x"
          }
          returns "Int"
        }
      }
    }
    imports [
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        const true
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                ref "f"
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

