warpt 1
{
  expect {
    answers 7
  }
  name "a-declaration-answering-a-contract-may-take-anything-where-it-writes-a-parameter"
  note "The contract takes some T, its own parameter, and the declaration answering it takes Any there. A slot taking anything takes whatever the contract's parameter stands for."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "some T"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  "x"
                ]
                procedure "App.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
              {
                name "n"
              }
            ]
            result 7
            returns "Int"
          }
        }
        satisfies [
          "App.Sized"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

