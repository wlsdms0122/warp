warpt 1
{
  expect {
    refuses "build"
  }
  name "two-structs-applied-to-two-types-in-a-list-join-to-anything-refuses"
  note "Two readings of one struct applied to two types are two types, and two types that differ join to `Any`. A list of an `App.Box<Int>` and an `App.Box<String>` reads as a list of `Any`, and nothing read out of it is the `String` the entry declares."
  program {
    imports []
    procedures {
      "App.first" {
        parameters [
          {
            name "bs"
            type "Array<App.Box<some T>>"
          }
        ]
        result {
          ref "bs[0].item"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "a"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "b"
            type "App.Box<String>"
            value {
              struct {
                item "x"
              }
            }
          }
          {
            let "xs"
            value [
              {
                ref "a"
              }
              {
                ref "b"
              }
            ]
          }
        ]
        result {
          call {
            arguments [
              {
                ref "xs"
              }
            ]
            procedure "App.first"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

