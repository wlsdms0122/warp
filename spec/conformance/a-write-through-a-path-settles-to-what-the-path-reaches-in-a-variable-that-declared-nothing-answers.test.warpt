warpt 1
{
  expect {
    answers "a"
  }
  name "a-write-through-a-path-settles-to-what-the-path-reaches-in-a-variable-that-declared-nothing-answers"
  note "`w` declares nothing and starts as `{ p: a }`, where `a` is a `bank.A`. `set w.p` writes the nameless record `{ k: \"y\" }`. A write through a path settles to what the path reaches, which the build reads as `bank.A`, so `app.P.show` is sent to `w.p`."
  program {
    contracts {
      "app.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.A.show" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "a"
            value {
              as {
                of {
                  record {
                    k "x"
                  }
                }
                type "bank.A"
              }
            }
          }
          {
            value {
              record {
                p {
                  ref "a"
                }
              }
            }
            var "w"
          }
          {
            set "w.p"
            value {
              record {
                k "y"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "w.p"
              }
            ]
            procedure "app.P.show"
          }
        }
      }
    }
    satisfies {
      "bank.A" [
        "app.P"
      ]
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

