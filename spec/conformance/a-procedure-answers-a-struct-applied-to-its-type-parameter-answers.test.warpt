(test 1)
(name "a-procedure-answers-a-struct-applied-to-its-type-parameter-answers")
(note "`App.wrap` answers `App.Box<some T>` built from what it is handed. The call fills `T` with `Int`, so what it answers stands where `App.Box<Int>` is declared.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure App.wrap
    (parameter x (type (some T)))
    (returns (named App.Box (some T)))
    (body
      (return (struct (field item x)))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (call App.wrap 3))
      (return (path b (field item))))))
(expect (answers 3))
