warpt 1
{
  expect {
    refuses "build"
  }
  name "writing-over-a-name-holding-a-linear-value-refuses"
  note "A `set` over a name still holding a value written `linear` would drop the value it held. Here `h` still holds the first handle when the second is written into it, and the build refuses."
  program {
    imports [
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "app.open"
              }
            }
            var "h"
          }
          {
            set "h"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.look" {
        answers 1
        parameters [
          {
            name "first"
            type "borrowing app.Handle"
          }
        ]
        returns "int"
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

