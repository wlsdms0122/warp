warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-module-variable-is-handed-in-place-to-a-native-word"
  note "A native word reads no module variable by name, so a module variable is handed to it in place and written back through the path."
  program {
    imports [
      "std.collection.append"
    ]
    procedures {
      entry {
        body [
          {
            value {
              call {
                arguments {
                  value 2
                }
                of {
                  ref "items"
                }
                procedure "std.collection.append"
              }
            }
          }
        ]
        result {
          ref "items"
        }
        returns "array<int>"
      }
    }
    var {
      items [
        1
      ]
    }
    warp 2
  }
  test 1
}
