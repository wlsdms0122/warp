warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-module-variable-is-handed-in-place-to-a-native-word"
  note "A module variable is handed in place to a native word the way it is to any body: the word writes through the path it was handed, and the write is in the variable when the word answers."
  program {
    imports [
      "std.collection.append"
    ]
    procedures {
      entry {
        body [
          {
            value {
              call {
                arguments {
                  value 2
                }
                of {
                  ref "items"
                }
                procedure "std.collection.append"
              }
            }
          }
        ]
        result {
          ref "items"
        }
        returns "array<int>"
      }
    }
    var {
      items [
        1
      ]
    }
    warp 1
  }
  test 1
}
