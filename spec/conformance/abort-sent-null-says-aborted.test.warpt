warpt 1
{
  expect {
    answers {
      message "aborted"
      type "aborted"
    }
  }
  name "abort-sent-null-says-aborted"
  note "`abort` takes `message: Any`, and null is a value `Any` admits. Null spells nothing, and a failure says something, so the message is `aborted`. A bare `var` holds null, and `abort` reads it."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            var "nothing"
          }
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "nothing"
                          }
                        ]
                        procedure "Standard.Control.abort"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    dictionary [
                      [
                        "message"
                        {
                          ref "tried.message"
                        }
                      ]
                      [
                        "type"
                        {
                          ref "tried.type"
                        }
                      ]
                    ]
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
        returns "Dictionary<String, String>"
      }
    }
    warp 1
  }
  test 1
}

