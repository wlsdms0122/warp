warpt 1
{
  expect {
    refuses "build"
  }
  name "a-procedure-nobody-declares-refuses-at-build"
  note "Every procedure a program sends has to come from somewhere in the link, and finding out is building rather than running."
  program {
    imports [
      "nobodyDeclaresThis"
    ]
    procedures {
      entry {
        result {
          call {
            procedure "nobodyDeclaresThis"
          }
        }
      }
    }
    warp 1
  }
  test 2
}

