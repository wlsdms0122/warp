warpt 1
{
  expect {
    reads bank.Account {
      balance 1
    }
  }
  name "a-named-record-reads-from-text"
  note "In value position a bare token followed by `{` is a record's name. The name is a declared type's spelling, and the record under it reads with that name on."
  test 1
  text "warpt 1\nbank.Account { balance 1 }\n"
}

