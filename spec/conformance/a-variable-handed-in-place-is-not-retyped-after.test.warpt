(test 1)
(name "a-variable-handed-in-place-is-not-retyped-after")
(note "A variable handed in place holds the type it read as there from the call on, since a closure the callee made may keep the box and write it as that type. Writing a string into the Int it was handed as refuses at the build.")

(program
  (warp 1)
  (import Standard.Text.uppercased)
  (procedure entry
    (access public)
    (returns String)
    (failing (anything))
    (body
      (var n 0)
      (let make
        (closure
          (parameter c (type (inout Int)))
          (returns (procedure (parameters) (returns Null)))
          (body
            (let w
              (closure
                (body
                  (set c 99)))))
          (result w)))
      (let w (apply make n))
      (set n "s")
      (apply w)
      (let u (call Standard.Text.uppercased n)))
    (result u)))
(expect (refuses build))
