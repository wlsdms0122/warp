warpt 1
{
  expect {
    refuses "run"
  }
  name "a-variable-a-generic-closure-writes-when-called-through-a-procedure-type-is-judged-refuses"
  note "App.with keeps x in cell and hands a closure taking some T, which writes cell, to a callback. The callback holds it as procedure<(int) -> int> and sends it a string read as any. The closure may write what T stands for nowhere, so the body proves nothing and the call judges its answer, and the string refuses at the run."
  program {
    imports []
    procedures {
      "App.with" {
        body [
          {
            value {
              ref "x"
            }
            var "cell"
          }
          {
            let "s"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "int"
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                ]
                procedure {
                  ref "run"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "run"
            type {
              procedure {
                parameters [
                  {
                    procedure {
                      parameters [
                        "some T"
                      ]
                      returns "int"
                    }
                  }
                ]
                returns "int"
              }
            }
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "cb"
            value {
              closure {
                body [
                  {
                    let "a"
                    type "any"
                    value "s"
                  }
                ]
                parameters [
                  {
                    name "f"
                    type {
                      procedure {
                        parameters [
                          "int"
                        ]
                        returns "int"
                      }
                    }
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "a"
                      }
                    ]
                    procedure {
                      ref "f"
                    }
                  }
                }
                returns "int"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  1
                  {
                    ref "cb"
                  }
                ]
                procedure "App.with"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

