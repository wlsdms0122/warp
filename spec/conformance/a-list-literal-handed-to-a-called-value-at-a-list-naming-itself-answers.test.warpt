warpt 1
{
  expect {
    answers [
      []
    ]
  }
  name "a-list-literal-handed-to-a-called-value-at-a-list-naming-itself-answers"
  note "`App.L` names a list of itself, and `g` is held at `Procedure(App.L) -> Any`. A call of `g` holds the literal `[[]]` to that slot before the closure takes it, and a list of empty lists is an `App.L`, however deep the name goes."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "g"
            type {
              procedure {
                parameters [
                  "App.L"
                ]
                returns "Any"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "p"
                    type "Any"
                  }
                ]
                result {
                  ref "p"
                }
                returns "Any"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              [
                []
              ]
            ]
            procedure {
              ref "g"
            }
          }
        }
      }
    }
    types {
      "App.L" "Array<App.L>"
    }
    warp 1
  }
  test 1
}

