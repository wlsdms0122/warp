warpt 1
{
  expect {
    refuses "load"
  }
  name "a-list-literal-handed-to-a-called-value-at-a-list-naming-itself-answers"
  note "`App.L` names `Array<App.L>`, a list of itself. A name that is no record and comes back to itself spells no type, so the document refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "g"
            type {
              procedure {
                parameters [
                  "App.L"
                ]
                returns "Any"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "p"
                    type "Any"
                  }
                ]
                result {
                  ref "p"
                }
                returns "Any"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              [
                []
              ]
            ]
            procedure {
              ref "g"
            }
          }
        }
      }
    }
    types {
      "App.L" "Array<App.L>"
    }
    warp 1
  }
  test 1
}

