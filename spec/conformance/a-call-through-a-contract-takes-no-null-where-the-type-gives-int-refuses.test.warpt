(test 1)
(name "a-call-through-a-contract-takes-no-null-where-the-type-gives-int-refuses")
(note "App.IntBag gives Item as Int, and a call of `Lib.Bag.take` handing a value of `Int?` at `Self.Item` refuses at the build. What a type gives is the associated type exactly, not joined with what the call hands.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Bag)
    (struct App.IntBag
      (satisfies Lib.Bag)
      (field n Int)
      (type Item Int)
      (procedure first
        (access public)
        (parameter of (type App.IntBag))
        (returns Int)
        (result (path of (field n))))
      (procedure take
        (access public)
        (parameter of (type App.IntBag))
        (parameter x (type Int))
        (returns Int)
        (result (call Int.plus x 1))))))

(program
  (warp 1)
  (import App.IntBag)
  (import Lib.Bag.take)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type App.IntBag) (struct (field n 1)))
      (let v (type (nullable Int)) null))
    (result (call Lib.Bag.take b v))))
(expect (refuses build))
