warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-outside-a-contract-in-a-closures-parameter-refuses"
  note "Applying a value hands each argument to the position the value's type declares, and the build reads that type where a name was bound to a closure literal: a value of a type that provably satisfies no such contract is refused at the build, and the body never sees it."
  program {
    contracts {
      "app.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.Card.describe" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "tell"
            value {
              closure {
                parameters [
                  {
                    name "it"
                    type "app.Describable"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "it"
                      }
                    ]
                    procedure "app.Describable.describe"
                  }
                }
                returns "string"
              }
            }
          }
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "applied"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "tell"
                }
              }
            }
          }
        ]
        result {
          ref "applied"
        }
      }
    }
    satisfies {
      "bank.Card" [
        "app.Describable"
      ]
    }
    types {
      "bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

