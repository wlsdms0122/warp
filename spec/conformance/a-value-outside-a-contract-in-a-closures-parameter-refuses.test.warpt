warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-outside-a-contract-in-a-closures-parameter-refuses"
  note "Calling a value hands each argument to the position the value's type declares, and a name bound to a closure literal holds the procedure type its signature declares: `1`, handed where `tell` takes `App.Describable`, is of a type that provably satisfies no such contract, so it is refused at the build, and the body never sees it."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "tell"
            value {
              closure {
                parameters [
                  {
                    name "it"
                    type "App.Describable"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "it"
                      }
                    ]
                    procedure "App.Describable.describe"
                  }
                }
                returns "String"
              }
            }
          }
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "applied"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "tell"
                }
              }
            }
          }
        ]
        failing "anything"
        result {
          ref "applied"
        }
        returns "String"
      }
    }
    types {
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

