(test 1)
(name "first-of-nothing-is-none")
(note "`first` and `last` return `some Element?`, and over a list holding nothing there is no element, so each returns the none: `null`.")

(program
  (warp 1)
  (import Standard.Collection.first)
  (import Standard.Collection.last)
  (procedure entry
    (access public)
    (returns (array (optional Int)))
    (body
      (let items (type (array Int)) (array))
      (return (array (call Standard.Collection.first items) (call Standard.Collection.last items))))))
(expect (answers (array null null)))
