warpt 1
{
  arguments {
    ready true
  }
  expect {
    refuses "build"
  }
  name "a-write-a-loop-round-makes-reads-back-nullable"
  note "A loop's round runs some number of times, none included, so a write inside it joins with what the name held. After it the name reads `Int?`, and a slot declared `Int` refuses it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            var "kept"
          }
          {
            value {
              loop {
                body [
                  {
                    set "kept"
                    value 1
                  }
                  {
                    value {
                      break null
                    }
                  }
                ]
                while {
                  ref "ready"
                }
              }
            }
          }
          {
            let "said"
            value {
              call {
                arguments [
                  {
                    ref "kept"
                  }
                ]
                procedure "wants"
              }
            }
          }
        ]
        parameters [
          {
            name "ready"
            type "Bool"
          }
        ]
      }
      wants {
        parameters [
          {
            name "it"
            type "Int"
          }
        ]
        result true
      }
    }
    warp 1
  }
  test 1
}

