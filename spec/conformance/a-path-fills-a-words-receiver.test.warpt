warpt 1
{
  expect {
    refuses "link"
  }
  name "a-path-fills-a-words-receiver"
  note "A path is a call that fills one slot. The receiver is judged against the word's declaration on the same surface a written call is, so text meeting absolute refuses before anything runs."
  program {
    needs []
    procedures {
      entry {
        parameters {
          word "string"
        }
        result {
          ref "word.absolute"
        }
      }
    }
    warp 1
  }
  test 1
}
