warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-what-may-be-null-where-it-answers-a-contract-refuses"
  note "The contract answers App.Sized and the declaration answering it answers Bank.Card?. Bank.Card answers App.Sized, but null does not, and the contract's answer never declared it."
  program {
    contracts {
      "App.Shown" {
        show {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "App.Sized"
            }
          ]
          returns "App.Sized"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Box.show" {
        body [
          {
            let "k"
            value {
              as {
                of {
                  record {
                    last "9"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "Bank.Box"
          }
          {
            name "n"
            type "App.Sized"
          }
        ]
        result {
          ref "k"
        }
        returns "Bank.Card?"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  record {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Box" [
        "App.Shown"
      ]
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        record {
          n "Int"
        }
      }
      "Bank.Card" {
        record {
          last "String"
        }
      }
      "Bank.Coin" {
        record {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

