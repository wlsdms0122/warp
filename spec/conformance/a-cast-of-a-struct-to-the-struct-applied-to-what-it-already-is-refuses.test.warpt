warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-struct-to-the-struct-applied-to-what-it-already-is-refuses"
  note "A reading of `App.Box<Int>` already is `App.Box<Int>`, so a cast naming it says nothing and is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  ref "b"
                }
                type "App.Box<Int>"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result 1
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

