warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-taken-inside-an-attempt-body-is-still-owed"
  note "Nothing inside an attempt hands on a value written `linear`, so a name the attempt's body binds to one reaches the end of the body still holding it."
  program {
    imports [
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "checked"
                    value {
                      as {
                        of 0
                        type "int(0...255)"
                      }
                    }
                  }
                  {
                    let "handle"
                    value {
                      call {
                        procedure "App.open"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      let "seen"
                      value 1
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

