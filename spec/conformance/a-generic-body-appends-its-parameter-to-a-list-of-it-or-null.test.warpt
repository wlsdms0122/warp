(test 1)
(name "a-generic-body-appends-its-parameter-to-a-list-of-it-or-null")
(note "Inside a declaration taking some T, a list holding null and the parameter reads Array<T?>. Appending the parameter reads Element as T? and as T, and T? takes T, so the call builds.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (procedure App.put
    (parameter x (type (some T)))
    (returns (array Any))
    (body
      (var ys (array null x))
      (call Standard.Collection.append ys x)
      (return ys)))
  (procedure entry
    (access public)
    (returns (array Any))
    (body
      (let ys (call App.put 3))
      (return ys))))
(expect (answers (array null 3 3)))
