warpt 1
{
  arguments {
    c App.Box {
      item App.Box {
        item 1
      }
    }
  }
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      extensions {
        "App.Box<some T: Hashable>" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Hashable"
            "Lib.Container"
          ]
          types {
            Item "some T"
          }
        }
      }
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
        }
      }
      warp 1
    }
  ]
  expect {
    answers App.Box {
      item 1
    }
  }
  name "a-door-reads-a-same-type-naming-an-applied-struct-answers"
  note "The entry says `C.Item` is `App.Box<Int>`. A box of a box of Int arrives: the outer box's `Item` is the inner box, so it answers it."
  program {
    imports [
      "App.Box"
      "Lib.Container"
      "Lib.Container.first"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "c"
            type "some C: Lib.Container"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "c"
              }
            ]
            procedure "Lib.Container.first"
          }
        }
        returns "App.Box<Int>"
        sameTypes {
          "C.Item" "App.Box<Int>"
        }
      }
    }
    warp 1
  }
  test 1
}

