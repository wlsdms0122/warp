(test 1)
(name "a-door-reads-a-same-type-naming-an-applied-struct-answers")
(note "The entry says `C.Item` is `App.Box<Int>`. A box of a box of Int arrives: the outer box's `Item` is the inner box, so it answers it.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Hashable Lib.Container)
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item)))))))

(program
  (warp 1)
  (import App.Box)
  (import Lib.Container)
  (import Lib.Container.first)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Container)))
    (returns (named App.Box Int))
    (sameType C.Item (named App.Box Int))
    (result (call Lib.Container.first c))))
(arguments (argument c (struct App.Box (field item (struct App.Box (field item 1))))))
(expect (answers (struct App.Box (field item 1))))
