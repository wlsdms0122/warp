warpt 1
{
  expect {
    refuses "build"
  }
  name "a-borrow-kept-in-a-box-refuses"
  note "A box outlives the call that lent the value, so a body may not keep what it borrowed in one."
  program {
    imports [
      "App.Handle"
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "stash"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
      stash {
        body [
          {
            value {
              ref "of"
            }
            var "kept"
          }
        ]
        parameters [
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

