warpt 1
{
  expect {
    refuses "build"
  }
  name "a-borrow-kept-in-a-box-refuses"
  note "A box outlives the call that lent the value, so a body may not keep what it borrowed in one."
  program {
    imports [
      "app.Handle"
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "stash"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
      }
      stash {
        body [
          {
            value {
              ref "of"
            }
            var "kept"
          }
        ]
        parameters [
          {
            name "of"
            type "borrowing app.Handle"
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

