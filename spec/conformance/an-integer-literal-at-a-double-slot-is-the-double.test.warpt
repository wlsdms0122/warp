(test 1)
(name "an-integer-literal-at-a-double-slot-is-the-double")
(note "An integer written as a literal at a `Double` slot is the floating-point number it names. A floating-point number is no integer, and the reverse refuses.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call wants 2))))
  (procedure wants
    (parameter it (type Double))
    (returns Double)
    (body
      (return it))))
(expect (answers 2.0))
