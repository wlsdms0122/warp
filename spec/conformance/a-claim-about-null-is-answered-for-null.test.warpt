(test 1)
(name "a-claim-about-null-is-answered-for-null")
(note "`Null` is a type a value is an instance of, as `Int` is, so a document may claim a contract for it. Null handed where `App.Described` is asked answers by `Null.describe`.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Null)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Null))
      (returns String)
      (body
        (return "nothing"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call App.Described.describe null)))))
(expect (answers "nothing"))
