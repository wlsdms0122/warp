warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-of-a-contract-inside-a-map-at-a-bounded-parameter-refuses"
  note "A bounded parameter is one type wherever it stands, and a map of values of a contract holds values of whichever types answer it. A value of a contract fills a bounded parameter only where the parameter stands alone at one position, so one handed as a map's value is refused at the build."
  program {
    contracts {
      "App.Described" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result "a whole number"
            returns "String"
          }
        }
        satisfies [
          "App.Described"
        ]
      }
    }
    imports []
    procedures {
      "App.first" {
        parameters [
          {
            name "xs"
            type "Dictionary<String, some T: App.Described>"
          }
        ]
        result 1
        returns "Int"
      }
      "App.wrap" {
        parameters [
          {
            name "x"
            type "App.Described"
          }
        ]
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    "a"
                    {
                      ref "x"
                    }
                  ]
                ]
              }
            ]
            procedure "App.first"
          }
        }
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "App.wrap"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

