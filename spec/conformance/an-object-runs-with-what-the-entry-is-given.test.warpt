(test 1)
(name "an-object-runs-with-what-the-entry-is-given")
(note "An object read back runs from `entry` with what the host gives it: `n` arrives as 41, is judged against the parameter the row writes, and the run answers 42.")
(object (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"a5732dc98a9098112838793ee3bc74983ef772acd039ef92ff67a167c57fe995")) (entry "document" (array x"54d4b03c4db4199a1fe9c6589788b4b6824d406982fe382d46519365ce6d7545")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Numeric.plus") (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 12 (array "Standard.Numeric" "plus" 0 (array (array 0 1)))))) (entry "rows" (array (array "entry" (array (array (array "n" (array 0) (array))) 1 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array 2)) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(arguments (argument n 41))
(expect (answers 42))
