warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-name-a-block-introduces-and-keeps-is-dropped-where-the-block-ends-refuses"
  note "The inner `h` is read nowhere after the block that introduces it, so the block reaches its end still holding the handle it made. Closing the outer `h` after the block hands on the outer handle only."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
          {
            value {
              block {
                body [
                  {
                    let "h"
                    type "App.Handle"
                    value {
                      record {
                        name "f"
                      }
                    }
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

