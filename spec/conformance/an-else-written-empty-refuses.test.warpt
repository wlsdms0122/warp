(test 1)
(name "an-else-written-empty-refuses")
(note "An empty `else` runs what no `else` runs, so writing `else []` is a second spelling of a conditional that writes none. A document says each thing one way, and this one is refused where it is read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (conditional
        (when true)
        (then)
        (else)))
    (result 1)))
(expect (refuses load))
