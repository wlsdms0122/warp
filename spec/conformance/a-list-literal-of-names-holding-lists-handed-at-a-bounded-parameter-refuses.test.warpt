warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-of-names-holding-lists-handed-at-a-bounded-parameter-refuses"
  note "`App.f` bounds `T` by `App.M`, which admits `Int` and `String`, and takes `Array<Array<some T>>`. The literal `[xs, ys]` handed there holds two names, `xs` a list of booleans and `ys` a list of whole numbers. What each name reads as stands at the parameter by its elements, and no member of `App.M` takes a boolean, so the call refuses at the build."
  program {
    constraints {
      "App.M" [
        "Int"
        "String"
      ]
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "gs"
            type "Array<Array<some T>>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "xs"
            type "Array<Bool>"
            value [
              true
            ]
          }
          {
            let "ys"
            type "Array<Int>"
            value [
              1
            ]
          }
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    {
                      ref "xs"
                    }
                    {
                      ref "ys"
                    }
                  ]
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

