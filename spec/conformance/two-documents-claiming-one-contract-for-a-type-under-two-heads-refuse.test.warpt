(test 1)
(name "two-documents-claiming-one-contract-for-a-type-under-two-heads-refuse")
(note "A type answers a contract one way, so a second document saying a type answers App.Describable under another head than the first is refused at the build.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String)))
    (extension
      (head (array Int))
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (parameter of (type (array Int)))
        (returns String)
        (body
          (return "ints"))))))

(program
  (warp 1)
  (import App.Describable)
  (extension
    (head (array String))
    (satisfies App.Describable))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
