(test 1)
(name "a-closure-answering-anything-does-not-fit-a-slot-answering-int-refuses")
(note "App.callIt takes a procedure that answers Int. The closure handed to it answers Any, and a value read as `Any` is no Int the build can see, so the closure does not fit the slot and the build refuses.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure App.callIt
    (parameter f (type (procedure (parameters) (returns Int))))
    (returns Any)
    (body
      (let v (apply f)))
    (result (call Standard.Collection.appending (array 1) v)))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let xs
        (call App.callIt
          (closure
            (returns Any)
            (result "s")))))
    (result xs)))
(expect (refuses build))
