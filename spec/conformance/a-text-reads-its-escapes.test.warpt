warpt 1
{
  expect {
    reads "\"\\\n\r\t\u0001"
  }
  name "a-text-reads-its-escapes"
  note "The quote, the backslash and the five control characters with short escapes read through their escapes, and any other control character through `\\u` and four lowercase hex digits."
  test 5
  text "warpt 1\n\"\\\"\\\\\\n\\r\\t\\u0001\"\n"
}

