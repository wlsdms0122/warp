warpt 1
{
  expect {
    refuses "build"
  }
  name "a-map-literal-whose-values-do-not-join-handed-at-a-dictionary-of-a-bounded-parameter-refuses"
  note "`App.g` bounds `T` by `App.M`, which `Int` and `String` answer, and takes `Dictionary<String, some T>`. The map literal holding `1` under `a` and `true` under `b` handed there fills `T` with each of its values, `Int` and `Bool`. The two do not join, and `Bool` answers no bound, so the call refuses at the build."
  program {
    contracts {
      "App.M" {}
    }
    extensions {
      Int {
        satisfies [
          "App.M"
        ]
      }
      String {
        satisfies [
          "App.M"
        ]
      }
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "Dictionary<String, some T>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    dictionary [
                      [
                        "a"
                        1
                      ]
                      [
                        "b"
                        true
                      ]
                    ]
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

