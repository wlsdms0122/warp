(test 1)
(name "a-fixed-name-bound-to-a-closure-literal-carries-what-it-declares-into-a-capture")
(note "A fixed name that writes no type follows the type written where its value came from, and a closure literal writes its signature, so `f`, bound to a literal declaring `const` and `isolated`, holds a `const isolated` procedure type. The closure handed to `Standard.Collection.map` declares both and calls the captured `f`, so it holds to them, and map runs it.")

(program
  (warp 1)
  (import Standard.Collection.map)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (let f
        (closure
          (const)
          (isolated)
          (parameter x (type Int))
          (returns Int)
          (body
            (return x))))
      (return
        (call Standard.Collection.map
          (array 1 2)
          (closure
            (const)
            (isolated)
            (parameter x (type Int))
            (returns Int)
            (body
              (let y (apply f x))
              (return y))))))))
(expect (answers (array 1 2)))
