(test 1)
(name "a-closure-answering-anything-does-not-fit-a-slot-answering-a-declared-struct-refuses")
(note "`f` declares it answers `Any`. A slot whose procedure type answers `App.Point` takes only a procedure answering one, and an answer of `Any` is none the build can see, so the build refuses.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (procedure entry
    (access public)
    (returns App.Point)
    (body
      (let f
        (closure
          (parameter a)
          (returns Any)
          (result a)))
      (let c (type (procedure (parameters Any) (returns App.Point))) f)
      (let r (apply c 1)))
    (result r)))
(expect (refuses build))
