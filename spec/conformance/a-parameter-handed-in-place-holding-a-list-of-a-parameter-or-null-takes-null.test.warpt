(test 1)
(name "a-parameter-handed-in-place-holding-a-list-of-a-parameter-or-null-takes-null")
(note "App.gen takes Array<some T>? in place and writes null into it. Null is one of the values a list of T or null holds, whatever filled T.")

(program
  (warp 1)
  (procedure App.gen
    (parameter x (type (inout (nullable (array (some T))))))
    (parameter y (type (some T)))
    (returns Int)
    (body
      (set x null)
      (return 0)))
  (procedure entry
    (access public)
    (returns (nullable (array String)))
    (body
      (var s (type (nullable (array String))) (array "a"))
      (let r (call App.gen s "b"))
      (return s))))
(expect (answers null))
