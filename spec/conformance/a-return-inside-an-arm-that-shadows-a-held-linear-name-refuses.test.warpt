warpt 1
{
  expect {
    refuses "build"
  }
  name "a-return-inside-an-arm-that-shadows-a-held-linear-name-refuses"
  note "The arm's `h` is a number of its own, and the outer `h` still holds the handle. The `return` leaves the procedure from inside the arm with the outer handle never handed on."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      "App.f" {
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
          {
            value {
              conditional {
                then [
                  {
                    let "h"
                    type "Int"
                    value 5
                  }
                  {
                    value {
                      return 1
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "Bool"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              true
            ]
            procedure "App.f"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

