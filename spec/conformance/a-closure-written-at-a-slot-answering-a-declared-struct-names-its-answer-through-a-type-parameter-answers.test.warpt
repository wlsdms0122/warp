warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-written-at-a-slot-answering-a-declared-struct-names-its-answer-through-a-type-parameter-answers"
  note "`c` is declared `() -> Bank.A`, so the closure written there, which writes no `returns`, answers `Bank.A`, and the struct literal `{ k: \"x\" }` it answers takes the name. `App.run` takes `() -> some T` and answers what calling it answers, so `v` reads as `Bank.A` and is one, and `App.P.show` reaches `Bank.A.show`."
  program {
    contracts {
      "App.P" {
        procedures {
          show {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type "() -> some T"
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type "() -> Bank.A"
            value {
              closure {
                result {
                  struct {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    types {
      "Bank.A" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Bank.A"
              }
            ]
            result "a"
            returns "String"
          }
        }
        satisfies [
          "App.P"
        ]
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

