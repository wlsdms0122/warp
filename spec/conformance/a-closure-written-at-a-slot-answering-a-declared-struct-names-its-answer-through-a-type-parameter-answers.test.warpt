warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-written-at-a-slot-answering-a-declared-struct-names-its-answer-through-a-type-parameter-answers"
  note "`c` is declared `{ procedure: { returns: Bank.A } }`, so the closure written there, which writes no `returns`, answers `Bank.A`, and the struct literal `{ k: \"x\" }` it answers takes the name. `App.run` takes `{ procedure: { returns: some T } }` and answers what calling it answers, so `v` reads as `Bank.A` and is one, and `App.P.show` reaches `Bank.A.show`."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  struct {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

