(test 1)
(name "a-generic-call-takes-no-nullable-variable-in-place-of-int-refuses")
(note "`Use.set` takes `inout some C.Item`, and App.IntBag gives Item as Int, so handing an `Int?` variable in place refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Bag)
    (struct App.IntBag
      (satisfies Lib.Bag)
      (field n Int)
      (type Item Int)
      (procedure first
        (access public)
        (parameter of (type App.IntBag))
        (returns Int)
        (body
          (return (path of (field n)))))
      (procedure take
        (access public)
        (parameter of (type App.IntBag))
        (parameter x (type Int))
        (returns Int)
        (body
          (return (call Int.plus x 1))))))
  (document
    (warp 1)
    (import Lib.Bag)
    (import Lib.Bag.take)
    (procedure Use.set
      (access public)
      (parameter c (type (some C Lib.Bag)))
      (parameter x (type (inout (some C.Item))))
      (returns Int)
      (body
        (return (call Lib.Bag.take c x))))))

(program
  (warp 1)
  (import App.IntBag)
  (import Use.set)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type App.IntBag) (struct (field n 1)))
      (var v (type (nullable Int)))
      (return (call Use.set b v)))))
(expect (refuses build))
