warpt 1
{
  expect {
    refuses "build"
  }
  name "a-map-keyed-by-a-type-parameter-no-bound-holds-refuses"
  note "A type parameter answers what its bounds name and nothing else, so a map keyed by one answers `Hashable` only where the signature writes `bounds: { K: Hashable }`. Without it the key answers nothing and the declaration refuses at the build."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "m"
            type "Dictionary<some K, Int>"
          }
        ]
        result 1
      }
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

