(test 1)
(name "a-map-keyed-by-a-type-parameter-no-bound-holds-refuses")
(note "A type parameter answers what its bounds name and nothing else, so a map keyed by one answers `Hashable` only where the signature writes `some K: Hashable`. Without it the key answers nothing and the declaration refuses at the build.")

(program
  (warp 1)
  (procedure App.f
    (parameter m (type (dictionary (some K) Int)))
    (returns Int)
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses build))
