(test 1)
(name "the-object-of-associated-types")
(note "An object writes the associated types a contract asks and their bounds, the type members a type is given, the associated types a signature says are a type, and an answer declared at an associated type: a type parameter labelled by it.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c)))))

(program
  (warp 1)
  (import Lib.Container)
  (import Lib.Container.first)
  (struct Use.Thing
    (satisfies Use.Sized)
    (field x Int)
    (type Item Int))
  (contract Use.Sized
    (type Item Hashable))
  (procedure Use.first
    (access public)
    (parameter c (type (some C Lib.Container)))
    (returns (some C.Item))
    (result (call Lib.Container.first c)))
  (procedure Use.plusOne
    (access public)
    (const)
    (isolated)
    (parameter c (type (some C Lib.Container)))
    (returns (some C.Item))
    (sameType C.Item Int)
    (result 1)))
(expect (builds (dictionary (entry "claims" (array (array "Use.Thing" (array "Use.Sized")))) (entry "constants" (array)) (entry "contracts" (array (array "Use.Sized" (array (array "Item") (array (array "Item" (array "Hashable"))) (array))))) (entry "dependencies" (array x"1dad53e333af6a7c93e1e2e9c7c85c471e9742ac9905ff9b26af701e89956174")) (entry "document" (array x"8cd700d5f3c08efa8ead0d7bb5ae6cd81981faceb536d8c108af8412001b1742")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "members" (array)) (entry "numbering" (array (array "Lib.Container.first") (array))) (entry "object" 1) (entry "rows" (array (array "Use.first" (array (array (array "c" (array (array 15 "C")) (array))) (array 19 "C" "Item") (array 1 (array)) 0 0 (array (array "C" (array "Lib.Container"))) (array)) 2 (array 0 (array (array) (array (array 12 (array "Lib.Container" "first" (array 1 (array 0 (array))) (array))))) (array 1 (array 0) (array) (array) (array "c")))) (array "Use.plusOne" (array (array (array "c" (array (array 15 "C")) (array))) (array 19 "C" "Item") (array 1 (array)) 1 1 (array (array "C" (array "Lib.Container"))) (array (array "C.Item" (array 4)))) 2 (array 0 (array (array) (array (array 0 (array 2 1)))) (array 1 (array 0) (array) (array) (array "c")))))) (entry "typeMembers" (array (array "Use.Thing" (array (array "Item" (array 4)))))) (entry "typeNumbering" (array)) (entry "types" (array (array "Use.Thing" (array 9 (array (array "x" (array 4))))))) (entry "variables" (array)))))
