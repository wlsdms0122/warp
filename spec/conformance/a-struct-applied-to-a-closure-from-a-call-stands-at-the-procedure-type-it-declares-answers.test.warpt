(test 1)
(name "a-struct-applied-to-a-closure-from-a-call-stands-at-the-procedure-type-it-declares-answers")
(note "A struct a call answers is read as applied to what its value reads as, and a closure reads as the procedure type its signature declares. So `App.wrap`'s box of a closure declaring `(Int) -> Int` stands where `App.Box<App.F>` is declared, `App.F` being that type.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (type App.F (procedure (parameters Int) (returns Int)))
  (procedure App.wrap
    (parameter x (type (some T)))
    (returns (named App.Box (some T)))
    (body
      (return (struct (field item x)))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b
        (type (named App.Box App.F))
        (call App.wrap
          (closure
            (parameter x (type Int))
            (returns Int)
            (body
              (return x)))))
      (return (apply (path b (field item)) 2)))))
(expect (answers 2))
