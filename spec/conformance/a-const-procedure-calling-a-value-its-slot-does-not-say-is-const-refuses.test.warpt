(test 1)
(name "a-const-procedure-calling-a-value-its-slot-does-not-say-is-const-refuses")
(note "A body calls a value without running only through a name a slot declared a `const` procedure type. `relaying`'s slot writes `() -> String` without `const`, which says nothing about whether what it holds runs, so `relaying`, declared `const`, refuses at the build, however `const` the closure handed to it says it is.")

(program
  (warp 1)
  (procedure asking
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body))
      (return answered)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let answering
        (closure
          (const)
          (returns String)
          (body
            (return "answered"))))
      (let given
        (closure
          (const)
          (returns String)
          (body
            (return (call relaying answering)))))
      (return (call asking given))))
  (procedure relaying
    (const)
    (parameter body (type (procedure (parameters) (returns String))))
    (returns String)
    (body
      (return (apply body)))))
(expect (refuses build))
