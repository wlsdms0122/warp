warpt 1
{
  expect {
    answers "took"
  }
  name "a-dictionary-of-a-membership-takes-a-record-whose-variable-field-is-of-it"
  note "App.f takes dictionary<App.Key> and is handed an App.Box, whose one field is var App.Key. The field's var says nothing about its value, which is a member of App.Key."
  program {
    constraints {
      "App.Key" [
        "Int"
        "String"
      ]
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "d"
            type "Dictionary<App.Key>"
          }
        ]
        result "took"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  record {
                    v 1
                  }
                }
                type "App.Box"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "App.Box" {
        record {
          v "var App.Key"
        }
      }
    }
    warp 1
  }
  test 1
}

