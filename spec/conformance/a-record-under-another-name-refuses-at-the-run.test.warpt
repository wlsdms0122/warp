warpt 1
{
  expect {
    refuses "run"
  }
  name "a-record-under-another-name-refuses-at-the-run"
  note "Through `any` the build cannot see the name, so the slot asks at the run: a `Vault` arriving where `Account` is declared refuses, whatever its structure."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "held"
            value {
              as "Vault"
              of {
                balance 1
              }
            }
          }
        ]
        result {
          call {
            arguments {
              account {
                ref "held"
              }
            }
            procedure "read"
          }
        }
        returns "Account"
      }
      read {
        parameters {
          account {
            type "any"
          }
        }
        result {
          as "Account"
          of {
            ref "account"
          }
        }
        returns "Account"
      }
    }
    types {
      Account {
        balance "int"
      }
      Vault {
        balance "int"
      }
    }
    warp 1
  }
  test 2
}

