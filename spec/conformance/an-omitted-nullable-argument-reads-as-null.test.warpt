warpt 1
{
  expect {
    answers null
  }
  name "an-omitted-nullable-argument-reads-as-null"
  note "`int?` is the declared type or null, and nothing else, so a call may leave the argument out and the body reads the null the caller left. Omission reads as null on a nullable parameter and nowhere else."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "limit"
            type "int?"
          }
        ]
        result {
          ref "limit"
        }
      }
    }
    warp 1
  }
  test 1
}

