warpt 1
{
  expect {
    refuses "build"
  }
  name "a-member-that-is-a-type-parameter-refuses"
  note "A member of a membership is a concrete type. A type parameter is filled by a call, and nothing fills one in a membership."
  program {
    constraints {
      Loose [
        "some T"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

