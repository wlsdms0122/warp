warpt 1
{
  expect {
    refuses "build"
  }
  name "sorting-the-unorderable-refuses"
  note "sorted is bounded by Comparable, the membership the shared std module declares. Booleans carry no ordering, and a literal is a reading the build can see, so the refusal lands before anything runs."
  program {
    imports [
      "std.collection.sorted"
    ]
    procedures {
      entry {
        result {
          call {
            of [
              true
              false
            ]
            procedure "std.collection.sorted"
          }
        }
      }
    }
    warp 1
  }
  test 2
}

