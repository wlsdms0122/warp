(test 1)
(name "sorting-the-unorderable-refuses")
(note "sorted is bounded by Comparable, the contract the shared Standard module declares. Booleans carry no ordering, and a literal is a reading the build can see, so the refusal lands before anything runs.")

(program
  (warp 1)
  (import Standard.Collection.sorted)
  (procedure entry
    (access public)
    (returns (array Bool))
    (body
      (return (call Standard.Collection.sorted (array true false))))))
(expect (refuses build))
