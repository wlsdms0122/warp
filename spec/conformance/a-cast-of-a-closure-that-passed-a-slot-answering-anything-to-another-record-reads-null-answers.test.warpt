warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-that-passed-a-slot-answering-anything-to-another-record-reads-null-answers"
  note "`c` is held at `procedure() -> Bank.A`, then at `procedure() -> any`, and travels through `any`. The closure keeps both answers, and a slot takes it only where its answer takes every one of them: `Bank.B` takes `any` but never a `Bank.A`, so the asking cast to `procedure() -> Bank.B` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "x"
            type {
              procedure {
                returns "any"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "a"
            type "any"
            value {
              ref "x"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    returns "Bank.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    types {
      "Bank.A" {
        record {
          k "string"
        }
      }
      "Bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

