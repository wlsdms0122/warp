warpt 1
{
  expect {
    answers "shown"
  }
  name "a-declaration-answering-a-contract-may-take-any-where-it-writes-a-contract"
  note "The contract hands App.Sized and the declaration answering it takes Any there, which takes whatever the contract hands."
  program {
    contracts {
      "App.Shown" {
        show {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "App.Sized"
            }
          ]
          returns "String"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  struct {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "Bank.Box" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Bank.Box"
              }
              {
                name "n"
              }
            ]
            result "shown"
            returns "String"
          }
        }
        satisfies [
          "App.Shown"
        ]
        struct {
          n "Int"
        }
      }
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result 4
            returns "Int"
          }
        }
        satisfies [
          "App.Sized"
        ]
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

