(test 1)
(name "nothing-runs-after-what-never-finishes")
(note "A statement after a call typed `Never` would never run, and the name it would bind would never bind. The leaves the text shows are held to this at the load; this one is held at the build, because only the build knows the signature.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Never)
    (failing aborted)
    (body
      (call Standard.Control.abort "done")
      (let after 1)
      (return after))))
(expect (refuses build))
