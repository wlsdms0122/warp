warpt 1
{
  expect {
    refuses "build"
  }
  name "nothing-runs-after-what-never-finishes"
  note "A statement after a call typed never would never run, and the name it would bind would never bind. The same rule the syntactic leaves get at the check, held at the build because only the build knows the signature."
  program {
    imports [
      "std.control.abort"
    ]
    procedures {
      entry {
        body [
          {
            value {
              call {
                of "done"
                procedure "std.control.abort"
              }
            }
          }
          {
            let "after"
            value 1
          }
        ]
        result {
          ref "after"
        }
      }
    }
    warp 1
  }
  test 2
}

