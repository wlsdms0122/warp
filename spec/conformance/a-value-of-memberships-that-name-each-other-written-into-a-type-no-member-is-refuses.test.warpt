warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-of-memberships-that-name-each-other-written-into-a-type-no-member-is-refuses"
  note "`app.M` admits `app.N` and `int`, and `app.N` admits `app.M` and `bool`, so a value of `app.M` is an int or a bool, each membership met again adding no member. A variable declared `string` starts with a name read as `app.M`, and neither member is a string, so the build refuses."
  program {
    constraints {
      "app.M" [
        "app.N"
        "int"
      ]
      "app.N" [
        "app.M"
        "bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "app.M"
            value 1
            var "x"
          }
          {
            type "string"
            value {
              ref "x"
            }
            var "y"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

