(test 1)
(name "a-taken-variable-is-handed-in-place-to-a-value-only-as-the-type-it-is-held-to")
(note "The same as handing it to a declaration: a variable held to Int that reads Int? after a join is handed in place to a value taking Int?, which refuses, since the value would write null into a box a closure reads as Int.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (var x 0)
      (var keep
        (type (procedure (parameters) (returns Int)))
        (closure
          (returns Int)
          (result 0)))
      (conditional
        (when true)
        (then
          (set keep
            (closure
              (returns Int)
              (result (call Standard.Numeric.plus x 1)))))
        (else
          (set x null)))
      (let clear
        (closure
          (parameter v (type (inout (nullable Int))))
          (body
            (set v null))))
      (apply clear x)
      (let r (apply keep)))
    (result r)))
(expect (refuses build))
