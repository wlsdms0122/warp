(test 1)
(name "a-struct-applied-to-a-type-its-bound-does-not-take-refuses")
(note "`App.Cache` bounds `K` by `Hashable`, and the type a mention applies it to at `K` conforms to that bound or the mention is refused. No document says `App.Plain` conforms to `Hashable`.")

(program
  (warp 1)
  (struct App.Cache
    (typeParameter K Hashable)
    (typeParameter V)
    (field table (dictionary (some K) (some V))))
  (struct App.Plain
    (field x Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let c (type (optional (named App.Cache App.Plain Int))) null)
      (return 1))))
(expect (refuses build))
