warpt 1
{
  expect {
    refuses "build"
  }
  name "an-asking-cast-onto-a-type-handed-on-once-refuses"
  note "A reading that may answer nothing does not take a value handed on once, since null would be a way through with nothing to hand on. `as?` onto such a type is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          item {
            type "any"
          }
        }
        result {
          "as?" "app.Handle"
          of {
            ref "item"
          }
        }
      }
    }
    types {
      "app.Handle" {
        linear {
          name "string"
        }
      }
    }
    warp 1
  }
  test 1
}

