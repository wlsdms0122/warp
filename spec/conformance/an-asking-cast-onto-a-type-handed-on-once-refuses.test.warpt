warpt 1
{
  expect {
    refuses "build"
  }
  name "an-asking-cast-onto-a-type-handed-on-once-refuses"
  note "A reading that may answer nothing does not take a linear value, since null would be a way through with nothing to hand on. `as?` onto such a type is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "any"
          }
        ]
        result {
          "as?" {
            of {
              ref "item"
            }
            type "app.Handle"
          }
        }
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

