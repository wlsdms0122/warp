(test 1)
(name "a-struct-the-language-declares-joined-with-and-refuses")
(note "`&` joins the names of contracts, and `Round` is a struct the language declares, which the load knows is no contract, so the composition refuses there.")

(program
  (warp 1)
  (contract App.Text)
  (procedure entry
    (access public)
    (parameter it (type (composition App.Text Round)))
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
