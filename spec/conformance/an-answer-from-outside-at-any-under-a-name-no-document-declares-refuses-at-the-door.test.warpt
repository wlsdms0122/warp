(test 1)
(name "an-answer-from-outside-at-any-under-a-name-no-document-declares-refuses-at-the-door")
(note "`App.v` is a procedure the host answers declaring it answers `Any`, and it answers a struct under `App.Z`, which no document declares. Its answer comes in through the door at `Any`, where a struct under a name that declares no struct refuses, so the run refuses there.")

(vocabulary
  (struct App.P
    (field a Int))
  (type App.Q App.P)
  (procedure App.v
    (isolated)
    (returns Any)
    (answers (struct App.Z (field a 1)))))

(program
  (warp 1)
  (import App.v)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let r (call App.v)))
    (result "ok")))
(expect (refuses run))
