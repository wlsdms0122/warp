(test 1)
(name "a-way-that-returns-from-an-attempt-is-not-met-after-it")
(note "Inside the attempt's body, the arm that sets `n` to a string and takes it there returns from the procedure with nothing that could fail after the taking, so it lands past the attempt and never reaches the write after it. What could fail runs only on the way that goes on, which took nothing, and a later write of an int stands.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (import Standard.Control.abort)
  (procedure check
    (parameter x (type Int))
    (returns Int)
    (failing aborted)
    (body
      (conditional
        (when (call Standard.Comparable.lessThan x 0))
        (then
          (call Standard.Control.abort "negative"))))
    (result x))
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (returns Int)
    (body
      (var n 0)
      (attempt
        (body
          (conditional
            (when ready)
            (then
              (set n "s")
              (let a
                (closure
                  (returns String)
                  (result n)))
              (return 0)))
          (call check n))
        (rescue null))
      (set n 5))
    (result n)))
(arguments (argument ready false))
(expect (answers 5))
