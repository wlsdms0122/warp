(test 1)
(name "a-rescue-reads-a-cast-to-a-procedure-type-by-its-spelling")
(note "`cast_refused`'s `expected` spells a cast to a procedure type the way a document writes it, signature and modifiers included.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns (nullable (dictionary String Any)))
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (as payload (procedure (const) (parameters Int) (returns Int))))
          (rescue
            (set tried (dictionary (entry "actual" (path caught (field details) (index "actual"))) (entry "expected" (path caught (field details) (index "expected")))))))))
    (result tried)))
(arguments (argument payload "not a procedure"))
(expect (answers (dictionary (entry "actual" "String") (entry "expected" "const (Int) -> Int"))))
