warpt 1
{
  expect {
    answers "a card"
  }
  name "a-contract-carries-a-procedure-into-a-generic-body"
  note "A contract is the procedures a value must answer. A document says which types answer it under `satisfies`, a signature bounds a type parameter by it, and the body calls the procedure without knowing which type it holds. The link finds the declaration behind each claimed procedure and the run reads one by the name the value wears."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        bounds {
          T "App.Describable"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "string"
      }
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
        ]
        result "an account"
        returns "string"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "Bank.Account" [
        "App.Describable"
      ]
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Account" {
        record {
          balance "int"
        }
      }
      "Bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

