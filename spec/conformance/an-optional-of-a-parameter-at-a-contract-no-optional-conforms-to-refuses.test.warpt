(test 1)
(name "an-optional-of-a-parameter-at-a-contract-no-optional-conforms-to-refuses")
(note "App.g takes m as the Optional of some T, T bounded by App.Num, and hands it to App.f, which takes App.Num. No document claims App.Num for an Optional.")

(program
  (warp 1)
  (contract App.Num)
  (extension
    (head Int)
    (satisfies App.Num))
  (procedure App.f
    (parameter n (type App.Num))
    (returns String)
    (body
      (return "took")))
  (procedure App.g
    (parameter m (type (optional (some T App.Num))))
    (returns String)
    (body
      (let s (call App.f m))
      (return s)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let s (call App.g 3))
      (return s))))
(expect (refuses build))
