(test 1)
(name "an-optional-at-a-contract-no-optional-conforms-to-refuses")
(note "App.f takes App.Sized and is handed a variable declared Bank.Card?. An Optional conforms to a contract where a claim about it says so. Bank.Card conforms to App.Sized, and no document claims it for an Optional, so the call refuses at the build.")

(program
  (warp 1)
  (struct Bank.Box
    (field n Int))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (body
        (return 4))))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure App.f
    (parameter n (type App.Sized))
    (returns String)
    (body
      (return "took")))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (type (optional Bank.Card)) (as (struct (field last "4")) Bank.Card))
      (let s (call App.f c))
      (return s))))
(expect (refuses build))
