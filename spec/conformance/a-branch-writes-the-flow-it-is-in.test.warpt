warpt 1
{
  arguments {
    take true
  }
  expect {
    answers "took-then"
  }
  name "a-branch-writes-the-flow-it-is-in"
  note "A branch answers nothing — the condition chooses a way through the body, and what an arm keeps it writes to an outer variable."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            var "chosen"
          }
          {
            branch {
              else [
                {
                  set "chosen"
                  value "took-else"
                }
              ]
              then [
                {
                  set "chosen"
                  value "took-then"
                }
              ]
              when {
                ref "take"
              }
            }
          }
        ]
        parameters {
          take "bool"
        }
        result {
          ref "chosen"
        }
      }
    }
    warp 1
  }
  test 1
}
