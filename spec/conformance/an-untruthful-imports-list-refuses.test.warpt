warpt 1
{
  expect {
    refuses "load"
  }
  name "an-untruthful-imports-list-refuses"
  note "The host reads the list to decide whether to run the program at all, so a list that disagrees with what the program uses refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              2
            ]
            procedure "Standard.Math.plus"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

