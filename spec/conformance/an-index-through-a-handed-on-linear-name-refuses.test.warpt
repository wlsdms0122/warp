warpt 1
{
  expect {
    refuses "build"
  }
  name "an-index-through-a-handed-on-linear-name-refuses"
  note "`h` handed its value to `App.close`, so `h.name` between the brackets reaches into a value `h` no longer holds."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
          {
            let "d"
            type "Dictionary<Int>"
            value {
              record {
                f 5
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
          {
            let "v"
            value {
              ref "d[h.name]"
            }
          }
        ]
        result {
          ref "v"
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

