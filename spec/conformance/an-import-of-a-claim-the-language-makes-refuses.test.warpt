(test 1)
(name "an-import-of-a-claim-the-language-makes-refuses")
(note "What the language claims is within every document's reach, the way a name the language declares is used without an import. An import of `Int: Hashable`, which the language claims, refuses at the load.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (result "card"))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))

(program
  (warp 1)
  (import App.Describable.describe)
  (import Int Hashable)
  (import T.Card)
  (import T.Card App.Describable)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let card (as (struct (field rank 1)) T.Card)))
    (result (call App.Describable.describe card))))
(expect (refuses load))
