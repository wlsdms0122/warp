warpt 1
{
  expect {
    refuses "load"
  }
  name "a-name-declared-as-both-a-constant-and-a-variable-refuses"
  note "A name is a constant or a variable, not both. One declared under `const` and under `var` is refused where the document is read."
  program {
    const {
      limit 1
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          ref "limit"
        }
        returns "Int"
      }
    }
    var {
      limit 1
    }
    warp 1
  }
  test 1
}

