(test 1)
(name "comparing-bytes-for-order-refuses")
(note "bytes = Array<Int>, and arrays do not order: numbers and strings conform to Comparable, not collections. A literal is a reading the build can judge, so the refusal lands before the run.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (return (call Standard.Comparable.lessThan x"01" x"02")))))
(expect (refuses build))
