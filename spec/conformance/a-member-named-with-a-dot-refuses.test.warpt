warpt 1
{
  expect {
    refuses "load"
  }
  name "a-member-named-with-a-dot-refuses"
  note "A call writes the type's name, a dot and the member's, so a member is named by one identifier."
  program {
    extensions {
      Int {
        procedures {
          "a.b" {
            parameters [
              {
                name "n"
                type "Int"
              }
            ]
            result 1
            returns "Int"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

