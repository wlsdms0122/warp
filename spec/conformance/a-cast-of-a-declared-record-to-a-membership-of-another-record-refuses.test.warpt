warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-declared-record-to-a-membership-of-another-record-refuses"
  note "`Bank.A` and `Bank.B` are both declared `{ k: string }`, and `App.M2` admits `Bank.B` and `Int`. `a` is read as `Bank.A`. A value settled into a membership keeps its name, so a `Bank.A` is a value of `App.M2` only if it is a `Bank.B` or a whole number, and it is neither. No value is both, so the cast `a as App.M2` refuses at the build, as it does where `a` is read as `Bank.A?`."
  program {
    constraints {
      "App.M2" [
        "Bank.B"
        "Int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "a"
            value {
              as {
                of {
                  record {
                    k "x"
                  }
                }
                type "Bank.A"
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "a"
                }
                type "App.M2"
              }
            }
          }
        ]
        result {
          ref "b"
        }
      }
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
      "Bank.B" {
        record {
          k "String"
        }
      }
      "Bank.BB" "Bank.B"
      "Bank.NA" "Bank.A?"
      "Bank.NB" "Bank.B?"
      "Bank.NBB" "Bank.NB"
    }
    warp 1
  }
  test 1
}

