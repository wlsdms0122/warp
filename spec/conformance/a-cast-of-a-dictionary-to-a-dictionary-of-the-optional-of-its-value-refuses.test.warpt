(test 1)
(name "a-cast-of-a-dictionary-to-a-dictionary-of-the-optional-of-its-value-refuses")
(note "`d` reads `Dictionary<String, Int>`, and `Dictionary<String, Int?>` takes that reading with each value as its some by promotion, so the cast says what a name declared `Dictionary<String, Int?>` says, and refuses at the build.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (let d (type (dictionary String Int)) (dictionary (entry "k" 1)))
      (return (as d (dictionary String (optional Int)))))))
(expect (refuses build))
