warpt 1
{
  expect {
    answers app.B {
      a "x"
    }
  }
  name "a-cast-of-a-membership-of-a-record-to-an-alias-of-another-nullable-record-answers"
  note "`app.A` and `app.B` are both declared `{ a: string }`, `app.NB` stands for `app.B?`, and `app.M` admits `app.A` and `int`. A nameless record written into `app.M` stays nameless, so a value read as `app.M` may be one `app.NB` takes. The cast `m as app.NB` builds, and the run settles the record under `app.B`."
  program {
    constraints {
      "app.M" [
        "app.A"
        "int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "m"
            type "app.M"
            value {
              record {
                a "x"
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "m"
                }
                type "app.NB"
              }
            }
          }
        ]
        result {
          ref "b"
        }
      }
    }
    types {
      "app.A" {
        record {
          a "string"
        }
      }
      "app.AA" "app.A"
      "app.B" {
        record {
          a "string"
        }
      }
      "app.NA" "app.A?"
      "app.NB" "app.B?"
    }
    warp 1
  }
  test 1
}

