warpt 1
{
  arguments {
    payload "not a whole number"
  }
  expect {
    answers null
  }
  name "the-asking-cast-reads-a-mismatch-as-null"
  note "`as?` is `as` with the mark `?.` carries: the author expects the value may not be the named type, so the mismatch reads as null instead of refusing, and the answer is `T?`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          payload {
            type "any"
          }
        }
        result {
          "as?" "int"
          of {
            ref "payload"
          }
        }
        returns "int?"
      }
    }
    warp 1
  }
  test 1
}

