(test 1)
(name "any-written-nullable-refuses")
(note "The `?` is written only where it says something new. `Any` already admits null, so `Any?` says nothing new and refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (nullable Any)))
    (result 1))
  (procedure entry
    (access public)
    (result 1)))
(expect (refuses load))
