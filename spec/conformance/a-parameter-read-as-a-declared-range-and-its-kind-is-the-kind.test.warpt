warpt 1
{
  expect {
    answers 300
  }
  name "a-parameter-read-as-a-declared-range-and-its-kind-is-the-kind"
  note "std.math.max reads its some N as std.byte, a declared range, and as int. The reading that holds both is int, whichever came first, so the answer 300 stands."
  program {
    imports [
      "std.byte"
      "std.math.max"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "std.byte"
            value 5
            var "b"
          }
          {
            value 300
            var "n"
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "n"
                  }
                ]
                procedure "std.math.max"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

