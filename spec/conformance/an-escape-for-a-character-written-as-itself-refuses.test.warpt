warpt 1
{
  expect {
    refuses "load"
  }
  name "an-escape-for-a-character-written-as-itself-refuses"
  note "A string escapes exactly the quote, the backslash and the control characters. `\\u0041` is a second text for the character `A`, which is written as itself, and one value has one text."
  test 5
  text "warpt 1\n\"\\u0041\"\n"
}

