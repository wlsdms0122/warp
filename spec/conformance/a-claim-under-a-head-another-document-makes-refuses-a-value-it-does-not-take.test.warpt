(test 1)
(name "a-claim-under-a-head-another-document-makes-refuses-a-value-it-does-not-take")
(note "The program imports the claim under `App.Box<some T: Hashable>` and hands a box of its own App.Plain, which answers no `Hashable`, so the head does not take it and the call refuses at the build.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (import App.Box)
    (import App.Describable)
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns String)
        (result "box")))))

(program
  (warp 1)
  (import App.Box)
  (import App.Box App.Describable)
  (import App.Describable.describe)
  (struct App.Plain
    (field x Int))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box App.Plain)) (struct (field item (struct (field x 1))))))
    (result (call App.Describable.describe b))))
(expect (refuses build))
