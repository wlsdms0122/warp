warpt 1
{
  expect {
    refuses "build"
  }
  name "calling-a-value-bounded-to-numbers-refuses"
  note "A type parameter bounded by `Standard.Numeric` stands for an `int` or a `double` at every call, and neither is a procedure. Calling a value of it refuses at the build, whatever a call fills it with."
  program {
    imports [
      "Standard.Numeric"
    ]
    procedures {
      "App.run" {
        bounds {
          N "Standard.Numeric"
        }
        parameters [
          {
            name "held"
            type "some N"
          }
        ]
        result {
          call {
            procedure {
              ref "held"
            }
          }
        }
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "App.run"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

