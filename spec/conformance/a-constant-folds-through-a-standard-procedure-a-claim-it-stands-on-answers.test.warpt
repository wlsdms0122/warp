(test 1)
(name "a-constant-folds-through-a-standard-procedure-a-claim-it-stands-on-answers")
(note "A constant settles at the build, and what it runs is asked of the claims within its document's reach, whoever declared what it runs. `Standard.Math.min` is held to `Standard.Comparable`, which the document declaring App.Score claims for it, and the program names App.Score, so the constant settles to the smaller score.")

(documents
  (document
    (warp 1)
    (import Standard.Comparable)
    (import Standard.Comparable.lessThan)
    (struct App.Score
      (satisfies Standard.Comparable)
      (field n Int)
      (procedure lessThan
        (const)
        (isolated)
        (parameter lhs (type App.Score))
        (parameter rhs (type App.Score))
        (returns Bool)
        (body
          (return (call Standard.Comparable.lessThan (path lhs (field n)) (path rhs (field n)))))))))

(program
  (warp 1)
  (import App.Score)
  (import Standard.Math.min)
  (const smaller (call Standard.Math.min (as (struct (field n 2)) App.Score) (as (struct (field n 1)) App.Score)))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (return (path smaller (field n))))))
(expect (answers 1))
