warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-handed-to-a-called-value-is-read-position-by-position-refuses"
  note "f takes Array<Dictionary<String, Array<String>>>, and a list of two map literals, one holding `[]` under `a` and one holding `[1]` is handed to it. A parameter of a called value holds what is written into it as a declared name does, so the build refuses the call."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            value {
              closure {
                body [
                  {
                    let "k"
                    value {
                      call {
                        arguments [
                          {
                            ref "xs"
                          }
                        ]
                        procedure "Standard.Collection.count"
                      }
                    }
                  }
                ]
                parameters [
                  {
                    name "xs"
                    type "Array<Dictionary<String, Array<String>>>"
                  }
                ]
                result {
                  ref "k"
                }
                returns "Int"
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  [
                    {
                      dictionary [
                        [
                          "a"
                          []
                        ]
                      ]
                    }
                    {
                      dictionary [
                        [
                          "a"
                          [
                            1
                          ]
                        ]
                      ]
                    }
                  ]
                ]
                procedure {
                  ref "f"
                }
              }
            }
          }
        ]
        failing "anything"
        result {
          ref "n"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

