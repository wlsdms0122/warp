(test 1)
(name "a-list-literal-handed-to-a-called-value-is-read-position-by-position-refuses")
(note "f takes Array<Dictionary<String, Array<String>>>, and a list of two map literals, one holding `[]` under `a` and one holding `[1]` is handed to it. A parameter of a called value holds what is written into it as a declared name does, so the build refuses the call.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let f
        (closure
          (parameter xs (type (array (dictionary String (array String)))))
          (returns Int)
          (body
            (let k (call Standard.Collection.count xs))
            (return k))))
      (let n (apply f (array (dictionary (entry "a" (array))) (dictionary (entry "a" (array 1))))))
      (return n))))
(expect (refuses build))
