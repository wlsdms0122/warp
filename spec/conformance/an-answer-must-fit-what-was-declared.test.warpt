warpt 1
{
  expect {
    refuses "link"
  }
  name "an-answer-must-fit-what-was-declared"
  note "A constant answer is a value and not only a shape, so it is held to what the declaration admits and not merely to what it reads as, the way a constant argument is."
  program {
    imports []
    procedures {
      entry {
        result "hello"
        returns "int"
      }
    }
    warp 1
  }
  test 1
}
