warpt 1
{
  expect {
    refuses "build"
  }
  name "an-answer-must-fit-what-was-declared"
  note "A constant answer is a value and not only a type. `300` reads `int`, which the range takes as a type, and the declaration still refuses it because the value is not one the range admits, the way a constant argument is refused."
  program {
    imports []
    procedures {
      entry {
        result 300
        returns "int(0...255)"
      }
    }
    warp 1
  }
  test 2
}
