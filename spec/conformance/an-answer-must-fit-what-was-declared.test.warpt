warpt 1
{
  expect {
    refuses "build"
  }
  name "an-answer-must-fit-what-was-declared"
  note "An answer is held to the type the declaration writes: the text it answers is no `Int`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result "three hundred"
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

