(test 1)
(name "a-cast-to-a-contract-of-a-reading-of-an-optional-of-any-holding-a-some-reads-the-type-the-value-is-an-instance-of")
(note "`a` is read as `Any?` and holds `5`, its some. A cast to `App.Described` of a reading of an Optional of `Any` whose value is its some holds the type the value is an instance of, `Int`, so the call through the contract reaches `Int`'s `describe`.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a number"))))
  (extension
    (head (optional Int))
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (optional Int)))
      (returns String)
      (body
        (return "a number or none"))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let a (type (optional Any)) 5)
      (return (call App.Described.describe (as a App.Described))))))
(expect (answers "a number"))
