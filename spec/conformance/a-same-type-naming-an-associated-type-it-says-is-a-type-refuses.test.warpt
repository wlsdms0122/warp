warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "load"
  }
  name "a-same-type-naming-an-associated-type-it-says-is-a-type-refuses"
  note "`sameTypes` says `C.Item` is `some D.Item` and `D.Item` is Int. A same type says what an associated type is in one step, so this refuses at the load."
  program {
    imports [
      "Lib.Container"
    ]
    procedures {
      "Use.it" {
        parameters [
          {
            name "c"
            type "some C: Lib.Container"
          }
          {
            name "d"
            type "some D: Lib.Container"
          }
        ]
        result 1
        returns "Int"
        sameTypes {
          "C.Item" "some D.Item"
          "D.Item" "Int"
        }
      }
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

