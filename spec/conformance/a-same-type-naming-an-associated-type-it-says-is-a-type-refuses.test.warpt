(test 1)
(name "a-same-type-naming-an-associated-type-it-says-is-a-type-refuses")
(note "`sameTypes` says `C.Item` is `some D.Item` and `D.Item` is Int. A same type says what an associated type is in one step, so this refuses at the load.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c))))))

(program
  (warp 1)
  (import Lib.Container)
  (procedure Use.it
    (parameter c (type (some C Lib.Container)))
    (parameter d (type (some D Lib.Container)))
    (returns Int)
    (sameType C.Item (some D.Item))
    (sameType D.Item Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
