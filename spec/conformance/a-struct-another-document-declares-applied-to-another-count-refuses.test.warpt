(test 1)
(name "a-struct-another-document-declares-applied-to-another-count-refuses")
(note "How many types a struct takes is its declaration's, read where the name resolves, so a mention in another document applying `App.Box` to two is refused at the build.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (procedure App.wrap
      (parameter x (type (some T)))
      (returns (named App.Box (some T)))
      (body
        (return (struct (field item x)))))))

(program
  (warp 1)
  (import App.Box)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (nullable (named App.Box Int Int))) null)
      (return 1))))
(expect (refuses build))
