warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-of-other-kinds-written-into-a-membership-refuses"
  note "A variable declared `App.M`, the membership of `array<int>` and `bool`, starts with `[1, \"s\"]`. A membership takes a literal one of its members takes part by part, and `array<int>` refuses the string, so the build refuses."
  program {
    constraints {
      "App.M" [
        "array<int>"
        "bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "App.M"
            value [
              1
              "s"
            ]
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

