warpt 1
{
  documents [
    {
      contracts {
        "App.Joinable" {
          join {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "other"
                type "Self"
              }
            ]
            returns "Self"
          }
        }
      }
      imports []
      procedures {
        "App.nothing" {
          returns "Null"
        }
      }
      warp 1
    }
    {
      extensions {
        Int {
          procedures {
            join {
              parameters [
                {
                  name "of"
                  type "Int"
                }
                {
                  name "other"
                  type "Int"
                }
              ]
              result {
                ref "of"
              }
              returns "Int"
            }
          }
          satisfies [
            "App.Joinable"
          ]
        }
      }
      imports [
        "App.Joinable"
      ]
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-constant-settling-through-a-claim-of-a-document-it-does-not-stand-on-refuses"
  note "A constant settles at the build, against what its document stands on. The claim that `Int` answers `App.Joinable`, and `Int.join` behind it, stand in a document the program never names, so the claim is not within its reach, however the host handed the documents over, and the constant refuses."
  program {
    const {
      joined {
        call {
          arguments [
            1
            2
          ]
          procedure "App.Joinable.join"
        }
      }
    }
    imports [
      "App.Joinable.join"
    ]
    procedures {
      entry {
        access "public"
        result {
          ref "joined"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

