warpt 1
{
  arguments {
    it null
  }
  expect {
    refuses "run"
  }
  name "a-receiver-is-held-to-its-parameter-at-the-run"
  note "The receiver is the parameter a call fills by writing a value in front, so it is held to that parameter the way every argument is. `uppercased` declares `of: string`; a null that arrives there through `any` is not a string, and the run says so instead of reading it as nothing."
  program {
    imports [
      "std.text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        parameters {
          it {
            type "any"
          }
        }
        result {
          call {
            of {
              ref "it"
            }
            procedure "std.text.uppercased"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

