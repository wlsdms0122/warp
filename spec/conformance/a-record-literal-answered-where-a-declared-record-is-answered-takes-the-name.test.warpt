warpt 1
{
  expect {
    answers Bank.Account {
      balance 1
    }
  }
  name "a-record-literal-answered-where-a-declared-record-is-answered-takes-the-name"
  note "A declared record is nominal. A record literal written where the type is read, here the answer of a declaration writing `returns Bank.Account`, is judged field by field and takes the name; the answer is written with it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          record {
            balance 1
          }
        }
        returns "Bank.Account"
      }
    }
    types {
      "Bank.Account" {
        record {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

