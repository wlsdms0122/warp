warpt 1
{
  expect {
    answers [
      false
      true
      9007199254740993
    ]
  }
  name "a-whole-and-a-fraction-meet-exactly"
  note "Numbers compare by what they are worth at every size. 2^53 + 1 rounds to 2^53 in binary64, and neither equality, ordering, nor the picking procedures follow the rounding."
  program {
    imports [
      "Standard.Logic.equal"
      "Standard.Math.greaterThan"
      "Standard.Math.max"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "same"
            value {
              call {
                arguments [
                  9007199254740993
                  9007199254740992.0
                ]
                procedure "Standard.Logic.equal"
              }
            }
          }
          {
            let "over"
            value {
              call {
                arguments [
                  9007199254740993
                  9007199254740992.0
                ]
                procedure "Standard.Math.greaterThan"
              }
            }
          }
          {
            let "kept"
            value {
              call {
                arguments [
                  9007199254740993
                  9007199254740992.0
                ]
                procedure "Standard.Math.max"
              }
            }
          }
        ]
        result [
          {
            ref "same"
          }
          {
            ref "over"
          }
          {
            ref "kept"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

