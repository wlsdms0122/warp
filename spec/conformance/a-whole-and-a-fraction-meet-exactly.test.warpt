(test 1)
(name "a-whole-and-a-fraction-meet-exactly")
(note "Equality reads numbers by what they are worth, at every size. 2^53 + 1 rounds to 2^53 in binary64, and equality does not follow the rounding: the whole number 2^53 + 1 is not the fraction 2^53, and 2^53 is.")

(program
  (warp 1)
  (import Standard.Logic.equal)
  (procedure entry
    (access public)
    (returns (array Bool))
    (result (array (call Standard.Logic.equal 9007199254740993 9007199254740992.0) (call Standard.Logic.equal 9007199254740992 9007199254740992.0)))))
(expect (answers (array false true)))
