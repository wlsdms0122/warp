warpt 1
{
  expect {
    answers [
      false
      true
    ]
  }
  name "a-whole-and-a-fraction-meet-exactly"
  note "Equality reads numbers by what they are worth, at every size. 2^53 + 1 rounds to 2^53 in binary64, and equality does not follow the rounding: the whole number 2^53 + 1 is not the fraction 2^53, and 2^53 is."
  program {
    imports [
      "Standard.Logic.equal"
    ]
    procedures {
      entry {
        access "public"
        result [
          {
            call {
              arguments [
                9007199254740993
                9007199254740992.0
              ]
              procedure "Standard.Logic.equal"
            }
          }
          {
            call {
              arguments [
                9007199254740992
                9007199254740992.0
              ]
              procedure "Standard.Logic.equal"
            }
          }
        ]
        returns "Array<Bool>"
      }
    }
    warp 1
  }
  test 1
}

