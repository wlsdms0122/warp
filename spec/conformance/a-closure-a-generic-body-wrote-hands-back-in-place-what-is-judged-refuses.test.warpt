warpt 1
{
  expect {
    refuses "run"
  }
  name "a-closure-a-generic-body-wrote-hands-back-in-place-what-is-judged-refuses"
  note "App.mk answers a closure appending its x to a list it takes in place as array of its own some T. Read through any as taking a list of text and handed one, the closure writes 5 into it, and the call of the value judges the list once it is over, so the 5 refuses at the run."
  program {
    imports [
      "Standard.Collection.append"
    ]
    procedures {
      "App.mk" {
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          closure {
            body [
              {
                value {
                  call {
                    arguments [
                      {
                        ref "xs"
                      }
                      {
                        ref "x"
                      }
                    ]
                    procedure "Standard.Collection.append"
                  }
                }
              }
            ]
            parameters [
              {
                name "xs"
                type "inout array<some T>"
              }
            ]
            result 0
            returns "int"
          }
        }
        returns {
          procedure {
            parameters [
              "inout array<some T>"
            ]
            returns "int"
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "a"
            type "any"
            value {
              call {
                arguments [
                  5
                ]
                procedure "App.mk"
              }
            }
          }
          {
            let "f"
            value {
              as {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      "inout array<string>"
                    ]
                    returns "int"
                  }
                }
              }
            }
          }
          {
            value [
              "a"
            ]
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                ]
                procedure {
                  ref "f"
                }
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

