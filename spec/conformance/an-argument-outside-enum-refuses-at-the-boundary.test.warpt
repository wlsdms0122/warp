warpt 1
{
  arguments {
    mode "medium"
  }
  expect {
    refuses "run"
  }
  name "an-argument-outside-enum-refuses-at-the-boundary"
  note "For an argument only the run can see, `enum` is judged where the value meets the parameter. At the boundary, before the body sees it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            enum [
              "fast"
              "slow"
            ]
            name "mode"
            type "String"
          }
        ]
        result {
          ref "mode"
        }
      }
    }
    warp 1
  }
  test 1
}

