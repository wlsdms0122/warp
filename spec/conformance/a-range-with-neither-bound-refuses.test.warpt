warpt 1
{
  expect {
    refuses "load"
  }
  name "a-range-with-neither-bound-refuses"
  note "Either bound may be left out, and not both: `int(...)` says nothing a bare `int` does not, and is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "int(...)"
          }
        ]
        result 1
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

