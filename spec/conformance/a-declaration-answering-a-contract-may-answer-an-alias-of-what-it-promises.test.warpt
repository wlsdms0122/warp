warpt 1
{
  expect {
    answers "a card"
  }
  name "a-declaration-answering-a-contract-may-answer-an-alias-of-what-it-promises"
  note "The contract answers App.Describable and the declaration answering it answers App.D, which names App.Describable."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
      "App.Maker" {
        make {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "App.Describable"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      "Bank.Card.make" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result {
          ref "of"
        }
        returns "App.D"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "1"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "m"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Maker.make"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "m"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
        "App.Maker"
      ]
    }
    types {
      "App.D" "App.Describable"
      "Bank.Card" {
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

