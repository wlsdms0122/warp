warpt 1
{
  expect {
    answers "a card"
  }
  name "a-declaration-answering-a-contract-may-answer-an-alias-of-what-it-promises"
  note "The contract answers App.Describable and the declaration answering it answers App.D, which names App.Describable."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
      "App.Maker" {
        make {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "App.Describable"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "1"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "m"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Maker.make"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "m"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
      }
    }
    types {
      "App.D" "App.Describable"
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
          make {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result {
              ref "of"
            }
            returns "App.D"
          }
        }
        satisfies [
          "App.Describable"
          "App.Maker"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

