(test 1)
(name "an-isolated-closure-writes-its-own-variables")
(note "Writing a variable the closure itself declared touches nothing outside it, so the closure declaring `isolated` holds to it and runs beside the others.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (import Standard.Numeric.times)
  (procedure entry
    (access public)
    (isolated)
    (returns (array Int))
    (failing concurrent_failed)
    (result
      (call Standard.Concurrent.map
        (array 1 2)
        (closure
          (const)
          (isolated)
          (parameter item (type Int))
          (parameter index (type Int))
          (returns Int)
          (body
            (var held item)
            (set held (call Standard.Numeric.times held 2)))
          (result held))))))
(expect (answers (array 2 4)))
