warpt 1
{
  expect {
    answers [
      2
      4
    ]
  }
  name "an-isolated-closure-writes-its-own-variables"
  note "Writing a variable the closure itself declared touches nothing outside it, so the closure declaring `isolated` holds to it and runs beside the others."
  program {
    imports [
      "Standard.Concurrent.map"
      "Standard.Numeric.times"
    ]
    procedures {
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      value {
                        ref "item"
                      }
                      var "held"
                    }
                    {
                      set "held"
                      value {
                        call {
                          arguments [
                            {
                              ref "held"
                            }
                            2
                          ]
                          procedure "Standard.Numeric.times"
                        }
                      }
                    }
                  ]
                  const true
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    ref "held"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

