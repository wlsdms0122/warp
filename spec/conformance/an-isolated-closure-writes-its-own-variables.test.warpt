warpt 1
{
  expect {
    answers [
      2
      4
    ]
  }
  name "an-isolated-closure-writes-its-own-variables"
  note "Writing a variable the closure itself declared touches nothing outside it, so the closure is isolated and runs beside the others."
  program {
    imports [
      "Standard.Concurrent.map"
      "Standard.Math.times"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      value {
                        ref "item"
                      }
                      var "held"
                    }
                    {
                      set "held"
                      value {
                        call {
                          arguments [
                            {
                              ref "held"
                            }
                            2
                          ]
                          procedure "Standard.Math.times"
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "item"
                      type "int"
                    }
                    {
                      name "index"
                      type "int"
                    }
                  ]
                  result {
                    ref "held"
                  }
                  returns "int"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

