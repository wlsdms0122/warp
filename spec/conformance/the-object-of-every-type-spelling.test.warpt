(test 1)
(name "the-object-of-every-type-spelling")
(note "Every type spelling a document writes lowers under the tag the page gives it: the scalars with `Null` and `Never`, a dictionary, the marks var and inout, the nullable, a procedure type with the types it takes and answers, what it may fail with and its claims, and a type parameter.")

(program
  (warp 1)
  (struct App.Kinds
    (field f Procedure)
    (field flag (var Bool))
    (field g (procedure (const) (isolated) (parameters String Int) (failing aborted) (returns Int)))
    (field maybe (nullable Int))
    (field none Null)
    (field stop (procedure (parameters) (failing (anything)) (returns Never)))
    (field table (dictionary String String)))
  (procedure App.read
    (const)
    (isolated)
    (parameter p (type (some T)))
    (returns (some T))
    (result p))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter io (type (inout Int)))
    (parameter k (type App.Kinds))
    (returns App.Kinds)
    (result k)))
(expect (builds (dictionary (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"7d5ed1c60229190b01936f14d2bb38aab4d70873abfb7f04f3d67b86225d7f37")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "rows" (array (array "App.read" (array (array (array "p" (array (array 15 "T")) (array))) (array 15 "T") (array 1 (array)) 1 1 (array) (array)) 1 (array 0 (array (array) (array (array 1 (array 0 (array))))) (array 1 (array 0) (array) (array) (array "p")))) (array "entry" (array (array (array "io" (array (array 12 (array 4))) (array)) (array "k" (array (array 14 "App.Kinds")) (array))) (array 14 "App.Kinds") (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array (array 1 (array 1 (array))))) (array 2 (array 0 1) (array) (array) (array "io" "k")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "types" (array (array "App.Kinds" (array 9 (array (array "f" (array 10 (array) 0 0)) (array "flag" (array 11 (array 3))) (array "g" (array 10 (array (array (array (array 6) (array 4)) (array 4) (array 1 (array "aborted")))) 1 1)) (array "maybe" (array 13 (array 4))) (array "none" (array 2)) (array "stop" (array 10 (array (array (array) (array 1) (array 0))) 0 0)) (array "table" (array 8 (array 6) (array 6)))))))) (entry "variables" (array)))))
