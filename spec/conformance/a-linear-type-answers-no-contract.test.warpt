warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-type-answers-no-contract"
  note "A contract standing where a type is written holds a value under no name of its own, and nothing follows a linear value but the name that holds it. The claim is refused where it is written."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.Handle.describe" {
        parameters [
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
        result "a handle"
        returns "String"
      }
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    satisfies {
      "App.Handle" [
        "App.Describable"
      ]
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

