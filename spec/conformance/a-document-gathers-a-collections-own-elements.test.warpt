warpt 1
{
  expect {
    answers [
      x"6968"
      [
        "c"
        "a"
      ]
    ]
  }
  name "a-document-gathers-a-collections-own-elements"
  note "gathering says which elements by position, so the answer is the collection's own, spelled the way the collection is: bytes gathered are bytes. This is what lets a document write the procedures that answer fewer elements or another order, since an array a body started empty has no spelling to keep."
  program {
    imports [
      "std.collection.gathering"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "back"
            value {
              call {
                arguments [
                  x"6869"
                  [
                    1
                    0
                  ]
                ]
                procedure "std.collection.gathering"
              }
            }
          }
          {
            let "picked"
            value {
              call {
                arguments [
                  [
                    "a"
                    "b"
                    "c"
                  ]
                  [
                    2
                    0
                  ]
                ]
                procedure "std.collection.gathering"
              }
            }
          }
        ]
        result [
          {
            ref "back"
          }
          {
            ref "picked"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

