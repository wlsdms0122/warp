warpt 1
{
  expect {
    answers 2
  }
  name "a-slot-naming-a-const-procedure-type-is-a-const-slot"
  note "A slot says a procedure it holds answers without running by writing a `const` procedure type, and a slot naming a declared type that stands for one says the same: a name is what it names. A body calling what that slot holds still answers without running, so an operand may call it."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      asking {
        body [
          {
            let "a"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "body"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type "App.Pick"
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      closure {
                        parameters [
                          {
                            name "x"
                            type "Int"
                          }
                        ]
                        result {
                          ref "x"
                        }
                        returns "Int"
                      }
                    }
                  ]
                  procedure "asking"
                }
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
    }
    types {
      "App.Pick" {
        "const procedure" {
          parameters [
            "Int"
          ]
          returns "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

