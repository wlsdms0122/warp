warpt 1
{
  expect {
    answers "a card"
  }
  name "a-parameter-read-as-a-contract-and-as-memberships-that-name-each-other-answers"
  note "`app.M` admits `app.N` and `bank.Card`, and `app.N` admits `app.M` and `bank.Card2`; both cards answer `app.Describable`. `app.pick` reads `T` as `app.Describable` and as `app.M`, so every member of `app.M` has to answer the contract. `app.N` met again on the way adds no member, the members left all answer, so it builds, and `describe` answers \"a card\"."
  program {
    constraints {
      "app.M" [
        "app.N"
        "bank.Card"
      ]
      "app.N" [
        "app.M"
        "bank.Card2"
      ]
    }
    contracts {
      "app.Describable" {
        describe {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.pick" {
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result {
          ref "b"
        }
        returns "some T"
      }
      "bank.Card.describe" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      "bank.Card2.describe" {
        parameters [
          {
            name "of"
            type "bank.Card2"
          }
        ]
        result "a second card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "app.Describable"
            value {
              as {
                of {
                  record {
                    last "1"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "m"
            type "app.M"
            value {
              as {
                of {
                  record {
                    last "2"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                  {
                    ref "m"
                  }
                ]
                procedure "app.pick"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "app.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "bank.Card" [
        "app.Describable"
      ]
      "bank.Card2" [
        "app.Describable"
      ]
    }
    types {
      "bank.Card" {
        record {
          last "string"
        }
      }
      "bank.Card2" {
        record {
          first "string"
        }
      }
    }
    warp 1
  }
  test 1
}

