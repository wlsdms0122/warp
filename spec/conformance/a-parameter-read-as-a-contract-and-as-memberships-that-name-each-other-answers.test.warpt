warpt 1
{
  expect {
    answers "a card"
  }
  name "a-parameter-read-as-a-contract-and-as-memberships-that-name-each-other-answers"
  note "`App.M` admits `App.N` and `Bank.Card`, and `App.N` admits `App.M` and `Bank.Card2`; both cards answer `App.Describable`. `App.pick` reads `T` as `App.Describable` and as `App.M`, so every member of `App.M` has to answer the contract. `App.N` met again on the way adds no member, the members left all answer, so it builds, and `describe` answers \"a card\"."
  program {
    constraints {
      "App.M" [
        "App.N"
        "Bank.Card"
      ]
      "App.N" [
        "App.M"
        "Bank.Card2"
      ]
    }
    contracts {
      "App.Describable" {
        describe {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.pick" {
        parameters [
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result {
          ref "b"
        }
        returns "some T"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      "Bank.Card2.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card2"
          }
        ]
        result "a second card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "App.Describable"
            value {
              as {
                of {
                  record {
                    last "1"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "m"
            type "App.M"
            value {
              as {
                of {
                  record {
                    last "2"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                  {
                    ref "m"
                  }
                ]
                procedure "App.pick"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
      "Bank.Card2" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "string"
        }
      }
      "Bank.Card2" {
        record {
          first "string"
        }
      }
    }
    warp 1
  }
  test 1
}

