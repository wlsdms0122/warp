(test 1)
(name "an-asking-cast-to-null-reads-a-match-as-its-some")
(note "`as? Null` reads `Null?`, so `null`, which is a `Null`, is a match, and a match is its some, `Some` holding `null`.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter a)
    (returns Any)
    (body
      (return (as? a Null)))))
(arguments (argument a null))
(expect (answers (struct Some (field wrapped null))))
