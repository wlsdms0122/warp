warpt 1
{
  expect {
    refuses "build"
  }
  name "count-of-a-declared-record-no-claim-names-refuses"
  note "A declared record is an instance of its own name, not of `Dictionary`, and `Standard.Collection` is claimed for no declared record here, so count handed one is refused at the build."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    record {
                      balance 1
                      owner "a"
                    }
                  }
                  type "Account"
                }
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    types {
      Account {
        record {
          balance "Int"
          owner "String"
        }
      }
    }
    warp 1
  }
  test 1
}

