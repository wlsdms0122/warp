(test 1)
(name "a-type-no-claim-names-refuses")
(note "A value of a type the language names answers a contract only where a document claims it for that type. A claim about `Int` says nothing about `String`, so handing text where the contract is asked is refused at the build, which reads the type the text is.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a whole number"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call App.Described.describe "s")))))
(expect (refuses build))
