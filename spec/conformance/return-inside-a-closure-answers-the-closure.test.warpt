warpt 1
{
  expect {
    answers "inner-and-on"
  }
  name "return-inside-a-closure-answers-the-closure"
  note "Leaving does not cross a closure's edge: `return` inside one answers the closure, and the flow that invoked it goes on."
  program {
    imports [
      "std.text.joined"
    ]
    procedures {
      entry {
        body [
          {
            let "shout"
            value {
              closure {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              return "inner"
                            }
                          }
                        ]
                        when true
                      }
                    }
                  }
                ]
                result "outer"
                returns "string"
              }
            }
          }
          {
            let "got"
            value {
              apply {
                procedure {
                  ref "shout"
                }
              }
            }
          }
          {
            let "after"
            value {
              call {
                of [
                  {
                    ref "got"
                  }
                  "-and-on"
                ]
                procedure "std.text.joined"
              }
            }
          }
        ]
        result {
          ref "after"
        }
      }
    }
    warp 1
  }
  test 1
}
