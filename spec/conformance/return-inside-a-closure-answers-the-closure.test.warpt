warpt 1
{
  expect {
    answers "inner-and-on"
  }
  name "return-inside-a-closure-answers-the-closure"
  note "Leaving does not cross a closure's edge: `return` inside one answers the closure, and the flow that invoked it goes on."
  program {
    imports [
      "Standard.Text.joined"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "shout"
            value {
              closure {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              return "inner"
                            }
                          }
                        ]
                        when true
                      }
                    }
                  }
                ]
                result "outer"
                returns "String"
              }
            }
          }
          {
            let "got"
            value {
              call {
                procedure {
                  ref "shout"
                }
              }
            }
          }
          {
            let "after"
            value {
              call {
                arguments [
                  [
                    {
                      ref "got"
                    }
                    "-and-on"
                  ]
                  ""
                ]
                procedure "Standard.Text.joined"
              }
            }
          }
        ]
        failing "anything"
        result {
          ref "after"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

