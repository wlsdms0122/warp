(test 1)
(name "return-inside-a-closure-answers-the-closure")
(note "Leaving does not cross a closure's edge: `return` inside one answers the closure, and the flow that invoked it goes on.")

(program
  (warp 1)
  (import Standard.Text.joined)
  (procedure entry
    (access public)
    (returns String)
    (failing (anything))
    (body
      (let shout
        (closure
          (returns String)
          (body
            (conditional
              (when true)
              (then
                (return "inner")))
            (return "outer"))))
      (let got (apply shout))
      (let after (call Standard.Text.joined (array got "-and-on") ""))
      (return after))))
(expect (answers "inner-and-on"))
