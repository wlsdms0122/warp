warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-membership-of-a-recursive-record-to-another-one-further-down-answers"
  note "`app.T` declares `{ n: app.T? }` and `app.U` declares `{ n: app.U? }`, and `app.M` admits `app.T` and `int`. A nameless record written into `app.M` stays nameless however deep it goes, so a value read as `app.M` may be one whose second `n` `app.U` takes. The cast builds, and the run settles that record under `app.U`."
  program {
    constraints {
      "app.M" [
        "app.T"
        "int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "m"
            type "app.M"
            value {
              record {
                n {
                  record {
                    n {
                      record {
                        n null
                      }
                    }
                  }
                }
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "m"
                }
                type {
                  record {
                    n {
                      record {
                        n "app.U"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          ref "b.n.n.n"
        }
      }
    }
    types {
      "app.T" {
        record {
          n "app.T?"
        }
      }
      "app.U" {
        record {
          n "app.U?"
        }
      }
    }
    warp 1
  }
  test 1
}

