warpt 1
{
  expect {
    answers [
      1
      3
    ]
  }
  name "a-path-handed-in-place-is-written-through"
  note "A path into a variable is handed in place too. The callee holds the caller's box through that path, and each write lands there as it is made."
  program {
    imports [
      "Standard.Math.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments [
                  {
                    ref "count"
                  }
                  1
                ]
                procedure "Standard.Math.plus"
              }
            }
          }
        ]
        parameters [
          {
            name "count"
            type "inout int"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            value [
              1
              2
            ]
            var "xs"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "xs[1]"
                  }
                ]
                procedure "bump"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

