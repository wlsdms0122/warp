warpt 1
{
  expect {
    answers [
      1
      3
    ]
  }
  name "a-path-handed-in-place-is-written-through"
  note "A path into a variable is handed in place too. The callee holds the caller's box through that path, and each write lands there as it is made."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments {
                  value 1
                }
                of {
                  ref "count"
                }
                procedure "std.math.plus"
              }
            }
          }
        ]
        parameters {
          count {
            type "inout int"
          }
        }
      }
      entry {
        body [
          {
            value [
              1
              2
            ]
            var "xs"
          }
          {
            value {
              call {
                arguments {
                  count {
                    ref "xs[1]"
                  }
                }
                procedure "bump"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 2
}

