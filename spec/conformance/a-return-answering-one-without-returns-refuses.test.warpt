warpt 1
{
  expect {
    refuses "build"
  }
  name "a-return-answering-one-without-returns-refuses"
  note "A `return` that carries a value is a way out of the body the way its result is, so a body whose `return` answers a value written `linear` writes `returns` too. Here every way out of `make` is such a `return`, and `entry` hands what it gets to `app.close`, so the missing `returns` is the one thing wrong."
  program {
    imports [
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                procedure "make"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "held"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
      }
      make {
        body [
          {
            value {
              conditional {
                else [
                  {
                    value {
                      return {
                        call {
                          procedure "app.open"
                        }
                      }
                    }
                  }
                ]
                then [
                  {
                    value {
                      return {
                        call {
                          procedure "app.open"
                        }
                      }
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

