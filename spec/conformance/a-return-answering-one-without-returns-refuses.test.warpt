warpt 1
{
  expect {
    refuses "build"
  }
  name "a-return-answering-one-without-returns-refuses"
  note "A `return` that carries a value is a way out of the body the way its result is, so a body that returns a value written `linear` writes `returns` too."
  program {
    imports [
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                procedure "make"
              }
            }
          }
        ]
      }
      make {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return {
                        call {
                          procedure "app.open"
                        }
                      }
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

