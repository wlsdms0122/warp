(test 1)
(name "a-result-written-as-null-refuses")
(note "A result of null reads as no result, so writing `result null` is a second spelling of a procedure that writes none. A document says each thing one way, and this one is refused where it is read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (result null)))
(expect (refuses load))
