(test 1)
(name "the-object-of-a-declared-type-and-a-contract")
(note "Declared types and contracts stand as the document wrote them. A body standing on a declared type, here by a cast to it, numbers it under typeNumbering, a slot declaring a type parameter writes it with its bounds, and a name that holds a value of a contract lowers to a composition of the contract's name.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (contract App.Number)
  (extension
    (head Double)
    (satisfies App.Number))
  (extension
    (head Int)
    (satisfies App.Number))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter p)
    (parameter v (type (some T App.Number)))
    (returns (some T))
    (failing cast_refused)
    (body
      (let kept (as p App.Point))
      (let number (type App.Number) v)
      (return v))))
