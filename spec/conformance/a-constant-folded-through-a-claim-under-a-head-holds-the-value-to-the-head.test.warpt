(test 1)
(name "a-constant-folded-through-a-claim-under-a-head-holds-the-value-to-the-head")
(note "A constant folds through App.Describable, whose procedure is const, with a box holding `1` read as `App.Box<Int?>`. The fold holds the value it ran on to the head the claim was written under, which takes it, so the link gives what the run would.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (contract App.Describable
      (procedure describe
        (const)
        (parameter of (type Self))
        (returns String)))
    (extension
      (head (named App.Box (optional Int)))
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (const)
        (isolated)
        (parameter of (type (named App.Box (optional Int))))
        (returns String)
        (body
          (return "box"))))))

(program
  (warp 1)
  (import App.Box)
  (import App.Describable.describe)
  (const d (call App.Describable.describe (as (struct (field item 1)) (named App.Box (optional Int)))))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns String)
    (body
      (return d))))
(expect (answers "box"))
