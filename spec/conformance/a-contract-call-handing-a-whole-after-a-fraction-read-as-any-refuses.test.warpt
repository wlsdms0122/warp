warpt 1
{
  expect {
    refuses "run"
  }
  name "a-contract-call-handing-a-whole-after-a-fraction-read-as-any-refuses"
  note "The first argument arrives a fraction, so Double.plus answers. The whole literal beside a reading of Any is the Int it is, and a Double slot takes no whole number: the boundary refuses it before Double.plus is asked."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            type "Any"
            value 0.5
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

