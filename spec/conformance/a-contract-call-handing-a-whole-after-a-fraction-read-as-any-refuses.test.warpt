warpt 1
{
  expect {
    refuses "build"
  }
  name "a-contract-call-handing-a-whole-after-a-fraction-read-as-any-refuses"
  note "`held` is read as `Any` and stands first, where `Standard.Numeric.plus` asks `Self`, which a reading of `Any` stands at only through a cast, so the build refuses before any row is picked."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            type "Any"
            value 0.5
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

