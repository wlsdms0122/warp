warpt 1
{
  expect {
    answers 11
  }
  name "a-variable-handed-in-place-is-written-by-the-callee"
  note "A parameter typed `inout` takes the caller's variable rather than its value. The callee writes the box, and the caller reads what was written."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      bump {
        body [
          {
            call {
              arguments {
                value 1
              }
              of {
                ref "count"
              }
              procedure "std.math.plus"
            }
            set "count"
          }
        ]
        parameters {
          count "inout int"
        }
      }
      entry {
        body [
          {
            value 10
            var "n"
          }
          {
            call {
              arguments {
                count {
                  ref "n"
                }
              }
              procedure "bump"
            }
          }
        ]
        result {
          ref "n"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}
