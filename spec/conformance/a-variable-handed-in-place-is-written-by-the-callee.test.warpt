warpt 1
{
  expect {
    answers 11
  }
  name "a-variable-handed-in-place-is-written-by-the-callee"
  note "A parameter typed `inout` takes the caller's variable rather than its value. The callee writes the box, and the caller reads what was written."
  program {
    imports [
      "Standard.Math.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments [
                  {
                    ref "count"
                  }
                  1
                ]
                procedure "Standard.Math.plus"
              }
            }
          }
        ]
        parameters [
          {
            name "count"
            type "inout Int"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            value 10
            var "n"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure "bump"
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

