(test 1)
(name "a-claim-about-a-list-gives-its-element-as-an-associated-type-answers")
(note "Lists answer `Lib.Container` under `Array<some E>`, giving Item as E, so the first of a list of Int is an Int.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (extension
      (head (array (some E)))
      (satisfies Lib.Container)
      (type Item (some E))
      (procedure first
        (access public)
        (parameter of (type (array (some E))))
        (returns (some E))
        (body
          (return (path of (index 0))))))))

(program
  (warp 1)
  (import Array Lib.Container)
  (import Int.plus)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let x (call Lib.firstOf (array 2)))
      (return (call Int.plus x 1)))))
(expect (answers 3))
