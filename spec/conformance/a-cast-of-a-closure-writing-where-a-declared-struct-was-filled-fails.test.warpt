warpt 1
{
  expect {
    answers "cast_refused"
  }
  name "a-cast-of-a-closure-writing-where-a-declared-struct-was-filled-fails"
  note "App.h keeps n in cell and writes a closure that sets cell from its own some T, held as Any. The entry fills T with App.R. The cast reading the closure as taking an App.X, a struct of the same fields under another name, fails with cast_refused, since only App.h's call filled its T, and the attempt in the entry catches the failure."
  program {
    imports []
    procedures {
      "App.h" {
        body [
          {
            value {
              ref "n"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "w"
            value {
              as {
                of {
                  ref "a"
                }
                type "(App.X) -> Int"
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    struct {
                      x 7
                    }
                  }
                ]
                procedure {
                  ref "w"
                }
              }
            }
          }
        ]
        failing "anything"
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "p"
                    type "App.R"
                    value {
                      struct {
                        x 1
                      }
                    }
                  }
                  {
                    let "r"
                    value {
                      call {
                        arguments [
                          {
                            ref "p"
                          }
                        ]
                        procedure "App.h"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "tried.type"
                  }
                }
                result {
                  ref "r.x"
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
        returns "Any"
      }
    }
    types {
      "App.R" {
        struct {
          x "Int"
        }
      }
      "App.X" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

