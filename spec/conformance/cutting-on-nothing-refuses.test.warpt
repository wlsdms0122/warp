warpt 1
{
  expect {
    answers {
      message "split asks an empty separator"
      type "aborted"
    }
  }
  name "cutting-on-nothing-refuses"
  note "A separator with no characters matches everywhere and consumes nothing, so there is no text it could cut. The refusal is the language's one refusal, which is what lets an attempt around it catch it."
  program {
    imports [
      "std.text.split"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          "a,b"
                          ""
                        ]
                        procedure "std.text.split"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    record {
                      message {
                        ref "tried.message"
                      }
                      type {
                        ref "tried.type"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

