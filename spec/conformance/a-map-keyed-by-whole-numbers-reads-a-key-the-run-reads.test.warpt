(test 1)
(name "a-map-keyed-by-whole-numbers-reads-a-key-the-run-reads")
(note "A path between the brackets of a map stands where the map's key type is read, so on `Dictionary<Int, String>` an `Int` the run reads finds the entry under it.")

(program
  (warp 1)
  (procedure App.read
    (parameter of (type (dictionary Int String)))
    (parameter key (type Int))
    (returns String)
    (result (path of (index key))))
  (procedure entry
    (access public)
    (returns String)
    (result (call App.read (dictionary (entry 0 "y") (entry 7 "x")) 7))))
(expect (answers "x"))
