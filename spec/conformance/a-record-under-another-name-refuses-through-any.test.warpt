warpt 1
{
  expect {
    refuses "run"
  }
  name "a-record-under-another-name-refuses-through-any"
  note "Through `any` the build cannot see the name, so the slot asks at the run: a `Vault` arriving where `Account` is declared refuses, whatever its structure."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "Vault"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      ref "held"
                    }
                  ]
                  procedure "hide"
                }
              }
            ]
            procedure "read"
          }
        }
        returns "Account"
      }
      hide {
        parameters [
          {
            name "it"
            type "any"
          }
        ]
        result {
          ref "it"
        }
        returns "any"
      }
      read {
        parameters [
          {
            name "account"
            type "Account"
          }
        ]
        result {
          ref "account"
        }
        returns "Account"
      }
    }
    types {
      Account {
        record {
          balance "int"
        }
      }
      Vault {
        record {
          balance "int"
        }
      }
    }
    warp 1
  }
  test 1
}

