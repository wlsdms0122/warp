(test 1)
(name "a-closure-handed-in-place-fails-with-exactly-what-the-slot-names")
(note "A slot handed a variable in place is one type with it. `s` holds a closure that fails with nothing, and the slot's type writes `throws` with no list, anything, so the two are two types and the call is refused at the build.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (var s
        (closure
          (parameter x (type Int))
          (returns Int)
          (result x)))
      (call keep s))
    (result (apply s 1)))
  (procedure keep
    (parameter step (type (inout (procedure (const) (isolated) (parameters Int) (failing (anything)) (returns Int)))))))
(expect (refuses build))
