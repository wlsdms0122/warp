warpt 1
{
  expect {
    answers [
      1
    ]
  }
  name "a-constant-record-hands-a-field-on-at-its-own-type"
  note "A record constant's fields keep their own types, so `k.a`, a `const` closure beside a field that runs, stands where `map` asks a `const` procedure."
  program {
    const {
      k {
        record {
          a {
            closure {
              parameters [
                {
                  name "x"
                  type "Int"
                }
              ]
              result {
                ref "x"
              }
              returns "Int"
            }
          }
          b {
            closure {
              body [
                {
                  let "h"
                  value {
                    closure {
                      parameters [
                        {
                          name "q"
                          type "Int"
                        }
                      ]
                      result {
                        ref "q"
                      }
                      returns "Int"
                    }
                  }
                }
                {
                  let "z"
                  value {
                    call {
                      arguments [
                        {
                          ref "x"
                        }
                      ]
                      procedure {
                        ref "h"
                      }
                    }
                  }
                }
              ]
              parameters [
                {
                  name "x"
                  type "Int"
                }
              ]
              result {
                ref "z"
              }
              returns "Int"
            }
          }
        }
      }
    }
    imports [
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
              ]
              {
                ref "k.a"
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

