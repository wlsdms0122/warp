warpt 1
{
  expect {
    answers [
      1
    ]
  }
  name "a-constant-record-hands-a-field-on-at-its-own-type"
  note "A constant of a declared record reads each field at the type its declaration writes, so `k.a`, declared a `const` procedure beside a field that runs, stands where `map` asks a `const` procedure."
  program {
    const {
      k {
        as {
          of {
            record {
              a {
                closure {
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    ref "x"
                  }
                  returns "Int"
                }
              }
              b {
                closure {
                  body [
                    {
                      let "h"
                      value {
                        closure {
                          parameters [
                            {
                              name "q"
                              type "Int"
                            }
                          ]
                          result {
                            ref "q"
                          }
                          returns "Int"
                        }
                      }
                    }
                    {
                      let "z"
                      value {
                        call {
                          arguments [
                            {
                              ref "x"
                            }
                          ]
                          procedure {
                            ref "h"
                          }
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    ref "z"
                  }
                  returns "Int"
                }
              }
            }
          }
          type "App.K"
        }
      }
    }
    imports [
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
              ]
              {
                ref "k.a"
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
      }
    }
    types {
      "App.K" {
        record {
          a {
            "const procedure" {
              parameters [
                "Int"
              ]
              returns "Int"
            }
          }
          b {
            procedure {
              parameters [
                "Int"
              ]
              returns "Int"
            }
          }
        }
      }
    }
    warp 1
  }
  test 1
}

