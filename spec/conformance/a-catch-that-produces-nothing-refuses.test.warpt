(test 1)
(name "a-catch-that-produces-nothing-refuses")
(note "A catch with no statement in it would drop a failure without a trace.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var tried)
      (try
        (body
          (let work 1)
          (set tried work))
        (catch))
      (return tried))))
(expect (refuses load))
