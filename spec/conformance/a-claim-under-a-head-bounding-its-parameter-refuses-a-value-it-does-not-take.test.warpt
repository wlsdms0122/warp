warpt 1
{
  expect {
    refuses "build"
  }
  name "a-claim-under-a-head-bounding-its-parameter-refuses-a-value-it-does-not-take"
  note "A box of App.Plain is no box of something that answers `Hashable`, so `App.Box<some T: Hashable>` does not take it and the call handing it where App.Describable is asked refuses at the build."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    extensions {
      "App.Box<some T: Hashable>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Box<some T>"
              }
            ]
            result "box"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<App.Plain>"
            value {
              struct {
                item {
                  struct {
                    x 1
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
      "App.Plain" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

