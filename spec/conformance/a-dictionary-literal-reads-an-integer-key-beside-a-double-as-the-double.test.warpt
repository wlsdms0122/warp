(test 1)
(name "a-dictionary-literal-reads-an-integer-key-beside-a-double-as-the-double")
(note "A dictionary literal's keys join, and an integer literal beside a `Double` is the `Double` it names, so the key written `1` is `1.0` and `keys` returns both keys as floating-point numbers.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (procedure entry
    (access public)
    (returns (array Double))
    (body
      (return (call Standard.Collection.keys (dictionary (entry 1 "a") (entry 2.5 "b")))))))
(expect (answers (array 1.0 2.5)))
