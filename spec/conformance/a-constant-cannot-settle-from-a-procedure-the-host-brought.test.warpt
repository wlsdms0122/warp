(test 1)
(name "a-constant-cannot-settle-from-a-procedure-the-host-brought")
(note "A constant settles at the build and what it settles to is written into the compiled document, so it settles from what every implementation answers the same way: a body in the link, and the procedures this specification names. `App.seat` answers what the host's code answers, and the compiled document says nothing about which code that was, so folding through it would write a value nothing can be read against.")

(vocabulary
  (procedure App.seat
    (const)
    (isolated)
    (returns Int)
    (answers 7)))

(program
  (warp 1)
  (import App.seat)
  (const seat (call App.seat))
  (procedure entry
    (access public)
    (returns Int)
    (result seat)))
(expect (refuses build))
