warpt 1
{
  expect {
    answers 2
  }
  name "a-map-literal-writing-a-key-the-run-reads-twice-holds-the-later-value"
  note "The entries are made in the order written, keys the run reads included, so two keys that turn out one leave the later value."
  program {
    imports []
    procedures {
      "App.m" {
        parameters [
          {
            name "a"
            type "Int"
          }
          {
            name "b"
            type "Int"
          }
        ]
        result {
          dictionary [
            [
              {
                ref "a"
              }
              1
            ]
            [
              {
                ref "b"
              }
              2
            ]
          ]
        }
        returns "Dictionary<Int, Int>"
      }
      entry {
        access "public"
        body [
          {
            let "m"
            value {
              call {
                arguments [
                  3
                  3
                ]
                procedure "App.m"
              }
            }
          }
        ]
        result {
          ref "m[3]"
        }
        returns "Int?"
      }
    }
    warp 1
  }
  test 1
}

