(test 1)
(name "an-optional-dot-on-a-field-that-is-there-refuses")
(note "`?.` reads a segment that may be absent as null. On a field the reading already says is there it says nothing, and a claim that says nothing is refused at the build.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let point (type App.Point) (struct (field x 1))))
    (result (path point (field? x)))))
(expect (refuses build))
