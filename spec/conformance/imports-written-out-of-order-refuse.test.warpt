(test 1)
(name "imports-written-out-of-order-refuse")
(note "A document lists what it imports in name order, so a list in another order is a second spelling of the same list. A document says each thing one way, and this one is refused where it is read.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (import Standard.Logic.equal)
  (procedure entry
    (access public)
    (result (call Standard.Logic.equal (call Standard.Numeric.plus 1 1) 2))))
(expect (refuses load))
