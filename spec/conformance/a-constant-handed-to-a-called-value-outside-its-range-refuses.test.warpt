warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-handed-to-a-called-value-outside-its-range-refuses"
  note "A constant handed to a value is settled at the build against the type at its position, the gate the run would hold it to: a whole number is the kind `Int(0...10)` takes, and 99 is still outside it, so every run would refuse it and the build does."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "level"
            value {
              closure {
                parameters [
                  {
                    name "n"
                    type "Int(0...10)"
                  }
                ]
                result {
                  ref "n"
                }
                returns "Int"
              }
            }
          }
          {
            let "made"
            value {
              call {
                arguments [
                  99
                ]
                procedure {
                  ref "level"
                }
              }
            }
          }
        ]
        result {
          ref "made"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

