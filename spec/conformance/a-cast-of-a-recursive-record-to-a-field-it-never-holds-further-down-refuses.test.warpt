warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-recursive-record-to-a-field-it-never-holds-further-down-refuses"
  note "`app.T` declares `{ n: app.T? }`, so a value of it is a chain of records ending in null. `t` is read as `app.T`, and the cast names a record four deep whose last `n` holds a whole number. However deep the chain goes, every `n` holds a record or null and never an int, so no value is both and the cast refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "t"
            type "app.T"
            value {
              record {
                n {
                  record {
                    n {
                      record {
                        n null
                      }
                    }
                  }
                }
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "t"
                }
                type {
                  record {
                    n {
                      record {
                        n {
                          record {
                            n {
                              record {
                                n "int"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          ref "b"
        }
      }
    }
    types {
      "app.T" {
        record {
          n "app.T?"
        }
      }
    }
    warp 1
  }
  test 1
}

