warpt 1
{
  expect {
    answers 2
  }
  name "a-dictionary-entry-handed-in-place-is-read-by-the-callee"
  note "An entry of a dictionary is handed in place the way a field is. The callee reads what the entry holds through the path, and its write lands in the caller's box."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments [
                  {
                    ref "count"
                  }
                  1
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        parameters [
          {
            name "count"
            type "inout Int"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            type "Dictionary<String, Int>"
            value {
              dictionary [
                [
                  "a"
                  1
                ]
              ]
            }
            var "d"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "d.a"
                  }
                ]
                procedure "bump"
              }
            }
          }
        ]
        result {
          ref "d.a"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

