(test 1)
(name "a-struct-under-another-name-refuses")
(note "Two declared structs of one type under two names are two types. A value read as a `Vault` fits no `Account` slot, and the build reads that off the cast.")

(program
  (warp 1)
  (struct Account
    (field balance Int))
  (struct Vault
    (field balance Int))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let held (as (struct (field balance 1)) Vault))
      (return (call read held))))
  (procedure read
    (parameter account (type Account))
    (returns Int)
    (body
      (return (path account (field balance))))))
(expect (refuses build))
