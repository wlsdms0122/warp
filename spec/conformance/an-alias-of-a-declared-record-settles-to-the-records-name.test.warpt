warpt 1
{
  arguments {
    who {
      name "a"
    }
  }
  expect {
    answers Person {
      name "a"
    }
  }
  name "an-alias-of-a-declared-record-settles-to-the-records-name"
  note "A declared name standing for a declared record is an alias, and settling judges by what it stands for: a nameless record reaching the alias takes the record's own name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "who"
            type "Someone"
          }
        ]
        result {
          ref "who"
        }
      }
    }
    types {
      Person {
        record {
          name "string"
        }
      }
      Someone "Person"
    }
    warp 1
  }
  test 1
}

