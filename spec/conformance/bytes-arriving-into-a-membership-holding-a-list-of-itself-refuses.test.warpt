warpt 1
{
  expect {
    refuses "run"
  }
  name "bytes-arriving-into-a-membership-holding-a-list-of-itself-refuses"
  note "`App.B` admits `array<App.B>` and `string`, and `Standard.Text.encoded` answers bytes that arrive through a name declared `any`. A byte is neither a list nor a string, and asking `App.B` of the bytes as a list asks each byte afresh, so the run refuses as it does for the same list written out."
  program {
    constraints {
      "App.B" [
        "array<App.B>"
        "string"
      ]
    }
    imports [
      "Standard.Text.encoded"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "raw"
            type "any"
            value {
              call {
                arguments [
                  "hi"
                  "utf8"
                ]
                procedure "Standard.Text.encoded"
              }
            }
          }
          {
            type "App.B"
            value {
              ref "raw"
            }
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

