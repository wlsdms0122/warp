(test 1)
(name "the-object-of-a-try")
(note "A try carries its body, its catch and the slot the failure is bound in for the catch to read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter payload)
    (returns String)
    (body
      (var tried)
      (try
        (body
          (let read (as payload String))
          (set tried read))
        (catch
          (set tried "caught")))
      (return tried))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false) (array 1 (array) false) (array 2 (array) false) (array 1 (array) false) (array 1 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"7dfdcfc2a76fb9da971ced69f2e2f450238487712eeca2b4116fdfabd9223ca5")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 6))) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 6 1 0 false) (array 1 2) (array 0 1) (array 10 (array (array (array (array 0 2)) 2 "read") (array (array (array 2 1)) 3 "tried")) (array (array (array (array 2 3)) 4 "tried")) (array)) (array 1 4) (array 13 0 (array 6)))) (entry "rows" (array (array "entry" (array (array (array "payload" (array))) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 1 1)) 0 "tried") (array (array) 5 "[1]") (array (array) 7 "[2]")) (array 3 (array 0) (array) (array) (array "payload" "tried" "read")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 6))) (entry "types" (array)) (entry "valueTable" (array (array 0) (array 4 "caught"))) (entry "variables" (array)))))
