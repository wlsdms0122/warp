warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-read-as-dictionaries-of-a-record-and-of-a-nameless-one-is-a-dictionary-of-the-nameless-one-refuses"
  note "App.pick reads its some T as a dictionary of Bank.Card that may be null and as a dictionary of nameless records of its fields. The reading that holds both is a dictionary of the nameless record that may be null, so handing it to a slot of a contract refuses at the build."
  program {
    contracts {
      "App.Describable" {
        describe {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "xs"
            type "Dictionary<App.Describable>?"
          }
        ]
        result "seen"
        returns "String"
      }
      "App.pick" {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return {
                        ref "x"
                      }
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "Bool"
          }
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "some T"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<Bank.Card>?"
            value {
              record {
                k {
                  as {
                    of {
                      record {
                        last "42"
                      }
                    }
                    type "Bank.Card"
                  }
                }
              }
            }
          }
          {
            let "e"
            type {
              dictionary {
                record {
                  last "String"
                }
              }
            }
            value {
              record {
                k {
                  record {
                    last "x"
                  }
                }
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  false
                  {
                    ref "d"
                  }
                  {
                    ref "e"
                  }
                ]
                procedure "App.pick"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

