(test 1)
(name "an-element-handed-in-place-beside-its-list-is-past-the-end-once-the-list-is-emptied")
(note "App.g takes a list and its first element in place, at its own type parameters. It empties the list and leaves the element, which now stands past the end, so nothing is written there, and the list answers empty.")

(program
  (warp 1)
  (procedure App.g
    (parameter a (type (inout (array (some T)))))
    (parameter b (type (inout (some T))))
    (parameter j)
    (returns Int)
    (body
      (let y (call App.h b j))
      (set a (array)))
    (result 0))
  (procedure App.h
    (parameter n (type (some T)))
    (parameter j)
    (returns (some T))
    (body
      (var cell n)
      (let c
        (closure
          (parameter y (type (some T)))
          (returns Int)
          (body
            (set cell y))
          (result 0))))
    (result cell))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (var xs (array 1))
      (let r (call App.g xs (path xs (index 0)) 5)))
    (result xs)))
(expect (answers (array)))
