(test 1)
(name "a-map-keyed-by-a-struct-taking-a-type-parameter-no-document-claims-hashable-refuses")
(note "What a struct is applied to does not make it a map's key. No document says `App.Box` answers `Hashable`, so a map keyed by `App.Box<Int>` is refused.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let m (type (dictionary (named App.Box Int) Int)) (dictionary)))
    (result 1)))
(expect (refuses build))
