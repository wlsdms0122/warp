warpt 1
{
  arguments {
    value 256
  }
  expect {
    refuses "run"
  }
  name "a-byte-is-a-whole-number-a-range-refines"
  note "byte is not a kind: std declares it as int(0...255), the way any module names a type. A slot declaring byte admits exactly what the range admits, and 256 misses it by one."
  program {
    imports []
    procedures {
      entry {
        parameters {
          value {
            type "std.byte"
          }
        }
        result {
          ref "value"
        }
      }
    }
    warp 1
  }
  test 2
}

