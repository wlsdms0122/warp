warpt 1
{
  arguments {
    value 256
  }
  expect {
    refuses "run"
  }
  name "a-byte-is-a-whole-number-a-range-refines"
  note "Standard.Byte is not a kind: Standard declares it as Int(0...255), the way any module names a type. A slot declaring Standard.Byte admits exactly what the range admits, and 256 misses it by one."
  program {
    imports [
      "Standard.Byte"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "value"
            type "Standard.Byte"
          }
        ]
        result {
          ref "value"
        }
      }
    }
    warp 1
  }
  test 1
}

