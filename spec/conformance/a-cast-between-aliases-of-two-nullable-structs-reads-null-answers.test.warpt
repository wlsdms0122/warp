(test 1)
(name "a-cast-between-aliases-of-two-nullable-structs-reads-null-answers")
(note "`App.NA` names `App.A?` and `App.NB` names `App.B?`. Each is an alias and stands for what it names, so null is a value of both, the cast could hold and builds, and the run reads null as one of `App.NB`.")

(program
  (warp 1)
  (struct App.A
    (field a String))
  (struct App.B
    (field b Int))
  (type App.NA (nullable App.A))
  (type App.NB (nullable App.B))
  (procedure entry
    (access public)
    (returns (nullable App.B))
    (failing cast_refused)
    (body
      (let n (type App.NA) null)
      (return (as n App.NB)))))
(expect (answers null))
