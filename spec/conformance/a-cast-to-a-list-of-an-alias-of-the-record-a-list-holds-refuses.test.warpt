warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-to-a-list-of-an-alias-of-the-record-a-list-holds-refuses"
  note "`Bank.BB` stands for `Bank.B`, a declared record. `xs` is read as `array<Bank.B>`, so casting it as `array<Bank.BB>` names what the reading already is under another spelling of the same record, and the build refuses the cast as needless."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "xs"
            type "array<Bank.B>"
            value [
              {
                record {
                  k "x"
                }
              }
            ]
          }
          {
            let "ys"
            value {
              as {
                of {
                  ref "xs"
                }
                type "array<Bank.BB>"
              }
            }
          }
        ]
        result 0
      }
    }
    types {
      "Bank.B" {
        record {
          k "string"
        }
      }
      "Bank.BB" "Bank.B"
    }
    warp 1
  }
  test 1
}

