warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-read-as-a-declared-record-with-a-var-field-and-a-nameless-one-reads-the-nameless-one-refuses"
  note "`App.Box` is declared `{ a: var int }`. `App.f` takes two of `some T` and answers the first. The call hands a name read as `App.Box` and the nameless record `{ a: 2 }`, so `T` is read as the nameless one, `{ a: int }`: a field's `var` is a fact about the field and not about the value. Casting the answer to `{ a: int }` reads it as what it already is, so the build refuses the cast."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box"
            value {
              record {
                a 1
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    record {
                      a 2
                    }
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          as {
            of {
              ref "r"
            }
            type {
              record {
                a "int"
              }
            }
          }
        }
      }
    }
    types {
      "App.Box" {
        record {
          a "var int"
        }
      }
    }
    warp 1
  }
  test 1
}

