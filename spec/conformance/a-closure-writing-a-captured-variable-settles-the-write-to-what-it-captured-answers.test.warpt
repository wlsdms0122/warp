warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-writing-a-captured-variable-settles-the-write-to-what-it-captured-answers"
  note "`r` declares nothing and starts as `a`, a `bank.A`. A closure that captured it writes the nameless record `{ k: \"y\" }` into it. The closure holds `r` to what it read as there, so the write settles to `bank.A`, and `app.P.show`, which `bank.A` answers, is sent to `r` after the closure ran."
  program {
    contracts {
      "app.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.A.show" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "a"
            value {
              as {
                of {
                  record {
                    k "x"
                  }
                }
                type "bank.A"
              }
            }
          }
          {
            value {
              ref "a"
            }
            var "r"
          }
          {
            let "w"
            value {
              closure {
                body [
                  {
                    set "r"
                    value {
                      record {
                        k "y"
                      }
                    }
                  }
                ]
                result 0
              }
            }
          }
          {
            let "z"
            value {
              call {
                procedure {
                  ref "w"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "r"
              }
            ]
            procedure "app.P.show"
          }
        }
      }
    }
    satisfies {
      "bank.A" [
        "app.P"
      ]
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

