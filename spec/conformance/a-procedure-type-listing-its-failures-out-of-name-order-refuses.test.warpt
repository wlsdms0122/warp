(test 1)
(name "a-procedure-type-listing-its-failures-out-of-name-order-refuses")
(note "A procedure type lists what it may fail with in name order, its one way, so `throws(cast_refused, aborted)` refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (type (procedure (parameters Int) (failing cast_refused aborted) (returns Int)))
        (closure
          (parameter x (type Int))
          (returns Int)
          (result x))))
    (result 1)))
(expect (refuses load))
