warpt 1
{
  expect {
    refuses "load"
  }
  name "a-procedure-type-listing-its-failures-out-of-name-order-refuses"
  note "A procedure type lists what it may fail with in name order, its one way, so `throws(cast_refused, aborted)` refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            type "(Int) throws(cast_refused, aborted) -> Int"
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "Int"
                  }
                ]
                result {
                  ref "x"
                }
                returns "Int"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

