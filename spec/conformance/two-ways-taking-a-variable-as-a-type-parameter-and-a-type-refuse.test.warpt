warpt 1
{
  expect {
    refuses "build"
  }
  name "two-ways-taking-a-variable-as-a-type-parameter-and-a-type-refuse"
  note "In a procedure generic over `T`, one arm takes `n` while it reads `T`, and the other sets it to an int and takes it there. `T` is whatever a call fills it with, not an int, so the two ways held the box to different types and the build refuses where they meet."
  program {
    imports []
    procedures {
      "App.pick" {
        body [
          {
            value {
              ref "x"
            }
            var "n"
          }
          {
            value {
              conditional {
                else [
                  {
                    set "n"
                    value 1
                  }
                  {
                    let "b"
                    value {
                      closure {
                        result {
                          ref "n"
                        }
                      }
                    }
                  }
                ]
                then [
                  {
                    let "a"
                    value {
                      closure {
                        result {
                          ref "n"
                        }
                      }
                    }
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "ready"
            type "bool"
          }
        ]
        result 1
        returns "int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              2
              true
            ]
            procedure "App.pick"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

