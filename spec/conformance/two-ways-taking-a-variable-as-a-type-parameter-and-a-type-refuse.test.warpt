(test 1)
(name "two-ways-taking-a-variable-as-a-type-parameter-and-a-type-refuse")
(note "In a procedure generic over `T`, one arm takes `n` while it reads `T`, and the other sets it to an int and takes it there. `T` is whatever a call fills it with, not an int, so the two ways held the box to different types and the build refuses where they meet.")

(program
  (warp 1)
  (procedure App.pick
    (parameter x (type (some T)))
    (parameter ready (type Bool))
    (returns Int)
    (body
      (var n x)
      (conditional
        (when ready)
        (then
          (let a
            (closure
              (returns (some T))
              (body
                (return n)))))
        (else
          (set n 1)
          (let b
            (closure
              (returns Int)
              (body
                (return n))))))
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.pick 2 true)))))
(expect (refuses build))
