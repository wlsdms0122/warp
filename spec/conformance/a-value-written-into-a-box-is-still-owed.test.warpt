warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-written-into-a-box-is-still-owed"
  note "A box written whole with a value written `linear` holds it the way a name bound to it does. The body hands on what the box held first, writes a new one into it, and reaches its end still holding that one."
  program {
    imports [
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "app.open"
              }
            }
            var "handle"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
          {
            set "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

