(test 1)
(name "a-type-parameter-written-nullable-refuses")
(note "The `?` is written only where it says something new. A type parameter stands for the whole type the call fills in, so `some T?` writes `?` where it says nothing a parameter does not, and refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (nullable (some T))))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
