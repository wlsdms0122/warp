(test 1)
(name "two-documents-claiming-one-contract-under-heads-taking-the-same-values-are-one-claim")
(note "`App.Box<some T: Hashable>` and `App.Box<some U: Hashable>` take the same boxes, so the two documents writing them say one claim, which the build reads where the names resolve, and the call reaches the member.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String)))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns String)
        (result "box"))))
  (document
    (warp 1)
    (import App.Box)
    (import App.Describable)
    (extension
      (head (named App.Box (some U Hashable)))
      (satisfies App.Describable))))

(program
  (warp 1)
  (import App.Box)
  (import App.Describable.describe)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1))))
    (result (call App.Describable.describe b))))
(expect (answers "box"))
