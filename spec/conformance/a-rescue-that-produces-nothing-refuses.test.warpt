(test 1)
(name "a-rescue-that-produces-nothing-refuses")
(note "A rescue with no statement in it would drop a failure without a trace.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var tried)
      (attempt
        (body
          (let work 1)
          (set tried work))
        (rescue))
      (return tried))))
(expect (refuses load))
