(test 1)
(name "a-rescue-that-produces-nothing-refuses")
(note "A rescue that produces nothing would swallow a failure into null without a trace.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let tried
        (attempt
          (body
            (let work 1))
          (result work)
          (rescue
            (body)))))
    (result tried)))
(expect (refuses load))
