warpt 1
{
  expect {
    answers app.A {
      a "s"
    }
  }
  name "a-cast-to-an-alias-of-a-nullable-record-names-the-record-answers"
  note "`app.NA` names `app.A?`, which is no record, so it is an alias and stands for what it names. A nameless record read as `{ a: string }?` cast `as app.NA` is the cast `as app.A?`: it could hold and is no needless cast, so it builds, and the run gives the record the name `app.A`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "x"
            type "any"
            value {
              record {
                a "s"
              }
            }
          }
          {
            let "r"
            value {
              "as?" {
                of {
                  ref "x"
                }
                type {
                  record {
                    a "string"
                  }
                }
              }
            }
          }
        ]
        result {
          as {
            of {
              ref "r"
            }
            type "app.NA"
          }
        }
      }
    }
    types {
      "app.A" {
        record {
          a "string"
        }
      }
      "app.NA" "app.A?"
    }
    warp 1
  }
  test 1
}

