warpt 1
{
  expect {
    refuses "build"
  }
  name "what-is-not-utf8-text-written-as-a-constant-refuses-to-decode"
  note "Bytes carry no promise of being text, and completing a broken sequence with replacement characters would answer a text nobody sent. The bytes are written as a constant, and `decoded` judges its own constant arguments, so the refusal is the build's."
  program {
    imports [
      "Standard.Text.decoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              x"ff"
              "utf8"
            ]
            procedure "Standard.Text.decoded"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

