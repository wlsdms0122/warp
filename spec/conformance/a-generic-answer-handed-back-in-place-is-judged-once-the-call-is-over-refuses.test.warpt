warpt 1
{
  expect {
    refuses "run"
  }
  name "a-generic-answer-handed-back-in-place-is-judged-once-the-call-is-over-refuses"
  note "App.put appends what App.h answers to the list handed to it in place, and App.h answers its any for its own some T. Nothing proves App.put hands back what it declares, so the call judges the list of the caller against array<string> once it is over, and the 5 in it refuses at the run."
  program {
    imports [
      "Standard.Collection.append"
    ]
    procedures {
      "App.h" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "any"
          }
        ]
        result {
          ref "junk"
        }
        returns "some T"
      }
      "App.put" {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  {
                    call {
                      arguments [
                        {
                          ref "n"
                        }
                        {
                          ref "junk"
                        }
                      ]
                      procedure "App.h"
                    }
                  }
                ]
                procedure "Standard.Collection.append"
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "any"
          }
          {
            name "xs"
            type "inout array<some T>"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value [
              "a"
            ]
            var "s"
          }
          {
            value {
              call {
                arguments [
                  "b"
                  5
                  {
                    ref "s"
                  }
                ]
                procedure "App.put"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

