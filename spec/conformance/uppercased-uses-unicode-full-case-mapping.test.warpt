warpt 1
{
  expect {
    answers "SS"
  }
  name "uppercased-uses-unicode-full-case-mapping"
  note "Case mapping is Unicode's full default mapping, so a character may map to more than one: `ß` uppercases to `SS`."
  program {
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "ß"
            ]
            procedure "Standard.Text.uppercased"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

