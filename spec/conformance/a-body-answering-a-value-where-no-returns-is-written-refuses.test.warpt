warpt 1
{
  expect {
    refuses "build"
  }
  name "a-body-answering-a-value-where-no-returns-is-written-refuses"
  note "A declaration that writes no `returns` answers null, so a body whose `result` names a number answers more than its declaration says, and refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

