(test 1)
(name "a-write-indexes-with-a-name")
(note "An index written as a name is read in the scope the write stands in, and the write lands on that one position.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (var xs (array 1 2 3))
      (let i 1)
      (set (path xs (index i)) 9)
      (return xs))))
(expect (answers (array 1 9 3)))
