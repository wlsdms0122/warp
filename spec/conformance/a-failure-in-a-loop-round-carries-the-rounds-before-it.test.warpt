(test 1)
(name "a-failure-in-a-loop-round-carries-the-rounds-before-it")
(note "The first round sets `n` to a string and continues; a later round fails. The failure lands at the attempt after every round before it, so the rescue reads `n` as what any of those rounds may have left, and asking whether it is an int stands rather than being a cast the reading already decides.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (import Standard.Control.abort)
  (procedure check
    (parameter x (type Int))
    (returns Int)
    (failing aborted)
    (body
      (conditional
        (when (call Standard.Comparable.lessThan x 0))
        (then
          (call Standard.Control.abort "negative")))
      (return x)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var n 0)
      (var first true)
      (attempt
        (body
          (loop
            (while true)
            (body
              (conditional
                (when first)
                (then
                  (set n "s")
                  (set first false)
                  (continue)))
              (call check -1)))
          (return 0))
        (rescue
          (let s (as? n Int))))
      (return 1))))
(expect (answers 1))
