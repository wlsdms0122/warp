(test 1)
(name "a-const-closure-calling-a-captured-variable-that-declares-nothing-refuses")
(note "A variable that declared nothing is held to the type it read as where a closure captured it, which is a reading the build worked out, so it says nothing the closure can hold on to, even where the closure literal it holds declares `const`. `relaying` declares `const` and calls `answering` through the capture, so it refuses at the build.")

(program
  (warp 1)
  (procedure asking
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body))
      (return answered)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (var answering
        (closure
          (const)
          (returns String)
          (body
            (return "answered"))))
      (let relaying
        (closure
          (const)
          (returns String)
          (failing (anything))
          (body
            (return (apply answering)))))
      (return (call asking relaying)))))
(expect (refuses build))
