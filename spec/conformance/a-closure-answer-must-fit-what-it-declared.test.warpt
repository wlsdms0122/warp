warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-answer-must-fit-what-it-declared"
  note "A closure literal writes its `returns` beside its body, so what it answers is held to it the way a declaration's answer is: the text it answers is no `Int`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "level"
            value {
              closure {
                result "three hundred"
                returns "Int"
              }
            }
          }
          {
            let "read"
            value {
              call {
                procedure {
                  ref "level"
                }
              }
            }
          }
        ]
        result {
          ref "read"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

