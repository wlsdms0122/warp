warpt 1
{
  expect {
    refuses "build"
  }
  name "a-literal-written-into-a-declared-variable-is-held-to-it-field-by-field-refuses"
  note "ys declares array<dictionary<array<string>>>, and [{ a: [] }, { a: [1] }] is written into it. The literal is held to the declaration part by part, so the 1 in the second record's list is a number where the declaration asks for text, and the build refuses it."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "array<dictionary<array<string>>>"
            value []
            var "ys"
          }
          {
            set "ys"
            value [
              {
                record {
                  a []
                }
              }
              {
                record {
                  a [
                    1
                  ]
                }
              }
            ]
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                ]
                procedure "std.collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

