(test 1)
(name "a-value-from-outside-under-a-name-no-document-declares-refuses")
(note "The host hands `a` under `App.Z`, which no document declares, where the entry declares nothing. A name a value carries is held to the struct it declares at every door, `Any` included, and `App.Z` names no type here, so the run refuses before the entry runs.")

(program
  (warp 1)
  (type App.A App.P)
  (struct App.P
    (field x Int))
  (procedure entry
    (access public)
    (parameter a)
    (returns Any)
    (body
      (return a))))
(arguments (argument a (struct App.Z (field x 1))))
(expect (refuses run))
