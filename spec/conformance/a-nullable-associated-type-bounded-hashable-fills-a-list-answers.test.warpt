(test 1)
(name "a-nullable-associated-type-bounded-hashable-fills-a-list-answers")
(note "App.MaybeBag gives Item as `Int?`, one type, which answers Hashable, so `Use.putH`, bounding `C.Item` by Hashable and taking a list of it, takes a list of `Int?`.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Lib.Bag)
    (struct App.MaybeBag
      (satisfies Lib.Bag)
      (field n (nullable Int))
      (type Item (nullable Int))
      (procedure first
        (access public)
        (parameter of (type App.MaybeBag))
        (returns (nullable Int))
        (body
          (return (path of (field n)))))
      (procedure take
        (access public)
        (parameter of (type App.MaybeBag))
        (parameter x (type (nullable Int)))
        (returns Int)
        (body
          (return 0)))))
  (document
    (warp 1)
    (import Lib.Bag)
    (procedure Use.putH
      (access public)
      (parameter c (type (some C Lib.Bag)))
      (parameter xs (type (array (some C.Item))))
      (returns Int)
      (bound C.Item Hashable)
      (body
        (return 0)))))

(program
  (warp 1)
  (import App.MaybeBag)
  (import Use.putH)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type App.MaybeBag) (struct (field n null)))
      (return (call Use.putH b (array 1 null))))))
(expect (answers 0))
