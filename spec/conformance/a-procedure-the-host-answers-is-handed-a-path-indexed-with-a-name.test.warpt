(test 1)
(name "a-procedure-the-host-answers-is-handed-a-path-indexed-with-a-name")
(note "A path handed in place to a procedure the host answers is read to a position the same way a write is: the index named by `i` is read where the call stands, and the procedure writes back to that element.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (procedure entry
    (access public)
    (returns (array (array Int)))
    (body
      (var grid (array (array 1) (array 2)))
      (let i 1)
      (call Standard.Collection.append (path grid (index i)) 9)
      (return grid))))
(expect (answers (array (array 1) (array 2 9))))
