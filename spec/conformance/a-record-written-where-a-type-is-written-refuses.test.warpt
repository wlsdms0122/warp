warpt 1
{
  expect {
    refuses "load"
  }
  name "a-record-written-where-a-type-is-written-refuses"
  note "A record is declared once, under its name in `types` as `{ record: { … } }`, and a type names it everywhere else. Written where a type is written, `{ record: { … } }` is no type."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "point"
            type {
              record {
                x "Int"
              }
            }
          }
        ]
        result 1
      }
    }
    warp 1
  }
  test 1
}

