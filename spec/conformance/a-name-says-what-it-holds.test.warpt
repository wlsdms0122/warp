warpt 1
{
  expect {
    answers 1
  }
  name "a-name-says-what-it-holds"
  note "A name may say what it holds under `type`, and the build works out a reading only where the name declares none. An `inout` slot asks for the same type the name is, and what the build derives about a closure (that this one answers without running and is isolated) is not what the name says. So the declaration is what lets this name be handed in place."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type {
              procedure {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "Int"
                  }
                ]
                result {
                  ref "x"
                }
                returns "Int"
              }
            }
            var "step"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "step"
                  }
                ]
                procedure "swap"
              }
            }
          }
        ]
        result 1
      }
      swap {
        body [
          {
            set "step"
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "Int"
                  }
                ]
                result 9
                returns "Int"
              }
            }
          }
        ]
        parameters [
          {
            name "step"
            type {
              "inout procedure" {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

