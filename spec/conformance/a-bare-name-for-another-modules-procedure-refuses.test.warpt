warpt 1
{
  expect {
    refuses "build"
  }
  name "a-bare-name-for-another-modules-procedure-refuses"
  note "`plus` is not the spelling of any procedure in the link: `Standard.Numeric.plus` is the spelling of the contract's procedure, and this document declares no `plus` of its own. A name is looked up as written, so the send refuses at the build."
  program {
    imports [
      "plus"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              2
            ]
            procedure "plus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

