(test 1)
(name "an-object-whose-struct-value-holds-fewer-values-than-its-field-names-refuses")
(note "A struct value carries its field names and then one value for each. `seen` starts a run holding an `App.R` whose names are `a`, `b` and `c` beside two values, which the reading refuses.")
(object (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"ae6cfbc97467ff4b6c82eaeef1654d7d14f639ee2853d6f5b9d48e623c0525b3")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 13 0 (array) (array 0)))) (entry "rows" (array (array "entry" (array (array) 2 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array) 1 "[0]")) (array 0 (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4) (array 4))) (entry "types" (array (array "App.R" (array 9 (array (array "a" 0) (array "b" 1)))))) (entry "valueTable" (array (array 2 1) (array 2 1) (array 2 2) (array 7 "App.R" (array "a" "b" "c") (array 1 2)))) (entry "variables" (array (array "seen" 3)))))
(expect (refuses load))
