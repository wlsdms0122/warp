warpt 1
{
  expect {
    answers "s"
  }
  name "a-closure-whose-body-shadows-a-variable-takes-nothing-of-it"
  note "A closure takes the variables around it that its body reads or writes. One whose body introduces the name again with its own `let` reads that name and not the variable, so it takes nothing of the variable, and a later `set` of the variable to another type retypes it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "n"
          }
          {
            let "f"
            value {
              closure {
                body [
                  {
                    let "n"
                    value "a"
                  }
                ]
                result {
                  ref "n"
                }
                returns "string"
              }
            }
          }
          {
            set "n"
            value "s"
          }
        ]
        result {
          ref "n"
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

