warpt 1
{
  expect {
    refuses "build"
  }
  name "a-piece-that-is-not-a-closure-refuses"
  note "`Standard.Concurrent.all` takes `Array<isolated Procedure>`, so a piece the text shows is not a closure is refused at the build."
  program {
    imports [
      "Standard.Concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result 1
                  }
                }
                2
              ]
            ]
            procedure "Standard.Concurrent.all"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

