(test 1)
(name "a-struct-literal-written-with-a-name-refuses")
(note "A struct takes a name from a declared struct it is written into, a door it comes through or a cast, and never from a literal's text. A literal written `Ghost.T { x 1 }` would hold a value of a type nothing declares or imports, so it refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Any)
    (result (struct Ghost.T (field x 1)))))
(expect (refuses load))
