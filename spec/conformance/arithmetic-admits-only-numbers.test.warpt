warpt 1
{
  expect {
    refuses "build"
  }
  name "arithmetic-admits-only-numbers"
  note "plus declares one parameter for both sides, so two pieces of text agree, and agreement is not admission. Numeric admits a whole number and a fraction, and text is a reading the build can refuse."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              value "b"
            }
            of "a"
            procedure "std.math.plus"
          }
        }
      }
    }
    warp 1
  }
  test 2
}

