(test 1)
(name "a-type-parameter-named-for-a-type-the-language-names-refuses")
(note "A type parameter's name is one identifier and no word the language writes itself. `some Int` beside `Int` would read one spelling two ways, so the document refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter x (type (some Int)))
    (returns Any)
    (body
      (return x))))
(expect (refuses load))
