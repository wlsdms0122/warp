warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-held-at-a-slot-writing-its-own-answer-keeps-that-answer-through-a-type-parameter-answers"
  note "The closure writes `returns bank.A` and is held at `procedure() -> bank.A`, the answer it already gives. `app.run` takes `procedure() -> some T`, so `v` reads as `bank.A`, the call inside settles the record to `bank.A`, and `app.P.show` reaches `bank.A`'s witness."
  program {
    contracts {
      "app.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      "bank.A.show" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
                returns "bank.A"
              }
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "app.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "app.P.show"
          }
        }
      }
    }
    satisfies {
      "bank.A" [
        "app.P"
      ]
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

