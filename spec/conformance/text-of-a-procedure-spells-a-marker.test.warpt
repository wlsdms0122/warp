(test 1)
(name "text-of-a-procedure-spells-a-marker")
(note "A procedure has no spelling a document carries, so `text` of one answers the language's own marker, `<procedure>`, and never a host formatter's.")

(program
  (warp 1)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (result
      (call Standard.Text.text
        (closure
          (returns Int)
          (result 1))))))
(expect (answers "<procedure>"))
