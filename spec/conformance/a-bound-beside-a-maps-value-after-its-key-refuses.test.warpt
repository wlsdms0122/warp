warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bound-beside-a-maps-value-after-its-key-refuses"
  note "Inside one type the order is by role: a map names its key before its value, whichever way its mapping writes them. `K` is named at the key, so a bound beside the `some K` of the value refuses at the load."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "m"
            type {
              dictionary {
                key "some K"
                value "some K: Hashable"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

