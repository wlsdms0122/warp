warpt 1
{
  expect {
    refuses "load"
  }
  name "a-record-literal-written-with-a-name-refuses"
  note "A record takes a name from a declared record it is written into, a door it comes through or a cast, and never from a literal's text. A literal written `Ghost.T { x 1 }` would hold a value of a type nothing declares or imports, so it refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result Ghost.T {
          x 1
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

