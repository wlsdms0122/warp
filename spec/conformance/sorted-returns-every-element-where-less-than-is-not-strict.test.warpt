(test 1)
(name "sorted-returns-every-element-where-less-than-is-not-strict")
(note "`App.Score.lessThan` returns whether `lhs.v` is at most `rhs.v`, which is no strict order: a score is less than itself. `sorted` still returns every element once, so the three scores come back, here in order.")

(program
  (warp 1)
  (import Standard.Collection.map)
  (import Standard.Collection.sorted)
  (import Standard.Comparable)
  (import Standard.Comparable.lessThan)
  (import Standard.Logic.not)
  (struct App.Score
    (satisfies Standard.Comparable)
    (field v Int)
    (procedure lessThan
      (const)
      (isolated)
      (parameter lhs (type App.Score))
      (parameter rhs (type App.Score))
      (returns Bool)
      (body
        (return (call Standard.Logic.not (call Standard.Comparable.lessThan (path rhs (field v)) (path lhs (field v))))))))
  (procedure entry
    (access public)
    (const)
    (returns (array Int))
    (body
      (let scores (type (array App.Score)) (array (struct (field v 2)) (struct (field v 1)) (struct (field v 2))))
      (return
        (call Standard.Collection.map
          (call Standard.Collection.sorted scores)
          (closure
            (const)
            (isolated)
            (parameter s (type App.Score))
            (returns Int)
            (body
              (return (path s (field v))))))))))
(expect (answers (array 1 2 2)))
