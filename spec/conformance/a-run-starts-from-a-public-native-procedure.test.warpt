(test 1)
(name "a-run-starts-from-a-public-native-procedure")
(note "A run starts from any `public` declaration the host names, a native procedure included. Here `entry` is the host's, and the run returns what it returns.")

(vocabulary
  (procedure entry
    (access public)
    (isolated)
    (returns Int)
    (answers 5)))

(program
  (warp 1)
  (procedure other
    (returns Int)
    (body
      (return 1))))
(expect (answers 5))
