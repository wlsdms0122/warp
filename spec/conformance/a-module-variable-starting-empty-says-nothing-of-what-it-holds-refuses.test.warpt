warpt 1
{
  expect {
    refuses "build"
  }
  name "a-module-variable-starting-empty-says-nothing-of-what-it-holds-refuses"
  note "A module variable that declares no type holds the type of its start, and an empty dictionary holds no entry, so it says nothing of what the box will hold and no write fits it. A variable started empty declares what it holds, so the build refuses."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Collection.setting"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "a"
                  1
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "b"
                  2
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "seen"
              }
            ]
            procedure "Standard.Collection.keys"
          }
        }
        returns "Array<String>"
      }
    }
    var {
      seen {
        as {
          of {
            record {}
          }
          type "Dictionary<Int>"
        }
      }
    }
    warp 1
  }
  test 1
}

