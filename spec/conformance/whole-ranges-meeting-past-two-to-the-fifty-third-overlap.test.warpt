warpt 1
{
  arguments {
    x 9007199254740996
  }
  expect {
    answers 9007199254740996
  }
  name "whole-ranges-meeting-past-two-to-the-fifty-third-overlap"
  note "Two whole ranges are read as whole numbers. These share 9007199254740996, a number a fraction does not tell from its neighbour, so the cast between them is one some value satisfies and it builds."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "x"
            type "int(..<9007199254740997)"
          }
        ]
        result {
          as {
            of {
              ref "x"
            }
            type "int(9007199254740996...)"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

