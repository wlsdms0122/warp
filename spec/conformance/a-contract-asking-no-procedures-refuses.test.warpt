warpt 1
{
  expect {
    refuses "build"
  }
  name "a-contract-asking-no-procedures-refuses"
  note "A contract says which procedures a value answers. One asking none is answered by every type, so it says nothing, and the build refuses it."
  program {
    contracts {
      "App.Anything" {}
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

