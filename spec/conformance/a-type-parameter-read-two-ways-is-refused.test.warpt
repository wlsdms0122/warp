(test 1)
(name "a-type-parameter-read-two-ways-is-refused")
(note "A declaration's type parameter read as one thing by one argument and another by the next has no answer, and it refuses at the build.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure entry
    (access public)
    (parameter names (type (array String)))
    (returns (array String))
    (body
      (return (call Standard.Collection.appending names 1)))))
(expect (refuses build))
