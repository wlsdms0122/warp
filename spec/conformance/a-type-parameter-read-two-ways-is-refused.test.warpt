warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-parameter-read-two-ways-is-refused"
  note "A declaration's type parameter read as one thing by one argument and another by the next has no answer, and it refuses at the build."
  program {
    imports [
      "Standard.Collection.appending"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "names"
            type "array<string>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "names"
              }
              1
            ]
            procedure "Standard.Collection.appending"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

