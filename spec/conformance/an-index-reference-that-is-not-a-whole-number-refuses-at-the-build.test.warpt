warpt 1
{
  expect {
    refuses "build"
  }
  name "an-index-reference-that-is-not-a-whole-number-refuses-at-the-build"
  note "An index written as a reference is a path of its own, judged where the outer walk stops. One that provably is not a whole number is refused at the build."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "which"
            value "first"
          }
          {
            let "items"
            value [
              1
              2
            ]
          }
        ]
        result {
          ref "items[which]"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

