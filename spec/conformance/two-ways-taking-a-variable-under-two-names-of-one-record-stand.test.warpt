warpt 1
{
  arguments {
    ready true
  }
  expect {
    answers 1
  }
  name "two-ways-taking-a-variable-under-two-names-of-one-record-stand"
  note "`app.Spot` names `app.Point`, so the two name one declared record. One arm takes `n` while it reads `app.Spot`, and the other sets it to an `app.Point` and takes it there. They held the box to one type, and where they meet the build stands."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              as {
                of {
                  record {
                    x 1
                  }
                }
                type "app.Spot"
              }
            }
            var "n"
          }
          {
            value {
              conditional {
                else [
                  {
                    set "n"
                    value {
                      as {
                        of {
                          record {
                            x 2
                          }
                        }
                        type "app.Point"
                      }
                    }
                  }
                  {
                    let "b"
                    value {
                      closure {
                        result {
                          ref "n"
                        }
                      }
                    }
                  }
                ]
                then [
                  {
                    let "a"
                    value {
                      closure {
                        result {
                          ref "n"
                        }
                      }
                    }
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "ready"
            type "bool"
          }
        ]
        result 1
        returns "int"
      }
    }
    types {
      "app.Point" {
        record {
          x "int"
        }
      }
      "app.Spot" "app.Point"
    }
    warp 1
  }
  test 1
}

