warpt 1
{
  expect {
    refuses "build"
  }
  name "a-call-through-a-contract-with-nothing-first-refuses"
  note "A call through a contract is answered by the type of its first argument. A call writing nothing there has nothing to answer it, and the build says so."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "label"
              type "String"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
          {
            name "label"
            type "String"
          }
        ]
        result {
          ref "label"
        }
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    satisfies {
      "Bank.Account" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Account" {
        record {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

