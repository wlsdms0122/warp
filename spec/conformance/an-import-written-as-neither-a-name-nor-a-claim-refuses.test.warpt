(test 1)
(name "an-import-written-as-neither-a-name-nor-a-claim-refuses")
(note "An import is a name or a claim, written as the type and the contract it is about with a colon between. One spelling three parts refuses at the load.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (body
          (return "card")))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))
(tree (dictionary (entry "imports" (array "App.Describable.describe" "T.Card" "T.Card: App.Describable: App.Describable")) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "card") (entry "value" (dictionary (entry "as" (dictionary (entry "of" (dictionary (entry "struct" (dictionary (entry "rank" 1))))) (entry "type" "T.Card")))))) (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "call" (dictionary (entry "arguments" (array (dictionary (entry "ref" "card")))) (entry "procedure" "App.Describable.describe")))))))))) (entry "returns" "String"))))) (entry "warp" 1)))
(expect (refuses load))
