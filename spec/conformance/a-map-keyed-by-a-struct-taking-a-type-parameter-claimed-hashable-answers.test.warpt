warpt 1
{
  expect {
    answers 7
  }
  name "a-map-keyed-by-a-struct-taking-a-type-parameter-claimed-hashable-answers"
  note "A claim that `App.Box` answers `Hashable` is about every value of it, so `App.Box<Int>` keys a map."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "m"
            type "Dictionary<App.Box<Int>, Int>"
            value {
              dictionary [
                [
                  {
                    ref "b"
                  }
                  7
                ]
              ]
            }
          }
        ]
        result {
          ref "m[b]"
        }
        returns "Int?"
      }
    }
    satisfies {
      "App.Box" [
        "Hashable"
      ]
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

