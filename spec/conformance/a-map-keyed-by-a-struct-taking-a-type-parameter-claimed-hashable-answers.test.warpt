(test 1)
(name "a-map-keyed-by-a-struct-taking-a-type-parameter-claimed-hashable-answers")
(note "A claim that `App.Box` answers `Hashable` is about every value of it, so `App.Box<Int>` keys a map.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (satisfies Hashable)
    (field item (some T)))
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (let m (type (dictionary (named App.Box Int) Int)) (dictionary (entry b 7))))
    (result (path m (index b)))))
(expect (answers 7))
