(test 1)
(name "a-generic-body-hands-no-nullable-value-where-an-associated-type-is-asked-refuses")
(note "Inside `Use.putOr`, `C.Item` is one type the body does not know, so handing a value of `C.Item?` where `Lib.Bag.take` asks `Self.Item` refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Lib.Bag)
    (import Lib.Bag.take)
    (procedure Use.putOr
      (access public)
      (parameter c (type (some C Lib.Bag)))
      (parameter d (type (nullable (some C.Item))))
      (returns Int)
      (result (call Lib.Bag.take c d)))))

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses build))
