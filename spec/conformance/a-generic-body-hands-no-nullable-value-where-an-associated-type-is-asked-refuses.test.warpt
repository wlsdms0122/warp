    }
    {
      imports [
        "Lib.Bag"
        "Lib.Bag.take"
      ]
      procedures {
        "Use.putOr" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Bag"
            }
            {
              name "d"
              type "some C.Item?"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
                {
                  ref "d"
                }
              ]
              procedure "Lib.Bag.take"
            }
          }
          returns "Int"
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-generic-body-hands-no-nullable-value-where-an-associated-type-is-asked-refuses"
  note "Inside `Use.putOr`, `C.Item` is one type the body does not know, so handing a value of `C.Item?` where `Lib.Bag.take` asks `Self.Item` refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
