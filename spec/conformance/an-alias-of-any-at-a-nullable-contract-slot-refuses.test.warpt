(test 1)
(name "an-alias-of-any-at-a-nullable-contract-slot-refuses")
(note "A slot taking App.Shape or null asks the contract of whatever is not null, and a value read through an alias of Any is of a type the build does not know, so the call refuses at the build.")

(program
  (warp 1)
  (type App.Loose Any)
  (struct App.Point
    (satisfies App.Shape)
    (field x Int))
  (contract App.Shape)
  (procedure App.g
    (parameter p (type (nullable App.Shape)))
    (returns Int)
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let d (type App.Loose) 5))
    (result (call App.g d))))
(expect (refuses build))
