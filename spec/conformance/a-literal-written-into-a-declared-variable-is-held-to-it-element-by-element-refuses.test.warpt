warpt 1
{
  expect {
    refuses "build"
  }
  name "a-literal-written-into-a-declared-variable-is-held-to-it-element-by-element-refuses"
  note "ys declares array<int>, and [1, \"a\"] is written into it. The literal is held to the declaration element by element rather than as one reading of both, so the text refuses at the build."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "array<int>"
            value []
            var "ys"
          }
          {
            set "ys"
            value [
              1
              "a"
            ]
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                ]
                procedure "std.collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

