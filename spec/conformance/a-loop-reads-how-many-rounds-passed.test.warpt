warpt 1
{
  expect {
    answers 3
  }
  name "a-loop-reads-how-many-rounds-passed"
  note "The loop's own name binds the round it is on, and the condition reads it before the round runs."
  program {
    imports [
      "std.math.lessThan"
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "count"
          }
          {
            let "round"
            value {
              loop {
                body [
                  {
                    set "count"
                    value {
                      call {
                        arguments [
                          {
                            ref "count"
                          }
                          1
                        ]
                        procedure "std.math.plus"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "round.index"
                      }
                      3
                    ]
                    procedure "std.math.lessThan"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "count"
        }
      }
    }
    warp 1
  }
  test 1
}

