warpt 1
{
  expect {
    refuses "run"
  }
  name "a-variable-handed-back-in-place-is-judged-when-the-call-fails-refuses"
  note "App.put writes a value of Any into the list handed to it in place and then fails, and the caller rescues. The list is judged before the failure passes on, so the 5 in it refuses at the run rather than reaching the rescue."
  program {
    imports [
      "Standard.Collection.append"
      "Standard.Control.abort"
    ]
    procedures {
      "App.h" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
        ]
        result {
          ref "junk"
        }
        returns "some T"
      }
      "App.put" {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  {
                    call {
                      arguments [
                        {
                          ref "n"
                        }
                        {
                          ref "junk"
                        }
                      ]
                      procedure "App.h"
                    }
                  }
                ]
                procedure "Standard.Collection.append"
              }
            }
          }
          {
            value {
              conditional {
                then [
                  {
                    value {
                      call {
                        arguments [
                          "boom"
                        ]
                        procedure "Standard.Control.abort"
                      }
                    }
                  }
                ]
                when {
                  ref "stop"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
            type "Any"
          }
          {
            name "xs"
            type "inout Array<some T>"
          }
          {
            name "stop"
            type "Bool"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value [
              "a"
            ]
            var "s"
          }
          {
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          "b"
                          5
                          {
                            ref "s"
                          }
                          true
                        ]
                        procedure "App.put"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      value 0
                    }
                  ]
                }
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

