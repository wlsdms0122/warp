(test 1)
(name "any-written-optional-holds-a-null-as-its-some")
(note "`Any?` is a type, and a reading of `Any` where `Any?` is asked is its some. `a` holds `null` as `Any`, so `App.f` is handed its some, `Some` holding `null`.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (optional Any)))
    (returns Any)
    (body
      (return x)))
  (procedure entry
    (access public)
    (parameter a)
    (returns Any)
    (body
      (return (call App.f a)))))
(arguments (argument a null))
(expect (answers (struct Some (field wrapped null))))
