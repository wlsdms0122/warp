(test 1)
(name "a-contract-asking-no-procedures-is-answered-by-what-claims-it")
(note "A contract may ask no procedures. It is a mark a claim gives a type, and a type answers it where a document claims it does: a whole number stands where the mark is asked because `Int` is claimed for it.")

(program
  (warp 1)
  (contract App.Marked)
  (extension
    (head Int)
    (satisfies App.Marked))
  (procedure App.take
    (parameter it (type App.Marked))
    (returns Int)
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (result (call App.take 7))))
(expect (answers 1))
