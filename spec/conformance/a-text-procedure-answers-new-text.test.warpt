warpt 1
{
  expect {
    answers "HI"
  }
  name "a-text-procedure-answers-new-text"
  note "Text procedures answer a new string and touch nothing: trimming drops surrounding whitespace, casing rewrites the letters."
  program {
    imports [
      "Standard.Text.trimmed"
      "Standard.Text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "clean"
            value {
              call {
                arguments [
                  " hi "
                ]
                procedure "Standard.Text.trimmed"
              }
            }
          }
          {
            let "loud"
            value {
              call {
                arguments [
                  {
                    ref "clean"
                  }
                ]
                procedure "Standard.Text.uppercased"
              }
            }
          }
        ]
        result {
          ref "loud"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

