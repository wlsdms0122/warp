warpt 1
{
  expect {
    answers "HI"
  }
  name "a-text-procedure-answers-new-text"
  note "Text procedures answer a new string and touch nothing: trimming drops surrounding whitespace, casing rewrites the letters."
  program {
    imports [
      "std.text.trimmed"
      "std.text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "clean"
            value {
              call {
                of " hi "
                procedure "std.text.trimmed"
              }
            }
          }
          {
            let "loud"
            value {
              call {
                of {
                  ref "clean"
                }
                procedure "std.text.uppercased"
              }
            }
          }
        ]
        result {
          ref "loud"
        }
      }
    }
    warp 1
  }
  test 1
}

