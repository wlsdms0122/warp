warpt 1
{
  expect {
    answers {
      balance 1
    }
  }
  name "an-inline-record-slot-takes-a-named-record"
  note "An inline record declares no name, so it is structural: a named record fits it by type, and what settles there is built on the slot's own layout, which has no name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "Account"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
            ]
            procedure "pass"
          }
        }
        returns "Any"
      }
      pass {
        parameters [
          {
            name "record"
            type {
              record {
                balance "Int"
              }
            }
          }
        ]
        result {
          ref "record"
        }
        returns "Any"
      }
    }
    types {
      Account {
        record {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

