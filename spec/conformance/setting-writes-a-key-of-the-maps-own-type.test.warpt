warpt 1
{
  expect {
    answers {
      1 "a"
      2 "b"
      3 "c"
    }
  }
  name "setting-writes-a-key-of-the-maps-own-type"
  note "setting's key is of the map's own key type, so a map keyed by whole numbers takes a whole number there and answers with the entry made in the key order."
  program {
    imports [
      "Standard.Collection.setting"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    3
                    "c"
                  ]
                  [
                    1
                    "a"
                  ]
                ]
              }
              2
              "b"
            ]
            procedure "Standard.Collection.setting"
          }
        }
        returns "Dictionary<Int, String>"
      }
    }
    warp 1
  }
  test 1
}

