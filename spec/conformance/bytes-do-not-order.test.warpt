warpt 1
{
  expect {
    refuses "build"
  }
  name "bytes-do-not-order"
  note "bytes = array<byte>, and arrays do not order: numbers and strings answer Comparable, not collections. A literal is a reading the build can judge, so the refusal lands before the run."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              x"01"
              x"02"
            ]
            procedure "Standard.Comparable.lessThan"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

