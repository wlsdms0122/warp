warpt 1
{
  arguments {
    p {
      a 5
      b "s"
    }
  }
  expect {
    refuses "run"
  }
  name "an-entry-handed-a-record-of-two-types-at-a-type-parameter-no-bound-holds-refuses-at-the-door"
  note "`p` is a record type whose fields `a` and `b` are both `some T`, which no bound holds, and the host hands `{ a: 5, b: \"s\" }`. The door fits the map to the record type before the fields fill `T`, so `T` is read as `Int` and as `String`, as a call handing that record literal refuses at the build, and the run refuses at the door."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "p"
            type {
              record {
                a "some T"
                b "some T"
              }
            }
          }
        ]
        result [
          {
            ref "p.a"
          }
          {
            ref "p.b"
          }
        ]
        returns "Array<some T>"
      }
    }
    warp 1
  }
  test 1
}

