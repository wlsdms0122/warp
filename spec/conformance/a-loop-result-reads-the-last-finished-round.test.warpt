warpt 1
{
  expect {
    answers 2
  }
  name "a-loop-result-reads-the-last-finished-round"
  note "What a loop answers is its result read in what the last round that finished left behind; a round cut short contributed nothing."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "walked"
            value {
              loop {
                body [
                  {
                    let "tick"
                    value {
                      ref "walked.index"
                    }
                  }
                ]
                result {
                  ref "tick"
                }
                while {
                  call {
                    arguments [
                      {
                        ref "walked.index"
                      }
                      3
                    ]
                    procedure "Standard.Comparable.lessThan"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "walked"
        }
      }
    }
    warp 1
  }
  test 1
}

