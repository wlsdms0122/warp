(test 1)
(name "the-object-of-a-break-and-a-continue")
(note "A `break` and a `continue` carry how far they reach and then the loop each names, or nothing for the nearest.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let outer
        (loop
          (while true)
          (body
            (loop
              (while true)
              (body
                (break outer)))
            (continue))))
      (return 1))))
