(test 1)
(name "a-closure-writes-the-associated-type-of-the-procedure-around-it-answers")
(note "A closure in `Use.apply` takes `some C.Item`, which the procedure says is Int.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item)))))))
  (document
    (warp 1)
    (import Lib.Container)
    (import Lib.Container.first)
    (procedure Use.apply
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns Int)
      (failing (anything))
      (sameType C.Item Int)
      (body
        (let x (call Lib.Container.first c))
        (let f
          (closure
            (parameter y (type (some C.Item)))
            (returns (some C.Item))
            (body
              (return y))))
        (return (apply f x))))))

(program
  (warp 1)
  (import App.Box)
  (import Use.apply)
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (let x (call Use.apply b))
      (return x))))
(expect (answers 1))
