warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
        "Lib.Container.first"
      ]
      procedures {
        "Use.apply" {
          access "public"
          body [
            {
              let "x"
              value {
                call {
                  arguments [
                    {
                      ref "c"
                    }
                  ]
                  procedure "Lib.Container.first"
                }
              }
            }
            {
              let "f"
              value {
                closure {
                  parameters [
                    {
                      name "y"
                      type "some C.Item"
                    }
                  ]
                  result {
                    ref "y"
                  }
                  returns "some C.Item"
                }
              }
            }
          ]
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "x"
                }
              ]
              procedure {
                ref "f"
              }
            }
          }
          returns "Int"
          sameTypes {
            "C.Item" "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    answers 1
  }
  name "a-closure-writes-the-associated-type-of-the-procedure-around-it-answers"
  note "A closure in `Use.apply` takes `some C.Item`, which the procedure says is Int."
  program {
    imports [
      "App.Box"
      "Use.apply"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "x"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "Use.apply"
              }
            }
          }
        ]
        result {
          ref "x"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

