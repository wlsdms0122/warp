(test 1)
(name "a-rescue-reads-what-a-cast-refused")
(note "`cast_refused` is the one failure the runtime raises itself, so no procedure owns its `details` and this specification names them. `expected` is the type the cast reads as and `actual` is the type the value that arrived is an instance of: what was asked for is readable from the program, what turned up is not, and a rescue that reports or branches wants the second.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns (nullable (dictionary String Any)))
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (as payload Int))
          (rescue
            (set tried (dictionary (entry "actual" (path caught (field details) (index "actual"))) (entry "expected" (path caught (field details) (index "expected")))))))))
    (result tried)))
(arguments (argument payload "not a whole number"))
(expect (answers (dictionary (entry "actual" "String") (entry "expected" "Int"))))
