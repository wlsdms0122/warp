(test 1)
(name "the-object-of-a-struct-taking-a-type-parameter")
(note "A struct taking type parameters is written in `types` under tag 9 with its fields, then its type parameters in order and their bounds, and a declared name applying it to types writes them after the name, here `App.Box<some T>` as `[14, \"App.Box\", [[15, \"T\"]]]`.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure App.wrap
    (const)
    (isolated)
    (parameter x (type (some T)))
    (returns (named App.Box (some T)))
    (body
      (return (struct (field item x)))))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (call App.wrap 3))
      (return (path b (field item))))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)) (array 0 (array (array 0 0 "item" false))))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"b18ef9f0ba6b7022d5d39bf1f5be2b8115700c88e1da27e7afd580e7caab11e8")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 3 (array (array "App.Box" (array "item")) (array 0))) (array 13 0 (array) (array 1)) (array 0 0) (array 11 (array 0 (array (array 3)) (array))) (array 1 1) (array 13 0 (array) (array 5)))) (entry "rows" (array (array "App.wrap" (array (array (array "x" (array 1))) 3 (array 1 (array)) 1 1 (array) (array)) 1 (array 0 (array (array (array) 2 "[0]")) (array 1 (array 0) (array) (array) (array "x")))) (array "entry" (array (array) 4 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 4 "b") (array (array) 6 "[1]")) (array 1 (array) (array) (array) (array "b")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 15 "T") (array 15 "T") (array 15 "T") (array 14 "App.Box" (array 2)) (array 4))) (entry "types" (array (array "App.Box" (array 9 (array (array "item" 0)) (array "T") (array))))) (entry "valueTable" (array (array 2 3))) (entry "variables" (array)))))
