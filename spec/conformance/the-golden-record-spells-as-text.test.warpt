warpt 1
{
  expect {
    spells {
      a 1
      b [
        true
        null
      ]
      c "hi"
      d 1.5
      e x"6a73"
    }
  }
  name "the-golden-record-spells-as-text"
  note "The writer lays a text out one way: keys ascending, two spaces an indent, one element or field a line, and the text ending in one newline. This is that layout for the golden record, and a writer answering any other text for the value has a layout of its own."
  test 1
  text "warpt 1\n{\n  a 1\n  b [\n    true\n    null\n  ]\n  c \"hi\"\n  d 1.5\n  e x\"6a73\"\n}\n"
}

