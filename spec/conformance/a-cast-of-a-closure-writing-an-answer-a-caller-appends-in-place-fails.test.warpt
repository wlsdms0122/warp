(test 1)
(name "a-cast-of-a-closure-writing-an-answer-a-caller-appends-in-place-fails")
(note "App.put appends what App.h answers to the list handed to it in place. App.h's closure sets cell from its own some T and is cast from Any to take a number, which fails with cast_refused, since only App.h's call filled its T. Nothing is appended, and the attempt in the entry catches the failure.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (procedure App.h
    (parameter n (type (some T)))
    (parameter junk)
    (returns (some T))
    (failing (anything))
    (body
      (var cell n)
      (let c
        (closure
          (parameter y (type (some T)))
          (returns Int)
          (body
            (set cell y))
          (result 0)))
      (let a (type Any) c)
      (let w (as a (procedure (parameters Int) (returns Int))))
      (let z (apply w (as junk Int))))
    (result cell))
  (procedure App.put
    (parameter n (type (some T)))
    (parameter junk)
    (parameter xs (type (inout (array (some T)))))
    (returns Int)
    (failing (anything))
    (body
      (let got (call App.h n junk))
      (call Standard.Collection.append xs got))
    (result 0))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (var s (array "a"))
            (call App.put "b" 5 s)
            (set tried s))
          (rescue
            (set tried (path caught (field type)))))))
    (result tried)))
(expect (answers "cast_refused"))
