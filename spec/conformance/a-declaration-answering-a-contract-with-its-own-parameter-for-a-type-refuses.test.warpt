warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-its-own-parameter-for-a-type-refuses"
  note "The contract takes an int and answers a string. The declaration answering it takes some T there and answers some T, which the contract's Int fills, so it answers an int where the contract writes String."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "x"
              type "Int"
            }
          ]
          returns "String"
        }
      }
    }
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "d"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  1
                ]
                procedure "App.Describable.describe"
              }
            }
          }
          {
            let "u"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                ]
                procedure "Standard.Text.uppercased"
              }
            }
          }
        ]
        result {
          ref "u"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Card" {
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

