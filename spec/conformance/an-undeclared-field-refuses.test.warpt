warpt 1
{
  expect {
    refuses "build"
  }
  name "an-undeclared-field-refuses"
  note "A dot on a declared record reads a field, and a field the type does not declare is a defect the text shows. The type rules the field out, so no spelling reads past it, `?.` included."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "task"
            type {
              record {
                id "string"
              }
            }
          }
        ]
        result {
          ref "task.done"
        }
      }
    }
    warp 1
  }
  test 1
}

