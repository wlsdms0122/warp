warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-literal-handed-at-a-parameter-bounded-by-a-membership-is-read-part-by-part-refuses"
  note "`app.g` takes `some T` bounded by `app.M`, which admits `{ a: array<int> }` and `bool`. The call hands `{ a: [1, \"s\"] }`, whose field joins to `array<any>`. Read part by part, no member takes a string in `a`, so the build refuses."
  program {
    constraints {
      "app.M" [
        {
          record {
            a "array<int>"
          }
        }
        "bool"
      ]
    }
    imports []
    procedures {
      "app.g" {
        bounds {
          T "app.M"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      a [
                        1
                        "s"
                      ]
                    }
                  }
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

