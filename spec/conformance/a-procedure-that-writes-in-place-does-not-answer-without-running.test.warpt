(test 1)
(name "a-procedure-that-writes-in-place-does-not-answer-without-running")
(note "A parameter handed in place is the caller's box, so a body writing through one does not answer without running, and neither does a body that sends it. `Standard.Collection.append` writes through its parameter, and a closure declaring `const` that sends it refuses at the build, even on a variable of the closure's own.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (import Standard.Collection.count)
  (import Standard.Collection.map)
  (procedure entry
    (access public)
    (returns (array Int))
    (result
      (call Standard.Collection.map
        (array 1 2)
        (closure
          (const)
          (isolated)
          (parameter item (type Int))
          (returns Int)
          (body
            (var own (type (array Int)) (array))
            (call Standard.Collection.append own item))
          (result (call Standard.Collection.count own)))))))
(expect (refuses build))
