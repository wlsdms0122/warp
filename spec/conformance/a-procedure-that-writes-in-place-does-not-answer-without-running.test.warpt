warpt 1
{
  expect {
    refuses "build"
  }
  name "a-procedure-that-writes-in-place-does-not-answer-without-running"
  note "A parameter handed in place is the caller's box, so a body writing through one does not answer without running, and neither does a body that sends it. `std.collection.append` writes through its parameter, and a slot asking `const procedure` refuses a closure that sends it at the build, even on a variable of the closure's own."
  program {
    imports [
      "std.collection.append"
      "std.collection.count"
      "std.collection.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              value {
                closure {
                  body [
                    {
                      type "array<int>"
                      value []
                      var "own"
                    }
                    {
                      value {
                        call {
                          arguments {
                            value {
                              ref "item"
                            }
                          }
                          of {
                            ref "own"
                          }
                          procedure "std.collection.append"
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "item"
                      type "int"
                    }
                  ]
                  result {
                    call {
                      of {
                        ref "own"
                      }
                      procedure "std.collection.count"
                    }
                  }
                  returns "int"
                }
              }
            }
            of [
              1
              2
            ]
            procedure "std.collection.map"
          }
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

