warpt 1
{
  expect {
    refuses "build"
  }
  name "a-procedure-that-writes-in-place-does-not-answer-without-running"
  note "A parameter handed in place is the caller's box, so a body writing through one does not answer without running, and neither does a body that sends it. `Standard.Collection.append` writes through its parameter, and a slot asking `const procedure` refuses a closure that sends it at the build, even on a variable of the closure's own."
  program {
    imports [
      "Standard.Collection.append"
      "Standard.Collection.count"
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      type "array<int>"
                      value []
                      var "own"
                    }
                    {
                      value {
                        call {
                          arguments [
                            {
                              ref "own"
                            }
                            {
                              ref "item"
                            }
                          ]
                          procedure "Standard.Collection.append"
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "item"
                      type "int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "own"
                        }
                      ]
                      procedure "Standard.Collection.count"
                    }
                  }
                  returns "int"
                }
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

