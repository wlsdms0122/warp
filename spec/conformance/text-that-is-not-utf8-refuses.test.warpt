(test 1)
(name "text-that-is-not-utf8-refuses")
(note "A text is UTF-8 bytes before it is anything else. Bytes that are not are no text, so they are no document, and the reader says so rather than reading what it can.")
(text x"28776172702031290a28636f6e737420612022ff22290a")
(expect (refuses load))
