(test 1)
(name "a-contract-stands-in-a-closures-parameter")
(note "A contract's name stands where a type is written, a closure literal's parameter included. The slot takes a value of whatever type conforms to it, and the body calls the contract's procedure through the contract.")

(program
  (warp 1)
  (struct Bank.Card
    (satisfies App.Describable)
    (field last String)
    (procedure describe
      (parameter of (type Bank.Card))
      (returns String)
      (body
        (return "a card"))))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns String)
    (failing (anything))
    (body
      (let tell
        (closure
          (parameter it (type App.Describable))
          (returns String)
          (body
            (return (call App.Describable.describe it)))))
      (let card (as (struct (field last "42")) Bank.Card))
      (let applied (apply tell card))
      (return applied))))
(expect (answers "a card"))
