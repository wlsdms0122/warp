warpt 1
{
  expect {
    answers "a card"
  }
  name "a-contract-stands-in-a-closures-parameter"
  note "A contract's name stands where a type is written, a closure literal's parameter included. The slot takes a value of whatever type satisfies it, and the body calls the contract's procedure through the contract."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "tell"
            value {
              closure {
                parameters [
                  {
                    name "it"
                    type "App.Describable"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "it"
                      }
                    ]
                    procedure "App.Describable.describe"
                  }
                }
                returns "String"
              }
            }
          }
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "applied"
            value {
              call {
                arguments [
                  {
                    ref "card"
                  }
                ]
                procedure {
                  ref "tell"
                }
              }
            }
          }
        ]
        result {
          ref "applied"
        }
      }
    }
    types {
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

