warpt 1
{
  expect {
    answers "a card"
  }
  name "a-contract-stands-in-a-closures-parameter"
  note "A contract's name stands where a type is written, a closure literal's parameter included. The slot takes a value of whatever type satisfies it, and the body calls the contract's procedure through the contract."
  program {
    contracts {
      "app.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.Card.describe" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
        ]
        result "a card"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "tell"
            value {
              closure {
                parameters [
                  {
                    name "it"
                    type "app.Describable"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "it"
                      }
                    ]
                    procedure "app.Describable.describe"
                  }
                }
                returns "string"
              }
            }
          }
          {
            let "card"
            value {
              as "bank.Card"
              of {
                last "42"
              }
            }
          }
          {
            let "applied"
            value {
              apply {
                arguments [
                  {
                    ref "card"
                  }
                ]
                procedure {
                  ref "tell"
                }
              }
            }
          }
        ]
        result {
          ref "applied"
        }
      }
    }
    satisfies {
      "bank.Card" [
        "app.Describable"
      ]
    }
    types {
      "bank.Card" {
        last "string"
      }
    }
    warp 1
  }
  test 1
}

