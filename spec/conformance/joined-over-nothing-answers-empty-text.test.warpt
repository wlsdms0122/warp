(test 1)
(name "joined-over-nothing-answers-empty-text")
(note "`joined` over an array with nothing in it answers the empty text, whatever the separator: there is nothing to put between.")

(program
  (warp 1)
  (import Standard.Text.joined)
  (procedure entry
    (access public)
    (returns String)
    (result (call Standard.Text.joined (array) ", "))))
(expect (answers ""))
