(test 1)
(name "a-cast-of-a-struct-holding-a-closure-over-a-type-parameter-reads-the-struct-its-maker-filled")
(note "`App.wrap` builds a struct holding a closure its body wrote over `T`, and the call of it with 1 fills `T` with `Int`. The closure holds that, so read as `Any` and cast to `App.Fn<Int>` the struct is one, its closure a value of `(Int) -> Int`, and applying it to 7 answers 7.")

(documents
  (document
    (warp 1)
    (struct App.Fn
      (typeParameter T)
      (field run (procedure (parameters (some T)) (returns (some T)))))
    (procedure App.wrap
      (access public)
      (parameter x (type (some T)))
      (returns (named App.Fn (some T)))
      (body
        (return
          (struct
            (field run
              (closure
                (parameter y (type (some T)))
                (returns (some T))
                (body
                  (return y))))))))))

(program
  (warp 1)
  (import App.Fn)
  (import App.wrap)
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let a (type Any) (call App.wrap 1))
      (let b (as a (named App.Fn Int)))
      (return (apply (path b (field run)) 7)))))
(expect (answers 7))
