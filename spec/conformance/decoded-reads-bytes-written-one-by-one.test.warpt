warpt 1
{
  expect {
    answers "hi"
  }
  name "decoded-reads-bytes-written-one-by-one"
  note "The compact spelling is the value's own fact and not the slot's, so bytes written out one by one as whole numbers arrive at an `Array<Standard.Byte>` slot as the array they are, and a procedure the host answers reads them as the bytes they also are."
  program {
    imports [
      "Standard.Text.decoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                104
                105
              ]
              "utf8"
            ]
            procedure "Standard.Text.decoded"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

