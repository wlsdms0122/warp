(test 1)
(name "a-box-of-what-may-be-null-at-a-bounded-parameter-inside-it-refuses")
(note "A box of `Int?` handed where `App.Box<some T: Hashable>` is declared: `T` stands inside the box, not alone, so `Int?` does not fill it.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (procedure App.get
      (access public)
      (parameter b (type (named App.Box (some T Hashable))))
      (returns (some T))
      (result (path b (field item))))))

(program
  (warp 1)
  (import App.Box)
  (import App.get)
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (let b (type (named App.Box (nullable Int))) (struct (field item null))))
    (result (call App.get b))))
(expect (refuses build))
