warpt 1
{
  expect {
    refuses "run"
  }
  name "a-piece-arriving-through-any-is-held-to-the-slot-at-the-run"
  note "The elements of `pieces` join to `Any`, so the build reads nothing it could refuse and the array crosses into `Standard.Concurrent.all` the way any value crosses a slot through `Any`. At the run it is held to `Array<isolated Procedure>`, and an element that is not a closure refuses."
  program {
    imports [
      "Standard.Concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "pieces"
            value [
              {
                closure {
                  result 1
                }
              }
              1
            ]
          }
        ]
        result {
          call {
            arguments [
              {
                ref "pieces"
              }
            ]
            procedure "Standard.Concurrent.all"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

