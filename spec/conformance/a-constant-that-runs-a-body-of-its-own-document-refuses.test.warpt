warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-that-runs-a-body-of-its-own-document-refuses"
  note "A constant settles from the language's procedures and from bodies the link has already resolved. A body its own document declares is still being resolved beside the constants it may read, so a constant that runs one is a circle with no start, and is refused at the build."
  program {
    const {
      seven {
        call {
          procedure "helper"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          ref "seven"
        }
        returns "int"
      }
      helper {
        result 7
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

