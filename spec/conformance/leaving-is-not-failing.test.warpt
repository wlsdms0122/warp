(test 1)
(name "leaving-is-not-failing")
(note "A rescue is for what the world did; leaving is what the program said. The cast is what the attempt stands over, since a rescue over a body that cannot fail refuses; the return leaves past it either way.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns String)
    (body
      (var tried)
      (attempt
        (body
          (let checked (as null (nullable Int)))
          (return "left from inside"))
        (rescue
          (set tried "the rescue ran"))))
    (result tried)))
(expect (answers "left from inside"))
