warpt 1
{
  expect {
    answers "a card"
  }
  name "an-alias-of-a-contract-answers-the-contract"
  note "App.D names App.Describable, so a slot of App.D takes a value answering App.Describable, and a call through the contract takes it."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "1"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                ref "c"
              }
            ]
            procedure "show"
          }
        }
        returns "String"
      }
      show {
        body [
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "App.D"
          }
        ]
        result {
          ref "s"
        }
        returns "String"
      }
    }
    types {
      "App.D" "App.Describable"
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

