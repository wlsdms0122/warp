(test 1)
(name "an-alias-of-a-contract-answers-the-contract")
(note "App.D names App.Describable, so a slot of App.D takes a value answering App.Describable, and a call through the contract takes it.")

(program
  (warp 1)
  (type App.D App.Describable)
  (struct Bank.Card
    (satisfies App.Describable)
    (field last String)
    (procedure describe
      (parameter of (type Bank.Card))
      (returns String)
      (result "a card")))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "1")) Bank.Card)))
    (result (call show c)))
  (procedure show
    (parameter c (type App.D))
    (returns String)
    (body
      (let s (call App.Describable.describe c)))
    (result s)))
(expect (answers "a card"))
