warpt 1
{
  expect {
    answers "a card"
  }
  name "an-alias-of-a-contract-answers-the-contract"
  note "App.D names App.Describable, so a slot of App.D takes a value answering App.Describable, and a call through the contract takes it."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "1"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "c"
              }
            ]
            procedure "show"
          }
        }
      }
      show {
        body [
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "App.D"
          }
        ]
        result {
          ref "s"
        }
        returns "String"
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "App.D" "App.Describable"
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

