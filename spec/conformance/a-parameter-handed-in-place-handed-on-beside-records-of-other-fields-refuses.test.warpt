warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-handed-in-place-handed-on-beside-records-of-other-fields-refuses"
  note "App.g hands xs, a list of dictionaries of lists of T handed in place, on to App.put beside [{ a: [x] }, { b: [] }]. A call reads each argument as one type to fill U, and two records of other fields read as one only as any, so U is read as any beside the variable it takes in place, which refuses the way a reading of any handed beside one does. Written into xs directly, the literal is judged part by part and taken."
  program {
    imports []
    procedures {
      "App.g" {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  [
                    {
                      record {
                        a [
                          {
                            ref "x"
                          }
                        ]
                      }
                    }
                    {
                      record {
                        b []
                      }
                    }
                  ]
                ]
                procedure "App.put"
              }
            }
          }
        ]
        parameters [
          {
            name "xs"
            type "inout array<dictionary<array<some T>>>"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result 0
      }
      "App.put" {
        body [
          {
            set "a"
            value {
              ref "b"
            }
          }
        ]
        parameters [
          {
            name "a"
            type "inout some U"
          }
          {
            name "b"
            type "some U"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value {
              as {
                of [
                  {
                    record {
                      k [
                        "a"
                      ]
                    }
                  }
                ]
                type "array<dictionary<array<string>>>"
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  "b"
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

