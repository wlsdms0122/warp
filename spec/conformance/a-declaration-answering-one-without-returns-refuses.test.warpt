warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-one-without-returns-refuses"
  note "What a declaration answers is read off its body where nobody wrote `returns`, and the mark `linear` is not something a reading keeps, so a body whose result answers a value written `linear` writes `returns`."
  program {
    imports [
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                procedure "make"
              }
            }
          }
        ]
      }
      make {
        result {
          call {
            procedure "app.open"
          }
        }
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

