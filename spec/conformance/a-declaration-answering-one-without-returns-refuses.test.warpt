warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-one-without-returns-refuses"
  note "What a declaration answers is read off its body where nobody wrote `returns`, and the mark `linear` is not something a reading keeps, so a body whose result answers a value written `linear` writes `returns`. `entry` hands what it gets to `App.close`, so the missing `returns` is the one thing wrong."
  program {
    imports [
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                procedure "make"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "held"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
      make {
        result {
          call {
            procedure "App.open"
          }
        }
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

