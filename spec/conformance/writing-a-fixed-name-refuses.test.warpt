(test 1)
(name "writing-a-fixed-name-refuses")
(note "`let` fixes the name. Written once, never again. Writing it needs `var` to have introduced it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let x 1)
      (set x 2)
      (return x))))
(expect (refuses load))
