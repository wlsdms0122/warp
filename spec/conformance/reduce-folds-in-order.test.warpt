warpt 1
{
  expect {
    answers 6
  }
  name "reduce-folds-in-order"
  note "A walking procedure offers names. Reduce offers `carried` and `item`, and the closure's own parameters say which of the offer it reads."
  program {
    imports [
      "Standard.Collection.reduce"
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "total"
            value {
              call {
                arguments [
                  [
                    1
                    2
                    3
                  ]
                  0
                  {
                    closure {
                      parameters [
                        {
                          name "carried"
                          type "Int"
                        }
                        {
                          name "item"
                          type "Int"
                        }
                      ]
                      result {
                        call {
                          arguments [
                            {
                              ref "carried"
                            }
                            {
                              ref "item"
                            }
                          ]
                          procedure "Standard.Numeric.plus"
                        }
                      }
                      returns "Int"
                    }
                  }
                ]
                procedure "Standard.Collection.reduce"
              }
            }
          }
        ]
        result {
          ref "total"
        }
      }
    }
    warp 1
  }
  test 1
}

