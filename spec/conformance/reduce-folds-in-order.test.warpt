(test 1)
(name "reduce-folds-in-order")
(note "A walking procedure offers names. Reduce offers `carried` and `item`, and the closure's own parameters say which of the offer it reads.")

(program
  (warp 1)
  (import Standard.Collection.reduce)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (const)
    (returns Int)
    (body
      (let total
        (call Standard.Collection.reduce
          (array 1 2 3)
          0
          (closure
            (const)
            (isolated)
            (parameter carried (type Int))
            (parameter item (type Int))
            (returns Int)
            (result (call Standard.Numeric.plus carried item))))))
    (result total)))
(expect (answers 6))
