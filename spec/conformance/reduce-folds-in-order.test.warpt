warpt 1
{
  expect {
    answers 6
  }
  name "reduce-folds-in-order"
  note "A walking procedure offers names. Reduce offers `carried` and `item`, and the closure's own parameters say which of the offer it reads."
  program {
    imports [
      "std.collection.reduce"
      "std.math.plus"
    ]
    procedures {
      entry {
        body [
          {
            let "total"
            value {
              call {
                arguments {
                  from 0
                  value {
                    closure {
                      parameters {
                        carried {
                          type "int"
                        }
                        item {
                          type "int"
                        }
                      }
                      result {
                        call {
                          arguments {
                            value {
                              ref "item"
                            }
                          }
                          of {
                            ref "carried"
                          }
                          procedure "std.math.plus"
                        }
                      }
                      returns "int"
                    }
                  }
                }
                of [
                  1
                  2
                  3
                ]
                procedure "std.collection.reduce"
              }
            }
          }
        ]
        result {
          ref "total"
        }
      }
    }
    warp 1
  }
  test 2
}

