(test 1)
(name "a-struct-type-may-name-a-field-for-a-form")
(note "A struct type is written under `struct`, so its fields may be called anything, `array` included, which alone would be the form of a list.")

(program
  (warp 1)
  (struct App.Holder
    (field array Int))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let held (as (struct (field array 1)) App.Holder)))
    (result (path held (field array)))))
(expect (answers 1))
