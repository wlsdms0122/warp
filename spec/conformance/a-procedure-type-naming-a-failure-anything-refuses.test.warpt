(test 1)
(name "a-procedure-type-naming-a-failure-anything-refuses")
(note "The slot's type writes `throws(anything)`. Bare `throws` says any failure, and `anything` names none, so a procedure type listing it is refused where it is read.")

(program
  (warp 1)
  (procedure App.f
    (parameter p (type (procedure (parameters) (failing anything) (returns Int))))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return
        (call App.f
          (closure
            (returns Int)
            (body
              (return 1))))))))
(expect (refuses load))
