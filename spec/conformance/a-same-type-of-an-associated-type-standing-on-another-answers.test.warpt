warpt 1
{
  documents [
    {
      contracts {
        "Lib.Keyed" {
          procedures {
            key {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Key"
            }
          }
          types [
            "Key"
          ]
        }
        "Lib.Outer" {
          bounds {
            Item "Lib.Keyed"
          }
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      warp 1
    }
    {
      imports [
        "Lib.Keyed"
        "Lib.Outer"
      ]
      types {
        "App.Card" {
          procedures {
            key {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Card"
                }
              ]
              result {
                ref "of.k"
              }
              returns "Int"
            }
          }
          satisfies [
            "Lib.Keyed"
          ]
          struct {
            k "Int"
          }
          types {
            Key "Int"
          }
        }
        "App.Shelf" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Shelf"
                }
              ]
              result {
                ref "of.card"
              }
              returns "App.Card"
            }
          }
          satisfies [
            "Lib.Outer"
          ]
          struct {
            card "App.Card"
          }
          types {
            Item "App.Card"
          }
        }
      }
      warp 1
    }
    {
      imports [
        "Int.plus"
        "Lib.Keyed.key"
        "Lib.Outer"
        "Lib.Outer.first"
      ]
      procedures {
        "Use.keyPlus" {
          access "public"
          body [
            {
              let "x"
              value {
                call {
                  arguments [
                    {
                      ref "c"
                    }
                  ]
                  procedure "Lib.Outer.first"
                }
              }
            }
            {
              let "k"
              value {
                call {
                  arguments [
                    {
                      ref "x"
                    }
                  ]
                  procedure "Lib.Keyed.key"
                }
              }
            }
          ]
          bounds {
            C "Lib.Outer"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "k"
                }
                1
              ]
              procedure "Int.plus"
            }
          }
          returns "Int"
          sameTypes {
            "C.Item.Key" "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    answers 2
  }
  name "a-same-type-of-an-associated-type-standing-on-another-answers"
  note "`Use.keyPlus` says `C.Item.Key` is Int, so inside it the Key of what `Lib.Outer.first` answers is an Int, and a shelf, whose card gives Key as Int, fills C."
  program {
    imports [
      "App.Shelf"
      "Use.keyPlus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "s"
            type "App.Shelf"
            value {
              struct {
                card {
                  struct {
                    k 1
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "s"
              }
            ]
            procedure "Use.keyPlus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

