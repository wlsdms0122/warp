(test 1)
(name "a-rescue-binds-a-failure-the-language-declares")
(note "What a rescue binds is a `Failure`, a struct the language declares, so a slot that declares `Failure` takes it as it is and reads its fields.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure App.told
    (parameter failed (type Failure))
    (returns String)
    (result (path failed (field message))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let tried
        (attempt
          (body
            (call Standard.Control.abort "on purpose"))
          (rescue
            (result (call App.told tried))))))
    (result tried)))
(expect (answers "on purpose"))
