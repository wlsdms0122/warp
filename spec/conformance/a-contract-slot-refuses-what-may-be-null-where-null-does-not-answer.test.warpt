warpt 1
{
  expect {
    refuses "build"
  }
  name "a-contract-slot-refuses-what-may-be-null-where-null-does-not-answer"
  note "App.f takes App.Sized and is handed a variable declared Bank.Card?. A reading that may be null answers where both the type and `Null` do. Bank.Card answers App.Sized, and no document claims it for `Null`."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized"
          }
        ]
        result "took"
        returns "String"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type "Bank.Card?"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        struct {
          n "Int"
        }
      }
      "Bank.Card" {
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

