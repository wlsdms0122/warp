warpt 1
{
  expect {
    answers [
      {
        a []
      }
      {
        b [
          "b"
        ]
      }
    ]
  }
  name "a-parameter-handed-in-place-holding-dictionaries-of-lists-of-a-parameter-takes-records-of-other-fields"
  note "App.g writes [{ a: [] }, { b: [x] }] into xs, a list of dictionaries of lists of T handed in place, where x is its own some T. The literal is judged part by part, so the two records need not be one type: each is a dictionary of lists of T, and the caller reads both."
  program {
    imports []
    procedures {
      "App.g" {
        body [
          {
            set "xs"
            value [
              {
                record {
                  a []
                }
              }
              {
                record {
                  b [
                    {
                      ref "x"
                    }
                  ]
                }
              }
            ]
          }
        ]
        parameters [
          {
            name "xs"
            type "inout array<dictionary<array<some T>>>"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value {
              as {
                of [
                  {
                    record {
                      k [
                        "a"
                      ]
                    }
                  }
                ]
                type "array<dictionary<array<string>>>"
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  "b"
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

