(test 1)
(name "an-object-whose-types-name-each-other-refuses")
(note "A declared name that is no struct and comes back to itself through what it stands for spells no type. An object's types are held to that where the object is read, as a document's are at the load, so the build meets no such name.")
(object (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"f50a937cbfe4e51086079c4613d3da8c7c5e7d157229ede1bcc023127a317389")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0))) (entry "rows" (array (array "entry" (array (array) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array 0)) (array 0 (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 14 "App.B") (array 14 "App.A") (array 14 "App.A") (array 4))) (entry "types" (array (array "App.A" 0) (array "App.B" 1) (array "App.X" 2))) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
