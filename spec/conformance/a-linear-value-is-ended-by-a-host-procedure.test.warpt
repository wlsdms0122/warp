warpt 1
{
  expect {
    answers "f"
  }
  name "a-linear-value-is-ended-by-a-host-procedure"
  note "Only a procedure with no body ends the obligation, because what a resource is lives outside the document. The body reads the handle through a slot that borrows and then hands it to one that consumes."
  program {
    imports [
      "app.close"
      "app.name"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            let "shown"
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.name"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
        result {
          ref "shown"
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.name" {
        answers "f"
        parameters [
          {
            name "first"
            type "borrowing app.Handle"
          }
        ]
        returns "string"
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

