warpt 1
{
  expect {
    refuses "load"
  }
  name "constants-that-name-each-other-refuse"
  note "A constant may name another declared beside it, so the order they settle in is the order they read each other. Two that read each other have no such order and neither can be first, which the document's text alone shows, so it refuses at the load."
  program {
    const {
      ceiling {
        ref "floor"
      }
      floor {
        ref "ceiling"
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          ref "floor"
        }
      }
    }
    warp 1
  }
  test 1
}

