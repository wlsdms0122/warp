(test 1)
(name "a-cast-writes-a-whole-literal-it-reads-as-the-fraction-its-type-names-answers")
(note "The type a cast names is a place a literal in what it reads is written into, as a slot is. `[1]` read as `Array<Double>` holds the fraction `1` names, so the cast holds and answers `[1.0]`.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (array Double))
    (failing cast_refused)
    (result (as (array 1) (array Double)))))
(expect (answers (array 1.0)))
