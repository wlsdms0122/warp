(test 1)
(name "a-declaration-satisfying-a-contracts-procedure-with-any-where-it-asks-string-refuses")
(note "The contract returns String and the declaration satisfying it returns Any. A value read as `Any` is no String the build can see, so the declaration does not satisfy the contract and the build refuses.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (struct Bank.Card
    (satisfies App.Describable)
    (field last String)
    (procedure describe
      (parameter of (type Bank.Card))
      (returns Any)
      (body
        (return 5))))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns (array String))
    (failing cast_refused)
    (body
      (let c (as (struct (field last "42")) Bank.Card))
      (let d (call App.Describable.describe c))
      (let xs (call Standard.Collection.appending (array "a") d))
      (return xs))))
(expect (refuses build))
