warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "values-answer-in-canonical-order"
  note "values walks a map the one way a map can be walked: in its key order, text ascending, so the same map answers the same walk on every run."
  program {
    imports [
      "Standard.Collection.values"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    "a"
                    1
                  ]
                  [
                    "b"
                    2
                  ]
                ]
              }
            ]
            procedure "Standard.Collection.values"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

