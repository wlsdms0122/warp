(test 1)
(name "values-answer-in-canonical-order")
(note "values walks a map the one way a map can be walked: in its key order, text ascending, so the same map answers the same walk on every run.")

(program
  (warp 1)
  (import Standard.Collection.values)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call Standard.Collection.values (dictionary (entry "a" 1) (entry "b" 2)))))))
(expect (answers (array 1 2)))
