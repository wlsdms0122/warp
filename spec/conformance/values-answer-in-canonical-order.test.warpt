warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "values-answer-in-canonical-order"
  note "values walks a record the one way a record can be walked. Its canonical order, names ascending, so the same record answers the same walk on every run."
  program {
    imports [
      "Standard.Collection.values"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                record {
                  a 1
                  b 2
                }
              }
            ]
            procedure "Standard.Collection.values"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

