warpt 1
{
  expect {
    answers true
  }
  name "values-are-the-same-by-what-they-hold"
  note "A whole number and a fraction of the same worth are one value, two records holding the same fields bound to the same values are one value, and two arrays holding the same elements in the same order are one value."
  program {
    imports [
      "Standard.Logic.and"
      "Standard.Logic.equal"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result {
                      call {
                        arguments [
                          1
                          1.0
                        ]
                        procedure "Standard.Logic.equal"
                      }
                    }
                  }
                }
                {
                  closure {
                    result {
                      call {
                        arguments [
                          {
                            as {
                              of {
                                record {
                                  a 1
                                  b 2
                                }
                              }
                              type "App.P"
                            }
                          }
                          {
                            as {
                              of {
                                record {
                                  a 1
                                  b 2
                                }
                              }
                              type "App.P"
                            }
                          }
                        ]
                        procedure "Standard.Logic.equal"
                      }
                    }
                  }
                }
                {
                  closure {
                    result {
                      call {
                        arguments [
                          [
                            1
                            2
                          ]
                          [
                            1
                            2
                          ]
                        ]
                        procedure "Standard.Logic.equal"
                      }
                    }
                  }
                }
              ]
            ]
            procedure "Standard.Logic.and"
          }
        }
        returns "Bool"
      }
    }
    types {
      "App.P" {
        record {
          a "Int"
          b "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

