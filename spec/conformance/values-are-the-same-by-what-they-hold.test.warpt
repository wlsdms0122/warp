warpt 1
{
  expect {
    answers true
  }
  name "values-are-the-same-by-what-they-hold"
  note "A whole number and a fraction of the same worth are one value, two records holding the same fields bound to the same values are one value, and two arrays holding the same elements in the same order are one value."
  program {
    imports [
      "std.logic.and"
      "std.logic.equal"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result {
                      call {
                        arguments [
                          1
                          1.0
                        ]
                        procedure "std.logic.equal"
                      }
                    }
                  }
                }
                {
                  closure {
                    result {
                      call {
                        arguments [
                          {
                            record {
                              a 1
                              b 2
                            }
                          }
                          {
                            record {
                              a 1
                              b 2
                            }
                          }
                        ]
                        procedure "std.logic.equal"
                      }
                    }
                  }
                }
                {
                  closure {
                    result {
                      call {
                        arguments [
                          [
                            1
                            2
                          ]
                          [
                            1
                            2
                          ]
                        ]
                        procedure "std.logic.equal"
                      }
                    }
                  }
                }
              ]
            ]
            procedure "std.logic.and"
          }
        }
        returns "bool"
      }
    }
    warp 1
  }
  test 1
}

