(test 1)
(name "a-map-is-never-the-same-as-a-struct")
(note "A struct holds the name of the struct it is, and a map holds none: an `App.P` holding `1` in `x` and a map holding `1` under the text `\"x\"` are two values, so `equal` answers false.")

(program
  (warp 1)
  (import Standard.Logic.equal)
  (struct App.P
    (field x Int))
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (let point (type App.P) (struct (field x 1)))
      (let map (type (dictionary String Int)) (dictionary (entry "x" 1)))
      (return (call Standard.Logic.equal point map)))))
(expect (answers false))
