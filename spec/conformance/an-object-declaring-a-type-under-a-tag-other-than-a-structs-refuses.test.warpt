(test 1)
(name "an-object-declaring-a-type-under-a-tag-other-than-a-structs-refuses")
(note "A declared type is a struct, written under the struct's tag, or an alias, written as the number of the type it stands for. `App.P` written under the tag of an array is refused where the object is read.")
(object (dictionary (entry "addressTable" (array (array 0 (array)) (array 1 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"84b6a306832c969388cb5f602c49a5e789e0930beff954f3e3232e9330e85d9a")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 3 (array (array "App.P" (array "a" "b")) (array 0 1))) (array 1 1) (array 13 0 (array) (array 3)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 2) (array))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 0 1)) 2 "p") (array (array) 4 "[1]")) (array 2 (array 0) (array) (array) (array "n" "p")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4) (array 4) (array 14 "App.P"))) (entry "types" (array (array "App.P" (array 7 (array (array "a" 0) (array "b" 1)))))) (entry "valueTable" (array (array 2 2))) (entry "variables" (array))))
(expect (refuses load))
