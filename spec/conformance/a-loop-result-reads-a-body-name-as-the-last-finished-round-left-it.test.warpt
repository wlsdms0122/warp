warpt 1
{
  arguments {
    again true
    leave true
  }
  expect {
    refuses "build"
  }
  name "a-loop-result-reads-a-body-name-as-the-last-finished-round-left-it"
  note "A round declares `y` as an int and may break before it sets `y` to a string. A round cut short contributes nothing to what the result reads, so the result reads `y` as the string the last finished round left, or null where none finished, and handing it to a slot that takes an int refuses at the build."
  program {
    imports []
    procedures {
      "App.wants" {
        parameters [
          {
            name "count"
            type "int"
          }
        ]
        result {
          ref "count"
        }
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "kept"
            value {
              loop {
                body [
                  {
                    value 1
                    var "y"
                  }
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              break null
                            }
                          }
                        ]
                        when {
                          ref "leave"
                        }
                      }
                    }
                  }
                  {
                    set "y"
                    value "s"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "y"
                      }
                    ]
                    procedure "App.wants"
                  }
                }
                while {
                  ref "again"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "again"
            type "bool"
          }
          {
            name "leave"
            type "bool"
          }
        ]
        result {
          ref "kept"
        }
      }
    }
    warp 1
  }
  test 1
}

