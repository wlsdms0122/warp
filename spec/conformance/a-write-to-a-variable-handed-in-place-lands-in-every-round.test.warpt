(test 1)
(name "a-write-to-a-variable-handed-in-place-lands-in-every-round")
(note "Each round writes an int into a variable that started null and hands it in place to an Int slot. The write lands in every round, so the variable reads Int where it is handed, in the first round and in every one after.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (import Standard.Numeric.plus)
  (procedure App.bump
    (parameter c (type (inout Int)))
    (returns Int)
    (body
      (set c (call Standard.Numeric.plus c 1))
      (return 0)))
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (var x)
      (var i 0)
      (let w
        (loop
          (while (call Standard.Comparable.lessThan i 2))
          (body
            (set x 1)
            (call App.bump x)
            (set i (call Standard.Numeric.plus i 1)))))
      (return x))))
(expect (answers 2))
