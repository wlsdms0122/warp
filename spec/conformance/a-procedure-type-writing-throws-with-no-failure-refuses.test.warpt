(test 1)
(name "a-procedure-type-writing-throws-with-no-failure-refuses")
(note "`throws()` lists no failure, which says what writing no `throws` says, and one type is written one way, so this refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (type (procedure (parameters Int) (failing) (returns Int)))
        (closure
          (parameter x (type Int))
          (returns Int)
          (result x))))
    (result 1)))
(expect (refuses load))
