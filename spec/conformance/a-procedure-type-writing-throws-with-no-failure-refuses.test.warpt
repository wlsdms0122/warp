warpt 1
{
  expect {
    refuses "load"
  }
  name "a-procedure-type-writing-throws-with-no-failure-refuses"
  note "`throws()` lists no failure. A procedure type failing with nothing writes no `throws`, so this refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            type "(Int) throws() -> Int"
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "Int"
                  }
                ]
                result {
                  ref "x"
                }
                returns "Int"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

