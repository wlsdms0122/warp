warpt 1
{
  expect {
    refuses "build"
  }
  name "a-variable-a-closure-captured-is-not-retyped-after"
  note "A variable a closure captured holds the type it read as there from the capture on, since the closure writes the box as that type when it is called. Writing a string into the Int it was captured as refuses at the build."
  program {
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "n"
          }
          {
            let "w"
            value {
              closure {
                body [
                  {
                    set "n"
                    value 99
                  }
                ]
              }
            }
          }
          {
            set "n"
            value "s"
          }
          {
            value {
              call {
                procedure {
                  ref "w"
                }
              }
            }
          }
          {
            let "u"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure "Standard.Text.uppercased"
              }
            }
          }
        ]
        failing "anything"
        result {
          ref "u"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

