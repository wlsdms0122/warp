warpt 1
{
  expect {
    answers null
  }
  name "a-cast-to-a-contract-of-a-value-the-head-of-its-claim-does-not-take-answers-null"
  note "A box of App.Plain read as `Any` is not taken by `App.Box<some T: Hashable>`, so the box answers no App.Describable and the cast answers null."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      "App.Box<some T: Hashable>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Box<some T>"
              }
            ]
            result "box"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "two"
            type "Any"
            value {
              as {
                of {
                  struct {
                    item {
                      struct {
                        x 1
                      }
                    }
                  }
                }
                type "App.Box<App.Plain>"
              }
            }
          }
        ]
        result {
          "as?" {
            of {
              ref "two"
            }
            type "App.Describable"
          }
        }
        returns "App.Describable?"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
      "App.Plain" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

