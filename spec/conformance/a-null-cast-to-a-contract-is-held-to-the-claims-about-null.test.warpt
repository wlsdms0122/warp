warpt 1
{
  arguments {
    absent null
  }
  expect {
    answers "nothing"
  }
  name "a-null-cast-to-a-contract-is-held-to-the-claims-about-null"
  note "The cast reads `absent`, which holds null, as `App.Described`, and the run holds what arrived to the contract by the type it is an instance of. A document claims the contract for `Null`, so the cast holds, the value fills `some T` as a reading of the contract, and `App.tell` answers."
  program {
    contracts {
      "App.Described" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        bounds {
          T "App.Described"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Described.describe"
          }
        }
        returns "String"
      }
      "Null.describe" {
        parameters [
          {
            name "of"
            type "Null"
          }
        ]
        result "nothing"
        returns "String"
      }
      entry {
        access "public"
        parameters [
          {
            name "absent"
            type "Any"
          }
        ]
        result {
          call {
            arguments [
              {
                as {
                  of {
                    ref "absent"
                  }
                  type "App.Described"
                }
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    satisfies {
      Null [
        "App.Described"
      ]
    }
    warp 1
  }
  test 1
}

