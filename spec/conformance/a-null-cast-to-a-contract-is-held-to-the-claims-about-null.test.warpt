(test 1)
(name "a-null-cast-to-a-contract-is-held-to-the-claims-about-null")
(note "The cast reads `absent`, which holds null, as `App.Described`, and the run holds what arrived to the contract by the type it is an instance of. A document claims the contract for `Null`, so the cast holds, the value fills `some T` as a reading of the contract, and `App.tell` returns.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Null)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Null))
      (returns String)
      (body
        (return "nothing"))))
  (procedure App.tell
    (parameter it (type (some T App.Described)))
    (returns String)
    (body
      (return (call App.Described.describe it))))
  (procedure entry
    (access public)
    (parameter absent)
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.tell (as absent App.Described))))))
(arguments (argument absent null))
(expect (answers "nothing"))
