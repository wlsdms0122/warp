(test 1)
(name "a-name-introduced-again-in-a-nested-body-is-a-new-name")
(note "A body inside another may introduce a name the one around it introduced. Inside, the name is the new one; outside, the old one keeps its value.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (body
      (let x 1)
      (var y 0)
      (conditional
        (when true)
        (then
          (let x 2)
          (set y x))))
    (result (dictionary (entry "inner" y) (entry "outer" x)))))
(expect (answers (dictionary (entry "inner" 2) (entry "outer" 1))))
