warpt 1
{
  expect {
    refuses "run"
  }
  name "floored-past-the-word-refuses"
  note "floored and rounded answer an int, and a fraction whose whole part is past the machine word has no int to answer. The refusal is the overflow rule, the same one arithmetic holds at the word's edge."
  program {
    imports [
      "std.math.floored"
    ]
    procedures {
      entry {
        result {
          call {
            of 1e+30
            procedure "std.math.floored"
          }
        }
      }
    }
    warp 2
  }
  test 1
}
