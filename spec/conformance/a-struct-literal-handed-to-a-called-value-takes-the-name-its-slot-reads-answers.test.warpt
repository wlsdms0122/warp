(test 1)
(name "a-struct-literal-handed-to-a-called-value-takes-the-name-its-slot-reads-answers")
(note "`g` is held at `(App.Point) -> Any`, and its closure takes `Any` and reads what it is handed `as? App.X`, a struct of the same field under another name. The struct literal a call of `g` hands is written where `App.Point` is read, so it arrives an `App.Point`, which is no `App.X`, and the asking cast reads null.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (struct App.X
    (field x Int))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let g
        (type (procedure (parameters App.Point) (returns Any)))
        (closure
          (parameter p)
          (returns Any)
          (result (as? p App.X)))))
    (result (apply g (struct (field x 1))))))
(expect (answers null))
