warpt 1
{
  expect {
    answers App.Point {
      x 1
    }
  }
  name "a-cast-of-a-nameless-record-to-a-declared-record-of-its-fields-names-it-answers"
  note "`v` is read as the nameless record `{ x: Int }`, not as `Any`. A cast to `App.Point` names a type a value of that reading may turn out to be, and writes the name onto the nameless record of its fields."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              record {
                x 1
              }
            }
          }
        ]
        result {
          as {
            of {
              ref "v"
            }
            type "App.Point"
          }
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

