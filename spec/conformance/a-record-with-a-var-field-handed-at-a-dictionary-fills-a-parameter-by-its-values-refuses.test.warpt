warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-with-a-var-field-handed-at-a-dictionary-fills-a-parameter-by-its-values-refuses"
  note "`App.Box` declares `var a: Int` and `b: Int?`. `App.f` answers the `Dictionary<some T>` it takes. Handed a box, the record is read as a dictionary by its fields' values, the `var` off, joined part by part, so `T` reads `Int?` and the answer does not fit the name declaring `Dictionary<Int>`, which refuses at the build."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "d"
            type "Dictionary<some T>"
          }
        ]
        result {
          ref "d"
        }
        returns "Dictionary<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box"
            value {
              record {
                a 1
                b null
              }
            }
          }
          {
            let "r"
            type "Dictionary<Int>"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result 0
      }
    }
    types {
      "App.Box" {
        record {
          a "var Int"
          b "Int?"
        }
      }
    }
    warp 1
  }
  test 1
}

