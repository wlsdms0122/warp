warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-with-a-var-field-handed-at-a-dictionary-fills-a-parameter-by-its-values-refuses"
  note "`App.Box` declares `var a: int` and `b: int?`. `App.f` bounds `T` by `App.M`, which admits `int?` and `string`, and answers the `dictionary<some T>` it takes. Handed a box, the record is read as a dictionary by its fields' values, the `var` off, joined part by part, so `T` reads `int?` and the answer does not fit the name declaring `dictionary<int>`, which refuses at the build."
  program {
    constraints {
      "App.M" [
        "int?"
        "string"
      ]
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "d"
            type "dictionary<some T>"
          }
        ]
        result {
          ref "d"
        }
        returns "dictionary<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box"
            value {
              record {
                a 1
                b null
              }
            }
          }
          {
            let "r"
            type "dictionary<int>"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result 0
      }
    }
    types {
      "App.Box" {
        record {
          a "var int"
          b "int?"
        }
      }
    }
    warp 1
  }
  test 1
}

