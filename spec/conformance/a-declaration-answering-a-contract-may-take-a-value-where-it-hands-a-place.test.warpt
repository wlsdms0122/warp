warpt 1
{
  expect {
    answers 9
  }
  name "a-declaration-answering-a-contract-may-take-a-value-where-it-hands-a-place"
  note "The contract takes inout Int and the declaration answering it takes an int. A position taking a value may stand where a place is handed, the way a closure's may, and reads what the variable holds, which the call leaves as it was."
  program {
    contracts {
      "App.Sized" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "n"
                type "inout Int"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            value 4
            var "k"
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  {
                    ref "k"
                  }
                ]
                procedure "App.Sized.size"
              }
            }
          }
          {
            let "t"
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  {
                    ref "k"
                  }
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          ref "t"
        }
        returns "Int"
      }
    }
    types {
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
              {
                name "n"
                type "Int"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "n"
                  }
                  1
                ]
                procedure "Standard.Numeric.plus"
              }
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Sized"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

