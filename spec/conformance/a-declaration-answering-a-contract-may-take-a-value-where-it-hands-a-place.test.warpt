(test 1)
(name "a-declaration-answering-a-contract-may-take-a-value-where-it-hands-a-place")
(note "The contract takes inout Int and the declaration answering it takes an int. A position taking a value may stand where a place is handed, the way a closure's may, and reads what the variable holds, which the call leaves as it was.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (parameter n (type Int))
      (returns Int)
      (body
        (return (call Standard.Numeric.plus n 1)))))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (parameter n (type (inout Int)))
      (returns Int)))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "42")) Bank.Card))
      (var k 4)
      (let s (call App.Sized.size c k))
      (let t (call Standard.Numeric.plus s k))
      (return t))))
(expect (answers 9))
