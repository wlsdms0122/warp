warpt 1
{
  expect {
    answers "zulu"
  }
  name "a-calls-arguments-are-evaluated-in-the-callees-parameter-order"
  note "A call's arguments are evaluated in the order the callee's declaration wrote its parameters, whatever order the call writes them in and whatever order their names sort in. Two arguments that would each fail surface the one whose parameter stands first: here `zulu`, which the declaration writes before `alpha`."
  program {
    imports [
      "std.control.abort"
    ]
    procedures {
      "app.pair" {
        parameters [
          {
            name "zulu"
            type "string"
          }
          {
            name "alpha"
            type "string"
          }
        ]
        result {
          ref "zulu"
        }
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "paired"
                    value {
                      call {
                        arguments {
                          alpha {
                            call {
                              of "alpha"
                              procedure "std.control.abort"
                            }
                          }
                          zulu {
                            call {
                              of "zulu"
                              procedure "std.control.abort"
                            }
                          }
                        }
                        procedure "app.pair"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "tried.message"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

