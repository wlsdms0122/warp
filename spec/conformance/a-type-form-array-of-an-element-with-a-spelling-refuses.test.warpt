warpt 1
{
  expect {
    refuses "load"
  }
  name "a-type-form-array-of-an-element-with-a-spelling-refuses"
  note "`{ array: <type> }` is the form for an element that has no string spelling, a procedure type that writes its signature. An element that has one is written `Array<T>`, and the form around it is not a second spelling of that type, so it is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "items"
            type {
              array "String"
            }
          }
        ]
        result {
          ref "items"
        }
      }
    }
    warp 1
  }
  test 1
}

