warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-that-misses-a-procedure-does-not-answer-the-contract"
  note "A claim missing a procedure the contract asks puts its type under no contract. `Bank.Plain` is claimed for `App.Describable` and nothing declares `Bank.Plain.describe`, so the call leaning on the pair refuses at the build."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        bounds {
          T "App.Describable"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "string"
      }
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
        ]
        result "an account"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "plain"
            value {
              as {
                of {
                  record {
                    note "x"
                  }
                }
                type "Bank.Plain"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "plain"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "Bank.Account" [
        "App.Describable"
      ]
      "Bank.Plain" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Account" {
        record {
          balance "int"
        }
      }
      "Bank.Plain" {
        record {
          note "string"
        }
      }
    }
    warp 1
  }
  test 1
}

