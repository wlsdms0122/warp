warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-that-misses-a-procedure-does-not-answer-the-contract"
  note "A claim missing a procedure the contract asks puts its type under no contract. `Bank.Plain` is claimed for `App.Describable` and nothing declares `Bank.Plain.describe`, so the claim refuses at the build, at the claim."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        bounds {
          T "App.Describable"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "plain"
            value {
              as {
                of {
                  struct {
                    note "x"
                  }
                }
                type "Bank.Plain"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "plain"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.Account" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Account"
              }
            ]
            result "an account"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          balance "Int"
        }
      }
      "Bank.Plain" {
        satisfies [
          "App.Describable"
        ]
        struct {
          note "String"
        }
      }
    }
    warp 1
  }
  test 1
}

