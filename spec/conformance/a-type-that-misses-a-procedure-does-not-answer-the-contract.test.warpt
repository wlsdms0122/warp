warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-that-misses-a-procedure-does-not-answer-the-contract"
  note "What puts a type under a contract is a document saying so under `satisfies`. A type no document claims does not stand where the contract bounds a parameter, and the link says so where the value is handed over."
  program {
    contracts {
      "app.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.tell" {
        bounds {
          T "app.Describable"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
      "bank.Account.describe" {
        parameters [
          {
            name "of"
            type "bank.Account"
          }
        ]
        result "an account"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "plain"
            value {
              as "bank.Plain"
              of {
                note "x"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "plain"
              }
            ]
            procedure "app.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "bank.Account" [
        "app.Describable"
      ]
    }
    types {
      "bank.Account" {
        balance "int"
      }
      "bank.Plain" {
        note "string"
      }
    }
    warp 1
  }
  test 1
}

