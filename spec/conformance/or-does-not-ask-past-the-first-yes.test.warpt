(test 1)
(name "or-does-not-ask-past-the-first-yes")
(note "or reads its sides in order and stops at the first yes. The later sides are procedures precisely so they are not evaluated once the result is known: the second reads past the end of a list holding nothing, which would refuse the run, and the result shows it was never asked.")

(program
  (warp 1)
  (import Standard.Logic.or)
  (procedure entry
    (access public)
    (const)
    (returns Bool)
    (body
      (let flags (type (array Bool)) (array))
      (return
        (call Standard.Logic.or
          (array
            (closure
              (const)
              (isolated)
              (returns Bool)
              (body
                (return true)))
            (closure
              (const)
              (isolated)
              (returns Bool)
              (body
                (return (path flags (index 0)))))))))))
(expect (answers true))
