warpt 1
{
  expect {
    answers true
  }
  name "or-does-not-ask-past-the-first-yes"
  note "or reads its sides in order and stops at the first yes. The later sides are procedures precisely so they are not evaluated once the answer is known."
  program {
    imports [
      "Standard.Control.abort"
      "Standard.Logic.or"
    ]
    procedures {
      entry {
        access "public"
        const true
        failing "anything"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    const true
                    isolated true
                    result true
                    returns "Bool"
                  }
                }
                {
                  closure {
                    const true
                    failing [
                      "aborted"
                    ]
                    isolated true
                    result {
                      call {
                        arguments [
                          "never asked"
                        ]
                        procedure "Standard.Control.abort"
                      }
                    }
                    returns "Bool"
                  }
                }
              ]
            ]
            procedure "Standard.Logic.or"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

