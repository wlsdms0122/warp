(test 1)
(name "a-closures-parameter-is-not-the-const-procedure-it-shadows")
(note "A closure's parameter is its own name, whatever a name of the same spelling outside it holds. A closure calling a parameter whose slot writes a procedure type without `const` does not answer without running, even where an outer name of that spelling is a `const` procedure type, so a slot asking a `const` procedure type refuses it at the build.")

(program
  (warp 1)
  (procedure asking
    (parameter body (type (procedure (const) (parameters (procedure (parameters Int) (returns Int))) (returns Int))))
    (returns Int)
    (body
      (let given
        (closure
          (parameter x (type Int))
          (returns Int)
          (result x)))
      (let answered (apply body given)))
    (result answered))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (type (procedure (const) (parameters Int) (returns Int)))
        (closure
          (parameter x (type Int))
          (returns Int)
          (result x)))
      (let g
        (closure
          (parameter f (type (procedure (parameters Int) (returns Int))))
          (returns Int)
          (body
            (let y (apply f 1)))
          (result y))))
    (result (call asking g))))
(expect (refuses build))
