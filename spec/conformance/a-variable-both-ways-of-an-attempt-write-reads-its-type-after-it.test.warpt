(test 1)
(name "a-variable-both-ways-of-an-attempt-write-reads-its-type-after-it")
(note "An attempt's body and its rescue are its two ways, and a write both make is unconditional the way one both arms of a conditional make is. `kept` starts null, the body writes it an int and the rescue writes it an int, so after the attempt it reads `Int` and a slot declared `Int` takes it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns Int)
    (body
      (var kept)
      (attempt
        (body
          (let read (as payload Int))
          (set kept read))
        (rescue
          (set kept 0)))
      (let said (call wants kept))
      (return said)))
  (procedure wants
    (parameter it (type Int))
    (returns Int)
    (body
      (return it))))
(arguments (argument payload "not a whole number"))
(expect (answers 0))
