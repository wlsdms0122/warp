(test 1)
(name "an-empty-map-literal-is-a-map-of-any-types")
(note "An empty map literal holds `Never` at its keys and its values, so it is a value of a map of any key and value type: here one keyed by whole numbers, which the language claims `Hashable` for.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let m (type (dictionary Int (array String))) (dictionary))
      (return (call Standard.Collection.count m)))))
(expect (answers 0))
