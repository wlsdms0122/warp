(test 1)
(name "a-list-holding-no-byte-handed-to-decoded-refuses-at-the-run")
(note "Bytes are whole numbers from 0 to 255, and `decoded` says what it takes when it runs, whatever wrote the argument: `300` is no byte, so the call refuses at the run.")

(program
  (warp 1)
  (import Standard.Text.decoded)
  (procedure entry
    (access public)
    (returns String)
    (result (call Standard.Text.decoded (array 104 300) "utf8"))))
(expect (refuses run))
