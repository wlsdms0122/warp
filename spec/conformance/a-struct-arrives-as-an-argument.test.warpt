(test 1)
(name "a-struct-arrives-as-an-argument")
(note "A struct written into the arguments under a name arrives carrying it, and fits the slot that declares that name.")

(program
  (warp 1)
  (struct Account
    (field balance Int))
  (procedure entry
    (access public)
    (parameter account (type Account))
    (returns Int)
    (body
      (return (path account (field balance))))))
(arguments (argument account (struct Account (field balance 3))))
(expect (answers 3))
