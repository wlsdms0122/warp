warpt 1
{
  arguments {
    account Account {
      balance 3
    }
  }
  expect {
    answers 3
  }
  name "a-struct-arrives-as-an-argument"
  note "A struct written into the arguments under a name arrives carrying it, and fits the slot that declares that name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "account"
            type "Account"
          }
        ]
        result {
          ref "account.balance"
        }
        returns "Int"
      }
    }
    types {
      Account {
        struct {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

