warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-linear-value-as-any-refuses"
  note "`App.f` answers a handle and declares it answers `Any`. A caller holds what it answers as `Any`, which hands nothing on, so the obligation would be held by nobody."
  program {
    imports []
    procedures {
      "App.f" {
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
        ]
        result {
          ref "h"
        }
        returns "Any"
      }
      entry {
        access "public"
        body [
          {
            let "y"
            value {
              call {
                procedure "App.f"
              }
            }
          }
        ]
        result 1
        returns "Any"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

