warpt 1
{
  expect {
    answers 1
  }
  name "a-cast-of-a-closure-held-at-a-contract-slot-back-to-the-number-it-answers-answers"
  note "`c` is declared `() -> Int`, so its closure answers `Int`, and holding it at `() -> Standard.Numeric`, which `Int` answers, hands it on as it is. The cast back to `() -> Int` takes the closure."
  program {
    imports [
      "Standard.Numeric"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "() -> Int"
            value {
              closure {
                result 1
                returns "Int"
              }
            }
          }
          {
            let "j"
            type "() -> Standard.Numeric"
            value {
              ref "c"
            }
          }
          {
            let "e"
            value {
              as {
                of {
                  ref "j"
                }
                type "() -> Int"
              }
            }
          }
        ]
        failing "anything"
        result {
          call {
            procedure {
              ref "e"
            }
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

