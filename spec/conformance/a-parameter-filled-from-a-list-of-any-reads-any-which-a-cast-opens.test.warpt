(test 1)
(name "a-parameter-filled-from-a-list-of-any-reads-any-which-a-cast-opens")
(note "App.pick fills E from [\"a\"] and from [j], j read as Any. E reads Array<Any> rather than Array<String>, so first of the answer reads Any, and a cast to Int opens it, which a reading of String never could. `Standard.Numeric.plus` takes the Int, and the run answers 2.")

(program
  (warp 1)
  (import Standard.Collection.first)
  (import Standard.Numeric.plus)
  (procedure App.pick
    (parameter a (type (some E)))
    (parameter b (type (some E)))
    (returns (some E))
    (body
      (return b)))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let j (type Any) 1)
      (let r (call App.pick (array "a") (array j)))
      (let q (call Standard.Numeric.plus (as (call Standard.Collection.first r) Int) 1))
      (return q))))
(expect (answers 2))
