warpt 1
{
  arguments {
    level -0.0
  }
  expect {
    answers -0.0
  }
  name "a-candidate-meets-a-number-by-worth"
  note "An argument meets the candidates by worth. The two zeros are one worth, so a list writing `0.0` admits `-0.0`, and the value arrives as it was handed."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            enum [
              "0.0"
              "1.5"
            ]
            name "level"
            type "Double"
          }
        ]
        result {
          ref "level"
        }
      }
    }
    warp 1
  }
  test 1
}

