warpt 1
{
  expect {
    refuses "build"
  }
  name "a-named-list-handed-where-a-list-of-a-contract-stands-is-held-to-it"
  note "A composition inside a slot holds what arrives wherever it stands, through the name a declared type gave the list: a list of a type no document says satisfies the contract is refused where the call is written."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.tellAll" {
        parameters [
          {
            name "them"
            type "array<App.Describable>"
          }
        ]
        result 1
        returns "int"
      }
      entry {
        access "public"
        parameters [
          {
            name "cards"
            type "App.Cards"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "cards"
              }
            ]
            procedure "App.tellAll"
          }
        }
        returns "int"
      }
    }
    types {
      "App.Cards" "array<Bank.Card>"
      "Bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

