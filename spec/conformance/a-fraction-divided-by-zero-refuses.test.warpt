(test 1)
(name "a-fraction-divided-by-zero-refuses")
(note "Division by zero refuses at the run for two fractions as for two whole numbers: `1.5` divided by `0.0`.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.dividedBy 1.5 0.0)))))
(expect (refuses run))
