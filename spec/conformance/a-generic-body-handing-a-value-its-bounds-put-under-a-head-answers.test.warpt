warpt 1
{
  expect {
    answers "box"
  }
  name "a-generic-body-handing-a-value-its-bounds-put-under-a-head-answers"
  note "A procedure bounding `T` by `Hashable` hands a box of `T` where App.Describable is asked, and the head `App.Box<some T: Hashable>` takes every box its bounds allow, so the reading is one the claim's head takes and it answers."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    extensions {
      "App.Box<some T: Hashable>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Box<some T>"
              }
            ]
            result "box"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                struct {
                  item 1
                }
              }
            ]
            procedure "relay"
          }
        }
        returns "String"
      }
      relay {
        bounds {
          T "Hashable"
        }
        parameters [
          {
            name "b"
            type "App.Box<some T>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

