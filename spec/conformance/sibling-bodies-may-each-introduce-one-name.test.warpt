(test 1)
(name "sibling-bodies-may-each-introduce-one-name")
(note "A name a body introduces is read to the end of that body and nowhere after, so two bodies side by side may each introduce it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (body
      (var a 0)
      (var b 0)
      (conditional
        (when true)
        (then
          (let x 1)
          (set a x)))
      (conditional
        (when true)
        (then
          (let x 2)
          (set b x)))
      (return (dictionary (entry "a" a) (entry "b" b))))))
(expect (answers (dictionary (entry "a" 1) (entry "b" 2))))
