(test 1)
(name "a-struct-literal-holding-an-empty-list-beside-an-int-fills-a-call-answers")
(note "An empty list holds no element wherever in a literal it stands, a struct literal's field included, so `App.Box<Array<Never>>` is read as the `App.Box<Array<Int>>` the call fills beside it.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure App.take2
    (parameter b (type (named App.Box (array (some T)))))
    (parameter x (type (some T)))
    (returns (some T))
    (body
      (return x)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.take2 (struct (field item (array))) 1)))))
(expect (answers 1))
