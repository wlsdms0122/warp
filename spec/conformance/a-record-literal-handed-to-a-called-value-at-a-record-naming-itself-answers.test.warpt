warpt 1
{
  expect {
    answers App.Node {
      children [
        App.Node {
          children []
        }
      ]
    }
  }
  name "a-record-literal-handed-to-a-called-value-at-a-record-naming-itself-answers"
  note "`App.Node` is a declared record holding a list of itself, and `g` is held at `{ procedure: { parameters: [App.Node], returns: Any } }`. A call of `g` holds the literal to that slot field by field, however deep the record goes, and names each level `App.Node`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "g"
            type {
              procedure {
                parameters [
                  "App.Node"
                ]
                returns "Any"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "p"
                    type "Any"
                  }
                ]
                result {
                  ref "p"
                }
                returns "Any"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                record {
                  children [
                    {
                      record {
                        children []
                      }
                    }
                  ]
                }
              }
            ]
            procedure {
              ref "g"
            }
          }
        }
      }
    }
    types {
      "App.Node" {
        record {
          children "Array<App.Node>"
        }
      }
    }
    warp 1
  }
  test 1
}

