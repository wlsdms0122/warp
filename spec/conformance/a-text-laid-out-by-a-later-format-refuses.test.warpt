warpt 1
{
  expect {
    refuses "load"
  }
  name "a-text-laid-out-by-a-later-format-refuses"
  note "A reader lays out one format and refuses a text that says a later one, for the reason a document is refused by a reader older than it: the text may say something the reader has no name for."
  test 5
  text "warpt 2\n1\n"
}

