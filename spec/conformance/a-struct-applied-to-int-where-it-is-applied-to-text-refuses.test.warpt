warpt 1
{
  expect {
    refuses "build"
  }
  name "a-struct-applied-to-int-where-it-is-applied-to-text-refuses"
  note "Two mentions of one struct are one type where they are applied to the same types. An `App.Box<Int>` does not stand where `App.Box<String>` is declared."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "c"
            type "App.Box<String>"
            value {
              ref "b"
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

