(test 1)
(name "a-declared-type-naming-a-type-parameter-refuses")
(note "What fills a type parameter is a call filling the slot that names it, and a name inside a body is no such slot. `let y` declaring `some T` refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (some T)))
    (returns Int)
    (body
      (let y (type (some T)) x)
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.f 1)))))
(expect (refuses load))
