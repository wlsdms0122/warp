warpt 1
{
  expect {
    answers 1
  }
  name "a-value-of-memberships-that-name-each-other-cast-to-a-member-answers"
  note "`App.M` admits `App.N` and `Int`, and `App.N` admits `App.M` and `Bool`, so a value of `App.M` is an int or a bool, each membership met again adding no member. A cast of a name read as `App.M` to `Int` could hold, so it builds, and the run reads 1 as an int."
  program {
    constraints {
      "App.M" [
        "App.N"
        "Int"
      ]
      "App.N" [
        "App.M"
        "Bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "App.M"
            value 1
            var "x"
          }
        ]
        result {
          as {
            of {
              ref "x"
            }
            type "Int"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

