(test 1)
(name "modifiers-written-in-another-order-refuse")
(note "A procedure type that is const and isolated is written `const isolated Procedure`, and `isolated const Procedure` is a second spelling of the same type. A document says each thing one way, and this one is refused where it is read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter f (type (procedure (isolated) (const))))
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
