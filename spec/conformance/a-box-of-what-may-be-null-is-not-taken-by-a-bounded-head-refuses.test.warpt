(test 1)
(name "a-box-of-what-may-be-null-is-not-taken-by-a-bounded-head-refuses")
(note "A box of `Int?` is not taken by `App.Box<some T: Hashable>`: what may be null fills a bounded parameter only where it stands alone.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (struct App.Plain
      (field x Int))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Lib.Container)
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import App.Box)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (let b (type (named App.Box (nullable Int))) (struct (field item null)))
      (return (call Lib.firstOf b)))))
(expect (refuses build))
