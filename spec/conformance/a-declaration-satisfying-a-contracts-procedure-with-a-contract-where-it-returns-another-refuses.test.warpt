(test 1)
(name "a-declaration-satisfying-a-contracts-procedure-with-a-contract-where-it-returns-another-refuses")
(note "The contract returns App.Named and the declaration satisfying it returns App.Sized. A type conforming to App.Sized need not conform to App.Named, so the return value could be one the contract's return type does not take.")

(program
  (warp 1)
  (struct Bank.Box
    (satisfies App.Shown)
    (field n Int)
    (procedure show
      (parameter of (type Bank.Box))
      (parameter n (type App.Sized))
      (returns App.Sized)
      (body
        (return n))))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (body
        (return 4))))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Named
    (procedure name
      (parameter of (type Self))
      (returns String)))
  (contract App.Shown
    (procedure show
      (parameter of (type Self))
      (parameter n (type App.Sized))
      (returns App.Named)))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure entry
    (access public)
    (returns App.Named)
    (failing cast_refused)
    (body
      (let b (as (struct (field n 1)) Bank.Box))
      (let c (as (struct (field last "4")) Bank.Card))
      (let s (call App.Shown.show b c))
      (return s))))
(expect (refuses build))
