warpt 1
{
  expect {
    refuses "load"
  }
  name "a-padded-bound-refuses"
  note "A whole bound is written the one way a whole number is. `int(007...255)` pads the bound, which is a second spelling of `int(7...255)`, and is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        parameters {
          item {
            type "int(007...255)"
          }
        }
        result 1
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

