warpt 1
{
  expect {
    answers "a first"
  }
  name "a-struct-literals-fields-are-made-in-the-order-of-their-names"
  note "A struct literal makes its fields in the order of their names. Both of `App.P`'s fields abort, so `a` is made first, its failure is the one the rescue catches, and `b` is never made."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "p"
                    type "App.P"
                    value {
                      struct {
                        a {
                          call {
                            arguments [
                              "a first"
                            ]
                            procedure "Standard.Control.abort"
                          }
                        }
                        b {
                          call {
                            arguments [
                              "b first"
                            ]
                            procedure "Standard.Control.abort"
                          }
                        }
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "tried.message"
                  }
                }
                result "no"
              }
            }
          }
        ]
        result {
          ref "tried"
        }
        returns "String"
      }
    }
    types {
      "App.P" {
        struct {
          a "String"
          b "String"
        }
      }
    }
    warp 1
  }
  test 1
}

