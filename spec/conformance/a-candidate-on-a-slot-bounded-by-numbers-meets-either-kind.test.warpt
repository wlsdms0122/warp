warpt 1
{
  arguments {
    level 1.0
  }
  expect {
    answers 1.0
  }
  name "a-candidate-on-a-slot-bounded-by-numbers-meets-either-kind"
  note "A slot bounded by `Standard.Numeric` takes either kind of number, so a whole candidate is live on it and a fraction of the same worth meets it."
  program {
    imports [
      "Standard.Numeric"
    ]
    procedures {
      entry {
        access "public"
        bounds {
          N "Standard.Numeric"
        }
        parameters [
          {
            enum [
              "1"
              "2.5"
            ]
            name "level"
            type "some N"
          }
        ]
        result {
          ref "level"
        }
      }
    }
    warp 1
  }
  test 1
}

