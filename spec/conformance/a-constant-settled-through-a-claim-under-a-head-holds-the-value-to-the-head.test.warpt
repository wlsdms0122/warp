warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              const true
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      extensions {
        "App.Box<Int?>" {
          procedures {
            describe {
              access "public"
              const true
              isolated true
              parameters [
                {
                  name "of"
                  type "App.Box<Int?>"
                }
              ]
              result "box"
              returns "String"
            }
          }
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports []
      types {
        "App.Box" {
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
        }
      }
      warp 1
    }
  ]
  expect {
    answers "box"
  }
  name "a-constant-settled-through-a-claim-under-a-head-holds-the-value-to-the-head"
  note "A constant settles through App.Describable, which answers without running, with a box holding `1` read as `App.Box<Int?>`. The fold holds the value it ran on to the head the claim was written under, which takes it, so the link answers what the run would."
  program {
    const {
      d {
        call {
          arguments [
            {
              as {
                of {
                  struct {
                    item 1
                  }
                }
                type "App.Box<Int?>"
              }
            }
          ]
          procedure "App.Describable.describe"
        }
      }
    }
    imports [
      "App.Box"
      "App.Describable.describe"
    ]
    procedures {
      entry {
        access "public"
        const true
        isolated true
        result {
          ref "d"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

