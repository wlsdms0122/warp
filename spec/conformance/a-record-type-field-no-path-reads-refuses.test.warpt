warpt 1
{
  expect {
    refuses "load"
  }
  name "a-record-type-field-no-path-reads-refuses"
  note "A field of a record type is reached by a path alone, so its name is a value's name. `a.b` is two steps to a path, so no path reaches the field, and the document refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    types {
      "App.T" {
        record {
          "a.b" "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

