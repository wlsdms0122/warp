warpt 1
{
  expect {
    answers [
      "a whole number"
      "text"
      "a list"
      "a map"
    ]
  }
  name "a-type-the-language-names-answers-a-contract"
  note "A type the language names is a type the way a declared one is, and a document claims a contract for it the same way. The run picks by the type the value is an instance of: a list by `Array` whatever it holds, and a map by `Dictionary` whatever it holds."
  program {
    contracts {
      "App.Described" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      Array {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Array<Any>"
              }
            ]
            result "a list"
            returns "String"
          }
        }
        satisfies [
          "App.Described"
        ]
      }
      Dictionary {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Dictionary<some Key: Hashable, Any>"
              }
            ]
            result "a map"
            returns "String"
          }
        }
        satisfies [
          "App.Described"
        ]
      }
      Int {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result "a whole number"
            returns "String"
          }
        }
        satisfies [
          "App.Described"
        ]
      }
      String {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "String"
              }
            ]
            result "text"
            returns "String"
          }
        }
        satisfies [
          "App.Described"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "map"
            type "Dictionary<String, Int>"
            value {
              dictionary [
                [
                  "a"
                  1
                ]
              ]
            }
          }
        ]
        result [
          {
            call {
              arguments [
                1
              ]
              procedure "App.Described.describe"
            }
          }
          {
            call {
              arguments [
                "s"
              ]
              procedure "App.Described.describe"
            }
          }
          {
            call {
              arguments [
                [
                  1
                ]
              ]
              procedure "App.Described.describe"
            }
          }
          {
            call {
              arguments [
                {
                  ref "map"
                }
              ]
              procedure "App.Described.describe"
            }
          }
        ]
        returns "Array<String>"
      }
    }
    warp 1
  }
  test 1
}

