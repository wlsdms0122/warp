(test 1)
(name "calling-a-value-read-as-a-nullable-number-refuses")
(note "A value read as `Int?` is a number or null, and neither is a procedure. Calling it refuses at the build, the way calling an `Int` does.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter held (type (nullable Int)))
    (returns Any)
    (failing (anything))
    (result (apply held))))
(expect (refuses build))
