(test 1)
(name "a-host-handing-some-for-an-inner-none-is-taken")
(note "The host hands a `Some` holding `null` at an `Int??` parameter, the some of the none of `Int?`. It holds a none, so it is a value of `Int??`, the door takes it as it came, and the entry answers it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter a (type (optional (optional Int))))
    (returns Any)
    (body
      (return a))))
(arguments (argument a (struct Some (field wrapped null))))
(expect (answers (struct Some (field wrapped null))))
