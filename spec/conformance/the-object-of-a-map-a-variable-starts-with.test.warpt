(test 1)
(name "the-object-of-a-map-a-variable-starts-with")
(note "A map stands in an object as value tag 9, its keys as values in the key order and its values beside them, here what `seen` starts a run holding.")

(program
  (warp 1)
  (var seen (type (dictionary String Int)) (dictionary (entry "b" 2) (entry "a" 1)))
  (procedure entry
    (access public)
    (isolated)
    (returns (dictionary String Int))
    (result seen)))
