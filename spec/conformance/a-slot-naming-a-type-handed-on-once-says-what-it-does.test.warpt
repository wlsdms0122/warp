warpt 1
{
  expect {
    refuses "build"
  }
  name "a-slot-naming-a-type-handed-on-once-says-what-it-does"
  note "Silence read as taking the obligation is what left no way to say a slot only looks. A parameter naming such a type writes `consuming` or `borrowing`, and neither refuses."
  program {
    imports []
    procedures {
      "app.look" {
        parameters {
          of {
            type "app.Handle"
          }
        }
        receiver "of"
        result null
      }
      "app.open" {
        result {
          as "app.Handle"
          of {
            name "f"
          }
        }
        returns "app.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
        ]
        result {
          ref "handle"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          name "string"
        }
      }
    }
    warp 1
  }
  test 1
}

