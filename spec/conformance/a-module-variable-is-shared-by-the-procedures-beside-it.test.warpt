(test 1)
(name "a-module-variable-is-shared-by-the-procedures-beside-it")
(note "A module `var` is one box every procedure of the document reads and writes. What one procedure wrote, another reads.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (var total 0)
  (procedure add
    (body
      (set total (call Standard.Numeric.plus total 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (call add)
      (call add)
      (return total))))
(expect (answers 2))
