(test 1)
(name "an-effectful-closure-where-const-is-asked-refuses")
(note "A slot of a `const` procedure type takes only a procedure that says it is const. The closure handed to `Standard.Collection.tryFilter` sends `Standard.Concurrent.all` and does not declare `const`, so the build refuses it at the slot.")

(program
  (warp 1)
  (import Standard.Collection.tryFilter)
  (import Standard.Concurrent.all)
  (procedure entry
    (access public)
    (returns (array Int))
    (failing (anything))
    (body
      (let kept
        (call Standard.Collection.tryFilter
          (array 1)
          (closure
            (isolated)
            (parameter item (type Int))
            (returns Bool)
            (failing concurrent_failed)
            (body
              (let raced (call Standard.Concurrent.all (array)))
              (return true)))))
      (return kept))))
(expect (refuses build))
