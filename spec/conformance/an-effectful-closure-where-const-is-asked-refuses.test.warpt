warpt 1
{
  expect {
    refuses "build"
  }
  name "an-effectful-closure-where-const-is-asked-refuses"
  note "A slot declared `const` takes only a procedure that answers without running. What a closure sends is a fact about its text, so the refusal is the build's."
  program {
    imports [
      "std.collection.filter"
      "std.concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "kept"
            value {
              call {
                arguments [
                  [
                    1
                  ]
                  {
                    closure {
                      body [
                        {
                          let "raced"
                          value {
                            call {
                              arguments [
                                []
                              ]
                              procedure "std.concurrent.all"
                            }
                          }
                        }
                      ]
                      parameters [
                        {
                          name "item"
                          type "int"
                        }
                      ]
                      result true
                      returns "bool"
                    }
                  }
                ]
                procedure "std.collection.filter"
              }
            }
          }
        ]
        result {
          ref "kept"
        }
      }
    }
    warp 1
  }
  test 1
}

