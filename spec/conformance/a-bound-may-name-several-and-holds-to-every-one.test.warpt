warpt 1
{
  expect {
    refuses "build"
  }
  name "a-bound-may-name-several-and-holds-to-every-one"
  note "A bound may name several contracts joined with `&`, and a parameter so bounded takes only what answers every one of them. A whole number answers the first contract and not the second, so the call is refused at the build."
  program {
    contracts {
      Scalar {}
      Text {}
    }
    extensions {
      Int {
        satisfies [
          "Scalar"
        ]
      }
      String {
        satisfies [
          "Scalar"
          "Text"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "keep"
          }
        }
        returns "Int"
      }
      keep {
        bounds {
          T "Scalar & Text"
        }
        parameters [
          {
            name "value"
            type "some T"
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

