(test 1)
(name "a-claim-for-a-type-that-misses-a-procedure-refuses")
(note "A claim missing a procedure the contract asks puts its type under no contract. `Bank.Plain` is claimed for `App.Describable` and nothing declares `Bank.Plain.describe`, so the claim refuses at the build, at the claim.")

(program
  (warp 1)
  (struct Bank.Account
    (satisfies App.Describable)
    (field balance Int)
    (procedure describe
      (parameter of (type Bank.Account))
      (returns String)
      (body
        (return "an account"))))
  (struct Bank.Plain
    (satisfies App.Describable)
    (field note String))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (parameter it (type (some T App.Describable)))
    (returns String)
    (body
      (return (call App.Describable.describe it))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let plain (as (struct (field note "x")) Bank.Plain))
      (return (call App.tell plain)))))
(expect (refuses build))
