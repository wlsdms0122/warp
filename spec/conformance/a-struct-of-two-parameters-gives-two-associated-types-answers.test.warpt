warpt 1
{
  documents [
    {
      contracts {
        "Lib.Keyed" {
          procedures {
            value {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Value"
            }
          }
          types [
            "Key: Hashable"
            "Value"
          ]
        }
      }
      imports []
      procedures {
        "Lib.valueOf" {
          access "public"
          parameters [
            {
              name "p"
              type "some P: Lib.Keyed"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "p"
                }
              ]
              procedure "Lib.Keyed.value"
            }
          }
          returns "some P.Value"
        }
      }
      warp 1
    }
    {
      extensions {
        "App.Pair<some A: Hashable, some B>" {
          procedures {
            value {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Pair<some A, some B>"
                }
              ]
              result {
                ref "of.b"
              }
              returns "some B"
            }
          }
          satisfies [
            "Lib.Keyed"
          ]
          types {
            Key "some A"
            Value "some B"
          }
        }
      }
      imports [
        "Lib.Keyed"
      ]
      types {
        "App.Pair" {
          struct {
            a "some A"
            b "some B"
          }
          typeParameters [
            "A"
            "B"
          ]
        }
      }
      warp 1
    }
  ]
  expect {
    answers "b"
  }
  name "a-struct-of-two-parameters-gives-two-associated-types-answers"
  note "A pair claims a contract asking `Key: Hashable` and `Value` under `App.Pair<some A: Hashable, some B>`, its parameters in order. A pair of Int and text answers its text."
  program {
    imports [
      "App.Pair"
      "Lib.valueOf"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "p"
            type "App.Pair<Int, String>"
            value {
              struct {
                a 1
                b "b"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "p"
              }
            ]
            procedure "Lib.valueOf"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

