(test 1)
(name "the-object-of-a-claim-under-a-head")
(note "A claim under a head applying its type is written under the head: the type, what it is applied to, and its type parameters' bounds.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some T Hashable)))
    (satisfies App.Describable)
    (procedure describe
      (const)
      (isolated)
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (result "box")))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1))))
    (result (call App.Describable.describe b))))
