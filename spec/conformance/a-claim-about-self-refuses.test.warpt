(test 1)
(name "a-claim-about-self-refuses")
(note "A claim is about a type a value is an instance of. `Self` names a type only inside a contract's procedures, so a claim about it is refused where the document is read.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Self)
    (satisfies App.Described))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses load))
