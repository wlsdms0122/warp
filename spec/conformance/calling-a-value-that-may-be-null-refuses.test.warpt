(test 1)
(name "calling-a-value-that-may-be-null-refuses")
(note "A slot declaring `Procedure?` may hold null, and a call of it would call through the null. Null is not called through, the way it is not read through, so the call refuses where it is written.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter held (type (nullable Procedure)))
    (returns Any)
    (failing (anything))
    (result (apply held))))
(expect (refuses build))
