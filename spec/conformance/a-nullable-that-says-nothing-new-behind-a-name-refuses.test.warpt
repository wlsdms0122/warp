(test 1)
(name "a-nullable-that-says-nothing-new-behind-a-name-refuses")
(note "A `?` is written only where it says something new. Behind a declared name standing for `Any` it says nothing, and the build refuses it where the name resolves.")

(program
  (warp 1)
  (type Loose Any)
  (procedure entry
    (access public)
    (parameter value (type (nullable Loose)))
    (returns Int)
    (result 1)))
(expect (refuses build))
