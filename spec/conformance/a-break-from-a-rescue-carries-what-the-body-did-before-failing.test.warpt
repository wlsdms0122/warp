(test 1)
(name "a-break-from-a-rescue-carries-what-the-body-did-before-failing")
(note "The attempt's body sets `n` to a string and then fails, and its rescue breaks out of the loop. The way that breaks went through the body up to the failure, so past the loop `n` may hold the string, and asking whether it is an int stands rather than being a cast the reading already decides.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (import Standard.Control.abort)
  (procedure check
    (parameter x (type Int))
    (returns Int)
    (failing aborted)
    (body
      (conditional
        (when (call Standard.Comparable.lessThan x 0))
        (then
          (call Standard.Control.abort "negative"))))
    (result x))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var n 0)
      (loop
        (while true)
        (body
          (attempt
            (body
              (set n "s")
              (call check -1)
              (return 0))
            (rescue
              (break)))))
      (let s (as? n Int)))
    (result 1)))
(expect (answers 1))
