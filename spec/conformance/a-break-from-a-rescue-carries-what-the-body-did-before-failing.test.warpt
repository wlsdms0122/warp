warpt 1
{
  expect {
    answers 1
  }
  name "a-break-from-a-rescue-carries-what-the-body-did-before-failing"
  note "The attempt's body sets `n` to a string and then fails, and its rescue breaks out of the loop. The way that breaks went through the body up to the failure, so past the loop `n` may hold the string, and asking whether it is an int stands rather than being a cast the reading already settles."
  program {
    imports [
      "Standard.Comparable.lessThan"
      "Standard.Control.abort"
    ]
    procedures {
      check {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      call {
                        arguments [
                          "negative"
                        ]
                        procedure "Standard.Control.abort"
                      }
                    }
                  }
                ]
                when {
                  call {
                    arguments [
                      {
                        ref "x"
                      }
                      0
                    ]
                    procedure "Standard.Comparable.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "Int"
          }
        ]
        result {
          ref "x"
        }
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            value 0
            var "n"
          }
          {
            value {
              loop {
                body [
                  {
                    value {
                      attempt {
                        body [
                          {
                            set "n"
                            value "s"
                          }
                          {
                            value {
                              call {
                                arguments [
                                  -1
                                ]
                                procedure "check"
                              }
                            }
                          }
                          {
                            value {
                              return 0
                            }
                          }
                        ]
                        rescue {
                          body [
                            {
                              value {
                                break null
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
                while true
              }
            }
          }
          {
            let "s"
            value {
              "as?" {
                of {
                  ref "n"
                }
                type "Int"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

