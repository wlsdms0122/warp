(test 1)
(name "a-name-declared-inside-a-nested-closure-does-not-cover-a-captured-one")
(note "Isolation reads names in scope. The closure handed to `Standard.Concurrent.map` declares `isolated`, and a closure nested inside it declares `tally` for itself alone. The outer closure's own `set tally` still writes the variable it captured, so it refuses at the build.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (procedure entry
    (access public)
    (returns (array Int))
    (failing concurrent_failed)
    (body
      (var tally 0))
    (result
      (call Standard.Concurrent.map
        (array 1)
        (closure
          (isolated)
          (parameter item (type Int))
          (returns Int)
          (body
            (let inner
              (closure
                (body
                  (var tally 1))))
            (set tally 1))
          (result item))))))
(expect (refuses build))
