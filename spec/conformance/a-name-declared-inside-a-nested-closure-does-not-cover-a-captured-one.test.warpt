warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-declared-inside-a-nested-closure-does-not-cover-a-captured-one"
  note "Isolation reads names in scope. The closure handed to `Standard.Concurrent.map` declares `isolated`, and a closure nested inside it declares `tally` for itself alone. The outer closure's own `set tally` still writes the variable it captured, so it refuses at the build."
  program {
    imports [
      "Standard.Concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "tally"
          }
        ]
        failing [
          "concurrent_failed"
        ]
        result {
          call {
            arguments [
              [
                1
              ]
              {
                closure {
                  body [
                    {
                      let "inner"
                      value {
                        closure {
                          body [
                            {
                              value 1
                              var "tally"
                            }
                          ]
                        }
                      }
                    }
                    {
                      set "tally"
                      value 1
                    }
                  ]
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                  ]
                  result {
                    ref "item"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

