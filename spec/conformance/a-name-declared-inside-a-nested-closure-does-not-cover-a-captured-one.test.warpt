warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-declared-inside-a-nested-closure-does-not-cover-a-captured-one"
  note "Isolation reads names in scope. A closure nested inside this one declares `tally` for itself alone; this closure's own `set tally` still writes the variable it captured, so it is not isolated and does not fit `map`."
  program {
    imports [
      "std.concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "tally"
          }
        ]
        result {
          call {
            arguments [
              [
                1
              ]
              {
                closure {
                  body [
                    {
                      let "inner"
                      value {
                        closure {
                          body [
                            {
                              value 1
                              var "tally"
                            }
                          ]
                        }
                      }
                    }
                    {
                      set "tally"
                      value 1
                    }
                  ]
                  parameters [
                    {
                      name "item"
                      type "int"
                    }
                  ]
                  result {
                    ref "item"
                  }
                }
              }
            ]
            procedure "std.concurrent.map"
          }
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

