warpt 1
{
  expect {
    answers 1
  }
  name "a-head-writes-a-nullable-procedure-type-in-parentheses"
  note "A head writes the types it applies a struct to as a slot does, so a procedure answering without running, or null, is written `(const Procedure)?` there too, and the extension loads."
  program {
    extensions {
      "App.Box<(const Procedure)?>" {
        procedures {
          one {
            parameters [
              {
                name "it"
                type "App.Box<(const Procedure)?>"
              }
            ]
            result 1
            returns "Int"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          held "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

