(test 1)
(name "an-object-claiming-under-a-head-bounding-a-type-parameter-by-nothing-refuses")
(note "A head's bounds name, for each type parameter it bounds, at least one contract. A head bounding `T` by no contract is refused where the object is read.")
(object (dictionary (entry "addressTable" (array)) (entry "claims" (array (array (array "App.Box" (array 1) (array (array "T" (array)))) (array "App.Marked")))) (entry "constants" (array)) (entry "contracts" (array (array "App.Marked" (array (array) (array) (array))))) (entry "dependencies" (array)) (entry "document" (array x"981962a8a5c75c482e95d39a63df76c4e585f59a594c6bf875b398f18b898871")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array)) (entry "rows" (array)) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 15 "T") (array 15 "T"))) (entry "types" (array (array "App.Box" (array 9 (array (array "item" 0)) (array "T") (array))))) (entry "valueTable" (array)) (entry "variables" (array))))
(expect (refuses load))
