warpt 1
{
  expect {
    answers 7
  }
  name "a-declaration-answering-a-contract-may-take-a-wider-type"
  note "The contract takes an int and the declaration answering it takes a double. Every int a call through the contract hands is a double, so the declaration answers the contract."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "Int"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "n"
            type "Double"
          }
        ]
        result 7
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  2
                ]
                procedure "App.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

