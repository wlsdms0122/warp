warpt 1
{
  expect {
    answers 7
  }
  name "a-declaration-answering-a-contract-may-take-a-wider-type"
  note "The contract takes an Int and the declaration answering it takes `Int?`. Every Int a call through the contract hands is an `Int?`, so the declaration answers the contract."
  program {
    contracts {
      "App.Sized" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "n"
                type "Int"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  2
                ]
                procedure "App.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
              {
                name "n"
                type "Int?"
              }
            ]
            result 7
            returns "Int"
          }
        }
        satisfies [
          "App.Sized"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

