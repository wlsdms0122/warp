warpt 1
{
  expect {
    answers App.Handle {
      name "f"
    }
  }
  name "a-borrowing-slot-reads-and-leaves-the-obligation"
  note "A slot that writes `borrowing` reads the value and ends nothing. The body that lent it still holds it and still hands it on, which it does here by answering it, and answering a name already given away would refuse."
  program {
    imports []
    procedures {
      "App.name" {
        parameters [
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
        result {
          ref "of.name"
        }
        returns "String"
      }
      "App.open" {
        result {
          as {
            of {
              record {
                name "f"
              }
            }
            type "App.Handle"
          }
        }
        returns "App.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            let "shown"
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.name"
              }
            }
          }
        ]
        result {
          ref "handle"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

