(test 1)
(name "a-cast-of-a-dictionary-to-a-declared-struct-refuses")
(note "A declared struct is nominal and a dictionary is no value of it, whatever its keys. `m` is read as `Dictionary<String, Int>`, so a cast of it to `App.P` names a type no value it reads is, and refuses at the build.")

(program
  (warp 1)
  (struct App.P
    (field x Int))
  (procedure entry
    (access public)
    (returns App.P)
    (failing cast_refused)
    (body
      (let m (type (dictionary String Int)) (dictionary (entry "x" 1)))
      (return (as m App.P)))))
(expect (refuses build))
