warpt 1
{
  expect {
    refuses "build"
  }
  name "a-oneof-that-admits-nothing-refuses-at-build"
  note "A oneOf that admits nothing is a parameter no call could ever fit."
  program {
    imports []
    procedures {
      entry {
        result null
      }
      pick {
        parameters {
          mode {
            oneOf []
            type "string"
          }
        }
        result {
          ref "mode"
        }
      }
    }
    warp 1
  }
  test 2
}
