warpt 1
{
  arguments {
    at [
      0
      2
    ]
  }
  expect {
    refuses "run"
  }
  name "gathering-past-the-end-refuses"
  note "The collection is there and says how long it is, so a position it does not hold read the length wrong. The same answer an index written past the end gets."
  program {
    imports [
      "Standard.Collection.gathering"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "at"
            type "array<int>"
          }
        ]
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                ref "at"
              }
            ]
            procedure "Standard.Collection.gathering"
          }
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

