warpt 1
{
  expect {
    answers [
      {
        k [
          "b"
        ]
      }
      {
        k []
      }
    ]
  }
  name "a-parameter-handed-in-place-handed-on-beside-records-of-it-and-of-an-empty-list-answers"
  note "app.g hands xs, a list of dictionaries of lists of T handed in place, on to app.put beside [{ k: [x] }, { k: [] }]. The records are taken field by field whichever stands first, so the literal is a value of array<dictionary<array<some T>>>, and the caller reads both records."
  program {
    imports []
    procedures {
      "app.g" {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  [
                    {
                      record {
                        k [
                          {
                            ref "x"
                          }
                        ]
                      }
                    }
                    {
                      record {
                        k []
                      }
                    }
                  ]
                ]
                procedure "app.put"
              }
            }
          }
        ]
        parameters [
          {
            name "xs"
            type "inout array<dictionary<array<some T>>>"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result 0
      }
      "app.put" {
        body [
          {
            set "a"
            value {
              ref "b"
            }
          }
        ]
        parameters [
          {
            name "a"
            type "inout some U"
          }
          {
            name "b"
            type "some U"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value {
              as {
                of [
                  {
                    record {
                      k [
                        "a"
                      ]
                    }
                  }
                ]
                type "array<dictionary<array<string>>>"
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  "b"
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

