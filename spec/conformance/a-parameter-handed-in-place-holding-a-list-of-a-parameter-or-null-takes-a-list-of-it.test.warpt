(test 1)
(name "a-parameter-handed-in-place-holding-a-list-of-a-parameter-or-null-takes-a-list-of-it")
(note "App.gen takes Array<some T>? in place and writes a list of its own some T into it, which is a list of what filled T.")

(program
  (warp 1)
  (procedure App.gen
    (parameter x (type (inout (nullable (array (some T))))))
    (parameter y (type (some T)))
    (returns Int)
    (body
      (set x (array y)))
    (result 0))
  (procedure entry
    (access public)
    (returns (nullable (array String)))
    (body
      (var s (type (nullable (array String))) (array "a"))
      (let r (call App.gen s "b")))
    (result s)))
(expect (answers (array "b")))
