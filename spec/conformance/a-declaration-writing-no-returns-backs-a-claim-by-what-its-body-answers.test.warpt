warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-writing-no-returns-backs-a-claim-by-what-its-body-answers"
  note "A declaration answering a contract's procedure that writes no `returns` answers what its body answers, read the way a call site reads it. One whose body answers `Int` where the contract writes `String` backs no claim, and the claim refuses at the build, at the claim."
  program {
    contracts {
      "App.Named" {
        procedures {
          name {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        parameters [
          {
            name "it"
            type "some T: App.Named"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Named.name"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    struct {
                      id 1
                    }
                  }
                  type "App.Thing"
                }
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Thing" {
        procedures {
          name {
            parameters [
              {
                name "of"
                type "App.Thing"
              }
            ]
            result 7
          }
        }
        satisfies [
          "App.Named"
        ]
        struct {
          id "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

