warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-writing-no-returns-backs-a-claim-by-what-its-body-answers"
  note "A declaration answering a contract's procedure that writes no `returns` answers what its body answers, read the way a call site reads it. One whose body answers `int` where the contract writes `string` backs no claim, and is refused where the pair is leaned on."
  program {
    contracts {
      "App.Named" {
        name {
          parameters [
            {
              name "of"
              type "App.Named"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.Thing.name" {
        parameters [
          {
            name "of"
            type "App.Thing"
          }
        ]
        result 7
      }
      "App.tell" {
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Named.name"
          }
        }
        returns "string"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    record {
                      id 1
                    }
                  }
                  type "App.Thing"
                }
              }
            ]
            procedure "App.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "App.Thing" [
        "App.Named"
      ]
    }
    types {
      "App.Thing" {
        record {
          id "int"
        }
      }
    }
    warp 1
  }
  test 1
}

