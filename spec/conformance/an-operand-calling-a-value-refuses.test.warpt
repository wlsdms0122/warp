warpt 1
{
  expect {
    refuses "load"
  }
  name "an-operand-calling-a-value-refuses"
  note "An operand is read rather than run, and which procedure a value is, is the run's answer. The text alone shows a call of a value, so a call of `f` written as an argument refuses at the load, though `f` is declared a `const` procedure type; written as a statement it stands."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.g" {
        parameters [
          {
            name "f"
            type "const () -> Int"
          }
        ]
        result {
          call {
            arguments [
              1
              {
                call {
                  procedure {
                    ref "f"
                  }
                }
              }
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                closure {
                  result 1
                  returns "Int"
                }
              }
            ]
            procedure "App.g"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

