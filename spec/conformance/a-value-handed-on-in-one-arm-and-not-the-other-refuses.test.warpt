warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-handed-on-in-one-arm-and-not-the-other-refuses"
  note "What a body holds after a conditional cannot depend on which arm ran. A linear value given away in one arm and kept in the other is refused at the build."
  program {
    imports [
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            value {
              conditional {
                then [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "handle"
                          }
                        ]
                        procedure "App.close"
                      }
                    }
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "ready"
            type "Bool"
          }
        ]
        returns "Null"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

