(test 1)
(name "a-claim-about-an-alias-another-document-declares-refuses")
(note "A value of App.Num is an instance of `Int` and of no other name, so a document extending it gives nothing to a type a value is, and the claim refuses at the build, where what App.Num is becomes known.")

(documents
  (document
    (warp 1)
    (type App.Num Int)))

(program
  (warp 1)
  (import App.Num)
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head App.Num)
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type App.Num))
      (returns String)
      (result "n")))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses build))
