warpt 1
{
  documents [
    {
      imports []
      types {
        "App.Num" "Int"
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-claim-about-an-alias-another-document-declares-refuses"
  note "A value of App.Num is an instance of `Int` and of no other name, so a document extending it gives nothing to a type a value is, and the claim refuses at the build, where what App.Num is becomes known."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    extensions {
      "App.Num" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result "n"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports [
      "App.Num"
    ]
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

