warpt 1
{
  expect {
    refuses "build"
  }
  name "an-attempt-around-a-call-of-a-value-whose-type-fails-with-nothing-refuses"
  note "`step`'s type says it fails with nothing, so the call of it in the attempt fails with nothing, and the rescue is a body no run reaches: refused at the build."
  program {
    imports []
    procedures {
      apply {
        body [
          {
            let "r"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "of"
                          }
                        ]
                        procedure {
                          ref "step"
                        }
                      }
                    }
                  }
                ]
                rescue {
                  result 0
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "Int"
          }
          {
            name "step"
            type "const (Int) -> Int"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              {
                closure {
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    ref "x"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "apply"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

