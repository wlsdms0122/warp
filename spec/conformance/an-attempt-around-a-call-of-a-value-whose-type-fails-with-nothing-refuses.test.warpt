(test 1)
(name "an-attempt-around-a-call-of-a-value-whose-type-fails-with-nothing-refuses")
(note "`step`'s type says it fails with nothing, so the call of it in the attempt fails with nothing, and the rescue is a body no run reaches: refused at the build.")

(program
  (warp 1)
  (procedure apply
    (parameter of (type Int))
    (parameter step (type (procedure (const) (parameters Int) (returns Int))))
    (returns Int)
    (body
      (let r
        (attempt
          (body
            (apply step of))
          (rescue
            (result 0)))))
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (result
      (call apply 1
        (closure
          (parameter x (type Int))
          (returns Int)
          (result x))))))
(expect (refuses build))
