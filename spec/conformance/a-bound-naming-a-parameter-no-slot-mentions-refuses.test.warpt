warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bound-naming-a-parameter-no-slot-mentions-refuses"
  note "`bounds` holds the type parameters the signature's slots mention. A name bounded there that no slot writes as `some T` is bound to nothing, and is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        bounds {
          T "Standard.Comparable"
        }
        parameters [
          {
            name "item"
            type "Int"
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

