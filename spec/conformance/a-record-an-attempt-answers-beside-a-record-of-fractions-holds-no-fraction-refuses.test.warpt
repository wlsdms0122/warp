warpt 1
{
  arguments {
    payload 3
  }
  expect {
    refuses "build"
  }
  name "a-record-an-attempt-answers-beside-a-record-of-fractions-holds-no-fraction-refuses"
  note "An attempt's two ways are each a place of their own, and they meet field by field. Its body answers `{ a: 1 }`, whose field is the Int it is, and its rescue `{ a: 2.5 }`, so `tried.a` reads `Any`. The entry declares `Double`, so the build refuses."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      as {
                        of {
                          ref "payload"
                        }
                        type "Int"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    record {
                      a 2.5
                    }
                  }
                }
                result {
                  record {
                    a 1
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "payload"
          }
        ]
        result {
          ref "tried.a"
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

