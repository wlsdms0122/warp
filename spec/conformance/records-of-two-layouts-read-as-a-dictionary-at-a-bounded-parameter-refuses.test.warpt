warpt 1
{
  expect {
    refuses "build"
  }
  name "records-of-two-layouts-read-as-a-dictionary-at-a-bounded-parameter-refuses"
  note "`app.f` bounds `T` by `app.Nums`, which admits `int` and `double`, and takes `dictionary<{ x: some T }>`. The record handed there holds two records whose fields differ, so their join is no record and `T` is read as nothing. Each record's field is still held to the bounds where it stands, and one is text, which no member takes, so the call refuses at the build."
  program {
    constraints {
      "app.Nums" [
        "int"
        "double"
      ]
    }
    imports []
    procedures {
      "app.f" {
        bounds {
          T "app.Nums"
        }
        parameters [
          {
            name "d"
            type {
              dictionary {
                record {
                  x "some T"
                }
              }
            }
          }
        ]
        result 0
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              record {
                a {
                  record {
                    x 1
                  }
                }
                b {
                  record {
                    x "s"
                    y 2
                  }
                }
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "app.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

