warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-loop-answers-is-read-position-by-position-refuses"
  note "A variable declared `Array<Dictionary<String, Array<String>>>` is set to a loop whose result is a list of two map literals, one holding `[]` under `a` and one holding `[1]`. The loop writes what its result writes, so the literal is held to the declaration position by position, and the list of ints refuses at the build."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "Array<Dictionary<String, Array<String>>>"
            value [
              {
                dictionary [
                  [
                    "a"
                    []
                  ]
                ]
              }
              {
                dictionary [
                  [
                    "a"
                    [
                      "s"
                    ]
                  ]
                ]
              }
            ]
            var "ys"
          }
          {
            set "ys"
            value {
              loop {
                body [
                  {
                    let "k"
                    value 0
                  }
                ]
                result [
                  {
                    dictionary [
                      [
                        "a"
                        []
                      ]
                    ]
                  }
                  {
                    dictionary [
                      [
                        "a"
                        [
                          1
                        ]
                      ]
                    ]
                  }
                ]
                while false
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

