warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-loop-answers-is-read-position-by-position-refuses"
  note "A variable declared `array<dictionary<array<string>>>` is set to a loop whose result is `[{ a: [] }, { a: [1] }]`. The loop writes what its result writes, so the literal is held to the declaration position by position, and the list of ints refuses at the build."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "array<dictionary<array<string>>>"
            value [
              {
                record {
                  a []
                }
              }
              {
                record {
                  a [
                    "s"
                  ]
                }
              }
            ]
            var "ys"
          }
          {
            set "ys"
            value {
              loop {
                body [
                  {
                    let "k"
                    value 0
                  }
                ]
                result [
                  {
                    record {
                      a []
                    }
                  }
                  {
                    record {
                      a [
                        1
                      ]
                    }
                  }
                ]
                while false
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                ]
                procedure "std.collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

