(test 1)
(name "a-module-variable-handed-in-place-is-one-box")
(note "A module variable handed in place to a body beside it is one box reached two ways: through the parameter and by its name. A write through either is seen through the other at once.")

(program
  (warp 1)
  (var items (array 1 2))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call poke (path items (index 0))))))
  (procedure poke
    (parameter first (type (inout Int)))
    (returns (array Int))
    (body
      (set first 9)
      (return items))))
(expect (answers (array 9 2)))
