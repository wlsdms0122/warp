warpt 1
{
  expect {
    answers "cast_refused"
  }
  name "a-cast-of-a-closure-writing-an-unsaid-generic-answer-carried-through-another-fails"
  note "App.g writes no returns, and what was read off its body is its some T, carried from App.h, whose closure sets cell from its own some T and is held as Any. The cast reading it as taking text fails with cast_refused, since only App.h's call filled its T, and the attempt in the entry catches the failure."
  program {
    imports []
    procedures {
      "App.g" {
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "n"
              }
              {
                ref "junk"
              }
            ]
            procedure "App.h"
          }
        }
      }
      "App.h" {
        body [
          {
            value {
              ref "n"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "w"
            value {
              as {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      "String"
                    ]
                    returns "Int"
                  }
                }
              }
            }
          }
          {
            let "z"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        ref "junk"
                      }
                      type "String"
                    }
                  }
                ]
                procedure {
                  ref "w"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "junk"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "r"
                    value {
                      call {
                        arguments [
                          1
                          "s"
                        ]
                        procedure "App.g"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "tried.type"
                  }
                }
                result {
                  ref "r"
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

