warpt 1
{
  expect {
    answers {
      tally 6
    }
  }
  name "a-walk-answers-nothing-and-writes-the-flow-it-is-in"
  note "A walk answers nothing, and its name is the element's alone — not readable after the walk. A round's contribution is what it writes outward: a pure mapping is std.collection.map's to say, and an effectful round with something to keep writes an outer variable."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        body [
          {
            value 0
            var "tally"
          }
          {
            let "walk"
            value {
              each {
                body [
                  {
                    set "tally"
                    value {
                      call {
                        arguments {
                          value {
                            ref "walk.item"
                          }
                        }
                        of {
                          ref "tally"
                        }
                        procedure "std.math.plus"
                      }
                    }
                  }
                ]
                in [
                  1
                  2
                  3
                ]
              }
            }
          }
        ]
        result {
          tally {
            ref "tally"
          }
        }
      }
    }
    warp 2
  }
  test 1
}
