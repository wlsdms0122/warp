warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-block-answers-is-read-position-by-position-refuses"
  note "A name declared `Array<Dictionary<Array<String>>>` starts with a block whose result is `[{ a: [] }, { a: [1] }]`. The block writes what its result writes, so the literal is held to the declaration position by position as it would be written directly, and the list of ints refuses at the build."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "Array<Dictionary<Array<String>>>"
            value {
              block {
                result [
                  {
                    record {
                      a []
                    }
                  }
                  {
                    record {
                      a [
                        1
                      ]
                    }
                  }
                ]
              }
            }
            var "ys"
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

