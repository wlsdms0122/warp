warpt 1
{
  expect {
    refuses "build"
  }
  name "a-required-argument-left-out-refuses"
  note "A call hands exactly as many arguments as the callee takes. `App.takes` takes one, so a call handing none refuses at the build, though the slot takes `Any`: an argument left out is not an argument holding null."
  program {
    imports []
    procedures {
      "App.takes" {
        parameters [
          {
            name "it"
          }
        ]
        result {
          ref "it"
        }
        returns "Any"
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.takes"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

