warpt 1
{
  expect {
    answers {
      message "on purpose"
      type "aborted"
    }
  }
  name "a-rescue-reads-the-failure-it-caught"
  note "While the rescue runs, the statement's name binds the failure as a record of `type`, `message` and `details`. This rescue reads the first two."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          "on purpose"
                        ]
                        procedure "Standard.Control.abort"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    dictionary [
                      [
                        "message"
                        {
                          ref "tried.message"
                        }
                      ]
                      [
                        "type"
                        {
                          ref "tried.type"
                        }
                      ]
                    ]
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

