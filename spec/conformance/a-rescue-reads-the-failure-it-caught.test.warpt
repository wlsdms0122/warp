warpt 1
{
  expect {
    answers {
      message "on purpose"
      type "aborted"
    }
  }
  name "a-rescue-reads-the-failure-it-caught"
  note "While the rescue runs, the statement's name binds the failure as a record: at least `type` and `message`. A failure is data the moment a rescue holds it."
  program {
    imports [
      "std.control.abort"
    ]
    procedures {
      entry {
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        of "on purpose"
                        procedure "std.control.abort"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    message {
                      ref "tried.message"
                    }
                    type {
                      ref "tried.type"
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 2
}

