(test 1)
(name "a-rescue-reads-the-failure-it-caught")
(note "While the rescue runs, the statement's name binds the failure as a struct of `type`, `message` and `details`. This rescue reads the first two.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns (dictionary String String))
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (call Standard.Control.abort "on purpose"))
          (rescue
            (set tried (dictionary (entry "message" (path caught (field message))) (entry "type" (path caught (field type)))))))))
    (result tried)))
(expect (answers (dictionary (entry "message" "on purpose") (entry "type" "aborted"))))
