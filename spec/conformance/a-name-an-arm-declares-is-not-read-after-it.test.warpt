warpt 1
{
  expect {
    refuses "load"
  }
  name "a-name-an-arm-declares-is-not-read-after-it"
  note "What an arm declares stays its own and dies with the arm. A reference after the conditional to a name only the arm declared reads a name that is not there."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              conditional {
                then [
                  {
                    value 1
                    var "inner"
                  }
                ]
                when true
              }
            }
          }
          {
            let "read"
            value {
              ref "inner"
            }
          }
        ]
        result {
          ref "read"
        }
      }
    }
    warp 1
  }
  test 1
}

