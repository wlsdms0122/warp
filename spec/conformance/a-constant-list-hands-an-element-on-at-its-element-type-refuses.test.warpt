warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-list-hands-an-element-on-at-its-element-type-refuses"
  note "A list's elements share one element type, the join of every element's, so `k[0]` reads as that type whatever its own closure was. One element calls a value and runs, so the element type is not `const`, and handing `k[0]` where `map` asks a `const` procedure refuses at the build. A record's fields keep their own types."
  program {
    const {
      k [
        {
          closure {
            parameters [
              {
                name "x"
                type "Int"
              }
            ]
            result {
              ref "x"
            }
            returns "Int"
          }
        }
        {
          closure {
            body [
              {
                let "h"
                value {
                  closure {
                    parameters [
                      {
                        name "q"
                        type "Int"
                      }
                    ]
                    result {
                      ref "q"
                    }
                    returns "Int"
                  }
                }
              }
              {
                let "z"
                value {
                  call {
                    arguments [
                      {
                        ref "x"
                      }
                    ]
                    procedure {
                      ref "h"
                    }
                  }
                }
              }
            ]
            parameters [
              {
                name "x"
                type "Int"
              }
            ]
            result {
              ref "z"
            }
            returns "Int"
          }
        }
      ]
    }
    imports [
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
              ]
              {
                ref "k[0]"
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

