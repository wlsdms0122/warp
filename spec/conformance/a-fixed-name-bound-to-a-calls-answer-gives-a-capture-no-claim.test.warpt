warpt 1
{
  expect {
    refuses "build"
  }
  name "a-fixed-name-bound-to-a-calls-answer-gives-a-capture-no-claim"
  note "`make` answers a `const` procedure type, and a name bound to that answer holds the build's reading of the call rather than a type a slot declared. A closure that captured the name and calls it does not answer without running, so `Standard.Collection.map` refuses it."
  program {
    imports [
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            value {
              call {
                procedure "make"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      let "y"
                      value {
                        call {
                          arguments [
                            {
                              ref "x"
                            }
                          ]
                          procedure {
                            ref "f"
                          }
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    ref "y"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
        returns "Array<Int>"
      }
      make {
        result {
          closure {
            parameters [
              {
                name "x"
                type "Int"
              }
            ]
            result {
              ref "x"
            }
            returns "Int"
          }
        }
        returns {
          "const procedure" {
            parameters [
              "Int"
            ]
            returns "Int"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

