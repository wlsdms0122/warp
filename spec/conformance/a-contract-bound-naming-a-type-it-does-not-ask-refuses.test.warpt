warpt 1
{
  documents []
  expect {
    refuses "load"
  }
  name "a-contract-bound-naming-a-type-it-does-not-ask-refuses"
  note "A contract holds a type it asks to contracts. `Lib.Keyed` asks Item and bounds Key, which refuses at the load."
  program {
    contracts {
      "Lib.Keyed" {
        bounds {
          Key "Hashable"
        }
        types [
          "Item"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

