warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "load"
  }
  name "a-same-type-writing-a-type-parameter-no-slot-writes-refuses"
  note "`sameTypes` says `C.Item` is `Array<some U>`, and no slot writes `some U`. What a same type writes is filled where a call fills the slots, so this refuses at the load."
  program {
    imports [
      "Lib.Container"
    ]
    procedures {
      "Use.it" {
        access "public"
        bounds {
          C "Lib.Container"
        }
        parameters [
          {
            name "c"
            type "some C"
          }
        ]
        result 1
        returns "Int"
        sameTypes {
          "C.Item" "Array<some U>"
        }
      }
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

