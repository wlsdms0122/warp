(test 1)
(name "a-door-takes-no-value-at-an-associated-type-of-another-type-refuses")
(note "The run hands a box of Int at C and text at `some C.Item`, which a box of Int gives as Int, so the run refuses it at the door.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import Lib.Container)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Container)))
    (parameter x (type (some C.Item)))
    (returns (some C.Item))
    (body
      (return x))))
(arguments (argument c (struct App.Box (field item 1))) (argument x "no"))
(expect (refuses run))
