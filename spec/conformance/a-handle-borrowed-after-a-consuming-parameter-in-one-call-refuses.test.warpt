warpt 1
{
  expect {
    refuses "build"
  }
  name "a-handle-borrowed-after-a-consuming-parameter-in-one-call-refuses"
  note "One call hands a name on in the order the run evaluates its arguments, the callee's parameter order. `App.swap` declares `value`, which consumes, before `of`, which borrows, so the handle is gone by the time `of` reads it, whichever order the call writes them in and whichever order their names sort in."
  program {
    imports [
      "App.Handle"
      "App.close"
      "App.open"
    ]
    procedures {
      "App.swap" {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "value"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        parameters [
          {
            name "value"
            type "consuming App.Handle"
          }
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                  {
                    ref "handle"
                  }
                ]
                procedure "App.swap"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

