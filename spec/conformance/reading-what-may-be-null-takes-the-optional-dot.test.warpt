(test 1)
(name "reading-what-may-be-null-takes-the-optional-dot")
(note "A nullable holds the declared value or null, and a plain dot reads a value that is there. Reading through what may be null takes `?.`. The build refuses the spelling that pretends otherwise.")

(program
  (warp 1)
  (struct Task
    (field name String))
  (procedure entry
    (access public)
    (parameter task (type (nullable Task)))
    (returns Any)
    (body
      (return (path task (field name))))))
(expect (refuses build))
