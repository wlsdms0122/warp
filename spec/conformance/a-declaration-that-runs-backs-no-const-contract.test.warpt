warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-that-runs-backs-no-const-contract"
  note "A contract's procedure writing `const` asks every declaration answering it to answer without running. One that reads a module variable answers by the run's state, so the claim it would back does not hold, and is refused where the pair is leaned on."
  program {
    contracts {
      "App.Named" {
        name {
          const true
          parameters [
            {
              name "of"
              type "App.Named"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.Thing.name" {
        parameters [
          {
            name "of"
            type "App.Thing"
          }
        ]
        result {
          ref "label"
        }
        returns "String"
      }
      "App.tell" {
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Named.name"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    record {
                      id 1
                    }
                  }
                  type "App.Thing"
                }
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    satisfies {
      "App.Thing" [
        "App.Named"
      ]
    }
    types {
      "App.Thing" {
        record {
          id "Int"
        }
      }
    }
    var {
      label "thing"
    }
    warp 1
  }
  test 1
}

