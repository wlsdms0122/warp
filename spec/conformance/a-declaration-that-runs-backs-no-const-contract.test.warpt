warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-that-runs-backs-no-const-contract"
  note "A contract's procedure writing `const` asks every declaration answering it to answer without running. One that reads a module variable answers by the run's state, so the claim it would back does not hold, and refuses at the build, at the claim."
  program {
    contracts {
      "App.Named" {
        procedures {
          name {
            const true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Named.name"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    struct {
                      id 1
                    }
                  }
                  type "App.Thing"
                }
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Thing" {
        procedures {
          name {
            parameters [
              {
                name "of"
                type "App.Thing"
              }
            ]
            result {
              ref "label"
            }
            returns "String"
          }
        }
        satisfies [
          "App.Named"
        ]
        struct {
          id "Int"
        }
      }
    }
    var {
      label "thing"
    }
    warp 1
  }
  test 1
}

