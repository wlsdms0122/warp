warpt 1
{
  arguments {
    payload 3
  }
  expect {
    answers 1
  }
  name "an-attempt-answering-records-of-the-same-fields-two-ways-joins-them-field-by-field"
  note "An attempt's two ways answer records of the same fields, so they join field by field, as a body's ways out do: `a` reads `Int` both ways and `b` reads `Any`, and `tried.a` is held at `Int`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      as {
                        of {
                          ref "payload"
                        }
                        type "Int"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    record {
                      a 2
                      b 3
                    }
                  }
                }
                result {
                  record {
                    a 1
                    b "x"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "payload"
          }
        ]
        result {
          ref "tried.a"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

