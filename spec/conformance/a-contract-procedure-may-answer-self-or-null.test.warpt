(test 1)
(name "a-contract-procedure-may-answer-self-or-null")
(note "`App.Find.find` answers `Self?`. The claim about `Int` reads it as `Int?`, which `Int.find` answers, and the call through the contract, filling `Self` with `Int`, answers `Int?`, held where `Int?` is declared.")

(program
  (warp 1)
  (contract App.Find
    (procedure find
      (parameter of (type Self))
      (returns (nullable Self))))
  (extension
    (head Int)
    (satisfies App.Find)
    (procedure find
      (parameter of (type Int))
      (returns (nullable Int))
      (result of)))
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (let found (type (nullable Int)) (call App.Find.find 5)))
    (result found)))
(expect (answers 5))
