warpt 1
{
  arguments {
    payload 3
  }
  expect {
    refuses "build"
  }
  name "a-whole-literal-an-attempt-answers-beside-a-fraction-is-no-fraction-refuses"
  note "An attempt's two ways are each a place of their own, and `tried` declares nothing. Its body answers a whole literal, which is the Int it is, and its rescue a fraction, so `tried` reads `Any`. The entry declares `Double`, and a value read as `Any` stands where a type is declared only where a cast says what it is, so the build refuses."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      as {
                        of {
                          ref "payload"
                        }
                        type "Int"
                      }
                    }
                  }
                ]
                rescue {
                  result 2.5
                }
                result 1
              }
            }
          }
        ]
        parameters [
          {
            name "payload"
          }
        ]
        result {
          ref "tried"
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

