(test 1)
(name "a-whole-literal-an-attempt-answers-beside-a-fraction-is-no-fraction-refuses")
(note "A write lands as the type the name holds it as, and `tried` declares nothing. An attempt's body writes it a whole literal, which is the Int it is, and its rescue a fraction, so where the two ways meet `tried` reads `Any`. The entry declares `Double`, and a value read as `Any` stands where a type is declared only where a cast says what it is, so the build refuses.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns Double)
    (body
      (var tried)
      (attempt
        (body
          (as payload Int)
          (set tried 1))
        (rescue
          (set tried 2.5))))
    (result tried)))
(arguments (argument payload 3))
(expect (refuses build))
