  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            var "kept"
          }
          {
            value {
              conditional {
                else [
                  {
                    value {
                      return 0
                    }
                  }
                ]
                then [
                  {
                    set "kept"
                    value 1
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "ready"
            type "Bool"
          }
        ]
        result {
          ref "kept"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
