warpt 1
{
  expect {
    refuses "build"
  }
  name "a-break-does-not-excuse-the-arm-it-leaves-from"
  note "A run does come back from a break: it comes back out of the loop still holding what the arm opened, so such an arm is held to the same rule any other arm is."
  program {
    imports [
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "spin"
            value {
              loop {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            let "own"
                            value {
                              call {
                                procedure "App.open"
                              }
                            }
                          }
                          {
                            value {
                              break null
                            }
                          }
                        ]
                        when true
                      }
                    }
                  }
                ]
                while true
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

