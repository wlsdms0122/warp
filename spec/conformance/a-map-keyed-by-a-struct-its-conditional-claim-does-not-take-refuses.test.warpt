(test 1)
(name "a-map-keyed-by-a-struct-its-conditional-claim-does-not-take-refuses")
(note "Box is Hashable where its item is. A map type keyed by a box of a struct no claim makes Hashable refuses at the build where it is written.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (struct App.Plain
      (field x Int))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Hashable))))

(program
  (warp 1)
  (import App.Box)
  (import App.Plain)
  (procedure entry
    (access public)
    (returns (dictionary (named App.Box App.Plain) String))
    (body
      (return (dictionary)))))
(expect (refuses build))
