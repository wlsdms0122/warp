warpt 1
{
  expect {
    refuses "build"
  }
  name "what-was-read-out-of-a-parameter-is-not-the-parameter"
  note "A dot on `some T` reads data, and what it reaches is a type the call decides too, but a different one: `of` is the type the call filled in and `of.inner` is a field of that type. So a name holding one on the way in and the other on the way through a conditional holds neither, and a dot on it is refused the way a dot on `any` is. Read as the same parameter, the field would stand wherever the parameter was proven, bound and all."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              flag true
              of {
                inner {
                  count "mine"
                }
              }
            }
            procedure "peek"
          }
        }
        returns "any"
      }
      peek {
        body [
          {
            value {
              ref "of"
            }
            var "held"
          }
          {
            value {
              conditional {
                then [
                  {
                    set "held"
                    value {
                      ref "of.inner"
                    }
                  }
                ]
                when {
                  ref "flag"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "flag"
            type "bool"
          }
          {
            name "of"
            type "some T"
          }
        ]
        result {
          ref "held.count"
        }
        returns "any"
      }
    }
    warp 1
  }
  test 1
}

