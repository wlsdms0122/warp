warpt 1
{
  expect {
    refuses "link"
  }
  name "a-module-variable-is-not-handed-in-place-beside-its-own-document"
  note "A body declared beside a module variable reads it by name, so handing the variable to it in place would reach one box two ways. The link refuses, the way it refuses one variable handed to two parameters."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            value {
              call {
                arguments {
                  list {
                    ref "items"
                  }
                }
                procedure "grow"
              }
            }
          }
        ]
        result {
          ref "items"
        }
        returns "array<int>"
      }
      grow {
        body [
          {
            set "list"
            value [
              1
              2
            ]
          }
        ]
        parameters {
          list "inout array<int>"
        }
      }
    }
    var {
      items [
        1
      ]
    }
    warp 2
  }
  test 1
}
