(test 1)
(name "an-associated-type-whose-parameter-no-parameter-writes-refuses")
(note "An associated type is what the type filling its parameter gives. No parameter writes `some C`, so no call fills C, and `some C.Item` refuses at the load.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c))))))

(program
  (warp 1)
  (import Lib.Container)
  (procedure Use.it
    (parameter x (type (some C.Item)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
