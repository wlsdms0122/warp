warpt 1
{
  expect {
    answers "took"
  }
  name "a-contract-or-null-slot-takes-a-parameter-bounded-by-the-contract-and-another"
  note "App.g hands its some T, bounded by App.Maybe & App.Sized, to App.f, which takes App.Sized?. T answers App.Sized by its bound, whatever type answering both fills it."
  program {
    contracts {
      "App.Maybe" {}
      "App.Sized" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized?"
          }
        ]
        result "took"
        returns "String"
      }
      "App.g" {
        body [
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "m"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        bounds {
          T "App.Maybe & App.Sized"
        }
        parameters [
          {
            name "m"
            type "some T"
          }
        ]
        result {
          ref "s"
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result 4
            returns "Int"
          }
        }
        satisfies [
          "App.Maybe"
          "App.Sized"
        ]
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        satisfies [
          "App.Maybe"
        ]
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

