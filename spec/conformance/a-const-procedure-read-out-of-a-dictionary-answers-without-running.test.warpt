warpt 1
{
  expect {
    answers 2
  }
  name "a-const-procedure-read-out-of-a-dictionary-answers-without-running"
  note "A slot writing `Dictionary<String, const (Int) -> Int>` says it of every entry, the way an array of them does. `asking` declares `const` and calls an entry it reads out by a key, which the build holds it to, so an operand may call it."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      asking {
        body [
          {
            let "a"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "body[key]"
                }
              }
            }
          }
        ]
        const true
        parameters [
          {
            name "body"
            type "Dictionary<String, const (Int) -> Int>"
          }
          {
            name "key"
            type "String"
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        const true
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      dictionary [
                        [
                          "k"
                          {
                            closure {
                              const true
                              isolated true
                              parameters [
                                {
                                  name "x"
                                  type "Int"
                                }
                              ]
                              result {
                                ref "x"
                              }
                              returns "Int"
                            }
                          }
                        ]
                      ]
                    }
                    "k"
                  ]
                  procedure "asking"
                }
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

