(test 1)
(name "a-const-procedure-read-out-of-a-dictionary-answers-without-running")
(note "A slot writing `Dictionary<String, const (Int) -> Int>` says it of every entry, the way an array of them does. `asking` declares `const` and calls an entry it reads out by a key, which the build holds it to, so an operand may call it.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure asking
    (const)
    (parameter body (type (dictionary String (procedure (const) (parameters Int) (returns Int)))))
    (parameter key (type String))
    (returns Int)
    (body
      (let a (apply (path body (index key)) 1)))
    (result a))
  (procedure entry
    (access public)
    (const)
    (returns Int)
    (result
      (call Standard.Numeric.plus
        (call asking
          (dictionary
            (entry "k"
              (closure
                (const)
                (isolated)
                (parameter x (type Int))
                (returns Int)
                (result x))))
          "k")
        1))))
(expect (answers 2))
