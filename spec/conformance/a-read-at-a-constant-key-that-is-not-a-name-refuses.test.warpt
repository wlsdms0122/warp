warpt 1
{
  expect {
    refuses "build"
  }
  name "a-read-at-a-constant-key-that-is-not-a-name-refuses"
  note "A constant between the brackets settles at the build, and empty text names no entry, so the read refuses there."
  program {
    const {
      K ""
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<Int>"
            value {
              record {
                a 1
              }
            }
          }
        ]
        result {
          ref "d[K]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

