warpt 1
{
  expect {
    refuses "load"
  }
  name "a-contract-procedure-takes-self-first"
  note "A contract's procedure is answered about the value it takes first, and that value is of the type answering the contract, written `Self`. One taking a string first names no value a type could answer about, which the contract's text says alone, so it refuses at the load."
  program {
    contracts {
      "App.Named" {
        procedures {
          name {
            parameters [
              {
                name "of"
                type "String"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

