(test 1)
(name "a-call-filling-a-parameter-from-the-bodys-own-and-a-reading-of-any-refuses")
(note "App.g answers App.pick([n], j), with j read as Array<Any>, which fills E as Array<Any>. App.g then answers Array<Any> where it promises Array<some T>, and a body takes only a value of its own parameter there, so it refuses at the build.")

(program
  (warp 1)
  (procedure App.g
    (parameter n (type (some T)))
    (parameter j (type (array Any)))
    (returns (array (some T)))
    (body
      (let p (call App.pick (array n) j))
      (return p)))
  (procedure App.pick
    (parameter a (type (some E)))
    (parameter b (type (some E)))
    (returns (some E))
    (body
      (return b)))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (let r (call App.g 1 (array "s")))
      (return r))))
(expect (refuses build))
