(test 1)
(name "a-variable-holding-a-const-procedure-is-not-a-const-slot")
(note "A variable that declared no type holds what its last write put in it, so a value it held from a slot of a `const` procedure type says nothing once a `set` may have written another. A body calling it does not answer without running, and an operand may not call it.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure asking
    (parameter f (type (procedure (const) (parameters Int) (returns Int))))
    (parameter g (type (procedure (parameters Int) (returns Int))))
    (returns Int)
    (failing (anything))
    (body
      (var x f)
      (set x g)
      (let a (apply x 1))
      (return a)))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (return
        (call Standard.Numeric.plus
          (call asking
            (closure
              (parameter x (type Int))
              (returns Int)
              (body
                (return x)))
            (closure
              (parameter x (type Int))
              (returns Int)
              (body
                (return x))))
          1)))))
(expect (refuses build))
