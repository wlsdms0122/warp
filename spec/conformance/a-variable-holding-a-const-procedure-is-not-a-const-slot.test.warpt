warpt 1
{
  expect {
    refuses "build"
  }
  name "a-variable-holding-a-const-procedure-is-not-a-const-slot"
  note "A variable that declared no type holds what its last write put in it, so a value it held from a `const Procedure` slot says nothing once a `set` may have written another. A body calling it does not answer without running, and an operand may not call it."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      asking {
        body [
          {
            value {
              ref "f"
            }
            var "x"
          }
          {
            set "x"
            value {
              ref "g"
            }
          }
          {
            let "a"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "x"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "f"
            type {
              "const procedure" {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
          }
          {
            name "g"
            type {
              procedure {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      closure {
                        parameters [
                          {
                            name "x"
                            type "Int"
                          }
                        ]
                        result {
                          ref "x"
                        }
                        returns "Int"
                      }
                    }
                    {
                      closure {
                        parameters [
                          {
                            name "x"
                            type "Int"
                          }
                        ]
                        result {
                          ref "x"
                        }
                        returns "Int"
                      }
                    }
                  ]
                  procedure "asking"
                }
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

