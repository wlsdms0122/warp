warpt 1
{
  expect {
    refuses "load"
  }
  name "a-construct-key-in-an-argument-refuses"
  note "A construct key outside a statement's `value` is not a construct. Written bare in an argument, `{ conditional … }` is read as an expression form, no form is named `conditional`, and it refuses at the load."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                conditional {
                  then [
                    {
                      value 1
                    }
                  ]
                  when true
                }
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

