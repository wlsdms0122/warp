warpt 1
{
  expect {
    answers 1
  }
  name "a-contract-procedure-answering-self-hands-a-struct-back-applied-as-it-came-answers"
  note "A call through a contract reads `Self` as the type handed, so a procedure answering `Self` for an `App.Box<Int>` answers an `App.Box<Int>`, whose field reads as `Int`."
  program {
    contracts {
      "App.Same" {
        procedures {
          same {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "Self"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "c"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "App.Same.same"
              }
            }
          }
        ]
        result {
          ref "c.item"
        }
        returns "Int"
      }
    }
    types {
      "App.Box" {
        procedures {
          same {
            parameters [
              {
                name "of"
                type "App.Box<some T>"
              }
            ]
            result {
              ref "of"
            }
            returns "App.Box<some T>"
          }
        }
        satisfies [
          "App.Same"
        ]
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

