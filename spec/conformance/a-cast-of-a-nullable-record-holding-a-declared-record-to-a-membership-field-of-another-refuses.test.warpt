warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-nullable-record-holding-a-declared-record-to-a-membership-field-of-another-refuses"
  note "`Bank.A` and `Bank.B` are both declared `{ k: string }`, `App.M2` admits `Bank.B` and `int`, and `n` is read as `App.NRA`, which stands for `{ f: Bank.A }?`. Its field keeps the name `Bank.A` wherever it is settled, so a value of it is one of `{ f: App.M2 }` only if that field is a `Bank.B` or a whole number, and it is neither. No value is both, so the cast refuses at the build."
  program {
    constraints {
      "App.M2" [
        "Bank.B"
        "int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "a"
            type "Bank.A"
            value {
              record {
                k "x"
              }
            }
          }
          {
            let "n"
            type "App.NRA"
            value {
              record {
                f {
                  ref "a"
                }
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "n"
                }
                type {
                  record {
                    f "App.M2"
                  }
                }
              }
            }
          }
        ]
        result 0
      }
    }
    types {
      "App.NRA" "App.RA?"
      "App.RA" {
        record {
          f "Bank.A"
        }
      }
      "Bank.A" {
        record {
          k "string"
        }
      }
      "Bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

