(test 1)
(name "a-dictionary-literal-whose-values-do-not-join-handed-at-a-dictionary-of-a-bounded-parameter-refuses")
(note "`App.g` bounds `T` by `App.M`, which `Int` and `String` conform to, and takes `Dictionary<String, some T>`. The dictionary literal holding `1` under `a` and `true` under `b` handed there fills `T` with each of its values, `Int` and `Bool`. The two do not join, and `Bool` conforms to no bound, so the call refuses at the build.")

(program
  (warp 1)
  (contract App.M)
  (extension
    (head Int)
    (satisfies App.M))
  (extension
    (head String)
    (satisfies App.M))
  (procedure App.g
    (parameter x (type (dictionary String (some T App.M))))
    (returns Int)
    (body
      (return 0)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let r (call App.g (dictionary (entry "a" 1) (entry "b" true))))
      (return r))))
(expect (refuses build))
