warpt 1
{
  expect {
    refuses "load"
  }
  name "a-branch-both-of-whose-arms-leave-ends-the-body"
  note "The leave rules reach through structure: a branch both of whose arms leave never finishes, so nothing may follow it and no name may bind it."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            value {
              branch {
                else [
                  {
                    value {
                      return 2
                    }
                  }
                ]
                then [
                  {
                    value {
                      return 1
                    }
                  }
                ]
                when true
              }
            }
          }
          {
            let "after"
            value 3
          }
        ]
        result {
          ref "after"
        }
      }
    }
    warp 2
  }
  test 1
}
