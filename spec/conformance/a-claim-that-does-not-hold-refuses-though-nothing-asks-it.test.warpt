(test 1)
(name "a-claim-that-does-not-hold-refuses-though-nothing-asks-it")
(note "A claim is held where it is written, to the members of its type within what its document stands on. T.Card gives itself no `describe`, so the claim that it answers App.Describable refuses at the build, though the program never asks the contract of the type.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))

(program
  (warp 1)
  (import T.Card)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let card (as (struct (field rank 3)) T.Card)))
    (result (path card (field rank)))))
(expect (refuses build))
