warpt 1
{
  expect {
    refuses "load"
  }
  name "inout-written-outside-a-parameter-refuses"
  note "`inout` is written on a parameter's type and nowhere else, since only a parameter is handed a variable in place. A declared type's field written `inout` is refused at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    types {
      Box {
        record {
          held "inout Int"
        }
      }
    }
    warp 1
  }
  test 1
}

