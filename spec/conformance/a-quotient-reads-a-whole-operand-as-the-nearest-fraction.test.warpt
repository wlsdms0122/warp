(test 1)
(name "a-quotient-reads-a-whole-operand-as-the-nearest-fraction")
(note "The quotient is binary64's own: a whole operand reads as the fraction nearest it first. 9007199254740993 reads as 9007199254740992.0, and the division rounds once more. Two implementations must spell the same quotient bit for bit.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (result (call Standard.Numeric.dividedBy 9007199254740993 3))))
(expect (answers 3002399751580330.5))
