warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      imports []
      warp 1
    }
    {
      imports []
      types {
        "T.Card" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "T.Card"
                }
              ]
              result "card"
              returns "String"
            }
          }
          struct {
            rank "Int"
          }
        }
      }
      warp 1
    }
    {
      extensions {
        "T.Card" {
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports [
        "App.Describable"
        "T.Card"
      ]
      procedures {
        "Glue.mark" {
          access "public"
          result 1
          returns "Int"
        }
      }
      warp 1
    }
    {
      imports [
        "App.Describable"
        "App.Describable.describe"
        "Glue.mark"
      ]
      procedures {
        "Lib.tell" {
          access "public"
          body [
            {
              let "marked"
              value {
                call {
                  procedure "Glue.mark"
                }
              }
            }
          ]
          parameters [
            {
              name "of"
              type "some T: App.Describable"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "of"
                }
              ]
              procedure "App.Describable.describe"
            }
          }
          returns "String"
        }
      }
      warp 1
    }
  ]
  expect {
    answers "card"
  }
  name "a-claim-a-document-two-steps-down-makes-answers"
  note "What a document stands on is what it names and, through that, what those documents name. The program calls Lib.tell, whose document calls Glue.mark, whose document claims T.Card answers App.Describable, so the claim is within the program's reach."
  program {
    imports [
      "Lib.tell"
      "T.Card"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    rank 1
                  }
                }
                type "T.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "Lib.tell"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

