warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-whose-fields-do-not-join-handed-at-a-dictionary-of-a-bounded-parameter-refuses"
  note "`App.g` bounds `T` by `App.M`, which admits `Int` and `String`, and takes `Dictionary<some T>`. The record `{ a: 1, b: true }` handed there fills `T` with each of its fields, `Int` and `Bool`. The two do not join, and `Bool` is what no member admits, so the call refuses at the build."
  program {
    constraints {
      "App.M" [
        "Int"
        "String"
      ]
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "Dictionary<some T>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      a 1
                      b true
                    }
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

