(test 1)
(name "an-attempt-whose-rescue-answers-a-list-literal-of-other-elements-refuses")
(note "A variable declared `Array<Dictionary<String, Array<String>>>` is set to an attempt whose body answers a list that fits and whose rescue answers a list of two map literals, one holding `[]` under `a` and one holding `[1]`. The rescue is a way the attempt writes on, so its answer is held to the declaration on its own and refuses at the build, though this run never takes it.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var ys (type (array (dictionary String (array String)))) (array (dictionary (entry "a" (array))) (dictionary (entry "a" (array "s")))))
      (set ys
        (attempt
          (body
            (conditional
              (when false)
              (then
                (call Standard.Control.abort "x"))))
          (result (array (dictionary (entry "a" (array))) (dictionary (entry "a" (array "s")))))
          (rescue
            (result (array (dictionary (entry "a" (array))) (dictionary (entry "a" (array 1))))))))
      (let n (call Standard.Collection.count ys)))
    (result n)))
(expect (refuses build))
