warpt 1
{
  expect {
    refuses "build"
  }
  name "an-attempt-whose-rescue-answers-a-list-literal-of-other-elements-refuses"
  note "A variable declared `Array<Dictionary<String, Array<String>>>` is set to an attempt whose body answers a list that fits and whose rescue answers a list of two map literals, one holding `[]` under `a` and one holding `[1]`. The rescue is a way the attempt writes on, so its answer is held to the declaration on its own and refuses at the build, though this run never takes it."
  program {
    imports [
      "Standard.Collection.count"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "Array<Dictionary<String, Array<String>>>"
            value [
              {
                dictionary [
                  [
                    "a"
                    []
                  ]
                ]
              }
              {
                dictionary [
                  [
                    "a"
                    [
                      "s"
                    ]
                  ]
                ]
              }
            ]
            var "ys"
          }
          {
            set "ys"
            value {
              attempt {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              call {
                                arguments [
                                  "x"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        when false
                      }
                    }
                  }
                ]
                rescue {
                  result [
                    {
                      dictionary [
                        [
                          "a"
                          []
                        ]
                      ]
                    }
                    {
                      dictionary [
                        [
                          "a"
                          [
                            1
                          ]
                        ]
                      ]
                    }
                  ]
                }
                result [
                  {
                    dictionary [
                      [
                        "a"
                        []
                      ]
                    ]
                  }
                  {
                    dictionary [
                      [
                        "a"
                        [
                          "s"
                        ]
                      ]
                    ]
                  }
                ]
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

