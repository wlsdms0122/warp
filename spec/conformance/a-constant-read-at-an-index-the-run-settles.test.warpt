warpt 1
{
  arguments {
    at 1
    key "1"
  }
  expect {
    answers {
      found 1
      name "0"
      nested 0
    }
  }
  name "a-constant-read-at-an-index-the-run-settles"
  note "A constant-headed path folds at the build where every index on it is settled there. Where an index is a reference the run settles, the build binds the constant's value in the body and the run reads past it like any name: a dictionary by a key, an array by a position, and a constant indexed by a constant indexed by a parameter."
  program {
    const {
      digits {
        as {
          of {
            record {
              "0" 0
              "1" 1
            }
          }
          type "Dictionary<Int>"
        }
      }
      names [
        "1"
        "0"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "at"
            type "Int"
          }
          {
            name "key"
            type "String"
          }
        ]
        result {
          record {
            found {
              ref "digits[key]"
            }
            name {
              ref "names[at]"
            }
            nested {
              ref "digits[names[at]]"
            }
          }
        }
        returns {
          record {
            found "Int"
            name "String"
            nested "Int"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

