(test 1)
(name "an-entry-handed-a-list-of-two-types-at-a-bounded-type-parameter-refuses")
(note "`xs` is `Array<some T>`, bounded by `App.C`, which `Int` and `String` both answer, and the host hands `[5, \"s\"]`. Its elements join to `Any`, which fills `T` and answers no contract, so the run refuses at the door.")

(program
  (warp 1)
  (import Standard.Text.joined)
  (import Standard.Text.text)
  (contract App.C
    (procedure f
      (parameter s (type Self))
      (parameter o (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.C)
    (procedure f
      (parameter s (type Int))
      (parameter o (type Int))
      (returns String)
      (body
        (let m (type Int) o)
        (return (call Standard.Text.joined (array "Int.f got" (call Standard.Text.text m)) " ")))))
  (extension
    (head String)
    (satisfies App.C)
    (procedure f
      (parameter s (type String))
      (parameter o (type String))
      (returns String)
      (body
        (return "String.f"))))
  (procedure entry
    (access public)
    (parameter xs (type (array (some T App.C))))
    (returns String)
    (body
      (let r (call App.C.f (path xs (index 0)) (path xs (index 1))))
      (return r))))
(arguments (argument xs (array 5 "s")))
(expect (refuses run))
