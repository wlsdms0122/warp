warpt 1
{
  expect {
    refuses "build"
  }
  name "an-enum-on-memberships-that-name-each-other-no-member-spells-refuses"
  note "`app.M` admits `app.N` and `int`, and `app.N` admits `app.M` and `bool`, so a value of `app.M` is an int or a bool, each membership met again adding no member. An `enum` on a parameter declared `app.M` lists `s`, which neither an int nor a bool spells, so the build refuses."
  program {
    constraints {
      "app.M" [
        "app.N"
        "int"
      ]
      "app.N" [
        "app.M"
        "bool"
      ]
    }
    imports []
    procedures {
      "app.g" {
        parameters [
          {
            enum [
              "s"
            ]
            name "x"
            type "app.M"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            let "z"
            value 0
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

