(test 1)
(name "a-struct-a-host-procedure-answers-short-of-its-fields-refuses")
(note "The door a host's answer comes through takes a struct of `App.Point` holding at least the fields the declaration names. `App.h` answers one holding none of them, so the answer refuses at the run where it comes through, before anything reads it.")

(vocabulary
  (struct App.Point
    (field x Int))
  (procedure App.h
    (const)
    (isolated)
    (returns App.Point)
    (answers (struct App.Point))))

(program
  (warp 1)
  (import App.h)
  (procedure entry
    (access public)
    (returns Any)
    (result (call App.h))))
(expect (refuses run))
