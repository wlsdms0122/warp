warpt 1
{
  expect {
    refuses "run"
  }
  name "a-value-arriving-through-any-into-memberships-that-name-each-other-refuses"
  note "The same memberships, with `[1, \"s\"]` arriving through a name declared `Any`. Where it arrives, asking `App.N` asks `App.M` of the same value again, which takes nothing, so the run refuses as the build does for the literal."
  program {
    constraints {
      "App.M" [
        "App.N"
        "Array<Int>"
      ]
      "App.N" [
        "App.M"
        "Bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "raw"
            type "Any"
            value [
              1
              "s"
            ]
          }
          {
            type "App.M"
            value {
              ref "raw"
            }
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

