(test 1)
(name "a-mapped-procedure-chooses-what-it-returns")
(note "A slot asking for a const procedure takes no construct, so the way such a procedure chooses among values is by calling one that chooses.")

(program
  (warp 1)
  (import Standard.Collection.map)
  (import Standard.Logic.equal)
  (import Standard.Logic.select)
  (procedure entry
    (access public)
    (const)
    (returns (array String))
    (body
      (return
        (call Standard.Collection.map
          (array 1 2)
          (closure
            (const)
            (isolated)
            (parameter item (type Int))
            (returns String)
            (body
              (return
                (call Standard.Logic.select
                  (call Standard.Logic.equal item 1)
                  (closure
                    (const)
                    (isolated)
                    (returns String)
                    (body
                      (return "one")))
                  (closure
                    (const)
                    (isolated)
                    (returns String)
                    (body
                      (return "other"))))))))))))
(expect (answers (array "one" "other")))
