warpt 1
{
  expect {
    answers {
      left 1
      right 2
    }
  }
  name "all-answers-every-piece-under-its-key"
  note "Running at once is a procedure, not grammar. `Standard.Concurrent.allKeyed` runs every piece it is handed under a key and answers each piece's answer under the key the piece stood under."
  program {
    imports [
      "Standard.Concurrent.allKeyed"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "both"
            value {
              call {
                arguments [
                  {
                    dictionary [
                      [
                        "left"
                        {
                          closure {
                            result 1
                          }
                        }
                      ]
                      [
                        "right"
                        {
                          closure {
                            result 2
                          }
                        }
                      ]
                    ]
                  }
                ]
                procedure "Standard.Concurrent.allKeyed"
              }
            }
          }
        ]
        result {
          ref "both"
        }
      }
    }
    warp 1
  }
  test 1
}

