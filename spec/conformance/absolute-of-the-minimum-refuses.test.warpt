warpt 1
{
  expect {
    refuses "run"
  }
  name "absolute-of-the-minimum-refuses"
  note "absolute answers an int only when an int holds the answer. The procedure's own minimum is the one magnitude the procedure does not hold, and the refusal is the overflow rule, not a special case."
  program {
    imports [
      "std.math.absolute"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              -9223372036854775808
            ]
            procedure "std.math.absolute"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

