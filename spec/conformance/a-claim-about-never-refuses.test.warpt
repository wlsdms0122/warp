warpt 1
{
  expect {
    refuses "load"
  }
  name "a-claim-about-never-refuses"
  note "A claim is about a type a value is an instance of. Nothing is ever a value of `Never`, so a claim about it is refused where the document is read."
  program {
    contracts {
      "App.Described" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    satisfies {
      Never [
        "App.Described"
      ]
    }
    warp 1
  }
  test 1
}

