(test 1)
(name "a-claim-about-never-refuses")
(note "A claim is about a type a value is an instance of. Nothing is ever a value of `Never`, so a claim about it is refused where the document is read.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Never)
    (satisfies App.Described))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses load))
