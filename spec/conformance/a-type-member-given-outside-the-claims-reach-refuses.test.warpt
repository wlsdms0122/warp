warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports []
      types {
        "App.Box" {
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
        }
        "App.Plain" {
          struct {
            x "Int"
          }
        }
      }
      warp 1
    }
    {
      extensions {
        "App.Box<some T>" {
          types {
            Item "some T"
          }
        }
      }
      imports [
        "App.Box"
      ]
      warp 1
    }
    {
      extensions {
        "App.Box<some T>" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
        }
      }
      imports [
        "App.Box"
        "Lib.Container"
      ]
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-type-member-given-outside-the-claims-reach-refuses"
  note "The extension claiming `Lib.Container` for App.Box stands on no document giving App.Box the type member Item, so the claim refuses at the build."
  program {
    imports [
      "App.Box"
      "App.Box: Lib.Container"
      "Int.plus"
      "Lib.firstOf"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "x"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "Lib.firstOf"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
              1
            ]
            procedure "Int.plus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

