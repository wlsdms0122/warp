warpt 1
{
  expect {
    refuses "build"
  }
  name "a-const-slot-refuses-a-closure-that-calls-what-runs"
  note "What a closure sends is a fact about its text, so a slot asking `const procedure` is answered at the build. A procedure that reaches outside the run is not one such a closure may send."
  program {
    imports [
      "app.ask"
      "std.logic.and"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            of [
              {
                closure {
                  result {
                    call {
                      procedure "app.ask"
                    }
                  }
                  returns "bool"
                }
              }
            ]
            procedure "std.logic.and"
          }
        }
        returns "bool"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.ask" {
        answers true
        returns "bool"
        runs true
      }
    }
  }
}

