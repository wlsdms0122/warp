warpt 1
{
  expect {
    refuses "build"
  }
  name "a-const-slot-refuses-a-closure-that-calls-what-runs"
  note "What a closure sends is a fact about its text, so a slot asking a `const` procedure type is answered at the build. A procedure that reaches outside the run is not one such a closure may send."
  program {
    imports [
      "App.ask"
      "Standard.Logic.and"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result {
                      call {
                        procedure "App.ask"
                      }
                    }
                    returns "Bool"
                  }
                }
              ]
            ]
            procedure "Standard.Logic.and"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    imports []
    procedures {
      "App.ask" {
        answers true
        returns "Bool"
        runs true
      }
    }
  }
}

