(test 1)
(name "a-const-slot-refuses-a-closure-that-calls-what-runs")
(note "What a closure sends is a fact about its text, so a slot asking a `const` procedure type is answered at the build. A procedure that reaches outside the run is not one such a closure may send. The closure sends `App.ask` and says only `isolated`, so `Standard.Logic.and` refuses it at the slot.")

(vocabulary
  (procedure App.ask
    (isolated)
    (returns Bool)
    (answers true)))

(program
  (warp 1)
  (import App.ask)
  (import Standard.Logic.and)
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (return
        (call Standard.Logic.and
          (array
            (closure
              (isolated)
              (returns Bool)
              (body
                (return (call App.ask))))))))))
(expect (refuses build))
