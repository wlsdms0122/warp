warpt 1
{
  expect {
    refuses "build"
  }
  name "an-extension-of-a-name-nothing-declares-refuses"
  note "Nothing in this link declares `App.Later`, and a name a document stands on is declared within what it stands on, so the extension giving it a member refuses at the build."
  program {
    extensions {
      "App.Later" {
        procedures {
          m {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result 7
            returns "Int"
          }
        }
      }
    }
    imports [
      "App.Later"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "App.Later.m"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

