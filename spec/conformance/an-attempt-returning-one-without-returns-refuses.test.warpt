warpt 1
{
  expect {
    refuses "build"
  }
  name "an-attempt-returning-one-without-returns-refuses"
  note "A `return` inside an attempt's body is a way out of the body like any other, so a body that returns a value written `linear` from there writes `returns` too. The rescue aborts, so the `return` inside the attempt is the only answer `make` has, and `entry` hands it to `App.close`."
  program {
    imports [
      "App.close"
      "App.open"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                procedure "make"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "held"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
      make {
        body [
          {
            value {
              attempt {
                body [
                  {
                    let "checked"
                    value {
                      as {
                        of 0
                        type "Int(0...255)"
                      }
                    }
                  }
                  {
                    value {
                      return {
                        call {
                          procedure "App.open"
                        }
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      value {
                        call {
                          arguments [
                            "failed"
                          ]
                          procedure "Standard.Control.abort"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

