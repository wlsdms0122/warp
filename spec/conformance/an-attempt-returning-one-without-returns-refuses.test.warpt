warpt 1
{
  expect {
    refuses "build"
  }
  name "an-attempt-returning-one-without-returns-refuses"
  note "A `return` inside an attempt's body is a way out of the body like any other, so a body that returns a value written `linear` from there writes `returns` too."
  program {
    imports [
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                procedure "make"
              }
            }
          }
        ]
      }
      make {
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "checked"
                    value {
                      as {
                        of 0
                        type "int(0...255)"
                      }
                    }
                  }
                  {
                    value {
                      return {
                        call {
                          procedure "app.open"
                        }
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      let "seen"
                      value 1
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

