(test 1)
(name "greater-than-mirrors-less-than")
(note "greaterThan orders two of one type the same way lessThan does, read from the other side.")

(program
  (warp 1)
  (import Standard.Math.greaterThan)
  (procedure entry
    (access public)
    (returns (array Bool))
    (body
      (let yes (call Standard.Math.greaterThan 3 2))
      (let no (call Standard.Math.greaterThan "a" "b"))
      (return (array yes no)))))
(expect (answers (array true false)))
