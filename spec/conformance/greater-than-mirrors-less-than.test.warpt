warpt 1
{
  expect {
    answers [
      true
      false
    ]
  }
  name "greater-than-mirrors-less-than"
  note "greaterThan orders two of a kind the same way lessThan does, read from the other side."
  program {
    imports [
      "std.math.greaterThan"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "yes"
            value {
              call {
                arguments {
                  value 2
                }
                of 3
                procedure "std.math.greaterThan"
              }
            }
          }
          {
            let "no"
            value {
              call {
                arguments {
                  value "b"
                }
                of "a"
                procedure "std.math.greaterThan"
              }
            }
          }
        ]
        result [
          {
            ref "yes"
          }
          {
            ref "no"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

