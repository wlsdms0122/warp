(test 1)
(name "a-cast-that-does-not-match-fails")
(note "A cast is a claim about what will arrive, and the run is where what arrived is known. A value that is not the named type fails there with `cast_refused`, a failure like any other, so a `try` catches it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns (optional String))
    (body
      (var tried)
      (let caught
        (try
          (body
            (as payload Int))
          (catch
            (set tried (path caught (field type))))))
      (return tried))))
(arguments (argument payload "not a whole number"))
(expect (answers "cast_refused"))
