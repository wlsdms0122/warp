warpt 1
{
  expect {
    answers "x"
  }
  name "a-contract-answer-is-read-as-it-wrote-and-hands-on-what-the-call-filled-answers"
  note "`App.Paired.pair` takes `some T` and answers `Array<some T>`, and `Bank.Card.pair` writes no `returns` and answers `[a]`. The call reads the answer by what the contract wrote, filled with what the call filled `T` with, so `p[0]` reads the text handed in."
  program {
    contracts {
      "App.Paired" {
        pair {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "a"
              type "some T"
            }
          ]
          returns "Array<some T>"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.pair" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "a"
            type "some U"
          }
        ]
        result [
          {
            ref "a"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "p"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  "x"
                ]
                procedure "App.Paired.pair"
              }
            }
          }
        ]
        result {
          ref "p[0]"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Paired"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

