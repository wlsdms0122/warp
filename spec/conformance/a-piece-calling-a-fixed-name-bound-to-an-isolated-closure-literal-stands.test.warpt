(test 1)
(name "a-piece-calling-a-fixed-name-bound-to-an-isolated-closure-literal-stands")
(note "A fixed name that writes no type follows the type written where its value came from, and a closure literal writes its signature, so `bump`, bound to a literal declaring `isolated`, holds an `isolated` procedure type. A piece declaring `isolated` that captured `bump` and calls it on its own variable holds to `isolated`, and `Standard.Concurrent.map` runs it.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns (array Int))
    (failing concurrent_failed)
    (body
      (let bump
        (closure
          (isolated)
          (parameter c (type (inout Int)))
          (body
            (set c (call Standard.Numeric.plus c 1))))))
    (result
      (call Standard.Concurrent.map
        (array 1 2)
        (closure
          (isolated)
          (parameter x (type Int))
          (parameter i (type Int))
          (returns Int)
          (failing (anything))
          (body
            (var m 0)
            (apply bump m))
          (result m))))))
(expect (answers (array 1 1)))
