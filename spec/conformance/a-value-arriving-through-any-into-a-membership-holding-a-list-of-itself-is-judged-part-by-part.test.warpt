warpt 1
{
  expect {
    refuses "run"
  }
  name "a-value-arriving-through-any-into-a-membership-holding-a-list-of-itself-is-judged-part-by-part"
  note "`App.M` admits `int` and `array<App.M>`, and `[[1, \"s\"]]` arrives through a name declared `any`. Where it arrives each element is asked of `App.M` as a value of its own, so the string refuses at the run."
  program {
    constraints {
      "App.M" [
        "int"
        "array<App.M>"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "raw"
            type "any"
            value [
              [
                1
                "s"
              ]
            ]
          }
          {
            type "App.M"
            value {
              ref "raw"
            }
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

