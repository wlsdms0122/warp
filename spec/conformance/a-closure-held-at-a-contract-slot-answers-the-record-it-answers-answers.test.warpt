warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-held-at-a-contract-slot-answers-the-record-it-answers-answers"
  note "`c` is declared `{ procedure: { returns: Bank.A } }`, so its closure answers `Bank.A`, the nameless `{ k: \"x\" }` it answers taking the name. `d` holds it again at `{ procedure: { returns: App.P } }`, which `Bank.A` answers, and a slot hands a value on as it is, so the call inside `App.run` answers a `Bank.A` and `App.P.show` reaches `Bank.A.show`."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "d"
            type {
              procedure {
                returns "App.P"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

