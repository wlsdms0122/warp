warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-of-a-contract-through-an-alias-fills-a-parameter-standing-twice-refuses"
  note "`App.Shape` is a name for the contract `App.Ordered`, so a value of it is of whichever type answers the contract. `before` takes `Self` twice, and two such values are not known to be one type, through a name as without one."
  program {
    contracts {
      "App.Ordered" {
        before {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "other"
              type "Self"
            }
          ]
          returns "Bool"
        }
      }
    }
    imports []
    procedures {
      "App.check" {
        parameters [
          {
            name "x"
            type "App.Shape"
          }
          {
            name "y"
            type "App.Shape"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
              {
                ref "y"
              }
            ]
            procedure "App.Ordered.before"
          }
        }
        returns "Bool"
      }
      "Int.before" {
        parameters [
          {
            name "of"
            type "Int"
          }
          {
            name "other"
            type "Int"
          }
        ]
        result true
        returns "Bool"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              2
            ]
            procedure "App.check"
          }
        }
        returns "Bool"
      }
    }
    satisfies {
      Int [
        "App.Ordered"
      ]
    }
    types {
      "App.Shape" "App.Ordered"
    }
    warp 1
  }
  test 1
}

