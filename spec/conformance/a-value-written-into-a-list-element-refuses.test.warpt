warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-written-into-a-list-element-refuses"
  note "Writing a name that holds a value written `linear` into an element of a list carries the whole value into the list, and nothing follows it there."
  program {
    imports [
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "array<any>"
            value [
              1
            ]
            var "bag"
          }
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            set "bag[0]"
            value {
              ref "handle"
            }
          }
        ]
        result {
          ref "bag"
        }
        returns "array<any>"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

