warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-of-memberships-that-name-each-other-written-into-a-nullable-slot-refuses"
  note "`App.M` admits `App.N` and `int`, and `App.N` admits `App.M` and `bool`, so a value of `App.M` is an int or a bool, each membership met again adding no member. A variable declared `int?` starts with a name read as `App.M`. Neither membership declares null, and a bool is not an int, so the build refuses."
  program {
    constraints {
      "App.M" [
        "App.N"
        "int"
      ]
      "App.N" [
        "App.M"
        "bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "App.M"
            value 1
            var "x"
          }
          {
            type "int?"
            value {
              ref "x"
            }
            var "y"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

