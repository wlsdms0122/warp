warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-outside-a-range-refuses"
  note "A range is judged wherever an argument is settled against the parameter. For a constant argument, at the build. The declared type says which whole numbers fit, and 300 is provably not among them."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              300
            ]
            procedure "paint"
          }
        }
      }
      paint {
        parameters [
          {
            name "level"
            type "int(0...255)"
          }
        ]
        result {
          ref "level"
        }
      }
    }
    warp 1
  }
  test 1
}

