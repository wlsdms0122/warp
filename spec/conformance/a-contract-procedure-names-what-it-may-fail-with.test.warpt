(test 1)
(name "a-contract-procedure-names-what-it-may-fail-with")
(note "A contract says what a procedure it asks may fail with, the way it asks constness and isolation. `check` may fail with `aborted`, so `Int.check`, which aborts, answers it, and a call through the contract may fail with `aborted`: the attempt around it is one a run reaches.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (contract App.Checked
    (procedure check
      (parameter of (type Self))
      (returns Int)
      (failing aborted)))
  (extension
    (head Int)
    (satisfies App.Checked)
    (procedure check
      (parameter of (type Int))
      (returns Int)
      (failing aborted)
      (result (call Standard.Control.abort "no"))))
  (procedure entry
    (access public)
    (returns (nullable String))
    (body
      (var failed)
      (let caught
        (attempt
          (body
            (call App.Checked.check 1))
          (rescue
            (set failed (path caught (field type)))))))
    (result failed)))
(expect (answers "aborted"))
