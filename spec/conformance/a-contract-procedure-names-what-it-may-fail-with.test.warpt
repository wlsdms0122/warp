warpt 1
{
  expect {
    answers "aborted"
  }
  name "a-contract-procedure-names-what-it-may-fail-with"
  note "A contract says what a procedure it asks may fail with, the way it asks constness and isolation. `check` may fail with `aborted`, so `Int.check`, which aborts, answers it, and a call through the contract may fail with `aborted`: the attempt around it is one a run reaches."
  program {
    contracts {
      "App.Checked" {
        procedures {
          check {
            failing [
              "aborted"
            ]
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          check {
            failing [
              "aborted"
            ]
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result {
              call {
                arguments [
                  "no"
                ]
                procedure "Standard.Control.abort"
              }
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Checked"
        ]
      }
    }
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "failed"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          1
                        ]
                        procedure "App.Checked.check"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    ref "failed.type"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "failed"
        }
        returns "String?"
      }
    }
    warp 1
  }
  test 1
}

