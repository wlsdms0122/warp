warpt 1
{
  expect {
    answers "a card"
  }
  name "a-contract-stands-where-a-type-is-written"
  note "A contract's name stands where a type is written: the slot takes a value of whatever type satisfies it, the body calls the contract's procedure without knowing which type it holds, and no name ties the slot to any other."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        parameters [
          {
            name "it"
            type "App.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

