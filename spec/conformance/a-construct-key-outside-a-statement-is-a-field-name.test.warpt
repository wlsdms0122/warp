warpt 1
{
  expect {
    answers 1
  }
  name "a-construct-key-outside-a-statement-is-a-field-name"
  note "A construct key is read directly under a statement's value and nowhere else. In an argument, a record carrying `conditional` is a record with one field, and count reads it as such."
  program {
    imports [
      "std.collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            of {
              conditional {
                when true
              }
            }
            procedure "std.collection.count"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

