warpt 1
{
  expect {
    answers 1
  }
  name "a-construct-key-outside-a-statement-is-a-field-name"
  note "A construct key is read directly under a statement's `value` and nowhere else. Under `record` it is a field name like any other, so the argument is a record with one field named `conditional`, and `count` reads it as such."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                record {
                  conditional {
                    record {
                      when true
                    }
                  }
                }
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

