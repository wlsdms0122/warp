warpt 1
{
  expect {
    answers true
  }
  name "a-construct-key-outside-a-statement-is-a-field-name"
  note "A construct key is read directly under a statement's `value` and nowhere else. Under `record` it is a field name like any other, so the value is a record with one field named `conditional`, and a path reads through it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "App.C"
            value {
              record {
                conditional {
                  record {
                    when true
                  }
                }
              }
            }
          }
        ]
        result {
          ref "c.conditional.when"
        }
        returns "Bool"
      }
    }
    types {
      "App.C" {
        record {
          conditional "App.When"
        }
      }
      "App.When" {
        record {
          when "Bool"
        }
      }
    }
    warp 1
  }
  test 1
}

