warpt 1
{
  expect {
    answers true
  }
  name "not-and-notequal-say-the-opposite"
  note "notEqual answers what equal would deny, and not turns a truth around. The negations answer by the language's one sameness."
  program {
    imports [
      "std.logic.not"
      "std.logic.notEqual"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "unequal"
            value {
              call {
                arguments [
                  1
                  1.0
                ]
                procedure "std.logic.notEqual"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "unequal"
              }
            ]
            procedure "std.logic.not"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

