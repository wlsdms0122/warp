(test 1)
(name "a-type-parameter-read-as-closures-returning-a-string-and-anything-returns-anything")
(note "`fa` writes `returns Any` and returns 1, and `fs` returns a string. `App.pick` hands back its second argument, and the call reads `E` from both: a procedure returning `Any` takes one returning a string, so `E` is the one returning `Any`, and so is `r`. Its return value stands beside the string in a list of anything.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure App.pick
    (parameter a (type (some E)))
    (parameter b (type (some E)))
    (returns (some E))
    (body
      (return b)))
  (procedure entry
    (access public)
    (returns (array Any))
    (failing (anything))
    (body
      (let fs
        (closure
          (returns String)
          (body
            (return "x"))))
      (let fa
        (closure
          (returns Any)
          (body
            (return 1))))
      (let r (call App.pick fs fa))
      (let v (apply r))
      (let t (call Standard.Collection.appending (array v) "z"))
      (return t))))
(expect (answers (array 1 "z")))
