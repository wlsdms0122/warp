warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-argument-outside-enum-refuses"
  note "`enum` is judged wherever an argument is judged against the parameter. For a constant argument, at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "got"
            value {
              call {
                arguments [
                  "medium"
                ]
                procedure "pick"
              }
            }
          }
        ]
        result {
          ref "got"
        }
      }
      pick {
        parameters [
          {
            enum [
              "fast"
              "slow"
            ]
            name "mode"
            type "String"
          }
        ]
        result {
          ref "mode"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

