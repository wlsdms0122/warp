warpt 1
{
  expect {
    refuses "build"
  }
  name "a-procedure-a-call-filled-from-a-declared-struct-takes-no-int-refuses"
  note "`App.make` answers the procedure it is handed as one taking `some T`. The point fills `T` with `App.Point`; the closure's `Any` fills nothing, so `h` takes `App.Point`, and calling it with `5` refuses at the build."
  program {
    imports []
    procedures {
      "App.make" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "f"
            type {
              procedure {
                parameters [
                  "some T"
                ]
                returns "Any"
              }
            }
          }
        ]
        result {
          ref "f"
        }
        returns {
          procedure {
            parameters [
              "some T"
            ]
            returns "Any"
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "h"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        struct {
                          x 1
                        }
                      }
                      type "App.Point"
                    }
                  }
                  {
                    closure {
                      parameters [
                        {
                          name "p"
                        }
                      ]
                      result {
                        ref "p"
                      }
                      returns "Any"
                    }
                  }
                ]
                procedure "App.make"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              5
            ]
            procedure {
              ref "h"
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

