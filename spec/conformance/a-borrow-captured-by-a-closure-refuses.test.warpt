warpt 1
{
  expect {
    refuses "build"
  }
  name "a-borrow-captured-by-a-closure-refuses"
  note "A closure runs where the lending call cannot see, so a closure may not capture a name its body borrowed, even to read a part of it."
  program {
    imports [
      "App.Handle"
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            let "later"
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "stash"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
      stash {
        parameters [
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
        result {
          closure {
            result {
              ref "of.name"
            }
            returns "string"
          }
        }
        returns {
          procedure {
            returns "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

