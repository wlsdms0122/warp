warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bare-key-that-is-not-an-identifier-refuses"
  note "Text is written bare in key position only when it is an identifier, and quoted otherwise. `a-b` is no identifier and spells no value, so a bare token written so is no key."
  test 1
  text "warpt 1\n{\n  a-b 1\n}\n"
}

