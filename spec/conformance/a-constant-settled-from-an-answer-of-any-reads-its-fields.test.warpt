warpt 1
{
  documents [
    {
      imports []
      procedures {
        "K.make" {
          body [
            {
              let "p"
              type "K.P"
              value {
                record {
                  x 1
                }
              }
            }
          ]
          result {
            ref "p"
          }
          returns "Any"
        }
      }
      types {
        "K.P" {
          record {
            x "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    answers 1
  }
  name "a-constant-settled-from-an-answer-of-any-reads-its-fields"
  note "`K.make` declares it answers `Any`, and the constant settled from it is a `K.P` with `x`. The constant's settled value is its type, so a dot reads `x` without `as` and the program builds."
  program {
    const {
      made {
        call {
          procedure "K.make"
        }
      }
    }
    imports [
      "K.make"
    ]
    procedures {
      entry {
        access "public"
        result {
          ref "made.x"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

