warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-to-a-procedure-answering-another-struct-reads-null-answers"
  note "`c` is declared `() -> Bank.A` and holds a closure writing `returns Bank.A`, and it travels through `Any`. `Bank.B` never takes a `Bank.A`, so the asking cast to `() -> Bank.B` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "() -> Bank.A"
            value {
              closure {
                result {
                  struct {
                    k "x"
                  }
                }
                returns "Bank.A"
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type "() -> Bank.B"
              }
            }
          }
        ]
        result {
          ref "v"
        }
        returns "(() -> Bank.B)?"
      }
    }
    types {
      "Bank.A" {
        struct {
          k "String"
        }
      }
      "Bank.B" {
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

