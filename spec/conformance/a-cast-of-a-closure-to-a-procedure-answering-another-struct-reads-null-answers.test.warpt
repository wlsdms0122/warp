(test 1)
(name "a-cast-of-a-closure-to-a-procedure-answering-another-struct-reads-null-answers")
(note "`c` is declared `() -> Bank.A` and holds a closure writing `returns Bank.A`, and it travels through `Any`. `Bank.B` never takes a `Bank.A`, so the asking cast to `() -> Bank.B` reads it as null.")

(program
  (warp 1)
  (struct Bank.A
    (field k String))
  (struct Bank.B
    (field k String))
  (procedure entry
    (access public)
    (returns (nullable (procedure (parameters) (returns Bank.B))))
    (body
      (let c
        (type (procedure (parameters) (returns Bank.A)))
        (closure
          (returns Bank.A)
          (result (struct (field k "x")))))
      (let a (type Any) c)
      (let v (as? a (procedure (parameters) (returns Bank.B)))))
    (result v)))
(expect (answers null))
