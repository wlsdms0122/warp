warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-to-a-procedure-answering-another-struct-reads-null-answers"
  note "`c` is declared `{ procedure: { returns: Bank.A } }`, so its closure, which writes no `returns`, answers `Bank.A`, and it travels through `Any`. `Bank.B` never takes a `Bank.A`, so the asking cast to `{ procedure: { returns: Bank.B } }` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  struct {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    returns "Bank.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    types {
      "Bank.A" {
        struct {
          k "String"
        }
      }
      "Bank.B" {
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

