warpt 1
{
  expect {
    refuses "build"
  }
  name "a-field-the-declared-answer-does-not-name-refuses"
  note "Once the answer of `all` is settled into a declared record, a field the declaration does not name is refused where it is read: at the build, and not as null at the run."
  program {
    imports [
      "std.concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "both"
            value {
              as "Answers"
              of {
                call {
                  arguments [
                    {
                      left {
                        closure {
                          result 1
                        }
                      }
                      right {
                        closure {
                          result 2
                        }
                      }
                    }
                  ]
                  procedure "std.concurrent.all"
                }
              }
            }
          }
        ]
        result {
          ref "both.middle"
        }
        returns "int"
      }
    }
    types {
      Answers {
        left "int"
        right "int"
      }
    }
    warp 1
  }
  test 1
}

