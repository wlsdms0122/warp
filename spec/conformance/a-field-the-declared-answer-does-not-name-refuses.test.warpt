warpt 1
{
  expect {
    refuses "build"
  }
  name "a-field-the-declared-answer-does-not-name-refuses"
  note "Once what `all` answers is cast to a declared record, a field the declaration does not name is refused where it is read: at the build, and not as null at the run."
  program {
    imports [
      "Standard.Concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "both"
            value {
              as {
                of {
                  call {
                    arguments [
                      {
                        record {
                          left {
                            closure {
                              result 1
                            }
                          }
                          right {
                            closure {
                              result 2
                            }
                          }
                        }
                      }
                    ]
                    procedure "Standard.Concurrent.all"
                  }
                }
                type "Answers"
              }
            }
          }
        ]
        result {
          ref "both.middle"
        }
        returns "Int"
      }
    }
    types {
      Answers {
        record {
          left "Int"
          right "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

