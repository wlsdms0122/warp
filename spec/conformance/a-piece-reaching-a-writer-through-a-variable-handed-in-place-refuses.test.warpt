(test 1)
(name "a-piece-reaching-a-writer-through-a-variable-handed-in-place-refuses")
(note "A variable handed in place to a slot saying a `const isolated` procedure type, and kept there by the closure the callee answers, is held to that type from the call on. A later `set` of a closure that writes a captured variable does not fit, so the build refuses it and no piece of `Standard.Concurrent.map` reaches the writer.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (import Standard.Numeric.plus)
  (procedure App.keep
    (parameter f (type (inout (procedure (const) (isolated) (parameters Int Int) (returns Int)))))
    (returns (procedure (isolated) (parameters Int Int) (returns Int)))
    (result
      (closure
        (parameter x (type Int))
        (parameter i (type Int))
        (returns Int)
        (body
          (let y (apply f x i)))
        (result y))))
  (procedure entry
    (access public)
    (returns Never)
    (failing concurrent_failed)
    (body
      (var h
        (closure
          (parameter x (type Int))
          (parameter i (type Int))
          (returns Int)
          (result x)))
      (let k (call App.keep h))
      (var count 0)
      (set h
        (closure
          (parameter x (type Int))
          (parameter i (type Int))
          (returns Int)
          (body
            (set count (call Standard.Numeric.plus count 1)))
          (result x)))
      (let out (call Standard.Concurrent.map (array 1 2 3) k)))
    (result (struct (field count count) (field out out)))))
(expect (refuses build))
