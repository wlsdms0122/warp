warpt 1
{
  expect {
    answers "box"
  }
  name "a-cast-to-a-contract-holds-a-value-to-the-head-it-settles-into"
  note "A box holding null read as `Any` is cast to App.Describable, claimed under `App.Box<Int?>`. The value settles into the head, so it answers, though what its parts read as is `App.Box<Null>`."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    extensions {
      "App.Box<Int?>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Box<Int?>"
              }
            ]
            result "box"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "one"
            type "Any"
            value {
              as {
                of {
                  struct {
                    item null
                  }
                }
                type "App.Box<Int?>"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                as {
                  of {
                    ref "one"
                  }
                  type "App.Describable"
                }
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

