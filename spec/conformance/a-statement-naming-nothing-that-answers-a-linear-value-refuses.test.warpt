warpt 1
{
  expect {
    refuses "build"
  }
  name "a-statement-naming-nothing-that-answers-a-linear-value-refuses"
  note "A statement naming nothing drops what it answers. `App.mk` answers a handle, so the statement drops a value handed on once."
  program {
    imports [
      "App.mk"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "App.mk"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.mk" {
        answers {
          name "h"
        }
        returns "App.Handle"
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

