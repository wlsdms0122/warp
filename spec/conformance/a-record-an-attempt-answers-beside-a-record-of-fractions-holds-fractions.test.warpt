warpt 1
{
  arguments {
    payload 3
  }
  expect {
    answers 1.0
  }
  name "a-record-an-attempt-answers-beside-a-record-of-fractions-holds-fractions"
  note "An attempt's two ways join the way a list literal's elements do, field by field. Its body answers `{ a: 1 }` and its rescue `{ a: 2.5 }`, so the field is read as a fraction, the whole literal in it is the fraction it names, and `tried.a` answers `1.0`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      as {
                        of {
                          ref "payload"
                        }
                        type "Int"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    record {
                      a 2.5
                    }
                  }
                }
                result {
                  record {
                    a 1
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "payload"
            type "Any"
          }
        ]
        result {
          ref "tried.a"
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

