warpt 1
{
  arguments {
    stuff "not-a-list"
  }
  expect {
    refuses "run"
  }
  name "a-walk-over-what-is-not-a-collection-refuses-at-run"
  note "A walk takes a collection. Handed anything else, it refuses rather than walking a guess."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "walk"
            value {
              each {
                body [
                  {
                    let "noop"
                    value 1
                  }
                ]
                in {
                  ref "stuff"
                }
              }
            }
          }
        ]
        parameters {
          stuff "any"
        }
        result null
      }
    }
    warp 1
  }
  test 1
}
