warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-arriving-through-any-answers-by-the-type-it-is"
  note "`App.anything` answers `Any`, which stands where `App.Described.describe` asks the contract only through a cast, so the build refuses, whatever the run would hand there."
  program {
    contracts {
      "App.Described" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.anything" {
        result 1
        returns "Any"
      }
      "Int.describe" {
        parameters [
          {
            name "of"
            type "Int"
          }
        ]
        result "a whole number"
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  procedure "App.anything"
                }
              }
            ]
            procedure "App.Described.describe"
          }
        }
        returns "String"
      }
    }
    satisfies {
      Int [
        "App.Described"
      ]
    }
    warp 1
  }
  test 1
}

