warpt 1
{
  expect {
    answers false
  }
  name "a-document-writes-a-short-circuiting-connective"
  note "A slot asking for an array of procedures that answer without running says it about every element, so applying one is read rather than run. A document can therefore write `and` itself, stopping at the first side that settles the answer."
  program {
    imports [
      "std.collection.count"
      "std.logic.not"
      "std.math.lessThan"
    ]
    procedures {
      "app.and" {
        body [
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "side"
                    value {
                      ref "of[walk.index]"
                    }
                  }
                  {
                    let "answered"
                    value {
                      apply {
                        procedure {
                          ref "side"
                        }
                      }
                    }
                  }
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              return false
                            }
                          }
                        ]
                        when {
                          call {
                            arguments [
                              {
                                ref "answered"
                              }
                            ]
                            procedure "std.logic.not"
                          }
                        }
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "of"
                            }
                          ]
                          procedure "std.collection.count"
                        }
                      }
                    ]
                    procedure "std.math.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type {
              array {
                "const procedure" {
                  returns "bool"
                }
              }
            }
          }
        ]
        result true
        returns "bool"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result true
                    returns "bool"
                  }
                }
                {
                  closure {
                    result false
                    returns "bool"
                  }
                }
              ]
            ]
            procedure "app.and"
          }
        }
        returns "bool"
      }
    }
    warp 1
  }
  test 1
}

