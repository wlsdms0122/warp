(test 1)
(name "a-fixed-name-handed-in-place-to-a-called-value-refuses")
(note "What a call of a value hands in place is a variable. A name fixed with `let` refuses at the build, the way it does handed to a declaration.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let n 10)
      (let bump
        (closure
          (parameter count (type (inout Int)))
          (body
            (set count (call Standard.Numeric.plus count 1)))))
      (apply bump n)
      (return n))))
(expect (refuses build))
