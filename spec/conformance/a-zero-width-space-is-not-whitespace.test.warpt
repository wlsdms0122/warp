warpt 1
{
  expect {
    answers 5
  }
  name "a-zero-width-space-is-not-whitespace"
  note "Unicode does not give a zero-width space the White_Space property, so trimming leaves one where it stands however a platform's own whitespace set answers. Written as its bytes, since a character with no width is one a document cannot show."
  program {
    imports [
      "Standard.Collection.count"
      "Standard.Text.characters"
      "Standard.Text.decoded"
      "Standard.Text.joined"
      "Standard.Text.trimmed"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "thin"
            value {
              call {
                arguments [
                  x"e2808b"
                  "utf8"
                ]
                procedure "Standard.Text.decoded"
              }
            }
          }
          {
            let "written"
            value {
              call {
                arguments [
                  [
                    " "
                    "warp"
                    {
                      ref "thin"
                    }
                    " "
                  ]
                  ""
                ]
                procedure "Standard.Text.joined"
              }
            }
          }
          {
            let "bare"
            value {
              call {
                arguments [
                  {
                    ref "written"
                  }
                ]
                procedure "Standard.Text.trimmed"
              }
            }
          }
          {
            let "held"
            value {
              call {
                arguments [
                  {
                    call {
                      arguments [
                        {
                          ref "bare"
                        }
                      ]
                      procedure "Standard.Text.characters"
                    }
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "held"
        }
      }
    }
    warp 1
  }
  test 1
}

