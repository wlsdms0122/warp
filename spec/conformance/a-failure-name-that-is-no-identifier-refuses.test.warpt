(test 1)
(name "a-failure-name-that-is-no-identifier-refuses")
(note "`App.f` lists a failure named `out of range`. A failure is named by one identifier, the way `cast_refused` is, so a list naming anything else is refused where it is read.")

(program
  (warp 1)
  (procedure App.f
    (returns Int)
    (failing `out of range`)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (return (call App.f)))))
(expect (refuses load))
