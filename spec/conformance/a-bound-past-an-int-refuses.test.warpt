warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bound-past-an-int-refuses"
  note "A whole bound is a number an `int` holds. `99999999999999999999` is past what an `int` holds, and the range refuses at the load."
  program {
    imports []
    procedures {
      "app.f" {
        parameters [
          {
            name "x"
            type "int(0...99999999999999999999)"
          }
        ]
        result 1
      }
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

