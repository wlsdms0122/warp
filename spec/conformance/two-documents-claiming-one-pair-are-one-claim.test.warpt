warpt 1
{
  documents [
    {
      contracts {
        "app.Describable" {
          describe {
            returns "string"
          }
        }
      }
      imports []
      procedures {
        "app.nothing" {
          result null
        }
      }
      warp 1
    }
    {
      imports []
      procedures {
        "t.Card.describe" {
          parameters [
            {
              name "of"
              type "t.Card"
            }
          ]
          receiver "of"
          result "card"
          returns "string"
        }
      }
      types {
        "t.Card" {
          rank "int"
        }
      }
      warp 1
    }
    {
      imports [
        "app.Describable"
        "t.Card"
      ]
      procedures {
        "c.nothing" {
          result null
        }
      }
      satisfies {
        "t.Card" [
          "app.Describable"
        ]
      }
      warp 1
    }
    {
      imports [
        "app.Describable"
        "t.Card"
      ]
      procedures {
        "d.nothing" {
          result null
        }
      }
      satisfies {
        "t.Card" [
          "app.Describable"
        ]
      }
      warp 1
    }
  ]
  expect {
    answers "card"
  }
  name "two-documents-claiming-one-pair-are-one-claim"
  note "A claim holds nothing but the pair, so a second document claiming the same pair says what the first said, and the link holds one claim and not two declarations of one name."
  program {
    imports [
      "app.Describable.describe"
      "t.Card"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as "t.Card"
              of {
                rank 1
              }
            }
          }
        ]
        result {
          call {
            of {
              ref "card"
            }
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

