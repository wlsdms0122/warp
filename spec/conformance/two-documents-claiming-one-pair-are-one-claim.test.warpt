warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
      imports []
      procedures {}
      warp 1
    }
    {
      imports []
      procedures {
        "T.Card.describe" {
          parameters [
            {
              name "of"
              type "T.Card"
            }
          ]
          result "card"
          returns "String"
        }
      }
      types {
        "T.Card" {
          record {
            rank "Int"
          }
        }
      }
      warp 1
    }
    {
      description "a claim"
      imports [
        "App.Describable"
        "T.Card"
      ]
      procedures {}
      satisfies {
        "T.Card" [
          "App.Describable"
        ]
      }
      warp 1
    }
    {
      description "the same claim again"
      imports [
        "App.Describable"
        "T.Card"
      ]
      procedures {}
      satisfies {
        "T.Card" [
          "App.Describable"
        ]
      }
      warp 1
    }
  ]
  expect {
    answers "card"
  }
  name "two-documents-claiming-one-pair-are-one-claim"
  note "A claim holds nothing but the pair, so a second document claiming the same pair says what the first said, whatever else the two say, and the link holds one claim and not two declarations of one name."
  program {
    imports [
      "App.Describable.describe"
      "T.Card"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    rank 1
                  }
                }
                type "T.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

