warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      imports []
      warp 1
    }
    {
      imports []
      types {
        "T.Card" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "T.Card"
                }
              ]
              result "card"
              returns "String"
            }
          }
          struct {
            rank "Int"
          }
        }
      }
      warp 1
    }
    {
      description "one maker"
      extensions {
        "T.Card" {
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports [
        "App.Describable"
        "T.Card"
      ]
      procedures {
        "One.mark" {
          access "public"
          result 1
          returns "Int"
        }
      }
      warp 1
    }
    {
      description "another maker"
      extensions {
        "T.Card" {
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports [
        "App.Describable"
        "T.Card"
      ]
      procedures {
        "Two.mark" {
          access "public"
          result 1
          returns "Int"
        }
      }
      warp 1
    }
  ]
  expect {
    answers "card"
  }
  name "two-documents-claiming-one-pair-are-one-claim"
  note "Two documents making one claim are one claim to a document reaching both by what they name: the program calls `One.mark` and `Two.mark`, and the card answers App.Describable."
  program {
    imports [
      "App.Describable.describe"
      "One.mark"
      "T.Card"
      "Two.mark"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "one"
            value {
              call {
                procedure "One.mark"
              }
            }
          }
          {
            let "two"
            value {
              call {
                procedure "Two.mark"
              }
            }
          }
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    rank 1
                  }
                }
                type "T.Card"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

