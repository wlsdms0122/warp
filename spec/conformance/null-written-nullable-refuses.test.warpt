warpt 1
{
  expect {
    refuses "load"
  }
  name "null-written-nullable-refuses"
  note "The `?` is written only where it says something new. `null` already admits null, so `null?` says nothing new and refuses at the load."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "x"
            type "null?"
          }
        ]
        result 1
      }
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

