warpt 1
{
  expect {
    answers 1.0
  }
  name "a-whole-literal-in-a-struct-beside-a-fraction-in-one-struct-reads-as-the-fraction-answers"
  note "One struct is one type only at the same arguments, and a whole number written as a literal is read as the fraction beside it. Two literals read at `App.Box<some T>` in one list, holding `1` and `2.5`, are both `App.Box<Double>`."
  program {
    imports []
    procedures {
      "App.first" {
        parameters [
          {
            name "bs"
            type "Array<App.Box<some T>>"
          }
        ]
        result {
          ref "bs[0].item"
        }
        returns "some T"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  struct {
                    item 1
                  }
                }
                {
                  struct {
                    item 2.5
                  }
                }
              ]
            ]
            procedure "App.first"
          }
        }
        returns "Double"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

