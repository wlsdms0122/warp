(test 1)
(name "fraction-arithmetic-with-no-finite-answer-refuses")
(note "Fraction arithmetic that reaches infinity has no answer a document can carry, so it refuses at the run rather than answering a value that exists only until it is written down.")

(program
  (warp 1)
  (import Standard.Numeric.times)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.times 1e+308 10.0)))))
(expect (refuses run))
