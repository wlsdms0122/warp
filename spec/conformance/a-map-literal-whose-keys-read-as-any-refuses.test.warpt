(test 1)
(name "a-map-literal-whose-keys-read-as-any-refuses")
(note "A map literal reads as a map keyed by what its keys join to, and a whole number beside a text joins to `Any`, which does not answer `Hashable`. The name declares no map, so the literal is that map type and refuses at the build where it is written, as `Dictionary<Any, String>` written there would.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let d (dictionary (entry 1 "a") (entry "b" "c"))))
    (result 1)))
(expect (refuses build))
