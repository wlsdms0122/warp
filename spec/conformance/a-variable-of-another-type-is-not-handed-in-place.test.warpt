(test 1)
(name "a-variable-of-another-type-is-not-handed-in-place")
(note "A parameter handed in place takes the caller's own box, so the variable's declared type is the parameter's all the way in: `Array<Any>` where `inout Array<Int>` stands is refused at the build, since nothing is judged where nothing is handed over.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure App.add
    (parameter into (type (inout (array Int))))
    (parameter value (type Int))
    (body
      (set into (call Standard.Collection.appending into value))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var xs (type (array Any)) (array))
      (call App.add xs 1))
    (result 1)))
(expect (refuses build))
