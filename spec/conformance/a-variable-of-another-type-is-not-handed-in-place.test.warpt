warpt 1
{
  expect {
    refuses "build"
  }
  name "a-variable-of-another-type-is-not-handed-in-place"
  note "A parameter handed in place takes the caller's own box, so the variable's declared type is the parameter's all the way in: `Array<Any>` where `inout Array<Int>` stands is refused at the build, since nothing settles where nothing is handed over."
  program {
    imports [
      "Standard.Collection.appending"
    ]
    procedures {
      "App.add" {
        body [
          {
            set "into"
            value {
              call {
                arguments [
                  {
                    ref "into"
                  }
                  {
                    ref "value"
                  }
                ]
                procedure "Standard.Collection.appending"
              }
            }
          }
        ]
        parameters [
          {
            name "into"
            type "inout Array<Int>"
          }
          {
            name "value"
            type "Int"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            type "Array<Any>"
            value []
            var "xs"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  1
                ]
                procedure "App.add"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

