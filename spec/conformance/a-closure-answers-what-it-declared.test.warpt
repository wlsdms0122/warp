(test 1)
(name "a-closure-answers-what-it-declared")
(note "A closure literal writes a signature and a body side by side, the way a declaration does, so what its body answers is held to its `returns` where both are written.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let ran
        (call twice
          (closure
            (returns Int)
            (body
              (let said "hi")
              (return said)))))
      (return ran)))
  (procedure twice
    (parameter body (type (procedure (parameters) (returns Int))))
    (returns Int)
    (body
      (return (apply body)))))
(expect (refuses build))
