(test 1)
(name "a-set-without-a-value-refuses")
(note "Only `var` may stand without a `value`. A `set` writes something into a name, and one written without anything to write refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (body
      (var x)
      (set x))
    (result 1)))
(expect (refuses load))
