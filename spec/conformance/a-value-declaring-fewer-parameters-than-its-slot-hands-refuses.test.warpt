(test 1)
(name "a-value-declaring-fewer-parameters-than-its-slot-hands-refuses")
(note "A value standing in a procedure-typed slot takes exactly the positions the slot hands. `Standard.Concurrent.map` hands its closure the item and then its index, so a closure declaring `item` alone does not fit, and the build refuses where the value is handed.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns (array Int))
    (failing concurrent_failed)
    (body
      (return
        (call Standard.Concurrent.map
          (array 1 2)
          (closure
            (isolated)
            (parameter item (type Int))
            (returns Int)
            (body
              (return (call Standard.Numeric.plus item 1)))))))))
(expect (refuses build))
