warpt 1
{
  documents [
    {
      imports []
      procedures {
        "App.helper" {
          access "private"
          result 1
          returns "int"
        }
        "Lib.seven" {
          result {
            call {
              procedure "App.helper"
            }
          }
          returns "int"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 8
  }
  name "two-documents-may-each-declare-a-private-name"
  note "A private declaration takes no spelling from the link: its own document reaches it, and nothing else does. So two documents may each declare one under one spelling, and each reaches its own, where two declarations any other document could name would refuse."
  program {
    imports [
      "Lib.seven"
      "Standard.Math.plus"
    ]
    procedures {
      "App.helper" {
        access "private"
        result 7
        returns "int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  procedure "App.helper"
                }
              }
              {
                call {
                  procedure "Lib.seven"
                }
              }
            ]
            procedure "Standard.Math.plus"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

