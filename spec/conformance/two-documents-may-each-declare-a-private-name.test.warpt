warpt 1
{
  documents [
    {
      imports []
      procedures {
        "App.helper" {
          access "private"
          const true
          isolated true
          result 1
          returns "Int"
        }
        "Lib.seven" {
          const true
          isolated true
          result {
            call {
              procedure "App.helper"
            }
          }
          returns "Int"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 8
  }
  name "two-documents-may-each-declare-a-private-name"
  note "A private declaration takes no spelling from the link: its own document reaches it, and nothing else does. So two documents may each declare one under one spelling, and each reaches its own, where two declarations any other document could name would refuse."
  program {
    imports [
      "Lib.seven"
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.helper" {
        access "private"
        const true
        isolated true
        result 7
        returns "Int"
      }
      entry {
        access "public"
        const true
        isolated true
        result {
          call {
            arguments [
              {
                call {
                  procedure "App.helper"
                }
              }
              {
                call {
                  procedure "Lib.seven"
                }
              }
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

