(test 1)
(name "a-declaration-satisfying-a-contracts-procedure-with-a-type-where-it-writes-a-contract-refuses")
(note "The contract hands App.Sized and the declaration satisfying it takes Bank.Card there. Any type conforming to App.Sized may be handed, and a slot of Bank.Card refuses every other.")

(program
  (warp 1)
  (struct Bank.Box
    (satisfies App.Shown)
    (field n Int)
    (procedure show
      (parameter of (type Bank.Box))
      (parameter n (type Bank.Card))
      (returns String)
      (body
        (return "shown"))))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (body
        (return 4))))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Shown
    (procedure show
      (parameter of (type Self))
      (parameter n (type App.Sized))
      (returns String)))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let b (as (struct (field n 1)) Bank.Box))
      (let c (as (struct (field last "4")) Bank.Card))
      (let s (call App.Shown.show b c))
      (return s))))
(expect (refuses build))
