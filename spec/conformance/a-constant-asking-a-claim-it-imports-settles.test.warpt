(test 1)
(name "a-constant-asking-a-claim-it-imports-settles")
(note "The same constant, the program importing the claim: settling it casts the card to App.Describable within the program's reach, and the program describes it.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (const)
        (isolated)
        (parameter of (type T.Card))
        (returns String)
        (result "card"))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable)))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (procedure App.probe
      (access public)
      (const)
      (isolated)
      (returns (nullable App.Describable))
      (failing cast_refused)
      (body
        (let two (type Any) (as (struct (field rank 1)) T.Card)))
      (result (as? two App.Describable)))))

(program
  (warp 1)
  (import App.Describable)
  (import App.Describable.describe)
  (import App.probe)
  (import T.Card App.Describable)
  (const folded (call App.probe))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (result (call App.Describable.describe (as folded App.Describable)))))
(expect (answers "card"))
