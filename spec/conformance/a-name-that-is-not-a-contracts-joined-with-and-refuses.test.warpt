warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-that-is-not-a-contracts-joined-with-and-refuses"
  note "`&` joins the names of contracts. A declared type joined into one is not, and the declaration is refused at the build."
  program {
    contracts {
      Text {}
    }
    extensions {
      String {
        satisfies [
          "Text"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "it"
            type "Card & Text"
          }
        ]
        result 1
        returns "Int"
      }
    }
    types {
      Card {
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

