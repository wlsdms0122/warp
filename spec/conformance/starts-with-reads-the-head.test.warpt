warpt 1
{
  expect {
    answers [
      true
      false
    ]
  }
  name "starts-with-reads-the-head"
  note "startsWith asks whether the text begins with the value, reading as a person reads. Two spellings of one letter are one head."
  program {
    imports [
      "Standard.Text.startsWith"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "spelled"
            value {
              call {
                arguments [
                  "étoile"
                  "é"
                ]
                procedure "Standard.Text.startsWith"
              }
            }
          }
          {
            let "elsewhere"
            value {
              call {
                arguments [
                  "warp"
                  "arp"
                ]
                procedure "Standard.Text.startsWith"
              }
            }
          }
        ]
        result [
          {
            ref "spelled"
          }
          {
            ref "elsewhere"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

