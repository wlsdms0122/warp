warpt 1
{
  expect {
    answers [
      true
      false
    ]
  }
  name "starts-with-reads-the-head"
  note "startsWith asks whether the text begins with the value, reading as a person reads. Two spellings of one letter are one head."
  program {
    imports [
      "std.text.startsWith"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "spelled"
            value {
              call {
                arguments {
                  value "é"
                }
                of "étoile"
                procedure "std.text.startsWith"
              }
            }
          }
          {
            let "elsewhere"
            value {
              call {
                arguments {
                  value "arp"
                }
                of "warp"
                procedure "std.text.startsWith"
              }
            }
          }
        ]
        result [
          {
            ref "spelled"
          }
          {
            ref "elsewhere"
          }
        ]
      }
    }
    warp 1
  }
  test 2
}

