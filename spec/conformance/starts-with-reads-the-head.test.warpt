(test 1)
(name "starts-with-reads-the-head")
(note "startsWith asks whether the text begins with the value, reading as a person reads. Two spellings of one letter are one head.")

(program
  (warp 1)
  (import Standard.Text.startsWith)
  (procedure entry
    (access public)
    (returns (array Bool))
    (body
      (let spelled (call Standard.Text.startsWith "étoile" "é"))
      (let elsewhere (call Standard.Text.startsWith "warp" "arp"))
      (return (array spelled elsewhere)))))
(expect (answers (array true false)))
