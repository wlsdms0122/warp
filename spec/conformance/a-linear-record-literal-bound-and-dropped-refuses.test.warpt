warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-record-literal-bound-and-dropped-refuses"
  note "A name declaring a type written linear takes the obligation whatever wrote its value, a record literal included, so a body that ends still holding it refuses at the build."
  program {
    imports [
      "App.Handle"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.name" {
        answers "f"
        parameters [
          {
            name "first"
            type "borrowing App.Handle"
          }
        ]
        returns "String"
      }
    }
    types {
      "App.H2" "App.Handle"
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

