(test 1)
(name "a-struct-field-writing-an-associated-type-refuses")
(note "A value carries no type's arguments, so what fills a struct's parameters is read off its fields, and a field writing the associated type `some C.Item` refuses at the load.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c))))))

(program
  (warp 1)
  (import Lib.Container)
  (struct Use.W
    (typeParameter C Lib.Container)
    (field item (some C.Item)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
