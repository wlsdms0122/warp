(test 1)
(name "bytes-do-not-fit-a-list-of-fractions-refuses")
(note "Bytes are a list of whole numbers in a compact spelling, and a whole number is no fraction. `Array<Double>` takes none of them, so bytes handed there are refused at the build.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (array Double))
    (result (call keep x"6869")))
  (procedure keep
    (parameter value (type (array Double)))
    (returns (array Double))
    (result value)))
(expect (refuses build))
