warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-takes-its-parameters-in-the-contracts-order"
  note "A declaration answering a contract's procedure takes its own type first and then what the contract asks at the same positions, since the run hands the arguments to the same positions whichever declaration answers. One taking them the other way round refuses at the build, where the claim is leaned on."
  program {
    contracts {
      "app.Labelled" {
        label {
          parameters [
            {
              name "of"
              type "app.Labelled"
            }
            {
              name "a"
              type "int"
            }
            {
              name "b"
              type "string"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.Card.label" {
        parameters [
          {
            name "of"
            type "app.Card"
          }
          {
            name "b"
            type "string"
          }
          {
            name "a"
            type "int"
          }
        ]
        result {
          ref "b"
        }
        returns "string"
      }
      "app.tell" {
        bounds {
          T "app.Labelled"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
              1
              "x"
            ]
            procedure "app.Labelled.label"
          }
        }
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "app.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "app.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "app.Card" [
        "app.Labelled"
      ]
    }
    types {
      "app.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

