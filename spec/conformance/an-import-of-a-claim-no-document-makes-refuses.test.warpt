warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
      imports []
      warp 1
    }
    {
      imports []
      types {
        "T.Card" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "T.Card"
                }
              ]
              result "card"
              returns "String"
            }
          }
          struct {
            rank "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "an-import-of-a-claim-no-document-makes-refuses"
  note "A claim imported is one some document in the link makes, the way a name imported is one some document declares. Nothing here claims T.Card answers App.Describable, so the import refuses at the build."
  program {
    imports [
      "App.Describable.describe"
      "T.Card"
      "T.Card: App.Describable"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    rank 1
                  }
                }
                type "T.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

