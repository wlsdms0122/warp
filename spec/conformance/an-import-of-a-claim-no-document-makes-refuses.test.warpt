(test 1)
(name "an-import-of-a-claim-no-document-makes-refuses")
(note "A claim imported is one some document in the link makes, the way a name imported is one some document declares. Nothing here claims T.Card conforms to App.Describable, so the import refuses at the build.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (body
          (return "card"))))))

(program
  (warp 1)
  (import App.Describable.describe)
  (import T.Card)
  (import T.Card App.Describable)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let card (as (struct (field rank 1)) T.Card))
      (return (call App.Describable.describe card)))))
(expect (refuses build))
