warpt 1
{
  expect {
    refuses "build"
  }
  name "a-map-literal-of-keys-of-two-types-handed-at-a-dictionary-of-a-bounded-key-refuses"
  note "`App.g` takes `Dictionary<some K, Int>`, its key bounded by `Hashable`, which `Int` and `String` each answer. The map literal keyed by `1` and `\"a\"` handed there fills `K` with its keys joined, `Any`, which answers no contract, so the build refuses though each key answers. A bounded parameter is one type."
  program {
    imports []
    procedures {
      "App.g" {
        bounds {
          K "Hashable"
        }
        parameters [
          {
            name "x"
            type "Dictionary<some K, Int>"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                dictionary [
                  [
                    1
                    1
                  ]
                  [
                    "a"
                    2
                  ]
                ]
              }
            ]
            procedure "App.g"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

