warpt 1
{
  expect {
    answers "1.0"
  }
  name "a-call-through-a-type-parameter-settles-a-closure-answer-to-the-fraction-its-slot-wrote-answers"
  note "`c` is held at `procedure() -> double` and its closure answers the whole number 1. `App.run` takes `procedure() -> some T`, so `v` reads as `double`. The closure keeps the answer its slot wrote, so the call inside `App.run` settles it to the fraction 1.0, and its text says so."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "double"
              }
            }
            value {
              closure {
                result 1
              }
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

