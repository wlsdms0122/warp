(test 1)
(name "an-import-of-a-claim-two-documents-make-answers")
(note "A claim imported is the claim, every copy of it the link holds, and not what the documents making it stand on. Two documents make the claim this one imports, the second placed after it, and the two copies are one claim, so the card answers App.Describable.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (body
          (return "card")))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))
    (procedure One.mark
      (returns Int)
      (body
        (return 1))))
  (document
    (warp 1)
    (import App.Describable.describe)
    (import T.Card)
    (import T.Card App.Describable)
    (procedure Imp.tell
      (access public)
      (returns String)
      (failing cast_refused)
      (body
        (let card (as (struct (field rank 1)) T.Card))
        (return (call App.Describable.describe card)))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))
    (procedure Two.mark
      (returns Int)
      (body
        (return 1)))))

(program
  (warp 1)
  (import Imp.tell)
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (return (call Imp.tell)))))
(expect (answers "card"))
