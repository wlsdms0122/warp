warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
      imports []
      warp 1
    }
    {
      imports []
      types {
        "T.Card" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "T.Card"
                }
              ]
              result "card"
              returns "String"
            }
          }
          struct {
            rank "Int"
          }
        }
      }
      warp 1
    }
    {
      description "one maker"
      extensions {
        "T.Card" {
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports [
        "App.Describable"
        "T.Card"
      ]
      warp 1
    }
    {
      imports [
        "App.Describable.describe"
        "T.Card"
        "T.Card: App.Describable"
      ]
      procedures {
        "Imp.tell" {
          access "public"
          body [
            {
              let "card"
              value {
                as {
                  of {
                    struct {
                      rank 1
                    }
                  }
                  type "T.Card"
                }
              }
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "card"
                }
              ]
              procedure "App.Describable.describe"
            }
          }
          returns "String"
        }
      }
      warp 1
    }
    {
      description "another maker"
      extensions {
        "T.Card" {
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports [
        "App.Describable"
        "T.Card"
      ]
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "an-import-of-a-claim-two-documents-make-refuses"
  note "A claim a document imports is made by one document of the link, the way a name it uses is declared by one, so what it stands on is the same however the host compiled it. Two documents make the claim this one imports, and the build refuses the import, though the importing document was compiled before the second arrived."
  program {
    imports [
      "Imp.tell"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            procedure "Imp.tell"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

