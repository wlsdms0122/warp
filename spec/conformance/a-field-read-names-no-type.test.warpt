warpt 1
{
  documents [
    {
      imports []
      procedures {
        "Core.origin" {
          failing [
            "cast_refused"
          ]
          result {
            as {
              of {
                struct {
                  x 3
                  y 4
                }
              }
              type "Core.Point"
            }
          }
          returns "Core.Point"
        }
      }
      types {
        "Core.Point" {
          struct {
            x "Int"
            y "Int"
          }
        }
      }
      warp 1
    }
    {
      imports [
        "Core.Point"
        "Core.origin"
      ]
      procedures {
        "Mid.tip" {
          failing [
            "cast_refused"
          ]
          result {
            call {
              procedure "Core.origin"
            }
          }
          returns "Core.Point"
        }
      }
      warp 1
    }
  ]
  expect {
    answers 3
  }
  name "a-field-read-names-no-type"
  note "The imports list holds the names a program uses: what it sends and the types it names. Reading a field off another document's answer names no type, so a program built on the middle layer lists the middle layer's procedure and nothing of the layer beneath."
  program {
    imports [
      "Mid.tip"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tip"
            value {
              call {
                procedure "Mid.tip"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          ref "tip.x"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

