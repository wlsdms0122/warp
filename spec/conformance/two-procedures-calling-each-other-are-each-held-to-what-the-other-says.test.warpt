(test 1)
(name "two-procedures-calling-each-other-are-each-held-to-what-the-other-says")
(note "`App.even` and `App.odd` call each other, and each says it answers without running. Each body is held to what the other declares, so neither waits on the other, and the call stands as an operand.")

(program
  (warp 1)
  (import Standard.Logic.equal)
  (import Standard.Logic.not)
  (import Standard.Numeric.minus)
  (procedure App.even
    (const)
    (parameter n (type Int))
    (returns Bool)
    (body
      (conditional
        (when (call Standard.Logic.equal n 0))
        (then
          (return true)))
      (return (call App.odd (call Standard.Numeric.minus n 1)))))
  (procedure App.odd
    (const)
    (parameter n (type Int))
    (returns Bool)
    (body
      (conditional
        (when (call Standard.Logic.equal n 0))
        (then
          (return false)))
      (return (call App.even (call Standard.Numeric.minus n 1)))))
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (return (call Standard.Logic.not (call App.odd 4))))))
(expect (answers true))
