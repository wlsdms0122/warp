(test 1)
(name "a-door-holds-a-list-at-a-list-of-an-associated-type-to-what-the-type-gives-refuses")
(note "The run hands a bag of Int at C and a list holding text at `Array<some C.Item>`, so the door refuses the text.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Bag)
    (struct App.IntBag
      (satisfies Lib.Bag)
      (field n Int)
      (type Item Int)
      (procedure first
        (access public)
        (parameter of (type App.IntBag))
        (returns Int)
        (result (path of (field n))))
      (procedure take
        (access public)
        (parameter of (type App.IntBag))
        (parameter x (type Int))
        (returns Int)
        (result (call Int.plus x 1))))))

(program
  (warp 1)
  (import Lib.Bag)
  (import Lib.Bag.take)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Bag)))
    (parameter xs (type (array (some C.Item))))
    (returns Int)
    (body
      (let y (path xs (index 1))))
    (result (call Lib.Bag.take c y))))
(arguments (argument c (struct App.IntBag (field n 1))) (argument xs (array 1 "s")))
(expect (refuses run))
