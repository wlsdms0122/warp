warpt 1
{
  arguments {
    c App.IntBag {
      n 1
    }
    xs [
      1
      "s"
    ]
  }
  documents [
    {
      contracts {
        "Lib.Bag" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
            take {
              parameters [
                {
                  name "of"
                  type "Self"
                }
                {
                  name "x"
                  type "Self.Item"
                }
              ]
              returns "Int"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      warp 1
    }
    {
      imports [
        "Int.plus"
        "Lib.Bag"
      ]
      types {
        "App.IntBag" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.IntBag"
                }
              ]
              result {
                ref "of.n"
              }
              returns "Int"
            }
            take {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.IntBag"
                }
                {
                  name "x"
                  type "Int"
                }
              ]
              result {
                call {
                  arguments [
                    {
                      ref "x"
                    }
                    1
                  ]
                  procedure "Int.plus"
                }
              }
              returns "Int"
            }
          }
          satisfies [
            "Lib.Bag"
          ]
          struct {
            n "Int"
          }
          types {
            Item "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "run"
  }
  name "a-door-holds-a-list-at-a-list-of-an-associated-type-to-what-the-type-gives-refuses"
  note "The run hands a bag of Int at C and a list holding text at `Array<some C.Item>`, so the door refuses the text."
  program {
    imports [
      "Lib.Bag"
      "Lib.Bag.take"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "y"
            value {
              ref "xs[1]"
            }
          }
        ]
        bounds {
          C "Lib.Bag"
        }
        parameters [
          {
            name "c"
            type "some C"
          }
          {
            name "xs"
            type "Array<some C.Item>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "c"
              }
              {
                ref "y"
              }
            ]
            procedure "Lib.Bag.take"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

