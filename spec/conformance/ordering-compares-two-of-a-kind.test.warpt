warpt 1
{
  expect {
    answers true
  }
  name "ordering-compares-two-of-a-kind"
  note "The procedures that order values order text too, so declaring them as taking numbers would say something they do not mean."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "a"
              "b"
            ]
            procedure "Standard.Comparable.lessThan"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

