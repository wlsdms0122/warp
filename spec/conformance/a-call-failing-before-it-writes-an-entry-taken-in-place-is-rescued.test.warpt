warpt 1
{
  expect {
    answers "rescued"
  }
  name "a-call-failing-before-it-writes-an-entry-taken-in-place-is-rescued"
  note "`App.touch` takes an entry of a dictionary not written yet in place at its own `some T`, and fails before writing it. The failure reaches the caller as it was raised, so the caller's attempt rescues it."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      "App.h" {
        body [
          {
            value {
              ref "n"
            }
            var "cell"
          }
          {
            let "c"
            value {
              closure {
                body [
                  {
                    set "cell"
                    value {
                      ref "y"
                    }
                  }
                ]
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result 0
                returns "Int"
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "some T"
          }
          {
            name "j"
          }
        ]
        result {
          ref "cell"
        }
        returns "some T"
      }
      "App.touch" {
        body [
          {
            let "y"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                  {
                    ref "j"
                  }
                ]
                procedure "App.h"
              }
            }
          }
          {
            value {
              conditional {
                then [
                  {
                    value {
                      call {
                        arguments [
                          "boom"
                        ]
                        procedure "Standard.Control.abort"
                      }
                    }
                  }
                ]
                when {
                  ref "stop"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "inout some T"
          }
          {
            name "n"
            type "some T"
          }
          {
            name "j"
          }
          {
            name "stop"
            type "Bool"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            type "Dictionary<String, Int>"
            value {
              dictionary [
                [
                  "a"
                  1
                ]
              ]
            }
            var "d"
          }
          {
            value "no"
            var "seen"
          }
          {
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "d[\"new\"]"
                          }
                          2
                          3
                          true
                        ]
                        procedure "App.touch"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      set "seen"
                      value "rescued"
                    }
                  ]
                }
              }
            }
          }
        ]
        result {
          ref "seen"
        }
      }
    }
    warp 1
  }
  test 1
}

