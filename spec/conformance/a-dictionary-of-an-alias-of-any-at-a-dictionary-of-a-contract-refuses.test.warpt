warpt 1
{
  expect {
    refuses "build"
  }
  name "a-dictionary-of-an-alias-of-any-at-a-dictionary-of-a-contract-refuses"
  note "Each entry of a Dictionary<App.Loose> is read as Any, which stands nowhere a contract is asked, so handing it where a Dictionary<App.Shape> is declared refuses at the build."
  program {
    contracts {
      "App.Shape" {}
    }
    imports []
    procedures {
      "App.g" {
        parameters [
          {
            name "p"
            type "Dictionary<App.Shape>"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<App.Loose>"
            value {
              record {
                k 5
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "d"
              }
            ]
            procedure "App.g"
          }
        }
        returns "Int"
      }
    }
    satisfies {
      "App.Point" [
        "App.Shape"
      ]
    }
    types {
      "App.Loose" "Any"
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

