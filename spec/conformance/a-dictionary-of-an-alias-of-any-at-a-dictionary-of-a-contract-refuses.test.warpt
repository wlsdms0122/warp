warpt 1
{
  expect {
    refuses "build"
  }
  name "a-dictionary-of-an-alias-of-any-at-a-dictionary-of-a-contract-refuses"
  note "Each entry of a Dictionary<String, App.Loose> is read as Any, which stands nowhere a contract is asked, so handing it where a Dictionary<String, App.Shape> is declared refuses at the build."
  program {
    contracts {
      "App.Shape" {}
    }
    imports []
    procedures {
      "App.g" {
        parameters [
          {
            name "p"
            type "Dictionary<String, App.Shape>"
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<String, App.Loose>"
            value {
              dictionary [
                [
                  "k"
                  5
                ]
              ]
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "d"
              }
            ]
            procedure "App.g"
          }
        }
        returns "Int"
      }
    }
    types {
      "App.Loose" "Any"
      "App.Point" {
        satisfies [
          "App.Shape"
        ]
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

