warpt 1
{
  expect {
    refuses "load"
  }
  name "a-backslash-before-what-it-does-not-escape-refuses"
  note "Inside the quotes a backslash escapes a quote or a backslash and nothing else, so each key has one spelling."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<String, Int>"
            value {
              dictionary [
                [
                  "an"
                  1
                ]
              ]
            }
          }
        ]
        result {
          ref "d[\"a\\n\"]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

