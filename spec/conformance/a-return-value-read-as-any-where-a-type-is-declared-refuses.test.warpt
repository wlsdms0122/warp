(test 1)
(name "a-return-value-read-as-any-where-a-type-is-declared-refuses")
(note "`Any` declares nothing about what is there, so a body returning one reads nothing a declaration of `Int` could take. A value read as `Any` stands where a type is declared only where a cast says what it is, so the build refuses.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns Int)
    (body
      (return payload))))
(arguments (argument payload "not a whole number"))
(expect (refuses build))
