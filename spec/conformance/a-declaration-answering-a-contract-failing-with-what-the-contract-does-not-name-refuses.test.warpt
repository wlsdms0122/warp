warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-failing-with-what-the-contract-does-not-name-refuses"
  note "A contract that names no failure lets nothing fail out of the procedures it asks. `Int.check` aborts, which `check` does not let it, so the claim does not hold and refuses at the build, at the claim."
  program {
    contracts {
      "App.Checked" {
        check {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    extensions {
      Int {
        procedures {
          check {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result {
              call {
                arguments [
                  "no"
                ]
                procedure "Standard.Control.abort"
              }
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Checked"
        ]
      }
    }
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "App.Checked.check"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

