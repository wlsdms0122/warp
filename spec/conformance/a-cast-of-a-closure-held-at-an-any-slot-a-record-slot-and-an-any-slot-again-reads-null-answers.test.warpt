warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-held-at-an-any-slot-a-record-slot-and-an-any-slot-again-reads-null-answers"
  note "The closure is held at `procedure() -> any`, then at `procedure() -> Bank.A`, then at `procedure() -> any` again, and travels through `Any`. Meeting `Any` again does not drop the `Bank.A` answer between, and `Bank.B` never takes a `Bank.A`: the asking cast to `procedure() -> Bank.B` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c0"
            type {
              procedure {
                returns "Any"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              ref "c0"
            }
          }
          {
            let "x"
            type {
              procedure {
                returns "Any"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "a"
            type "Any"
            value {
              ref "x"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    returns "Bank.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
      "Bank.B" {
        record {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

