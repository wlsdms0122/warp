(test 1)
(name "an-optional-cast-to-a-contract-of-a-box-of-a-box-of-what-is-not-hashable-reads-null")
(note "The inner box holds a struct no claim makes Hashable, so the inner box is not Hashable and `as?` to `Lib.Describable` answers null.")

(documents
  (document
    (warp 1)
    (contract Lib.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (import Lib.Describable)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (struct App.Plain
      (field x Int))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Hashable Lib.Describable)
      (procedure describe
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns String)
        (result "box")))))

(program
  (warp 1)
  (import App.Box)
  (import App.Plain)
  (import Lib.Describable)
  (procedure entry
    (access public)
    (returns (nullable Lib.Describable))
    (failing cast_refused)
    (body
      (let a (type Any) (as (struct (field item (struct (field item (struct (field x 1)))))) (named App.Box (named App.Box App.Plain)))))
    (result (as? a Lib.Describable))))
(expect (answers null))
