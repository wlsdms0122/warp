warpt 1
{
  expect {
    answers "a"
  }
  name "a-call-through-a-type-parameter-settles-a-closure-answer-to-the-record-its-slot-wrote-answers"
  note "`c` is held at `procedure() -> Bank.A` and its closure answers the nameless `{ k: \"x\" }`. `App.run` takes `procedure() -> some T` and answers what calling it answers, so `v` reads as `Bank.A`. The closure keeps the answer its slot wrote, so the call inside `App.run` settles it to `Bank.A`, and `App.P.show` reaches `Bank.A`'s witness."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

