warpt 1
{
  expect {
    answers "a"
  }
  name "a-struct-literal-written-into-a-module-variable-declaring-a-struct-takes-the-name-answers"
  note "`r` is a module variable declaring `Bank.A`, and a body writes the struct literal `{ k: \"y\" }` into it. A literal written where `Bank.A` is read takes the name, so `r` holds a `Bank.A`, and `App.P.show`, which `Bank.A` answers, is sent to it."
  program {
    contracts {
      "App.P" {
        procedures {
          show {
            const true
            isolated true
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            set "r"
            value {
              struct {
                k "y"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "r"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    types {
      "Bank.A" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Bank.A"
              }
            ]
            result "a"
            returns "String"
          }
        }
        satisfies [
          "App.P"
        ]
        struct {
          k "String"
        }
      }
    }
    var {
      r {
        type "Bank.A"
        value {
          struct {
            k "x"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

