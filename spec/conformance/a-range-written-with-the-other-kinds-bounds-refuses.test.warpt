warpt 1
{
  expect {
    refuses "load"
  }
  name "a-range-written-with-the-other-kinds-bounds-refuses"
  note "A bound is a value of the kind it bounds, and each kind has one spelling: `1` spells a whole number and `1.0` a fraction. So a fraction range written with whole bounds names no range at all, and the read refuses it where the grammar lives."
  program {
    imports []
    procedures {
      entry {
        parameters {
          ratio "double(0...1)"
        }
        result {
          ref "ratio"
        }
      }
    }
    warp 2
  }
  test 1
}
