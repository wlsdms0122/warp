warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-outside-a-contract-standing-as-a-type-refuses"
  note "A contract standing where a type is written holds the slot to what satisfies it, and the build can see the name a value wears: a type no document says satisfies the contract is refused where the call is written."
  program {
    contracts {
      "app.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "app.Describable"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.tell" {
        parameters [
          {
            name "it"
            type "app.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "bank.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "app.tell"
          }
        }
        returns "string"
      }
    }
    types {
      "bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

