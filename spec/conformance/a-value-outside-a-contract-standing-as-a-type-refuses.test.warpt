(test 1)
(name "a-value-outside-a-contract-standing-as-a-type-refuses")
(note "A contract standing where a type is written holds the slot to what satisfies it, and the build can see the name a value wears: a type no document says satisfies the contract is refused where the call is written.")

(program
  (warp 1)
  (struct Bank.Card
    (field last String))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (parameter it (type App.Describable))
    (returns String)
    (body
      (return (call App.Describable.describe it))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let card (as (struct (field last "42")) Bank.Card))
      (return (call App.tell card)))))
(expect (refuses build))
