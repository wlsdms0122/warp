warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-outside-a-contract-standing-as-a-type-refuses"
  note "A contract standing where a type is written holds the slot to what satisfies it, and the build can see the name a value wears: a type no document says satisfies the contract is refused where the call is written."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        parameters [
          {
            name "it"
            type "App.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.Card" {
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

