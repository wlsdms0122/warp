warpt 1
{
  expect {
    refuses "load"
  }
  name "a-record-form-array-of-a-named-element-refuses"
  note "`{ array: <type> }` is the form for an element that has no string spelling, a record or a procedure type. An element that has one is written `Array<T>`, and the record form around it is not a second spelling of that type, so it is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "items"
            type {
              array "String"
            }
          }
        ]
        result {
          ref "items"
        }
      }
    }
    warp 1
  }
  test 1
}

