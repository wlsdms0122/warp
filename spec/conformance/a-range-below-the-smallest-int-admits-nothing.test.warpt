warpt 1
{
  expect {
    refuses "build"
  }
  name "a-range-below-the-smallest-int-admits-nothing"
  note "A range with no near bound stands on the smallest int. Nothing is below it, so a range ending before it admits nothing, and the build refuses it as it refuses any range no call could fit."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "x"
            type "Int(..<-9223372036854775808)"
          }
        ]
        result 1
      }
    }
    warp 1
  }
  test 1
}

