(test 1)
(name "a-write-through-an-element-keeps-the-others")
(note "An element is written through its index, and the array around it is what it was.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (var xs (array 1 2 3))
      (set (path xs (index 1)) 9))
    (result xs)))
(expect (answers (array 1 9 3)))
