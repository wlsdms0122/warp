(test 1)
(name "a-fixed-name-bound-to-a-value-calls-return-value-carries-what-its-type-says")
(note "`f` is bound to what calling `g` returns, and `g`'s type says it returns a `const` procedure. A call of a value returns what the value's written type says, so `f` follows that type and `App.run`, declared const, may call it.")

(program
  (warp 1)
  (procedure App.run
    (const)
    (parameter g (type (procedure (const) (parameters) (returns (procedure (const) (parameters) (returns Int))))))
    (returns Int)
    (body
      (let f (apply g))
      (return (apply f))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return
        (call App.run
          (closure
            (const)
            (returns (procedure (const) (parameters) (returns Int)))
            (body
              (return
                (closure
                  (const)
                  (returns Int)
                  (body
                    (return 1)))))))))))
(expect (answers 1))
