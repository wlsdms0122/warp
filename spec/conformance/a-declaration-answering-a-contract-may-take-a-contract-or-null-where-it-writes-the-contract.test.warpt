warpt 1
{
  expect {
    answers "ok"
  }
  name "a-declaration-answering-a-contract-may-take-a-contract-or-null-where-it-writes-the-contract"
  note "The contract hands App.Sized and the declaration answering it takes App.Sized? there, which takes whatever the contract hands."
  program {
    contracts {
      "App.Shown" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "n"
                type "App.Sized"
              }
            ]
            returns "String"
          }
        }
      }
      "App.Sized" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  struct {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result "ok"
        returns "String"
      }
    }
    types {
      "Bank.Box" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Bank.Box"
              }
              {
                name "n"
                type "App.Sized?"
              }
            ]
            result "shown"
            returns "String"
          }
        }
        satisfies [
          "App.Shown"
        ]
        struct {
          n "Int"
        }
      }
      "Bank.Card" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result 4
            returns "Int"
          }
        }
        satisfies [
          "App.Sized"
        ]
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

