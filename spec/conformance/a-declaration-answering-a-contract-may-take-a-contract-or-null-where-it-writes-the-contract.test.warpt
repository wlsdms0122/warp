warpt 1
{
  expect {
    answers "ok"
  }
  name "a-declaration-answering-a-contract-may-take-a-contract-or-null-where-it-writes-the-contract"
  note "The contract hands App.Sized and the declaration answering it takes App.Sized? there, which takes whatever the contract hands."
  program {
    constraints {
      "App.Pockets" [
        "Bank.Card"
        "Bank.Coin"
      ]
      "App.Wallets" [
        "Bank.Card"
        "Bank.Coin"
      ]
    }
    contracts {
      "App.Shown" {
        show {
          parameters [
            {
              name "of"
              type "App.Shown"
            }
            {
              name "n"
              type "App.Sized"
            }
          ]
          returns "string"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Box.show" {
        parameters [
          {
            name "of"
            type "Bank.Box"
          }
          {
            name "n"
            type "App.Sized?"
          }
        ]
        result "shown"
        returns "string"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  record {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result "ok"
      }
    }
    satisfies {
      "Bank.Box" [
        "App.Shown"
      ]
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        record {
          n "int"
        }
      }
      "Bank.Card" {
        record {
          last "string"
        }
      }
      "Bank.Coin" {
        record {
          cents "int"
        }
      }
    }
    warp 1
  }
  test 1
}

