warpt 1
{
  expect {
    answers [
      1
      2
    ]
  }
  name "a-piece-calling-an-isolated-procedure-read-out-of-a-struct-field-stands"
  note "A slot declaring a struct type says what each of its fields holds. `asking` declares `isolated` and calls what the field `f` holds, which `App.Holder` declares an `isolated` procedure type, so the build holds it to that, and a piece of `Standard.Concurrent.map` calling `asking` stands."
  program {
    imports [
      "Standard.Concurrent.map"
    ]
    procedures {
      asking {
        body [
          {
            let "a"
            value {
              call {
                arguments [
                  {
                    ref "item"
                  }
                ]
                procedure {
                  ref "body.f"
                }
              }
            }
          }
        ]
        isolated true
        parameters [
          {
            name "body"
            type "App.Holder"
          }
          {
            name "item"
            type "Int"
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  isolated true
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          struct {
                            f {
                              closure {
                                const true
                                isolated true
                                parameters [
                                  {
                                    name "x"
                                    type "Int"
                                  }
                                ]
                                result {
                                  ref "x"
                                }
                                returns "Int"
                              }
                            }
                          }
                        }
                        {
                          ref "item"
                        }
                      ]
                      procedure "asking"
                    }
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<Int>"
      }
    }
    types {
      "App.Holder" {
        struct {
          f "isolated (Int) -> Int"
        }
      }
    }
    warp 1
  }
  test 1
}

