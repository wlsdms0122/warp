warpt 1
{
  arguments {
    payload 1
  }
  expect {
    refuses "build"
  }
  name "a-write-an-attempt-body-makes-reads-back-nullable"
  note "An attempt's body may fail before its write, so a write inside it joins with what the name held. After it the name reads `Int?`, and a slot declared `Int` refuses it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            var "kept"
          }
          {
            value {
              attempt {
                body [
                  {
                    let "read"
                    value {
                      as {
                        of {
                          ref "payload"
                        }
                        type "Int"
                      }
                    }
                  }
                  {
                    set "kept"
                    value {
                      ref "read"
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      let "noted"
                      value 0
                    }
                  ]
                }
              }
            }
          }
          {
            let "said"
            value {
              call {
                arguments [
                  {
                    ref "kept"
                  }
                ]
                procedure "wants"
              }
            }
          }
        ]
        parameters [
          {
            name "payload"
          }
        ]
      }
      wants {
        parameters [
          {
            name "it"
            type "Int"
          }
        ]
        result true
      }
    }
    warp 1
  }
  test 1
}

