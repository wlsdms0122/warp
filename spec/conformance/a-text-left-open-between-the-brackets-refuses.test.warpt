warpt 1
{
  expect {
    refuses "load"
  }
  name "a-text-left-open-between-the-brackets-refuses"
  note "A text between the brackets is closed by a quote, and one never closed leaves the path unfinished."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<String, Int>"
            value {
              dictionary [
                [
                  "a"
                  1
                ]
              ]
            }
          }
        ]
        result {
          ref "d[\"a]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

