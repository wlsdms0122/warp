warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-to-a-procedure-answering-another-record-reads-null-answers"
  note "`c` is held at `procedure() -> Bank.A`, and travels through `any`. A slot takes a closure only where its answer takes every answer a slot the closure was settled into wrote, and `Bank.B` never takes a `Bank.A`: the asking cast to `procedure() -> Bank.B` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "a"
            type "any"
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    returns "Bank.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    types {
      "Bank.A" {
        record {
          k "string"
        }
      }
      "Bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

