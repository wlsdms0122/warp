(test 1)
(name "a-type-member-under-a-head-taking-fewer-values-than-the-claim-refuses")
(note "App.Box claims `Lib.Container` for every box and is given Item for a box of Int alone, so the claim refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))
    (extension
      (head (named App.Box Int))
      (type Item Int))))

(program
  (warp 1)
  (import App.Box)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return 1))))
(expect (refuses build))
