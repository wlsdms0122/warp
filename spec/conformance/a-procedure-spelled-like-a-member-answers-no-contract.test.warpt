warpt 1
{
  expect {
    refuses "build"
  }
  name "a-procedure-spelled-like-a-member-answers-no-contract"
  note "`App.Card.describe` is declared among the procedures and not given to App.Card, so it is that document's procedure and answers no contract: the claim holds nothing, and refuses at the build, at the claim."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.Card.describe" {
        parameters [
          {
            name "of"
            type "App.Card"
          }
        ]
        result "card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    rank 1
                  }
                }
                type "App.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Card" {
        satisfies [
          "App.Describable"
        ]
        struct {
          rank "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

