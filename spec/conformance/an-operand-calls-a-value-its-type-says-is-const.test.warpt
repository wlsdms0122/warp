(test 1)
(name "an-operand-calls-a-value-its-type-says-is-const")
(note "An operand is read rather than run, so what it calls answers without running. Which procedure a value is, is the run's answer, and the type written for it is what says that procedure is `const`: `f` is a parameter declared `const () -> Int`, so a call of it written as an argument stands, as a call of a declaration saying `const` does.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure App.g
    (parameter f (type (procedure (const) (parameters) (returns Int))))
    (returns Int)
    (result (call Standard.Numeric.plus 1 (apply f))))
  (procedure entry
    (access public)
    (returns Int)
    (result
      (call App.g
        (closure
          (const)
          (returns Int)
          (result 1))))))
(expect (answers 2))
