warpt 1
{
  expect {
    refuses "load"
  }
  name "a-signed-bound-refuses"
  note "A whole bound is written the one way a whole number is. `+1` is a second spelling of `1`, and the range refuses at the load."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "x"
            type "int(+1...5)"
          }
        ]
        result 1
      }
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

