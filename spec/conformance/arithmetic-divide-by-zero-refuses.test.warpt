(test 1)
(name "arithmetic-divide-by-zero-refuses")
(note "A fraction has an answer for this and it is not a number, so answering with it would put something in a program no later check could talk about.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.dividedBy 1 0)))))
(expect (refuses run))
