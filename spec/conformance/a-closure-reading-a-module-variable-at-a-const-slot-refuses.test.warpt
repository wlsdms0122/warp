(test 1)
(name "a-closure-reading-a-module-variable-at-a-const-slot-refuses")
(note "What a module variable holds is the run's rather than the text's, so a body reading one does not answer without running, and a slot asking a `const` procedure type refuses a closure that does.")

(program
  (warp 1)
  (var standing "held")
  (procedure asking
    (parameter body (type (procedure (const) (parameters) (returns String))))
    (returns String)
    (body
      (let answered (apply body))
      (return answered)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let given
        (closure
          (returns String)
          (body
            (return standing))))
      (return (call asking given)))))
(expect (refuses build))
