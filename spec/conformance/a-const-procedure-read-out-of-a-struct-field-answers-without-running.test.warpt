warpt 1
{
  expect {
    answers 2
  }
  name "a-const-procedure-read-out-of-a-struct-field-answers-without-running"
  note "A slot declaring a struct type says what each of its fields holds, and the value was judged against it when it was handed over. `asking` declares `const` and calls what the field `f` holds, which `App.Holder` declares a `const` procedure type, so the build holds it to that, the way it does one calling an element or an entry, and an operand may call it."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      asking {
        body [
          {
            let "a"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "body.f"
                }
              }
            }
          }
        ]
        const true
        parameters [
          {
            name "body"
            type "App.Holder"
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        const true
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      struct {
                        f {
                          closure {
                            const true
                            isolated true
                            parameters [
                              {
                                name "x"
                                type "Int"
                              }
                            ]
                            result {
                              ref "x"
                            }
                            returns "Int"
                          }
                        }
                      }
                    }
                  ]
                  procedure "asking"
                }
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
    }
    types {
      "App.Holder" {
        struct {
          f "const (Int) -> Int"
        }
      }
    }
    warp 1
  }
  test 1
}

