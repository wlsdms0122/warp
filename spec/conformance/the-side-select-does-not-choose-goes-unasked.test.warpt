warpt 1
{
  expect {
    answers "taken"
  }
  name "the-side-select-does-not-choose-goes-unasked"
  note "Both sides are procedures so the one not chosen is never asked. The side left alone here reads past the end of a list holding nothing, which would refuse the run, and the answer shows it was never read."
  program {
    imports [
      "Standard.Logic.select"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "none"
            type "Array<Any>"
            value []
          }
        ]
        const true
        result {
          call {
            arguments [
              true
              {
                closure {
                  const true
                  isolated true
                  result "taken"
                  returns "Any"
                }
              }
              {
                closure {
                  const true
                  isolated true
                  result {
                    ref "none[0]"
                  }
                  returns "Any"
                }
              }
            ]
            procedure "Standard.Logic.select"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

