warpt 1
{
  arguments {
    payload "not a number"
  }
  expect {
    answers "taken"
  }
  name "the-side-select-does-not-choose-goes-unasked"
  note "Both sides are procedures so the one not chosen is never asked. The side left alone here would fail its cast at the run, and the answer shows it was never read."
  program {
    imports [
      "Standard.Logic.select"
    ]
    procedures {
      entry {
        access "public"
        const true
        failing "anything"
        parameters [
          {
            name "payload"
          }
        ]
        result {
          call {
            arguments [
              true
              {
                closure {
                  const true
                  isolated true
                  result "taken"
                  returns "Any"
                }
              }
              {
                closure {
                  const true
                  failing [
                    "cast_refused"
                  ]
                  isolated true
                  result {
                    as {
                      of {
                        ref "payload"
                      }
                      type "Int"
                    }
                  }
                  returns "Any"
                }
              }
            ]
            procedure "Standard.Logic.select"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

