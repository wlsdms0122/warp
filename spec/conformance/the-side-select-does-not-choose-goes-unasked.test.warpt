warpt 1
{
  arguments {
    payload "not a number"
  }
  expect {
    answers "taken"
  }
  name "the-side-select-does-not-choose-goes-unasked"
  note "Both sides are procedures so the one not chosen is never asked. The side left alone here would refuse its cast at the run, and the answer shows it was never read."
  program {
    imports [
      "std.logic.select"
    ]
    procedures {
      entry {
        access "public"
        parameters {
          payload {
            type "any"
          }
        }
        result {
          call {
            arguments {
              else {
                closure {
                  result {
                    as "int"
                    of {
                      ref "payload"
                    }
                  }
                  returns "any"
                }
              }
              then {
                closure {
                  result "taken"
                  returns "any"
                }
              }
            }
            of true
            procedure "std.logic.select"
          }
        }
        returns "any"
      }
    }
    warp 1
  }
  test 1
}

