(test 1)
(name "an-object-whose-layout-names-stand-out-of-order-refuses")
(note "A struct built from parts writes its layout's field names in name order, one operation each in that order. Names out of order would pair each name with another's operation.")
(object (dictionary (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"f992a6b8f1ff7564873d0680de54a88f3b19097e8671198262d9bb96f6473c35")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "rows" (array (array "entry" (array (array) (array 0) (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array (array 3 (array (array "App.R" (array "b" "a")) (array (array 0 (array 2 1)) (array 0 (array 4 "s"))))))) (array 0 (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array "App.R")) (entry "types" (array (array "App.R" (array 9 (array (array "a" (array 4)) (array "b" (array 6))))))) (entry "variables" (array))))
(expect (refuses load))
