(test 1)
(name "an-object-whose-layout-names-stand-out-of-order-refuses")
(note "A struct built from parts writes its layout's field names in name order, one operation each in that order. Names out of order would pair each name with another's operation.")
(object (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"f992a6b8f1ff7564873d0680de54a88f3b19097e8671198262d9bb96f6473c35")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 0 1) (array 3 (array (array "App.R" (array "b" "a")) (array 0 1))) (array 13 0 (array) (array 2)))) (entry "rows" (array (array "entry" (array (array) 2 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 3 "[0]")) (array 0 (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array "App.R")) (entry "typeTable" (array (array 4) (array 6) (array 0))) (entry "types" (array (array "App.R" (array 9 (array (array "a" 0) (array "b" 1)))))) (entry "valueTable" (array (array 2 1) (array 4 "s"))) (entry "variables" (array))))
(expect (refuses load))
