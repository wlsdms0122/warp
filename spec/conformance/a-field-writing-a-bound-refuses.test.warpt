warpt 1
{
  expect {
    refuses "load"
  }
  name "a-field-writing-a-bound-refuses"
  note "A struct bounds its type parameters in `typeParameters`, each entry a name and what holds it, `T: Hashable`. A field writing `some T: Hashable` writes a bound where no name is introduced, and refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T: Hashable"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

