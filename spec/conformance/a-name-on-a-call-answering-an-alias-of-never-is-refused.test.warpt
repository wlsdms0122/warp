warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-on-a-call-answering-an-alias-of-never-is-refused"
  note "`App.N` is a name for `Never`, and `App.f` declares it, so its call never finishes the way a call declaring `Never` does: a name on it promises a binding that cannot happen, and the build refuses the name."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      "App.f" {
        body [
          {
            value {
              call {
                arguments [
                  "no"
                ]
                procedure "Standard.Control.abort"
              }
            }
          }
        ]
        returns "App.N"
      }
      entry {
        access "public"
        body [
          {
            let "x"
            value {
              call {
                procedure "App.f"
              }
            }
          }
        ]
        result 1
      }
    }
    types {
      "App.N" "Never"
    }
    warp 1
  }
  test 1
}

