warpt 1
{
  expect {
    answers null
  }
  name "a-closure-a-generic-body-wrote-read-past-its-bounds-is-not-that-type"
  note "App.mk answers a closure taking a list of its own some T in place, T bounded by Standard.Numeric, and it is read through any as taking a list of text. Reading its T as text is outside its bounds, so the closure is not of that type, and as? reads it as null."
  program {
    imports [
      "Standard.Numeric"
    ]
    procedures {
      "App.mk" {
        bounds {
          T "Standard.Numeric"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          closure {
            parameters [
              {
                name "xs"
                type "inout Array<some T>"
              }
            ]
            result 0
            returns "Int"
          }
        }
        returns {
          procedure {
            parameters [
              "inout Array<some T>"
            ]
            returns "Int"
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "a"
            type "Any"
            value {
              call {
                arguments [
                  5
                ]
                procedure "App.mk"
              }
            }
          }
          {
            let "f"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    parameters [
                      "inout Array<String>"
                    ]
                    returns "Int"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "f"
        }
      }
    }
    warp 1
  }
  test 1
}

