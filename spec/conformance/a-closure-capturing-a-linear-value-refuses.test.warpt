warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-capturing-a-linear-value-refuses"
  note "A closure may run any number of times, so capturing a value written `linear` in one is not handing it on exactly once. `peek` captures `h`, and the build refuses the capture."
  program {
    imports [
      "App.close"
      "App.look"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            let "peek"
            value {
              closure {
                result {
                  call {
                    arguments [
                      {
                        ref "h"
                      }
                    ]
                    procedure "App.look"
                  }
                }
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.look" {
        answers 1
        parameters [
          {
            name "first"
            type "borrowing App.Handle"
          }
        ]
        returns "int"
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

