(test 1)
(name "a-piece-of-first-not-declaring-isolated-refuses")
(note "`Standard.Concurrent.first` takes isolated closures, the same as `all`. The piece writes the variable `tally` it captured, as a closure not declaring `isolated` may, and it is handed where `isolated` is declared, so the build refuses it there.")

(program
  (warp 1)
  (import Standard.Concurrent.first)
  (procedure entry
    (access public)
    (returns Int)
    (failing concurrent_failed)
    (body
      (var tally 0)
      (call Standard.Concurrent.first
        (array
          (closure
            (returns Int)
            (body
              (set tally 1)
              (return 1)))))
      (return tally))))
(expect (refuses build))
