warpt 1
{
  expect {
    refuses "build"
  }
  name "a-claim-naming-a-membership-where-a-contract-belongs-refuses"
  note "A claim names a type and the contracts it answers. A membership where a contract belongs is a claim no document arriving later can make right, and it is refused at the claim."
  program {
    constraints {
      "app.Scalar" [
        "int"
        "string"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
      }
    }
    satisfies {
      "bank.Account" [
        "app.Scalar"
      ]
    }
    types {
      "bank.Account" {
        record {
          balance "int"
        }
      }
    }
    warp 1
  }
  test 1
}

