warpt 1
{
  expect {
    answers "a"
  }
  name "a-cast-of-a-closure-a-membership-slot-held-back-to-the-record-it-answers-answers"
  note "`c` is held at `procedure() -> Bank.A`, then at `procedure() -> App.M`, which admits `Bank.A` and `Int`. A membership settles nothing, so that slot adds no answer, and the cast back to `procedure() -> Bank.A` takes the closure: `App.P.show` reaches `Bank.A`'s witness."
  program {
    constraints {
      "App.M" [
        "Bank.A"
        "Int"
      ]
    }
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.P"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "j"
            type {
              procedure {
                returns "App.M"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "e"
            value {
              as {
                of {
                  ref "j"
                }
                type {
                  procedure {
                    returns "Bank.A"
                  }
                }
              }
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "e"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

