(test 1)
(name "a-whole-literal-beside-a-fraction-at-a-bounded-parameter-is-held-to-the-bound-as-the-fraction")
(note "`App.Scalable` is claimed for `Double` alone. `scale` is handed `2` and `0.5` where `Self` stands twice, so `Self` reads `Double` and the call hands `2` on as the fraction it names. That fraction is what the bound is held to, and nothing asks a claim about `Int`.")

(program
  (warp 1)
  (contract App.Scalable
    (procedure scale
      (parameter of (type Self))
      (parameter by (type Self))
      (returns Self)))
  (extension
    (head Double)
    (satisfies App.Scalable)
    (procedure scale
      (parameter of (type Double))
      (parameter by (type Double))
      (returns Double)
      (body
        (return of))))
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call App.Scalable.scale 2 0.5)))))
(expect (answers 2.0))
