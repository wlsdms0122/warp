warpt 1
{
  expect {
    refuses "build"
  }
  name "a-struct-literal-in-a-list-beside-a-list-of-another-struct-at-a-type-parameter-refuses"
  note "`App.same` takes `some T` twice. A struct literal fills nothing, so the list holding it beside `s`, an `App.S`, reads as a list of `App.S`, and the list handed first reads as a list of `App.P`: the readings fill `T` two ways, so the call has no answer to read the literal as, and it refuses at the build."
  program {
    imports []
    procedures {
      "App.same" {
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "p"
            type "App.P"
            value {
              struct {
                a 1
              }
            }
          }
          {
            let "s"
            type "App.S"
            value {
              struct {
                b "hi"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    {
                      ref "p"
                    }
                  ]
                  [
                    {
                      struct {
                        a 2
                      }
                    }
                    {
                      ref "s"
                    }
                  ]
                ]
                procedure "App.same"
              }
            }
          }
        ]
        result {
          ref "r[1].a"
        }
        returns "Int"
      }
    }
    types {
      "App.P" {
        struct {
          a "Int"
        }
      }
      "App.S" {
        struct {
          b "String"
        }
      }
    }
    warp 1
  }
  test 1
}

