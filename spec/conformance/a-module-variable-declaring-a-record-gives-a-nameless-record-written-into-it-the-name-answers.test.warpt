warpt 1
{
  expect {
    answers "a"
  }
  name "a-module-variable-declaring-a-record-gives-a-nameless-record-written-into-it-the-name-answers"
  note "`r` is a module variable declaring `Bank.A`, and a body writes the nameless record `{ k: \"y\" }` into it. The write settles to what the variable declares, so `r` holds a `Bank.A`, and `App.P.show`, which `Bank.A` answers, is sent to it."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.P"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            set "r"
            value {
              record {
                k "y"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "r"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
    }
    var {
      r {
        type "Bank.A"
        value {
          record {
            k "x"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

