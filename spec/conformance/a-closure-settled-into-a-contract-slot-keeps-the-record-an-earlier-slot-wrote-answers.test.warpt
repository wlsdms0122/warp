warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-settled-into-a-contract-slot-keeps-the-record-an-earlier-slot-wrote-answers"
  note "`c` is held at `procedure() -> bank.A`, its closure answering the nameless `{ k: \"x\" }`, and `d` holds it again at `procedure() -> app.P`, which `bank.A` answers. The closure keeps both answers in turn, so the call inside `app.run` settles it to `bank.A` and then to `app.P`, which a `bank.A` already is, and `app.P.show` reaches `bank.A`'s witness."
  program {
    contracts {
      "app.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      "bank.A.show" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "d"
            type {
              procedure {
                returns "app.P"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                ]
                procedure "app.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "app.P.show"
          }
        }
      }
    }
    satisfies {
      "bank.A" [
        "app.P"
      ]
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

