warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-settled-into-a-contract-slot-keeps-the-record-an-earlier-slot-wrote-answers"
  note "`c` is held at `procedure() -> Bank.A`, its closure answering the nameless `{ k: \"x\" }`, and `d` holds it again at `procedure() -> App.P`, which `Bank.A` answers. The closure keeps both answers in turn, so the call inside `App.run` settles it to `Bank.A` and then to `App.P`, which a `Bank.A` already is, and `App.P.show` reaches `Bank.A`'s witness."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "d"
            type {
              procedure {
                returns "App.P"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "d"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

