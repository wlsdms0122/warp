warpt 1
{
  expect {
    refuses "build"
  }
  name "a-member-under-a-head-takes-the-heads-bounds"
  note "A member given under `App.Box<some T: Hashable>` holds the `T` its signature writes to `Hashable`, so calling it with a box of App.Plain refuses at the build: the member is there where the head takes the value."
  program {
    extensions {
      "App.Box<some T: Hashable>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "App.Box<some T>"
              }
            ]
            result "box"
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                as {
                  of {
                    struct {
                      item {
                        struct {
                          x 1
                        }
                      }
                    }
                  }
                  type "App.Box<App.Plain>"
                }
              }
            ]
            procedure "App.Box.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
      "App.Plain" {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

