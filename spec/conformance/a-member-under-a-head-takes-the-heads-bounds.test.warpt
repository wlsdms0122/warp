(test 1)
(name "a-member-under-a-head-takes-the-heads-bounds")
(note "A member given under `App.Box<some T: Hashable>` holds the `T` its signature writes to `Hashable`, so calling it with a box of App.Plain refuses at the build: the member is there where the head takes the value.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (struct App.Plain
    (field x Int))
  (extension
    (head (named App.Box (some T Hashable)))
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.Box.describe (as (struct (field item (struct (field x 1)))) (named App.Box App.Plain)))))))
(expect (refuses build))
