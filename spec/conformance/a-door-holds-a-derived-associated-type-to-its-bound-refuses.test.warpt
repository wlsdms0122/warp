(test 1)
(name "a-door-holds-a-derived-associated-type-to-its-bound-refuses")
(note "The entry bounds `C.Item` by App.Describable, which only Int answers, and the run hands a box of text at C, so the door refuses it.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item))))))
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String)))
    (extension
      (head Int)
      (satisfies App.Describable)
      (procedure describe
        (access public)
        (parameter of (type Int))
        (returns String)
        (result "one")))))

(program
  (warp 1)
  (import App.Describable)
  (import App.Describable.describe)
  (import Lib.Container)
  (import Lib.Container.first)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Container)))
    (returns String)
    (bound C.Item App.Describable)
    (body
      (let y (call Lib.Container.first c)))
    (result (call App.Describable.describe y))))
(arguments (argument c (struct App.Box (field item "s"))))
(expect (refuses run))
