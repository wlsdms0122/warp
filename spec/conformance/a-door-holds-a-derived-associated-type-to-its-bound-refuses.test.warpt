warpt 1
{
  arguments {
    c App.Box {
      item "s"
    }
  }
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          parameters [
            {
              name "c"
              type "some C: Lib.Container"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      extensions {
        Int {
          procedures {
            describe {
              access "public"
              parameters [
                {
                  name "of"
                  type "Int"
                }
              ]
              result "one"
              returns "String"
            }
          }
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports []
      warp 1
    }
  ]
  expect {
    refuses "run"
  }
  name "a-door-holds-a-derived-associated-type-to-its-bound-refuses"
  note "The entry bounds `C.Item` by App.Describable, which only Int answers, and the run hands a box of text at C, so the door refuses it."
  program {
    imports [
      "App.Describable"
      "App.Describable.describe"
      "Lib.Container"
      "Lib.Container.first"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "y"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "Lib.Container.first"
              }
            }
          }
        ]
        bounds {
          "C.Item" "App.Describable"
        }
        parameters [
          {
            name "c"
            type "some C: Lib.Container"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "y"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

