warpt 1
{
  expect {
    answers 0
  }
  name "remainder-at-the-words-minimum-answers"
  note "A remainder is smaller than its divisor, so it always fits the word — the one divisor that trips a machine's division instruction still has an answer, and it is 0. Overflow never reaches remainder."
  program {
    imports [
      "std.math.remainder"
    ]
    procedures {
      entry {
        result {
          call {
            arguments {
              value -1
            }
            of -9223372036854775808
            procedure "std.math.remainder"
          }
        }
      }
    }
    warp 2
  }
  test 1
}
