warpt 1
{
  expect {
    refuses "build"
  }
  name "a-whole-literal-where-a-bounded-parameter-stands-refuses"
  note "Inside a body, a type parameter is one type the body does not know, held to its bounds. A whole number written as a literal is an Int, and an Int is not known to be that type, however many types answering the bound it may be: arithmetic handing it beside the parameter is refused at the build."
  program {
    imports [
      "Standard.Numeric"
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.next" {
        parameters [
          {
            name "x"
            type "some T: Standard.Numeric"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              2
            ]
            procedure "App.next"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

