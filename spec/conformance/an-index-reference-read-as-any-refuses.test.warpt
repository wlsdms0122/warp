warpt 1
{
  expect {
    refuses "build"
  }
  name "an-index-reference-read-as-any-refuses"
  note "An index stands where an Int is read, and `which` reads Any, which stands only where Any is declared until a cast says what it is, so the build refuses the reference."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "which"
            type "Any"
            value 0
          }
          {
            let "items"
            value [
              1
              2
            ]
          }
        ]
        result {
          ref "items[which]"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

