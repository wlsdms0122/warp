(test 1)
(name "an-associated-type-is-one-type-the-body-does-not-know-refuses")
(note "Without a same type, `C.Item` inside `Use.plusOne` is a type the body does not know, and `Int.plus` takes no value of it.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item))))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Container)
    (import Lib.Container.first)
    (procedure Use.plusOne
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns Int)
      (body
        (let x (call Lib.Container.first c)))
      (result (call Int.plus x 1)))))

(program
  (warp 1)
  (import App.Box)
  (import Use.plusOne)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1))))
    (result (call Use.plusOne b))))
(expect (refuses build))
