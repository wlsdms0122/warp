warpt 1
{
  expect {
    answers [
      "{\"a\":\"x\",\"b\":1}"
      "Point {\"x\":1}"
      "{}"
    ]
  }
  name "text-spells-a-record-on-one-line"
  note "text spells a container on one line: a dictionary's entries between braces as the key quoted, a colon and the value; a named record the same with its name and a space in front; an empty one as its two braces."
  program {
    imports [
      "std.text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "plain"
            value {
              call {
                arguments [
                  {
                    record {
                      a "x"
                      b 1
                    }
                  }
                ]
                procedure "std.text.text"
              }
            }
          }
          {
            let "named"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        record {
                          x 1
                        }
                      }
                      type "Point"
                    }
                  }
                ]
                procedure "std.text.text"
              }
            }
          }
          {
            let "empty"
            value {
              call {
                arguments [
                  {
                    record {}
                  }
                ]
                procedure "std.text.text"
              }
            }
          }
        ]
        result [
          {
            ref "plain"
          }
          {
            ref "named"
          }
          {
            ref "empty"
          }
        ]
      }
    }
    types {
      Point {
        record {
          x "int"
        }
      }
    }
    warp 1
  }
  test 1
}

