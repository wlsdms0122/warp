(test 1)
(name "case-mapping-takes-no-locale")
(note "Case mapping is Unicode's default and no locale's tailoring: `i` uppercases to `I` and `I` lowercases to `i` everywhere, whatever the machine's locale says about a dotted i.")

(program
  (warp 1)
  (import Standard.Text.lowercased)
  (import Standard.Text.uppercased)
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (return (array (call Standard.Text.uppercased "i") (call Standard.Text.lowercased "I"))))))
(expect (answers (array "I" "i")))
