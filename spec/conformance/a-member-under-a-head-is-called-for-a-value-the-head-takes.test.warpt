(test 1)
(name "a-member-under-a-head-is-called-for-a-value-the-head-takes")
(note "A member given under `App.Box<some T: Hashable>` is called by its type's name and its own, here with a box of `Int`, which the head takes.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (extension
    (head (named App.Box (some T Hashable)))
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.Box.describe (as (struct (field item 1)) (named App.Box Int)))))))
(expect (answers "box"))
