(test 1)
(name "a-map-keyed-by-a-type-parameter-bounded-by-hashable-answers")
(note "A type parameter its bounds hold to `Hashable` answers it, so a map keyed by one is a map whatever key type a call fills it with, and the document builds.")

(program
  (warp 1)
  (procedure App.f
    (parameter m (type (dictionary (some K Hashable) Int)))
    (returns Int)
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (answers 1))
