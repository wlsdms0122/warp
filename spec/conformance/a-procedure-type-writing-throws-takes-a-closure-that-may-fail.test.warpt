(test 1)
(name "a-procedure-type-writing-throws-takes-a-closure-that-may-fail")
(note "`throws` alone says the procedure may fail with anything, so a closure that aborts stands where `(Int) throws -> Int` is declared, as one does under `throws(aborted)`. Nothing calls them, and the run answers 1.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (type (procedure (parameters Int) (failing (anything)) (returns Int)))
        (closure
          (parameter x (type Int))
          (returns Int)
          (failing aborted)
          (result (call Standard.Control.abort "no"))))
      (let g
        (type (procedure (parameters Int) (failing aborted) (returns Int)))
        (closure
          (parameter x (type Int))
          (returns Int)
          (failing aborted)
          (result (call Standard.Control.abort "no")))))
    (result 1)))
(expect (answers 1))
