warpt 1
{
  expect {
    answers "took"
  }
  name "a-contract-or-null-slot-takes-a-membership-whose-members-answer-or-are-null"
  note "App.f takes App.Sized? and is handed a value of App.Maybe, whose one member is Bank.Card?. Each member is a Bank.Card, which answers App.Sized, or null, which the slot takes."
  program {
    constraints {
      "App.Maybe" [
        "Bank.Card?"
      ]
    }
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized?"
          }
        ]
        result "took"
        returns "string"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type "App.Maybe"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "string"
        }
      }
      "Bank.Coin" {
        record {
          cents "int"
        }
      }
    }
    warp 1
  }
  test 1
}

