warpt 1
{
  expect {
    answers "took"
  }
  name "a-contract-or-null-slot-takes-a-membership-whose-members-answer-or-are-null"
  note "app.f takes app.Sized? and is handed a value of app.Maybe, whose one member is bank.Card?. Each member is a bank.Card, which answers app.Sized, or null, which the slot takes."
  program {
    constraints {
      "app.Maybe" [
        "bank.Card?"
      ]
    }
    contracts {
      "app.Sized" {
        size {
          parameters [
            {
              name "of"
              type "app.Sized"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "app.f" {
        parameters [
          {
            name "n"
            type "app.Sized?"
          }
        ]
        result "took"
        returns "string"
      }
      "bank.Card.size" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
        ]
        result 4
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type "app.Maybe"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "app.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "bank.Card" [
        "app.Sized"
      ]
    }
    types {
      "bank.Card" {
        record {
          last "string"
        }
      }
      "bank.Coin" {
        record {
          cents "int"
        }
      }
    }
    warp 1
  }
  test 1
}

