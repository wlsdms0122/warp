warpt 1
{
  expect {
    refuses "run"
  }
  name "a-declaration-answering-a-contract-with-any-is-judged-where-the-call-reads-it-refuses"
  note "The contract answers string and the declaration answering it answers any, holding an int. A call through the contract reads the answer as text, and judges it there."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports [
      "Standard.Collection.appending"
    ]
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 5
        returns "Any"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "d"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
          {
            let "xs"
            value {
              call {
                arguments [
                  [
                    "a"
                  ]
                  {
                    ref "d"
                  }
                ]
                procedure "Standard.Collection.appending"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

