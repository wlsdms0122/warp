(test 1)
(name "split-on-nothing-fails")
(note "A separator with no characters matches everywhere and consumes nothing, so there is no text `split` could cut. It fails with `aborted`, and an attempt around it catches it because it is a failure and not a refusal.")

(program
  (warp 1)
  (import Standard.Text.split)
  (procedure entry
    (access public)
    (returns (nullable (dictionary String String)))
    (body
      (let tried
        (attempt
          (body
            (call Standard.Text.split "a,b" ""))
          (rescue
            (result (dictionary (entry "message" (path tried (field message))) (entry "type" (path tried (field type)))))))))
    (result tried)))
(expect (answers (dictionary (entry "message" "split asks an empty separator") (entry "type" "aborted"))))
