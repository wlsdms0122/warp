(test 1)
(name "split-on-nothing-fails")
(note "A separator with no characters matches everywhere and consumes nothing, so there is no string `split` could cut. It fails with `aborted`, and a try around it catches it because it is a failure and not a refusal.")

(program
  (warp 1)
  (import Standard.Text.split)
  (procedure entry
    (access public)
    (returns (optional (dictionary String String)))
    (body
      (var tried)
      (let caught
        (try
          (body
            (call Standard.Text.split "a,b" ""))
          (catch
            (set tried (dictionary (entry "message" (path caught (field message))) (entry "type" (path caught (field type))))))))
      (return tried))))
(expect (answers (dictionary (entry "message" "split asks an empty separator") (entry "type" "aborted"))))
