warpt 1
{
  expect {
    refuses "build"
  }
  name "an-effect-in-a-contract-calls-operand-refuses"
  note "What a slot takes has nothing to do with whether the operand written into it is read or run. A call through a contract reaches whatever type arrives, and its operands are data all the same."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "note"
            }
          ]
          returns "String"
        }
      }
    }
    imports [
      "Standard.Concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  struct {
                    balance 1
                  }
                }
                type "Bank.Account"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
              {
                call {
                  arguments [
                    []
                  ]
                  procedure "Standard.Concurrent.all"
                }
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.Account" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Account"
              }
              {
                name "note"
              }
            ]
            result "an account"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

