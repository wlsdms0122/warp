warpt 1
{
  expect {
    refuses "build"
  }
  name "an-effect-in-a-contract-calls-operand-refuses"
  note "What a slot takes has nothing to do with whether the operand written into it is read or run. A call through a contract reaches whatever type arrives, and its operands are data all the same."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "App.Describable"
            }
            {
              name "note"
              type "any"
            }
          ]
          returns "string"
        }
      }
    }
    imports [
      "Standard.Concurrent.all"
    ]
    procedures {
      "Bank.Account.describe" {
        parameters [
          {
            name "of"
            type "Bank.Account"
          }
          {
            name "note"
            type "any"
          }
        ]
        result "an account"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "Bank.Account"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
              {
                call {
                  arguments [
                    []
                  ]
                  procedure "Standard.Concurrent.all"
                }
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "Bank.Account" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Account" {
        record {
          balance "int"
        }
      }
    }
    warp 1
  }
  test 1
}

