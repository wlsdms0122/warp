(test 1)
(name "a-value-from-outside-at-a-bounded-parameter-is-held-to-the-head-of-its-claim")
(note "The entry takes `some T` bounded by App.Describable, and the host hands a box holding `1`. A value carries no type's arguments, so the door holds it to the head `App.Box<Int?>` by whether it settles there, which it does.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (nullable Int)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (nullable Int))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (parameter x (type (some T App.Describable)))
    (returns String)
    (body
      (return (call App.Describable.describe x)))))
(arguments (argument x (struct App.Box (field item 1))))
(expect (answers "box"))
