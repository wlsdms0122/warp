warpt 1
{
  expect {
    refuses "run"
  }
  name "a-list-holding-no-byte-handed-to-decoded-as-a-constant-refuses"
  note "Bytes are whole numbers from 0 to 255, and what a value means is the procedure's to say when it runs: `300` is no byte, so the run refuses the call, though the list is written as a constant."
  program {
    imports [
      "Standard.Text.decoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                104
                300
              ]
              "utf8"
            ]
            procedure "Standard.Text.decoded"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

