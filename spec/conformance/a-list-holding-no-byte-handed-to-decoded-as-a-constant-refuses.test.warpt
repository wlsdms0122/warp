warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-holding-no-byte-handed-to-decoded-as-a-constant-refuses"
  note "Bytes are whole numbers from 0 to 255, and `decoded` judges its own constant arguments before any run: `300` is no byte, so the build refuses the call."
  program {
    imports [
      "Standard.Text.decoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                104
                300
              ]
              "utf8"
            ]
            procedure "Standard.Text.decoded"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

