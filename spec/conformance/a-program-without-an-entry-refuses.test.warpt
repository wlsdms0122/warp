warpt 1
{
  expect {
    refuses "build"
  }
  name "a-program-without-an-entry-refuses"
  note "A runner starts from the procedure spelled `entry`. A document that declares none reads and compiles like any other, and is refused at the build, where a name nothing in the link declares is refused."
  program {
    imports []
    procedures {
      other {
        result 1
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

