warpt 1
{
  expect {
    refuses "load"
  }
  name "an-extension-writing-nothing-refuses"
  note "An extension that gives a type nothing is no extension the writer writes, so the document says one thing two ways and the load refuses it."
  program {
    extensions {
      Int {}
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

