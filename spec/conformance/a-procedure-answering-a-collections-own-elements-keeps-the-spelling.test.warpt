warpt 1
{
  expect {
    answers [
      x"6968"
      x"6869"
      [
        104
        105
        300
      ]
    ]
  }
  name "a-procedure-answering-a-collections-own-elements-keeps-the-spelling"
  note "reversed and sorted answer a collection's own elements in another order, so bytes answer bytes. Sorted included, whose element declaration carries a bound: a member that takes every byte answers the membership for all of them at once. appending puts something among them that is not a byte, and the answer says so by the spelling it comes back in. The spelling is a fact about the value, and claiming otherwise would be a claim no value backs."
  program {
    imports [
      "Standard.Collection.appending"
      "Standard.Collection.reversed"
      "Standard.Collection.sorted"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "back"
            value {
              call {
                arguments [
                  x"6869"
                ]
                procedure "Standard.Collection.reversed"
              }
            }
          }
          {
            let "ordered"
            value {
              call {
                arguments [
                  x"6968"
                ]
                procedure "Standard.Collection.sorted"
              }
            }
          }
          {
            let "grown"
            value {
              call {
                arguments [
                  x"6869"
                  300
                ]
                procedure "Standard.Collection.appending"
              }
            }
          }
        ]
        result [
          {
            ref "back"
          }
          {
            ref "ordered"
          }
          {
            ref "grown"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

