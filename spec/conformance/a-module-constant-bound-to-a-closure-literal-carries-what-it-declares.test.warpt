warpt 1
{
  expect {
    answers 1
  }
  name "a-module-constant-bound-to-a-closure-literal-carries-what-it-declares"
  note "`k` is a module constant bound to a closure literal declared const. A constant is a fixed name, and a fixed name that writes no type follows the type written where its value came from, here the closure's signature, so `entry`, declared const, may call it."
  program {
    const {
      k {
        closure {
          const true
          result 1
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        const true
        result {
          call {
            procedure {
              ref "k"
            }
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

