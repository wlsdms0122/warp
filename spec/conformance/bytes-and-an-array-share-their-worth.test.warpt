warpt 1
{
  expect {
    answers true
  }
  name "bytes-and-an-array-share-their-worth"
  note "bytes = Array<Standard.Byte>: x\"6869\" is the compact spelling of the whole numbers 104 and 105 in order. Worth unifies across spellings the way 1 and 1.0 do, and the spellings stay two values the same way."
  program {
    imports [
      "Standard.Logic.equal"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              x"6869"
              [
                104
                105
              ]
            ]
            procedure "Standard.Logic.equal"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

