warpt 1
{
  expect {
    answers true
  }
  name "bytes-and-an-array-share-their-worth"
  note "bytes = array<byte>: x\"6869\" is the compact spelling of the whole numbers 104 and 105 in order. Worth unifies across spellings the way 1 and 1.0 do, and the spellings stay two values the same way."
  program {
    imports [
      "std.logic.equal"
    ]
    procedures {
      entry {
        result {
          call {
            arguments {
              value [
                104
                105
              ]
            }
            of x"6869"
            procedure "std.logic.equal"
          }
        }
      }
    }
    warp 1
  }
  test 2
}
