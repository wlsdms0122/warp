warpt 1
{
  expect {
    answers 5
  }
  name "a-name-written-whole-after-handing-on-holds-the-new-value"
  note "`x` handed its handle to `App.close`, and the write of the whole name gives it a record of its own again, so reading through `x.name` reads the new value."
  program {
    imports [
      "App.close"
      "App.mkq"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "App.mkq"
              }
            }
            var "x"
          }
          {
            let "d"
            type "Dictionary<Int>"
            value {
              record {
                f 5
                h 5
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "x"
                  }
                ]
                procedure "App.close"
              }
            }
          }
          {
            set "x"
            value {
              record {
                name "f"
              }
            }
          }
          {
            let "v"
            value {
              ref "d[x.name]"
            }
          }
        ]
        result {
          ref "v"
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.mkq" {
        answers {
          name "h"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

