warpt 1
{
  expect {
    answers null
  }
  name "a-cast-between-aliases-of-two-nullable-records-reads-null-answers"
  note "`app.NA` names `app.A?` and `app.NB` names `app.B?`. Each is an alias and stands for what it names, so null is a value of both, the cast could hold and builds, and the run reads null as one of `app.NB`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "n"
            type "app.NA"
            value null
          }
        ]
        result {
          as {
            of {
              ref "n"
            }
            type "app.NB"
          }
        }
      }
    }
    types {
      "app.A" {
        record {
          a "string"
        }
      }
      "app.B" {
        record {
          b "int"
        }
      }
      "app.NA" "app.A?"
      "app.NB" "app.B?"
    }
    warp 1
  }
  test 1
}

