warpt 1
{
  expect {
    refuses "link"
  }
  name "a-bare-constraint-name-refuses-at-the-link"
  note "`Comparable` is not the spelling of any declaration in the link: `std` declares `std.Comparable`, and this document declares no constraint of its own. A name is looked up as written, so the bound refuses at the link."
  program {
    imports []
    procedures {
      entry {
        result {
          call {
            arguments {
              value 3
            }
            procedure "keep"
          }
        }
        returns "int"
      }
      keep {
        bounds {
          T "Comparable"
        }
        parameters {
          value "some T"
        }
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 2
  }
  test 1
}
