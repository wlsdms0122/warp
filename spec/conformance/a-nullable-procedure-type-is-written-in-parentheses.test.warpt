(test 1)
(name "a-nullable-procedure-type-is-written-in-parentheses")
(note "A `?` meaning the whole procedure may be null follows parentheses around it, `((Int) -> Int)?`, since one after its answer would be the answer's. Null stands there.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (nullable (procedure (parameters Int) (returns Int))))
    (body
      (let f (type (nullable (procedure (parameters Int) (returns Int)))) null))
    (result f)))
(expect (answers null))
