(test 1)
(name "a-struct-applied-to-itself-reads-the-inner-field-answers")
(note "`App.Box<App.Box<Int>>` reads its field as `App.Box<Int>`, so the inner literal is that struct and its field reads as `Int`.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box (named App.Box Int))) (struct (field item (struct (field item 4))))))
    (result (path b (field item) (field item)))))
(expect (answers 4))
