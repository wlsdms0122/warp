(test 1)
(name "a-struct-keying-a-map-by-an-unbounded-parameter-refuses")
(note "A map's key answers `Hashable`, and a type parameter answers what its bounds name. `App.Cache` keys its map by `K` and bounds nothing, so the declaration is refused at the build.")

(program
  (warp 1)
  (struct App.Cache
    (typeParameter K)
    (typeParameter V)
    (field table (dictionary (some K) (some V))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
