warpt 1
{
  expect {
    answers "1.0"
  }
  name "a-whole-literal-a-closure-answers-is-the-fraction-its-returns-names"
  note "`c` holds a closure literal writing `returns Double`, and a closure's declared answer is a place a literal is written into, so its result `1` is the fraction 1.0, and the text of the answer says so."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "() -> Double"
            value {
              closure {
                result 1
                returns "Double"
              }
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

