(test 1)
(name "min-returns-lhs-on-a-tie")
(note "Two values that order the same are a tie, and on a tie min returns lhs as it arrived: 0.0 and -0.0 are one worth, and their text tells which came back.")

(program
  (warp 1)
  (import Standard.Math.min)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call Standard.Text.text (call Standard.Math.min 0.0 -0.0))))))
(expect (answers "0.0"))
