warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-under-another-name-refuses"
  note "Two declared records of one type under two names are two types. A value read as a `Vault` fits no `Account` slot, and the build reads that off the cast."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "Vault"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
            ]
            procedure "read"
          }
        }
        returns "int"
      }
      read {
        parameters [
          {
            name "account"
            type "Account"
          }
        ]
        result {
          ref "account.balance"
        }
        returns "int"
      }
    }
    types {
      Account {
        record {
          balance "int"
        }
      }
      Vault {
        record {
          balance "int"
        }
      }
    }
    warp 1
  }
  test 1
}

