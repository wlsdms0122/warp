warpt 1
{
  expect {
    answers [
      2
      1
    ]
  }
  name "two-paths-under-one-head-are-handed-in-place-to-one-call"
  note "Two `inout` parameters may be handed paths under one head. Both hold the same box, and each write lands in it as it is made, so swapping through them swaps the elements."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            value [
              1
              2
            ]
            var "xs"
          }
          {
            value {
              call {
                arguments {
                  left {
                    ref "xs[0]"
                  }
                  right {
                    ref "xs[1]"
                  }
                }
                procedure "swap"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
        returns "array<int>"
      }
      swap {
        body [
          {
            let "held"
            value {
              ref "left"
            }
          }
          {
            set "left"
            value {
              ref "right"
            }
          }
          {
            set "right"
            value {
              ref "held"
            }
          }
        ]
        parameters {
          left "inout int"
          right "inout int"
        }
      }
    }
    warp 1
  }
  test 2
}
