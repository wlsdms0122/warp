warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bare-token-running-into-a-quote-refuses"
  note "Whitespace separates a bare token from a string. `a\"hi\"` is not a key and a value laid out close together: a bare token ends at whitespace or a bracket, and the one token that begins with a letter and a quote is bytes, `x\"6a\"`."
  test 5
  text "warpt 1\n{ a\"hi\" }\n"
}

