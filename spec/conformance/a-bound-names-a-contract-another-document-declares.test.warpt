warpt 1
{
  documents [
    {
      contracts {
        "Num.Scalar" {}
      }
      extensions {
        Int {
          satisfies [
            "Num.Scalar"
          ]
        }
        String {
          satisfies [
            "Num.Scalar"
          ]
        }
      }
      imports []
      warp 1
    }
  ]
  expect {
    answers "k"
  }
  name "a-bound-names-a-contract-another-document-declares"
  note "A contract is declared once under a name, and a signature in another document bounds a type parameter by it the way it would by its own: the name is listed in imports, and the bound holds the parameter to what answers the contract."
  program {
    imports [
      "Num.Scalar"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "k"
            ]
            procedure "keep"
          }
        }
        returns "String"
      }
      keep {
        parameters [
          {
            name "value"
            type "some T: Num.Scalar"
          }
        ]
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 1
}

