warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-handed-on-inside-a-loop-round-refuses"
  note "A round runs no fixed number of times, so handing on a value written `linear` inside one is not handing it on exactly once."
  program {
    imports [
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            let "spin"
            value {
              loop {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "handle"
                          }
                        ]
                        procedure "app.close"
                      }
                    }
                  }
                ]
                while false
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

