warpt 1
{
  expect {
    answers App.Handle {
      name "f"
    }
  }
  name "a-linear-value-is-handed-on"
  note "A type written `linear` says its values are handed on: given to a procedure, or answered. A body that answers one has handed it on, and its caller owes it from there. Only a procedure with no body ends the obligation, since what a resource is lives outside the document."
  program {
    imports []
    procedures {
      "App.open" {
        result {
          as {
            of {
              record {
                name "f"
              }
            }
            type "App.Handle"
          }
        }
        returns "App.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
        ]
        result {
          ref "handle"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

