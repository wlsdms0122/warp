warpt 1
{
  expect {
    answers "b"
  }
  name "a-closure-a-record-slot-took-the-name-from-settles-into-another-record-slot-answers"
  note "`c` is held at `procedure() -> Bank.A`, `d` holds it at `procedure() -> { k: string }`, and `e` at `procedure() -> Bank.B`. The nameless slot takes `Bank.A`'s name off what a call answers, so the answer no longer bears `Bank.A`, and `Bank.B`'s slot takes the closure: a call of `e` settles the record to `Bank.B`, and `App.P.show` reaches `Bank.B`'s witness."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      "Bank.B.show" {
        parameters [
          {
            name "of"
            type "Bank.B"
          }
        ]
        result "b"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "d"
            type {
              procedure {
                returns {
                  record {
                    k "string"
                  }
                }
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "e"
            type {
              procedure {
                returns "Bank.B"
              }
            }
            value {
              ref "d"
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "e"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
      "Bank.B" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        record {
          k "string"
        }
      }
      "Bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

