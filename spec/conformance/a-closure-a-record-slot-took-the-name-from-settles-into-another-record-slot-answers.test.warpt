warpt 1
{
  expect {
    answers "b"
  }
  name "a-closure-a-record-slot-took-the-name-from-settles-into-another-record-slot-answers"
  note "`c` is held at `procedure() -> bank.A`, `d` holds it at `procedure() -> { k: string }`, and `e` at `procedure() -> bank.B`. The nameless slot takes `bank.A`'s name off what a call answers, so the answer no longer bears `bank.A`, and `bank.B`'s slot takes the closure: a call of `e` settles the record to `bank.B`, and `app.P.show` reaches `bank.B`'s witness."
  program {
    contracts {
      "app.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.A.show" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      "bank.B.show" {
        parameters [
          {
            name "of"
            type "bank.B"
          }
        ]
        result "b"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "d"
            type {
              procedure {
                returns {
                  record {
                    k "string"
                  }
                }
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "e"
            type {
              procedure {
                returns "bank.B"
              }
            }
            value {
              ref "d"
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "e"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "app.P.show"
          }
        }
      }
    }
    satisfies {
      "bank.A" [
        "app.P"
      ]
      "bank.B" [
        "app.P"
      ]
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
      "bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

