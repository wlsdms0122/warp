warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-read-as-lists-of-a-record-and-of-a-nameless-one-is-a-list-of-the-nameless-one"
  note "App.pick reads its some T as array<Bank.Card> and as a list of nameless records of its fields. The reading that holds both is a list of the nameless record, position by position, so the contract call on its first element refuses at the build."
  program {
    contracts {
      "App.Describable" {
        describe {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "String"
        }
      }
    }
    imports [
      "Standard.Collection.first"
    ]
    procedures {
      "App.pick" {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return {
                        ref "x"
                      }
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "Bool"
          }
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "some T"
      }
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  false
                  [
                    {
                      as {
                        of {
                          record {
                            last "42"
                          }
                        }
                        type "Bank.Card"
                      }
                    }
                  ]
                  [
                    {
                      record {
                        last "x"
                      }
                    }
                  ]
                ]
                procedure "App.pick"
              }
            }
          }
          {
            let "f"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "Standard.Collection.first"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "f"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Describable"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

