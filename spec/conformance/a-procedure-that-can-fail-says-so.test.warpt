warpt 1
{
  expect {
    answers "rescued"
  }
  name "a-procedure-that-can-fail-says-so"
  note "`std.control.abort` says it raises `aborted`, so the attempt around it stands and the rescue reads the procedure the failure names itself by."
  program {
    imports [
      "std.control.abort"
    ]
    procedures {
      entry {
        body [
          {
            let "tried"
            value {
              attempt {
                body []
                rescue {
                  result "rescued"
                }
                result {
                  call {
                    of "no"
                    procedure "std.control.abort"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
        returns "string"
      }
    }
    warp 1
  }
  test 2
}

