(test 1)
(name "a-closure-carries-what-a-captured-slot-said")
(note "What a slot says about the procedure it holds stands wherever the name is read, a closure that captured it included. That is what lets a body build one closure per element and hand the lot to a fan-out: each piece declares `isolated` and calls the captured `value`, whose slot said an `isolated` procedure type, so the build holds the piece to what it says.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (import Standard.Collection.count)
  (import Standard.Comparable.lessThan)
  (import Standard.Concurrent.all)
  (import Standard.Numeric.times)
  (procedure App.eachAtOnce
    (isolated)
    (parameter of (type (array Int)))
    (parameter value (type (procedure (isolated) (parameters Int) (returns Int))))
    (returns (array Int))
    (failing concurrent_failed)
    (body
      (var pieces (array))
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count of)))
          (body
            (let item (path of (index (path walk (field index)))))
            (let piece
              (closure
                (isolated)
                (returns Int)
                (body
                  (let answered (apply value item))
                  (return answered))))
            (set pieces (call Standard.Collection.appending pieces piece)))))
      (return (call Standard.Concurrent.all pieces))))
  (procedure entry
    (access public)
    (isolated)
    (returns (array Int))
    (failing concurrent_failed)
    (body
      (return
        (call App.eachAtOnce
          (array 1 2 3)
          (closure
            (const)
            (isolated)
            (parameter item (type Int))
            (returns Int)
            (body
              (return (call Standard.Numeric.times item 2)))))))))
(expect (answers (array 2 4 6)))
