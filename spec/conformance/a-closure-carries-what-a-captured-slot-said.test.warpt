warpt 1
{
  expect {
    answers [
      2
      4
      6
    ]
  }
  name "a-closure-carries-what-a-captured-slot-said"
  note "What a slot says about the procedure it holds stands wherever the name is read, a closure that captured it included. That is what lets a body build one closure per element and hand the lot to a fan-out: each piece calls the captured procedure and is isolated for the same reason the body around it would be."
  program {
    imports [
      "Standard.Collection.appending"
      "Standard.Collection.count"
      "Standard.Concurrent.all"
      "Standard.Math.lessThan"
      "Standard.Math.times"
    ]
    procedures {
      "App.eachAtOnce" {
        body [
          {
            value []
            var "pieces"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "item"
                    value {
                      ref "of[walk.index]"
                    }
                  }
                  {
                    let "piece"
                    value {
                      closure {
                        body [
                          {
                            let "answered"
                            value {
                              call {
                                arguments [
                                  {
                                    ref "item"
                                  }
                                ]
                                procedure {
                                  ref "value"
                                }
                              }
                            }
                          }
                        ]
                        result {
                          ref "answered"
                        }
                      }
                    }
                  }
                  {
                    set "pieces"
                    value {
                      call {
                        arguments [
                          {
                            ref "pieces"
                          }
                          {
                            ref "piece"
                          }
                        ]
                        procedure "Standard.Collection.appending"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "of"
                            }
                          ]
                          procedure "Standard.Collection.count"
                        }
                      }
                    ]
                    procedure "Standard.Math.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "Array<Int>"
          }
          {
            name "value"
            type {
              "isolated procedure" {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "pieces"
              }
            ]
            procedure "Standard.Concurrent.all"
          }
        }
        returns "Array<Int>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
                3
              ]
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                        2
                      ]
                      procedure "Standard.Math.times"
                    }
                  }
                  returns "Int"
                }
              }
            ]
            procedure "App.eachAtOnce"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

