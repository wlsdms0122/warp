(test 1)
(name "elements-of-different-types-join-to-any")
(note "An `Int` and a `String` written beside each other in a list are two parts that still differ, so they join to `Any`: the list reads `Array<Any>` rather than refusing.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (array Any))
    (body
      (let items (array 1 "a"))
      (return items))))
(expect (answers (array 1 "a")))
