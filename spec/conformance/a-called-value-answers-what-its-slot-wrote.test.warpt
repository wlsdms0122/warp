warpt 1
{
  expect {
    refuses "build"
  }
  name "a-called-value-answers-what-its-slot-wrote"
  note "Calling a value answers what the slot holding it wrote under `returns`, so a body that hands that answer up as something else is refused where both are written, the way a call's answer is."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                closure {
                  result 1
                  returns "Int"
                }
              }
            ]
            procedure "through"
          }
        }
        returns "String"
      }
      through {
        parameters [
          {
            name "body"
            type "() -> Int"
          }
        ]
        result {
          call {
            procedure {
              ref "body"
            }
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

