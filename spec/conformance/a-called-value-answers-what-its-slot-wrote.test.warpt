(test 1)
(name "a-called-value-answers-what-its-slot-wrote")
(note "Calling a value answers what the slot holding it wrote after `->`, so a body that hands that answer up as something else is refused where both are written, the way a call's answer is.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return
        (call through
          (closure
            (returns Int)
            (body
              (return 1)))))))
  (procedure through
    (parameter body (type (procedure (parameters) (returns Int))))
    (returns String)
    (body
      (return (apply body)))))
(expect (refuses build))
