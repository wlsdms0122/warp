warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-handed-on-once-inside-another-refuses-at-the-build"
  note "A value handed on once is followed by the name holding it, and nothing follows one into a list. A slot naming a list of such a type is refused at the build."
  program {
    imports []
    procedures {
      entry {
        parameters {
          item {
            type "consuming array<app.Handle>"
          }
        }
        result 1
        returns "int"
      }
    }
    types {
      "app.Handle" {
        linear {
          name "string"
        }
      }
    }
    warp 1
  }
  test 2
}

