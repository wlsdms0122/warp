warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-a-bounded-parameter-where-it-writes-a-parameter-refuses"
  note "The contract takes its own some T at n, bounded by nothing, and the declaration answering it takes some U there, bounded by App.Whole. Nothing about T proves it is an int."
  program {
    contracts {
      "App.Shown" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "n"
                type "some T"
              }
            ]
            returns "String"
          }
        }
      }
      "App.Sized" {
        procedures {
          size {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "Int"
          }
        }
      }
      "App.Whole" {}
    }
    extensions {
      Int {
        satisfies [
          "App.Whole"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  3
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          ref "s"
        }
        returns "String"
      }
    }
    types {
      "Bank.Card" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
              {
                name "n"
                type "some U: App.Whole"
              }
            ]
            result "shown"
            returns "String"
          }
        }
        satisfies [
          "App.Shown"
        ]
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

