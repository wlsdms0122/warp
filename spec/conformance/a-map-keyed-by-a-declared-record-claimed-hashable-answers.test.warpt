warpt 1
{
  expect {
    answers 1
  }
  name "a-map-keyed-by-a-declared-record-claimed-hashable-answers"
  note "A declared record answers `Hashable` where a document claims it does, and the claim asks no procedures, so a map keyed by the record builds."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "m"
            type "Dictionary<App.Point, Int>"
          }
        ]
        result 1
      }
      entry {
        access "public"
        result 1
      }
    }
    satisfies {
      "App.Point" [
        "Hashable"
      ]
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

