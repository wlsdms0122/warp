(test 1)
(name "a-contract-slot-takes-no-optional-where-both-conform-refuses")
(note "A reading of `Bank.Card?` is of the Optional of `Bank.Card`, which conforms to a contract only where a claim about it says so. `Bank.Card` and `Null` are claimed for `App.Described` and no Optional is, so handing the variable where the contract is asked refuses at the build.")

(program
  (warp 1)
  (struct Bank.Card
    (satisfies App.Described)
    (field last String)
    (procedure describe
      (parameter of (type Bank.Card))
      (returns String)
      (body
        (return "a card"))))
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Null)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Null))
      (returns String)
      (body
        (return "nothing"))))
  (procedure App.tell
    (parameter it (type App.Described))
    (returns String)
    (body
      (return (call App.Described.describe it))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let c (type (optional Bank.Card)) null)
      (return (call App.tell c)))))
(expect (refuses build))
