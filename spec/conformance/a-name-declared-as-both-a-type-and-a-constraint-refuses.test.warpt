warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-declared-as-both-a-type-and-a-constraint-refuses"
  note "A name is a type or a membership or a contract and never two of them. One declared under `types` and under `constraints` is refused at the build."
  program {
    constraints {
      Pair [
        "Int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    types {
      Pair {
        record {
          left "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

