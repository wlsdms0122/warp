warpt 1
{
  expect {
    answers "outer"
  }
  name "a-name-declared-again-inside-an-arm-is-a-new-name"
  note "A `var` inside an arm spelled like a name outside introduces a new name with a box of its own. The outer box keeps what it held."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value "outer"
            var "verdict"
          }
          {
            value {
              conditional {
                then [
                  {
                    value "inner"
                    var "verdict"
                  }
                ]
                when true
              }
            }
          }
        ]
        result {
          ref "verdict"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

