warpt 1
{
  expect {
    refuses "build"
  }
  name "a-generic-answer-every-member-takes-is-judged-against-what-filled-it-refuses"
  note "App.gen answers some T bounded by App.Real, whose one member is Double, and its body answers 2.5. The call fills T with Int, which App.Real does not admit, so the call is refused at the build."
  program {
    constraints {
      "App.Real" [
        "Double"
      ]
    }
    imports [
      "Standard.Collection.appending"
    ]
    procedures {
      "App.gen" {
        bounds {
          T "App.Real"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result 2.5
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                ]
                procedure "App.gen"
              }
            }
          }
          {
            let "xs"
            value {
              call {
                arguments [
                  [
                    1
                  ]
                  {
                    ref "r"
                  }
                ]
                procedure "Standard.Collection.appending"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
      }
    }
    warp 1
  }
  test 1
}

