warpt 1
{
  arguments {
    who Someone {
      name "a"
    }
  }
  expect {
    answers Person {
      name "a"
    }
  }
  name "an-alias-of-a-declared-record-gives-a-value-from-outside-the-records-name"
  note "A declared name standing for a declared record is an alias, and judges by what it stands for: a record from outside under the alias's name takes the record's own name at the door."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "who"
            type "Someone"
          }
        ]
        result {
          ref "who"
        }
      }
    }
    types {
      Person {
        record {
          name "String"
        }
      }
      Someone "Person"
    }
    warp 1
  }
  test 1
}

