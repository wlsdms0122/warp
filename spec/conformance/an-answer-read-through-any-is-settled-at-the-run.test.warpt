warpt 1
{
  arguments {
    payload "not a whole number"
  }
  expect {
    refuses "run"
  }
  name "an-answer-read-through-any-is-settled-at-the-run"
  note "`any` declares nothing about what is there, so a body answering one reads nothing the declaration could be held to. The document stands and the answer is settled where the value arrives, which is the run."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          payload {
            type "any"
          }
        }
        result {
          ref "payload"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

