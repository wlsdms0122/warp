warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-value-does-not-go-into-a-list"
  note "What follows the value is the name that holds it, and a name does not follow it into a type. Written into a list the obligation would be neither handed on nor still held."
  program {
    imports [
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
        ]
        result [
          {
            ref "handle"
          }
        ]
        returns "Any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

