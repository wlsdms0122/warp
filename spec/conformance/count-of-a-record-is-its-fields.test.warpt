warpt 1
{
  expect {
    answers 2
  }
  name "count-of-a-record-is-its-fields"
  note "A record stands as a dictionary, so count reads its fields, name or no name."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    record {
                      balance 1
                      owner "a"
                    }
                  }
                  type "Account"
                }
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    types {
      Account {
        record {
          balance "Int"
          owner "String"
        }
      }
    }
    warp 1
  }
  test 1
}

