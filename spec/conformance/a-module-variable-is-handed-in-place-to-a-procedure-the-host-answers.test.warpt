(test 1)
(name "a-module-variable-is-handed-in-place-to-a-procedure-the-host-answers")
(note "A module variable is handed in place to a procedure the host answers the way it is to any body: the procedure writes through the path it was handed, and the write is in the variable when the procedure answers.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (var items (array 1))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (call Standard.Collection.append items 2)
      (return items))))
(expect (answers (array 1 2)))
