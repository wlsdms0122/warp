(test 1)
(name "ordering-compares-two-of-one-type")
(note "The procedures that order values take what answers Standard.Comparable, and text answers it, so two pieces of text order.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (procedure entry
    (access public)
    (returns Bool)
    (result (call Standard.Comparable.lessThan "a" "b"))))
(expect (answers true))
