warpt 1
{
  expect {
    refuses "build"
  }
  name "a-variable-written-into-memberships-that-name-each-other-as-nullable-refuses"
  note "`app.M` admits `app.N?` and `array<int>`, and `app.N` admits `app.M?` and `bool`. A variable declared `app.M` starts with a name read as `array<string>`, which is not null, so each `?` is passed through to the membership it names, and asking `app.M` of the same reading again takes nothing. Neither `array<int>` nor `bool` takes it, so the build refuses."
  program {
    constraints {
      "app.M" [
        "app.N?"
        "array<int>"
      ]
      "app.N" [
        "app.M?"
        "bool"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "s"
            type "array<string>"
            value [
              "a"
            ]
          }
          {
            type "app.M"
            value {
              ref "s"
            }
            var "x"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

