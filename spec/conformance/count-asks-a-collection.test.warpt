warpt 1
{
  expect {
    refuses "build"
  }
  name "count-asks-a-collection"
  note "count takes what Standard.Collection admits: text, a list, a map. A number has no count, and a constant one is refused where the call is written rather than answered nothing at the run."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

