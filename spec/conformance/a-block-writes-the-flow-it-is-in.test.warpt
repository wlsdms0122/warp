warpt 1
{
  expect {
    answers 1
  }
  name "a-block-writes-the-flow-it-is-in"
  note "A block runs here, once, in the same flow, and no expression can carry it away, so it may `set` the enclosing variable."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "tally"
          }
          {
            let "blocked"
            value {
              block {
                body [
                  {
                    set "tally"
                    value 1
                  }
                ]
              }
            }
          }
        ]
        result {
          ref "tally"
        }
      }
    }
    warp 1
  }
  test 1
}

