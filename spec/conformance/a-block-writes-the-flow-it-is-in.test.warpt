warpt 1
{
  expect {
    answers 1
  }
  name "a-block-writes-the-flow-it-is-in"
  note "A block is the non-escaping reading of a closure: a body in a grammar position runs here, once, in the same flow, and nothing can carry it away. So it may set the enclosing variable. Exactly the write a closure is refused."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            value 0
            var "tally"
          }
          {
            let "blocked"
            value {
              block {
                body [
                  {
                    set "tally"
                    value 1
                  }
                ]
              }
            }
          }
        ]
        result {
          ref "tally"
        }
      }
    }
    warp 1
  }
  test 1
}
