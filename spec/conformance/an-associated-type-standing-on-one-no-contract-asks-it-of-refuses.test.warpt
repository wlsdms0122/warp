(test 1)
(name "an-associated-type-standing-on-one-no-contract-asks-it-of-refuses")
(note "`Lib.Container` asks Item and holds it to nothing, so no contract asks a Key of `C.Item`, and `some C.Item.Key` refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c))))))

(program
  (warp 1)
  (import Lib.Container)
  (procedure Use.keyOf
    (access public)
    (parameter c (type (some C Lib.Container)))
    (parameter k (type (some C.Item.Key)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
