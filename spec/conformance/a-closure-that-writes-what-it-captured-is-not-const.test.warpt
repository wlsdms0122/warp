warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-that-writes-what-it-captured-is-not-const"
  note "A name a closure captured is a box outside the closure, so writing it reaches the run's state the way writing a module variable does. The closure declares `const` and writes the captured `seen`, so it refuses at the build where it is written, called or not."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "seen"
          }
          {
            let "step"
            value {
              closure {
                body [
                  {
                    set "seen"
                    value {
                      call {
                        arguments [
                          {
                            ref "seen"
                          }
                          {
                            ref "item"
                          }
                        ]
                        procedure "Standard.Numeric.plus"
                      }
                    }
                  }
                ]
                const true
                parameters [
                  {
                    name "item"
                    type "Int"
                  }
                ]
                result {
                  ref "item"
                }
                returns "Int"
              }
            }
          }
        ]
        result {
          ref "seen"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

