warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-that-writes-what-it-captured-is-not-const"
  note "A name a closure captured is a box outside the closure, so writing it reaches the run's state the way writing a module variable does. A slot asking `const Procedure` refuses the closure at the build."
  program {
    imports [
      "Standard.Collection.map"
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "seen"
          }
          {
            let "mapped"
            value {
              call {
                arguments [
                  [
                    1
                    2
                  ]
                  {
                    closure {
                      body [
                        {
                          set "seen"
                          value {
                            call {
                              arguments [
                                {
                                  ref "seen"
                                }
                                {
                                  ref "item"
                                }
                              ]
                              procedure "Standard.Numeric.plus"
                            }
                          }
                        }
                      ]
                      parameters [
                        {
                          name "item"
                          type "Int"
                        }
                      ]
                      result {
                        ref "item"
                      }
                      returns "Int"
                    }
                  }
                ]
                procedure "Standard.Collection.map"
              }
            }
          }
        ]
        result {
          ref "seen"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

