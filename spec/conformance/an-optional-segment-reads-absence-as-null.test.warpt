warpt 1
{
  arguments {
    data {}
  }
  expect {
    answers null
  }
  name "an-optional-segment-reads-absence-as-null"
  note "`?.` and `?[` are the spellings that expect absence: an entry that is not there, or a null on the way, answers null for the whole path instead of refusing."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "data"
            type "Dictionary<String, Any>"
          }
        ]
        result {
          ref "data?[\"missing\"]"
        }
      }
    }
    warp 1
  }
  test 1
}

