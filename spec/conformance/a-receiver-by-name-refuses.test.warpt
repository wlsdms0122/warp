warpt 1
{
  expect {
    refuses "build"
  }
  name "a-receiver-by-name-refuses"
  note "`absolute` declares `of` as its receiver, so `of` is what stands in front of the dot and is written nowhere else. Writing it under `arguments`, with nothing in front, is refused at the build rather than read as the receiver."
  program {
    imports [
      "std.math.absolute"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              of -1
            }
            procedure "std.math.absolute"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

