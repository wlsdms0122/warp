warpt 1
{
  expect {
    refuses "build"
  }
  name "an-argument-refused-at-its-slot-is-not-rescued-past-a-failure-after-it"
  note "The first argument is read as `Any` and stands where `App.f` bounds `some N` by `Standard.Comparable`, which a reading of `Any` stands at only through a cast, so the build refuses before anything runs."
  program {
    imports [
      "Standard.Comparable"
      "Standard.Control.abort"
    ]
    procedures {
      "App.f" {
        bounds {
          N "Standard.Comparable"
        }
        parameters [
          {
            name "x"
            type "some N"
          }
          {
            name "y"
            type "Int"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "held"
            type "Any"
            value true
          }
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "held"
                          }
                          {
                            call {
                              arguments [
                                "second"
                              ]
                              procedure "Standard.Control.abort"
                            }
                          }
                        ]
                        procedure "App.f"
                      }
                    }
                  }
                ]
                rescue {
                  result "rescued"
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

