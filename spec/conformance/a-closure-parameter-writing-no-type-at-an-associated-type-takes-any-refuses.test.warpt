(test 1)
(name "a-closure-parameter-writing-no-type-at-an-associated-type-takes-any-refuses")
(note "The closure's parameter writes no type, so it takes `Any`, and adding to it refuses at the build though `C.Item` is Int.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.apply
      (access public)
      (parameter c (type (some C Lib.Container)))
      (parameter f (type (procedure (parameters (some C.Item)) (returns Int))))
      (returns Int)
      (body
        (let i (call Lib.Container.first c)))
      (result (apply f i)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (struct App.Plain
      (field x Int))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Lib.Container)
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item)))))))

(program
  (warp 1)
  (import App.Box)
  (import Int.plus)
  (import Lib.apply)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1))))
    (result
      (call Lib.apply b
        (closure
          (parameter x)
          (returns Int)
          (result (call Int.plus x 10)))))))
(expect (refuses build))
