warpt 1
{
  expect {
    refuses "link"
  }
  name "an-undeclared-field-refuses-at-the-link"
  note "A dot on a declared record reads a field, and a field the type does not declare is a defect the text shows. The type proved the absence, so no spelling — `?.` included — reads past it."
  program {
    needs []
    procedures {
      entry {
        parameters {
          task {
            type {
              id "string"
            }
          }
        }
        result {
          ref "task.done"
        }
      }
    }
    warp 1
  }
  test 1
}
