warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
    {
      imports [
        "Int.plus"
        "Lib.Container"
        "Lib.Container.first"
      ]
      procedures {
        "Use.plusOne" {
          access "public"
          body [
            {
              let "x"
              value {
                call {
                  arguments [
                    {
                      ref "c"
                    }
                  ]
                  procedure "Lib.Container.first"
                }
              }
            }
          ]
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "x"
                }
                1
              ]
              procedure "Int.plus"
            }
          }
          returns "Int"
          sameTypes {
            "C.Item" "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-same-type-takes-no-type-giving-another-refuses"
  note "`Use.plusOne` says `C.Item` is Int, and a box of text gives String there, so the call refuses at the build."
  program {
    imports [
      "App.Box"
      "Use.plusOne"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<String>"
            value {
              struct {
                item "x"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "Use.plusOne"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

