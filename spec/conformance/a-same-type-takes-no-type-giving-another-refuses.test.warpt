(test 1)
(name "a-same-type-takes-no-type-giving-another-refuses")
(note "`Use.plusOne` says `C.Item` is Int, and a box of text gives String there, so the call refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item)))))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Container)
    (import Lib.Container.first)
    (procedure Use.plusOne
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns Int)
      (sameType C.Item Int)
      (body
        (let x (call Lib.Container.first c))
        (return (call Int.plus x 1))))))

(program
  (warp 1)
  (import App.Box)
  (import Use.plusOne)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box String)) (struct (field item "x")))
      (return (call Use.plusOne b)))))
(expect (refuses build))
