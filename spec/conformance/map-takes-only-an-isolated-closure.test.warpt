(test 1)
(name "map-takes-only-an-isolated-closure")
(note "`Standard.Concurrent.map` asks for an isolated closure. This one writes the captured variable `tally` and does not declare `isolated`, so the build refuses it where it is handed over.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (procedure entry
    (access public)
    (returns Int)
    (failing concurrent_failed)
    (body
      (var tally 0)
      (call Standard.Concurrent.map
        (array 1 2)
        (closure
          (parameter item (type Int))
          (returns Int)
          (body
            (set tally item)
            (return item))))
      (return tally))))
(expect (refuses build))
