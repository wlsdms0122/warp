warpt 1
{
  expect {
    refuses "build"
  }
  name "a-bare-name-for-another-modules-word-refuses"
  note "`plus` is not the spelling of any declaration in the link: `std.math` declares `std.math.plus`, and this document declares no `plus` of its own. A name is looked up as written, so the send refuses at the build, and the list saying `plus` names no module a caller could hand this program."
  program {
    imports [
      "plus"
    ]
    procedures {
      entry {
        result {
          call {
            arguments {
              value 2
            }
            of 1
            procedure "plus"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}
