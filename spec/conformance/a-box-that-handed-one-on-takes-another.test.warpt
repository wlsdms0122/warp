warpt 1
{
  expect {
    answers "done"
  }
  name "a-box-that-handed-one-on-takes-another"
  note "A box whose value written `linear` was handed on holds nothing owed, so writing a new one into it writes over nothing. The box then holds the new one, and the body hands it on."
  program {
    imports [
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              call {
                procedure "App.open"
              }
            }
            var "handle"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
          {
            set "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        result "done"
        returns "String"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

