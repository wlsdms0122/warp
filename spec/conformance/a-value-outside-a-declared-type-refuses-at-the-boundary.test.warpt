warpt 1
{
  arguments {
    task Task {
      id "a"
    }
  }
  expect {
    refuses "run"
  }
  name "a-value-outside-a-declared-type-refuses-at-the-boundary"
  note "Arguments are judged against the declaration before the body sees them, and a record missing a declared field does not fit the type."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "task"
            type "Task"
          }
        ]
        result {
          ref "task.done"
        }
      }
    }
    types {
      Task {
        record {
          done "Bool"
          id "String"
        }
      }
    }
    warp 1
  }
  test 1
}

