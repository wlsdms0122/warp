warpt 1
{
  arguments {
    task {
      id "a"
    }
  }
  expect {
    refuses "run"
  }
  name "a-value-outside-a-declared-type-refuses-at-the-boundary"
  note "Arguments are settled against the declaration before the body sees them, and a record missing a declared field does not fit the type."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          task {
            type "Task"
          }
        }
        result {
          ref "task.done"
        }
      }
    }
    types {
      Task {
        done "bool"
        id "string"
      }
    }
    warp 1
  }
  test 1
}

