warpt 1
{
  expect {
    refuses "build"
  }
  name "an-element-of-a-constant-record-field-reads-as-its-element-type-refuses"
  note "A field keeps its own type, `Array<Any>` here, and an element of it reads that list's element type, so `k.a[1]` reads `Any` though it settles to `\"s\"`. A name declaring `String` refuses it at the build."
  program {
    const {
      k {
        record {
          a [
            1
            "s"
          ]
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "x"
            type "String"
            value {
              ref "k.a[1]"
            }
          }
        ]
        result {
          ref "x"
        }
      }
    }
    warp 1
  }
  test 1
}

