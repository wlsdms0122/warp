warpt 1
{
  expect {
    refuses "build"
  }
  name "records-of-two-layouts-holding-one-value-read-as-a-dictionary-at-a-bounded-parameter-refuses"
  note "`App.f` bounds `T` by `App.Nums`, which admits `Int` and `Double`, and takes `Dictionary<{ x: some T }>`. The record handed there holds two records whose fields differ and whose `x` is the same text, so `T` is read as text. No member takes text, so the call refuses at the build."
  program {
    constraints {
      "App.Nums" [
        "Int"
        "Double"
      ]
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.Nums"
        }
        parameters [
          {
            name "d"
            type {
              dictionary {
                record {
                  x "some T"
                }
              }
            }
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              record {
                a {
                  record {
                    x "s"
                  }
                }
                b {
                  record {
                    x "s"
                    y 2
                  }
                }
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

