warpt 1
{
  expect {
    answers [
      1.5
      2.5
    ]
  }
  name "a-call-filling-a-parameter-from-a-variable-held-in-place-takes-a-value-of-that-parameter"
  note "App.gen takes a list of its own some T in place and a some T, and appends the one to the other through Standard.Collection.append. Both are T, so the call takes them, and the list answers with the value added."
  program {
    constraints {
      "App.Real" [
        "Double"
      ]
    }
    imports [
      "Standard.Collection.append"
    ]
    procedures {
      "App.gen" {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  {
                    ref "y"
                  }
                ]
                procedure "Standard.Collection.append"
              }
            }
          }
        ]
        bounds {
          T "App.Real"
        }
        parameters [
          {
            name "xs"
            type "inout Array<some T>"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value [
              1.5
            ]
            var "ns"
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "ns"
                  }
                  2.5
                ]
                procedure "App.gen"
              }
            }
          }
        ]
        result {
          ref "ns"
        }
      }
    }
    warp 1
  }
  test 1
}

