(test 1)
(name "an-attempt-without-a-rescue-refuses")
(note "An attempt's `rescue` is required. One written without it refuses at the load.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (body
      (attempt
        (body
          (call Standard.Control.abort "x"))))
    (result 1)))
(expect (refuses load))
