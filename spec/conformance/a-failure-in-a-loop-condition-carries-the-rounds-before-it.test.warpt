(test 1)
(name "a-failure-in-a-loop-condition-carries-the-rounds-before-it")
(note "The first round's condition reads `n` as a bool and its body sets `n` to a string; the next condition's cast fails. The condition runs after every round before it, so the rescue reads `n` as what any of those rounds may have left, and asking whether it is a bool stands rather than being a cast the reading already decides.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var n true)
      (attempt
        (body
          (loop
            (while (as n Bool))
            (body
              (set n "s")))
          (return 0))
        (rescue
          (let s (as? n Bool)))))
    (result 1)))
(expect (answers 1))
