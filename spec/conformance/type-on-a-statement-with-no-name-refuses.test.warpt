(test 1)
(name "type-on-a-statement-with-no-name-refuses")
(note "`type` says what a name holds, and a statement with no naming key introduces none. Writing `type` there refuses at the load.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "type" "Int") (entry "value" 1)))) (entry "result" 1) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
