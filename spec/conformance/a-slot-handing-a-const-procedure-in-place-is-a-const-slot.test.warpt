warpt 1
{
  expect {
    answers 2
  }
  name "a-slot-handing-a-const-procedure-in-place-is-a-const-slot"
  note "A parameter typed `inout const Procedure` holds the caller's box, held to that type through every write, so it says what the value it holds answers. A body calling it answers without running, and an operand may call it."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      asking {
        body [
          {
            let "a"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "p"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "p"
            type {
              "inout const procedure" {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            type {
              "const procedure" {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "Int"
                  }
                ]
                result {
                  ref "x"
                }
                returns "Int"
              }
            }
            var "held"
          }
        ]
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      ref "held"
                    }
                  ]
                  procedure "asking"
                }
              }
              1
            ]
            procedure "Standard.Numeric.plus"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

