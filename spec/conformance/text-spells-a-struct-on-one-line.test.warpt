warpt 1
{
  expect {
    answers [
      "{\"a\":\"x\",\"b\":1}"
      "Point {\"x\":1}"
      "{}"
    ]
  }
  name "text-spells-a-struct-on-one-line"
  note "text spells a container on one line: a map's entries between braces as the key in its own spelling, text quoted, a colon and the value; a named struct the same with its name and a space in front; an empty one as its two braces."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "plain"
            value {
              call {
                arguments [
                  {
                    dictionary [
                      [
                        "a"
                        "x"
                      ]
                      [
                        "b"
                        1
                      ]
                    ]
                  }
                ]
                procedure "Standard.Text.text"
              }
            }
          }
          {
            let "named"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        struct {
                          x 1
                        }
                      }
                      type "Point"
                    }
                  }
                ]
                procedure "Standard.Text.text"
              }
            }
          }
          {
            let "empty"
            value {
              call {
                arguments [
                  {
                    dictionary []
                  }
                ]
                procedure "Standard.Text.text"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result [
          {
            ref "plain"
          }
          {
            ref "named"
          }
          {
            ref "empty"
          }
        ]
        returns "Array<String>"
      }
    }
    types {
      Point {
        struct {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

