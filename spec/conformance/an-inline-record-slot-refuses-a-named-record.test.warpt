warpt 1
{
  expect {
    refuses "build"
  }
  name "an-inline-record-slot-refuses-a-named-record"
  note "An inline record declares no name, and a declared record is a value of its own name and of nothing else. Handing an `Account` where `{ balance: Int }` is declared would take the name off, which no place does, so the call refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "Account"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
            ]
            procedure "pass"
          }
        }
        returns "Any"
      }
      pass {
        parameters [
          {
            name "record"
            type {
              record {
                balance "Int"
              }
            }
          }
        ]
        result {
          ref "record"
        }
        returns "Any"
      }
    }
    types {
      Account {
        record {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

