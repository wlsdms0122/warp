(test 1)
(name "an-empty-list-fills-the-base-with-never-and-the-associated-type-takes-nothing-refuses")
(note "An empty list fills C with Never, which holds no value, so `C.Item` is Never too, and handing text there refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Lib.Bag)
    (procedure Use.count
      (access public)
      (parameter cs (type (array (some C Lib.Bag))))
      (parameter x (type (some C.Item)))
      (returns Int)
      (body
        (return 0)))))

(program
  (warp 1)
  (import Use.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call Use.count (array) "s")))))
(expect (refuses build))
