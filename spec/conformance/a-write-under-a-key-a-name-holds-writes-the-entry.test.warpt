(test 1)
(name "a-write-under-a-key-a-name-holds-writes-the-entry")
(note "The brackets on a dictionary read what stands between them as a key, in a write as in a read, so a set through d[k] with k holding a string writes that entry.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (body
      (var d (type (dictionary String Int)) (dictionary (entry "a" 0)))
      (let k (type String) "a")
      (set (path d (index k)) 5)
      (return d))))
(expect (answers (dictionary (entry "a" 5))))
