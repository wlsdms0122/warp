(test 1)
(name "a-cast-to-a-procedure-type-returning-an-alias-of-what-it-returns-refuses")
(note "`App.I` names `Int`. `f` is read as `() -> Int`, and the cast names `() -> App.I`: the same procedure type, its return type spelled another way. The cast names what the reading already is, so it refuses at the build.")

(program
  (warp 1)
  (type App.I Int)
  (procedure entry
    (access public)
    (returns (procedure (parameters) (returns Int)))
    (failing cast_refused)
    (body
      (let f
        (type (procedure (parameters) (returns Int)))
        (closure
          (returns Int)
          (body
            (return 1))))
      (let g (as f (procedure (parameters) (returns App.I))))
      (return g))))
(expect (refuses build))
