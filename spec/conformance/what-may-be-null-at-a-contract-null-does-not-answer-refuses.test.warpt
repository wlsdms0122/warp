(test 1)
(name "what-may-be-null-at-a-contract-null-does-not-answer-refuses")
(note "App.f takes App.Sized and is handed a variable declared Bank.Card?. A reading that may be null answers where both the type and `Null` do. Bank.Card answers App.Sized, and no document claims it for `Null`.")

(program
  (warp 1)
  (struct Bank.Box
    (field n Int))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (body
        (return 4))))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure App.f
    (parameter n (type App.Sized))
    (returns String)
    (body
      (return "took")))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (type (nullable Bank.Card)) (as (struct (field last "4")) Bank.Card))
      (let s (call App.f c))
      (return s))))
(expect (refuses build))
