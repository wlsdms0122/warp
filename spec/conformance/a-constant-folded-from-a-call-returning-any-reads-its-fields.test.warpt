(test 1)
(name "a-constant-folded-from-a-call-returning-any-reads-its-fields")
(note "`K.make` declares it returns `Any`, and the constant folded from it is a `K.P` with `x`. The constant's folded value is its type, so a dot reads `x` without `as` and the program builds.")

(documents
  (document
    (warp 1)
    (struct K.P
      (field x Int))
    (procedure K.make
      (const)
      (isolated)
      (returns Any)
      (body
        (let p (type K.P) (struct (field x 1)))
        (return p)))))

(program
  (warp 1)
  (import K.make)
  (const made (call K.make))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (return (path made (field x))))))
(expect (answers 1))
