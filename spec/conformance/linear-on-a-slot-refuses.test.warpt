warpt 1
{
  expect {
    refuses "build"
  }
  name "linear-on-a-slot-refuses"
  note "`linear` is written on a type in `types` and nowhere else: what follows a value is the name holding it, and a slot carries the type's mark by naming the type. Writing it on a slot is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type {
              linear "String"
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

