warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-to-a-procedure-type-answering-an-alias-of-what-it-answers-refuses"
  note "`App.I` names `Int`. `f` is read as `{ procedure: { returns: Int } }`, and the cast names `{ procedure: { returns: App.I } }`: the same procedure type, its answer spelled another way. The cast names what the reading already is, so it refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            type {
              procedure {
                returns "Int"
              }
            }
            value {
              closure {
                result 1
              }
            }
          }
          {
            let "g"
            value {
              as {
                of {
                  ref "f"
                }
                type {
                  procedure {
                    returns "App.I"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "g"
        }
      }
    }
    types {
      "App.I" "Int"
    }
    warp 1
  }
  test 1
}

