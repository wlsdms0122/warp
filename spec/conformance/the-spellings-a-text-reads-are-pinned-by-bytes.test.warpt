(test 1)
(name "the-spellings-a-text-reads-are-pinned-by-bytes")
(note "A text case is read by one reader on both sides, so a reader taking a spelling for the wrong value would agree with itself. Every scalar and every name a text case reads appears in some bytes case, and this one holds the spellings no other bytes case does: the two forms of a fraction, the escapes, a name that has to be in backticks, a struct's name and field, the keys a document's and a case's nodes write, and the names and texts the cases of the writer's layout read.")
(bytes x"")
(expect (spells (array 1e+16 1e-05 0.0001 1000000000000000.0 -0.5 1.0 "\"\\\n\r\t\u0001" (dictionary (entry "a" 1) (entry "b c" 2)) (struct Bank.Account (field balance 1)) (array "access" "answers" "const" "dictionary" "entry" "expect" "imports" "Int" "procedures" "public" "ref" "result" "returns" "test" "warp") (array 0 "() -> Int" "App.g" "Bool" "Lib.one" "a-call-into-a-document-beside" "arguments" "body" "call" "closure" "conditional" "documents" "else" "f" "n" "name" "note" "parameters" "procedure" "program" "set" "then" "type" "value" "var" "when" "…"))))
