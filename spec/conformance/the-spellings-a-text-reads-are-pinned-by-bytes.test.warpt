(test 1)
(name "the-spellings-a-text-reads-are-pinned-by-bytes")
(note "A text case is read by one reader on both sides, so a reader taking a spelling for the wrong value would agree with itself. Every scalar and every name a text case reads appears in some bytes case, and this one holds the spellings no other bytes case does: the two forms of a floating-point number, the escapes, a name that has to be in backticks, a struct's name and field, the keys a document's and a case's nodes write, the names and strings the cases of the writer's layout read, and those an interface's case reads.")
(bytes x"")
(expect (spells (array 1e+16 1e-05 0.0001 1000000000000000.0 -0.5 1.0 "\"\\\n\r\t\u0001" (dictionary (entry "a" 1) (entry "b c" 2)) (struct Bank.Account (field balance 1)) (array "access" "answers" "const" "dictionary" "entry" "expect" "imports" "Int" "procedures" "public" "ref" "return" "returns" "test" "warp") (array 0 "() -> Int" "App.g" "Bool" "Int?" "Lib.one" "a-call-into-a-document-beside" "arguments" "body" "call" "closure" "conditional" "documents" "else" "f" "let" "n" "name" "note" "o" "of" "parameters" "procedure" "program" "set" "then" "type" "unwrap" "value" "var" "when" "x" "…") (array "App.Named" "App.Range" "App.largest" "Array<some T: Standard.Comparable>" "Self" "Standard.Comparable" "String" "contracts" "extensions" "high" "interface" "low" "satisfies" "some T?" "struct" "types") "a`b\"c" "a b" 5e-324)))
