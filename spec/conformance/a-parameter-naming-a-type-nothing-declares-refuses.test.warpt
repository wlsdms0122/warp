(test 1)
(name "a-parameter-naming-a-type-nothing-declares-refuses")
(note "A spelling no module in the link declares refuses where it is mentioned, a signature's parameter included.")

(program
  (warp 1)
  (import App.Missing)
  (procedure entry
    (access public)
    (parameter x (type App.Missing))
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
