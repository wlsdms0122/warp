warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-handed-in-place-holding-lists-of-a-parameter-refuses-an-attempt-whose-rescue-answers-a-member-value"
  note "A parameter handed in place as `array<array<some T>>`, with `T` bounded by `std.Numeric`, is set to an attempt whose body answers `[[], [x]]` and whose rescue `[[5]]`. Each way is judged on its own, and `5` is a value every member of the bounds takes rather than one of the parameter, so the rescue refuses at the build."
  program {
    imports [
      "std.Numeric"
      "std.control.abort"
    ]
    procedures {
      "app.g" {
        body [
          {
            set "xs"
            value {
              attempt {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              call {
                                arguments [
                                  "x"
                                ]
                                procedure "std.control.abort"
                              }
                            }
                          }
                        ]
                        when false
                      }
                    }
                  }
                ]
                rescue {
                  result [
                    [
                      5
                    ]
                  ]
                }
                result [
                  []
                  [
                    {
                      ref "x"
                    }
                  ]
                ]
              }
            }
          }
        ]
        bounds {
          T "std.Numeric"
        }
        parameters [
          {
            name "xs"
            type "inout array<array<some T>>"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value {
              as {
                of []
                type "array<array<int(0...3)>>"
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  1
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

