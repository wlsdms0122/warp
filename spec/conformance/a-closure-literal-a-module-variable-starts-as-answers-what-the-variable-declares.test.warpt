warpt 1
{
  expect {
    answers "1.0"
  }
  name "a-closure-literal-a-module-variable-starts-as-answers-what-the-variable-declares"
  note "The module variable `cv` declares `{ procedure: { returns: Double } }` and starts as a closure literal that writes no `returns`, so the closure answers what the variable declares: its literal 1 is the fraction 1.0. `App.run` takes `{ procedure: { returns: some T } }`, so `T` is `Double`."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "cv"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
      }
    }
    var {
      cv {
        type {
          procedure {
            returns "Double"
          }
        }
        value {
          closure {
            result 1
          }
        }
      }
    }
    warp 1
  }
  test 1
}

