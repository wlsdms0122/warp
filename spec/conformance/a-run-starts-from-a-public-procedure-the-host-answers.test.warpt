(test 1)
(name "a-run-starts-from-a-public-procedure-the-host-answers")
(note "A run starts from any `public` declaration the host names, one the host answers included. Here `entry` is the host's, and the run answers what the host answers.")

(vocabulary
  (procedure entry
    (access public)
    (isolated)
    (returns Int)
    (answers 5)))

(program
  (warp 1)
  (procedure other
    (returns Int)
    (result 1)))
(expect (answers 5))
