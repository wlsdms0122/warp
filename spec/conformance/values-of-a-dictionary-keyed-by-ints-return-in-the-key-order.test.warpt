(test 1)
(name "values-of-a-dictionary-keyed-by-ints-return-in-the-key-order")
(note "values walks a dictionary in its key order whatever its keys are: under integers, ascending by worth.")

(program
  (warp 1)
  (import Standard.Collection.values)
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (return (call Standard.Collection.values (dictionary (entry 2 "b") (entry 10 "c") (entry 1 "a")))))))
(expect (answers (array "a" "b" "c")))
