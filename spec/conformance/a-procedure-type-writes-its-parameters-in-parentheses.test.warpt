warpt 1
{
  expect {
    refuses "load"
  }
  name "a-procedure-type-writes-its-parameters-in-parentheses"
  note "A procedure type writes the types it is called with in parentheses before `->`, `(Int) -> Int`, so `Int -> Int` refuses at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "f"
            type "Int -> Int"
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "Int"
                  }
                ]
                result {
                  ref "x"
                }
                returns "Int"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

