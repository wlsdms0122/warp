warpt 1
{
  expect {
    refuses "build"
  }
  name "a-fixed-name-is-not-handed-in-place"
  note "What is handed in place is a variable. A name fixed with `id` refuses at the build."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments {
                  value 1
                }
                of {
                  ref "count"
                }
                procedure "std.math.plus"
              }
            }
          }
        ]
        parameters {
          count {
            type "inout int"
          }
        }
      }
      entry {
        body [
          {
            let "n"
            value 10
          }
          {
            value {
              call {
                arguments {
                  count {
                    ref "n"
                  }
                }
                procedure "bump"
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

