warpt 1
{
  expect {
    refuses "build"
  }
  name "a-fixed-name-is-not-handed-in-place"
  note "What is handed in place is a variable. A name fixed with `let` refuses at the build."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      bump {
        body [
          {
            set "count"
            value {
              call {
                arguments [
                  {
                    ref "count"
                  }
                  1
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        parameters [
          {
            name "count"
            type "inout Int"
          }
        ]
      }
      entry {
        access "public"
        body [
          {
            let "n"
            value 10
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure "bump"
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

