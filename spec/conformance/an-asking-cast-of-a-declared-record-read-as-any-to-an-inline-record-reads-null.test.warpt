warpt 1
{
  expect {
    answers null
  }
  name "an-asking-cast-of-a-declared-record-read-as-any-to-an-inline-record-reads-null"
  note "`a` is an `App.Point`, and `App.hide` hands it back read as `Any`. A cast writes a name and never takes one off, so the value is no `{ x: Int }`, and `as?` reads null."
  program {
    imports []
    procedures {
      "App.hide" {
        parameters [
          {
            name "it"
            type "Any"
          }
        ]
        result {
          ref "it"
        }
        returns "Any"
      }
      entry {
        access "public"
        body [
          {
            let "a"
            type "App.Point"
            value {
              record {
                x 1
              }
            }
          }
        ]
        result {
          "as?" {
            of {
              call {
                arguments [
                  {
                    ref "a"
                  }
                ]
                procedure "App.hide"
              }
            }
            type {
              record {
                x "Int"
              }
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

