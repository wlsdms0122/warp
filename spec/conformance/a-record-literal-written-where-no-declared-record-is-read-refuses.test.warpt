warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-literal-written-where-no-declared-record-is-read-refuses"
  note "A record literal is read as the declared record of the place it is written into. `entry` answers `Any`, which declares no record, so the literal has no record to be and refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          record {
            a 1
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

