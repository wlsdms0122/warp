(test 1)
(name "the-object-of-a-local")
(note "A name lowers to the slot the build gave it, read through an address with no steps, and the frame says the parameter fills that slot and what it was called.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter n (type Int))
    (returns Int)
    (result n)))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"5943143b9ce0dcb0cf647989700cf5993bd567744da04d5c80988080daa36617")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0))) (entry "rows" (array (array "entry" (array (array (array "n" (array 0) (array))) 1 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array 0)) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4))) (entry "types" (array)) (entry "valueTable" (array)) (entry "variables" (array)))))
