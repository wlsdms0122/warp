(test 1)
(name "a-declaration-answering-a-contract-may-answer-an-alias-of-a-struct-answering-it")
(note "The contract answers App.Describable and the declaration answering it answers Bank.Alias, which names Bank.Card, and a document says Bank.Card answers App.Describable.")

(program
  (warp 1)
  (type Bank.Alias Bank.Card)
  (struct Bank.Card
    (satisfies App.Describable App.Pick)
    (field last String)
    (procedure describe
      (parameter of (type Bank.Card))
      (returns String)
      (result "a card"))
    (procedure pick
      (parameter of (type Bank.Card))
      (returns Bank.Alias)
      (result of)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (contract App.Pick
    (procedure pick
      (parameter of (type Self))
      (returns App.Describable)))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "42")) Bank.Card))
      (let p (call App.Pick.pick c))
      (let s (call App.Describable.describe p)))
    (result s)))
(expect (answers "a card"))
