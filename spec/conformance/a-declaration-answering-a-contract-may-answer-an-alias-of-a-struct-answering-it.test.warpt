warpt 1
{
  expect {
    answers "a card"
  }
  name "a-declaration-answering-a-contract-may-answer-an-alias-of-a-struct-answering-it"
  note "The contract answers App.Describable and the declaration answering it answers Bank.Alias, which names Bank.Card, and a document says Bank.Card answers App.Describable."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
      "App.Pick" {
        pick {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "App.Describable"
        }
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "p"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Pick.pick"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "p"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "Bank.Alias" "Bank.Card"
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
          pick {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result {
              ref "of"
            }
            returns "Bank.Alias"
          }
        }
        satisfies [
          "App.Describable"
          "App.Pick"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

