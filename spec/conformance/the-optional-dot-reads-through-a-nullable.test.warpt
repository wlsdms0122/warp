(test 1)
(name "the-optional-dot-reads-through-a-nullable")
(note "`?.` unwraps a nullable: a value that arrived reads its field, and a null the host handed would answer null for the whole path. The path's own answer is nullable for the same reason.")

(program
  (warp 1)
  (struct Task
    (field name String))
  (procedure entry
    (access public)
    (parameter task (type (nullable Task)))
    (returns (nullable String))
    (body
      (return (path task (field? name))))))
(arguments (argument task (struct Task (field name "loaded"))))
(expect (answers "loaded"))
