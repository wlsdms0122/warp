warpt 1
{
  arguments {
    task {
      name "loaded"
    }
  }
  expect {
    answers "loaded"
  }
  name "the-optional-dot-reads-through-a-nullable"
  note "`?.` unwraps a nullable: a value that arrived reads its field, and the null the caller left would answer null for the whole path. The path's own answer is nullable for the same reason."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters {
          task {
            default null
            type "Task?"
          }
        }
        result {
          ref "task?.name"
        }
        returns "string?"
      }
    }
    types {
      Task {
        name "string"
      }
    }
    warp 1
  }
  test 1
}

