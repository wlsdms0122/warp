(test 1)
(name "a-body-introduces-its-parameter-once")
(note "A procedure's parameters are names its own body introduced before its first statement, and a body introduces a name once, so a `let` of a parameter's spelling at the body's own level refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type Int))
    (returns Int)
    (body
      (let x 2))
    (result x))
  (procedure entry
    (access public)
    (returns Int)
    (result (call App.f 1))))
(expect (refuses load))
