warpt 1
{
  arguments {
    p {
      a "s"
      b 5
    }
  }
  expect {
    refuses "run"
  }
  name "an-entry-handed-a-record-of-two-types-at-a-bounded-type-parameter-refuses-at-the-door"
  note "`p` is a record type whose fields are both `some T`, bounded by `App.C`, and the host hands `{ a: \"s\", b: 5 }`. Fitted to the record type, its fields read `T` as `String` and as `Int`, so the run refuses at the door before the call through `App.C` picks the `String` row by `p.a` and hands it `5`."
  program {
    contracts {
      "App.C" {
        f {
          parameters [
            {
              name "s"
              type "Self"
            }
            {
              name "o"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Int.f" {
        parameters [
          {
            name "s"
            type "Int"
          }
          {
            name "o"
            type "Int"
          }
        ]
        result "i"
        returns "String"
      }
      "String.f" {
        parameters [
          {
            name "s"
            type "String"
          }
          {
            name "o"
            type "String"
          }
        ]
        result {
          ref "o"
        }
        returns "String"
      }
      entry {
        access "public"
        bounds {
          T "App.C"
        }
        parameters [
          {
            name "p"
            type {
              record {
                a "some T"
                b "some T"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "p.a"
              }
              {
                ref "p.b"
              }
            ]
            procedure "App.C.f"
          }
        }
        returns "String"
      }
    }
    satisfies {
      Int [
        "App.C"
      ]
      String [
        "App.C"
      ]
    }
    warp 1
  }
  test 1
}

