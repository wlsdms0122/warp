warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-a-contract-where-it-answers-another-refuses"
  note "The contract answers App.Named and the declaration answering it answers App.Sized. A type answering App.Sized need not answer App.Named, so the answer could be one the contract's answer does not take."
  program {
    contracts {
      "App.Named" {
        name {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
      "App.Shown" {
        show {
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "n"
              type "App.Sized"
            }
          ]
          returns "App.Named"
        }
      }
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Box.show" {
        parameters [
          {
            name "of"
            type "Bank.Box"
          }
          {
            name "n"
            type "App.Sized"
          }
        ]
        result {
          ref "n"
        }
        returns "App.Sized"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "b"
            value {
              as {
                of {
                  struct {
                    n 1
                  }
                }
                type "Bank.Box"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.Shown.show"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Box" [
        "App.Shown"
      ]
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        struct {
          n "Int"
        }
      }
      "Bank.Card" {
        struct {
          last "String"
        }
      }
      "Bank.Coin" {
        struct {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

