(test 1)
(name "a-declaration-answering-a-contract-with-a-contract-where-it-answers-another-refuses")
(note "The contract answers App.Named and the declaration answering it answers App.Sized. A type answering App.Sized need not answer App.Named, so the answer could be one the contract's answer does not take.")

(program
  (warp 1)
  (struct Bank.Box
    (satisfies App.Shown)
    (field n Int)
    (procedure show
      (parameter of (type Bank.Box))
      (parameter n (type App.Sized))
      (returns App.Sized)
      (result n)))
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (returns Int)
      (result 4)))
  (struct Bank.Coin
    (field cents Int))
  (contract App.Named
    (procedure name
      (parameter of (type Self))
      (returns String)))
  (contract App.Shown
    (procedure show
      (parameter of (type Self))
      (parameter n (type App.Sized))
      (returns App.Named)))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure entry
    (access public)
    (returns App.Named)
    (failing cast_refused)
    (body
      (let b (as (struct (field n 1)) Bank.Box))
      (let c (as (struct (field last "4")) Bank.Card))
      (let s (call App.Shown.show b c)))
    (result s)))
(expect (refuses build))
