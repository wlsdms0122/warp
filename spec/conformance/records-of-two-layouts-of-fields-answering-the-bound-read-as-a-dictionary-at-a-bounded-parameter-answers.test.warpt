warpt 1
{
  expect {
    answers 0
  }
  name "records-of-two-layouts-of-fields-answering-the-bound-read-as-a-dictionary-at-a-bounded-parameter-answers"
  note "`App.f` bounds `T` by `App.Nums`, which `Int` and `Double` answer, and takes `Dictionary<{ x: some T }>`. The record handed there holds two records whose fields differ, and their `x` fields read `T` as `Int` and as `Double`. Each is held to the bounds and each answers them, so the call answers."
  program {
    contracts {
      "App.Nums" {}
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.Nums"
        }
        parameters [
          {
            name "d"
            type {
              dictionary {
                record {
                  x "some T"
                }
              }
            }
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            value {
              record {
                a {
                  record {
                    x 1
                  }
                }
                b {
                  record {
                    x 2.5
                    y 2
                  }
                }
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      Double [
        "App.Nums"
      ]
      Int [
        "App.Nums"
      ]
    }
    warp 1
  }
  test 1
}

