warpt 1
{
  expect {
    answers true
  }
  name "contains-asks-a-collection"
  note "contains answers whether an array holds an element, by the language's one sameness."
  program {
    imports [
      "std.collection.contains"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                arguments {
                  value 2
                }
                of [
                  1
                  2
                  3
                ]
                procedure "std.collection.contains"
              }
            }
          }
        ]
        result {
          ref "held"
        }
      }
    }
    warp 1
  }
  test 1
}

