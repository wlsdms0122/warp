warpt 1
{
  expect {
    answers true
  }
  name "contains-asks-a-collection"
  note "contains answers whether an array holds an element, by the language's one sameness."
  program {
    imports [
      "Standard.Collection.contains"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              call {
                arguments [
                  [
                    1
                    2
                    3
                  ]
                  2
                ]
                procedure "Standard.Collection.contains"
              }
            }
          }
        ]
        result {
          ref "held"
        }
      }
    }
    warp 1
  }
  test 1
}

