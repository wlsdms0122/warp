warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-reading-a-bounded-parameter-beside-any-refuses"
  note "`App.C` asks `m` taking text and `Any` after the type. `Bank.X.m` answers it with two of `some T`, bounded by `App.Nums`, which `Int` and `Double` answer. Held to the contract, `T` is read as `String` and as `Any`, which join to `Any`; each reading is held to the bounds as it was read, text answers no bound, and the call leaning on the claim refuses at the build."
  program {
    contracts {
      "App.C" {
        m {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
            {
              name "a"
              type "String"
            }
            {
              name "b"
              type "Any"
            }
          ]
          returns "Int"
        }
      }
      "App.Nums" {}
    }
    imports []
    procedures {
      "Bank.X.m" {
        bounds {
          T "App.Nums"
        }
        parameters [
          {
            name "of"
            type "Bank.X"
          }
          {
            name "a"
            type "some T"
          }
          {
            name "b"
            type "some T"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "x"
            type "Bank.X"
            value {
              record {
                k "a"
              }
            }
          }
          {
            let "s"
            type "String"
            value "s"
          }
          {
            let "u"
            type "Any"
            value 1
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
              {
                ref "s"
              }
              {
                ref "u"
              }
            ]
            procedure "App.C.m"
          }
        }
      }
    }
    satisfies {
      "Bank.X" [
        "App.C"
      ]
      Double [
        "App.Nums"
      ]
      Int [
        "App.Nums"
      ]
    }
    types {
      "Bank.X" {
        record {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

