warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-no-name-holds-handed-to-a-borrowing-slot-refuses"
  note "A slot that borrows leaves the obligation with the caller, and a value written straight into the call has no name holding it, so nothing would owe it after the call. The build refuses it, and the value is bound to a name first."
  program {
    imports [
      "App.name"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      name "f"
                    }
                  }
                ]
                procedure "App.name"
              }
            }
          }
        ]
        result {
          ref "r"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.name" {
        answers "f"
        parameters [
          {
            name "first"
            type "borrowing App.Handle"
          }
        ]
        returns "String"
      }
    }
    types {
      "App.H2" "App.Handle"
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

