warpt 1
{
  arguments {
    payload {
      name "warp"
    }
  }
  expect {
    answers "warp"
  }
  name "a-cast-opens-what-any-declares-nothing-about"
  note "A cast names the type a value is read as, and from there the reading is that type, so the dot the build refused on `any` is judged, and the run is left only the question of what arrived."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "read"
            value {
              as {
                of {
                  ref "payload"
                }
                type {
                  record {
                    name "string"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "payload"
            type "any"
          }
        ]
        result {
          ref "read.name"
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

