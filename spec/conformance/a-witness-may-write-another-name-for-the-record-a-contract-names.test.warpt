warpt 1
{
  expect {
    answers 5
  }
  name "a-witness-may-write-another-name-for-the-record-a-contract-names"
  note "The contract's procedure takes an `App.Point` second, and the declaration answering it for `App.Box` writes `App.Spot`, which names `App.Point`. A name that stands for a declared record names that record's type, so the two signatures agree and the claim holds."
  program {
    contracts {
      "App.Placing" {
        place {
          parameters [
            {
              name "of"
              type "App.Placing"
            }
            {
              name "at"
              type "App.Point"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "App.Box.place" {
        parameters [
          {
            name "of"
            type "App.Box"
          }
          {
            name "at"
            type "App.Spot"
          }
        ]
        result {
          ref "at.x"
        }
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "box"
            value {
              as {
                of {
                  record {
                    v 1
                  }
                }
                type "App.Box"
              }
            }
          }
          {
            let "point"
            value {
              as {
                of {
                  record {
                    x 5
                  }
                }
                type "App.Point"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "box"
              }
              {
                ref "point"
              }
            ]
            procedure "App.Placing.place"
          }
        }
        returns "int"
      }
    }
    satisfies {
      "App.Box" [
        "App.Placing"
      ]
    }
    types {
      "App.Box" {
        record {
          v "int"
        }
      }
      "App.Point" {
        record {
          x "int"
        }
      }
      "App.Spot" "App.Point"
    }
    warp 1
  }
  test 1
}

