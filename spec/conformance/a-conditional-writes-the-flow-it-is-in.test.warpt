warpt 1
{
  arguments {
    take true
  }
  expect {
    answers "took-then"
  }
  name "a-conditional-writes-the-flow-it-is-in"
  note "A conditional answers nothing. The condition chooses a way through the body, and what an arm keeps it writes to an outer variable."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            var "chosen"
          }
          {
            value {
              conditional {
                else [
                  {
                    set "chosen"
                    value "took-else"
                  }
                ]
                then [
                  {
                    set "chosen"
                    value "took-then"
                  }
                ]
                when {
                  ref "take"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "take"
            type "Bool"
          }
        ]
        result {
          ref "chosen"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

