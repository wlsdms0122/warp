warpt 1
{
  expect {
    answers 20
  }
  name "a-path-reads-through-what-a-name-holds"
  note "A path walks fields and elements of what its head resolves to."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "data"
            value {
              list [
                10
                20
              ]
            }
          }
        ]
        result {
          ref "data.list[1]"
        }
      }
    }
    warp 1
  }
  test 2
}

