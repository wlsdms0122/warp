warpt 1
{
  expect {
    answers 6
  }
  name "a-vocabulary-imports-the-contract-a-bound-names-answers"
  note "A vocabulary is a module and lists what it uses under `imports`, as any module does, so a procedure the host brings may bound a type parameter by `Standard.Numeric`. The program sends `App.h` a whole number, which answers the bound, and the host answers 6."
  program {
    imports [
      "App.h"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              5
            ]
            procedure "App.h"
          }
        }
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    imports [
      "Standard.Numeric"
    ]
    procedures {
      "App.h" {
        answers 6
        bounds {
          T "Standard.Numeric"
        }
        parameters [
          {
            name "first"
            type "some T"
          }
        ]
        returns "some T"
      }
    }
  }
}

