(test 1)
(name "a-set-of-a-failures-name-refuses")
(note "An attempt's failure is a fixed name inside the rescue, whatever its spelling names outside. `caught` is a variable of the document, and inside the rescue it is the failure, so a `set` of it refuses at the load.")

(program
  (warp 1)
  (var caught 0)
  (procedure entry
    (access public)
    (parameter payload)
    (returns Int)
    (body
      (let caught
        (attempt
          (body
            (let n (as payload Int)))
          (result 1)
          (rescue
            (body
              (set caught 1))
            (result 2)))))
    (result caught)))
(expect (refuses load))
