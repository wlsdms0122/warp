warpt 1
{
  expect {
    refuses "load"
  }
  name "a-walk-name-is-not-readable-after-the-walk"
  note "A walk answers nothing, so its name is the element's alone — a later read could only ever see null, and is refused instead."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "walk"
            value {
              each {
                body [
                  {
                    let "noop"
                    value 1
                  }
                ]
                in [
                  1
                ]
              }
            }
          }
          {
            let "after"
            value {
              ref "walk"
            }
          }
        ]
        result {
          ref "after"
        }
      }
    }
    warp 1
  }
  test 1
}
