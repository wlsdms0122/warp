(test 1)
(name "a-module-variable-closure-may-name-its-documents-own-type")
(note "A closure a module variable starts holding is a procedure of the document that declared the variable, so its body reads the types that document declares, here a cast to one, the way a body written in a declaration does.")

(program
  (warp 1)
  (var v
    (closure
      (returns Int)
      (failing cast_refused)
      (body
        (let c (as (struct (field x 1)) App.Box))
        (return (path c (field x))))))
  (struct App.Box
    (field x Int))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let a (apply v))
      (return a))))
(expect (answers 1))
