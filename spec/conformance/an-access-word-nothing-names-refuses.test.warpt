warpt 1
{
  expect {
    refuses "load"
  }
  name "an-access-word-nothing-names-refuses"
  note "Access is one of three words, public, internal and private, and a document answers that alone. A fourth word names no scope a reader could hold the declaration to, so it is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "open"
        result 1
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

