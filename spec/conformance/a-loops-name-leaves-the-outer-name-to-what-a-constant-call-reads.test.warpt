warpt 1
{
  expect {
    answers true
  }
  name "a-loops-name-leaves-the-outer-name-to-what-a-constant-call-reads"
  note "A loop's name binds nothing after the loop: in an arm where `f` names a loop, a call of `f` after it calls the outer `f`, bound to the `const` slot `body`, so `App.asking` holds to the `const` it declares and a closure sending it stands in the const slot `Standard.Logic.and` asks."
  program {
    imports [
      "Standard.Logic.and"
    ]
    procedures {
      "App.asking" {
        body [
          {
            let "f"
            value {
              ref "body"
            }
          }
          {
            value false
            var "answered"
          }
          {
            value {
              conditional {
                then [
                  {
                    let "f"
                    value {
                      loop {
                        body []
                        while false
                      }
                    }
                  }
                  {
                    set "answered"
                    value {
                      call {
                        procedure {
                          ref "f"
                        }
                      }
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
        const true
        parameters [
          {
            name "body"
            type "const () -> Bool"
          }
        ]
        result {
          ref "answered"
        }
        returns "Bool"
      }
      entry {
        access "public"
        const true
        failing "anything"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    const true
                    result {
                      call {
                        arguments [
                          {
                            closure {
                              const true
                              isolated true
                              result true
                              returns "Bool"
                            }
                          }
                        ]
                        procedure "App.asking"
                      }
                    }
                    returns "Bool"
                  }
                }
              ]
            ]
            procedure "Standard.Logic.and"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

