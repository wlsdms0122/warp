warpt 1
{
  expect {
    answers true
  }
  name "a-loops-name-leaves-the-outer-name-to-what-a-constant-call-reads"
  note "A loop's name binds nothing after the loop in what the build derives either: in an arm where `f` names a loop, a call of `f` after it calls the constant procedure around the arm, so the body answers without running."
  program {
    imports [
      "Standard.Logic.and"
    ]
    procedures {
      "App.asking" {
        body [
          {
            let "f"
            value {
              ref "body"
            }
          }
          {
            value false
            var "answered"
          }
          {
            value {
              conditional {
                then [
                  {
                    let "f"
                    value {
                      loop {
                        body []
                        while false
                      }
                    }
                  }
                  {
                    set "answered"
                    value {
                      call {
                        procedure {
                          ref "f"
                        }
                      }
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type {
              "const procedure" {
                returns "Bool"
              }
            }
          }
        ]
        result {
          ref "answered"
        }
        returns "Bool"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  closure {
                    result {
                      call {
                        arguments [
                          {
                            closure {
                              result true
                              returns "Bool"
                            }
                          }
                        ]
                        procedure "App.asking"
                      }
                    }
                    returns "Bool"
                  }
                }
              ]
            ]
            procedure "Standard.Logic.and"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

