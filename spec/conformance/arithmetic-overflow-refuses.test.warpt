(test 1)
(name "arithmetic-overflow-refuses")
(note "Whole-number arithmetic with no whole answer refuses. Wrapping would answer, and answering wrongly is worse than not answering.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (result (call Standard.Numeric.plus 9223372036854775807 1))))
(expect (refuses run))
