(test 1)
(name "a-type-the-language-names-conforms-to-a-contract")
(note "A type the language names is a type the way a declared one is, and a document claims a contract for it the same way. The run picks by the type the value is an instance of: a list by `Array` whatever it holds, and a dictionary by `Dictionary` whatever it holds.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Array)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (array Any)))
      (returns String)
      (body
        (return "a list"))))
  (extension
    (head Dictionary)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (dictionary (some Key Hashable) Any)))
      (returns String)
      (body
        (return "a dictionary"))))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a whole number"))))
  (extension
    (head String)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type String))
      (returns String)
      (body
        (return "text"))))
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (let dictionary (type (dictionary String Int)) (dictionary (entry "a" 1)))
      (return (array (call App.Described.describe 1) (call App.Described.describe "s") (call App.Described.describe (array 1)) (call App.Described.describe dictionary))))))
(expect (answers (array "a whole number" "text" "a list" "a dictionary")))
