(test 1)
(name "an-object-writing-a-struct-as-a-type-entry-refuses")
(note "A struct is written in `types` as the declaration itself and never as an entry of `typeTable`. An entry under the struct's tag is refused where the object is read.")
(object (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"a9acbc660e232e6e0ba9ebf00a53a787b1e1e6d116111fa99513035430385125")) (entry "document" (array x"4e397fd69d6c8c4a876ea129f0d76bc74924b3d25abd0aeaaace549c1d53aeba")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Collection.appending") (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 11 (array 0 (array (array 0) (array 1)) (array))) (array 13 0 (array) (array 2)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 1) (array))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 3 "[0]")) (array 1 (array 0) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 9 (array)) (array 7 0) (array 4) (array 7 2))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
