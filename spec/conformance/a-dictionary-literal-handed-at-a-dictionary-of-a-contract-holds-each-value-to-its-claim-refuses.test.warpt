(test 1)
(name "a-dictionary-literal-handed-at-a-dictionary-of-a-contract-holds-each-value-to-its-claim-refuses")
(note "`App.h` takes `Dictionary<String, App.P>`. The dictionary literal holding `c` under `a` handed there holds a `Bank.Card`, which a beside document gives `show` but no document says conforms to `App.P`. Each value is held to its own claim, so the call refuses at the build.")

(documents
  (document
    (warp 1)
    (struct Bank.Card
      (field last String))
    (procedure Bank.Card.show
      (access public)
      (parameter of (type Bank.Card))
      (returns String)
      (body
        (return "card")))))

(program
  (warp 1)
  (import Bank.Card)
  (contract App.P
    (procedure show
      (const)
      (isolated)
      (parameter of (type Self))
      (returns String)))
  (procedure App.h
    (parameter x (type (dictionary String App.P)))
    (returns String)
    (body
      (return (call App.P.show (path x (index "a"))))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "1")) Bank.Card))
      (let s (call App.h (dictionary (entry "a" c))))
      (return s))))
(expect (refuses build))
