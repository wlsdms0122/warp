(test 1)
(name "a-send-is-a-declared-spelling-or-an-import")
(note "The document declares `Wallet.fee` and sends `fee`. That spelling is not one the document declares, so it is a procedure the document imports, and a list that leaves it out is refused when the module is made.")

(program
  (warp 1)
  (procedure Wallet.fee
    (returns Int)
    (result 7))
  (procedure entry
    (access public)
    (returns Int)
    (result (call fee))))
(expect (refuses load))
