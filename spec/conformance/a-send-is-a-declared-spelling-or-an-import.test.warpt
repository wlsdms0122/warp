warpt 1
{
  expect {
    refuses "load"
  }
  name "a-send-is-a-declared-spelling-or-an-import"
  note "The document declares `wallet.fee` and sends `fee`. That spelling is not one the document declares, so it is a word the document imports, and a list that leaves it out is refused when the module is made."
  program {
    imports []
    procedures {
      entry {
        result {
          call {
            procedure "fee"
          }
        }
        returns "int"
      }
      "wallet.fee" {
        result 7
        returns "int"
      }
    }
    warp 1
  }
  test 2
}
