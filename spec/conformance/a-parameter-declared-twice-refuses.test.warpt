warpt 1
{
  expect {
    refuses "load"
  }
  name "a-parameter-declared-twice-refuses"
  note "Two parameters under one name would be one name the body reads two ways, so a declaration writing a name twice refuses at the load, before anything is judged."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "n"
            type "int"
          }
          {
            name "n"
            type "string"
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

