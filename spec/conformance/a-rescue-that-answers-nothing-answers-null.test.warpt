(test 1)
(name "a-rescue-that-answers-nothing-answers-null")
(note "A rescue runs statements for effect and need not answer. When the body fails and that rescue is the path taken, the attempt answers null, which is the value behind the `T?` the join reads.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns (nullable Int))
    (body
      (let tried
        (attempt
          (body
            (let read (as payload Int)))
          (result read)
          (rescue
            (body
              (let noted 0))))))
    (result tried)))
(arguments (argument payload "not a whole number"))
(expect (answers null))
