warpt 1
{
  expect {
    answers "x"
  }
  name "a-cast-of-a-membership-of-a-record-with-a-declared-field-to-another-record-names-it-answers"
  note "`App.A` and `App.B` are both declared `{ a: string }`, and `App.M` admits `{ f: App.A }` and `Int`. A nameless record written into `App.M` stays nameless at every depth, so a value read as `App.M` may be one `{ f: App.B }` takes. The cast builds, and the run settles the field under `App.B`."
  program {
    constraints {
      "App.M" [
        {
          record {
            f "App.A"
          }
        }
        "Int"
      ]
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "m"
            type "App.M"
            value {
              record {
                f {
                  record {
                    a "x"
                  }
                }
              }
            }
          }
          {
            let "b"
            value {
              as {
                of {
                  ref "m"
                }
                type {
                  record {
                    f "App.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "b.f.a"
        }
      }
    }
    types {
      "App.A" {
        record {
          a "String"
        }
      }
      "App.B" {
        record {
          a "String"
        }
      }
    }
    warp 1
  }
  test 1
}

