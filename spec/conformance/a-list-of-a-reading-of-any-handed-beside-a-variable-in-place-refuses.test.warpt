(test 1)
(name "a-list-of-a-reading-of-any-handed-beside-a-variable-in-place-refuses")
(note "App.put fills U from s, a list of text handed in place, and from [j], j read as Any. U reads Array<Any>, which s is not, so the build refuses the call the way it refuses j handed beside s at the top.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure App.put
    (parameter a (type (inout (some U))))
    (parameter b (type (some U)))
    (returns Int)
    (body
      (set a b)
      (return 0)))
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (let j (type Any) 1)
      (var s (array "a"))
      (call App.put s (array j))
      (let xs (call Standard.Collection.appending s "b"))
      (return xs))))
(expect (refuses build))
