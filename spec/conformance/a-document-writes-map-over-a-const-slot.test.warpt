(test 1)
(name "a-document-writes-map-over-a-const-slot")
(note "A slot asking a `const` procedure type says what the value in it is, so calling that name is read rather than run, and a document can write `map` itself instead of reaching for the one the vocabulary brings. The call of the value stands as a statement binding `rewritten`, since an operand calling a value refuses at the build.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (import Standard.Collection.count)
  (import Standard.Comparable.lessThan)
  (import Standard.Numeric.times)
  (procedure App.mapped
    (const)
    (parameter of (type (array Int)))
    (parameter value (type (procedure (const) (parameters Int) (returns Int))))
    (returns (array Int))
    (body
      (var kept (array))
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count of)))
          (body
            (let item (path of (index (path walk (field index)))))
            (let rewritten (apply value item))
            (set kept (call Standard.Collection.appending kept rewritten))))))
    (result kept))
  (procedure entry
    (access public)
    (const)
    (returns (array Int))
    (result
      (call App.mapped
        (array 1 2 3)
        (closure
          (const)
          (isolated)
          (parameter item (type Int))
          (returns Int)
          (result (call Standard.Numeric.times item 2)))))))
(expect (answers (array 2 4 6)))
