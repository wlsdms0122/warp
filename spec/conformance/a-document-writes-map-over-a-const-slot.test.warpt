warpt 1
{
  expect {
    answers [
      2
      4
      6
    ]
  }
  name "a-document-writes-map-over-a-const-slot"
  note "A slot asking a `const` procedure type says what the value in it is, so calling that name is read rather than run, and a document can write `map` itself instead of reaching for the one the vocabulary brings. The call of the value stands as a statement binding `rewritten`, since an operand calling a value refuses at the build."
  program {
    imports [
      "Standard.Collection.appending"
      "Standard.Collection.count"
      "Standard.Comparable.lessThan"
      "Standard.Numeric.times"
    ]
    procedures {
      "App.mapped" {
        body [
          {
            value []
            var "kept"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "item"
                    value {
                      ref "of[walk.index]"
                    }
                  }
                  {
                    let "rewritten"
                    value {
                      call {
                        arguments [
                          {
                            ref "item"
                          }
                        ]
                        procedure {
                          ref "value"
                        }
                      }
                    }
                  }
                  {
                    set "kept"
                    value {
                      call {
                        arguments [
                          {
                            ref "kept"
                          }
                          {
                            ref "rewritten"
                          }
                        ]
                        procedure "Standard.Collection.appending"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "of"
                            }
                          ]
                          procedure "Standard.Collection.count"
                        }
                      }
                    ]
                    procedure "Standard.Comparable.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "Array<Int>"
          }
          {
            name "value"
            type "const (Int) -> Int"
          }
        ]
        result {
          ref "kept"
        }
        returns "Array<Int>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
                3
              ]
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                        2
                      ]
                      procedure "Standard.Numeric.times"
                    }
                  }
                  returns "Int"
                }
              }
            ]
            procedure "App.mapped"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

