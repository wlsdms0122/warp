warpt 1
{
  expect {
    answers [
      2
      4
      6
    ]
  }
  name "a-document-writes-map-over-a-const-slot"
  note "A slot asking `const procedure` says what the value in it is, so applying that name is read rather than run. That is what lets a document write map itself instead of reaching for the one the vocabulary brings. The apply is bound to a name, since an operand is read rather than run."
  program {
    imports [
      "std.collection.appending"
      "std.collection.count"
      "std.math.lessThan"
      "std.math.times"
    ]
    procedures {
      "app.mapped" {
        body [
          {
            value []
            var "kept"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "item"
                    value {
                      ref "of[walk.index]"
                    }
                  }
                  {
                    let "rewritten"
                    value {
                      apply {
                        arguments [
                          {
                            ref "item"
                          }
                        ]
                        procedure {
                          ref "value"
                        }
                      }
                    }
                  }
                  {
                    set "kept"
                    value {
                      call {
                        arguments [
                          {
                            ref "kept"
                          }
                          {
                            ref "rewritten"
                          }
                        ]
                        procedure "std.collection.appending"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "of"
                            }
                          ]
                          procedure "std.collection.count"
                        }
                      }
                    ]
                    procedure "std.math.lessThan"
                  }
                }
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "array<int>"
          }
          {
            name "value"
            type {
              "const procedure" {
                parameters [
                  "int"
                ]
                returns "int"
              }
            }
          }
        ]
        result {
          ref "kept"
        }
        returns "array<int>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                1
                2
                3
              ]
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                        2
                      ]
                      procedure "std.math.times"
                    }
                  }
                  returns "int"
                }
              }
            ]
            procedure "app.mapped"
          }
        }
        returns "array<int>"
      }
    }
    warp 1
  }
  test 1
}

