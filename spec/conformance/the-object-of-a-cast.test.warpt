(test 1)
(name "the-object-of-a-cast")
(note "A cast carries what it reads, the lowered type it reads it as, and whether it is the optional form.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter p)
    (returns Int)
    (failing cast_refused)
    (body
      (let maybe (as? p Int))
      (return (as p Int)))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array)) (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"5743c6b6b1f3d5dcac4e853d4197389b35788437aa54e99ab76647202072d4a0")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 4) (array 4))) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 6 0 0 true) (array 1 1) (array 6 2 1 false) (array 13 0 (array) (array 3)))) (entry "rows" (array (array "entry" (array (array (array "p" (array))) 0 (array 1 (array "cast_refused")) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 0 1)) 1 "maybe") (array (array) 4 "[1]")) (array 2 (array 0) (array) (array) (array "p" "maybe")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array)) (entry "variables" (array)))))
