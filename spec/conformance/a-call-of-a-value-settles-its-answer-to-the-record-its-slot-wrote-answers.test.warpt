warpt 1
{
  expect {
    answers "a"
  }
  name "a-call-of-a-value-settles-its-answer-to-the-record-its-slot-wrote-answers"
  note "`c` is held at `procedure() -> bank.A`, and the closure in it writes no `returns` and answers the nameless record `{ k: \"x\" }`. Calling `c` answers what its slot wrote, and that answer meets the declaration and settles to it, so `v` is a `bank.A` and `app.P.show`, which `bank.A` answers, is sent to it."
  program {
    contracts {
      "app.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "app.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.A.show" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "bank.A"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "app.P.show"
          }
        }
      }
    }
    satisfies {
      "bank.A" [
        "app.P"
      ]
    }
    types {
      "bank.A" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

