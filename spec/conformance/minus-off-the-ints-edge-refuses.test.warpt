warpt 1
{
  expect {
    refuses "run"
  }
  name "minus-off-the-ints-edge-refuses"
  note "Whole-number arithmetic with no whole answer refuses at the run. `minus` off the int's low edge does not wrap."
  program {
    imports [
      "Standard.Math.minus"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              -9223372036854775808
              1
            ]
            procedure "Standard.Math.minus"
          }
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

