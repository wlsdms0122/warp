(test 1)
(name "minus-off-the-ints-edge-refuses")
(note "Whole-number arithmetic with no whole answer refuses at the run. `minus` off the int's low edge does not wrap.")

(program
  (warp 1)
  (import Standard.Numeric.minus)
  (procedure entry
    (access public)
    (returns Int)
    (result (call Standard.Numeric.minus -9223372036854775808 1))))
(expect (refuses run))
