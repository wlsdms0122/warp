warpt 1
{
  expect {
    refuses "build"
  }
  name "a-literal-of-names-at-a-contract-bound-leans-on-each-claim-refuses"
  note "`App.f` bounds `T` by the contract `App.Describable` and takes `Array<Array<some T>>`. The literal `[ps, qs]` handed there holds a list of `Bank.P`, which a document says answers it, and a list of `Bank.Q`, which none does. Each name read at the parameter leans on its own claim, so the call writes both down and refuses at the build where `Bank.Q` has none."
  program {
    contracts {
      "App.Describable" {
        describe {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.Describable"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.Describable"
        }
        parameters [
          {
            name "gs"
            type "Array<Array<some T>>"
          }
        ]
        result 0
        returns "Int"
      }
      "Bank.P.describe" {
        parameters [
          {
            name "of"
            type "Bank.P"
          }
        ]
        result "p"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "ps"
            type "Array<Bank.P>"
            value [
              {
                as {
                  of {
                    record {
                      a "1"
                    }
                  }
                  type "Bank.P"
                }
              }
            ]
          }
          {
            let "qs"
            type "Array<Bank.Q>"
            value [
              {
                as {
                  of {
                    record {
                      b "1"
                    }
                  }
                  type "Bank.Q"
                }
              }
            ]
          }
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    {
                      ref "ps"
                    }
                    {
                      ref "qs"
                    }
                  ]
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      "Bank.P" [
        "App.Describable"
      ]
    }
    types {
      "Bank.P" {
        record {
          a "String"
        }
      }
      "Bank.Q" {
        record {
          b "String"
        }
      }
    }
    warp 1
  }
  test 1
}

