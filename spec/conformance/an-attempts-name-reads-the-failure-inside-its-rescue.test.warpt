warpt 1
{
  expect {
    answers "f"
  }
  name "an-attempts-name-reads-the-failure-inside-its-rescue"
  note "An attempt's statement name is the failure inside its rescue. `h` read there is the failure, which has a `message`, and the text `h` around the block is another name that keeps its value."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value "f"
          }
          {
            value {
              block {
                body [
                  {
                    let "h"
                    value {
                      attempt {
                        body [
                          {
                            value {
                              call {
                                arguments [
                                  "on purpose"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        rescue {
                          body [
                            {
                              let "m"
                              value {
                                ref "h.message"
                              }
                            }
                          ]
                          result 0
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
        result {
          ref "h"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

