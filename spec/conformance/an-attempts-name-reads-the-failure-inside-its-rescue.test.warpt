warpt 1
{
  expect {
    answers {
      inner "on purpose"
      outer "f"
    }
  }
  name "an-attempts-name-reads-the-failure-inside-its-rescue"
  note "An attempt's statement name is the failure inside its rescue and what the attempt answered after it. The `h` around the arm is another name and keeps its value."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value "f"
          }
          {
            var "inner"
          }
          {
            value {
              conditional {
                then [
                  {
                    let "h"
                    value {
                      attempt {
                        body [
                          {
                            value {
                              call {
                                arguments [
                                  "on purpose"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        rescue {
                          result {
                            ref "h.message"
                          }
                        }
                      }
                    }
                  }
                  {
                    set "inner"
                    value {
                      ref "h"
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
        result {
          dictionary [
            [
              "inner"
              {
                ref "inner"
              }
            ]
            [
              "outer"
              {
                ref "h"
              }
            ]
          ]
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
}

