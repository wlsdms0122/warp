(test 1)
(name "an-attempts-name-reads-the-failure-inside-its-rescue")
(note "An attempt's statement name is the failure inside its rescue and what the attempt answered after it. The `h` around the arm is another name and keeps its value.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let h "f")
      (var inner)
      (conditional
        (when true)
        (then
          (let h
            (attempt
              (body
                (call Standard.Control.abort "on purpose"))
              (rescue
                (result (path h (field message))))))
          (set inner h))))
    (result (dictionary (entry "inner" inner) (entry "outer" h)))))
(expect (answers (dictionary (entry "inner" "on purpose") (entry "outer" "f"))))
