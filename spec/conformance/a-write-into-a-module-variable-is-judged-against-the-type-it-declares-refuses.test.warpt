warpt 1
{
  expect {
    refuses "run"
  }
  name "a-write-into-a-module-variable-is-judged-against-the-type-it-declares-refuses"
  note "`r` is a module variable declaring `Int(0...3)`, and a body writes `Standard.Numeric.plus(4, 5)` into it. A write into a box that said what it holds is judged against it, the way a local `var` declaring a type judges each write, so 9 is outside the range and the run refuses at the write."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "r"
            value {
              call {
                arguments [
                  4
                  5
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    types {
      "Bank.A" {
        record {
          k "String"
        }
      }
    }
    var {
      r {
        type "Int(0...3)"
        value 0
      }
    }
    warp 1
  }
  test 1
}

