(test 1)
(name "an-inner-constant-of-an-outer-name-is-not-written")
(note "A `let` inside an arm spelled like a variable outside is a new name, and a fixed one. A `set` of that spelling after it in the arm writes the fixed name, which is refused, and does not reach the outer box.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var verdict 1)
      (conditional
        (when true)
        (then
          (let verdict 2)
          (set verdict 3))))
    (result verdict)))
(expect (refuses load))
