warpt 1
{
  expect {
    refuses "link"
  }
  name "sorting-the-unorderable-refuses-at-the-link"
  note "sorted is bounded by Comparable, the membership the shared std module declares. Booleans carry no ordering, and a literal is a reading the link can see, so the refusal lands before anything runs."
  program {
    imports [
      "std.collection.sorted"
    ]
    procedures {
      entry {
        result {
          call {
            of [
              true
              false
            ]
            procedure "std.collection.sorted"
          }
        }
      }
    }
    warp 2
  }
  test 1
}
