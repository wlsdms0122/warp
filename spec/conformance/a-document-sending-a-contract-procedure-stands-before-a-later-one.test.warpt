warpt 1
{
  documents [
    {
      contracts {
        "app.Describable" {
          describe {
            const true
            parameters [
              {
                name "of"
                type "app.Describable"
              }
            ]
            returns "string"
          }
        }
      }
      imports []
      procedures {
        "app.nothing" {
          result null
          returns "null"
        }
      }
      warp 1
    }
    {
      imports [
        "app.Describable"
        "app.Describable.describe"
      ]
      procedures {
        "bank.Account.describe" {
          parameters [
            {
              name "of"
              type "bank.Account"
            }
          ]
          result "an account"
          returns "string"
        }
        "bank.tell" {
          parameters [
            {
              name "of"
              type "bank.Account"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "of"
                }
              ]
              procedure "app.Describable.describe"
            }
          }
          returns "string"
        }
      }
      satisfies {
        "bank.Account" [
          "app.Describable"
        ]
      }
      types {
        "bank.Account" {
          record {
            balance "int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    answers "an account"
  }
  name "a-document-sending-a-contract-procedure-stands-before-a-later-one"
  note "A call to a contract's procedure is answered by the link through the contract, not by a row a document declares, so a document sending one stands laid beside a document laid after it. The documents beside the program are laid one after another, and the program comes last."
  program {
    imports [
      "bank.Account"
      "bank.tell"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "account"
            value {
              as {
                of {
                  record {
                    balance 1
                  }
                }
                type "bank.Account"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "account"
              }
            ]
            procedure "bank.tell"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
}

