warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-that-says-nothing-is-what-the-build-worked-out"
  note "The same program with the declaration left off. The build works out `const isolated procedure` for the closure literal, because that is what its text does, and an `inout` slot asks for the same type the name is. The slot says `procedure` and the name is not that, so the two are not one type."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              closure {
                parameters [
                  {
                    name "x"
                    type "int"
                  }
                ]
                result {
                  ref "x"
                }
                returns "int"
              }
            }
            var "step"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "step"
                  }
                ]
                procedure "swap"
              }
            }
          }
        ]
        result 1
      }
      swap {
        parameters [
          {
            name "step"
            type {
              "inout procedure" {
                parameters [
                  "int"
                ]
                returns "int"
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

