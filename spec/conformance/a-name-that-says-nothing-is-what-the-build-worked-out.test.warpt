warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-that-says-nothing-is-what-the-build-worked-out"
  note "The same program with the declaration left off. The build works out `pure isolated procedure` for the closure literal, because that is what its text does, and an `inout` slot asks for the same type the name is. The slot says `procedure` and the name is not that, so the two are not one shape."
  program {
    imports [
    ]
    procedures {
      entry {
        body [
          {
            var "step"
            value {
              closure {
                parameters {
                  x "int"
                }
                result {
                  ref "x"
                }
                returns "int"
              }
            }
          }
          {
            value {
              call {
                arguments {
                  step {
                    ref "step"
                  }
                }
                procedure "swap"
              }
            }
          }
        ]
        result 1
      }
      swap {
        body [
        ]
        parameters {
          step {
            type {
              "inout procedure" {
                parameters {
                  x "int"
                }
                returns "int"
              }
            }
          }
        }
      }
    }
    warp 1
  }
  test 1
}
