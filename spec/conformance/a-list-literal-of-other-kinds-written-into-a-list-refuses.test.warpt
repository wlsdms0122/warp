warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-of-other-kinds-written-into-a-list-refuses"
  note "A variable declared `array<int>` starts with `[1, \"s\"]`. The literal is held to the declaration element by element, so the string refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "array<int>"
            value [
              1
              "s"
            ]
            var "xs"
          }
        ]
        result 0
      }
    }
    warp 1
  }
  test 1
}

