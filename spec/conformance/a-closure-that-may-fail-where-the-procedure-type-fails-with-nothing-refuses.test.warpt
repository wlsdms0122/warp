warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-that-may-fail-where-the-procedure-type-fails-with-nothing-refuses"
  note "The closure declares it may fail with `aborted`, and the slot's procedure type `const (Int) -> Int` says it fails with nothing, so the argument is refused at the build."
  program {
    contracts {
      "App.Runner" {
        procedures {
          run {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "step"
                type "const (Int) -> Int"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          run {
            parameters [
              {
                name "of"
                type "Int"
              }
              {
                name "step"
                type "const (Int) -> Int"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure {
                  ref "step"
                }
              }
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Runner"
        ]
      }
    }
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              1
              {
                closure {
                  const true
                  failing [
                    "aborted"
                  ]
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        "no"
                      ]
                      procedure "Standard.Control.abort"
                    }
                  }
                  returns "Int"
                }
              }
            ]
            procedure "App.Runner.run"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

