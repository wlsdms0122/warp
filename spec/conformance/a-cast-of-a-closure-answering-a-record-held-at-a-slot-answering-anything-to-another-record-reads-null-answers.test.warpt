warpt 1
{
  expect {
    answers null
  }
  name "a-cast-of-a-closure-answering-a-record-held-at-a-slot-answering-anything-to-another-record-reads-null-answers"
  note "The closure writes `returns Bank.A` and is held at `procedure() -> any`, then travels through `any`. A call of it settles to its own answer first, so a slot takes it only where its answer takes `Bank.A` as well as `any`, and `Bank.B` never takes a `Bank.A`: the asking cast to `procedure() -> Bank.B` reads it as null."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "any"
              }
            }
            value {
              closure {
                result {
                  record {
                    k "x"
                  }
                }
                returns "Bank.A"
              }
            }
          }
          {
            let "x"
            type {
              procedure {
                returns "any"
              }
            }
            value {
              ref "c"
            }
          }
          {
            let "a"
            type "any"
            value {
              ref "x"
            }
          }
          {
            let "v"
            value {
              "as?" {
                of {
                  ref "a"
                }
                type {
                  procedure {
                    returns "Bank.B"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "v"
        }
      }
    }
    types {
      "Bank.A" {
        record {
          k "string"
        }
      }
      "Bank.B" {
        record {
          k "string"
        }
      }
    }
    warp 1
  }
  test 1
}

