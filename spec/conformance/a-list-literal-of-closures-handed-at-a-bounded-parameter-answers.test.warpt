(test 1)
(name "a-list-literal-of-closures-handed-at-a-bounded-parameter-answers")
(note "`App.f` bounds `T` by `App.M`, which `Int` and `String` answer, and takes a list of procedures taking `some T`. A list literal handed there holds a closure taking `Int` and one taking `Any`, and `x` fills `T` with `Int`. Only the parts standing at the parameter are held to the bounds, so each closure is judged as any closure handed to its procedure type is, and the call answers 1.")

(program
  (warp 1)
  (contract App.M)
  (extension
    (head Int)
    (satisfies App.M))
  (extension
    (head String)
    (satisfies App.M))
  (procedure App.f
    (parameter gs (type (array (procedure (parameters (some T App.M)) (returns Int)))))
    (parameter x (type (some T)))
    (returns Int)
    (body
      (return (apply (path gs (index 0)) x))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let r
        (call App.f
          (array
            (closure
              (parameter n (type Int))
              (returns Int)
              (body
                (return n)))
            (closure
              (parameter n)
              (returns Int)
              (body
                (return 7))))
          1))
      (return r))))
(expect (answers 1))
