(test 1)
(name "a-declared-name-is-not-retyped-by-a-write")
(note "A name that says what it holds is fixed at that. A write into it is held to the declaration and does not retype it, the way a write into a module variable or an `inout` parameter is.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var held (type Int) 1)
      (set held "no"))
    (result held)))
(expect (refuses build))
