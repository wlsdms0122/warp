warpt 1
{
  expect {
    answers {
      pieces [
        "fragile"
      ]
      type "concurrent_failed"
    }
  }
  name "a-rescue-reads-what-a-failure-carried"
  note "The envelope is the same for every failure and `details` is the box the failing procedure fills. `concurrent_failed` puts every piece's reason there, keyed by the piece, and a rescue reads it with a dot through `details`."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Concurrent.allKeyed"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            record {
                              fine {
                                closure {
                                  result "ok"
                                }
                              }
                              fragile {
                                closure {
                                  body [
                                    {
                                      value {
                                        call {
                                          arguments [
                                            "on purpose"
                                          ]
                                          procedure "Standard.Control.abort"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        ]
                        procedure "Standard.Concurrent.allKeyed"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    record {
                      pieces {
                        call {
                          arguments [
                            {
                              ref "tried.details.failures"
                            }
                          ]
                          procedure "Standard.Collection.keys"
                        }
                      }
                      type {
                        ref "tried.type"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

