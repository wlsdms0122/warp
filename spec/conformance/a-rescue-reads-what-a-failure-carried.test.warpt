(test 1)
(name "a-rescue-reads-what-a-failure-carried")
(note "The envelope is the same for every failure and `details` is the box the failing procedure fills. `concurrent_failed` puts every piece's reason there, keyed by the piece, and a rescue reads it through brackets on `details`.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (import Standard.Concurrent.allKeyed)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns (nullable (dictionary String Any)))
    (failing cast_refused)
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (call Standard.Concurrent.allKeyed
              (dictionary
                (entry "fine"
                  (closure
                    (const)
                    (isolated)
                    (returns String)
                    (result "ok")))
                (entry "fragile"
                  (closure
                    (const)
                    (isolated)
                    (returns Never)
                    (failing aborted)
                    (body
                      (call Standard.Control.abort "on purpose")))))))
          (rescue
            (set tried (dictionary (entry "pieces" (call Standard.Collection.keys (as (path caught (field details) (index "failures")) (dictionary String Any)))) (entry "type" (path caught (field type)))))))))
    (result tried)))
(expect (answers (dictionary (entry "pieces" (array "fragile")) (entry "type" "concurrent_failed"))))
