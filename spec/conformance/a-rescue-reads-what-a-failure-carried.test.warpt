warpt 1
{
  expect {
    answers {
      pieces [
        "fragile"
      ]
      type "concurrent_failed"
    }
  }
  name "a-rescue-reads-what-a-failure-carried"
  note "The envelope is the same for every failure and `details` is the box the failing procedure fills. `concurrent_failed` puts every piece's reason there, keyed by the piece, and a rescue reads it through brackets on `details`."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Concurrent.allKeyed"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            dictionary [
                              [
                                "fine"
                                {
                                  closure {
                                    const true
                                    isolated true
                                    result "ok"
                                    returns "String"
                                  }
                                }
                              ]
                              [
                                "fragile"
                                {
                                  closure {
                                    body [
                                      {
                                        value {
                                          call {
                                            arguments [
                                              "on purpose"
                                            ]
                                            procedure "Standard.Control.abort"
                                          }
                                        }
                                      }
                                    ]
                                    const true
                                    failing [
                                      "aborted"
                                    ]
                                    isolated true
                                    returns "Never"
                                  }
                                }
                              ]
                            ]
                          }
                        ]
                        procedure "Standard.Concurrent.allKeyed"
                      }
                    }
                  }
                ]
                rescue {
                  result {
                    dictionary [
                      [
                        "pieces"
                        {
                          call {
                            arguments [
                              {
                                as {
                                  of {
                                    ref "tried.details[\"failures\"]"
                                  }
                                  type "Dictionary<String, Any>"
                                }
                              }
                            ]
                            procedure "Standard.Collection.keys"
                          }
                        }
                      ]
                      [
                        "type"
                        {
                          ref "tried.type"
                        }
                      ]
                    ]
                  }
                }
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        isolated true
        result {
          ref "tried"
        }
        returns "Dictionary<String, Any>?"
      }
    }
    warp 1
  }
  test 1
}

