warpt 1
{
  expect {
    refuses "load"
  }
  name "claims-written-out-of-order-refuse"
  note "The contracts a type answers under `satisfies` are written in name order, so `App.Y` before `App.X` is a second spelling of the same claims. A document says each thing one way, and this one refuses at the load."
  program {
    contracts {
      "App.X" {
        d {
          parameters [
            {
              name "of"
              type "App.X"
            }
          ]
          returns "string"
        }
      }
      "App.Y" {
        e {
          parameters [
            {
              name "of"
              type "App.Y"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.d" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      "Bank.A.e" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        result 1
      }
    }
    satisfies {
      "Bank.A" [
        "App.Y"
        "App.X"
      ]
    }
    types {
      "Bank.A" {
        record {
          n "int"
        }
      }
    }
    warp 1
  }
  test 1
}

