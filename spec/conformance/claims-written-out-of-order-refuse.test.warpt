warpt 1
{
  expect {
    refuses "load"
  }
  name "claims-written-out-of-order-refuse"
  note "The contracts a type answers under `satisfies` are written in name order, so `app.Y` before `app.X` is a second spelling of the same claims. A document says each thing one way, and this one refuses at the load."
  program {
    contracts {
      "app.X" {
        d {
          parameters [
            {
              name "of"
              type "app.X"
            }
          ]
          returns "string"
        }
      }
      "app.Y" {
        e {
          parameters [
            {
              name "of"
              type "app.Y"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "bank.A.d" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      "bank.A.e" {
        parameters [
          {
            name "of"
            type "bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        result 1
      }
    }
    satisfies {
      "bank.A" [
        "app.Y"
        "app.X"
      ]
    }
    types {
      "bank.A" {
        record {
          n "int"
        }
      }
    }
    warp 1
  }
  test 1
}

