warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-on-what-never-finishes-is-refused"
  note "std.control.abort declares never, so a name on its call promises a binding that cannot happen. The build refuses the name where the signature is known."
  program {
    imports [
      "std.control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "gone"
            value {
              call {
                of "done"
                procedure "std.control.abort"
              }
            }
          }
        ]
        result 1
      }
    }
    warp 1
  }
  test 2
}

