warpt 1
{
  expect {
    refuses "build"
  }
  name "a-name-on-what-never-finishes-is-refused"
  note "Standard.Control.abort declares Never, so a name on its call promises a binding that cannot happen. The build refuses the name where the signature is known."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "gone"
            value {
              call {
                arguments [
                  "done"
                ]
                procedure "Standard.Control.abort"
              }
            }
          }
        ]
        failing [
          "aborted"
        ]
        result 1
        returns "Never"
      }
    }
    warp 1
  }
  test 1
}

