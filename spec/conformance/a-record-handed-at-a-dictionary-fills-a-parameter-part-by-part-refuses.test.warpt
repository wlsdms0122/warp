warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-handed-at-a-dictionary-fills-a-parameter-part-by-part-refuses"
  note "`App.f` answers the `Dictionary<String, { x: some T }>` it takes. The record handed there holds `{ x: 1 }` and `{ x: null }`, and its fields fill `T` joined part by part, as a list literal's elements do, so `T` reads `Int?`. The answer is then a dictionary of `{ x: Int? }`, which the name declaring `Dictionary<String, { x: Int }>` does not hold, and it refuses at the build."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "d"
            type {
              dictionary {
                key "String"
                value {
                  record {
                    x "some T"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "d"
        }
        returns {
          dictionary {
            key "String"
            value {
              record {
                x "some T"
              }
            }
          }
        }
      }
      entry {
        access "public"
        body [
          {
            let "r"
            type {
              dictionary {
                key "String"
                value {
                  record {
                    x "Int"
                  }
                }
              }
            }
            value {
              call {
                arguments [
                  {
                    record {
                      a {
                        record {
                          x 1
                        }
                      }
                      b {
                        record {
                          x null
                        }
                      }
                    }
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

