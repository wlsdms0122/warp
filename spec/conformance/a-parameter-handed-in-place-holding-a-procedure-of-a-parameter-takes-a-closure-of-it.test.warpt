warpt 1
{
  expect {
    answers 5
  }
  name "a-parameter-handed-in-place-holding-a-procedure-of-a-parameter-takes-a-closure-of-it"
  note "App.swap takes Procedure<(some T) -> some T> in place and writes a closure taking and answering some T. The closure is const and isolated, which a slot that does not ask for either takes."
  program {
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.swap" {
        body [
          {
            set "f"
            value {
              closure {
                parameters [
                  {
                    name "y"
                    type "some T"
                  }
                ]
                result {
                  ref "y"
                }
                returns "some T"
              }
            }
          }
        ]
        parameters [
          {
            name "f"
            type {
              "inout procedure" {
                parameters [
                  "some T"
                ]
                returns "some T"
              }
            }
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            type {
              procedure {
                parameters [
                  "Int"
                ]
                returns "Int"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "n"
                    type "Int"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "n"
                      }
                      1
                    ]
                    procedure "Standard.Numeric.plus"
                  }
                }
                returns "Int"
              }
            }
            var "g"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "g"
                  }
                ]
                procedure "App.swap"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  5
                ]
                procedure {
                  ref "g"
                }
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

