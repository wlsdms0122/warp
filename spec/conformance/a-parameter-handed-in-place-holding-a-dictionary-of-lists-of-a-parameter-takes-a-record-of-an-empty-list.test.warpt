warpt 1
{
  expect {
    answers {
      k []
    }
  }
  name "a-parameter-handed-in-place-holding-a-dictionary-of-lists-of-a-parameter-takes-a-record-of-an-empty-list"
  note "App.g writes a map literal holding `[]` under `k` into d, a dictionary of lists of T handed in place. The empty list in the entry holds no element, so the map is a value of Dictionary<String, Array<some T>>, and the caller reads k as an empty list."
  program {
    imports []
    procedures {
      "App.g" {
        body [
          {
            set "d"
            value {
              dictionary [
                [
                  "k"
                  []
                ]
              ]
            }
          }
        ]
        parameters [
          {
            name "d"
            type "inout Dictionary<String, Array<some T>>"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            type "Dictionary<String, Array<String>>"
            value {
              dictionary [
                [
                  "k"
                  [
                    "a"
                  ]
                ]
              ]
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

