(test 1)
(name "a-side-not-saying-it-is-isolated-handed-to-and-refuses")
(note "`Standard.Logic.and` takes sides that touch nothing, written `const isolated`, and the side handed second says only that it answers without running, so it refuses where it is handed.")

(program
  (warp 1)
  (import Standard.Logic.and)
  (procedure entry
    (access public)
    (returns Bool)
    (result
      (call Standard.Logic.and
        (array
          (closure
            (const)
            (isolated)
            (returns Bool)
            (result true))
          (closure
            (const)
            (returns Bool)
            (result true)))))))
(expect (refuses build))
