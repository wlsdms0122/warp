warpt 1
{
  expect {
    answers "f"
  }
  name "a-borrow-passes-to-another-borrow"
  note "A body that borrowed a value written `linear` may lend it on to another slot that borrows. The obligation never moves, and the body that lent it first still hands it on."
  program {
    imports [
      "app.Handle"
      "app.close"
      "app.name"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            let "shown"
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "show"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
        result {
          ref "shown"
        }
        returns "string"
      }
      show {
        parameters [
          {
            name "of"
            type "borrowing app.Handle"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of"
              }
            ]
            procedure "app.name"
          }
        }
        returns "string"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.name" {
        answers "f"
        parameters [
          {
            name "first"
            type "borrowing app.Handle"
          }
        ]
        returns "string"
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

