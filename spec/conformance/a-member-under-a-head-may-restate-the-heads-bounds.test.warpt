(test 1)
(name "a-member-under-a-head-may-restate-the-heads-bounds")
(note "A member under `App.Box<some T: Hashable>` writing `T: Hashable` again says what the head says, and the document keeps it as written.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some T Hashable)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some T Hashable))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (answers "box"))
