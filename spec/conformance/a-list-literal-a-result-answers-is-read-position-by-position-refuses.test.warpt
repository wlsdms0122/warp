(test 1)
(name "a-list-literal-a-result-answers-is-read-position-by-position-refuses")
(note "App.g declares it answers Array<Dictionary<String, Array<String>>>, and its result is a list of two map literals, one holding `[]` under `a` and one holding `[1]`. The declared answer holds what the result writes into it, its elements joined position by position, so the build refuses the result.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure App.g
    (parameter x (type Int))
    (returns (array (dictionary String (array String))))
    (body
      (let k x)
      (return (array (dictionary (entry "a" (array))) (dictionary (entry "a" (array 1)))))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let r (call App.g 1))
      (let n (call Standard.Collection.count r))
      (return n))))
(expect (refuses build))
