warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-result-answers-is-read-position-by-position-refuses"
  note "App.g declares it answers Array<Dictionary<Array<String>>>, and its result is [{ a: [] }, { a: [1] }]. The declared answer holds what the result writes into it, its elements joined position by position, so the build refuses the result."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      "App.g" {
        body [
          {
            let "k"
            value {
              ref "x"
            }
          }
        ]
        parameters [
          {
            name "x"
            type "Int"
          }
        ]
        result [
          {
            record {
              a []
            }
          }
          {
            record {
              a [
                1
              ]
            }
          }
        ]
        returns "Array<Dictionary<Array<String>>>"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  1
                ]
                procedure "App.g"
              }
            }
          }
          {
            let "n"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "Standard.Collection.count"
              }
            }
          }
        ]
        result {
          ref "n"
        }
      }
    }
    warp 1
  }
  test 1
}

