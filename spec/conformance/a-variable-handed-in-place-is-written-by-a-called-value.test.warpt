warpt 1
{
  expect {
    answers 11
  }
  name "a-variable-handed-in-place-is-written-by-a-called-value"
  note "A call of a value whose type the build reads hands a variable in place at each position the type marks `inout`, the way a call to a declaration does. The closure writes the caller's box, and the caller reads what was written."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 10
            var "n"
          }
          {
            let "bump"
            value {
              closure {
                body [
                  {
                    set "count"
                    value {
                      call {
                        arguments [
                          {
                            ref "count"
                          }
                          1
                        ]
                        procedure "std.math.plus"
                      }
                    }
                  }
                ]
                parameters [
                  {
                    name "count"
                    type "inout int"
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure {
                  ref "bump"
                }
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

