warpt 1
{
  expect {
    refuses "build"
  }
  name "a-procedure-handing-a-parameter-in-place-to-a-value-does-not-answer-without-running"
  note "A parameter handed in place is the caller's box, and a body handing it on in place to a value reaches that box the way it would through a declaration, so it does not answer without running. A slot asking a `const` procedure type refuses a closure calling it at the build, even on a variable of the closure's own."
  program {
    imports [
      "Standard.Collection.map"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "peek"
            value {
              closure {
                parameters [
                  {
                    name "count"
                    type "inout Int"
                  }
                ]
                result {
                  ref "count"
                }
                returns "Int"
              }
            }
          }
        ]
        failing "anything"
        result {
          call {
            arguments [
              [
                1
                2
              ]
              {
                closure {
                  body [
                    {
                      value {
                        ref "item"
                      }
                      var "own"
                    }
                    {
                      let "got"
                      value {
                        call {
                          arguments [
                            {
                              ref "own"
                            }
                            {
                              ref "peek"
                            }
                          ]
                          procedure "relay"
                        }
                      }
                    }
                  ]
                  parameters [
                    {
                      name "item"
                      type "Int"
                    }
                  ]
                  result {
                    ref "got"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "Standard.Collection.map"
          }
        }
        returns "Array<Int>"
      }
      relay {
        body [
          {
            let "got"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure {
                  ref "read"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "n"
            type "inout Int"
          }
          {
            name "read"
            type "const (inout Int) -> Int"
          }
        ]
        result {
          ref "got"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

