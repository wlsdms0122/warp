(test 1)
(name "a-procedure-handing-a-parameter-in-place-to-a-value-does-not-answer-without-running")
(note "A parameter handed in place is the caller's box, and a body handing it on in place to a value reaches that box the way it would through a declaration, so it does not answer without running. `relay` declares `const` and hands its parameter on in place to `read`, so it refuses at the build, even where the closure calling it hands it a variable of the closure's own.")

(program
  (warp 1)
  (import Standard.Collection.map)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (let peek
        (closure
          (const)
          (isolated)
          (parameter count (type (inout Int)))
          (returns Int)
          (result count))))
    (result
      (call Standard.Collection.map
        (array 1 2)
        (closure
          (const)
          (isolated)
          (parameter item (type Int))
          (returns Int)
          (body
            (var own item)
            (let got (call relay own peek)))
          (result got)))))
  (procedure relay
    (const)
    (isolated)
    (parameter n (type (inout Int)))
    (parameter read (type (procedure (const) (isolated) (parameters (inout Int)) (returns Int))))
    (returns Int)
    (body
      (let got (apply read n)))
    (result got)))
(expect (refuses build))
