(test 1)
(name "an-associated-type-a-call-fills-from-the-callers-parameter-is-the-callers-answers")
(note "`Use.twice` hands its own C to `Lib.firstOf`, and what that answers is its own `some C.Item`.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item))))))
  (document
    (warp 1)
    (import Lib.Container)
    (import Lib.firstOf)
    (procedure Use.twice
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (let x (call Lib.firstOf c)))
      (result x))))

(program
  (warp 1)
  (import App.Box)
  (import Use.twice)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (let x (call Use.twice b)))
    (result x)))
(expect (answers 1))
