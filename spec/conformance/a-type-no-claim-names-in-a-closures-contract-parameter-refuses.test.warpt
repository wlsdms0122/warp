warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-no-claim-names-in-a-closures-contract-parameter-refuses"
  note "Calling a value holds each argument to the position its type declares the way a call to a declaration holds one to its slot. No document claims `Bank.Card` answers `App.Describable`, so the call is refused at the build, before the body runs."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.describe" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result "a card"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "tell"
            value {
              closure {
                parameters [
                  {
                    name "it"
                    type "App.Describable"
                  }
                ]
                result {
                  call {
                    arguments [
                      {
                        ref "it"
                      }
                    ]
                    procedure "App.Describable.describe"
                  }
                }
                returns "String"
              }
            }
          }
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "applied"
            value {
              call {
                arguments [
                  {
                    ref "card"
                  }
                ]
                procedure {
                  ref "tell"
                }
              }
            }
          }
        ]
        result {
          ref "applied"
        }
      }
    }
    types {
      "Bank.Card" {
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

