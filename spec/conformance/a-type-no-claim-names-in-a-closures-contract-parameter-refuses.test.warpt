(test 1)
(name "a-type-no-claim-names-in-a-closures-contract-parameter-refuses")
(note "Calling a value holds each argument to the position its type declares the way a call to a declaration holds one to its slot. No document claims `Bank.Card` answers `App.Describable`, so the call is refused at the build, before the body runs.")

(program
  (warp 1)
  (struct Bank.Card
    (field last String))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure Bank.Card.describe
    (parameter of (type Bank.Card))
    (returns String)
    (body
      (return "a card")))
  (procedure entry
    (access public)
    (returns String)
    (failing (anything))
    (body
      (let tell
        (closure
          (parameter it (type App.Describable))
          (returns String)
          (body
            (return (call App.Describable.describe it)))))
      (let card (as (struct (field last "42")) Bank.Card))
      (let applied (apply tell card))
      (return applied))))
(expect (refuses build))
