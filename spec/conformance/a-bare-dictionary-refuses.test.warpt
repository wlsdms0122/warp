warpt 1
{
  expect {
    refuses "load"
  }
  name "a-bare-dictionary-refuses"
  note "A map says what it holds. `Dictionary<Any>` is a map of anything, and `Dictionary` written bare is not a second spelling of it, so a type written that way refuses at the load."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "d"
            type "Dictionary"
          }
        ]
        result 1
      }
      entry {
        access "public"
        result 1
      }
    }
    warp 1
  }
  test 1
}

