(test 1)
(name "a-bare-dictionary-refuses")
(note "A map says what it holds, its key's type and its value's. `Dictionary<String, Any>` is a map from text to anything, and `Dictionary` written bare is not a second spelling of it, so a type written that way refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter d (type Dictionary))
    (returns Int)
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses load))
