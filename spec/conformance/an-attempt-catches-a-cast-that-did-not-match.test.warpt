warpt 1
{
  arguments {
    payload 1
  }
  expect {
    answers "caught"
  }
  name "an-attempt-catches-a-cast-that-did-not-match"
  note "A cast is the author expecting a shape of data that came from outside, and being wrong about that is what the world does, so the refusal is a failure like any other and an `attempt` catches it."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "read"
                    value {
                      as "string"
                      of {
                        ref "payload"
                      }
                    }
                  }
                ]
                result {
                  ref "read"
                }
                rescue {
                  result "caught"
                }
              }
            }
          }
        ]
        parameters {
          payload {
            type "any"
          }
        }
        result {
          ref "tried"
        }
        returns "string"
      }
    }
    warp 1
  }
  test 2
}
