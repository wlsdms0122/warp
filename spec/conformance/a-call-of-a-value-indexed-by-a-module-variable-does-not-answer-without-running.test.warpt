warpt 1
{
  expect {
    refuses "build"
  }
  name "a-call-of-a-value-indexed-by-a-module-variable-does-not-answer-without-running"
  note "Which value a call of a value calls is read like any name. A body reading a module variable to pick the entry it calls out of a `Dictionary<const Procedure>` answers by the run's state, so it does not answer without running, and an operand may not call it."
  program {
    imports [
      "Standard.Math.plus"
    ]
    procedures {
      asking {
        body [
          {
            let "a"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "body[mode]"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type {
              dictionary {
                "const procedure" {
                  parameters [
                    "Int"
                  ]
                  returns "Int"
                }
              }
            }
          }
        ]
        result {
          ref "a"
        }
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      record {
                        k {
                          closure {
                            parameters [
                              {
                                name "x"
                                type "Int"
                              }
                            ]
                            result {
                              ref "x"
                            }
                            returns "Int"
                          }
                        }
                      }
                    }
                  ]
                  procedure "asking"
                }
              }
              1
            ]
            procedure "Standard.Math.plus"
          }
        }
        returns "Int"
      }
    }
    var {
      mode "k"
    }
    warp 1
  }
  test 1
}

