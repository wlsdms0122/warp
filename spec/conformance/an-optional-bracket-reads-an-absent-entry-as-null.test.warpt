warpt 1
{
  expect {
    answers null
  }
  name "an-optional-bracket-reads-an-absent-entry-as-null"
  note "On a dictionary `?[` expects the entry's absence, as `?.` does: a key the run reads that names no entry reads as null rather than refusing."
  program {
    imports []
    procedures {
      "App.read" {
        parameters [
          {
            name "of"
            type "Dictionary<Int>"
          }
          {
            name "key"
            type "String"
          }
        ]
        result {
          ref "of?[key]"
        }
        returns "Int?"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                record {
                  a 1
                }
              }
              "b"
            ]
            procedure "App.read"
          }
        }
        returns "Int?"
      }
    }
    warp 1
  }
  test 1
}

