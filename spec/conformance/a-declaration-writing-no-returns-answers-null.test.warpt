(test 1)
(name "a-declaration-writing-no-returns-answers-null")
(note "A declaration that writes no `returns` answers null: `Null` is what a procedure answering nothing answers, and nothing is read off its body.")

(program
  (warp 1)
  (procedure App.nothing
    (body
      (let x 1)))
  (procedure entry
    (access public)
    (body
      (return (call App.nothing)))))
(expect (answers null))
