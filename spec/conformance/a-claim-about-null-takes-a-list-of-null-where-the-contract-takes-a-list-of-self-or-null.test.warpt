(test 1)
(name "a-claim-about-null-takes-a-list-of-null-where-the-contract-takes-a-list-of-self-or-null")
(note "`Array<Self?>` read for a claim about `Null` is `Array<Null>`, so the declaration writes that at the position, and the claim holds.")

(program
  (warp 1)
  (contract App.Q
    (procedure q
      (parameter s (type Self))
      (parameter t (type (array (nullable Self))))
      (returns Int)))
  (extension
    (head Null)
    (satisfies App.Q)
    (procedure q
      (parameter s (type Null))
      (parameter t (type (array Null)))
      (returns Int)
      (body
        (return 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.Q.q null (array null))))))
(expect (answers 1))
