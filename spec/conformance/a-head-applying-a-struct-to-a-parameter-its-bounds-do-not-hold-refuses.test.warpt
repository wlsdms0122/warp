(test 1)
(name "a-head-applying-a-struct-to-a-parameter-its-bounds-do-not-hold-refuses")
(note "App.Box holds `T` to `Hashable`, and a head is a mention of the type it applies, so `App.Box<some U>` bounding `U` by nothing applies App.Box to what its bounds do not hold and refuses at the build, as a parameter written so does.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T Hashable)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some U)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some U Hashable))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (refuses build))
