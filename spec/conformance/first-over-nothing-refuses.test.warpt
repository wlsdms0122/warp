(test 1)
(name "first-over-nothing-refuses")
(note "A procedure that answers exactly one thing has no empty answer.")

(program
  (warp 1)
  (import Standard.Concurrent.first)
  (procedure entry
    (access public)
    (returns Never)
    (failing concurrent_failed)
    (result (call Standard.Concurrent.first (array)))))
(expect (refuses run))
