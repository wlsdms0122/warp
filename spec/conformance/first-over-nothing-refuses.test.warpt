warpt 1
{
  expect {
    refuses "run"
  }
  name "first-over-nothing-refuses"
  note "A procedure that answers exactly one thing has no empty answer."
  program {
    imports [
      "Standard.Concurrent.first"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              []
            ]
            procedure "Standard.Concurrent.first"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

