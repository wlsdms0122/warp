warpt 1
{
  expect {
    refuses "run"
  }
  name "first-over-nothing-refuses"
  note "A procedure that answers exactly one thing has no empty answer."
  program {
    imports [
      "std.concurrent.first"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "won"
            value {
              call {
                of []
                procedure "std.concurrent.first"
              }
            }
          }
        ]
        result {
          ref "won"
        }
      }
    }
    warp 1
  }
  test 1
}

