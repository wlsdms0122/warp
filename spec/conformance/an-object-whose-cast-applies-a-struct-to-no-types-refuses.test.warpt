(test 1)
(name "an-object-whose-cast-applies-a-struct-to-no-types-refuses")
(note "A lowered declared type applying a struct to types writes them after its place, at least one, and one applying it to none writes no list. A cast to `App.Box` applied to an empty list is refused where the object is read.")
(object (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"1214d0d339a219ca4559a16fe2b995c3e59da99a54501ca47b1e3db053721bf2")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 14 0 (array)))) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 6 0 0 false) (array 0 0) (array 13 0 (array) (array 2)))) (entry "rows" (array (array "entry" (array (array (array "p" (array) (array))) 1 (array 1 (array "cast_refused")) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 0 1)) 1 "b") (array (array) 3 "[1]")) (array 2 (array 0) (array) (array) (array "p" "b")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array "App.Box")) (entry "typeTable" (array (array 15 "T") (array 4))) (entry "types" (array (array "App.Box" (array 9 (array (array "item" 0)) (array "T") (array))))) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
