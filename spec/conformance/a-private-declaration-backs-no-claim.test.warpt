warpt 1
{
  expect {
    refuses "build"
  }
  name "a-private-declaration-backs-no-claim"
  note "A contract is how a document that never names a declaration calls it, so a private declaration answers no contract. The claim it would back does not hold, and is refused where the pair is leaned on, the way a claim nothing backs is."
  program {
    contracts {
      "app.Describable" {
        describe {
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "app.Handle.describe" {
        access "private"
        parameters {
          of {
            type "app.Handle"
          }
        }
        receiver "of"
        result "a handle"
        returns "string"
      }
      "app.tell" {
        bounds {
          T "app.Describable"
        }
        parameters {
          it {
            type "some T"
          }
        }
        receiver "it"
        result {
          call {
            of {
              ref "it"
            }
            procedure "app.Describable.describe"
          }
        }
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              as "app.Handle"
              of {
                name "x"
              }
            }
          }
        ]
        result {
          call {
            of {
              ref "handle"
            }
            procedure "app.tell"
          }
        }
        returns "string"
      }
    }
    satisfies {
      "app.Handle" [
        "app.Describable"
      ]
    }
    types {
      "app.Handle" {
        name "string"
      }
    }
    warp 1
  }
  test 1
}

