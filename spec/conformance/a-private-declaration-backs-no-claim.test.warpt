warpt 1
{
  expect {
    refuses "build"
  }
  name "a-private-declaration-backs-no-claim"
  note "A contract is how a document that never names a declaration calls it, so a private declaration answers no contract. The claim it would back does not hold, and is refused where the pair is leaned on, the way a claim nothing backs is."
  program {
    contracts {
      "App.Describable" {
        describe {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.Handle.describe" {
        access "private"
        parameters [
          {
            name "of"
            type "App.Handle"
          }
        ]
        result "a handle"
        returns "String"
      }
      "App.tell" {
        bounds {
          T "App.Describable"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              as {
                of {
                  record {
                    name "x"
                  }
                }
                type "App.Handle"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "handle"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    satisfies {
      "App.Handle" [
        "App.Describable"
      ]
    }
    types {
      "App.Handle" {
        record {
          name "String"
        }
      }
    }
    warp 1
  }
  test 1
}

