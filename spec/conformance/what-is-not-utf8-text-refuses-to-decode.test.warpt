warpt 1
{
  expect {
    refuses "run"
  }
  name "what-is-not-utf8-text-refuses-to-decode"
  note "Bytes carry no promise of being text, and completing a broken sequence with replacement characters would answer a text nobody sent. The bytes are a run-time value, so the refusal is the run's."
  program {
    imports [
      "std.text.decoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              x"ff"
              "utf8"
            ]
            procedure "std.text.decoded"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

