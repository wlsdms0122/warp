warpt 1
{
  expect {
    answers [
      "a"
      "b"
      "c"
    ]
  }
  name "keys-answer-in-canonical-order"
  note "A record has no order, so keys answers in the record's canonical order. Names ascending, and a program that walks it gets the same walk on every run."
  program {
    imports [
      "Standard.Collection.keys"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "data"
            value {
              record {
                a 2
                b 1
                c 3
              }
            }
          }
          {
            let "names"
            value {
              call {
                arguments [
                  {
                    ref "data"
                  }
                ]
                procedure "Standard.Collection.keys"
              }
            }
          }
        ]
        result {
          ref "names"
        }
      }
    }
    warp 1
  }
  test 1
}

