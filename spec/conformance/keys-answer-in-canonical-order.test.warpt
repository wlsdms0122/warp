warpt 1
{
  expect {
    answers [
      "a"
      "b"
      "c"
    ]
  }
  name "keys-answer-in-canonical-order"
  note "A map holds its keys in the key order, so keys answers in that order: text ascending, and a program that walks it gets the same walk on every run."
  program {
    imports [
      "Standard.Collection.keys"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "data"
            value {
              dictionary [
                [
                  "a"
                  2
                ]
                [
                  "b"
                  1
                ]
                [
                  "c"
                  3
                ]
              ]
            }
          }
          {
            let "names"
            value {
              call {
                arguments [
                  {
                    ref "data"
                  }
                ]
                procedure "Standard.Collection.keys"
              }
            }
          }
        ]
        result {
          ref "names"
        }
        returns "Array<String>"
      }
    }
    warp 1
  }
  test 1
}

