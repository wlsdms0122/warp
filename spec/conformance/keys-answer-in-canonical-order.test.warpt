(test 1)
(name "keys-answer-in-canonical-order")
(note "A map holds its keys in the key order, so keys answers in that order: text ascending, and a program that walks it gets the same walk on every run.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (let data (dictionary (entry "a" 2) (entry "b" 1) (entry "c" 3)))
      (let names (call Standard.Collection.keys data))
      (return names))))
(expect (answers (array "a" "b" "c")))
