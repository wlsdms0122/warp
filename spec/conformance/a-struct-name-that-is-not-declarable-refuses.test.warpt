warpt 1
{
  bytes x"574152500109096d792073747275637400"
  expect {
    refuses "load"
  }
  name "a-struct-name-that-is-not-declarable-refuses"
  note "A struct's name is a declared type's spelling, identifiers joined by dots. A name with a space in it is no type's, and the text encoding has no way to write it, so the binary refuses it too."
  test 1
}

