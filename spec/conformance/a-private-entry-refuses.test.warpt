warpt 1
{
  expect {
    refuses "build"
  }
  name "a-private-entry-refuses"
  note "A run starts from outside the link, and a private declaration is named by nothing outside its document. An entry written private is declared and still refused at the build, as what it is rather than as a name nothing declares."
  program {
    imports []
    procedures {
      entry {
        access "private"
        result 1
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

