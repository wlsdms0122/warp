warpt 1
{
  expect {
    refuses "load"
  }
  name "a-parameter-is-not-introduced-again-in-a-nested-body"
  note "A body does not introduce its procedure's parameters again, at any depth. `x` is a parameter of `App.f`, and a `let` taking that spelling inside a block refuses at the load."
  program {
    imports []
    procedures {
      "App.f" {
        body [
          {
            let "y"
            value {
              block {
                body [
                  {
                    let "x"
                    value 2
                  }
                ]
                result {
                  ref "x"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "int"
          }
        ]
        result {
          ref "y"
        }
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              1
            ]
            procedure "App.f"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

