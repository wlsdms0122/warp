(test 1)
(name "a-parameter-is-not-introduced-again-in-a-nested-body")
(note "A body does not introduce its procedure's parameters again, at any depth. `x` is a parameter of `App.f`, and a `let` taking that spelling inside an arm refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type Int))
    (returns Int)
    (body
      (conditional
        (when true)
        (then
          (let x 2))))
    (result x))
  (procedure entry
    (access public)
    (returns Int)
    (result (call App.f 1))))
(expect (refuses load))
