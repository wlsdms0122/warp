warpt 1
{
  arguments {
    ready true
  }
  expect {
    refuses "build"
  }
  name "a-write-only-one-arm-makes-reads-back-nullable"
  note "The run either took the arm or did not, so afterwards the name holds the write or the null it started with. Int?, and a slot declared Int refuses it where names resolve."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            var "kept"
          }
          {
            value {
              conditional {
                then [
                  {
                    set "kept"
                    value 1
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
          {
            let "said"
            value {
              call {
                arguments [
                  {
                    ref "kept"
                  }
                ]
                procedure "wants"
              }
            }
          }
        ]
        parameters [
          {
            name "ready"
            type "Bool"
          }
        ]
      }
      wants {
        parameters [
          {
            name "it"
            type "Int"
          }
        ]
        result true
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

