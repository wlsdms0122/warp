warpt 1
{
  arguments {
    ready true
  }
  expect {
    refuses "build"
  }
  name "a-write-only-one-arm-makes-reads-back-nullable"
  note "The run either took the arm or did not, so afterwards the name holds the write or the null it started with. Int?, and a slot declared int refuses it where names resolve."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            var "kept"
          }
          {
            value {
              conditional {
                then [
                  {
                    set "kept"
                    value 1
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
          {
            let "said"
            value {
              call {
                arguments {
                  it {
                    ref "kept"
                  }
                }
                procedure "wants"
              }
            }
          }
        ]
        parameters {
          ready "bool"
        }
      }
      wants {
        parameters {
          it "int"
        }
        result true
      }
    }
    warp 1
  }
  test 2
}

