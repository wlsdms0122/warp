warpt 1
{
  expect {
    answers null
  }
  name "the-asking-cast-reads-another-name-as-null"
  note "Through `Any` the build cannot see the name, so the asking cast reads it at the run: a name that does not match reads as null, the way a type that does not match does."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "held"
            value {
              as {
                of {
                  struct {
                    balance 1
                  }
                }
                type "Vault"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "held"
              }
            ]
            procedure "read"
          }
        }
        returns "Account?"
      }
      read {
        parameters [
          {
            name "account"
          }
        ]
        result {
          "as?" {
            of {
              ref "account"
            }
            type "Account"
          }
        }
        returns "Account?"
      }
    }
    types {
      Account {
        struct {
          balance "Int"
        }
      }
      Vault {
        struct {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

