warpt 1
{
  expect {
    answers null
  }
  name "the-asking-cast-reads-another-name-as-null"
  note "Through `any` the build cannot see the name, so the asking cast reads it at the run: a name that does not match reads as null, the way a shape that does not match does."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "held"
            value {
              as "Vault"
              of {
                balance 1
              }
            }
          }
        ]
        result {
          call {
            arguments {
              account {
                ref "held"
              }
            }
            procedure "read"
          }
        }
        returns "Account?"
      }
      read {
        parameters {
          account "any"
        }
        result {
          "as?" "Account"
          of {
            ref "account"
          }
        }
        returns "Account?"
      }
    }
    types {
      Account {
        balance "int"
      }
      Vault {
        balance "int"
      }
    }
    warp 1
  }
  test 2
}
