warpt 1
{
  expect {
    answers true
  }
  name "a-write-into-an-element-of-bytes-lands-on-that-element-answers"
  note "Bytes are a list of whole numbers in a compact spelling, so a write through `b[0]` passes through an element of a list as it does for `[1, 2]`, and `b` holds 5 and 2 after it."
  program {
    imports [
      "Standard.Logic.equal"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "Array<Int>"
            value x"0102"
            var "b"
          }
          {
            set "b[0]"
            value 5
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
              [
                5
                2
              ]
            ]
            procedure "Standard.Logic.equal"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

