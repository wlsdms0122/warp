(test 1)
(name "a-constant-of-a-struct-keeps-what-it-was-applied-to-refuses")
(note "A value says nothing of what a struct is applied to, so a constant struct is the struct its expression was judged as. Judged at `App.Box<Int?>`, it does not stand where `App.Box<Int>` is declared, though it holds an `Int`.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (procedure App.listMaybe
      (parameter x (type Int))
      (returns (array (nullable Int)))
      (result (array x)))
    (procedure App.wrapMaybe
      (parameter x (type Int))
      (returns (named App.Box (nullable Int)))
      (result (struct (field item x))))))

(program
  (warp 1)
  (import App.Box)
  (import App.wrapMaybe)
  (const k (call App.wrapMaybe 1))
  (procedure App.need
    (parameter b (type (named App.Box Int)))
    (returns Int)
    (result (path b (field item))))
  (procedure entry
    (access public)
    (returns Int)
    (result (call App.need k))))
(expect (refuses build))
