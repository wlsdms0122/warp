warpt 1
{
  expect {
    answers [
      "0a"
      "1b"
    ]
  }
  name "concurrent-map-offers-item-and-index"
  note "A walking procedure offers names, and the closure's own parameters say which of the offer it reads. The concurrent map offers item and index and answers in the collection's order."
  program {
    imports [
      "std.concurrent.map"
      "std.text.joined"
      "std.text.text"
    ]
    procedures {
      entry {
        body [
          {
            let "tagged"
            value {
              call {
                arguments {
                  by {
                    closure {
                      body [
                        {
                          let "place"
                          value {
                            call {
                              of {
                                ref "index"
                              }
                              procedure "std.text.text"
                            }
                          }
                        }
                      ]
                      parameters {
                        index "int"
                        item "string"
                      }
                      result {
                        call {
                          of [
                            {
                              ref "place"
                            }
                            {
                              ref "item"
                            }
                          ]
                          procedure "std.text.joined"
                        }
                      }
                      returns "string"
                    }
                  }
                }
                of [
                  "a"
                  "b"
                ]
                procedure "std.concurrent.map"
              }
            }
          }
        ]
        result {
          ref "tagged"
        }
      }
    }
    warp 1
  }
  test 2
}
