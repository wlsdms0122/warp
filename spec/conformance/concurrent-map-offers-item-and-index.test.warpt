(test 1)
(name "concurrent-map-offers-item-and-index")
(note "A walking procedure offers names, and the closure's own parameters say which of the offer it reads. The concurrent map offers item and index and answers in the collection's order.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (import Standard.Text.joined)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (isolated)
    (returns (array String))
    (failing concurrent_failed)
    (body
      (let tagged
        (call Standard.Concurrent.map
          (array "a" "b")
          (closure
            (const)
            (isolated)
            (parameter item (type String))
            (parameter index (type Int))
            (returns String)
            (body
              (let place (call Standard.Text.text index))
              (return (call Standard.Text.joined (array place item) ""))))))
      (return tagged))))
(expect (answers (array "0a" "1b")))
