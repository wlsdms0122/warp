warpt 1
{
  expect {
    answers [
      "0a"
      "1b"
    ]
  }
  name "concurrent-map-offers-item-and-index"
  note "A walking procedure offers names, and the closure's own parameters say which of the offer it reads. The concurrent map offers item and index and answers in the collection's order."
  program {
    imports [
      "std.concurrent.map"
      "std.text.joined"
      "std.text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tagged"
            value {
              call {
                arguments [
                  [
                    "a"
                    "b"
                  ]
                  {
                    closure {
                      body [
                        {
                          let "place"
                          value {
                            call {
                              arguments [
                                {
                                  ref "index"
                                }
                              ]
                              procedure "std.text.text"
                            }
                          }
                        }
                      ]
                      parameters [
                        {
                          name "item"
                          type "string"
                        }
                        {
                          name "index"
                          type "int"
                        }
                      ]
                      result {
                        call {
                          arguments [
                            [
                              {
                                ref "place"
                              }
                              {
                                ref "item"
                              }
                            ]
                          ]
                          procedure "std.text.joined"
                        }
                      }
                      returns "string"
                    }
                  }
                ]
                procedure "std.concurrent.map"
              }
            }
          }
        ]
        result {
          ref "tagged"
        }
      }
    }
    warp 1
  }
  test 1
}

