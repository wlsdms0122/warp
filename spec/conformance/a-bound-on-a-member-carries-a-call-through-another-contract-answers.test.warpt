warpt 1
{
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      extensions {
        Int {
          procedures {
            describe {
              access "public"
              parameters [
                {
                  name "of"
                  type "Int"
                }
              ]
              result "one"
              returns "String"
            }
          }
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports []
      warp 1
    }
    {
      imports [
        "App.Describable"
        "App.Describable.describe"
        "Lib.Container"
        "Lib.Container.first"
      ]
      procedures {
        "Use.firstText" {
          access "public"
          body [
            {
              let "x"
              value {
                call {
                  arguments [
                    {
                      ref "c"
                    }
                  ]
                  procedure "Lib.Container.first"
                }
              }
            }
          ]
          bounds {
            C "Lib.Container"
            "C.Item" "App.Describable"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "x"
                }
              ]
              procedure "App.Describable.describe"
            }
          }
          returns "String"
        }
      }
      warp 1
    }
  ]
  expect {
    answers "one"
  }
  name "a-bound-on-a-member-carries-a-call-through-another-contract-answers"
  note "`Use.firstText` bounds `C.Item` by App.Describable, so it calls describe on what `Lib.Container.first` answers."
  program {
    imports [
      "App.Box"
      "Use.firstText"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "Use.firstText"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

