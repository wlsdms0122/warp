warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-value-that-is-dropped-refuses"
  note "A body that reaches its end still holding a value written `linear` has dropped it. That is the whole of what the mark buys, and it is decided before anything runs."
  program {
    imports []
    procedures {
      "App.open" {
        result {
          as {
            of {
              record {
                name "f"
              }
            }
            type "App.Handle"
          }
        }
        returns "App.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
        ]
        result "done"
        returns "String"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

