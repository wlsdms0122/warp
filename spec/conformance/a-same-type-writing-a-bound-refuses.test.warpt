(test 1)
(name "a-same-type-writing-a-bound-refuses")
(note "A same type says what an associated type is and introduces nothing, so a bound beside the `some U` it writes refuses at the load.")

(program
  (warp 1)
  (contract App.Container
    (type Item))
  (procedure App.f
    (parameter c (type (some C App.Container)))
    (parameter u (type (some U)))
    (returns Int)
    (sameType C.Item (some U Hashable))
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
