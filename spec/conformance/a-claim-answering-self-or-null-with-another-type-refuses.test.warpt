(test 1)
(name "a-claim-answering-self-or-null-with-another-type-refuses")
(note "`App.Find.find` answers `Self?`, which the claim about `Int` reads as `Int?`. `Int.find` answers `String?`, which that does not take, so the claim does not hold and refuses at the build, at the claim.")

(program
  (warp 1)
  (contract App.Find
    (procedure find
      (parameter of (type Self))
      (returns (nullable Self))))
  (extension
    (head Int)
    (satisfies App.Find)
    (procedure find
      (parameter of (type Int))
      (returns (nullable String))
      (body
        (return "s"))))
  (procedure entry
    (access public)
    (returns (nullable Int))
    (body
      (return (call App.Find.find 5)))))
(expect (refuses build))
