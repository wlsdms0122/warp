warpt 1
{
  expect {
    refuses "build"
  }
  name "a-claim-answering-self-or-null-with-another-type-refuses"
  note "`App.Find.find` answers `Self?`, which the claim about `Int` reads as `Int?`. `Int.find` answers `String?`, which that does not take, so the claim does not hold and refuses at the build, at the claim."
  program {
    contracts {
      "App.Find" {
        procedures {
          find {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "Self?"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          find {
            parameters [
              {
                name "of"
                type "Int"
              }
            ]
            result "s"
            returns "String?"
          }
        }
        satisfies [
          "App.Find"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              5
            ]
            procedure "App.Find.find"
          }
        }
        returns "Int?"
      }
    }
    warp 1
  }
  test 1
}

