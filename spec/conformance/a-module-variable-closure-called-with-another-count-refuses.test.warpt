(test 1)
(name "a-module-variable-closure-called-with-another-count-refuses")
(note "A module variable that declares no type holds the type its start reads as, and the closure it holds reads as the procedure type its start was judged at. A call handing `f` two arguments where that type takes one refuses at the build.")

(program
  (warp 1)
  (var f
    (closure
      (parameter x (type Int))
      (returns Int)
      (result x)))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let a (apply f 1 2)))
    (result a)))
(expect (refuses build))
