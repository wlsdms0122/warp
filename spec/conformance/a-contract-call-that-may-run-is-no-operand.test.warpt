warpt 1
{
  expect {
    refuses "build"
  }
  name "a-contract-call-that-may-run-is-no-operand"
  note "A contract's procedure writing neither `const` nor `isolated` may run, so a call through it is read the way a call to a declaration that runs is: an operand is read rather than run, and this one is refused at the build."
  program {
    contracts {
      "App.Named" {
        procedures {
          name {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      "App.tell" {
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "it"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                call {
                  arguments [
                    {
                      ref "it"
                    }
                  ]
                  procedure "App.Named.name"
                }
              }
            ]
            procedure "Standard.Text.uppercased"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                as {
                  of {
                    struct {
                      id 1
                    }
                  }
                  type "App.Thing"
                }
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "App.Thing" {
        procedures {
          name {
            parameters [
              {
                name "of"
                type "App.Thing"
              }
            ]
            result "thing"
            returns "String"
          }
        }
        satisfies [
          "App.Named"
        ]
        struct {
          id "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

