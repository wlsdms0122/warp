warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-return-must-fit-what-was-declared"
  note "What a `return` carries is held to the declaration the way a `result` is: the text it carries is no `Int`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              return "three hundred"
            }
          }
        ]
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

