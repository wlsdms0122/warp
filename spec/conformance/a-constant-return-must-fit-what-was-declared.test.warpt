warpt 1
{
  expect {
    refuses "build"
  }
  name "a-constant-return-must-fit-what-was-declared"
  note "What a `return` carries is held to the declaration the way a `result` is. `300` reads `int`, which the range takes as a type, and the declaration still refuses it because the value is not one the range admits."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              return 300
            }
          }
        ]
        returns "int(0...255)"
      }
    }
    warp 1
  }
  test 1
}

