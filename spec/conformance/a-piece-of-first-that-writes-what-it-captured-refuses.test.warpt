warpt 1
{
  expect {
    refuses "build"
  }
  name "a-piece-of-first-that-writes-what-it-captured-refuses"
  note "`Standard.Concurrent.first` takes isolated closures, the same as `all`. A piece that writes a variable it captured is not isolated, and the build refuses it where it is handed over."
  program {
    imports [
      "Standard.Concurrent.first"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "tally"
          }
          {
            value {
              call {
                arguments [
                  {
                    record {
                      one {
                        closure {
                          body [
                            {
                              set "tally"
                              value 1
                            }
                          ]
                          result 1
                        }
                      }
                    }
                  }
                ]
                procedure "Standard.Concurrent.first"
              }
            }
          }
        ]
        result {
          ref "tally"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

