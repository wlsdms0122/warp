warpt 1
{
  expect {
    refuses "build"
  }
  name "a-struct-read-by-a-key-the-run-reads-refuses"
  note "A struct's fields are its type's, so a key the run reads has nothing there to be judged against. `r[k]` on a struct type refuses at the build."
  program {
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "r"
            type "App.A"
          }
          {
            name "k"
            type "String"
          }
        ]
        result {
          ref "r[k]"
        }
        returns "Any"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                struct {
                  a 1
                }
              }
              "a"
            ]
            procedure "App.f"
          }
        }
        returns "Any"
      }
    }
    types {
      "App.A" {
        struct {
          a "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

