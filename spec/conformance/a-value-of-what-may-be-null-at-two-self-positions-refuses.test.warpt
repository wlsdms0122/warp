(test 1)
(name "a-value-of-what-may-be-null-at-two-self-positions-refuses")
(note "A value of what may be null is of the type or of `Null`, and `Self` is one type wherever it stands. `Int` and `Null` both answer `App.Same`, and handing a reading of `Int?` beside an int at `lhs` and `rhs` refuses at the build, since the two may be of two types.")

(program
  (warp 1)
  (contract App.Same
    (procedure same
      (parameter lhs (type Self))
      (parameter rhs (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Same)
    (procedure same
      (parameter lhs (type Int))
      (parameter rhs (type Int))
      (returns String)
      (result "ii")))
  (extension
    (head Null)
    (satisfies App.Same)
    (procedure same
      (parameter lhs (type Null))
      (parameter rhs (type Null))
      (returns String)
      (result "nn")))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let c (type (nullable Int)) null))
    (result (call App.Same.same c 1))))
(expect (refuses build))
