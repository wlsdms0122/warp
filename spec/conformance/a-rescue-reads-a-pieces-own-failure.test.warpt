(test 1)
(name "a-rescue-reads-a-pieces-own-failure")
(note "What concurrent_failed gathers under each piece is the failure that piece raised, a `Failure` like every failure a rescue binds, so a rescue reads a piece's own type through details once a cast says it is one.")

(program
  (warp 1)
  (import Standard.Concurrent.allKeyed)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns (nullable String))
    (failing cast_refused)
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (call Standard.Concurrent.allKeyed
              (dictionary
                (entry "fine"
                  (closure
                    (const)
                    (isolated)
                    (returns String)
                    (result "ok")))
                (entry "fragile"
                  (closure
                    (const)
                    (isolated)
                    (returns Never)
                    (failing aborted)
                    (body
                      (call Standard.Control.abort "on purpose")))))))
          (rescue
            (let failures (as (path caught (field details) (index "failures")) (dictionary String Any)))
            (let piece (as (path failures (index "fragile")) Failure))
            (set tried (path piece (field type)))))))
    (result tried)))
(expect (answers "aborted"))
