warpt 1
{
  expect {
    answers "aborted"
  }
  name "a-rescue-reads-a-pieces-own-failure"
  note "What concurrent_failed gathers under each piece is the envelope that piece raised, so a rescue reads a piece's own type through details, the way it reads any failure's."
  program {
    imports [
      "Standard.Concurrent.allKeyed"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            record {
                              fine {
                                closure {
                                  result "ok"
                                }
                              }
                              fragile {
                                closure {
                                  body [
                                    {
                                      value {
                                        call {
                                          arguments [
                                            "on purpose"
                                          ]
                                          procedure "Standard.Control.abort"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        ]
                        procedure "Standard.Concurrent.allKeyed"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      let "failures"
                      value {
                        as {
                          of {
                            ref "tried.details.failures"
                          }
                          type "Dictionary<Any>"
                        }
                      }
                    }
                    {
                      let "piece"
                      value {
                        as {
                          of {
                            ref "failures.fragile"
                          }
                          type {
                            record {
                              details "Dictionary<Any>"
                              message "String"
                              type "String"
                            }
                          }
                        }
                      }
                    }
                  ]
                  result {
                    ref "piece.type"
                  }
                }
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

