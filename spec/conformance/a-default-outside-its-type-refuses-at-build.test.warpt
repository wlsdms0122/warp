warpt 1
{
  expect {
    refuses "build"
  }
  name "a-default-outside-its-type-refuses-at-build"
  note "A default the parameter's own type would refuse is a refusal waiting for the one call that leans on it. The declaration is judged at the build, where declared type names resolve."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result null
      }
      pick {
        parameters {
          count {
            default "three"
            type "int"
          }
        }
        result {
          ref "count"
        }
      }
    }
    warp 1
  }
  test 1
}

