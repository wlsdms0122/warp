warpt 1
{
  expect {
    refuses "run"
  }
  name "a-parameter-handed-in-place-reads-what-the-box-holds-now"
  note "A parameter handed in place holds the caller's box through the path it was handed, and a read finds what the path holds now. The body shortened the array the path runs through, so the element it names is gone and the read refuses at the run."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                ref "items[1]"
              }
            ]
            procedure "poke"
          }
        }
        returns "int"
      }
      poke {
        body [
          {
            set "items"
            value [
              7
            ]
          }
        ]
        parameters [
          {
            name "second"
            type "inout int"
          }
        ]
        result {
          ref "second"
        }
        returns "int"
      }
    }
    var {
      items [
        1
        2
      ]
    }
    warp 1
  }
  test 1
}

