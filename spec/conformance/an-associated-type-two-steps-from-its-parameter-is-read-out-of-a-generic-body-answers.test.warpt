  name "an-associated-type-two-steps-from-its-parameter-is-read-out-of-a-generic-body-answers"
  note "`Use.deep2` writes no returns and answers the first of the first of c. A box of boxes of Int fills C, so the answer is an Int."
  program {
    imports [
      "App.Box"
      "Use.deep2"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "bb"
            type "App.Box<App.Box<Int>>"
            value {
              struct {
                item {
                  ref "b"
                }
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "bb"
                  }
                ]
                procedure "Use.deep2"
              }
            }
          }
        ]
        result {
          ref "r"
        }
        returns "Any"
