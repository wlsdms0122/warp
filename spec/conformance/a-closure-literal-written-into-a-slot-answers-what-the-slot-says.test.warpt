warpt 1
{
  expect {
    answers "1.0"
  }
  name "a-closure-literal-written-into-a-slot-answers-what-the-slot-says"
  note "`c` declares `() -> Double`, and the closure literal written there writes no `returns`, so it answers what its place says: its literal 1 is the fraction 1.0, and the text of the answer says so."
  program {
    imports [
      "Standard.Text.text"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type "() -> Double"
            value {
              closure {
                result 1
              }
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

