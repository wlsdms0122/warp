(test 1)
(name "an-object-writing-a-row-with-a-field-more-than-its-layout-refuses")
(note "A part is written as its fields in order, and a row has four. A row of `entry` writing a fifth is a writing of something else, and the reading refuses it.")
(object (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"4037d56fccec235930cb114e818ce6bc5617a9254d947496a8f29cfe1eff412c")) (entry "document" (array x"4e397fd69d6c8c4a876ea129f0d76bc74924b3d25abd0aeaaace549c1d53aeba")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Collection.appending") (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 11 (array 0 (array (array 0) (array 1)) (array))) (array 13 0 (array 2)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 1))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 3 "[0]")) (array 1 (array 0) (array) (array) (array "n"))) 0))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 7 0) (array 4) (array 7 2))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
