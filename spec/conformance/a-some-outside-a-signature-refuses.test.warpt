warpt 1
{
  expect {
    refuses "load"
  }
  name "a-some-outside-a-signature-refuses"
  note "A type parameter lives in a signature, where a call fills it, or in a struct listing it under `typeParameters`, where a mention fills it. A struct writing `some T` in a field and listing no `T` has nothing to fill it, and is refused at the load."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result 1
        returns "Int"
      }
    }
    types {
      Box {
        struct {
          item "some T"
        }
      }
    }
    warp 1
  }
  test 1
}

