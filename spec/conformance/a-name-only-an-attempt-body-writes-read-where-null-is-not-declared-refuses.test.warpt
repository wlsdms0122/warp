(test 1)
(name "a-name-only-an-attempt-body-writes-read-where-null-is-not-declared-refuses")
(note "An attempt's body may fail before its write and its rescue writes nothing, so where the two ways meet the write joins with what the name held. After it the name reads `Int?`, and a slot declared `Int` refuses it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (body
      (var kept)
      (attempt
        (body
          (let read (as payload Int))
          (set kept read))
        (rescue
          (let noted 0)))
      (let said (call wants kept))))
  (procedure wants
    (parameter it (type Int))
    (returns Bool)
    (body
      (return true))))
(arguments (argument payload 1))
(expect (refuses build))
