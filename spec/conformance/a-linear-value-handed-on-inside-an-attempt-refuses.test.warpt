warpt 1
{
  expect {
    refuses "build"
  }
  name "a-linear-value-handed-on-inside-an-attempt-refuses"
  note "An attempt's body may fail somewhere the text does not show, so handing on a value written `linear` inside one is not handing it on exactly once. The rescue hands `h` on too, so each way through hands it on once, and the build still refuses the handing inside the attempt."
  program {
    imports [
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "h"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            value {
              attempt {
                body [
                  {
                    let "checked"
                    value {
                      as {
                        of 0
                        type "int(0...255)"
                      }
                    }
                  }
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "h"
                          }
                        ]
                        procedure "App.close"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      value {
                        call {
                          arguments [
                            {
                              ref "h"
                            }
                          ]
                          procedure "App.close"
                        }
                      }
                    }
                  ]
                  result 1
                }
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.look" {
        answers 1
        parameters [
          {
            name "first"
            type "borrowing App.Handle"
          }
        ]
        returns "int"
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

