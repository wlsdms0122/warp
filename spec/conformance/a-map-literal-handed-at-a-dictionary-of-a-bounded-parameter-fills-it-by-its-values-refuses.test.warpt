(test 1)
(name "a-map-literal-handed-at-a-dictionary-of-a-bounded-parameter-fills-it-by-its-values-refuses")
(note "`App.g` bounds `T` by `App.M`, which `Int` and `String` answer, and takes `Dictionary<String, some T>`. The map literal holding `true` under `b` handed there fills `T` with `Bool`, which answers no bound, and the call refuses at the build.")

(program
  (warp 1)
  (contract App.M)
  (extension
    (head Int)
    (satisfies App.M))
  (extension
    (head String)
    (satisfies App.M))
  (procedure App.g
    (parameter x (type (dictionary String (some T App.M))))
    (returns Int)
    (result 0))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let r (call App.g (dictionary (entry "b" true)))))
    (result r)))
(expect (refuses build))
