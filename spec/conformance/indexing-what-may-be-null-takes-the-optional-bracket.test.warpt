warpt 1
{
  expect {
    refuses "link"
  }
  name "indexing-what-may-be-null-takes-the-optional-bracket"
  note "A nullable holds the declared array or null, and a plain index reads an array that is there. Indexing through what may be null takes `?[` — the link refuses the spelling that pretends otherwise."
  program {
    imports []
    procedures {
      entry {
        parameters {
          items {
            default null
            type "array<string>?"
          }
        }
        result {
          ref "items[0]"
        }
      }
    }
    warp 2
  }
  test 1
}
