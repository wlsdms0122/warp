(test 1)
(name "a-value-a-host-procedure-answers-outside-its-returns-refuses")
(note "`App.h` declares it answers `Int` and hands back text. What a host procedure answers is judged against its `returns` at the door it comes through, so the answer refuses at the run there, before anything reads it.")

(vocabulary
  (procedure App.h
    (const)
    (isolated)
    (returns Int)
    (answers "s")))

(program
  (warp 1)
  (import App.h)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (return (call App.h)))))
(expect (refuses run))
