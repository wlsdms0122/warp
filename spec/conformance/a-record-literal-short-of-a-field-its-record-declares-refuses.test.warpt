warpt 1
{
  expect {
    refuses "build"
  }
  name "a-record-literal-short-of-a-field-its-record-declares-refuses"
  note "A record literal is judged against the declared record of its place, exactly the declared fields. `App.P` declares `x` and `y`, and the literal answered where it is declared writes `x` alone, so it refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          record {
            x 1
          }
        }
        returns "App.P"
      }
    }
    types {
      "App.P" {
        record {
          x "Int"
          y "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

