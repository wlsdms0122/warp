(test 1)
(name "an-optional-cast-of-a-closure-over-a-type-parameter-its-making-call-filled-reads-null")
(note "`App.mk` returns a closure taking its own `some T`, and the call of it with 5 fills `T` with `Int`. The closure holds that, so held as `Any` it is a value of `(Int) -> Int`, and `as?` reads it as null at `(Double) -> Int`, since `Int` is not `Double`.")

(program
  (warp 1)
  (import Standard.Numeric)
  (procedure App.mk
    (parameter x (type (some T Standard.Numeric)))
    (returns (procedure (parameters (some T)) (returns Int)))
    (body
      (return
        (closure
          (parameter y (type (some T)))
          (returns Int)
          (body
            (return 0))))))
  (procedure entry
    (access public)
    (returns (optional (procedure (parameters Double) (returns Int))))
    (body
      (let a (type Any) (call App.mk 5))
      (let r (as? a (procedure (parameters Double) (returns Int))))
      (return r))))
(expect (answers null))
