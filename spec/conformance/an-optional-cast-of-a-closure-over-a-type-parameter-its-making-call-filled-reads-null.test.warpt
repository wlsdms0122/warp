(test 1)
(name "an-optional-cast-of-a-closure-over-a-type-parameter-its-making-call-filled-reads-null")
(note "`App.mk` answers a closure taking its own `some T`, which only the call that made it fills, and `a` holds it as `Any`. The closure is a value of no procedure type here, so `as?` reads it as null.")

(program
  (warp 1)
  (import Standard.Numeric)
  (procedure App.mk
    (parameter x (type (some T Standard.Numeric)))
    (returns (procedure (parameters (some T)) (returns Int)))
    (result
      (closure
        (parameter y (type (some T)))
        (returns Int)
        (result 0))))
  (procedure entry
    (access public)
    (returns (nullable (procedure (parameters Double) (returns Int))))
    (body
      (let a (type Any) (call App.mk 5))
      (let r (as? a (procedure (parameters Double) (returns Int)))))
    (result r)))
(expect (answers null))
