(test 1)
(name "an-empty-name-refuses")
(note "A name is written: a statement is called something, and nothing written is no name. A statement bound to the empty name is refused where the document is read.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "") (entry "value" 1)) (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
