warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          procedures {
            describe {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "String"
            }
          }
        }
      }
      imports []
      warp 1
    }
    {
      imports [
        "App.Describable"
      ]
      types {
        "App.Card" {
          satisfies [
            "App.Describable"
          ]
          struct {
            rank "Int"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "build"
  }
  name "a-claim-whose-member-a-document-it-does-not-stand-on-gives-refuses"
  note "App.Card claims App.Describable where it is declared, and the member `describe` is given in the program, which stands on that document and not the other way round. A claim is held to the members within what its own document stands on, so it refuses at the build."
  program {
    extensions {
      "App.Card" {
        procedures {
          describe {
            access "public"
            parameters [
              {
                name "of"
                type "App.Card"
              }
            ]
            result "card"
            returns "String"
          }
        }
      }
    }
    imports [
      "App.Card"
      "App.Describable.describe"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    rank 1
                  }
                }
                type "App.Card"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "card"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

