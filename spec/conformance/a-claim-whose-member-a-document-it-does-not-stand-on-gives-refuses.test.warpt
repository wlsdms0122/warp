(test 1)
(name "a-claim-whose-member-a-document-it-does-not-stand-on-gives-refuses")
(note "App.Card claims App.Describable where it is declared, and the member `describe` is given in the program, which stands on that document and not the other way round. A claim is held to the members within what its own document stands on, so it refuses at the build.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (import App.Describable)
    (struct App.Card
      (satisfies App.Describable)
      (field rank Int))))

(program
  (warp 1)
  (import App.Card)
  (import App.Describable.describe)
  (extension
    (head App.Card)
    (procedure describe
      (access public)
      (parameter of (type App.Card))
      (returns String)
      (result "card")))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let card (as (struct (field rank 1)) App.Card)))
    (result (call App.Describable.describe card))))
(expect (refuses build))
