warpt 1
{
  expect {
    answers 1
  }
  name "a-record-literal-holding-a-closure-handed-at-a-bounded-parameter-answers"
  note "`App.f` bounds `T` by `App.M`, which `Int` and `String` answer, and takes a record whose field `g` is a procedure taking `some T`. A record literal handed there holds a closure taking `Int`, and `x` fills `T` with `Int`. Only the parts standing at the parameter are held to the bounds, and a closure is judged as any closure handed to its procedure type is, so it builds and answers 1."
  program {
    contracts {
      "App.M" {}
    }
    imports []
    procedures {
      "App.f" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "r"
            type {
              record {
                e "Array<Int>"
                g {
                  procedure {
                    parameters [
                      "some T"
                    ]
                    returns "Int"
                  }
                }
              }
            }
          }
          {
            name "x"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "x"
              }
            ]
            procedure {
              ref "r.g"
            }
          }
        }
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    record {
                      e []
                      g {
                        closure {
                          parameters [
                            {
                              name "n"
                              type "Int"
                            }
                          ]
                          result {
                            ref "n"
                          }
                          returns "Int"
                        }
                      }
                    }
                  }
                  1
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    satisfies {
      Int [
        "App.M"
      ]
      String [
        "App.M"
      ]
    }
    warp 1
  }
  test 1
}

