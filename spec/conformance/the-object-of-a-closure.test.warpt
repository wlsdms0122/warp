(test 1)
(name "the-object-of-a-closure")
(note "A closure literal is lifted into a row of its own behind the declarations, spelled by the numbering as the first closure entry wrote, and the literal names that number and which outer slot fills which inner slot.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter n (type Int))
    (returns Int)
    (failing (anything))
    (body
      (let held
        (closure
          (const)
          (isolated)
          (returns Int)
          (body
            (return n))))
      (let got (apply held))
      (return got))))
(expect (builds (dictionary (entry "addressTable" (array (array 1 (array)) (array 2 (array)) (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"dbfdf8cb54a693d3ebd111a19130ff12d81b92a8662fa01f80d85e99c5e8e67b")) (entry "importedClaims" (array)) (entry "lifted" (array (array (array (array) 2 (array 1 (array)) 1 1 (array) (array)) 0 (array 0 (array (array (array) 6 "[0]")) (array 1 (array) (array) (array 0) (array "n")))))) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array (array (array 0 "entry") 1)))) (entry "object" 1) (entry "operationTable" (array (array 4 1 (array (array 0 0))) (array 1 0) (array 5 1 (array)) (array 1 1) (array 13 0 (array) (array 3)) (array 1 2) (array 13 0 (array) (array 5)))) (entry "rows" (array (array "entry" (array (array (array "n" (array 0))) 1 (array 0) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 0 1)) 0 "held") (array (array (array 0 2)) 2 "got") (array (array) 4 "[2]")) (array 3 (array 0) (array) (array) (array "n" "held" "got")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4) (array 4))) (entry "types" (array)) (entry "valueTable" (array)) (entry "variables" (array)))))
