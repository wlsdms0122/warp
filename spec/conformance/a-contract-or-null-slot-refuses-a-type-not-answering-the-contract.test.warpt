warpt 1
{
  expect {
    refuses "build"
  }
  name "a-contract-or-null-slot-refuses-a-type-not-answering-the-contract"
  note "App.f takes App.Sized? and is handed a Bank.Coin, which no document says answers App.Sized."
  program {
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized?"
          }
        ]
        result "took"
        returns "string"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    cents 4
                  }
                }
                type "Bank.Coin"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Box" {
        record {
          n "int"
        }
      }
      "Bank.Card" {
        record {
          last "string"
        }
      }
      "Bank.Coin" {
        record {
          cents "int"
        }
      }
    }
    warp 1
  }
  test 1
}

