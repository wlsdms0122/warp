(test 1)
(name "a-write-at-a-constant-index-below-zero-refuses")
(note "`K` settles to -1, a whole number below zero, which is no position in any list, so `set d[K]` refuses at the build.")

(program
  (warp 1)
  (const K -1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var d (type (array Int)) (array 1))
      (set (path d (index K)) 2))
    (result (path d (index 0)))))
(expect (refuses build))
