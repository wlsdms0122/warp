warpt 1
{
  expect {
    reads {
      a [
        1
        true
      ]
      b 2
      c {}
    }
  }
  name "a-text-reads-in-any-layout"
  note "Layout is free on the way in: keys in any order, any whitespace between tokens, any indentation. A text written by a person reads as the same value the writer would have laid out."
  test 5
  text "warpt 1\n{ b 2\n\n\ta [ 1\n true ]   c {} }\n"
}

