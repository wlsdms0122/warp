(test 1)
(name "a-fixed-name-cannot-be-written")
(note "`let` fixes the name. Written once, never again. Writing it needs `var` to have introduced it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let x 1)
      (set x 2))
    (result x)))
(expect (refuses load))
