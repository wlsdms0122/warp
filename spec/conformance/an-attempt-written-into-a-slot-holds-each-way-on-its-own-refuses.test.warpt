warpt 1
{
  expect {
    refuses "build"
  }
  name "an-attempt-written-into-a-slot-holds-each-way-on-its-own-refuses"
  note "An int variable is set to an attempt whose body answers an int and whose rescue a string. Each way writes its own answer, so the rescue's string refuses at the build as a `set` of it inside the rescue would."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "int"
            value 0
            var "x"
          }
          {
            set "x"
            value {
              attempt {
                body [
                  {
                    value {
                      conditional {
                        then [
                          {
                            value {
                              call {
                                arguments [
                                  "x"
                                ]
                                procedure "Standard.Control.abort"
                              }
                            }
                          }
                        ]
                        when false
                      }
                    }
                  }
                ]
                rescue {
                  result "s"
                }
                result 1
              }
            }
          }
        ]
        result {
          ref "x"
        }
      }
    }
    warp 1
  }
  test 1
}

