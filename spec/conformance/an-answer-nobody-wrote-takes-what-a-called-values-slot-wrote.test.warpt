warpt 1
{
  expect {
    refuses "build"
  }
  name "an-answer-nobody-wrote-takes-what-a-called-values-slot-wrote"
  note "A declaration with no `returns` answers what its body hands back, read the way a call site reads it. A body answering a call of a value answers what the slot holding it wrote after `->`, so a caller holding that to another type is refused at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              {
                closure {
                  result 1
                  returns "Int"
                }
              }
            ]
            procedure "through"
          }
        }
        returns "String"
      }
      through {
        parameters [
          {
            name "body"
            type "() -> Int"
          }
        ]
        result {
          call {
            procedure {
              ref "body"
            }
          }
        }
      }
    }
    warp 1
  }
  test 1
}

