(test 1)
(name "a-round-ending-in-continue-refuses")
(note "A `continue` ending a round goes where the round goes on its own, so one program would have two texts, and it refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let walk
        (loop
          (while false)
          (body
            (continue)))))
    (result 1)))
(expect (refuses load))
