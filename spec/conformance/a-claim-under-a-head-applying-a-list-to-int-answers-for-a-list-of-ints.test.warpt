warpt 1
{
  expect {
    answers "ints"
  }
  name "a-claim-under-a-head-applying-a-list-to-int-answers-for-a-list-of-ints"
  note "The extension of `Array<Int>` is about every list of integers, so a list of them answers App.Describable through the member it gives."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
    }
    extensions {
      "Array<Int>" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Array<Int>"
              }
            ]
            result "ints"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "b"
            type "Array<Int>"
            value [
              1
              2
            ]
          }
        ]
        result {
          call {
            arguments [
              {
                ref "b"
              }
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

