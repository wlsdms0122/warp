(test 1)
(name "a-struct-literal-returned-where-a-declared-struct-is-returned-takes-the-name")
(note "A declared struct is nominal. A struct literal written where the type is read, here the return value of a declaration writing `returns Bank.Account`, is judged field by field and takes the name; the return value is written with it.")

(program
  (warp 1)
  (struct Bank.Account
    (field balance Int))
  (procedure entry
    (access public)
    (returns Bank.Account)
    (body
      (return (struct (field balance 1))))))
(expect (answers (struct Bank.Account (field balance 1))))
