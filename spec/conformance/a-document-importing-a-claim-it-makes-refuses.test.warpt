(test 1)
(name "a-document-importing-a-claim-it-makes-refuses")
(note "A document stands on its own claims, so one writing a claim it makes among its imports refuses at the load.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String)))))

(program
  (warp 1)
  (import App.Describable)
  (import App.Describable.describe)
  (import T.Card App.Describable)
  (struct T.Card
    (satisfies App.Describable)
    (field rank Int)
    (procedure describe
      (parameter of (type T.Card))
      (returns String)
      (body
        (return "card"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let card (as (struct (field rank 1)) T.Card))
      (return (call App.Describable.describe card)))))
(expect (refuses load))
