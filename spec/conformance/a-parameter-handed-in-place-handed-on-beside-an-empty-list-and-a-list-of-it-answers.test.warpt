(test 1)
(name "a-parameter-handed-in-place-handed-on-beside-an-empty-list-and-a-list-of-it-answers")
(note "App.g hands xs, a list of lists of T handed in place, on to App.put beside [[], [x]], where x is its own some T. The empty list holds no element, so the literal is a value of Array<Array<some T>>, and the caller reads both lists.")

(program
  (warp 1)
  (procedure App.g
    (parameter xs (type (inout (array (array (some T))))))
    (parameter x (type (some T)))
    (returns Int)
    (body
      (call App.put xs (array (array) (array x)))
      (return 0)))
  (procedure App.put
    (parameter a (type (inout (some U))))
    (parameter b (type (some U)))
    (returns Int)
    (body
      (set a b)
      (return 0)))
  (procedure entry
    (access public)
    (returns (array (array String)))
    (body
      (var s (array (array "a")))
      (call App.g s "b")
      (return s))))
(expect (answers (array (array) (array "b"))))
