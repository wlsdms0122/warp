(test 1)
(name "a-declaration-answering-a-contract-fills-its-own-parameter-with-the-contracts")
(note "The contract takes some T and answers some T. The declaration answering it takes and answers some U, its own parameter, which the contract's T fills, so it answers what the contract promises.")

(program
  (warp 1)
  (struct Bank.Card
    (satisfies App.Sized)
    (field last String)
    (procedure size
      (parameter of (type Bank.Card))
      (parameter n (type (some U)))
      (returns (some U))
      (body
        (return n))))
  (contract App.Sized
    (procedure size
      (parameter of (type Self))
      (parameter n (type (some T)))
      (returns (some T))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let c (as (struct (field last "42")) Bank.Card))
      (let s (call App.Sized.size c "x"))
      (return s))))
(expect (answers "x"))
