warpt 1
{
  expect {
    answers "x"
  }
  name "a-declaration-answering-a-contract-fills-its-own-parameter-with-the-contracts"
  note "The contract takes some T and answers some T. The declaration answering it takes and answers some U, its own parameter, which the contract's T fills, so it answers what the contract promises."
  program {
    contracts {
      "app.Sized" {
        size {
          parameters [
            {
              name "of"
              type "app.Sized"
            }
            {
              name "n"
              type "some T"
            }
          ]
          returns "some T"
        }
      }
    }
    imports []
    procedures {
      "bank.Card.size" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
          {
            name "n"
            type "some U"
          }
        ]
        result {
          ref "n"
        }
        returns "some U"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  "x"
                ]
                procedure "app.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "bank.Card" [
        "app.Sized"
      ]
    }
    types {
      "bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

