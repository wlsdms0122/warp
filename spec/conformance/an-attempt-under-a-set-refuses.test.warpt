(test 1)
(name "an-attempt-under-a-set-refuses")
(note "An attempt answers nothing, so a `set` of one has nothing to write. What either of its ways keeps it writes to an outer variable.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (body
      (var r 5)
      (set r
        (attempt
          (body
            (call Standard.Control.abort "stop"))
          (rescue
            (let noted 1)))))))
(expect (refuses load))
