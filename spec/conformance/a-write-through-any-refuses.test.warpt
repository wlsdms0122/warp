warpt 1
{
  expect {
    refuses "build"
  }
  name "a-write-through-any-refuses"
  note "A write's path is judged against the type it reaches, and `Any` declares nothing to write into. `set x.a` on a variable declared `Any` refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "Any"
            value {
              dictionary [
                [
                  "a"
                  1
                ]
              ]
            }
            var "x"
          }
          {
            set "x.a"
            value 2
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

