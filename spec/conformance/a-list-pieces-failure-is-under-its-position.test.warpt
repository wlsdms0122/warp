(test 1)
(name "a-list-pieces-failure-is-under-its-position")
(note "concurrent_failed holds a list piece's failure under the piece's position, a whole number, the way a map piece's stands under its key, so a rescue reads the failures as a map keyed by Int.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (import Standard.Concurrent.all)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns (array Int))
    (failing cast_refused)
    (body
      (var tried)
      (let caught
        (attempt
          (body
            (call Standard.Concurrent.all
              (array
                (closure
                  (const)
                  (isolated)
                  (returns String)
                  (body
                    (return "ok")))
                (closure
                  (const)
                  (isolated)
                  (returns Never)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "on purpose")))))
            (set tried (array)))
          (rescue
            (let failures (as (path caught (field details) (index "failures")) (dictionary Int Any)))
            (set tried (call Standard.Collection.keys failures)))))
      (return tried))))
(expect (answers (array 1)))
