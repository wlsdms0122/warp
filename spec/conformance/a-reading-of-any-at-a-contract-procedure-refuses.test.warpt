(test 1)
(name "a-reading-of-any-at-a-contract-procedure-refuses")
(note "`App.anything` answers `Any`, and the call hands it at `Self`, where `App.Described.describe` asks the contract. A reading of `Any` stands where a contract is asked only through a cast, so the build refuses, whatever the run would hand there.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a whole number"))))
  (procedure App.anything
    (returns Any)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call App.Described.describe (call App.anything))))))
(expect (refuses build))
