warpt 1
{
  expect {
    answers "took"
  }
  name "a-contract-or-null-slot-takes-a-parameter-bounded-by-the-contract-and-a-membership"
  note "App.g hands its some T, bounded by App.Maybe & App.Sized, to App.f, which takes App.Sized?. T answers App.Sized by its bound, whatever member of App.Maybe fills it."
  program {
    constraints {
      "App.Maybe" [
        "Bank.Card"
        "Bank.Coin"
      ]
    }
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "n"
            type "App.Sized?"
          }
        ]
        result "took"
        returns "String"
      }
      "App.g" {
        body [
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "m"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        bounds {
          T "App.Maybe & App.Sized"
        }
        parameters [
          {
            name "m"
            type "some T"
          }
        ]
        result {
          ref "s"
        }
        returns "String"
      }
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result 4
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
      "Bank.Coin" {
        record {
          cents "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

