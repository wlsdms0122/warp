warpt 1
{
  expect {
    refuses "load"
  }
  name "a-range-with-nothing-after-the-open-edge-refuses"
  note "`..<` leaves the far bound outside the range, so something has to stand after it. `Int(0..<)` names no far bound and is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "item"
            type "Int(0..<)"
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

