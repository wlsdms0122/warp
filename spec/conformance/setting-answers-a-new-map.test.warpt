(test 1)
(name "setting-answers-a-new-map")
(note "setting answers a map with the entry written, and a new map: the one it was given still holds what it held.")

(program
  (warp 1)
  (import Standard.Collection.setting)
  (procedure entry
    (access public)
    (returns (array (dictionary String Int)))
    (body
      (let data (dictionary (entry "a" 1)))
      (let grown (call Standard.Collection.setting data "b" 2)))
    (result (array grown data))))
(expect (answers (array (dictionary (entry "a" 1) (entry "b" 2)) (dictionary (entry "a" 1)))))
