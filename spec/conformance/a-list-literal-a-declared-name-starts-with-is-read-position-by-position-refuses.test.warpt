(test 1)
(name "a-list-literal-a-declared-name-starts-with-is-read-position-by-position-refuses")
(note "ys declares Array<Dictionary<String, Array<String>>> and starts as a list of two map literals, one holding `[]` under `a` and one holding `[1]`. The start value is held to the declaration as a later write is, its elements joined position by position, so the map whose `a` holds a number refuses at the build.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var ys (type (array (dictionary String (array String)))) (array (dictionary (entry "a" (array))) (dictionary (entry "a" (array 1)))))
      (let n (call Standard.Collection.count ys))
      (return n))))
(expect (refuses build))
