warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-a-membership-where-it-writes-a-list-of-a-parameter-refuses"
  note "The contract takes a list of some T, its own parameter bounded by nothing, and the declaration answering it takes App.Lists there. Nothing about T proves a list of it is a list of ints or of doubles, so a call through the contract handing a list of strings would reach a slot that refuses it."
  program {
    constraints {
      "App.Lists" [
        "Array<Int>"
        "Array<Double>"
      ]
    }
    contracts {
      "App.Sized" {
        size {
          parameters [
            {
              name "of"
              type "App.Sized"
            }
            {
              name "n"
              type "Array<some T>"
            }
          ]
          returns "Int"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.size" {
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
          {
            name "n"
            type "App.Lists"
          }
        ]
        result 7
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  [
                    "x"
                  ]
                ]
                procedure "App.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Sized"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

