warpt 1
{
  expect {
    refuses "build"
  }
  name "a-declaration-answering-a-contract-with-a-membership-where-it-writes-a-parameter-refuses"
  note "The contract takes some T, its own parameter bounded by nothing, and the declaration answering it takes app.Num there. Nothing about T proves it is a member, so a call through the contract handing a string would reach a slot that refuses it."
  program {
    constraints {
      "app.Num" [
        "int"
        "double"
      ]
    }
    contracts {
      "app.Sized" {
        size {
          parameters [
            {
              name "of"
              type "app.Sized"
            }
            {
              name "n"
              type "some T"
            }
          ]
          returns "int"
        }
      }
    }
    imports []
    procedures {
      "bank.Card.size" {
        parameters [
          {
            name "of"
            type "bank.Card"
          }
          {
            name "n"
            type "app.Num"
          }
        ]
        result 7
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "42"
                  }
                }
                type "bank.Card"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  "x"
                ]
                procedure "app.Sized.size"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    satisfies {
      "bank.Card" [
        "app.Sized"
      ]
    }
    types {
      "bank.Card" {
        record {
          last "string"
        }
      }
    }
    warp 1
  }
  test 1
}

