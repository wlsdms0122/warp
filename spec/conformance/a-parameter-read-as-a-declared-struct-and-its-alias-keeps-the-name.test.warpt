warpt 1
{
  expect {
    answers "a card"
  }
  name "a-parameter-read-as-a-declared-struct-and-its-alias-keeps-the-name"
  note "`Bank.Alias` names `Bank.Card`, a declared struct that answers `App.Describable`. `App.pick` takes two of `some T` and is handed a `Bank.Card` and a `Bank.Alias`. The two are one struct under one name, so `T` is that struct and keeps its name, and `App.Describable.describe` dispatches to `Bank.Card.describe`."
  program {
    contracts {
      "App.Describable" {
        describe {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.pick" {
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return {
                        ref "x"
                      }
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "c"
            type "Bool"
          }
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  struct {
                    last "1"
                  }
                }
                type "Bank.Alias"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  false
                  {
                    as {
                      of {
                        struct {
                          last "42"
                        }
                      }
                      type "Bank.Card"
                    }
                  }
                  {
                    ref "c"
                  }
                ]
                procedure "App.pick"
              }
            }
          }
          {
            let "s"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "App.Describable.describe"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    types {
      "Bank.Alias" "Bank.Card"
      "Bank.Card" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Bank.Card"
              }
            ]
            result "a card"
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

