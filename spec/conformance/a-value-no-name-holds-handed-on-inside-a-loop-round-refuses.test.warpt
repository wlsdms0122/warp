warpt 1
{
  expect {
    refuses "build"
  }
  name "a-value-no-name-holds-handed-on-inside-a-loop-round-refuses"
  note "Handing one on inside a loop round refuses whether a name holds it or not: `App.close` takes what `App.mkq` answers, inside the round."
  program {
    imports [
      "App.close"
      "App.mkq"
    ]
    procedures {
      "App.f" {
        body [
          {
            value {
              loop {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            call {
                              procedure "App.mkq"
                            }
                          }
                        ]
                        procedure "App.close"
                      }
                    }
                  }
                  {
                    value {
                      break null
                    }
                  }
                ]
                while true
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.f"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.mkq" {
        answers {
          name "h"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

