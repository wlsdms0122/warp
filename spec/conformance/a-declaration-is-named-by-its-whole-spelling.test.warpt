warpt 1
{
  expect {
    answers 7
  }
  name "a-declaration-is-named-by-its-whole-spelling"
  note "The key a document declares a procedure under is its whole name, dot included. The send writes `wallet.fee` inside the declaring document too, and a word the document declares is not one it imports."
  program {
    imports []
    procedures {
      entry {
        result {
          call {
            procedure "wallet.fee"
          }
        }
        returns "int"
      }
      "wallet.fee" {
        result 7
        returns "int"
      }
    }
    warp 1
  }
  test 1
}
