warpt 1
{
  expect {
    answers 1
  }
  name "a-contract-procedure-taking-a-procedure-that-names-its-failures-is-backed-by-a-declaration-calling-it"
  note "A procedure type names what it may fail with, the way a contract's procedure does. `run` takes `step`, whose type may fail with `aborted`, and `Int.run` calls it: a call of a value fails with what the slot it came out of names, so `Int.run` may fail with `aborted`, which `run` lets it, and the claim holds."
  program {
    contracts {
      "App.Runner" {
        procedures {
          run {
            failing [
              "aborted"
            ]
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "step"
                type "const (Int) throws(aborted) -> Int"
              }
            ]
            returns "Int"
          }
        }
      }
    }
    extensions {
      Int {
        procedures {
          run {
            const true
            failing [
              "aborted"
            ]
            parameters [
              {
                name "of"
                type "Int"
              }
              {
                name "step"
                type "const (Int) throws(aborted) -> Int"
              }
            ]
            result {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure {
                  ref "step"
                }
              }
            }
            returns "Int"
          }
        }
        satisfies [
          "App.Runner"
        ]
      }
    }
    imports []
    procedures {
      entry {
        access "public"
        failing [
          "aborted"
        ]
        result {
          call {
            arguments [
              1
              {
                closure {
                  const true
                  isolated true
                  parameters [
                    {
                      name "x"
                      type "Int"
                    }
                  ]
                  result {
                    ref "x"
                  }
                  returns "Int"
                }
              }
            ]
            procedure "App.Runner.run"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

