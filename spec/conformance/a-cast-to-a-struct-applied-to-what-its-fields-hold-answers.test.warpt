warpt 1
{
  expect {
    answers 1
  }
  name "a-cast-to-a-struct-applied-to-what-its-fields-hold-answers"
  note "A value carries a struct's name and its fields and nothing of what it was applied to. A cast to `App.Box<Int>` judges the fields against `Int`, which they hold."
  program {
    imports []
    procedures {
      "App.hide" {
        parameters [
          {
            name "v"
          }
        ]
        result {
          ref "v"
        }
      }
      entry {
        access "public"
        body [
          {
            let "b"
            type "App.Box<Int>"
            value {
              struct {
                item 1
              }
            }
          }
          {
            let "any"
            value {
              call {
                arguments [
                  {
                    ref "b"
                  }
                ]
                procedure "App.hide"
              }
            }
          }
          {
            let "c"
            value {
              as {
                of {
                  ref "any"
                }
                type "App.Box<Int>"
              }
            }
          }
        ]
        result {
          ref "c.item"
        }
        returns "Int"
      }
    }
    types {
      "App.Box" {
        struct {
          item "some T"
        }
        typeParameters [
          "T"
        ]
      }
    }
    warp 1
  }
  test 1
}

