warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-written-at-a-slot-answering-a-declared-struct-names-its-answer-answers"
  note "`c` is declared `{ procedure: { returns: Bank.A } }`, and the closure written there writes no `returns`, so it answers what the place it is written into says. The struct literal `{ k: \"x\" }` it answers is a literal written where `Bank.A` is read, and takes the name, so `v` is a `Bank.A` and `App.P.show`, which `Bank.A` answers, is sent to it."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  struct {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "v"
            value {
              call {
                procedure {
                  ref "c"
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "Bank.A" {
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

