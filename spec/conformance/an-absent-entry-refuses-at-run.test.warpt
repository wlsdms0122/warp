warpt 1
{
  arguments {
    data {}
  }
  expect {
    refuses "run"
  }
  name "an-absent-entry-refuses-at-run"
  note "An object's entries are data, so which names are there is a run's fact. The plain dot promises the entry is there — an absent one refuses rather than inventing a null nobody wrote."
  program {
    needs []
    procedures {
      entry {
        parameters {
          data "object<any>"
        }
        result {
          ref "data.missing"
        }
      }
    }
    warp 1
  }
  test 1
}
