(test 1)
(name "a-variable-of-another-type-is-not-handed-in-place-to-a-called-value")
(note "A value taking a parameter in place takes the caller's own box, so the variable's declared type is the parameter's: a `Double` where `inout Int` stands refuses at the build.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Double)
    (failing (anything))
    (body
      (var n (type Double) 10.0)
      (let bump
        (closure
          (parameter count (type (inout Int)))
          (body
            (set count (call Standard.Numeric.plus count 1)))))
      (apply bump n))
    (result n)))
(expect (refuses build))
