warpt 1
{
  expect {
    answers 7
  }
  name "a-module-declares-a-contract-a-bound-names"
  note "A module declares a contract and says which types answer it: a slot writes only the parameter, the signature binds it in bounds, and the judgement a bounded parameter gets is the same one the standard procedures get."
  program {
    contracts {
      Scalar {}
    }
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              7
            ]
            procedure "keep"
          }
        }
        returns "Int"
      }
      keep {
        bounds {
          T "Scalar"
        }
        parameters [
          {
            name "value"
            type "some T"
          }
        ]
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    satisfies {
      Int [
        "Scalar"
      ]
      String [
        "Scalar"
      ]
    }
    warp 1
  }
  test 1
}

