warpt 1
{
  documents [
    {
      contracts {
        "app.Describable" {
          describe {
            parameters [
              {
                name "of"
                type "app.Describable"
              }
            ]
            returns "string"
          }
        }
      }
      imports []
      procedures {
        "app.nothing" {
          result null
        }
      }
      warp 1
    }
    {
      imports []
      procedures {
        "t.nothing" {
          result null
        }
      }
      types {
        "t.Card" {
          rank "int"
        }
      }
      warp 1
    }
    {
      imports [
        "app.Describable"
        "t.Card"
      ]
      procedures {
        "c.nothing" {
          result null
        }
      }
      satisfies {
        "t.Card" [
          "app.Describable"
        ]
      }
      warp 1
    }
  ]
  expect {
    answers 3
  }
  name "a-claim-nobody-leans-on-refuses-nowhere"
  note "A claim missing a procedure puts its type under no contract, and that is refused only where a call leaned on the pair. A program beside such a claim that never asks the contract of the type builds and runs."
  program {
    imports [
      "t.Card"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as "t.Card"
              of {
                rank 3
              }
            }
          }
        ]
        result {
          ref "card.rank"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

