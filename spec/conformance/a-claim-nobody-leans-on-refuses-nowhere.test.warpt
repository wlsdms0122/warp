warpt 1
{
  documents [
    {
      contracts {
        "App.Describable" {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
            ]
            returns "String"
          }
        }
      }
      imports []
      warp 1
    }
    {
      imports []
      types {
        "T.Card" {
          struct {
            rank "Int"
          }
        }
      }
      warp 1
    }
    {
      extensions {
        "T.Card" {
          satisfies [
            "App.Describable"
          ]
        }
      }
      imports [
        "App.Describable"
        "T.Card"
      ]
      warp 1
    }
  ]
  expect {
    answers 3
  }
  name "a-claim-nobody-leans-on-refuses-nowhere"
  note "A claim missing a procedure puts its type under no contract, and that is refused only where a call leaned on the pair. A program beside such a claim that never asks the contract of the type builds and runs."
  program {
    imports [
      "T.Card"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "card"
            value {
              as {
                of {
                  struct {
                    rank 3
                  }
                }
                type "T.Card"
              }
            }
          }
        ]
        result {
          ref "card.rank"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

