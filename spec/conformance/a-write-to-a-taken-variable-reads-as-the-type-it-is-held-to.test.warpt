warpt 1
{
  arguments {
    c false
  }
  expect {
    answers 6
  }
  name "a-write-to-a-taken-variable-reads-as-the-type-it-is-held-to"
  note "One arm lets a closure capture an Int variable and the other writes null into it, so after the conditional it is held to Int and reads Int?. Writing an int into it leaves it reading Int, and it is handed in place to an Int slot."
  program {
    imports [
      "Standard.Collection.append"
      "Standard.Numeric.plus"
    ]
    procedures {
      "App.bump" {
        body [
          {
            set "c"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                  1
                ]
                procedure "Standard.Numeric.plus"
              }
            }
          }
        ]
        isolated true
        parameters [
          {
            name "c"
            type "inout Int"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            value 0
            var "x"
          }
          {
            type "Array<const isolated () -> Int>"
            value []
            var "fs"
          }
          {
            value {
              conditional {
                else [
                  {
                    set "x"
                    value null
                  }
                ]
                then [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "fs"
                          }
                          {
                            closure {
                              const true
                              isolated true
                              result {
                                ref "x"
                              }
                              returns "Int"
                            }
                          }
                        ]
                        procedure "Standard.Collection.append"
                      }
                    }
                  }
                ]
                when {
                  ref "c"
                }
              }
            }
          }
          {
            set "x"
            value 5
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "x"
                  }
                ]
                procedure "App.bump"
              }
            }
          }
        ]
        isolated true
        parameters [
          {
            name "c"
            type "Bool"
          }
        ]
        result {
          ref "x"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

