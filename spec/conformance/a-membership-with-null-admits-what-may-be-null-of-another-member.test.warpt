warpt 1
{
  expect {
    answers 1
  }
  name "a-membership-with-null-admits-what-may-be-null-of-another-member"
  note "App.MaybeNum admits int and null, and App.f takes it. A reading of int? is an int or null, each a member."
  program {
    constraints {
      "App.MaybeNum" [
        "int"
        "null"
      ]
    }
    imports []
    procedures {
      "App.f" {
        parameters [
          {
            name "x"
            type "App.MaybeNum"
          }
        ]
        result 1
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            type "int?"
            var "n"
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure "App.f"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

