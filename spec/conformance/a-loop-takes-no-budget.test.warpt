warpt 1
{
  expect {
    refuses "load"
  }
  name "a-loop-takes-no-budget"
  note "A loop takes `while`, `body` and `result` and nothing else. A `guard` beside them is a key the grammar does not name, and the loop refuses at the load; bounding a loop is a counter in its condition."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "gate"
            value {
              loop {
                body [
                  {
                    let "noop"
                    value 1
                  }
                ]
                guard 2
                while false
              }
            }
          }
        ]
      }
    }
    warp 1
  }
  test 1
}

