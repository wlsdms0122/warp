warpt 1
{
  arguments {
    xs []
  }
  expect {
    answers [
      1
      "a"
    ]
  }
  name "a-type-parameter-read-as-any-and-as-a-type-holds-any"
  note "Two readings of one type parameter where one accepts the other join to the looser. `Any` accepts everything, so a list of anything takes a number and then a text."
  program {
    imports [
      "Standard.Collection.appending"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "one"
            value {
              call {
                arguments [
                  {
                    ref "xs"
                  }
                  1
                ]
                procedure "Standard.Collection.appending"
              }
            }
          }
        ]
        parameters [
          {
            name "xs"
            type "Array<Any>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "one"
              }
              "a"
            ]
            procedure "Standard.Collection.appending"
          }
        }
        returns "Array<Any>"
      }
    }
    warp 1
  }
  test 1
}

