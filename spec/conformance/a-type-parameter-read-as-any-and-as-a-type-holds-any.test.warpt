(test 1)
(name "a-type-parameter-read-as-any-and-as-a-type-holds-any")
(note "Two readings of one type parameter where one accepts the other join to the looser. `Any` accepts everything, so a list of anything takes a number and then a text.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure entry
    (access public)
    (parameter xs (type (array Any)))
    (returns (array Any))
    (body
      (let one (call Standard.Collection.appending xs 1)))
    (result (call Standard.Collection.appending one "a"))))
(arguments (argument xs (array)))
(expect (answers (array 1 "a")))
