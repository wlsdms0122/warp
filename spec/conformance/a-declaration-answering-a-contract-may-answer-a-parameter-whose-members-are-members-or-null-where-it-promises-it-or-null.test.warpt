warpt 1
{
  expect {
    answers "ok"
  }
  name "a-declaration-answering-a-contract-may-answer-a-parameter-whose-members-are-members-or-null-where-it-promises-it-or-null"
  note "The contract answers App.Num? and the declaration answering it answers its own some V, bounded by App.MaybeNum, whose one member is int?."
  program {
    constraints {
      "App.MaybeNum" [
        "Int?"
      ]
      "App.Num" [
        "Int"
      ]
    }
    contracts {
      "App.Pick" {
        pick {
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "App.Num?"
        }
      }
    }
    imports []
    procedures {
      "Bank.Card.pick" {
        body [
          {
            var "v"
          }
        ]
        bounds {
          V "App.MaybeNum"
        }
        parameters [
          {
            name "of"
            type "Bank.Card"
          }
        ]
        result {
          ref "v"
        }
        returns "some V"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            value {
              as {
                of {
                  record {
                    last "4"
                  }
                }
                type "Bank.Card"
              }
            }
          }
          {
            let "p"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.Pick.pick"
              }
            }
          }
        ]
        result "ok"
      }
    }
    satisfies {
      "Bank.Card" [
        "App.Pick"
      ]
    }
    types {
      "Bank.Card" {
        record {
          last "String"
        }
      }
    }
    warp 1
  }
  test 1
}

