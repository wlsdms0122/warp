(test 1)
(name "an-element-of-a-constant-struct-field-reads-as-its-element-type-refuses")
(note "A field reads at the type its declaration writes, `Array<Any>` here, and an element of it reads that list's element type, so `k.a[1]` reads `Any` though it folds to `\"s\"`. A name declaring `String` refuses it at the build.")

(program
  (warp 1)
  (const k (as (struct (field a (array 1 "s"))) App.K))
  (struct App.K
    (field a (array Any)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let x (type String) (path k (field a) (index 1)))
      (return x))))
(expect (refuses build))
