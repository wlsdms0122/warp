warpt 1
{
  expect {
    refuses "load"
  }
  name "a-list-leaving-out-a-type-the-program-names-refuses"
  note "The list is every name the program uses and does not declare, and the contract a bound names is one of them. The host lays the link from the list, so one that left `Standard.Comparable` out would be trusted and wrong."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              3
            ]
            procedure "keep"
          }
        }
        returns "Int"
      }
      keep {
        parameters [
          {
            name "value"
            type "some T: Standard.Comparable"
          }
        ]
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 1
}

