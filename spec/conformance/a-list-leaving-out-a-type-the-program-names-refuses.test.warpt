warpt 1
{
  expect {
    refuses "load"
  }
  name "a-list-leaving-out-a-type-the-program-names-refuses"
  note "The list is every name the program uses and does not declare, and the constraint a bound names is one of them. A caller lays the link from the list, so one that left `std.Comparable` out would be trusted and wrong."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments {
              value 3
            }
            procedure "keep"
          }
        }
        returns "int"
      }
      keep {
        bounds {
          T "std.Comparable"
        }
        parameters {
          value {
            type "some T"
          }
        }
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 1
}

