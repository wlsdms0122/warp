(test 1)
(name "setting-a-key-of-another-type-than-the-maps-refuses")
(note "setting reads the map's keys and the key it writes as one type: text keys beside a whole number fill that type two ways, and the call refuses at the build.")

(program
  (warp 1)
  (import Standard.Collection.setting)
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (result (call Standard.Collection.setting (dictionary (entry "a" 1)) 2 3))))
(expect (refuses build))
