warpt 1
{
  expect {
    answers 1.0
  }
  name "a-closure-literal-a-cast-reads-answers-what-its-procedure-type-answers"
  note "The type a cast names is a place a literal in what it reads is written into. A closure literal writing no `returns`, read as a procedure answering `Double`, answers that: its result `1` is read as the fraction it names, so the call answers `1.0`."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            procedure {
              as {
                of {
                  closure {
                    result 1
                  }
                }
                type "() -> Double"
              }
            }
          }
        }
        returns "Double"
      }
    }
    warp 1
  }
  test 1
}

