(test 1)
(name "a-map-keyed-by-a-declared-struct-no-document-claims-hashable-refuses")
(note "A declared struct answers `Hashable` only where a document claims it does. No document here does, so the map keyed by it refuses at the build.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (procedure App.f
    (parameter m (type (dictionary App.Point Int)))
    (returns Int)
    (result 1))
  (procedure entry
    (access public)
    (returns Int)
    (result 1)))
(expect (refuses build))
