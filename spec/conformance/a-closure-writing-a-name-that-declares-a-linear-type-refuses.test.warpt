warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-writing-a-name-that-declares-a-linear-type-refuses"
  note "`h` declares `App.Handle` and was handed on before the closure. A write of `h` inside the closure would make it hold a value handed on once each time the closure runs, which is no fixed number of times."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
            var "h"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
          {
            let "f"
            value {
              closure {
                body [
                  {
                    set "h"
                    value {
                      record {
                        name "g"
                      }
                    }
                  }
                ]
                result 1
                returns "Int"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

