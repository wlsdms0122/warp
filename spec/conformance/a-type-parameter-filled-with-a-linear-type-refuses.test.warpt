warpt 1
{
  expect {
    refuses "build"
  }
  name "a-type-parameter-filled-with-a-linear-type-refuses"
  note "What fills a type parameter is the call's, so a body taking a value handed on once there has no name to carry the obligation on. A call filling one with a type written linear refuses at the build."
  program {
    imports []
    procedures {
      "App.id" {
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "x"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "h"
            value {
              call {
                arguments [
                  {
                    as {
                      of {
                        record {
                          name "f"
                        }
                      }
                      type "App.Handle"
                    }
                  }
                ]
                procedure "App.id"
              }
            }
          }
        ]
        result 1
        returns "Int"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

