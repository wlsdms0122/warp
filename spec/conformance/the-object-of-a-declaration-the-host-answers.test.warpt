(test 1)
(name "the-object-of-a-declaration-the-host-answers")
(note "A declaration the host answers has no body: its row's implementation is the host's, carrying the sends it declared, and the object standing on it names that module's object under dependencies.")

(vocabulary
  (procedure Host.ping
    (const)
    (isolated)
    (returns Int)
    (answers 7)))

(program
  (warp 1)
  (import Host.ping)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (result (call Host.ping))))
(expect (builds (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"68130506183fd1b2262dc7b86f32782c9adc0a3caa1fc02a8a61cbf490eb850e")) (entry "document" (array x"8bf649c6a54e878cdb4d2b2e2ef086b6b5a9c12dcccceb332233ae47e80fee9b")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Host.ping") (array))) (entry "object" 1) (entry "operationTable" (array (array 11 (array 0 (array) (array))))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array) (array 0)) (array 0 (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array)) (entry "variables" (array)))))
