(test 1)
(name "two-documents-that-need-each-other-refuse")
(note "A document beside the program is built against what stands before it. `Ring.a` sends `Ring.b`, which only the document laid after it declares, so the send reaches nothing and the build refuses.")

(documents
  (document
    (warp 1)
    (import Ring.b)
    (procedure Ring.a
      (returns Int)
      (body
        (return (call Ring.b)))))
  (document
    (warp 1)
    (procedure Ring.b
      (returns Int)
      (body
        (return 1)))))

(program
  (warp 1)
  (import Ring.a)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call Ring.a)))))
(expect (refuses build))
