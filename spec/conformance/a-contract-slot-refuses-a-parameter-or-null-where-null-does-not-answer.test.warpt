(test 1)
(name "a-contract-slot-refuses-a-parameter-or-null-where-null-does-not-answer")
(note "App.g reads v as some T or null, T bounded by App.Num, and hands it to App.f, which takes App.Num. No document claims App.Num for `Null`.")

(program
  (warp 1)
  (contract App.Num)
  (extension
    (head Int)
    (satisfies App.Num))
  (procedure App.f
    (parameter n (type App.Num))
    (returns String)
    (body
      (return "took")))
  (procedure App.g
    (parameter m (type (some T App.Num)))
    (returns String)
    (body
      (var v)
      (conditional
        (when true)
        (then
          (set v m)))
      (let s (call App.f v))
      (return s)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let s (call App.g 3))
      (return s))))
(expect (refuses build))
