(test 1)
(name "a-struct-from-outside-under-an-alias-of-an-applied-struct-fills-an-associated-type-answers")
(note "The value at the door is written under the alias's name; an alias's name becomes its struct's, so it is a box of Int.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (type App.IntBox (named App.Box Int))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Lib.Container)
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import App.IntBox)
  (import Int.plus)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (parameter c (type App.IntBox))
    (returns Int)
    (body
      (let v (call Lib.firstOf c))
      (return (call Int.plus v 1)))))
(arguments (argument c (struct App.IntBox (field item 1))))
(expect (answers 2))
