warpt 1
{
  expect {
    refuses "run"
  }
  name "a-list-of-a-parameter-rewritten-with-a-member-value-is-judged-refuses"
  note "App.g writes ys, a list of T, as Standard.Collection.appending(ys, 5) and answers it. 5 is not a value of T, so the call judges the answer, and T filled with int(0...3) refuses 5 at the run."
  program {
    imports [
      "Standard.Collection.appending"
      "Standard.Numeric"
    ]
    procedures {
      "App.g" {
        body [
          {
            value [
              {
                ref "n"
              }
            ]
            var "ys"
          }
          {
            set "ys"
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                  5
                ]
                procedure "Standard.Collection.appending"
              }
            }
          }
        ]
        bounds {
          T "Standard.Numeric"
        }
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          ref "ys"
        }
        returns "Array<some T>"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            type "Int(0...3)"
            value 2
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

