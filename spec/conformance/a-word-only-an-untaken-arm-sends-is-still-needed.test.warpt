warpt 1
{
  arguments {
    ready true
  }
  expect {
    refuses "link"
  }
  name "a-word-only-an-untaken-arm-sends-is-still-needed"
  note "The same rule one layer out: a word reached only from an arm nobody takes still has to be there, because whether the arm is taken is not known until it runs and by then the refusal is too late."
  program {
    imports [
      "nobodyDeclaresThis"
    ]
    procedures {
      entry {
        body [
          {
            value {
              conditional {
                else [
                  {
                    value {
                      call {
                        procedure "nobodyDeclaresThis"
                      }
                    }
                  }
                ]
                then [
                  {
                    let "taken"
                    value "taken"
                  }
                ]
                when {
                  ref "ready"
                }
              }
            }
          }
        ]
        parameters {
          ready "bool"
        }
      }
    }
    warp 1
  }
  test 1
}
