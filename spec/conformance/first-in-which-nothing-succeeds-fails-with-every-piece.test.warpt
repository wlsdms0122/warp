(test 1)
(name "first-in-which-nothing-succeeds-fails-with-every-piece")
(note "A `firstKeyed` in which nothing succeeds fails the way `allKeyed` fails: every piece's failure reported, keyed by the piece it came from, so a rescue reads one failure per piece.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (import Standard.Concurrent.firstKeyed)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns (array String))
    (failing cast_refused)
    (body
      (let tried
        (attempt
          (body
            (call Standard.Concurrent.firstKeyed
              (dictionary
                (entry "left"
                  (closure
                    (const)
                    (isolated)
                    (returns Int)
                    (failing aborted)
                    (body
                      (call Standard.Control.abort "left"))))
                (entry "right"
                  (closure
                    (const)
                    (isolated)
                    (returns Int)
                    (failing aborted)
                    (body
                      (call Standard.Control.abort "right")))))))
          (result (array))
          (rescue
            (body
              (let failures (as (path tried (field details) (index "failures")) (dictionary String Any))))
            (result (call Standard.Collection.keys failures))))))
    (result tried)))
(expect (answers (array "left" "right")))
