warpt 1
{
  expect {
    answers [
      "left"
      "right"
    ]
  }
  name "first-in-which-nothing-succeeds-fails-with-every-piece"
  note "A `firstKeyed` in which nothing succeeds fails the way `allKeyed` fails: every piece's failure reported, keyed by the piece it came from, so a rescue reads one failure per piece."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Concurrent.firstKeyed"
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            record {
                              left {
                                closure {
                                  body [
                                    {
                                      value {
                                        call {
                                          arguments [
                                            "left"
                                          ]
                                          procedure "Standard.Control.abort"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                              right {
                                closure {
                                  body [
                                    {
                                      value {
                                        call {
                                          arguments [
                                            "right"
                                          ]
                                          procedure "Standard.Control.abort"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        ]
                        procedure "Standard.Concurrent.firstKeyed"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      let "failures"
                      value {
                        as {
                          of {
                            ref "tried.details.failures"
                          }
                          type "Dictionary<Any>"
                        }
                      }
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "failures"
                        }
                      ]
                      procedure "Standard.Collection.keys"
                    }
                  }
                }
                result []
              }
            }
          }
        ]
        result {
          ref "tried"
        }
      }
    }
    warp 1
  }
  test 1
}

