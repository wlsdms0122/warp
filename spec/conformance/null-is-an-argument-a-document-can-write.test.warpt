warpt 1
{
  expect {
    answers true
  }
  name "null-is-an-argument-a-document-can-write"
  note "Writing an argument is giving it. An argument holding null was given, and a slot of type `any` takes it."
  program {
    imports [
      "std.logic.equal"
    ]
    procedures {
      "app.takes" {
        parameters [
          {
            name "it"
            type "any"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
              null
            ]
            procedure "std.logic.equal"
          }
        }
        returns "bool"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              null
            ]
            procedure "app.takes"
          }
        }
        returns "bool"
      }
    }
    warp 1
  }
  test 1
}

