(test 1)
(name "null-is-an-argument-a-document-can-write")
(note "Writing an argument is giving it. An argument holding null was given, and a slot of type `Any` takes it.")

(program
  (warp 1)
  (import Standard.Logic.equal)
  (procedure App.takes
    (parameter it)
    (returns Bool)
    (body
      (return (call Standard.Logic.equal it null))))
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (return (call App.takes null)))))
(expect (answers true))
