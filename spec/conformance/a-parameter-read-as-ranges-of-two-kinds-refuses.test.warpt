warpt 1
{
  expect {
    refuses "build"
  }
  name "a-parameter-read-as-ranges-of-two-kinds-refuses"
  note "App.pick reads its some T as a range of fractions and as a range of whole numbers. No value is both a whole number and a fraction, so no one type holds both readings, and the call is refused at the build."
  program {
    imports []
    procedures {
      "App.pick" {
        parameters [
          {
            name "c"
            type "Bool"
          }
          {
            name "x"
            type "some T"
          }
          {
            name "y"
            type "some T"
          }
          {
            name "j"
            type "Any"
          }
        ]
        result {
          ref "j"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "d"
            type "Double(0.0...1.5)"
            value 0.5
          }
          {
            let "n"
            type "Int(0...10)"
            value 10
          }
          {
            let "r"
            value {
              call {
                arguments [
                  false
                  {
                    ref "d"
                  }
                  {
                    ref "n"
                  }
                  {
                    ref "n"
                  }
                ]
                procedure "App.pick"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

