(test 1)
(name "a-cast-of-a-closure-appending-to-a-list-of-its-makers-parameter-fails")
(note "A closure in App.g appends its parameter to cell, a list of T, and is held as Any. The cast reading it as taking a string fails with cast_refused, since only App.g's call filled its T, so cell holds only values of T and the attempt in the entry catches the failure.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (procedure App.g
    (parameter x (type (some T)))
    (returns (array (some T)))
    (failing (anything))
    (body
      (var cell (array x))
      (let c
        (closure
          (parameter y (type (some T)))
          (returns Int)
          (body
            (call Standard.Collection.append cell y))
          (result 0)))
      (let a (type Any) c)
      (let h (as a (procedure (parameters String) (returns Int))))
      (let z (apply h "s")))
    (result cell))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let tried
        (attempt
          (body
            (let r (call App.g 1)))
          (result r)
          (rescue
            (result (path tried (field type)))))))
    (result tried)))
(expect (answers "cast_refused"))
