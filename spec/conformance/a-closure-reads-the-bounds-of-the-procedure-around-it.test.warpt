warpt 1
{
  expect {
    answers [
      "1"
      "2"
    ]
  }
  name "a-closure-reads-the-bounds-of-the-procedure-around-it"
  note "A closure written in a body reads the type parameters of the procedure around it: its `some T` is the `T` the caller filled, held to the bounds the declaration wrote. So a closure over `some T` may send the contract's procedure to what it is handed, the way the body around it may."
  program {
    contracts {
      "App.Named" {
        name {
          parameters [
            {
              name "of"
              type "App.Named"
            }
          ]
          returns "string"
        }
      }
    }
    imports [
      "Standard.Collection.append"
      "Standard.Collection.count"
      "Standard.Math.lessThan"
      "Standard.Text.text"
    ]
    procedures {
      "App.Thing.name" {
        parameters [
          {
            name "of"
            type "App.Thing"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of.id"
              }
            ]
            procedure "Standard.Text.text"
          }
        }
        returns "string"
      }
      "App.each" {
        body [
          {
            type "array<string>"
            value []
            var "out"
          }
          {
            let "walk"
            value {
              loop {
                body [
                  {
                    let "got"
                    value {
                      call {
                        arguments [
                          {
                            ref "of[walk.index]"
                          }
                        ]
                        procedure {
                          ref "by"
                        }
                      }
                    }
                  }
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "out"
                          }
                          {
                            ref "got"
                          }
                        ]
                        procedure "Standard.Collection.append"
                      }
                    }
                  }
                ]
                while {
                  call {
                    arguments [
                      {
                        ref "walk.index"
                      }
                      {
                        call {
                          arguments [
                            {
                              ref "of"
                            }
                          ]
                          procedure "Standard.Collection.count"
                        }
                      }
                    ]
                    procedure "Standard.Math.lessThan"
                  }
                }
              }
            }
          }
        ]
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "of"
            type "array<some T>"
          }
          {
            name "by"
            type {
              procedure {
                parameters [
                  "some T"
                ]
                returns "string"
              }
            }
          }
        ]
        result {
          ref "out"
        }
        returns "array<string>"
      }
      "App.names" {
        bounds {
          T "App.Named"
        }
        parameters [
          {
            name "of"
            type "array<some T>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "of"
              }
              {
                closure {
                  parameters [
                    {
                      name "item"
                      type "some T"
                    }
                  ]
                  result {
                    call {
                      arguments [
                        {
                          ref "item"
                        }
                      ]
                      procedure "App.Named.name"
                    }
                  }
                  returns "string"
                }
              }
            ]
            procedure "App.each"
          }
        }
        returns "array<string>"
      }
      entry {
        access "public"
        result {
          call {
            arguments [
              [
                {
                  as {
                    of {
                      record {
                        id 1
                      }
                    }
                    type "App.Thing"
                  }
                }
                {
                  as {
                    of {
                      record {
                        id 2
                      }
                    }
                    type "App.Thing"
                  }
                }
              ]
            ]
            procedure "App.names"
          }
        }
        returns "array<string>"
      }
    }
    satisfies {
      "App.Thing" [
        "App.Named"
      ]
    }
    types {
      "App.Thing" {
        record {
          id "int"
        }
      }
    }
    warp 1
  }
  test 1
}

