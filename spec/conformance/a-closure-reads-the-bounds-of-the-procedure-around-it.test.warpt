(test 1)
(name "a-closure-reads-the-bounds-of-the-procedure-around-it")
(note "A closure written in a body reads the type parameters of the procedure around it: its `some T` is the `T` the caller filled, held to the bounds the declaration wrote. So a closure over `some T` may send the contract's procedure to what it is handed, the way the body around it may.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (import Standard.Collection.count)
  (import Standard.Comparable.lessThan)
  (import Standard.Text.text)
  (struct App.Thing
    (satisfies App.Named)
    (field id Int)
    (procedure name
      (parameter of (type App.Thing))
      (returns String)
      (result (call Standard.Text.text (path of (field id))))))
  (contract App.Named
    (procedure name
      (parameter of (type Self))
      (returns String)))
  (procedure App.each
    (parameter of (type (array (some T App.Named))))
    (parameter by (type (procedure (parameters (some T)) (returns String))))
    (returns (array String))
    (body
      (var out (type (array String)) (array))
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count of)))
          (body
            (let got (apply by (path of (index (path walk (field index))))))
            (call Standard.Collection.append out got)))))
    (result out))
  (procedure App.names
    (parameter of (type (array (some T App.Named))))
    (returns (array String))
    (result
      (call App.each of
        (closure
          (parameter item (type (some T)))
          (returns String)
          (result (call App.Named.name item))))))
  (procedure entry
    (access public)
    (returns (array String))
    (failing cast_refused)
    (result (call App.names (array (as (struct (field id 1)) App.Thing) (as (struct (field id 2)) App.Thing))))))
(expect (answers (array "1" "2")))
