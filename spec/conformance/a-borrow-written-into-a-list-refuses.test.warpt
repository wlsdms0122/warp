warpt 1
{
  expect {
    refuses "build"
  }
  name "a-borrow-written-into-a-list-refuses"
  note "Wrapping a borrowed name in a list carries the whole value out rather than reading a part of it, which gives away what the body never took."
  program {
    imports [
      "app.Handle"
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            let "shown"
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "leak"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
      }
      leak {
        parameters [
          {
            name "of"
            type "borrowing app.Handle"
          }
        ]
        result [
          {
            ref "of"
          }
        ]
        returns "any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

