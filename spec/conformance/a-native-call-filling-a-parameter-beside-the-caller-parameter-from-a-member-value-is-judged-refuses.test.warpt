warpt 1
{
  expect {
    refuses "run"
  }
  name "a-native-call-filling-a-parameter-beside-the-caller-parameter-from-a-member-value-is-judged-refuses"
  note "app.g, bounded by std.Numeric, answers std.math.plus(n, 5), which fills N from n and from 5. The native's word holds for what filled N, which 5 is not a value of, so the call judges the answer, and T filled with int(0...3) refuses 7 at the run."
  program {
    imports [
      "std.Numeric"
      "std.math.plus"
    ]
    procedures {
      "app.g" {
        body [
          {
            let "p"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                  5
                ]
                procedure "std.math.plus"
              }
            }
          }
        ]
        bounds {
          T "std.Numeric"
        }
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          ref "p"
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "v"
            type "int(0...3)"
            value 2
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "v"
                  }
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

