warpt 1
{
  expect {
    answers "a"
  }
  name "a-cast-of-a-nameless-field-to-a-field-of-a-declared-record-names-it"
  note "`s` holds a record whose field `p` is the nameless record `{ k: \"x\" }`, and `Bank.A` is declared `{ k: string }`. Casting it as `{ p: Bank.A }` attaches the name to the field, so it is no cast of what the reading already is, and `App.P.show` is sent to the field."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "App.P"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.show" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              record {
                p {
                  record {
                    k "x"
                  }
                }
              }
            }
          }
          {
            let "s"
            value {
              as {
                of {
                  ref "r"
                }
                type {
                  record {
                    p "Bank.A"
                  }
                }
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "s.p"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    satisfies {
      "Bank.A" [
        "App.P"
      ]
    }
    types {
      "App.KR" {
        record {
          k "string"
        }
      }
      "App.NK" "App.KR?"
      "Bank.A" {
        record {
          k "string"
        }
      }
      "Bank.B" {
        record {
          k "string"
        }
      }
      "Bank.NA" "Bank.A?"
      "Bank.NB" "Bank.B?"
    }
    warp 1
  }
  test 1
}

