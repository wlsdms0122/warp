warpt 1
{
  expect {
    answers [
      1
      "a"
    ]
  }
  name "elements-of-different-kinds-join-to-any"
  note "Two values of different kinds join to `Any`. Where the readings disagree the slot holds neither, and a join that guessed would be a refusal an author cannot act on."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "items"
            value [
              1
              "a"
            ]
          }
        ]
        result {
          ref "items"
        }
        returns "Array<Any>"
      }
    }
    warp 1
  }
  test 1
}

