(test 1)
(name "a-cast-to-a-list-of-an-alias-of-the-struct-a-list-holds-refuses")
(note "`Bank.BB` stands for `Bank.B`, a declared struct. `xs` is read as `Array<Bank.B>`, so casting it as `Array<Bank.BB>` names what the reading already is under another spelling of the same struct, and the build refuses the cast as needless.")

(program
  (warp 1)
  (struct Bank.B
    (field k String))
  (type Bank.BB Bank.B)
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let xs (type (array Bank.B)) (array (struct (field k "x"))))
      (let ys (as xs (array Bank.BB))))
    (result 0)))
(expect (refuses build))
