(test 1)
(name "a-type-parameter-read-as-closures-answering-text-and-anything-answers-anything")
(note "`fa` writes `returns Any` and answers 1, and `fs` answers text. `App.pick` hands back its second argument, and the call reads `E` from both: a procedure answering `Any` takes one answering text, so `E` is the one answering `Any`, and so is `r`. Its answer stands beside the text in a list of anything.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (procedure App.pick
    (parameter a (type (some E)))
    (parameter b (type (some E)))
    (returns (some E))
    (body
      (return b)))
  (procedure entry
    (access public)
    (returns (array Any))
    (failing (anything))
    (body
      (let fs
        (closure
          (returns String)
          (body
            (return "x"))))
      (let fa
        (closure
          (returns Any)
          (body
            (return 1))))
      (let r (call App.pick fs fa))
      (let v (apply r))
      (let t (call Standard.Collection.appending (array v) "z"))
      (return t))))
(expect (answers (array 1 "z")))
