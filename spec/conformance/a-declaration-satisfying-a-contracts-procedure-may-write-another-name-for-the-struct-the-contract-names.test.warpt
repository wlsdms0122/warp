(test 1)
(name "a-declaration-satisfying-a-contracts-procedure-may-write-another-name-for-the-struct-the-contract-names")
(note "The contract's procedure takes an `App.Point` second, and the declaration satisfying it for `App.Box` writes `App.Spot`, which names `App.Point`. A name that stands for a declared struct names that struct's type, so the two signatures agree and the claim holds.")

(program
  (warp 1)
  (struct App.Box
    (satisfies App.Placing)
    (field v Int)
    (procedure place
      (parameter of (type App.Box))
      (parameter at (type App.Spot))
      (returns Int)
      (body
        (return (path at (field x))))))
  (struct App.Point
    (field x Int))
  (type App.Spot App.Point)
  (contract App.Placing
    (procedure place
      (parameter of (type Self))
      (parameter at (type App.Point))
      (returns Int)))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let box (as (struct (field v 1)) App.Box))
      (let point (as (struct (field x 5)) App.Point))
      (return (call App.Placing.place box point)))))
(expect (answers 5))
