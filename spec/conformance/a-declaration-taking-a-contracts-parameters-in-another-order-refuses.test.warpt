(test 1)
(name "a-declaration-taking-a-contracts-parameters-in-another-order-refuses")
(note "A declaration answering a contract's procedure takes its own type first and then what the contract asks at the same positions, since the run hands the arguments to the same positions whichever declaration answers. One taking them the other way round backs no claim, which refuses at the build, at the claim.")

(program
  (warp 1)
  (struct App.Card
    (satisfies App.Labelled)
    (field last String)
    (procedure label
      (parameter of (type App.Card))
      (parameter b (type String))
      (parameter a (type Int))
      (returns String)
      (body
        (return b))))
  (contract App.Labelled
    (procedure label
      (parameter of (type Self))
      (parameter a (type Int))
      (parameter b (type String))
      (returns String)))
  (procedure App.tell
    (parameter it (type (some T App.Labelled)))
    (returns String)
    (body
      (return (call App.Labelled.label it 1 "x"))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let card (as (struct (field last "42")) App.Card))
      (return (call App.tell card)))))
(expect (refuses build))
