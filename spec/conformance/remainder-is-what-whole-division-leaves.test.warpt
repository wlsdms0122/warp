warpt 1
{
  expect {
    answers 1
  }
  name "remainder-is-what-whole-division-leaves"
  note "remainder answers what is left of a whole division."
  program {
    imports [
      "Standard.Numeric.remainder"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "left"
            value {
              call {
                arguments [
                  7
                  3
                ]
                procedure "Standard.Numeric.remainder"
              }
            }
          }
        ]
        result {
          ref "left"
        }
      }
    }
    warp 1
  }
  test 1
}

