(test 1)
(name "remainder-is-what-whole-division-leaves")
(note "remainder answers what is left of a whole division.")

(program
  (warp 1)
  (import Standard.Numeric.remainder)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let left (call Standard.Numeric.remainder 7 3)))
    (result left)))
(expect (answers 1))
