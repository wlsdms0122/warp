warpt 1
{
  arguments {
    z 0
  }
  expect {
    refuses "run"
  }
  name "a-rescue-does-not-hold-a-piece-that-refuses"
  note "A piece refusing at the run refuses the whole run. A refusal is not a failure, so the rescue around the fan-out does not hold it, and what the other pieces answered is not reported."
  program {
    imports [
      "Standard.Concurrent.allKeyed"
      "Standard.Numeric.dividedBy"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    let "both"
                    value {
                      call {
                        arguments [
                          {
                            dictionary [
                              [
                                "broken"
                                {
                                  closure {
                                    const true
                                    isolated true
                                    result {
                                      call {
                                        arguments [
                                          1
                                          {
                                            ref "z"
                                          }
                                        ]
                                        procedure "Standard.Numeric.dividedBy"
                                      }
                                    }
                                    returns "Double"
                                  }
                                }
                              ]
                              [
                                "fine"
                                {
                                  closure {
                                    const true
                                    isolated true
                                    result 1
                                    returns "Int"
                                  }
                                }
                              ]
                            ]
                          }
                        ]
                        procedure "Standard.Concurrent.allKeyed"
                      }
                    }
                  }
                ]
                rescue {
                  result "rescued"
                }
              }
            }
          }
        ]
        isolated true
        parameters [
          {
            name "z"
            type "Int"
          }
        ]
        result {
          ref "tried"
        }
        returns "String?"
      }
    }
    warp 1
  }
  test 1
}

