(test 1)
(name "a-rescue-does-not-hold-a-piece-that-refuses")
(note "A piece refusing at the run refuses the whole run. A refusal is not a failure, so the rescue around the fan-out does not hold it, and what the other pieces answered is not reported.")

(program
  (warp 1)
  (import Standard.Concurrent.allKeyed)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (isolated)
    (parameter z (type Int))
    (returns (nullable String))
    (body
      (let tried
        (attempt
          (body
            (let both
              (call Standard.Concurrent.allKeyed
                (dictionary
                  (entry "broken"
                    (closure
                      (const)
                      (isolated)
                      (returns Double)
                      (result (call Standard.Numeric.dividedBy 1 z))))
                  (entry "fine"
                    (closure
                      (const)
                      (isolated)
                      (returns Int)
                      (result 1)))))))
          (rescue
            (result "rescued")))))
    (result tried)))
(arguments (argument z 0))
(expect (refuses run))
