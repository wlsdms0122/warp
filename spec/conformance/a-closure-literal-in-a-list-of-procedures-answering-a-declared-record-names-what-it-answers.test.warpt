warpt 1
{
  expect {
    answers App.Point {
      x 1
    }
  }
  name "a-closure-literal-in-a-list-of-procedures-answering-a-declared-record-names-what-it-answers"
  note "`c` declares a list of `Procedure() -> App.Point`, and the closure literal written as its element writes no `returns`, so it answers `App.Point`: the record literal it answers is written where `App.Point` is read and takes the name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              array {
                procedure {
                  returns "App.Point"
                }
              }
            }
            value [
              {
                closure {
                  result {
                    record {
                      x 1
                    }
                  }
                }
              }
            ]
          }
        ]
        result {
          call {
            procedure {
              ref "c[0]"
            }
          }
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

