warpt 1
{
  expect {
    answers {
      a "y"
      b 2
    }
  }
  name "a-parameter-read-as-an-alias-of-a-nullable-record-and-as-a-wider-record-answers"
  note "`app.NA` names `app.A?`, which is no record, so it is an alias and stands for what it names. `app.pick` reads `E` as `app.NA` and as `{ a: string, b: int }`, and the alias takes the wider record as `app.A?` does, so the call builds and answers the second record."
  program {
    imports []
    procedures {
      "app.pick" {
        parameters [
          {
            name "a"
            type "some E"
          }
          {
            name "b"
            type "some E"
          }
        ]
        result {
          ref "b"
        }
        returns "some E"
      }
      entry {
        access "public"
        body [
          {
            let "n"
            type "app.NA"
            value {
              record {
                a "x"
              }
            }
          }
          {
            let "r"
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                  {
                    record {
                      a "y"
                      b 2
                    }
                  }
                ]
                procedure "app.pick"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    types {
      "app.A" {
        record {
          a "string"
        }
      }
      "app.NA" "app.A?"
    }
    warp 1
  }
  test 1
}

