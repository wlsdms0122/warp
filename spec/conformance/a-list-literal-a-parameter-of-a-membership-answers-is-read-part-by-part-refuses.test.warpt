warpt 1
{
  expect {
    refuses "build"
  }
  name "a-list-literal-a-parameter-of-a-membership-answers-is-read-part-by-part-refuses"
  note "`App.g` answers `some T`, with `T` bounded by the membership of `array<int>` and `array<string>`, and answers `[i, t]`, an int and a string read from its parameters. A value of the parameter is one every member takes, and the literal is held to each member part by part, so neither list takes it and the build refuses."
  program {
    constraints {
      "App.M" [
        "array<int>"
        "array<string>"
      ]
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "i"
            type "int"
          }
          {
            name "t"
            type "string"
          }
        ]
        result [
          {
            ref "i"
          }
          {
            ref "t"
          }
        ]
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    1
                  ]
                  1
                  "s"
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

