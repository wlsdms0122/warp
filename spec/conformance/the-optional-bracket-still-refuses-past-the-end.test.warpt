(test 1)
(name "the-optional-bracket-still-refuses-past-the-end")
(note "`?[` expects the array's absence, not the element's. An array that arrived says how long it is, so a reading that misses it read the length wrong. Past the end refuses at the run, mark or no mark.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter items (type (nullable (array String))))
    (returns (nullable String))
    (body
      (return (path items (index? 5))))))
(arguments (argument items (array "only")))
(expect (refuses run))
