warpt 1
{
  expect {
    refuses "run"
  }
  name "a-called-value-writes-in-place-held-to-its-slots-type"
  note "A closure writing the parameter it takes in place is held to that parameter's type, the way a declaration's body is: `n` holds `int(0...10)`, and the write of 11 through the closure refuses at the run before it lands in the caller's box."
  program {
    imports [
      "std.math.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            type "int(0...10)"
            value 10
            var "n"
          }
          {
            let "bump"
            value {
              closure {
                body [
                  {
                    set "count"
                    value {
                      call {
                        arguments [
                          {
                            ref "count"
                          }
                          1
                        ]
                        procedure "std.math.plus"
                      }
                    }
                  }
                ]
                parameters [
                  {
                    name "count"
                    type "inout int(0...10)"
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure {
                  ref "bump"
                }
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

