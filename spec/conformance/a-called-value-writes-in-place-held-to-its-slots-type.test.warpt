warpt 1
{
  expect {
    refuses "build"
  }
  name "a-called-value-writes-in-place-held-to-its-slots-type"
  note "A closure writing the parameter it takes in place is held to that parameter's type, the way a declaration's body is: `count` is an `inout Int`, and writing text into it refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            type "Int"
            value 10
            var "n"
          }
          {
            let "bump"
            value {
              closure {
                body [
                  {
                    set "count"
                    value "eleven"
                  }
                ]
                parameters [
                  {
                    name "count"
                    type "inout Int"
                  }
                ]
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure {
                  ref "bump"
                }
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

