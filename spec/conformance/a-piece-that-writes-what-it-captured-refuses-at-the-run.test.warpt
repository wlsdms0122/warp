warpt 1
{
  expect {
    refuses "run"
  }
  name "a-piece-that-writes-what-it-captured-refuses-at-the-run"
  note "`all` takes its pieces as `any`, so the link could not ask. The closure value carries the isolation the link derived, and the word asks each piece as it is started."
  program {
    imports [
      "std.concurrent.all"
    ]
    procedures {
      entry {
        body [
          {
            value 0
            var "tally"
          }
          {
            let "pieces"
            value [
              {
                closure {
                  body [
                    {
                      set "tally"
                      value 1
                    }
                  ]
                  result 1
                }
              }
            ]
          }
          {
            value {
              call {
                of {
                  ref "pieces"
                }
                procedure "std.concurrent.all"
              }
            }
          }
        ]
        result {
          ref "tally"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}
