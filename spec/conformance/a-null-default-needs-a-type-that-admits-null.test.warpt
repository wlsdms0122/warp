warpt 1
{
  expect {
    refuses "build"
  }
  name "a-null-default-needs-a-type-that-admits-null"
  note "A default written as null is the value the body receives when the argument is left out, so the declaration must admit null like any other value."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result null
      }
      pick {
        parameters {
          text {
            default null
            type "string"
          }
        }
        result {
          ref "text"
        }
      }
    }
    warp 1
  }
  test 2
}

