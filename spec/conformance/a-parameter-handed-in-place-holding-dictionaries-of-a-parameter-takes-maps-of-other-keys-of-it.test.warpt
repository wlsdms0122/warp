(test 1)
(name "a-parameter-handed-in-place-holding-dictionaries-of-a-parameter-takes-maps-of-other-keys-of-it")
(note "App.g writes a list of two map literals into xs, a list of dictionaries of lists of T handed in place: one holding `[x]` under `a`, one holding `[x, x]` under `b`. Each map is a dictionary of lists of its own some T, under other keys, so the literal is a value of Array<Dictionary<String, Array<some T>>>.")

(program
  (warp 1)
  (procedure App.g
    (parameter xs (type (inout (array (dictionary String (array (some T)))))))
    (parameter x (type (some T)))
    (returns Int)
    (body
      (set xs (array (dictionary (entry "a" (array x))) (dictionary (entry "b" (array x x))))))
    (result 0))
  (procedure entry
    (access public)
    (returns (array (dictionary String (array String))))
    (body
      (var s (type (array (dictionary String (array String)))) (array (dictionary (entry "k" (array "a")))))
      (call App.g s "b"))
    (result s)))
(expect (answers (array (dictionary (entry "a" (array "b"))) (dictionary (entry "b" (array "b" "b"))))))
