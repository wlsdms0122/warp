warpt 1
{
  expect {
    answers 1
  }
  name "a-constant-closure-taking-a-parameter-in-place-is-handed-a-variable"
  note "A constant holds the type its expression was judged at, so `bump` reads as a procedure type writing `inout Int`. The build hands `n` in place at that position, and the closure writes it."
  program {
    const {
      bump {
        closure {
          body [
            {
              set "c"
              value {
                call {
                  arguments [
                    {
                      ref "c"
                    }
                    1
                  ]
                  procedure "Standard.Numeric.plus"
                }
              }
            }
          ]
          parameters [
            {
              name "c"
              type "inout Int"
            }
          ]
        }
      }
    }
    imports [
      "Standard.Numeric.plus"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "n"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "n"
                  }
                ]
                procedure {
                  ref "bump"
                }
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

