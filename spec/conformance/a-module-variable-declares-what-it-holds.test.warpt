warpt 1
{
  expect {
    answers [
      "a"
    ]
  }
  name "a-module-variable-declares-what-it-holds"
  note "A module variable may say what it holds under `type` beside its start, the way a `var` statement does, so a start that is an empty collection still says what the box will hold. Every write is judged against the declared type."
  program {
    imports [
      "Standard.Collection.keys"
      "Standard.Collection.setting"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            set "seen"
            value {
              call {
                arguments [
                  {
                    ref "seen"
                  }
                  "a"
                  1
                ]
                procedure "Standard.Collection.setting"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "seen"
              }
            ]
            procedure "Standard.Collection.keys"
          }
        }
        returns "Array<String>"
      }
    }
    var {
      seen {
        type "Dictionary<Int>"
        value {
          record {}
        }
      }
    }
    warp 1
  }
  test 1
}

