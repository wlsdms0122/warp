warpt 1
{
  expect {
    refuses "build"
  }
  name "a-variable-that-declares-nothing-gives-a-capture-no-claim"
  note "A variable that declared nothing is held to the type it read as where a closure captured it, which is a reading the build worked out, so it says nothing the closure can hold on to. A closure calling it through the capture does not answer without running."
  program {
    imports []
    procedures {
      asking {
        body [
          {
            let "answered"
            value {
              call {
                procedure {
                  ref "body"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "body"
            type "const () -> String"
          }
        ]
        result {
          ref "answered"
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            value {
              closure {
                result "answered"
                returns "String"
              }
            }
            var "answering"
          }
          {
            let "relaying"
            value {
              closure {
                result {
                  call {
                    procedure {
                      ref "answering"
                    }
                  }
                }
                returns "String"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "relaying"
              }
            ]
            procedure "asking"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

