warpt 1
{
  expect {
    refuses "load"
  }
  name "a-marked-head-is-refused"
  note "`?.` and `?[` expect an absence to read past, and the head of a path is a name a scope holds. There is nothing before it to read past. A head that answers nothing is a reading gone wrong, not an absence, so the mark is refused wherever the path is judged."
  program {
    imports []
    procedures {
      entry {
        parameters {
          text {
            default null
            type "string?"
          }
        }
        result {
          ref "?.text"
        }
        returns "string?"
      }
    }
    warp 1
  }
  test 2
}
