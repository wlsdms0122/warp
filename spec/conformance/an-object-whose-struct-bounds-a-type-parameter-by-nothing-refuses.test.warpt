(object (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"9750f44dae76570bfabf05e51b66b5f60f665dc9fd0a5f876730549851177844")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 3 (array (array "App.Box" (array "item")) (array 0))) (array 0 1) (array 13 0 (array) (array 2)))) (entry "rows" (array (array "entry" (array (array) 1 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 1 "b") (array (array) 3 "[1]")) (array 1 (array) (array) (array) (array "b")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 15 "T") (array 4))) (entry "types" (array (array "App.Box" (array 9 (array (array "item" 0)) (array "T") (array (array "T" (array))))))) (entry "valueTable" (array (array 2 1) (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
