warpt 1
{
  expect {
    answers 7
  }
  name "an-answer-nobody-wrote-is-read-off-the-body"
  note "A declaration with no `returns` still answers something, and what it answers is what its body hands back. The dot after the call is judged against that, so the shape the body already states does not have to be stated twice."
  program {
    imports []
    procedures {
      counts {
        result {
          total 7
        }
      }
      entry {
        body [
          {
            let "said"
            value {
              call {
                procedure "counts"
              }
            }
          }
        ]
        result {
          ref "said.total"
        }
        returns "int"
      }
    }
    warp 2
  }
  test 1
}
