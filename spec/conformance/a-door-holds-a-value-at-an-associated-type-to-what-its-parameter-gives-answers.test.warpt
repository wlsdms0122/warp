(test 1)
(name "a-door-holds-a-value-at-an-associated-type-to-what-its-parameter-gives-answers")
(note "The run hands a box of Int at C and an Int at `some C.Item`, which is what a box of Int gives.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (result (call Lib.Container.first c))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item)))))))

(program
  (warp 1)
  (import Lib.Container)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Container)))
    (parameter x (type (some C.Item)))
    (returns (some C.Item))
    (result x)))
(arguments (argument c (struct App.Box (field item 1))) (argument x 1))
(expect (answers 1))
