warpt 1
{
  expect {
    refuses "build"
  }
  name "a-body-cannot-answer-what-it-borrowed"
  note "What a body answers its caller then owes. A body that only borrowed never owed it, so it has nothing to hand over."
  program {
    imports []
    procedures {
      "app.leak" {
        parameters {
          of {
            type "borrowing app.Handle"
          }
        }
        receiver "of"
        result {
          ref "of"
        }
        returns "app.Handle"
      }
      "app.open" {
        result {
          as "app.Handle"
          of {
            name "f"
          }
        }
        returns "app.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
        ]
        result {
          ref "handle"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          name "string"
        }
      }
    }
    warp 1
  }
  test 1
}

