warpt 1
{
  expect {
    refuses "build"
  }
  name "a-body-cannot-answer-what-it-borrowed"
  note "What a body answers its caller then owes. A body that only borrowed never owed it, so it has nothing to hand over."
  program {
    imports []
    procedures {
      "App.leak" {
        parameters [
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
        result {
          ref "of"
        }
        returns "App.Handle"
      }
      "App.open" {
        result {
          as {
            of {
              record {
                name "f"
              }
            }
            type "App.Handle"
          }
        }
        returns "App.Handle"
      }
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
        ]
        result {
          ref "handle"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
    warp 1
  }
  test 1
}

