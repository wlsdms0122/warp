warpt 1
{
  arguments {
    c App.Box {
      item 1
    }
    x "no"
  }
  documents [
    {
      contracts {
        "Lib.Container" {
          procedures {
            first {
              parameters [
                {
                  name "of"
                  type "Self"
                }
              ]
              returns "Self.Item"
            }
          }
          types [
            "Item"
          ]
        }
      }
      imports []
      procedures {
        "Lib.firstOf" {
          access "public"
          bounds {
            C "Lib.Container"
          }
          parameters [
            {
              name "c"
              type "some C"
            }
          ]
          result {
            call {
              arguments [
                {
                  ref "c"
                }
              ]
              procedure "Lib.Container.first"
            }
          }
          returns "some C.Item"
        }
      }
      warp 1
    }
    {
      imports [
        "Lib.Container"
      ]
      types {
        "App.Box" {
          procedures {
            first {
              access "public"
              parameters [
                {
                  name "of"
                  type "App.Box<some T>"
                }
              ]
              result {
                ref "of.item"
              }
              returns "some T"
            }
          }
          satisfies [
            "Lib.Container"
          ]
          struct {
            item "some T"
          }
          typeParameters [
            "T"
          ]
          types {
            Item "some T"
          }
        }
      }
      warp 1
    }
  ]
  expect {
    refuses "run"
  }
  name "a-door-refuses-a-value-at-a-member-of-another-type-refuses"
  note "The run hands a box of Int at C and text at `some C.Item`, which a box of Int gives as Int, so the run refuses it at the door."
  program {
    imports [
      "Lib.Container"
    ]
    procedures {
      entry {
        access "public"
        bounds {
          C "Lib.Container"
        }
        parameters [
          {
            name "c"
            type "some C"
          }
          {
            name "x"
            type "some C.Item"
          }
        ]
        result {
          ref "x"
        }
        returns "some C.Item"
      }
    }
    warp 1
  }
  test 1
}

