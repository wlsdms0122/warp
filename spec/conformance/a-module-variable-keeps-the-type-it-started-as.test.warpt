(test 1)
(name "a-module-variable-keeps-the-type-it-started-as")
(note "A module variable's type is the type its start reads as, and every body of the document reads it as that. A write that does not fit refuses at the build.")

(program
  (warp 1)
  (var total 0)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (set total "many"))
    (result total)))
(expect (refuses build))
