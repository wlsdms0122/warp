warpt 1
{
  expect {
    answers [
      []
      [
        1
      ]
    ]
  }
  name "a-parameter-handed-in-place-holding-lists-of-a-parameter-takes-a-block-answering-an-empty-list-beside-a-list-of-it"
  note "A parameter handed in place as `array<array<some T>>` is set to a block whose result is `[[], [x]]`, with `x` one of `some T`. The block writes what its result writes, so the literal is judged part by part as it is written directly: the empty list holds no element and `[x]` holds the parameter."
  program {
    imports []
    procedures {
      "App.g" {
        body [
          {
            set "xs"
            value {
              block {
                result [
                  []
                  [
                    {
                      ref "x"
                    }
                  ]
                ]
              }
            }
          }
        ]
        parameters [
          {
            name "xs"
            type "inout array<array<some T>>"
          }
          {
            name "x"
            type "some T"
          }
        ]
        result 0
      }
      entry {
        access "public"
        body [
          {
            value {
              as {
                of []
                type "array<array<int>>"
              }
            }
            var "s"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "s"
                  }
                  1
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "s"
        }
      }
    }
    warp 1
  }
  test 1
}

