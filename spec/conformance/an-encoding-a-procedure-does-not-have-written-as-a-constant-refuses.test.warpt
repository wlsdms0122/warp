warpt 1
{
  expect {
    refuses "run"
  }
  name "an-encoding-a-procedure-does-not-have-written-as-a-constant-refuses"
  note "Which encodings `encoded` has is the procedure's to say when it runs: `utf9` is no encoding it has, so the run refuses the call, though the name is written as a constant."
  program {
    imports [
      "Standard.Text.encoded"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "hi"
              "utf9"
            ]
            procedure "Standard.Text.encoded"
          }
        }
        returns "Array<Int>"
      }
    }
    warp 1
  }
  test 1
}

