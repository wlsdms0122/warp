warpt 1
{
  bytes x""
  expect {
    refuses "load"
  }
  name "nesting-past-the-bound-refuses"
  note "Five hundred and twelve containers is an exact bound and not a floor, so a writer may rely on the refusal. What it guards is not the reader, which iterates, but everything downstream of one: a checker, a comparer or a host walking the tree recurses in the ordinary way, and their stacks are not the sender's to spend."
  test 4
}

