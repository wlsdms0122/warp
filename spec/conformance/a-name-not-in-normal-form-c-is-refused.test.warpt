warpt 1
{
  expect {
    refuses "load"
  }
  name "a-name-not-in-normal-form-c-is-refused"
  note "One name, one spelling: names are normal form C, compared as bytes. A declaration and a reference can only meet by being the same bytes, so a decomposed spelling is refused where it is written."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "café"
            value 1
          }
        ]
        result {
          ref "café"
        }
      }
    }
    warp 1
  }
  test 2
}

