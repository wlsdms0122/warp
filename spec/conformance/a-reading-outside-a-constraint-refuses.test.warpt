warpt 1
{
  expect {
    refuses "build"
  }
  name "a-reading-outside-a-constraint-refuses"
  note "Both sides of lessThan agree, and agreement is not admission: Comparable admits numbers and text, and these readings are booleans the build can see. The sameness half and the membership half are both said before anything runs."
  program {
    imports [
      "Standard.Comparable.lessThan"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              true
              false
            ]
            procedure "Standard.Comparable.lessThan"
          }
        }
        returns "Bool"
      }
    }
    warp 1
  }
  test 1
}

