warpt 1
{
  expect {
    answers Bank.Account {
      balance 1
    }
  }
  name "a-cast-names-the-record-it-reads"
  note "`as` is one of the places a name is written: the nameless record it reads takes the declared name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          as {
            of {
              record {
                balance 1
              }
            }
            type "Bank.Account"
          }
        }
        returns "Any"
      }
    }
    types {
      "Bank.Account" {
        record {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

