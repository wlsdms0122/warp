warpt 1
{
  expect {
    answers bank.Account {
      balance 1
    }
  }
  name "a-cast-names-the-record-it-reads"
  note "`as` is the settling written out: the record it reads takes the declared name."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          as {
            of {
              record {
                balance 1
              }
            }
            type "bank.Account"
          }
        }
        returns "any"
      }
    }
    types {
      "bank.Account" {
        record {
          balance "int"
        }
      }
    }
    warp 1
  }
  test 1
}

