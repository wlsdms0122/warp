warpt 1
{
  expect {
    answers [
      1
      7.25
    ]
  }
  name "min-and-max-pick-an-end"
  note "min and max answer the lesser and the greater of two of a kind, by worth."
  program {
    imports [
      "std.math.max"
      "std.math.min"
    ]
    procedures {
      entry {
        body [
          {
            let "low"
            value {
              call {
                arguments {
                  value 1
                }
                of 3
                procedure "std.math.min"
              }
            }
          }
          {
            let "high"
            value {
              call {
                arguments {
                  value 7.25
                }
                of 2.5
                procedure "std.math.max"
              }
            }
          }
        ]
        result [
          {
            ref "low"
          }
          {
            ref "high"
          }
        ]
      }
    }
    warp 1
  }
  test 2
}

