warpt 1
{
  expect {
    answers [
      1
      7.25
    ]
  }
  name "min-and-max-pick-an-end"
  note "min and max answer the lesser and the greater of two of one type, by worth."
  program {
    imports [
      "Standard.Math.max"
      "Standard.Math.min"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "low"
            value {
              call {
                arguments [
                  3
                  1
                ]
                procedure "Standard.Math.min"
              }
            }
          }
          {
            let "high"
            value {
              call {
                arguments [
                  2.5
                  7.25
                ]
                procedure "Standard.Math.max"
              }
            }
          }
        ]
        result [
          {
            ref "low"
          }
          {
            ref "high"
          }
        ]
        returns "Array<Any>"
      }
    }
    warp 1
  }
  test 1
}

