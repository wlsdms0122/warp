warpt 1
{
  expect {
    answers 5
  }
  name "a-named-block-binds-its-result"
  note "A block is a body written as a statement; its name binds what its result answers, and what it declared inside does not escape."
  program {
    imports []
    procedures {
      entry {
        body [
          {
            let "got"
            value {
              block {
                body [
                  {
                    let "inner"
                    value 5
                  }
                ]
                result {
                  ref "inner"
                }
              }
            }
          }
        ]
        result {
          ref "got"
        }
      }
    }
    warp 1
  }
  test 2
}
