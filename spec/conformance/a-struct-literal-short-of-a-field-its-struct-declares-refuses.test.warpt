(test 1)
(name "a-struct-literal-short-of-a-field-its-struct-declares-refuses")
(note "A struct literal is judged against the declared struct of its place, exactly the declared fields. `App.P` declares `x` and `y`, and the literal returned where it is declared writes `x` alone, so it refuses at the build.")

(program
  (warp 1)
  (struct App.P
    (field x Int)
    (field y Int))
  (procedure entry
    (access public)
    (returns App.P)
    (body
      (return (struct (field x 1))))))
(expect (refuses build))
