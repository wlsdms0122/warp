(test 1)
(name "a-document-claiming-one-contract-for-a-type-under-two-heads-refuses")
(note "A type answers a contract one way, so a document saying lists of integers and lists of text each answer App.Describable under their own heads is refused at the load.")

(program
  (warp 1)
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (array Int))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (array Int)))
      (returns String)
      (body
        (return "ints"))))
  (extension
    (head (array String))
    (satisfies App.Describable))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
