warpt 1
{
  expect {
    answers false
  }
  name "two-names-of-one-structure-are-two-values"
  note "The name is part of what a record holds: an `Account` and a `Vault` with the same fields are not equal."
  program {
    imports [
      "std.logic.equal"
    ]
    procedures {
      entry {
        body [
          {
            let "one"
            value {
              as "Account"
              of {
                balance 1
              }
            }
          }
          {
            let "other"
            value {
              as "Vault"
              of {
                balance 1
              }
            }
          }
        ]
        result {
          call {
            arguments {
              value {
                ref "other"
              }
            }
            of {
              ref "one"
            }
            procedure "std.logic.equal"
          }
        }
        returns "bool"
      }
    }
    types {
      Account {
        balance "int"
      }
      Vault {
        balance "int"
      }
    }
    warp 1
  }
  test 2
}
