(test 1)
(name "two-names-of-one-structure-are-two-values")
(note "The name is part of what a struct holds: an `Account` and a `Vault` with the same fields are not equal.")

(program
  (warp 1)
  (import Standard.Logic.equal)
  (struct Account
    (field balance Int))
  (struct Vault
    (field balance Int))
  (procedure entry
    (access public)
    (returns Bool)
    (failing cast_refused)
    (body
      (let one (as (struct (field balance 1)) Account))
      (let other (as (struct (field balance 1)) Vault))
      (return (call Standard.Logic.equal one other)))))
(expect (answers false))
