warpt 1
{
  expect {
    answers []
  }
  name "concurrent-map-over-nothing-answers-nothing"
  note "`Standard.Concurrent.map` answers one element per element it was given, in the collection's order, so a map over nothing answers nothing rather than failing."
  program {
    imports [
      "Standard.Concurrent.map"
    ]
    procedures {
      entry {
        access "public"
        failing [
          "concurrent_failed"
        ]
        isolated true
        result {
          call {
            arguments [
              []
              {
                closure {
                  const true
                  isolated true
                  parameters [
                    {
                      name "item"
                    }
                    {
                      name "index"
                      type "Int"
                    }
                  ]
                  result {
                    ref "item"
                  }
                  returns "Any"
                }
              }
            ]
            procedure "Standard.Concurrent.map"
          }
        }
        returns "Array<Any>"
      }
    }
    warp 1
  }
  test 1
}

