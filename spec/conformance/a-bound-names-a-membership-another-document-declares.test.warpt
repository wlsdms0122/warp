warpt 1
{
  documents [
    {
      constraints {
        "Num.Scalar" [
          "int"
          "string"
        ]
      }
      imports []
      procedures {
        "Num.nothing" {}
      }
      warp 1
    }
  ]
  expect {
    answers "k"
  }
  name "a-bound-names-a-membership-another-document-declares"
  note "A membership is declared once under a name, and a signature in another document bounds a type parameter by it the way it would by its own: the name is listed in imports, and the bound holds the parameter to what the membership admits."
  program {
    imports [
      "Num.Scalar"
    ]
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              "k"
            ]
            procedure "keep"
          }
        }
        returns "string"
      }
      keep {
        bounds {
          T "Num.Scalar"
        }
        parameters [
          {
            name "value"
            type "some T"
          }
        ]
        result {
          ref "value"
        }
        returns "some T"
      }
    }
    warp 1
  }
  test 1
}

