warpt 1
{
  expect {
    answers 2
  }
  name "a-local-list-of-a-parameter-handed-in-place-beside-a-member-value-answers"
  note "app.g hands ys, its own list of T, in place to std.collection.append beside 5. ys is no parameter handed in place, so the call takes 5 as a write into ys would, and app.g answers the count."
  program {
    imports [
      "std.Numeric"
      "std.collection.append"
      "std.collection.count"
    ]
    procedures {
      "app.g" {
        body [
          {
            value [
              {
                ref "n"
              }
            ]
            var "ys"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                  5
                ]
                procedure "std.collection.append"
              }
            }
          }
        ]
        bounds {
          T "std.Numeric"
        }
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "ys"
              }
            ]
            procedure "std.collection.count"
          }
        }
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  2.5
                ]
                procedure "app.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

