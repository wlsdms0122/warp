warpt 1
{
  expect {
    answers 2
  }
  name "a-local-list-of-a-parameter-handed-in-place-beside-a-member-value-answers"
  note "App.g hands ys, its own list of T, in place to Standard.Collection.append beside 5. ys is no parameter handed in place, so the call takes 5 as a write into ys would, and App.g answers the count."
  program {
    imports [
      "Standard.Collection.append"
      "Standard.Collection.count"
      "Standard.Numeric"
    ]
    procedures {
      "App.g" {
        body [
          {
            value [
              {
                ref "n"
              }
            ]
            var "ys"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "ys"
                  }
                  5
                ]
                procedure "Standard.Collection.append"
              }
            }
          }
        ]
        bounds {
          T "Standard.Numeric"
        }
        parameters [
          {
            name "n"
            type "some T"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "ys"
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  2.5
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

