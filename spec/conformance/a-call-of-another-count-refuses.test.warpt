warpt 1
{
  expect {
    refuses "build"
  }
  name "a-call-of-another-count-refuses"
  note "A call hands its arguments by position, and `plain` takes one. A second argument would stand at a position `plain` does not have, and the build says so rather than dropping it."
  program {
    imports []
    procedures {
      entry {
        access "public"
        result {
          call {
            arguments [
              7
              8
            ]
            procedure "plain"
          }
        }
        returns "int"
      }
      plain {
        parameters [
          {
            name "value"
            type "int"
          }
        ]
        result {
          ref "value"
        }
        returns "int"
      }
    }
    warp 1
  }
  test 1
}

