warpt 1
{
  expect {
    answers [
      []
      [
        1
      ]
    ]
  }
  name "a-list-literal-answered-at-a-parameter-of-memberships-that-name-each-other-answers"
  note "`App.M` admits `App.N` and `Array<Array<Int>>`, and `App.N` admits `App.M` and `Bool`. `App.g` bounds `T` by `App.M` and answers the literal `[[], [i]]` as `some T`. A value of `T` is one every member of `App.M` takes, and asking `App.N` for it is not asking `App.M` of it again: `App.N` takes it through `App.M`, whose `Array<Array<Int>>` takes it part by part. So the build takes the answer, and the run answers `[[], [1]]`."
  program {
    constraints {
      "App.M" [
        "App.N"
        "Array<Array<Int>>"
      ]
      "App.N" [
        "App.M"
        "Bool"
      ]
    }
    imports []
    procedures {
      "App.g" {
        bounds {
          T "App.M"
        }
        parameters [
          {
            name "x"
            type "some T"
          }
          {
            name "i"
            type "Int"
          }
        ]
        result [
          []
          [
            {
              ref "i"
            }
          ]
        ]
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  [
                    [
                      1
                    ]
                  ]
                  1
                ]
                procedure "App.g"
              }
            }
          }
        ]
        result {
          ref "r"
        }
      }
    }
    warp 1
  }
  test 1
}

