(test 1)
(name "a-name-that-says-nothing-is-the-type-its-value-reads-as")
(note "The name `step` declares nothing, so it is the type its value reads as, and the closure literal declares `const` and `isolated`, so `step` is `const isolated (Int) -> Int`. An `inout` slot asks for the same type the name is, and `swap` says `(Int) -> Int`, so the two are not one type and the build refuses.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (var step
        (closure
          (const)
          (isolated)
          (parameter x (type Int))
          (returns Int)
          (body
            (return x))))
      (call swap step)
      (return 1)))
  (procedure swap
    (const)
    (isolated)
    (parameter step (type (inout (procedure (parameters Int) (returns Int)))))))
(expect (refuses build))
