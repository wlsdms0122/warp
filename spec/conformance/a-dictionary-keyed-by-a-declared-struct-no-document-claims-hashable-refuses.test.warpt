(test 1)
(name "a-dictionary-keyed-by-a-declared-struct-no-document-claims-hashable-refuses")
(note "A declared struct conforms to `Hashable` only where a document claims it does. No document here does, so the dictionary keyed by it refuses at the build.")

(program
  (warp 1)
  (struct App.Point
    (field x Int))
  (procedure App.f
    (parameter m (type (dictionary App.Point Int)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
