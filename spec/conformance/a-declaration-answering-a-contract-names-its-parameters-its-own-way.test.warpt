(test 1)
(name "a-declaration-answering-a-contract-names-its-parameters-its-own-way")
(note "A call through a contract hands its arguments by position, so a declaration answering it takes them at the contract's positions under names of its own: `Bank.Account.describe` calls what `App.Describable` calls `label` its `prefix`.")

(program
  (warp 1)
  (struct Bank.Account
    (satisfies App.Describable)
    (field balance Int)
    (procedure describe
      (parameter account (type Bank.Account))
      (parameter prefix (type String))
      (returns String)
      (body
        (return prefix))))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (parameter label (type String))
      (returns String)))
  (procedure App.tell
    (parameter it (type (some T App.Describable)))
    (returns String)
    (body
      (return (call App.Describable.describe it "hi"))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let account (as (struct (field balance 1)) Bank.Account))
      (return (call App.tell account)))))
(expect (answers "hi"))
