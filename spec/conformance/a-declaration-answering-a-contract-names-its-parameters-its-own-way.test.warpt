warpt 1
{
  expect {
    answers "hi"
  }
  name "a-declaration-answering-a-contract-names-its-parameters-its-own-way"
  note "A call through a contract hands its arguments by position, so a declaration answering it takes them at the contract's positions under names of its own: `Bank.Account.describe` calls what `App.Describable` calls `label` its `prefix`."
  program {
    contracts {
      "App.Describable" {
        procedures {
          describe {
            parameters [
              {
                name "of"
                type "Self"
              }
              {
                name "label"
                type "String"
              }
            ]
            returns "String"
          }
        }
      }
    }
    imports []
    procedures {
      "App.tell" {
        parameters [
          {
            name "it"
            type "some T: App.Describable"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "it"
              }
              "hi"
            ]
            procedure "App.Describable.describe"
          }
        }
        returns "String"
      }
      entry {
        access "public"
        body [
          {
            let "account"
            value {
              as {
                of {
                  struct {
                    balance 1
                  }
                }
                type "Bank.Account"
              }
            }
          }
        ]
        failing [
          "cast_refused"
        ]
        result {
          call {
            arguments [
              {
                ref "account"
              }
            ]
            procedure "App.tell"
          }
        }
        returns "String"
      }
    }
    types {
      "Bank.Account" {
        procedures {
          describe {
            parameters [
              {
                name "account"
                type "Bank.Account"
              }
              {
                name "prefix"
                type "String"
              }
            ]
            result {
              ref "prefix"
            }
            returns "String"
          }
        }
        satisfies [
          "App.Describable"
        ]
        struct {
          balance "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

