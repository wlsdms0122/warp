(test 1)
(name "an-object-whose-struct-fields-stand-out-of-name-order-refuses")
(note "A struct value writes its field names in name order, the order the writing puts them in. Here `seen` starts a run holding an `App.R` written with `b` before `a`, which a reading refuses: one that took the fields in any order would read two writings as one object.")
(object (dictionary (entry "addressTable" (array (array 0 (array)))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"a58a34716614997dfe79be5333b9ba694e1281fe041e3414794d97fcf1e72ee5")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0))) (entry "rows" (array (array "entry" (array (array) 2 (array 1 (array)) 0 1 (array) (array)) 2 (array 0 (array (array) (array 0)) (array 1 (array) (array (array 0 0)) (array) (array "seen")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 4) (array 14 "App.R"))) (entry "types" (array (array "App.R" (array 9 (array (array "a" 0) (array "b" 1)))))) (entry "valueTable" (array (array 2 2) (array 2 1) (array 7 "App.R" (array "b" "a") (array 0 1)))) (entry "variables" (array (array "seen" 2)))))
(expect (refuses load))
