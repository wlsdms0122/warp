warpt 1
{
  expect {
    refuses "build"
  }
  name "a-borrow-handed-to-a-consuming-slot-refuses"
  note "A body that borrowed a value written `linear` never took the obligation, so it has none to hand to a slot that says `consuming`."
  program {
    imports [
      "App.Handle"
      "App.close"
      "App.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "App.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "give"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
      }
      give {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure "App.close"
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "borrowing App.Handle"
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
      "App.open" {
        answers App.Handle {
          name "f"
        }
        returns "App.Handle"
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

