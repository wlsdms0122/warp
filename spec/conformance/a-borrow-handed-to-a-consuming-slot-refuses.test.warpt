warpt 1
{
  expect {
    refuses "build"
  }
  name "a-borrow-handed-to-a-consuming-slot-refuses"
  note "A body that borrowed a value written `linear` never took the obligation, so it has none to hand to a slot that says `consuming`."
  program {
    imports [
      "app.Handle"
      "app.close"
      "app.open"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "handle"
            value {
              call {
                procedure "app.open"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "give"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "handle"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
      }
      give {
        body [
          {
            value {
              call {
                arguments [
                  {
                    ref "of"
                  }
                ]
                procedure "app.close"
              }
            }
          }
        ]
        parameters [
          {
            name "of"
            type "borrowing app.Handle"
          }
        ]
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "app.close" {
        parameters [
          {
            name "first"
            type "consuming app.Handle"
          }
        ]
        runs true
      }
      "app.open" {
        answers app.Handle {
          name "f"
        }
        returns "app.Handle"
      }
    }
    types {
      "app.Handle" {
        linear {
          record {
            name "string"
          }
        }
      }
    }
  }
}

