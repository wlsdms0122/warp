warpt 1
{
  expect {
    answers [
      3
      2
      -3
      3
      -3
    ]
  }
  name "absolute-floored-and-rounded-shape-a-number"
  note "absolute drops the sign and keeps the kind; floored goes toward the smaller whole even below zero; rounded goes to the nearest whole, away from zero at the halfway."
  program {
    needs [
      "std.math.absolute"
      "std.math.floored"
      "std.math.rounded"
    ]
    procedures {
      entry {
        body [
          {
            call {
              of -3
              procedure "std.math.absolute"
            }
            id "sized"
          }
          {
            call {
              of 2.9
              procedure "std.math.floored"
            }
            id "down"
          }
          {
            call {
              of -2.1
              procedure "std.math.floored"
            }
            id "below"
          }
          {
            call {
              of 2.5
              procedure "std.math.rounded"
            }
            id "near"
          }
          {
            call {
              of -2.5
              procedure "std.math.rounded"
            }
            id "nearBelow"
          }
        ]
        result [
          {
            ref "sized"
          }
          {
            ref "down"
          }
          {
            ref "below"
          }
          {
            ref "near"
          }
          {
            ref "nearBelow"
          }
        ]
      }
    }
    warp 1
  }
  test 1
}
