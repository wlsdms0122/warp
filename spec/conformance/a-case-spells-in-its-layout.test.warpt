(test 1)
(name "a-case-spells-in-its-layout")
(note "A case's top is laid out as a document's is, one node a line and a blank line before each node that breaks. `documents`, each `document` in it and `program` are blocks, and inside a block a node that breaks takes no blank line before it.")
(text "(test 1)\n(name \"a-call-into-a-document-beside\")\n(note \"…\")\n\n(documents\n  (document\n    (warp 1)\n    (procedure Lib.one\n      (access public)\n      (returns Int)\n      (result 1))))\n\n(program\n  (warp 1)\n  (import Lib.one)\n  (procedure entry\n    (access public)\n    (returns Int)\n    (result (call Lib.one))))\n(expect (answers 1))\n")
(expect (spells (dictionary (entry "documents" (array (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "Lib.one" (dictionary (entry "access" "public") (entry "result" 1) (entry "returns" "Int"))))) (entry "warp" 1)))) (entry "expect" (dictionary (entry "answers" 1))) (entry "name" "a-call-into-a-document-beside") (entry "note" "…") (entry "program" (dictionary (entry "imports" (array "Lib.one")) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "result" (dictionary (entry "call" (dictionary (entry "procedure" "Lib.one"))))) (entry "returns" "Int"))))) (entry "warp" 1))) (entry "test" 1))))
