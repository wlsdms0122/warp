warpt 1
{
  expect {
    answers [
      true
      false
    ]
  }
  name "regex-finds-a-match-anywhere"
  note "regex answers whether the pattern matches anywhere in the text — a program that asks about the whole anchors the pattern itself."
  program {
    imports [
      "std.text.regex"
    ]
    procedures {
      entry {
        body [
          {
            let "anywhere"
            value {
              call {
                arguments {
                  value "[0-9]"
                }
                of "warp-1"
                procedure "std.text.regex"
              }
            }
          }
          {
            let "anchored"
            value {
              call {
                arguments {
                  value "^[0-9]+$"
                }
                of "warp-1"
                procedure "std.text.regex"
              }
            }
          }
        ]
        result [
          {
            ref "anywhere"
          }
          {
            ref "anchored"
          }
        ]
      }
    }
    warp 2
  }
  test 1
}
