warpt 1
{
  expect {
    answers 2
  }
  name "an-answer-of-all-settles-into-the-record-declared"
  note "What `all` answers holds each piece's answer under the key the piece stood under, so the author declares a record type with those keys and settles the answer into it, the way any answer read through `any` is settled at the boundary."
  program {
    imports [
      "Standard.Concurrent.all"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "both"
            value {
              as {
                of {
                  call {
                    arguments [
                      {
                        record {
                          left {
                            closure {
                              result 1
                            }
                          }
                          right {
                            closure {
                              result 2
                            }
                          }
                        }
                      }
                    ]
                    procedure "Standard.Concurrent.all"
                  }
                }
                type "Answers"
              }
            }
          }
        ]
        result {
          ref "both.right"
        }
        returns "int"
      }
    }
    types {
      Answers {
        record {
          left "int"
          right "int"
        }
      }
    }
    warp 1
  }
  test 1
}

