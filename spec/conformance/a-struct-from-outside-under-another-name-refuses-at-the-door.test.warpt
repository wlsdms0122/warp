(test 1)
(name "a-struct-from-outside-under-another-name-refuses-at-the-door")
(note "The entry declares `Account`, and the host hands a `Vault` of the same fields. A declared struct fits only its own name, and the door fits a value's fields and never its name, so the run refuses it.")

(program
  (warp 1)
  (struct Account
    (field balance Int))
  (struct Vault
    (field balance Int))
  (procedure entry
    (access public)
    (parameter a (type Account))
    (returns Account)
    (body
      (return a))))
(arguments (argument a (struct Vault (field balance 3))))
(expect (refuses run))
