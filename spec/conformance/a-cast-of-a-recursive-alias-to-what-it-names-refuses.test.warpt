warpt 1
{
  expect {
    refuses "build"
  }
  name "a-cast-of-a-recursive-alias-to-what-it-names-refuses"
  note "`App.L` names `array<App.L>`, a list of itself. `xs` is read as `App.L`, and the cast names `array<App.L>`, which is what `App.L` names. The cast names what the reading already is, so it refuses at the build."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "xs"
            type "App.L"
            value []
          }
          {
            let "g"
            value {
              as {
                of {
                  ref "xs"
                }
                type "array<App.L>"
              }
            }
          }
        ]
        result {
          ref "g"
        }
      }
    }
    types {
      "App.L" "array<App.L>"
    }
    warp 1
  }
  test 1
}

