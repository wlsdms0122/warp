warpt 1
{
  expect {
    refuses "build"
  }
  name "an-enum-with-a-dead-candidate-refuses"
  note "A dead candidate is a member no call could ever match. '007' is a second spelling of a number that already has one, and a live member beside it does not excuse it. The declaration's own facts are judged where they are written."
  program {
    imports []
    procedures {
      entry {
        access "public"
        parameters [
          {
            enum [
              "1"
              "007"
            ]
            name "level"
            type "Int"
          }
        ]
        result {
          ref "level"
        }
      }
    }
    warp 1
  }
  test 1
}

