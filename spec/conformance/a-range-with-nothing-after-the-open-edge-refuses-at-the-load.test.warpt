warpt 1
{
  expect {
    refuses "load"
  }
  name "a-range-with-nothing-after-the-open-edge-refuses-at-the-load"
  note "`..<` leaves the far bound outside the range, so something has to stand after it. `int(0..<)` names no far bound and is refused where the document is read."
  program {
    imports []
    procedures {
      entry {
        parameters {
          item {
            type "int(0..<)"
          }
        }
        result 1
        returns "int"
      }
    }
    warp 1
  }
  test 2
}

