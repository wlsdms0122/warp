warpt 1
{
  expect {
    refuses "build"
  }
  name "a-closure-literal-handed-to-a-called-value-answers-what-the-slot-answers-refuses"
  note "`g` takes `Procedure() -> App.Point`, and the closure literal a call of `g` hands it writes no `returns`, so it answers what the slot answers. Its body answers `{ x: 1, y: 2 }`, which is no `App.Point`, so it refuses at the build as the same closure written at a name declaring that type does."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "g"
            type {
              procedure {
                parameters [
                  {
                    procedure {
                      returns "App.Point"
                    }
                  }
                ]
                returns "App.Point"
              }
            }
            value {
              closure {
                parameters [
                  {
                    name "h"
                    type {
                      procedure {
                        returns "App.Point"
                      }
                    }
                  }
                ]
                result {
                  call {
                    procedure {
                      ref "h"
                    }
                  }
                }
                returns "App.Point"
              }
            }
          }
          {
            let "c"
            value {
              call {
                arguments [
                  {
                    closure {
                      result {
                        record {
                          x 1
                          y 2
                        }
                      }
                    }
                  }
                ]
                procedure {
                  ref "g"
                }
              }
            }
          }
        ]
        result {
          ref "c"
        }
      }
    }
    types {
      "App.Point" {
        record {
          x "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

