warpt 1
{
  arguments {
    trees []
  }
  expect {
    refuses "build"
  }
  name "a-parameter-read-as-a-declared-record-and-as-a-record-of-its-fields-refuses"
  note "A type parameter read as a declared record's name by one argument and as a nameless record of its fields by the next is read two ways: a declared record is its name, and a record literal written at a type parameter takes none, so the two are two types and the call refuses at the build."
  program {
    imports [
      "Standard.Collection.appending"
    ]
    procedures {
      entry {
        access "public"
        parameters [
          {
            name "trees"
            type "Array<Tree>"
          }
        ]
        result {
          call {
            arguments [
              {
                ref "trees"
              }
              {
                record {
                  a 1
                }
              }
            ]
            procedure "Standard.Collection.appending"
          }
        }
      }
    }
    types {
      Tree {
        record {
          a "Int"
        }
      }
    }
    warp 1
  }
  test 1
}

