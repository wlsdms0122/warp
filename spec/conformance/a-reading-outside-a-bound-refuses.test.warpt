(test 1)
(name "a-reading-outside-a-bound-refuses")
(note "Both sides of lessThan agree, and agreement is not answering: Int, Double and String answer Comparable, and these readings are booleans the build can see. The sameness half and the bound half are both said before anything runs.")

(program
  (warp 1)
  (import Standard.Comparable.lessThan)
  (procedure entry
    (access public)
    (returns Bool)
    (result (call Standard.Comparable.lessThan true false))))
(expect (refuses build))
