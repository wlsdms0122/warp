warpt 1
{
  expect {
    refuses "build"
  }
  name "a-claim-naming-a-contract-where-the-type-belongs-refuses"
  note "A claim is keyed by a type and names contracts. This one is keyed by the contract `App.X` and names the type `Bank.A`, so it refuses at the build, at the claim, though nothing leans on it."
  program {
    contracts {
      "App.X" {
        d {
          parameters [
            {
              name "of"
              type "App.X"
            }
          ]
          returns "string"
        }
      }
    }
    imports []
    procedures {
      "Bank.A.d" {
        parameters [
          {
            name "of"
            type "Bank.A"
          }
        ]
        result "a"
        returns "string"
      }
      entry {
        access "public"
        result 1
      }
    }
    satisfies {
      "App.X" [
        "Bank.A"
      ]
    }
    types {
      "Bank.A" {
        record {
          n "int"
        }
      }
    }
    warp 1
  }
  test 1
}

