(test 1)
(name "a-claim-naming-a-contract-where-the-type-belongs-refuses")
(note "A claim is keyed by a type and names contracts. This one is keyed by the contract `App.X` and names the type `Bank.A`, so it refuses at the build, at the claim, though nothing asks the contract of the type.")

(program
  (warp 1)
  (struct Bank.A
    (field n Int))
  (contract App.X
    (procedure d
      (parameter of (type Self))
      (returns String)))
  (extension
    (head App.X)
    (satisfies Bank.A))
  (procedure Bank.A.d
    (parameter of (type Bank.A))
    (returns String)
    (body
      (return "a")))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
