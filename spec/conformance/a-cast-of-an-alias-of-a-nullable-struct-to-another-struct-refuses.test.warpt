(test 1)
(name "a-cast-of-an-alias-of-a-nullable-struct-to-another-struct-refuses")
(note "`App.A` and `App.B` are both declared `{ a: String }`, and `App.NA` stands for `App.A?`. `n` is read as `App.NA`, which names `App.A` through the alias, so a value of it is one of `App.B` only if it is null, and `App.B` does not take null. No value is both, so the cast `n as App.B` refuses at the build.")

(program
  (warp 1)
  (struct App.A
    (field a String))
  (struct App.B
    (field a String))
  (type App.NA (nullable App.A))
  (type App.NB (nullable App.B))
  (procedure entry
    (access public)
    (returns App.B)
    (failing cast_refused)
    (body
      (let n (type App.NA) (struct (field a "x")))
      (let b (as n App.B))
      (return b))))
(expect (refuses build))
