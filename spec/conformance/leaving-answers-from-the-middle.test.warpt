(test 1)
(name "leaving-answers-from-the-middle")
(note "Answering from inside a body leaves the procedure with what it carries. The statements and result after the leave never run.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns String)
    (body
      (conditional
        (when true)
        (then
          (return "left early"))))
    (result "went on")))
(expect (answers "left early"))
