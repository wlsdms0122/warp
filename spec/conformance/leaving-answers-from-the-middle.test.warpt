warpt 1
{
  expect {
    answers "left early"
  }
  name "leaving-answers-from-the-middle"
  note "Answering from inside a body leaves the procedure with what it carries. The statements and result after the leave never run."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            value {
              conditional {
                then [
                  {
                    value {
                      return "left early"
                    }
                  }
                ]
                when true
              }
            }
          }
        ]
        result "went on"
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

