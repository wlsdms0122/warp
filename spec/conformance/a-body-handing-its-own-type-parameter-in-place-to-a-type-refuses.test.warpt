warpt 1
{
  expect {
    refuses "build"
  }
  name "a-body-handing-its-own-type-parameter-in-place-to-a-type-refuses"
  note "A declaration holds a value of its type parameter T in a variable and hands it in place to a parameter declared Int. In place the two sides are one type, and T is not Int inside the declaration."
  program {
    imports [
      "Standard.Text.uppercased"
    ]
    procedures {
      "App.gen" {
        body [
          {
            value {
              ref "x"
            }
            var "y"
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "y"
                  }
                ]
                procedure "App.poke"
              }
            }
          }
        ]
        parameters [
          {
            name "x"
            type "some T"
          }
        ]
        result {
          ref "y"
        }
        returns "some T"
      }
      "App.poke" {
        body [
          {
            set "v"
            value 7
          }
        ]
        parameters [
          {
            name "v"
            type "inout Int"
          }
        ]
        result 0
        returns "Int"
      }
      entry {
        access "public"
        body [
          {
            let "r"
            value {
              call {
                arguments [
                  "s"
                ]
                procedure "App.gen"
              }
            }
          }
          {
            let "u"
            value {
              call {
                arguments [
                  {
                    ref "r"
                  }
                ]
                procedure "Standard.Text.uppercased"
              }
            }
          }
        ]
        result {
          ref "u"
        }
        returns "String"
      }
    }
    warp 1
  }
  test 1
}

