warpt 1
{
  expect {
    answers 1
  }
  name "a-call-that-fails-after-writing-has-written"
  note "The box is the caller's, so a write made before the callee fails is a write the caller sees after the rescue."
  program {
    imports [
      "Standard.Control.abort"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            value 0
            var "n"
          }
          {
            let "tried"
            value {
              attempt {
                body [
                  {
                    value {
                      call {
                        arguments [
                          {
                            ref "n"
                          }
                        ]
                        procedure "poke"
                      }
                    }
                  }
                ]
                rescue {
                  body [
                    {
                      let "seen"
                      value 1
                    }
                  ]
                }
              }
            }
          }
        ]
        result {
          ref "n"
        }
        returns "Int"
      }
      poke {
        body [
          {
            set "count"
            value 1
          }
          {
            value {
              call {
                arguments [
                  "after writing"
                ]
                procedure "Standard.Control.abort"
              }
            }
          }
        ]
        parameters [
          {
            name "count"
            type "inout Int"
          }
        ]
        returns "Never"
      }
    }
    warp 1
  }
  test 1
}

