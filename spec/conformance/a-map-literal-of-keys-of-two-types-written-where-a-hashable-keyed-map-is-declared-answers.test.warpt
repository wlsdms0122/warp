warpt 1
{
  expect {
    answers 2
  }
  name "a-map-literal-of-keys-of-two-types-written-where-a-hashable-keyed-map-is-declared-answers"
  note "Where the place declares a map, each key is held to the key it declares, and a whole number and a text each answer `Hashable`, so the literal holds both."
  program {
    imports [
      "Standard.Collection.count"
    ]
    procedures {
      entry {
        access "public"
        body [
          {
            let "d"
            type "Dictionary<Hashable, String>"
            value {
              dictionary [
                [
                  1
                  "a"
                ]
                [
                  "b"
                  "c"
                ]
              ]
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "d"
              }
            ]
            procedure "Standard.Collection.count"
          }
        }
        returns "Int"
      }
    }
    warp 1
  }
  test 1
}

