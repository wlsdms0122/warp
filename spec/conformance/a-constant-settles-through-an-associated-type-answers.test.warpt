(test 1)
(name "a-constant-settles-through-an-associated-type-answers")
(note "A constant settles at the build from a call through a contract asking its procedure to answer without running, and its type is the associated type the box of Int gives.")

(documents
  (document
    (warp 1)
    (contract Lib.Held
      (type Item)
      (procedure first
        (const)
        (parameter of (type Self))
        (returns Self.Item))))
  (document
    (warp 1)
    (import Lib.Held)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Held)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (const)
        (isolated)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (result (path of (field item)))))))

(program
  (warp 1)
  (import App.Box)
  (import Int.plus)
  (import Lib.Held.first)
  (const k (call Lib.Held.first (as (struct (field item 1)) (named App.Box Int))))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (result (call Int.plus k 1))))
(expect (answers 2))
