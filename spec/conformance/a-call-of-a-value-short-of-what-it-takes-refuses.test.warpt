warpt 1
{
  expect {
    refuses "build"
  }
  name "a-call-of-a-value-short-of-what-it-takes-refuses"
  note "Calling a value hands exactly what its type takes, the way a call does. A position whose type declares null is handed like any other, so a call of `pair` with one argument is refused where it is written."
  program {
    imports []
    procedures {
      entry {
        access "public"
        body [
          {
            let "pair"
            value {
              closure {
                parameters [
                  {
                    name "a"
                    type "Int"
                  }
                  {
                    name "b"
                    type "String?"
                  }
                ]
                result {
                  ref "b"
                }
                returns "String?"
              }
            }
          }
          {
            let "made"
            value {
              call {
                arguments [
                  1
                ]
                procedure {
                  ref "pair"
                }
              }
            }
          }
        ]
        failing "anything"
        result {
          ref "made"
        }
        returns "String?"
      }
    }
    warp 1
  }
  test 1
}

