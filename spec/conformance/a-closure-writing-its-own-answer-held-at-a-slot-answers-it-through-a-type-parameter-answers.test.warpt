(test 1)
(name "a-closure-writing-its-own-answer-held-at-a-slot-answers-it-through-a-type-parameter-answers")
(note "The closure writes `returns Bank.A` and is held at `() -> Bank.A`, the answer it already gives. `App.run` takes `() -> some T`, so `v` reads as `Bank.A`, the closure's own `returns` names the struct it answers, and `App.P.show` reaches `Bank.A.show`.")

(program
  (warp 1)
  (struct Bank.A
    (satisfies App.P)
    (field k String)
    (procedure show
      (const)
      (isolated)
      (parameter of (type Bank.A))
      (returns String)
      (body
        (return "a"))))
  (contract App.P
    (procedure show
      (const)
      (isolated)
      (parameter of (type Self))
      (returns String)))
  (procedure App.run
    (parameter c (type (procedure (parameters) (returns (some T)))))
    (returns (some T))
    (body
      (return (apply c))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let c
        (type (procedure (parameters) (returns Bank.A)))
        (closure
          (const)
          (isolated)
          (returns Bank.A)
          (body
            (return (struct (field k "x"))))))
      (let v (call App.run c))
      (return (call App.P.show v)))))
(expect (answers "a"))
