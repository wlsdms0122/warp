warpt 1
{
  expect {
    answers "a"
  }
  name "a-closure-writing-its-own-answer-held-at-a-slot-answers-it-through-a-type-parameter-answers"
  note "The closure writes `returns Bank.A` and is held at `{ procedure: { returns: Bank.A } }`, the answer it already gives. `App.run` takes `{ procedure: { returns: some T } }`, so `v` reads as `Bank.A`, the closure's own `returns` names the struct it answers, and `App.P.show` reaches `Bank.A.show`."
  program {
    contracts {
      "App.P" {
        show {
          const true
          isolated true
          parameters [
            {
              name "of"
              type "Self"
            }
          ]
          returns "String"
        }
      }
    }
    imports []
    procedures {
      "App.run" {
        parameters [
          {
            name "c"
            type {
              procedure {
                returns "some T"
              }
            }
          }
        ]
        result {
          call {
            procedure {
              ref "c"
            }
          }
        }
        returns "some T"
      }
      entry {
        access "public"
        body [
          {
            let "c"
            type {
              procedure {
                returns "Bank.A"
              }
            }
            value {
              closure {
                result {
                  struct {
                    k "x"
                  }
                }
                returns "Bank.A"
              }
            }
          }
          {
            let "v"
            value {
              call {
                arguments [
                  {
                    ref "c"
                  }
                ]
                procedure "App.run"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              {
                ref "v"
              }
            ]
            procedure "App.P.show"
          }
        }
      }
    }
    types {
      "Bank.A" {
        procedures {
          show {
            parameters [
              {
                name "of"
                type "Bank.A"
              }
            ]
            result "a"
            returns "String"
          }
        }
        satisfies [
          "App.P"
        ]
        struct {
          k "String"
        }
      }
    }
    warp 1
  }
  test 1
}

