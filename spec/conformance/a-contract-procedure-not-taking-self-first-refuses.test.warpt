(test 1)
(name "a-contract-procedure-not-taking-self-first-refuses")
(note "A contract's procedure dispatches on the value it takes first, and that value is of the type conforming to the contract, written `Self`. One taking a string first names no value a call could dispatch on, which the contract's text says alone, so it refuses at the load.")

(program
  (warp 1)
  (contract App.Named
    (procedure name
      (parameter of (type String))
      (returns String)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
