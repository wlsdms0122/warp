warpt 1
{
  expect {
    refuses "run"
  }
  name "a-value-calls-answer-is-judged-against-the-returns-its-slot-wrote-refuses"
  note "app.callIt takes a procedure that answers int and calls it. The closure handed to it answers any, and what it answers is text, so the answer is judged as an int where the call reads it."
  program {
    imports [
      "std.collection.appending"
    ]
    procedures {
      "app.callIt" {
        body [
          {
            let "v"
            value {
              call {
                procedure {
                  ref "f"
                }
              }
            }
          }
        ]
        parameters [
          {
            name "f"
            type {
              procedure {
                returns "int"
              }
            }
          }
        ]
        result {
          call {
            arguments [
              [
                1
              ]
              {
                ref "v"
              }
            ]
            procedure "std.collection.appending"
          }
        }
        returns "any"
      }
      entry {
        access "public"
        body [
          {
            let "xs"
            value {
              call {
                arguments [
                  {
                    closure {
                      result "s"
                      returns "any"
                    }
                  }
                ]
                procedure "app.callIt"
              }
            }
          }
        ]
        result {
          ref "xs"
        }
      }
    }
    warp 1
  }
  test 1
}

