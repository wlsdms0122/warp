warpt 1
{
  expect {
    refuses "build"
  }
  name "a-part-of-a-linear-name-read-after-handing-it-on-refuses"
  note "`h` handed its value to `App.close`, and a name that handed its value on holds nothing, so reading `h.name` after it refuses."
  program {
    imports [
      "App.Handle"
      "App.close"
    ]
    procedures {
      "App.f" {
        body [
          {
            let "h"
            type "App.Handle"
            value {
              record {
                name "f"
              }
            }
          }
          {
            value {
              call {
                arguments [
                  {
                    ref "h"
                  }
                ]
                procedure "App.close"
              }
            }
          }
          {
            let "n"
            type "String"
            value {
              ref "h.name"
            }
          }
        ]
        result {
          ref "n"
        }
        returns "String"
      }
      entry {
        access "public"
        result {
          call {
            procedure "App.f"
          }
        }
        returns "Any"
      }
    }
    warp 1
  }
  test 1
  vocabulary {
    procedures {
      "App.close" {
        parameters [
          {
            name "first"
            type "consuming App.Handle"
          }
        ]
        runs true
      }
    }
    types {
      "App.Handle" {
        linear {
          record {
            name "String"
          }
        }
      }
    }
  }
}

