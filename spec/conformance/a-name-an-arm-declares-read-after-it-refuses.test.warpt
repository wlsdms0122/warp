(test 1)
(name "a-name-an-arm-declares-read-after-it-refuses")
(note "What an arm declares stays its own and dies with the arm. A reference after the conditional to a name only the arm declared reads a name that is not there.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (conditional
        (when true)
        (then
          (var inner 1)))
      (let read inner)
      (return read))))
(expect (refuses load))
