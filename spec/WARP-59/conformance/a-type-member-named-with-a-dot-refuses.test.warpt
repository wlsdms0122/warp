(test 1)
(name "a-type-member-named-with-a-dot-refuses")
(note "`some T.Item` writes a type member after a dot, so a type member is named by one identifier, and App.Box giving `Item.Key` refuses at the load.")
(documents)

(program
  (warp 1)
  (struct App.Box
    (field item Int)
    (type Item.Key Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
