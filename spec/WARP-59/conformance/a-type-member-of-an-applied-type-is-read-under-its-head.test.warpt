(test 1)
(name "a-type-member-of-an-applied-type-is-read-under-its-head")
(note "App.Wrapper gives Item as its own parameter T, so `App.Wrapper<String>.Item` reads T as String and is an alias of String. A parameter of that type takes \"a\".")

(program
  (warp 1)
  (struct App.Wrapper
    (typeParameter T)
    (field item (some T))
    (type Item (some T)))
  (procedure App.echo
    (parameter x (type (member (named App.Wrapper String) Item)))
    (returns String)
    (body
      (return x)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let echoed (call App.echo "a"))
      (return echoed))))
(expect (answers "a"))
