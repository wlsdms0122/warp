(test 1)
(name "an-overstated-imports-list-refuses")
(note "The imports list is the set of what the program sends, not a bound around it. A procedure listed but never sent asks for a grant the program has no use for.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
