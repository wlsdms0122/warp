(test 1)
(name "a-claim-about-int-another-document-makes-is-imported")
(note "A claim among the imports names the type a head is about, and `Int` is one. The program stands on no document making the claim about `Int`, and reaches it by importing `Int: App.Named`.")

(documents
  (document
    (warp 1)
    (contract App.Named
      (procedure name
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (import App.Named)
    (extension
      (head Int)
      (satisfies App.Named)
      (procedure name
        (parameter of (type Int))
        (returns String)
        (body
          (return "named"))))))

(program
  (warp 1)
  (import App.Named.name)
  (import Int App.Named)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let v (type Int) 1)
      (return (call App.Named.name v)))))
(expect (answers "named"))
