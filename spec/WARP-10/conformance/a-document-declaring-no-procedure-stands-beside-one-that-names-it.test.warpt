(test 1)
(name "a-document-declaring-no-procedure-stands-beside-one-that-names-it")
(note "A document may declare no procedure, and then writes no `procedures`. A document declaring only a type is read, and the program beside it lists the type it names and builds.")

(documents
  (document
    (warp 1)
    (struct Geo.Point
      (field x Int))))

(program
  (warp 1)
  (import Geo.Point)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let p (type Geo.Point) (struct (field x 2)))
      (return (path p (field x))))))
(expect (answers 2))
