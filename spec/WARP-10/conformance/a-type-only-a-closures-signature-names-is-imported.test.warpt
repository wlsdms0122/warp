(test 1)
(name "a-type-only-a-closures-signature-names-is-imported")
(note "The imports list holds the types a program names in a closure's signature. `Geo.Point` is named only in a closure's parameter type, and the list holds it.")

(documents
  (document
    (warp 1)
    (struct Geo.Point
      (field x Int))))

(program
  (warp 1)
  (import Geo.Point)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (closure
          (parameter p (type Geo.Point))
          (returns Int)
          (body
            (return 1))))
      (return 1))))
(expect (answers 1))
