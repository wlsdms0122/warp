(test 1)
(name "a-claim-import-whose-type-is-no-types-name-refuses")
(note "A claim among the imports is written as the type's name and the contract's. `T.Card<Int>` is a mention applying a type and no type's name, so the import refuses at the load.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (parameter of (type T.Card))
        (returns String)
        (body
          (return "card")))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))

(program
  (warp 1)
  (import App.Describable.describe)
  (import T.Card)
  (import T.Card<Int> App.Describable)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let card (as (struct (field rank 1)) T.Card))
      (return (call App.Describable.describe card)))))
(expect (refuses load))
