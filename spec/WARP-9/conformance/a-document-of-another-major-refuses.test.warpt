(test 1)
(name "a-document-of-another-major-refuses")
(note "A reader reads a document of its release's major alone. `\"1.0\"` names another major, and refuses at the load.")

(program
  (warp "1.0")
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
