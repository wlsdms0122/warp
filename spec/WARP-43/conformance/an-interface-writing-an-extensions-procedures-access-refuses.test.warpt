(test 1)
(name "an-interface-writing-an-extensions-procedures-access-refuses")
(note "A procedure in an interface, one an extension gives included, is its signature's nodes, so an extension's procedure writing an `access` refuses as a procedure at the top does.")
(text "(interface 1)\n(contract App.Named (procedure name (parameter of (type Self)) (returns String)))\n(extension (head Int) (satisfies App.Named) (procedure name (access public) (parameter of (type Int)) (returns String)))\n")
(expect (refuses load))
