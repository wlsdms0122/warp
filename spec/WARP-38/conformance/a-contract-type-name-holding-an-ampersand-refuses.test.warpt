(test 1)
(name "a-contract-type-name-holding-an-ampersand-refuses")
(note "A contract's `type` joins its names into one string, and a name that string reads back otherwise has no text there. The name `Item: A & B` writes the string `Item: A & B`, which reads back as `(type Item A B)`, so it refuses.")
(text "(warp 1)\n\n(contract App.Named\n  (type `Item: A & B`))\n")
(expect (refuses load))
