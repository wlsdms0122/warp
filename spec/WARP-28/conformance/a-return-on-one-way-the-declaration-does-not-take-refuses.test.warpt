(test 1)
(name "a-return-on-one-way-the-declaration-does-not-take-refuses")
(note "Every `return` is held to what the procedure declared. The last one fitting does not excuse one on another way through that carries something else, so the mismatch is refused where the return is written and never reaches a run.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (returns Int)
    (body
      (conditional
        (when ready)
        (then
          (return "x")))
      (return 0))))
(expect (refuses build))
