(test 1)
(name "a-break-naming-an-outer-loop-past-a-named-one-ends-the-outer-loop")
(note "The `break` stands in the loop `inner` and names `outer`, the loop around it. The outer loop ends there, and the statement after it runs.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var i (type Int) 0)
      (let outer
        (loop
          (while true)
          (body
            (let inner
              (loop
                (while true)
                (body
                  (set i (call Standard.Numeric.plus i 1))
                  (break outer)))))))
      (return i))))
(expect (answers 1))
