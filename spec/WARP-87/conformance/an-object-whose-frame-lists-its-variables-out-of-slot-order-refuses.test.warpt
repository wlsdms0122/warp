(test 1)
(name "an-object-whose-frame-lists-its-variables-out-of-slot-order-refuses")
(note "A frame lists the module variables its body reads in slot order, so one document has one object. The frame listing [[0, 1], [1, 0]], by the variables' order in `variables`, stands out of slot order, and the reading refuses it.")
(object (dictionary (entry "addressTable" (array (array 0 (array) false) (array 1 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f8091a2b")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 1 1) (array 2 (array 0 1)) (array 13 0 (array 2)))) (entry "rows" (array (array "entry" (array (array) 1 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array) 3)) (array 2 (array) (array (array 0 1) (array 1 0)) (array) (array) (array "b" "a")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 7 0))) (entry "types" (array)) (entry "valueTable" (array (array 2 1) (array 2 2))) (entry "variables" (array (array "a" 0) (array "b" 1)))))
(expect (refuses load))
