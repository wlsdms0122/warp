(test 1)
(name "an-object-whose-native-send-writes-its-spelling-as-a-number-refuses")
(note "A native row's send writes the spelling it reaches as a name, which the document's `numbering` numbers. The row `lone` writes its send of `Standard.Numeric.plus` as `0`, the number the numbering gives it, and the reading refuses it.")
(object (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"8af75591dda024dd54e03c9956e36ec1f1a655130299736cfaf4ba6828377f10")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "Standard.Numeric.plus") (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 13 0 (array 1)))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 0) (array (array) 2)) (array 1 (array) (array) (array) (array) (array "n")))) (array "lone" (array (array) 1 (array 0) 0 0 (array) (array)) 0 (array 1 (array (array 0 0 2)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4) (array 0))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
