(test 1)
(name "the-object-of-a-drop-a-promotion-and-steps-by-name-and-by-slot")
(note "A contract value meeting `Any` drops its types, coercion `[1]`, and a list of `Int?` meeting a list of `App.Described??` holds each element beside `Int` and then promotes each element as its some, `[2, [[0, …]], [0]]`. A dot past `Null` stands by name, `[1, name, optional]`, as the build laid out no struct there, and a key read from a slot into a dictionary keyed by `Int??` stands as `[3, address, true, [[2, [], []]]]`, the key promoted where it lands.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a number"))))
  (procedure entry
    (access public)
    (parameter d (type App.Described))
    (parameter k (type (optional Int)))
    (parameter n (type Null))
    (parameter os (type (array (optional Int))))
    (parameter t (type (optional (dictionary (optional (optional Int)) Int))))
    (returns (array Any))
    (body
      (let dropped (type Any) d)
      (let wrapped (type (array (optional (optional App.Described)))) os)
      (let past (path n (field? x) (field y)))
      (let keyed (path t (index? k)))
      (return (array dropped wrapped past keyed)))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false) (array 3 (array) false) (array 2 (array (array 1 "x" true) (array 1 "y" false)) false) (array 1 (array) false) (array 4 (array (array 3 3 true (array (array 2 (array) (array))))) false) (array 5 (array) false) (array 6 (array) false) (array 7 (array) false) (array 8 (array) false))) (entry "claims" (array (array "Int" (array "App.Described")))) (entry "constants" (array)) (entry "contracts" (array (array "App.Described" (array (array) (array) (array (array "describe" (array (array (array "of" (array 0))) 1 (array 1 (array)) 0 0 (array) (array)))))))) (entry "dependencies" (array)) (entry "document" (array x"983780e32e8c9d3074eb91b9318d536ee7d3586117e3f540ba08a06ea13c72f6")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 4) (array 13 0) (array 7 1) (array 16 (array "App.Described")) (array 13 3) (array 13 4) (array 7 5))) (entry "members" (array (array "Int" (array "describe")))) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 13 0 (array 0)) (array 1 0) (array 15 2 (array 1)) (array 1 1) (array 15 4 (array 2 (array (array 0 2 6)) (array 0))) (array 1 2) (array 1 4) (array 1 5) (array 1 6) (array 15 9 (array 1)) (array 1 7) (array 1 8) (array 2 (array 8 10 11 12)) (array 13 0 (array 13)))) (entry "rows" (array (array "Int.describe" (array (array (array "of" (array 2))) 3 (array 1 (array)) 0 0 (array) (array)) 1 (array 0 (array (array (array) 1)) (array 1 (array 0) (array) (array) (array) (array "of")))) (array "entry" (array (array (array "d" (array 4)) (array "k" (array 6)) (array "n" (array 7)) (array "os" (array 10)) (array "t" (array 16))) 18 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 0 5)) 3) (array (array (array 0 6)) 5) (array (array (array 0 7)) 6) (array (array (array 0 8)) 7) (array (array) 14)) (array 9 (array 0 1 2 3 4) (array) (array) (array) (array "d" "k" "n" "os" "t" "dropped" "wrapped" "past" "keyed")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 18) (array 6) (array 4) (array 6) (array 14 "App.Described") (array 4) (array 13 5) (array 2) (array 4) (array 13 8) (array 7 9) (array 4) (array 13 11) (array 13 12) (array 4) (array 8 13 14) (array 13 15) (array 0) (array 7 17))) (entry "types" (array)) (entry "valueTable" (array (array 4 "a number"))) (entry "variables" (array)))))
