(test 1)
(name "a-dictionary-from-outside-keyed-by-a-struct-under-its-alias-and-its-name-refuses")
(note "The door makes a struct under an alias's name a value of its struct, so a key under `App.A` beside one under `App.P` with the same fields are one key, and the dictionary refuses at the run.")

(program
  (warp 1)
  (type App.A App.P)
  (struct App.P
    (satisfies Hashable)
    (field x Int))
  (procedure entry
    (access public)
    (parameter d)
    (returns Int)
    (body
      (return 1))))
(arguments (argument d (dictionary (entry (struct App.A (field x 1)) 1) (entry (struct App.P (field x 1)) 2))))
(expect (refuses run))
