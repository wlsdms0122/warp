(test 1)
(name "a-struct-from-outside-short-of-a-field-at-a-contract-slot-refuses")
(note "The entry asks `App.Shape` and is handed a value under the name `App.P`, which a document claims conforms to it. A value under a declared struct's name conforms to a contract as that struct, so the door holds it to `App.P`, and one without `w` refuses there.")

(program
  (warp 1)
  (import Standard.Text.text)
  (struct App.P
    (satisfies App.Shape)
    (field w Int)
    (field x Int))
  (contract App.Shape)
  (procedure entry
    (access public)
    (parameter a (type App.Shape))
    (returns String)
    (body
      (return (call Standard.Text.text a)))))
(arguments (argument a (struct App.P (field x 1))))
(expect (refuses run))
