(test 1)
(name "a-return-value-from-outside-at-any-under-an-alias-is-a-value-of-its-struct")
(note "`App.v` is a native procedure declaring it returns `Any`, and it returns `(struct App.Q (field a 1))`, `App.Q` an alias of the struct `App.P`. Its return value comes in through the door at `Any`, which holds every name a value carries to the struct the name declares, so `r` is an `App.P` and `text` spells it so.")

(vocabulary
  (struct App.P
    (field a Int))
  (type App.Q App.P)
  (procedure App.v
    (isolated)
    (returns Any)
    (answers (struct App.Q (field a 1)))))

(program
  (warp 1)
  (import App.v)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let r (call App.v))
      (return (call Standard.Text.text r)))))
(expect (answers "App.P {a:1}"))
