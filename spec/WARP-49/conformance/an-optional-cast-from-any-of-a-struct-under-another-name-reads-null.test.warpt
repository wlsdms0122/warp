(test 1)
(name "an-optional-cast-from-any-of-a-struct-under-another-name-reads-null")
(note "Where a cast reads a value read as `Any`, a struct under another name fails the cast, and `as?` reads it as null. `Vault` has the fields of `Account` and is not `Account`.")

(program
  (warp 1)
  (struct Account
    (field balance Int))
  (struct Vault
    (field balance Int))
  (procedure entry
    (access public)
    (parameter a)
    (returns (optional Account))
    (body
      (return (as? a Account)))))
(arguments (argument a (struct Vault (field balance 3))))
(expect (answers null))
