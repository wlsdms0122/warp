(test 1)
(name "a-struct-literal-inside-a-struct-literal-at-a-type-parameter-refuses")
(note "The outer literal handed at `App.Box<some T>` reads its field at `some T`, a type parameter nothing else fills with a declared struct, so the inner literal takes no name and is refused.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure App.unwrap
    (parameter b (type (named App.Box (some T))))
    (returns (some T))
    (body
      (return (path b (field item)))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let x (call App.unwrap (struct (field item (struct (field item 6))))))
      (return (path x (field item))))))
(expect (refuses build))
