(test 1)
(name "a-return-value-from-outside-at-any-under-a-name-no-document-declares-refuses")
(note "`App.v` is a native procedure declaring it returns `Any`, and it returns a struct under `App.Z`, which no document declares. Its return value comes in through the door at `Any`, where a struct under a name that declares no struct refuses, so the run refuses there.")

(vocabulary
  (struct App.P
    (field a Int))
  (type App.Q App.P)
  (procedure App.v
    (isolated)
    (returns Any)
    (answers (struct App.Z (field a 1)))))

(program
  (warp 1)
  (import App.v)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let r (call App.v))
      (return "ok"))))
(expect (refuses run))
