(test 1)
(name "a-no-break-space-is-part-of-the-name-it-touches")
(note "White space is space, tab, line feed and carriage return, so a no-break space is part of the token it touches, and a name holding one is written bare.")
(text "(warp 1)\n(const a b 1)\n")
(expect (spells (dictionary (entry "const" (dictionary (entry "a b" 1))) (entry "imports" (array)) (entry "warp" 1))))
