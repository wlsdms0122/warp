(test 1)
(name "a-run-given-nothing-for-an-optional-parameter-refuses")
(note "A run is given every parameter its entry declares, an Optional one included: `Int?` says null is a value the host may hand, and a run started without `limit` was handed nothing. It is refused before anything runs.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter limit (type (optional Int)))
    (returns (optional Int))
    (body
      (return limit))))
(expect (refuses run))
