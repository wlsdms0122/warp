(test 1)
(name "a-run-given-null-for-an-optional-parameter-answers")
(note "A host gives a value for every parameter the entry declares, null included where the parameter's type takes it. `limit` is `Int?` and is handed null, so the run starts and answers null, where a parameter given nothing refuses.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter limit (type (optional Int)))
    (returns (optional Int))
    (body
      (return limit))))
(arguments (argument limit null))
(expect (answers null))
