(test 1)
(name "and-does-not-ask-past-the-first-no")
(note "and reads its sides in order and stops at the first false. The second side reads past the end of a list holding nothing, which would refuse the run, so the answer shows it was never asked.")

(program
  (warp 1)
  (import Standard.Logic.and)
  (procedure entry
    (access public)
    (const)
    (returns Bool)
    (body
      (let flags (type (array Bool)) (array))
      (return
        (call Standard.Logic.and
          (array
            (closure
              (const)
              (isolated)
              (returns Bool)
              (body
                (return false)))
            (closure
              (const)
              (isolated)
              (returns Bool)
              (body
                (return (path flags (index 0)))))))))))
(expect (answers false))
