(test 1)
(name "or-over-nothing-returns-false")
(note "`Standard.Logic.or` over no condition returns `false`: no side decided the result, so the chain's own result stands.")

(program
  (warp 1)
  (import Standard.Logic.or)
  (procedure entry
    (access public)
    (returns Bool)
    (body
      (return (call Standard.Logic.or (array))))))
(expect (answers false))
