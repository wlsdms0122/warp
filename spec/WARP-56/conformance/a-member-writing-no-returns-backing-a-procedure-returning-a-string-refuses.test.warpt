(test 1)
(name "a-member-writing-no-returns-backing-a-procedure-returning-a-string-refuses")
(note "A declaration that writes no `returns` returns `Null`, and a claim holds it to that. `Int.describe` writes no `returns` where the contract's `describe` returns `String`, so it backs no claim, and the claim refuses at the build, at the claim.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (body
        (let x 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
