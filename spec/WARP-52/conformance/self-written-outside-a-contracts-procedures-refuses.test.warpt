(test 1)
(name "self-written-outside-a-contracts-procedures-refuses")
(note "`Self` is written in a contract's procedures alone, so a procedure no contract declares writing it refuses at the load.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type Self))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
