(test 1)
(name "a-reading-of-any-at-a-bounded-parameter-refuses")
(note "`absent` writes no type, so it is read as `Any`, and `App.tell` bounds its `some T` by `App.Described`. A reading of `Any` stands at a bounded parameter only through a cast, so the build refuses, whatever arrives, null included.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Null)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Null))
      (returns String)
      (body
        (return "nothing"))))
  (procedure App.tell
    (parameter it (type (some T App.Described)))
    (returns String)
    (body
      (return (call App.Described.describe it))))
  (procedure entry
    (access public)
    (parameter absent)
    (returns String)
    (body
      (return (call App.tell absent)))))
(arguments (argument absent null))
(expect (refuses build))
