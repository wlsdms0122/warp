(test 1)
(name "some-written-in-an-alias-refuses")
(note "An alias writes no `some T`, since it lists no type parameters and nothing fills one there.")

(program
  (warp 1)
  (type App.L (array (some T)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
