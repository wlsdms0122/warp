(test 1)
(name "a-struct-bounded-by-a-type-the-language-names-refuses")
(note "A struct's bound naming `Int` refuses at the load, as a signature's does: the load knows the language's names.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T Int)
    (field item (some T)))
  (struct App.P
    (field x Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
