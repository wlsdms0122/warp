(test 1)
(name "a-piece-calling-a-procedure-that-calls-an-isolated-module-variable-stands")
(note "A module variable that declared its type an `isolated` procedure type is a slot that said so. `relayH` declares `isolated` and calls `h`, which the build holds it to, so a piece declaring `isolated` that calls `relayH` stands and `Standard.Concurrent.map` runs it.")

(program
  (warp 1)
  (import Standard.Concurrent.map)
  (var h
    (type (procedure (isolated) (parameters) (returns Int)))
    (closure
      (const)
      (isolated)
      (returns Int)
      (body
        (return 0))))
  (procedure entry
    (access public)
    (isolated)
    (returns (array Int))
    (failing concurrent_failed)
    (body
      (return
        (call Standard.Concurrent.map
          (array 1 2)
          (closure
            (isolated)
            (parameter item (type Int))
            (parameter index (type Int))
            (returns Int)
            (body
              (call relayH)
              (return item)))))))
  (procedure relayH
    (isolated)
    (body
      (apply h))))
(expect (answers (array 1 2)))
