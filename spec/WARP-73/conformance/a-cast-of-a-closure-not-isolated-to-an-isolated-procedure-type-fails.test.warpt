(test 1)
(name "a-cast-of-a-closure-not-isolated-to-an-isolated-procedure-type-fails")
(note "A closure value carries the isolation its signature declares, and a slot asking for it reads it through a cast from `Any`. The closure does not say it is isolated, so the cast to an `isolated` procedure type fails with `cast_refused`.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns (optional String))
    (body
      (let any
        (call hide
          (closure
            (returns Int)
            (body
              (return 1)))))
      (var failed)
      (let caught
        (try
          (body
            (let f (as any (procedure (isolated) (parameters) (returns Int)))))
          (catch
            (set failed (path caught (field type))))))
      (return failed)))
  (procedure hide
    (parameter v)
    (returns Any)
    (body
      (return v))))
(expect (answers "cast_refused"))
