(test 1)
(name "a-type-parameters-bound-naming-its-contracts-out-of-name-order-refuses")
(note "A `typeParameters` entry writes its bound as a type writes one, its contracts' names in name order. `K: App.B & App.A` is a second spelling of `K: App.A & App.B`, and refuses at the load.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter K App.B App.A)
    (field x (some K)))
  (contract App.A)
  (contract App.B)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
