(test 1)
(name "a-signature-applying-a-struct-to-a-parameter-bounded-as-the-struct-asks")
(note "A signature bounding `K` by `Hashable` may apply `App.Cache` to `some K`, since the parameter conforms to what the struct holds that position to.")

(program
  (warp 1)
  (struct App.Cache
    (typeParameter K Hashable)
    (typeParameter V)
    (field table (dictionary (some K) (some V))))
  (procedure App.size
    (parameter c (type (named App.Cache (some K Hashable) Int)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let c (type (named App.Cache String Int)) (struct (field table (dictionary))))
      (return (call App.size c)))))
(expect (answers 1))
