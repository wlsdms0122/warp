(test 1)
(name "an-unwrap-of-an-inner-none-binds-a-none")
(note "`o` reads `Int??` and is handed `Int?`'s none, which is its some, `Some` holding `null`. The unwrap takes one level off, so `x` binds `null`, the none of `Int?`, and `then` runs.")

(program
  (warp 1)
  (procedure App.f
    (parameter o (type (optional (optional Int))))
    (returns Any)
    (body
      (var r (type Any) "none")
      (let x
        (unwrap o
          (then
            (set r (array "some" x)))))
      (return r)))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let inner (type (optional Int)) null)
      (return (call App.f inner)))))
(expect (answers (array "some" null)))
