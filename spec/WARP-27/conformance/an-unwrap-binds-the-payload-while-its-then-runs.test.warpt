(test 1)
(name "an-unwrap-binds-the-payload-while-its-then-runs")
(note "`o` holds a some, so the unwrap takes its `then` way, where its name `x` binds the payload, read as `Int` where `o` reads `Int?`. Handed 5, `then` writes 6.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure App.f
    (parameter o (type (optional Int)))
    (returns Int)
    (body
      (var n 0)
      (let x
        (unwrap o
          (then
            (set n (call Standard.Numeric.plus x 1)))))
      (return n)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.f 5)))))
(expect (answers 6))
