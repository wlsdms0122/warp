(test 1)
(name "an-unwrap-without-then-whose-else-ends-in-a-call-returning-never-stands")
(note "With no `then`, every way through `else` leaves, and a way whose last statement is a call returning `Never` leaves. This `else` ends in `abort`, so the unwrap stands and `x` holds the payload after it. Handed 5, it answers 5.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure App.f
    (parameter o (type (optional Int)))
    (returns Int)
    (failing aborted)
    (body
      (let x
        (unwrap o
          (else
            (call Standard.Control.abort "none"))))
      (return x)))
  (procedure entry
    (access public)
    (returns Int)
    (failing aborted)
    (body
      (return (call App.f 5)))))
(expect (answers 5))
