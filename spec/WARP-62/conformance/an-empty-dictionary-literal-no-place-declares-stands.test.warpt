(test 1)
(name "an-empty-dictionary-literal-no-place-declares-stands")
(note "An empty dictionary literal no place declares reads as a dictionary holding `Never` at its key, and the language claims `Hashable` for `Never`, so the literal builds and the run answers 1.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let d (dictionary))
      (return 1))))
(expect (answers 1))
