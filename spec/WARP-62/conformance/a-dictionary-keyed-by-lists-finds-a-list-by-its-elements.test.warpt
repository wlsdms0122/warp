(test 1)
(name "a-dictionary-keyed-by-lists-finds-a-list-by-its-elements")
(note "`Array<Int>` conforms to `Hashable` through the language's claim about every list, so a list is a dictionary's key, and a list written apart from the dictionary, `k`, finds the entry under the same elements in the same order.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let d (type (dictionary (array Int) String)) (dictionary (entry (array 1 2) "a") (entry (array 1) "b")))
      (let k (type (array Int)) (array 1 2))
      (return (path d (index k))))))
(expect (answers "a"))
