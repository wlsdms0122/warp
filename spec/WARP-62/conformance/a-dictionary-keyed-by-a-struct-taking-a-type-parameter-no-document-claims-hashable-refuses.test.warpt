(test 1)
(name "a-dictionary-keyed-by-a-struct-taking-a-type-parameter-no-document-claims-hashable-refuses")
(note "What a struct is applied to does not make it a dictionary's key. No document says `App.Box` conforms to `Hashable`, so a dictionary keyed by `App.Box<Int>` is refused.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let m (type (dictionary (named App.Box Int) Int)) (dictionary))
      (return 1))))
(expect (refuses build))
