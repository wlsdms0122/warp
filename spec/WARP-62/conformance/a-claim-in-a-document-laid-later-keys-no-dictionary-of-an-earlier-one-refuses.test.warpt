(test 1)
(name "a-claim-in-a-document-laid-later-keys-no-dictionary-of-an-earlier-one-refuses")
(note "Whether a key conforms is judged against the claims within what the document stands on. The document declaring `App.Point` keys a dictionary by it, and the one claim of `Hashable` for it stands in the program laid after, so the earlier document refuses at the build.")

(documents
  (document
    (warp 1)
    (struct App.Point
      (field x Int))
    (procedure App.f
      (parameter m (type (dictionary App.Point Int)))
      (returns Int)
      (body
        (return 1)))))

(program
  (warp 1)
  (import App.Point)
  (extension
    (head App.Point)
    (satisfies Hashable))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
