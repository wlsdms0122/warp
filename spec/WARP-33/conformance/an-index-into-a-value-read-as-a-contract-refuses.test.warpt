(test 1)
(name "an-index-into-a-value-read-as-a-contract-refuses")
(note "`s` reads `App.Shape`, a contract. A contract says nothing of what a value holds at a position or under a key, so brackets on it have nothing declared to be judged against and the build refuses them.")

(program
  (warp 1)
  (struct App.Box
    (satisfies App.Shape)
    (field x Int)
    (procedure size
      (parameter of (type App.Box))
      (returns Int)
      (body
        (return 1))))
  (contract App.Shape
    (procedure size
      (parameter of (type Self))
      (returns Int)))
  (procedure App.read
    (parameter s (type App.Shape))
    (returns Int)
    (body
      (return (path s (index 0)))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type App.Box) (struct (field x 1)))
      (return (call App.read b)))))
(expect (refuses build))
