(test 1)
(name "an-optional-dot-on-an-undeclared-field-refuses")
(note "On a struct type a field the type does not declare refuses at the build, `?.` or not. `task` reads `App.Task?`, and `?.` reads past its none to a field `App.Task` does not declare.")

(program
  (warp 1)
  (struct App.Task
    (field id String))
  (procedure entry
    (access public)
    (parameter task (type (optional App.Task)))
    (returns Any)
    (body
      (return (path task (field? done))))))
(expect (refuses build))
