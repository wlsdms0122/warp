(test 1)
(name "a-backslash-before-what-it-does-not-escape-refuses")
(note "Inside the quotes a backslash escapes a quote or a backslash and nothing else, so each key has one spelling.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "d") (entry "type" "Dictionary<String, Int>") (entry "value" (dictionary (entry "dictionary" (array (array "an" 1)))))) (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "ref" "d[\"a\\n\"]")))))))) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
