(test 1)
(name "white-space-around-what-the-brackets-hold-refuses")
(note "Nothing stands around what the brackets hold, so `a[ 1 ]` is a second spelling of `a[1]`.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "a") (entry "value" (array 5 6))) (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "ref" "a[ 1 ]")))))))) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
