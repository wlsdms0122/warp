(test 1)
(name "a-claim-about-a-struct-backed-for-it-applied-to-int-alone-refuses")
(note "A claim about `App.Box` is about every value of it, and a call through the contract hands the declaration any of them. `App.Box.describe` is given under `App.Box<Int>`, for boxes of integers alone, so the claim does not hold and refuses at the build, at the claim.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))))

(program
  (warp 1)
  (import App.Box)
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head App.Box)
    (satisfies App.Describable))
  (extension
    (head (named App.Box Int))
    (procedure describe
      (parameter of (type (named App.Box Int)))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (refuses build))
