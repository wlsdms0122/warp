(test 1)
(name "a-list-written-as-bytes-reaches-the-claim-about-array")
(note "Bytes are a list, and a claim about `Array` is about every list. The host hands `x\"0102\"` where `App.Described` is asked, and the only claim of it is about `Array`, so the door takes it and the call through the contract reaches `Array.describe`.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Array)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (array Any)))
      (returns String)
      (body
        (return "a list"))))
  (procedure entry
    (access public)
    (parameter it (type App.Described))
    (returns String)
    (body
      (return (call App.Described.describe it)))))
(arguments (argument it x"0102"))
(expect (answers "a list"))
