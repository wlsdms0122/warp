(test 1)
(name "a-claim-about-any-refuses")
(note "A claim is about a type a value is an instance of, since the run dispatches by the type the value is. No value is an instance of `Any` by name, so a claim about it is refused where the document is read.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Any)
    (satisfies App.Described))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call App.Described.describe 1)))))
(expect (refuses load))
