(test 1)
(name "a-claim-in-one-document-about-a-struct-another-declares-with-a-type-parameter")
(note "A claim about a struct taking type parameters may be made by any document. This one claims `App.Box` from the document beside it, backed for every value of it.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))))

(program
  (warp 1)
  (import App.Box)
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head App.Box)
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (return (call App.Describable.describe b)))))
(expect (answers "box"))
