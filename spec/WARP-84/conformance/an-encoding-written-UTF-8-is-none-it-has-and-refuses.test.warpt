(test 1)
(name "an-encoding-written-UTF-8-is-none-it-has-and-refuses")
(note "The encodings are the strings `encoding` produces, and that is `utf8` alone, so `UTF-8`, another way of writing UTF-8, is no encoding `encoded` has and the call refuses at the run.")

(program
  (warp 1)
  (import Standard.Text.encoded)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call Standard.Text.encoded "hi" "UTF-8")))))
(expect (refuses run))
