(test 1)
(name "encoded-writes-the-code-points-as-they-stand")
(note "`encoded` writes the string's code points as they stand and normalises nothing: a letter followed by a combining mark is three bytes in UTF-8, not the two of the precomposed letter.")

(program
  (warp 1)
  (import Standard.Text.encoded)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call Standard.Text.encoded "é" "utf8")))))
(expect (answers x"65cc81"))
