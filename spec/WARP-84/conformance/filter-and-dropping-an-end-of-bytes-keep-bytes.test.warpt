(test 1)
(name "filter-and-dropping-an-end-of-bytes-keep-bytes")
(note "filter, dropFirst and dropLast return a collection's own elements, so bytes stay bytes, a return value holding nothing included.")

(program
  (warp 1)
  (import Standard.Collection.dropFirst)
  (import Standard.Collection.dropLast)
  (import Standard.Collection.filter)
  (import Standard.Logic.equal)
  (import Standard.Numeric.remainder)
  (procedure entry
    (access public)
    (returns (array (array Int)))
    (body
      (let odd
        (call Standard.Collection.filter x"010203"
          (closure
            (const)
            (isolated)
            (parameter x (type Int))
            (returns Bool)
            (body
              (return (call Standard.Logic.equal (call Standard.Numeric.remainder x 2) 1))))))
      (return (array odd (call Standard.Collection.dropFirst x"68") (call Standard.Collection.dropLast x"68"))))))
(expect (answers (array x"0103" x"" x"")))
