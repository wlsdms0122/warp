(test 1)
(name "encoded-writes-a-string-as-bytes-in-a-named-encoding")
(note "`decoded` and `encoded` are the two directions of one mapping. A string is Unicode and utf8 spells all of it, so this cannot refuse the string it was given.")

(program
  (warp 1)
  (import Standard.Text.encoded)
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call Standard.Text.encoded "hi" "utf8")))))
(expect (answers x"6869"))
