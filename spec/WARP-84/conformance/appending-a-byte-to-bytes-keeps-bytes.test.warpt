(test 1)
(name "appending-a-byte-to-bytes-keeps-bytes")
(note "appending and prepending a byte to bytes return bytes, matched strictly: every element of the return value is a byte, so it keeps the spelling its collection arrived in.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (import Standard.Collection.prepending)
  (procedure entry
    (access public)
    (returns (array (array Int)))
    (body
      (return (array (call Standard.Collection.appending x"68" 105) (call Standard.Collection.prepending x"69" 104))))))
(expect (answers (array x"6869" x"6869")))
