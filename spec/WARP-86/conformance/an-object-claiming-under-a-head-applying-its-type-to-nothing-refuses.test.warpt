(object (dictionary (entry "addressTable" (array)) (entry "claims" (array (array (array "App.Box" (array) (array (array "T" (array "Hashable")))) (array "App.Marked")))) (entry "constants" (array)) (entry "contracts" (array (array "App.Marked" (array (array) (array) (array))))) (entry "dependencies" (array)) (entry "document" (array x"981962a8a5c75c482e95d39a63df76c4e585f59a594c6bf875b398f18b898871")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array)) (entry "rows" (array)) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 15 "T"))) (entry "types" (array (array "App.Box" (array 9 (array (array "item" 0)) (array "T") (array))))) (entry "valueTable" (array)) (entry "variables" (array))))
