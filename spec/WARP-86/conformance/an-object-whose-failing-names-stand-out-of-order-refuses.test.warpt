(test 1)
(name "an-object-whose-failing-names-stand-out-of-order-refuses")
(note "A failing is [1, names], the names ascending. An object whose `entry` may fail with `b` and then `a` is refused where it is read.")
(object (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"8af75591dda024dd54e03c9956e36ec1f1a655130299736cfaf4ba6828377f10")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 0) (array 13 0 (array 1)))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array "b" "a")) 1 1 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 0) (array (array) 2)) (array 1 (array) (array) (array) (array) (array "n")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array))))
(expect (refuses load))
