(test 1)
(name "the-object-of-a-double-type")
(note "`Double` stands in `typeTable` as type tag 5, here the type of `App.same`'s parameter, what it returns and what `entry` returns.")

(program
  (warp 1)
  (procedure App.same
    (access public)
    (const)
    (isolated)
    (parameter x (type Double))
    (returns Double)
    (body
      (return x)))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Double)
    (body
      (return (call App.same 1.5)))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"d1b3c709fb2383d7987b838cbcf224cccd0b380a7d3786d18c11755b4780ca93")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 13 0 (array 0)) (array 0 0) (array 11 (array 0 (array (array 2)) (array) (array))) (array 13 0 (array 3)))) (entry "rows" (array (array "App.same" (array (array (array "x" (array 0))) 1 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 1)) (array 1 (array 0) (array) (array) (array) (array "x")))) (array "entry" (array (array) 2 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 4)) (array 0 (array) (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 5) (array 5) (array 5))) (entry "types" (array)) (entry "valueTable" (array (array 3 1.5))) (entry "variables" (array)))))
