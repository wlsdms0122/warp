(test 1)
(name "claims-under-heads-stand-in-the-order-of-the-heads-spellings")
(note "A list a head keys stands in the order of the heads' spellings, compared as names. `Bool?` comes before `Int`, so the claim and the members under the Optional's head, written `[\"Optional\", [2], []]`, stand first, where `Optional` would come after `Int`.")

(program
  (warp 1)
  (contract App.Shown
    (procedure show
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (optional Bool))
    (satisfies App.Shown)
    (procedure show
      (parameter of (type (optional Bool)))
      (returns String)
      (body
        (return "bool"))))
  (extension
    (head Int)
    (satisfies App.Shown)
    (procedure show
      (parameter of (type Int))
      (returns String)
      (body
        (return "int"))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (builds (dictionary (entry "addressTable" (array)) (entry "claims" (array (array (array "Optional" (array 2) (array)) (array "App.Shown")) (array "Int" (array "App.Shown")))) (entry "constants" (array)) (entry "contracts" (array (array "App.Shown" (array (array) (array) (array (array "show" (array (array (array "of" (array 0))) 1 (array 1 (array)) 0 0 (array) (array)))))))) (entry "dependencies" (array)) (entry "document" (array x"6ff97eb294d3004cf899148edf300d428e57458daaa43f039db357188fa16a99")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array (array (array "Optional" (array 3) (array)) (array "show")) (array "Int" (array "show")))) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 13 0 (array 0)) (array 0 1) (array 13 0 (array 2)) (array 0 2) (array 13 0 (array 4)))) (entry "rows" (array (array "Int.show" (array (array (array "of" (array 4))) 5 (array 1 (array)) 0 0 (array) (array)) 1 (array 0 (array (array (array) 1)) (array 1 (array 0) (array) (array) (array) (array "of")))) (array "Optional.show" (array (array (array "of" (array 7))) 8 (array 1 (array)) 0 0 (array) (array)) 1 (array 0 (array (array (array) 3)) (array 1 (array 0) (array) (array) (array) (array "of")))) (array "entry" (array (array) 9 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array) 5)) (array 0 (array) (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 18) (array 6) (array 3) (array 3) (array 4) (array 6) (array 3) (array 13 6) (array 6) (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 4 "int") (array 4 "bool") (array 2 1))) (entry "variables" (array)))))
