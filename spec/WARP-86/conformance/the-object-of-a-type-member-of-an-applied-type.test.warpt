(test 1)
(name "the-object-of-a-type-member-of-an-applied-type")
(note "A type member of an applied type stands in `typeTable` as type tag 21, the applied type's *type* and then the member's name, here `App.Wrapper<String>.Item` as `[21, 1, \"Item\"]` beside the applied type `[14, \"App.Wrapper\", [0]]`.")

(documents
  (document
    (warp 1)
    (struct App.Wrapper
      (typeParameter T)
      (field item (some T))
      (type Item (some T)))))

(program
  (warp 1)
  (import App.Wrapper)
  (import App.Wrapper.Item)
  (procedure App.echo
    (access public)
    (const)
    (isolated)
    (parameter x (type (member (named App.Wrapper String) Item)))
    (returns String)
    (body
      (return x)))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns String)
    (body
      (return (call App.echo "a")))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"efad1caf131c570532beb3323509add12eff7efbf40cb5637ecfae99116b8ff7")) (entry "document" (array x"66216d4a0ce9445ac4d338fef2fc6ccfcaf2812a417632626690fad7ab9bb200")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 13 0 (array 0)) (array 0 0) (array 11 (array 0 (array (array 2)) (array) (array))) (array 13 0 (array 3)))) (entry "rows" (array (array "App.echo" (array (array (array "x" (array 2))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 1)) (array 1 (array 0) (array) (array) (array) (array "x")))) (array "entry" (array (array) 4 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 4)) (array 0 (array) (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 6) (array 14 "App.Wrapper" (array 0)) (array 21 1 "Item") (array 6) (array 6))) (entry "types" (array)) (entry "valueTable" (array (array 4 "a"))) (entry "variables" (array)))))
