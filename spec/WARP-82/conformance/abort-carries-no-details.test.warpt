(test 1)
(name "abort-carries-no-details")
(note "`abort` takes its message and nothing else, and the failure's `message` holds it, so `details`, what the failing procedure carried beside it, hold nothing.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns (optional (dictionary String Any)))
    (body
      (var tried)
      (let caught
        (try
          (body
            (call Standard.Control.abort "why"))
          (catch
            (set tried (path caught (field details))))))
      (return tried))))
(expect (answers (dictionary)))
