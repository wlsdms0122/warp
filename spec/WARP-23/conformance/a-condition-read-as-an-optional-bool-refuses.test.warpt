(test 1)
(name "a-condition-read-as-an-optional-bool-refuses")
(note "A condition must be a `Bool`, and `Bool?` is no `Bool`: it may hold its none, which chooses no way. `c` reads `Bool?`, so the build refuses the condition.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter c (type (optional Bool)))
    (body
      (conditional
        (when c)
        (then
          (let kept 1))))))
(expect (refuses build))
