(test 1)
(name "an-associated-type-of-a-type-parameter-is-what-the-type-filling-it-gives")
(note "A contract asks the type Item, and `Lib.firstOf` returns `some C.Item`, the associated type Item of C. A box of Int gives Item as Int, so what a call of it returns is an Int, which `Int.plus` takes.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import App.Box)
  (import Int.plus)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (named App.Box Int)) (struct (field item 1)))
      (let x (call Lib.firstOf b))
      (return (call Int.plus x 1)))))
(expect (answers 2))
