(test 1)
(name "a-generic-call-takes-no-double-where-the-type-gives-int-refuses")
(note "`Use.put` takes `some C.Item`, and App.IntBag gives Item as Int, so handing 1.5 there refuses at the build. A Double is not joined with the Int the type gives.")

(documents
  (document
    (warp 1)
    (contract Lib.Bag
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))
      (procedure take
        (parameter of (type Self))
        (parameter x (type Self.Item))
        (returns Int))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Bag)
    (struct App.IntBag
      (satisfies Lib.Bag)
      (field n Int)
      (type Item Int)
      (procedure first
        (access public)
        (parameter of (type App.IntBag))
        (returns Int)
        (body
          (return (path of (field n)))))
      (procedure take
        (access public)
        (parameter of (type App.IntBag))
        (parameter x (type Int))
        (returns Int)
        (body
          (return (call Int.plus x 1))))))
  (document
    (warp 1)
    (import Lib.Bag)
    (import Lib.Bag.take)
    (procedure Use.put
      (access public)
      (parameter c (type (some C Lib.Bag)))
      (parameter x (type (some C.Item)))
      (returns Int)
      (body
        (return (call Lib.Bag.take c x))))))

(program
  (warp 1)
  (import App.IntBag)
  (import Use.put)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type App.IntBag) (struct (field n 1)))
      (return (call Use.put b 1.5)))))
(expect (refuses build))
