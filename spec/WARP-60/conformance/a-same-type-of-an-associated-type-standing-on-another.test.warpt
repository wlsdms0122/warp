(test 1)
(name "a-same-type-of-an-associated-type-standing-on-another")
(note "`Use.keyPlus` says `C.Item.Key` is Int, so inside it the Key of what `Lib.Outer.first` returns is an Int, and a shelf, whose card gives Key as Int, fills C.")

(documents
  (document
    (warp 1)
    (contract Lib.Keyed
      (type Key)
      (procedure key
        (parameter of (type Self))
        (returns Self.Key)))
    (contract Lib.Outer
      (type Item Lib.Keyed)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))))
  (document
    (warp 1)
    (import Lib.Keyed)
    (import Lib.Outer)
    (struct App.Card
      (satisfies Lib.Keyed)
      (field k Int)
      (type Key Int)
      (procedure key
        (access public)
        (parameter of (type App.Card))
        (returns Int)
        (body
          (return (path of (field k))))))
    (struct App.Shelf
      (satisfies Lib.Outer)
      (field card App.Card)
      (type Item App.Card)
      (procedure first
        (access public)
        (parameter of (type App.Shelf))
        (returns App.Card)
        (body
          (return (path of (field card)))))))
  (document
    (warp 1)
    (import Int.plus)
    (import Lib.Keyed.key)
    (import Lib.Outer)
    (import Lib.Outer.first)
    (procedure Use.keyPlus
      (access public)
      (parameter c (type (some C Lib.Outer)))
      (returns Int)
      (sameType C.Item.Key Int)
      (body
        (let x (call Lib.Outer.first c))
        (let k (call Lib.Keyed.key x))
        (return (call Int.plus k 1))))))

(program
  (warp 1)
  (import App.Shelf)
  (import Use.keyPlus)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let s (type App.Shelf) (struct (field card (struct (field k 1)))))
      (return (call Use.keyPlus s)))))
(expect (answers 2))
