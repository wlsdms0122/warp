(test 1)
(name "an-optional-fills-no-associated-type-no-claim-about-it-gives-refuses")
(note "A value read as `App.Box<Int>?` is of an Optional, and no claim about an Optional gives Item, so a call filling C with it where `some C.Item` is written refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import App.Box)
  (import Lib.firstOf)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let b (type (optional (named App.Box Int))) (struct (field item 1)))
      (let x (call Lib.firstOf b))
      (return 1))))
(expect (refuses build))
