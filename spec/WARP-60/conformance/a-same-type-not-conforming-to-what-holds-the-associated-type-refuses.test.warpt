(test 1)
(name "a-same-type-not-conforming-to-what-holds-the-associated-type-refuses")
(note "`Lib.Hashed` holds Item to Hashable, and `Use.it` says `C.Item` is App.Plain, which no claim makes Hashable, so the same type refuses at the build where it is written.")

(documents
  (document
    (warp 1)
    (contract Lib.Hashed
      (type Item Hashable)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item))))
  (document
    (warp 1)
    (struct App.Plain
      (field x Int))))

(program
  (warp 1)
  (import App.Plain)
  (import Lib.Hashed)
  (procedure Use.it
    (access public)
    (parameter c (type (some C Lib.Hashed)))
    (returns Int)
    (sameType C.Item App.Plain)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
