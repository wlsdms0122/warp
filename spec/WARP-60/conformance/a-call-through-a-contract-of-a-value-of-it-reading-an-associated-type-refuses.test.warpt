(test 1)
(name "a-call-through-a-contract-of-a-value-of-it-reading-an-associated-type-refuses")
(note "`Lib.Container.first` returns `Self.Item`, and a value read as the contract gives no one Item, so the call refuses at the build.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (satisfies Lib.Container)
      (field item (some T))
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import App.Box)
  (import Lib.Container)
  (import Lib.Container.first)
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (let b (type Lib.Container) (as (struct (field item 1)) (named App.Box Int)))
      (let x (call Lib.Container.first b))
      (return x))))
(expect (refuses build))
