(test 1)
(name "a-private-procedure-called-beside-its-declaration-runs")
(note "`private` is the document's own scope: a procedure declared beside the caller is named from there whatever its `access`, so a private helper called by its own document's entry runs.")

(program
  (warp 1)
  (procedure App.seven
    (access private)
    (returns Int)
    (body
      (return 7)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.seven)))))
(expect (answers 7))
