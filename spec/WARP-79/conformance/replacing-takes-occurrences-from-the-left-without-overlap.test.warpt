(test 1)
(name "replacing-takes-occurrences-from-the-left-without-overlap")
(note "Occurrences are taken from the start, each search beginning after the last one taken. In `aaa` the target `aa` stands at two places that overlap, and replacing takes the first, so `aaa` becomes `ba`, not `ab`.")

(program
  (warp 1)
  (import Standard.Text.replacing)
  (procedure entry
    (access public)
    (returns String)
    (failing aborted)
    (body
      (return (call Standard.Text.replacing "aaa" "aa" "b")))))
(expect (answers "ba"))
