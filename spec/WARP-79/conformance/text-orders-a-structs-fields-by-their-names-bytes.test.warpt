(test 1)
(name "text-orders-a-structs-fields-by-their-names-bytes")
(note "text writes a struct's fields ascending by their names' UTF-8 bytes, so a capital C (0x43) stands before a and b. The struct declares them b, C, a, and an order that ignores case would put C last.")

(program
  (warp 1)
  (import Standard.Text.text)
  (struct App.Trio
    (field C Int)
    (field a Int)
    (field b Int))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let trio (type App.Trio) (struct (field C 3) (field a 2) (field b 1)))
      (return (call Standard.Text.text trio)))))
(expect (answers "App.Trio {C:3,a:2,b:1}"))
