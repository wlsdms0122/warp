(test 1)
(name "text-of-a-procedure-spells-a-marker")
(note "A procedure has no spelling a document carries, so `text` of one returns the language's own marker, `<procedure>`, and never a host formatter's.")

(program
  (warp 1)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return
        (call Standard.Text.text
          (closure
            (returns Int)
            (body
              (return 1))))))))
(expect (answers "<procedure>"))
