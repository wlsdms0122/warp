(test 1)
(name "text-spells-a-struct-on-one-line")
(note "text spells a container on one line: a dictionary's entries between braces as the key in its own spelling, strings quoted, a colon and the value; a named struct the same with its name and a space in front, each field's name bare; an empty one as its two braces.")

(program
  (warp 1)
  (import Standard.Text.text)
  (struct Point
    (field x Int))
  (procedure entry
    (access public)
    (returns (array String))
    (failing cast_refused)
    (body
      (let plain (call Standard.Text.text (dictionary (entry "a" "x") (entry "b" 1))))
      (let named (call Standard.Text.text (as (struct (field x 1)) Point)))
      (let empty (call Standard.Text.text (dictionary)))
      (return (array plain named empty)))))
(expect (answers (array "{\"a\":\"x\",\"b\":1}" "Point {x:1}" "{}")))
