(test 1)
(name "a-name-of-an-optional-handed-where-its-optional-is-asked-is-its-some")
(note "A reading of `Int?` where `Int??` is asked is a some of `Int?`. `y` holds the none of `Int?`, so `App.f` is handed its some, `Some` holding `null`.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (optional (optional Int))))
    (returns Any)
    (body
      (return x)))
  (procedure App.g
    (parameter y (type (optional Int)))
    (returns Any)
    (body
      (return (call App.f y))))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (return (call App.g null)))))
(expect (answers (struct Some (field wrapped null))))
