(test 1)
(name "an-optional-of-an-optional-at-an-optional-of-any-stands-as-it-is")
(note "A reading `U?` stands as it is where `T` takes `U` and `U` is as many Optional levels deep as `T` or more. `z` reads `Int??` and holds `Some` holding `null`. At `Any?`, `Any` takes `Int?`, which is deeper, so `z` is handed as it is and is not marked again.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (optional Any)))
    (returns Any)
    (body
      (return x)))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let n (type (optional Int)) null)
      (let z (type (optional (optional Int))) n)
      (return (call App.f z)))))
(expect (answers (struct Some (field wrapped null))))
