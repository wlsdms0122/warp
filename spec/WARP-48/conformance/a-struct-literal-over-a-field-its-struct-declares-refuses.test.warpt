(test 1)
(name "a-struct-literal-over-a-field-its-struct-declares-refuses")
(note "A struct fits only with exactly its fields, and one over refuses. The literal returned where `App.P` is declared writes `y`, which `App.P` does not declare, so the build refuses it.")

(program
  (warp 1)
  (struct App.P
    (field x Int))
  (procedure entry
    (access public)
    (returns App.P)
    (body
      (return (struct (field x 1) (field y 2))))))
(expect (refuses build))
