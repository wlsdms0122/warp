(test 1)
(name "a-cast-refused-expects-an-associated-type-as-the-call-filled-it")
(note "An associated type written inside a cast's type reads as the call filled it, and `expected` is the type the cast reads as. The call fills `C` with `App.Words`, whose `Item` is `String`, so `some C.Item` expects `String`.")

(program
  (warp 1)
  (struct App.Words
    (satisfies App.Container)
    (field x Int)
    (type Item String)
    (procedure first
      (parameter of (type App.Words))
      (returns String)
      (body
        (return "w"))))
  (contract App.Container
    (type Item)
    (procedure first
      (parameter of (type Self))
      (returns Self.Item)))
  (procedure App.g
    (parameter c (type (some C App.Container)))
    (parameter a)
    (returns Any)
    (body
      (let caught
        (try
          (body
            (as a (some C.Item)))
          (catch
            (return (path caught (field details) (index "expected"))))))
      (return "no failure")))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (let w (type App.Words) (struct (field x 1)))
      (return (call App.g w 7)))))
(expect (answers "String"))
