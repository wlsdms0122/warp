(test 1)
(name "a-variable-only-a-trys-body-writes-is-null-after-its-catch")
(note "A catch runs statements for effect and need not write what the body writes. When the body fails before its write and the catch is the way taken, the variable still holds null, which is the value behind the `T?` the join reads.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns (optional Int))
    (body
      (var tried)
      (try
        (body
          (let read (as payload Int))
          (set tried read))
        (catch
          (let noted 0)))
      (return tried))))
(arguments (argument payload "not a whole number"))
(expect (answers null))
