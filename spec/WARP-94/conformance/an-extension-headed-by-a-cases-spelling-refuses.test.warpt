(test 1)
(name "an-extension-headed-by-a-cases-spelling-refuses")
(note "A case is not a type, so an extension headed by `App.Light.red` is about no type. The document declaring the enum writes it, and shows it alone, so the load refuses.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (extension
    (head App.Light.red)
    (procedure shade
      (parameter of (type App.Light))
      (returns Int)
      (body
        (return 1))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
