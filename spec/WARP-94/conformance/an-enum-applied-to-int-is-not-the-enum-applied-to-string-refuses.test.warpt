(test 1)
(name "an-enum-applied-to-int-is-not-the-enum-applied-to-string-refuses")
(note "Two mentions of one enum are one type only where they apply it to the same types. `result` is an `App.Result<Int, String>`, and `App.need` asks an `App.Result<String, String>`, so the build refuses the call.")

(program
  (warp 1)
  (enum App.Result
    (typeParameter T)
    (typeParameter E)
    (case failure (field error (some E)))
    (case success (field value (some T))))
  (procedure App.need
    (parameter result (type (named App.Result String String)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let result (type (named App.Result Int String)) (case success (field value 1)))
      (return (call App.need result)))))
(expect (refuses build))
