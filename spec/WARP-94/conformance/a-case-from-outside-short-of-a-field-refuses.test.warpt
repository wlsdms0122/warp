(test 1)
(name "a-case-from-outside-short-of-a-field-refuses")
(note "The host hands `App.Target.remote` carrying `host` alone, and the case carries `host` and `port`. The door judges the value against the fields its case carries, so it refuses the run.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (parameter target (type App.Target))
    (returns Int)
    (body
      (return 1))))
(arguments (argument target (struct App.Target.remote (field host "a"))))
(expect (refuses run))
