(test 1)
(name "an-enum-stands-as-a-type-argument")
(note "An enum's name stands wherever a type is written, a type argument among them. `App.Box<App.Light>` holds an `App.Light`, so the literal in its field is read as one and reads back as `red`.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns App.Light)
    (body
      (let box (type (named App.Box App.Light)) (struct (field item (case red))))
      (return (path box (field item))))))
(expect (answers (struct App.Light.red)))
