(test 1)
(name "a-struct-at-an-enum-slot-refuses")
(note "A slot of an enum takes a value under one of its cases' spellings and no other. `point` is read as the declared struct `App.Point`, which is no type `App.Light` takes, so the build refuses the call.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (struct App.Point
    (field x Int))
  (procedure App.take
    (parameter light (type App.Light))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let point (type App.Point) (struct (field x 1)))
      (return (call App.take point)))))
(expect (refuses build))
