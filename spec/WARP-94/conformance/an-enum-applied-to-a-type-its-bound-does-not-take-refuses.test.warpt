(test 1)
(name "an-enum-applied-to-a-type-its-bound-does-not-take-refuses")
(note "`App.Keyed` bounds `K` by `Hashable`, and a type standing at a bounded position conforms to the bounds there. No document claims `Hashable` for `App.Plain`, so the build refuses `App.Keyed<App.Plain>`.")

(program
  (warp 1)
  (enum App.Keyed
    (typeParameter K Hashable)
    (case none)
    (case one (field key (some K))))
  (struct App.Plain
    (field x Int))
  (procedure App.take
    (parameter keyed (type (named App.Keyed App.Plain)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
