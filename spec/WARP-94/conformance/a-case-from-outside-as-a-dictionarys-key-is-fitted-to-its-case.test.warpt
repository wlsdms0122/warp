(test 1)
(name "a-case-from-outside-as-a-dictionarys-key-is-fitted-to-its-case")
(note "The host hands a dictionary whose key is `App.Light.red` carrying a field `x` the case never names. The door fits a value to its case at whatever depth a dictionary's key holds it, so `x` is left out and the dictionary is the one the entry builds.")

(program
  (warp 1)
  (import Standard.Logic.equal)
  (enum App.Light
    (satisfies Hashable)
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter d)
    (returns Bool)
    (body
      (let built (type (dictionary App.Light Int)) (dictionary (entry (case red) 1)))
      (return (call Standard.Logic.equal d built)))))
(arguments (argument d (dictionary (entry (struct App.Light.red (field x 1)) 1))))
(expect (answers true))
