(test 1)
(name "a-case-from-outside-in-an-optional-is-fitted-to-its-case")
(note "The entry declares `App.Target?`, and the host hands `App.Target.remote` carrying a field `tls` the case never names. The door fits a value to its case at whatever depth an Optional holds it, so `tls` is left out and the text shows `host` and `port` alone.")

(program
  (warp 1)
  (import Standard.Text.text)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (parameter target (type (optional App.Target)))
    (returns String)
    (body
      (return (call Standard.Text.text target)))))
(arguments (argument target (struct App.Target.remote (field host "a") (field port 8080) (field tls true))))
(expect (answers "App.Target.remote {host:\"a\",port:8080}"))
