(test 1)
(name "a-list-of-an-enum-applied-to-never-beside-it-applied-to-int-reads-it-applied-to-int")
(note "`a` reads `App.Result<Never, String>` and `b` reads `App.Result<Int, String>`. `Never`, as a part, joins to what stands beside it, so the list reads `Array<App.Result<Int, String>>`, which `App.count` takes, and the call answers 2.")

(program
  (warp 1)
  (enum App.Result
    (typeParameter T)
    (typeParameter E)
    (case failure (field error (some E)))
    (case success (field value (some T))))
  (procedure App.count
    (parameter results (type (array (named App.Result Int String))))
    (returns Int)
    (body
      (return 2)))
  (procedure App.oops
    (returns (named App.Result Never String))
    (body
      (return (case failure (field error "x")))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let a (call App.oops))
      (let b (type (named App.Result Int String)) (case success (field value 1)))
      (let results (array a b))
      (return (call App.count results)))))
(expect (answers 2))
