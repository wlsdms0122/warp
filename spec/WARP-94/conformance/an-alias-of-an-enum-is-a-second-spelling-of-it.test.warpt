(test 1)
(name "an-alias-of-an-enum-is-a-second-spelling-of-it")
(note "`App.Signal` is an alias of `App.Light`, a second spelling of it, so an `App.Light` stands where `App.Signal` is declared, and the switch over it takes the `red` arm.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (type App.Signal App.Light)
  (procedure App.word
    (parameter signal (type App.Signal))
    (returns String)
    (body
      (switch signal
        (case green
          (then
            (return "go")))
        (case red
          (then
            (return "stop"))))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let light (type App.Light) (case red))
      (return (call App.word light)))))
(expect (answers "stop"))
