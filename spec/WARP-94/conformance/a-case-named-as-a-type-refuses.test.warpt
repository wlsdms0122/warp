(test 1)
(name "a-case-named-as-a-type-refuses")
(note "A case is not a type. `App.Light.red` is the spelling a value of the case carries and names no type, and the document declaring the enum writes it as a parameter's type, which it shows alone, so the load refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure App.stop
    (parameter light (type App.Light.red))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
