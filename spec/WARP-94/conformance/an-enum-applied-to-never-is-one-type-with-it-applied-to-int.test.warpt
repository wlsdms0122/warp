(test 1)
(name "an-enum-applied-to-never-is-one-type-with-it-applied-to-int")
(note "Two mentions of one enum are one type where they apply it to the same types, `Never` read as any type. `App.oops` returns an `App.Result<Never, String>`, so its value stands where `App.Result<Int, String>` is declared.")

(program
  (warp 1)
  (enum App.Result
    (typeParameter T)
    (typeParameter E)
    (case failure (field error (some E)))
    (case success (field value (some T))))
  (procedure App.oops
    (returns (named App.Result Never String))
    (body
      (return (case failure (field error "x")))))
  (procedure App.valueOr
    (parameter result (type (named App.Result Int String)))
    (parameter fallback (type Int))
    (returns Int)
    (body
      (switch result
        (case failure
          (then
            (return fallback)))
        (case success
          (bind value v)
          (then
            (return v))))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let result (call App.oops))
      (return (call App.valueOr result 7)))))
(expect (answers 7))
