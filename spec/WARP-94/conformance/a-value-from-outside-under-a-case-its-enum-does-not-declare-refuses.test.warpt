(test 1)
(name "a-value-from-outside-under-a-case-its-enum-does-not-declare-refuses")
(note "The host hands a struct under `App.Light.blue` where the entry declares `App.Light`. `App.Light` declares `green` and `red` and nothing declares `App.Light.blue`, so the door refuses the run before anything runs.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns String)
    (body
      (return "ok"))))
(arguments (argument light (struct App.Light.blue)))
(expect (refuses run))
