(test 1)
(name "a-cast-between-an-enum-and-a-dictionary-refuses")
(note "`light` is read as `App.Light`, and no value of an enum is a dictionary. The cast to `Dictionary<String, Int>` names a type no value it reads is, so the build refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let light (type App.Light) (case red))
      (let d (as light (dictionary String Int)))
      (return 1))))
(expect (refuses build))
