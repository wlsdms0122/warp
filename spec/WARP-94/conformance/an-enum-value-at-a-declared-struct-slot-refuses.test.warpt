(test 1)
(name "an-enum-value-at-a-declared-struct-slot-refuses")
(note "An enum, a declared struct and a dictionary are types none of which takes another. `light` is read as `App.Light`, which `App.Point` does not take, so the build refuses the call.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (struct App.Point
    (field x Int))
  (procedure App.take
    (parameter point (type App.Point))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let light (type App.Light) (case red))
      (return (call App.take light)))))
(expect (refuses build))
