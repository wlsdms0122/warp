(test 1)
(name "a-type-argument-naming-a-cases-spelling-refuses")
(note "A case is not a type, so `App.Light.red` written as a type argument names none. The document declaring the enum writes it, and shows it alone, so the load refuses.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (enum App.Light
    (case green)
    (case red))
  (procedure App.take
    (parameter box (type (named App.Box App.Light.red)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
