(test 1)
(name "a-cast-between-two-enums-refuses")
(note "`light` is read as `App.Light`, and `App.Signal` declares cases of the same names, but two enums are two types by name. The cast names a type no value it reads is, so the build refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (enum App.Signal
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let light (type App.Light) (case red))
      (let signal (as light App.Signal))
      (return 1))))
(expect (refuses build))
