(test 1)
(name "an-asking-cast-of-a-case-whose-field-does-not-fit-the-enum-as-applied-reads-null")
(note "The host hands `App.Result.success` carrying a string, and the entry asks for an `App.Result<Int, String>`. The value is under one of the enum's cases, but its field does not fit the enum as the cast applies it, so the asking cast reads the none.")

(program
  (warp 1)
  (enum App.Result
    (typeParameter T)
    (typeParameter E)
    (case failure (field error (some E)))
    (case success (field value (some T))))
  (procedure entry
    (access public)
    (parameter value)
    (returns (optional (named App.Result Int String)))
    (body
      (return (as? value (named App.Result Int String))))))
(arguments (argument value (struct App.Result.success (field value "s"))))
(expect (answers null))
