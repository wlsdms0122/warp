(test 1)
(name "a-native-procedure-returning-a-case-its-enum-does-not-declare-refuses")
(note "`App.pick` is declared to return `App.Light`, and the host's answer crosses the door, which holds it to its case. `App.Light.blue` is a spelling no enum declares a case under, so the run refuses.")

(vocabulary
  (enum App.Light
    (case green)
    (case red))
  (procedure App.pick
    (returns App.Light)
    (answers (struct App.Light.blue))))

(program
  (warp 1)
  (import App.pick)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let light (call App.pick))
      (switch light
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2)))))))
(expect (refuses run))
