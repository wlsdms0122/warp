(test 1)
(name "concurrent-failed-says-a-list-pieces-position-as-its-digits")
(note "A list's piece stands in `failures` under its position, an `Int`, and the message says each key as `text` spells it, so the pieces of an `all` are said as `0` and `1`, in the key order.")

(program
  (warp 1)
  (import Standard.Concurrent.all)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns String)
    (body
      (var tried "none")
      (let caught
        (try
          (body
            (call Standard.Concurrent.all
              (array
                (closure
                  (const)
                  (isolated)
                  (returns Never)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "first")))
                (closure
                  (const)
                  (isolated)
                  (returns Never)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "second"))))))
          (catch
            (set tried (path caught (field message))))))
      (return tried))))
(expect (answers "concurrent pieces failed: 0: first; 1: second"))
