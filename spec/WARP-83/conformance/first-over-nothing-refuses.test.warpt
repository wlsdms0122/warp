(test 1)
(name "first-over-nothing-refuses")
(note "A procedure that returns exactly one thing has no empty return value.")

(program
  (warp 1)
  (import Standard.Concurrent.first)
  (procedure entry
    (access public)
    (returns Never)
    (failing concurrent_failed)
    (body
      (return (call Standard.Concurrent.first (array))))))
(expect (refuses run))
