(test 1)
(name "concurrent-failed-says-int-keys-in-the-key-order")
(note "The message says the pieces in the key order of failures, and Int keys order by worth, so 2 comes before 10 although the text 10 sorts before the text 2.")

(program
  (warp 1)
  (import Standard.Concurrent.allKeyed)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns String)
    (body
      (var tried "none")
      (let caught
        (try
          (body
            (call Standard.Concurrent.allKeyed
              (dictionary
                (entry 10
                  (closure
                    (const)
                    (isolated)
                    (returns Never)
                    (failing aborted)
                    (body
                      (call Standard.Control.abort "ten"))))
                (entry 2
                  (closure
                    (const)
                    (isolated)
                    (returns Never)
                    (failing aborted)
                    (body
                      (call Standard.Control.abort "two")))))))
          (catch
            (set tried (path caught (field message))))))
      (return tried))))
(expect (answers "concurrent pieces failed: 2: two; 10: ten"))
