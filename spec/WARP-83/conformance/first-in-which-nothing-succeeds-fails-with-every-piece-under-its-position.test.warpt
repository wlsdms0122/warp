(test 1)
(name "first-in-which-nothing-succeeds-fails-with-every-piece-under-its-position")
(note "A first in which nothing succeeds fails the way all fails: every piece's failure in failures, under the piece's position in pieces.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (import Standard.Concurrent.first)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns (array Int))
    (failing cast_refused)
    (body
      (var tried)
      (let caught
        (try
          (body
            (call Standard.Concurrent.first
              (array
                (closure
                  (const)
                  (isolated)
                  (returns Int)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "left")))
                (closure
                  (const)
                  (isolated)
                  (returns Int)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "right")))))
            (set tried (array)))
          (catch
            (let failures (as (path caught (field details) (index "failures")) (dictionary Int Any)))
            (set tried (call Standard.Collection.keys failures)))))
      (return tried))))
(expect (answers (array 0 1)))
