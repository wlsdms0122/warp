(test 1)
(name "a-piece-that-is-not-a-closure-refuses")
(note "`Standard.Concurrent.all` takes `Array<isolated Procedure>`, so a piece the text shows is not a closure is refused at the build.")

(program
  (warp 1)
  (import Standard.Concurrent.all)
  (procedure entry
    (access public)
    (returns (array Any))
    (failing concurrent_failed)
    (body
      (return
        (call Standard.Concurrent.all
          (array
            (closure
              (isolated)
              (returns Int)
              (body
                (return 1)))
            2))))))
(expect (refuses build))
