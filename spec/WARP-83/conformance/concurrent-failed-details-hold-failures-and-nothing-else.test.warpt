(test 1)
(name "concurrent-failed-details-hold-failures-and-nothing-else")
(note "The `details` of `concurrent_failed` hold `failures` and nothing else, so their keys are `failures` alone.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (import Standard.Concurrent.all)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (isolated)
    (returns (array String))
    (body
      (var tried (array))
      (let caught
        (try
          (body
            (call Standard.Concurrent.all
              (array
                (closure
                  (const)
                  (isolated)
                  (returns Never)
                  (failing aborted)
                  (body
                    (call Standard.Control.abort "on purpose"))))))
          (catch
            (set tried (call Standard.Collection.keys (path caught (field details)))))))
      (return tried))))
(expect (answers (array "failures")))
