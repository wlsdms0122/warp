(test 1)
(name "first-keyed-over-nothing-refuses")
(note "A procedure that returns exactly one thing has no empty return value, over a dictionary as over a list.")

(program
  (warp 1)
  (import Standard.Concurrent.firstKeyed)
  (procedure entry
    (access public)
    (returns Never)
    (failing concurrent_failed)
    (body
      (return (call Standard.Concurrent.firstKeyed (dictionary))))))
(expect (refuses run))
