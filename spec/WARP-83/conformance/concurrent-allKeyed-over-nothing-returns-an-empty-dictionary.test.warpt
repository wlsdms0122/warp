(test 1)
(name "concurrent-allKeyed-over-nothing-returns-an-empty-dictionary")
(note "allKeyed returns each piece's return value under its key, so over a dictionary holding nothing it returns a dictionary holding nothing. Only a race needs pieces.")

(program
  (warp 1)
  (import Standard.Concurrent.allKeyed)
  (procedure entry
    (access public)
    (isolated)
    (returns (dictionary String Any))
    (failing concurrent_failed)
    (body
      (return (call Standard.Concurrent.allKeyed (dictionary))))))
(expect (answers (dictionary)))
