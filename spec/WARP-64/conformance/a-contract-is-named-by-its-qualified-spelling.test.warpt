(test 1)
(name "a-contract-is-named-by-its-qualified-spelling")
(note "A contract name is its declared spelling with the declaring module in front. `Standard` declares Comparable, so a bound that means it writes `Standard.Comparable`.")

(program
  (warp 1)
  (import Standard.Comparable)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call keep 3))))
  (procedure keep
    (parameter value (type (some T Standard.Comparable)))
    (returns (some T))
    (body
      (return value))))
(expect (answers 3))
