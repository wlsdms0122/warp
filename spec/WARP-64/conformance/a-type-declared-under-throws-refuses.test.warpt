(test 1)
(name "a-type-declared-under-throws-refuses")
(note "`throws` is a word a procedure type's spelling writes before its `->`, and no type's name. A type declared under it refuses at the load.")

(program
  (warp 1)
  (type throws Int)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
