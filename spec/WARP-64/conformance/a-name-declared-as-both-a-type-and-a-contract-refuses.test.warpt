(test 1)
(name "a-name-declared-as-both-a-type-and-a-contract-refuses")
(note "Types and contracts share one namespace, and a name in it is one of them. One document declares `App.Thing` as a type and as a contract, which the document decides alone, so it refuses at the load.")

(program
  (warp 1)
  (type App.Thing Int)
  (contract App.Thing
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
