(test 1)
(name "a-cast-to-an-associated-type-reads-it-as-the-call-filled-it")
(note "App.g bounds C by App.Container, which asks `Item`, and casts to `some C.Item`. The call fills C with App.Words, whose `Item` is `String`, so the cast reads the string as a `String`.")

(program
  (warp 1)
  (struct App.Box
    (satisfies App.Container)
    (field x Int)
    (type Item Int)
    (procedure first
      (parameter of (type App.Box))
      (returns Int)
      (body
        (return 0))))
  (struct App.Words
    (satisfies App.Container)
    (field x Int)
    (type Item String)
    (procedure first
      (parameter of (type App.Words))
      (returns String)
      (body
        (return "w"))))
  (contract App.Container
    (type Item)
    (procedure first
      (parameter of (type Self))
      (returns Self.Item)))
  (procedure App.g
    (parameter c (type (some C App.Container)))
    (parameter a)
    (returns (some C.Item))
    (failing cast_refused)
    (body
      (return (as a (some C.Item)))))
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (let w (type App.Words) (struct (field x 1)))
      (return (call App.g w "s")))))
(expect (answers "s"))
