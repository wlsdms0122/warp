(test 1)
(name "a-cast-of-a-list-literal-to-a-list-of-the-optional-of-its-element-refuses")
(note "`[1]` read as written is `Array<Int>`, and `Array<Int?>` takes that reading with each element as its some by promotion, so the cast says what a name declared `Array<Int?>` says, and refuses at the build, though no element can hold a none.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (return (as (array 1) (array (optional Int)))))))
(expect (refuses build))
