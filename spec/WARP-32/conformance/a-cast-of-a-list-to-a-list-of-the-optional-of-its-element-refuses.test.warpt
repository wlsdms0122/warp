(test 1)
(name "a-cast-of-a-list-to-a-list-of-the-optional-of-its-element-refuses")
(note "`xs` reads `Array<Int?>`, and `Array<Int??>` takes that reading with each element as its some by promotion, so a cast of `xs` to `Array<Int??>` says what a name declared `Array<Int??>` says, and refuses at the build.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (let xs (type (array (optional Int))) (array null))
      (return (as xs (array (optional (optional Int))))))))
(expect (refuses build))
