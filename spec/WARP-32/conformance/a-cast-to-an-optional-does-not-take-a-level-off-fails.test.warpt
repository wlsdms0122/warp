(test 1)
(name "a-cast-to-an-optional-does-not-take-a-level-off-fails")
(note "A cast judges the value against the type it names and takes no level off. `Some` holding `null` is the some of a none, which is no `Int?`, so the cast to `Int?` fails with `cast_refused`, which the try catches.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter payload)
    (returns (optional String))
    (body
      (var tried)
      (let caught
        (try
          (body
            (as payload (optional Int)))
          (catch
            (set tried (path caught (field type))))))
      (return tried))))
(arguments (argument payload (struct Some (field wrapped null))))
(expect (answers "cast_refused"))
