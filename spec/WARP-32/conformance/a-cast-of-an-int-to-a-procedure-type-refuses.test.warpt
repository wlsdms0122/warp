(test 1)
(name "a-cast-of-an-int-to-a-procedure-type-refuses")
(note "`x` reads `Int` and the cast names `(Int) -> Int`. A procedure type holds procedures and an `Int` is none, so no value is both and the build refuses the cast.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter x (type Int))
    (returns Any)
    (failing cast_refused)
    (body
      (return (as x (procedure (parameters Int) (returns Int)))))))
(arguments (argument x 1))
(expect (refuses build))
