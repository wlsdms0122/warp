(test 1)
(name "a-cast-of-a-null-reading-to-an-int-refuses")
(note "`n` reads `Null`, whose one value is null, and the cast names `Int`, which holds no null. No value is both, so the build refuses the cast.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter n (type Null))
    (returns Any)
    (failing cast_refused)
    (body
      (return (as n Int)))))
(arguments (argument n null))
(expect (refuses build))
