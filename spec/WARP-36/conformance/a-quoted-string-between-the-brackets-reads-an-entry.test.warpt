(test 1)
(name "a-quoted-string-between-the-brackets-reads-an-entry")
(note "A string between double quotes in the brackets is a key written there, so `d[\"b\"]` reads the entry under the string b.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let d (type (dictionary String Int)) (dictionary (entry "a" 1) (entry "b" 2)))
      (return (path d (index "b"))))))
(expect (answers 2))
