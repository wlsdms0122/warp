(test 1)
(name "a-dictionary-keyed-by-ints-reads-a-key-the-run-reads")
(note "A path between the brackets of a dictionary stands where the dictionary's key type is read, so on `Dictionary<Int, String>` an `Int` the run reads finds the entry under it.")

(program
  (warp 1)
  (procedure App.read
    (parameter of (type (dictionary Int String)))
    (parameter key (type Int))
    (returns String)
    (body
      (return (path of (index key)))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call App.read (dictionary (entry 0 "y") (entry 7 "x")) 7)))))
(expect (answers "x"))
