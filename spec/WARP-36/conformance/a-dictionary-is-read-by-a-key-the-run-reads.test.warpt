(test 1)
(name "a-dictionary-is-read-by-a-key-the-run-reads")
(note "A dictionary's keys are data, so a key the run reads finds an entry the way a written key does. That is what lets a document walk a dictionary at all, and `values` is what walking one is for.")

(program
  (warp 1)
  (import Standard.Collection.appending)
  (import Standard.Collection.count)
  (import Standard.Collection.keys)
  (import Standard.Comparable.lessThan)
  (procedure App.values
    (parameter of (type (dictionary String Int)))
    (returns (array Int))
    (body
      (let names (call Standard.Collection.keys of))
      (var held (array))
      (let walk
        (loop
          (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count names)))
          (body
            (let name (path names (index (path walk (field index)))))
            (set held (call Standard.Collection.appending held (path of (index name)))))))
      (return held)))
  (procedure entry
    (access public)
    (returns (array Int))
    (body
      (return (call App.values (dictionary (entry "first" 1) (entry "second" 2)))))))
(expect (answers (array 1 2)))
