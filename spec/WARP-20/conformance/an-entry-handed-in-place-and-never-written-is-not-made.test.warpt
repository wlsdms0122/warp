(test 1)
(name "an-entry-handed-in-place-and-never-written-is-not-made")
(note "An entry the dictionary does not hold is made by the write that lands on it. `d[\"new\"]` is handed in place to `App.leave`, which never writes it, so the dictionary still holds one entry after the call.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure App.leave
    (parameter x (type (inout Int)))
    (returns Int)
    (body
      (return 0)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var d (type (dictionary String Int)) (dictionary (entry "a" 1)))
      (let r (call App.leave (path d (index "new"))))
      (return (call Standard.Collection.count d)))))
(expect (answers 1))
