(test 1)
(name "two-ways-taking-a-variable-as-different-types-refuse")
(note "Each arm of the conditional makes a closure that takes `n`: one while it holds an int, one after the arm set it to a string. Either closure may be the one that ran, so a write after the arms meet would have to fit both types, and the build refuses where they meet.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (returns Int)
    (body
      (var n 0)
      (conditional
        (when ready)
        (then
          (let a
            (closure
              (body
                (set n (call Standard.Numeric.plus n 1))))))
        (else
          (set n "s")
          (let b
            (closure
              (body
                (set n "t"))))))
      (return 1))))
(expect (refuses build))
