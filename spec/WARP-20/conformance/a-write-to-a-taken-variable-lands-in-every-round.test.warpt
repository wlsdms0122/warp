(test 1)
(name "a-write-to-a-taken-variable-lands-in-every-round")
(note "Each round writes an int into a variable that started null and lets a closure capture it. The write lands in every round, so the variable reads Int where the round adds to it, and after the loop.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (import Standard.Comparable.lessThan)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (isolated)
    (returns (optional Int))
    (body
      (var x)
      (var i 0)
      (var fs (type (array (procedure (const) (isolated) (parameters) (returns Int)))) (array))
      (let w
        (loop
          (while (call Standard.Comparable.lessThan i 2))
          (body
            (set x 1)
            (call Standard.Collection.append fs
              (closure
                (const)
                (isolated)
                (returns Int)
                (body
                  (return x))))
            (let y (call Standard.Numeric.plus x 1))
            (set i (call Standard.Numeric.plus i 1)))))
      (return x))))
(expect (answers 1))
