(test 1)
(name "a-write-at-a-constant-position-writes-the-element")
(note "An integer constant written between the brackets of a write folds at the build to a position, and the write lands on that element.")

(program
  (warp 1)
  (const K 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var d (type (array Int)) (array 1 1))
      (set (path d (index K)) 2)
      (return (path d (index K))))))
(expect (answers 2))
