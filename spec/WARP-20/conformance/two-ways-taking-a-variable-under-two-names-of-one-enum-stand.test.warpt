(test 1)
(name "two-ways-taking-a-variable-under-two-names-of-one-enum-stand")
(note "Two names for one declared enum are one type. One arm takes `n` while it reads `App.F`, a name for `App.E`, the other sets it to an `App.E` and takes it there, and the build stands where they meet.")

(program
  (warp 1)
  (enum App.E
    (case a)
    (case b))
  (type App.F App.E)
  (procedure entry
    (access public)
    (parameter ready (type Bool))
    (returns Int)
    (failing cast_refused)
    (body
      (var n (as (case a) App.F))
      (conditional
        (when ready)
        (then
          (let x
            (closure
              (returns App.E)
              (body
                (return n)))))
        (else
          (set n (as (case b) App.E))
          (let y
            (closure
              (returns App.E)
              (body
                (return n))))))
      (return 1))))
(arguments (argument ready true))
(expect (answers 1))
