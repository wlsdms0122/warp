(test 1)
(name "a-struct-in-a-key-a-native-procedure-returns-is-fitted-to-its-declaration-refuses")
(note "At a door every struct a value holds, in a key as in a value, is fitted to the struct its name declares. `App.h` hands back a dictionary whose key is an `App.P` writing `y` where `App.P` declares `x`, so the run refuses there.")

(vocabulary
  (struct App.P
    (satisfies Hashable)
    (field x Int))
  (procedure App.h
    (const)
    (isolated)
    (returns (dictionary App.P Int))
    (answers (dictionary (entry (struct App.P (field y 1)) 1)))))

(program
  (warp 1)
  (import App.h)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (return (call App.h)))))
(expect (refuses run))
