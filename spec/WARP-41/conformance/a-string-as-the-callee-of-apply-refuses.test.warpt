(test 1)
(name "a-string-as-the-callee-of-apply-refuses")
(note "`apply` calls a value, and a string under `procedure` in the tree names a declaration, which `call` writes. A string as `apply`'s callee has no tree, and refuses.")
(text "(warp 1)\n\n(procedure entry\n  (access public)\n  (returns Int)\n  (body\n    (return (apply \"App.f\"))))")
(expect (refuses load))
