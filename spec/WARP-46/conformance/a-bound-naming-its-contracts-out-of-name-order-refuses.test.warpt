(test 1)
(name "a-bound-naming-its-contracts-out-of-name-order-refuses")
(note "A bound names its contracts in name order, so `some T: App.B & App.A` is a second spelling of `some T: App.A & App.B`, and one type is written one way, so this refuses at the load.")

(program
  (warp 1)
  (contract App.A)
  (contract App.B)
  (extension
    (head Int)
    (satisfies App.A App.B))
  (procedure App.f
    (parameter x (type (some T App.B App.A)))
    (returns Int)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.f 1)))))
(expect (refuses load))
