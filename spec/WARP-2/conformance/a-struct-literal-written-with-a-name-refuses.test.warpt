(test 1)
(name "a-struct-literal-written-with-a-name-refuses")
(note "A struct takes a name from a declared struct it is written into, a door it comes through or a cast, and never from a literal's text, so a literal written with a name refuses at the load, whatever the name.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (return (struct Ghost.T (field x 1))))))
(expect (refuses load))
