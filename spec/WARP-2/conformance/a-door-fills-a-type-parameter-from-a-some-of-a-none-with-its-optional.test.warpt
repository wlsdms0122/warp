(test 1)
(name "a-door-fills-a-type-parameter-from-a-some-of-a-none-with-its-optional")
(note "The entry takes `some T?` and is handed the marker holding `null`, a value of `Null?`. The door fills `T` with `Null`, so the value is the some and its payload is `null`.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter a (type (optional (some T))))
    (returns Any)
    (body
      (let x
        (unwrap a
          (else
            (return "none"))))
      (return (array "some" x)))))
(arguments (argument a (struct Some (field wrapped null))))
(expect (answers (array "some" null)))
