(test 1)
(name "a-some-with-a-field-beside-wrapped-refuses")
(note "A `Some` is a struct of exactly one field, `wrapped`. These bytes are a `Some` holding `null` under `wrapped` and another field beside it, which is no value, so the binary refuses it.")
(bytes x"57415250010904536f6d6502056f7468657200077772617070656400")
(expect (refuses load))
