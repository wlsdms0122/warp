(test 1)
(name "a-struct-named-as-the-contract-the-language-declares-in-a-cases-text-refuses")
(note "A struct carries the name of a declared struct. `Hashable` is the contract the language declares, so a struct carrying it is no value, and the text refuses it.")
(text "(test 1)\n(expect (answers (struct Hashable)))\n")
(expect (refuses load))
