(test 1)
(name "an-extensions-procedures-written-empty-beside-what-it-adopts-refuses")
(note "An extension's keys are not written empty. This one adopts `App.C`, a contract asking nothing, so it gives something, and the `procedures: {}` beside it says the same extension a second way.")
(tree (dictionary (entry "contracts" (dictionary (entry "App.C" (dictionary)))) (entry "extensions" (dictionary (entry "Int" (dictionary (entry "procedures" (dictionary)) (entry "satisfies" (array "App.C")))))) (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
