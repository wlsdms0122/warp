(test 1)
(name "claims-written-out-of-order-refuse")
(note "The contracts a type adopts under `satisfies` are written in name order, so `App.Y` before `App.X` is a second spelling of the same claims. A document says each thing one way, and this one refuses at the load.")

(program
  (warp 1)
  (struct Bank.A
    (satisfies App.Y App.X)
    (field n Int)
    (procedure d
      (parameter of (type Bank.A))
      (returns String)
      (body
        (return "a")))
    (procedure e
      (parameter of (type Bank.A))
      (returns String)
      (body
        (return "a"))))
  (contract App.X
    (procedure d
      (parameter of (type Self))
      (returns String)))
  (contract App.Y
    (procedure e
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
