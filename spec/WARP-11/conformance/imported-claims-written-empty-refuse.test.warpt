(test 1)
(name "imported-claims-written-empty-refuse")
(note "A document importing no claim writes no `importedClaims`, so `importedClaims: []` says it a second way.")
(tree (dictionary (entry "importedClaims" (array)) (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
