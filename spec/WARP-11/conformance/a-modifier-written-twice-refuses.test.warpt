(test 1)
(name "a-modifier-written-twice-refuses")
(note "`const const Procedure` says `const` once, so it is a second spelling of `const Procedure`. A document says each thing one way, and this one is refused where it is read.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter f (type (procedure (const) (const))))
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
