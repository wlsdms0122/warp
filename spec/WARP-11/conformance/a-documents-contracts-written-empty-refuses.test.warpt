(test 1)
(name "a-documents-contracts-written-empty-refuses")
(note "A document declaring no contract writes no `contracts`, so `contracts: {}` says it a second way.")
(tree (dictionary (entry "contracts" (dictionary)) (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "returns" "Int"))))) (entry "warp" 1)))
(expect (refuses load))
