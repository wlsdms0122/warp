(test 1)
(name "a-declaration-saying-nothing-backing-an-isolated-contract-refuses")
(note "A claim backed by a declaration that says less than the contract asked does not hold. `App.Named` asks `name` to be `isolated`, and `App.Thing`'s `name` leaves it out, so the claim refuses at the build.")

(program
  (warp 1)
  (struct App.Thing
    (satisfies App.Named)
    (field id Int)
    (procedure name
      (parameter of (type App.Thing))
      (returns String)
      (body
        (return "thing"))))
  (contract App.Named
    (procedure name
      (isolated)
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (parameter it (type (some T App.Named)))
    (returns String)
    (body
      (return (call App.Named.name it))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.tell (as (struct (field id 1)) App.Thing))))))
(expect (refuses build))
