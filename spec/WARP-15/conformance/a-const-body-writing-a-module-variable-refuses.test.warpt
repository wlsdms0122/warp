(test 1)
(name "a-const-body-writing-a-module-variable-refuses")
(note "A const body writes no name it does not own, and a module variable is the run's. `App.reset` writes `count` and reads nothing outside the run, so the write alone is what the build refuses.")

(program
  (warp 1)
  (var count (type Int) 0)
  (procedure App.reset
    (const)
    (returns Int)
    (body
      (set count 1)
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.reset)))))
(expect (refuses build))
