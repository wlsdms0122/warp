(test 1)
(name "an-operand-calling-a-contract-procedure-that-may-run-refuses")
(note "A contract's procedure writing neither `const` nor `isolated` may run, so a call through it is read the way a call to a declaration that runs is: an operand is read rather than run, and this one is refused at the build.")

(program
  (warp 1)
  (import Standard.Text.uppercased)
  (struct App.Thing
    (satisfies App.Named)
    (field id Int)
    (procedure name
      (parameter of (type App.Thing))
      (returns String)
      (body
        (return "thing"))))
  (contract App.Named
    (procedure name
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (parameter it (type (some T App.Named)))
    (returns String)
    (body
      (return (call Standard.Text.uppercased (call App.Named.name it)))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.tell (as (struct (field id 1)) App.Thing))))))
(expect (refuses build))
