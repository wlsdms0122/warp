(test 1)
(name "a-contract-procedure-may-say-it-fails-with-anything")
(note "A contract's procedure writes `failing` the way any declaration does, `anything` included, and a declaration satisfying it may then fail with anything. A call through the contract may fail with anything, which the catch around it catches.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (contract App.Runner
    (procedure run
      (parameter of (type Self))
      (returns Int)
      (failing (anything))))
  (extension
    (head Int)
    (satisfies App.Runner)
    (procedure run
      (parameter of (type Int))
      (returns Never)
      (failing (anything))
      (body
        (return (call Standard.Control.abort "no")))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (var tried)
      (try
        (body
          (let ran (call App.Runner.run 1))
          (set tried "ran"))
        (catch
          (set tried "caught")))
      (return tried))))
(expect (answers "caught"))
