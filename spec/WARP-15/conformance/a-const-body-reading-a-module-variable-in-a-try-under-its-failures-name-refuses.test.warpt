(test 1)
(name "a-const-body-reading-a-module-variable-in-a-try-under-its-failures-name-refuses")
(note "A try's name binds the failure only while the catch runs, so in the try's body the spelling is still the module variable. `App.r` is declared `const` and its try's body reads the variable `tried`, so it refuses at the build.")

(program
  (warp 1)
  (var tried (type Any) 0)
  (procedure App.r
    (const)
    (returns Any)
    (body
      (var kept)
      (let tried
        (try
          (body
            (let read (as tried String))
            (set kept read))
          (catch
            (set kept "caught"))))
      (return kept)))
  (procedure entry
    (access public)
    (returns Any)
    (body
      (return (call App.r)))))
(expect (refuses build))
