(test 1)
(name "a-const-closure-writing-what-it-captured-refuses")
(note "A name a closure captured is a box outside the closure, so writing it reaches the run's state the way writing a module variable does. The closure declares `const` and writes the captured `seen`, so it refuses at the build where it is written, called or not.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var seen 0)
      (let step
        (closure
          (const)
          (parameter item (type Int))
          (returns Int)
          (body
            (set seen (call Standard.Numeric.plus seen item))
            (return item))))
      (return seen))))
(expect (refuses build))
