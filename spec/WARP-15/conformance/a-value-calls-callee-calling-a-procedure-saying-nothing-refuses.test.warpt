(test 1)
(name "a-value-calls-callee-calling-a-procedure-saying-nothing-refuses")
(note "A value call's callee is an operand, read rather than run. The callee is a call of `App.make`, which returns a const closure but says nothing of itself, so the build refuses the call of it there.")

(program
  (warp 1)
  (procedure App.make
    (returns (procedure (const) (isolated) (parameters) (returns Int)))
    (body
      (return
        (closure
          (const)
          (isolated)
          (returns Int)
          (body
            (return 1))))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (apply (call App.make))))))
(expect (refuses build))
