(test 1)
(name "a-const-body-calling-a-part-of-a-list-literal-refuses")
(note "A list literal writes no type for its parts, so a part of one reached through a name that writes none carries no claim. `App.f` is const and calls `fs[0]`, a closure declaring itself const inside a list literal, and the build refuses the call.")

(program
  (warp 1)
  (procedure App.f
    (const)
    (returns Int)
    (failing (anything))
    (body
      (let fs
        (array
          (closure
            (const)
            (returns Int)
            (body
              (return 1)))))
      (let r (apply (path fs (index 0))))
      (return r)))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (return (call App.f)))))
(expect (refuses build))
