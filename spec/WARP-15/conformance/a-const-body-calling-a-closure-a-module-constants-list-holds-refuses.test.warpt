(test 1)
(name "a-const-body-calling-a-closure-a-module-constants-list-holds-refuses")
(note "A list literal writes no type for its parts, and a module constant writes no type, so `ks[0]`, a const closure inside the constant's list literal, carries no claim. A const entry calling it refuses at the build: the claim is the type written's, not what the constant's reading holds.")

(program
  (warp 1)
  (const ks
    (array
      (closure
        (const)
        (isolated)
        (returns Int)
        (body
          (return 1)))))
  (procedure entry
    (access public)
    (const)
    (returns Int)
    (body
      (return (apply (path ks (index 0)))))))
(expect (refuses build))
