(test 1)
(name "a-const-body-sending-a-contract-procedure-writing-neither-refuses")
(note "A contract's procedure writing neither `const` nor `isolated` may run, so a body declared `const` may not send it. `App.tell` returns the call through `App.Named.name`, a statement and not an operand, so the const claim is what refuses.")

(program
  (warp 1)
  (struct App.Thing
    (satisfies App.Named)
    (field id Int)
    (procedure name
      (parameter of (type App.Thing))
      (returns String)
      (body
        (return "thing"))))
  (contract App.Named
    (procedure name
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (const)
    (parameter it (type (some T App.Named)))
    (returns String)
    (body
      (return (call App.Named.name it))))
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (return (call App.tell (as (struct (field id 1)) App.Thing))))))
(expect (refuses build))
