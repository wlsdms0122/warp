(test 1)
(name "a-body-returning-a-value-where-no-returns-is-written-refuses")
(note "A declaration that writes no `returns` returns null, so a body whose `return` carries a number returns more than its declaration says, and refuses at the build.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (body
      (return 1))))
(expect (refuses build))
