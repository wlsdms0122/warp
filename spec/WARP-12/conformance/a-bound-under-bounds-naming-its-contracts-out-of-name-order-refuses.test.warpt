(test 1)
(name "a-bound-under-bounds-naming-its-contracts-out-of-name-order-refuses")
(note "A bound under `bounds` is a bound, written one way: its contracts stand in name order. `App.B & App.A` is a second spelling of `App.A & App.B`, and the document is refused where it is read.")

(program
  (warp 1)
  (contract App.A)
  (contract App.B)
  (contract App.Keyed
    (type Item))
  (procedure App.f
    (parameter x (type (some T App.Keyed)))
    (returns Int)
    (bound T.Item App.B App.A)
    (body
      (return 1)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
