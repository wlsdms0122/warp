(test 1)
(name "a-closure-writing-returns-whose-body-reaches-its-end-refuses")
(note "The closure `f` holds writes `returns Int`, and its body ends in a `let`. A closure literal writes its signature the way a declaration does and is held to leaving on every way through its body the same way, so the build refuses it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (closure
          (returns Int)
          (body
            (let x 1))))
      (return (apply f)))))
(expect (refuses build))
