(test 1)
(name "a-declaration-writing-no-returns-returns-null")
(note "A declaration that writes no `returns` returns null: `Null` is the return value of a procedure that returns nothing, and nothing is read off its body.")

(program
  (warp 1)
  (procedure App.nothing
    (body
      (let x 1)))
  (procedure entry
    (access public)
    (body
      (return (call App.nothing)))))
(expect (answers null))
