(test 1)
(name "a-dictionary-literal-keyed-by-a-list-holding-a-procedure-refuses")
(note "A value holding a procedure is the same as no value, so it is no key. A list of anything conforms to `Hashable` and the build cannot see what the run puts in it, so the dictionary the literal makes under one refuses at the run.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let f
        (closure
          (returns Int)
          (body
            (return 1))))
      (let k (type (array Any)) (array f))
      (let d (dictionary (entry k 1)))
      (return (call Standard.Collection.count d)))))
(expect (refuses run))
