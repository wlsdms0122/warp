(test 1)
(name "an-int-key-stands-between-doubles-by-its-worth")
(note "Numbers are one kind in the key order and ascend by worth whichever type each is, so the Double 1.5 stands between the Ints 1 and 2.")
(bytes x"5741525001070303020302043ff8000000000000030403040306")
(expect (spells (dictionary (entry 1 1) (entry 1.5 2) (entry 2 3))))
