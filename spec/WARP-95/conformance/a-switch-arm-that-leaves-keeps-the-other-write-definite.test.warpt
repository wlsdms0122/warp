(test 1)
(name "a-switch-arm-that-leaves-keeps-the-other-write-definite")
(note "A way that leaves contributes nothing where the ways meet. The `green` arm returns, so every way that finishes made the `red` arm's write, and `kept` reads `Int` after the switch.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (var kept)
      (switch light
        (case green
          (then
            (return 0)))
        (case red
          (then
            (set kept 1))))
      (return kept))))
(arguments (argument light (struct App.Light.red)))
(expect (answers 1))
