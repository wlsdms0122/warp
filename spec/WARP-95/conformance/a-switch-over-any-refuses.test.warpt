(test 1)
(name "a-switch-over-any-refuses")
(note "An `of` whose reading is no enum refuses at the build, since the build cannot hold the arms to a declaration. `value` reads `Any`, and a cast has to say which enum first.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter value)
    (returns Int)
    (body
      (switch value
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2)))))))
(arguments (argument value (struct App.Light.red)))
(expect (refuses build))
