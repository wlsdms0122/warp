(test 1)
(name "a-statement-after-a-switch-every-way-of-which-leaves-refuses")
(note "Both arms of the switch return, so it never finishes, and nothing may follow it. The text shows it, so the load refuses the statement after it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (switch light
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2))))
      (return 3))))
(arguments (argument light (struct App.Light.red)))
(expect (refuses load))
