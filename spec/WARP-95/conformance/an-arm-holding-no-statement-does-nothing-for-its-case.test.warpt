(test 1)
(name "an-arm-holding-no-statement-does-nothing-for-its-case")
(note "An arm's `then` may hold no statement, which is how a switch does nothing for a case. Handed `green`, the switch runs the empty arm, and `n` keeps the 0 it started with.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (var n 0)
      (switch light
        (case green
          (then))
        (case red
          (then
            (set n 1))))
      (return n))))
(arguments (argument light (struct App.Light.green)))
(expect (answers 0))
