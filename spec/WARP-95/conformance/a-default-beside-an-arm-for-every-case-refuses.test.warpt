(test 1)
(name "a-default-beside-an-arm-for-every-case-refuses")
(note "Every case `App.Light` declares has an arm, so the `default` takes no case and no run reaches it. A body no run reaches refuses at the build, as a catch over a body that cannot fail does.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns String)
    (body
      (switch light
        (case green
          (then
            (return "go")))
        (case red
          (then
            (return "stop")))
        (default
          (return "wait"))))))
(arguments (argument light (struct App.Light.red)))
(expect (refuses build))
