(test 1)
(name "a-closure-captures-a-name-an-arm-binds")
(note "The `remote` arm binds `port` to `p`, and a closure written in the arm's `then` captures it as it captures any name in reach. Called there, the closure returns the port.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (parameter target (type App.Target))
    (returns Int)
    (body
      (switch target
        (case local
          (then
            (return 0)))
        (case remote
          (bind port p)
          (then
            (let f
              (closure
                (returns Int)
                (body
                  (return p))))
            (return (apply f))))))))
(arguments (argument target (struct App.Target.remote (field host "a") (field port 8080))))
(expect (answers 8080))
