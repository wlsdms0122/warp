(test 1)
(name "a-switch-arm-naming-a-case-its-enum-does-not-declare-refuses")
(note "`App.Light` declares `green` and `red`, and the switch writes an arm for `blue` beside them. A `cases` naming a case the enum does not declare refuses at the build, where the declaration is read.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (switch light
        (case blue
          (then
            (return 0)))
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2)))))))
(arguments (argument light (struct App.Light.red)))
(expect (refuses build))
