(test 1)
(name "a-set-of-a-bound-name-refuses")
(note "A bound name is fixed, as an unwrap's payload is. The `remote` arm sets `p`, so the load refuses it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (parameter target (type App.Target))
    (returns Int)
    (body
      (switch target
        (case local
          (then
            (return 0)))
        (case remote
          (bind port p)
          (then
            (set p 1)
            (return p)))))))
(arguments (argument target (struct App.Target.remote (field host "a") (field port 8080))))
(expect (refuses load))
