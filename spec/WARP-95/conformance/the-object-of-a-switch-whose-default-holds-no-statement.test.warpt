(test 1)
(name "the-object-of-a-switch-whose-default-holds-no-statement")
(note "The `default` holds no statement, so operation 17 writes it as a list holding the empty instruction list, `[[]]`, which stays apart from the `[]` of a switch writing no `default`.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red)
    (case yellow))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (switch light
        (case green
          (then
            (return 1)))
        (default))
      (return 0))))
