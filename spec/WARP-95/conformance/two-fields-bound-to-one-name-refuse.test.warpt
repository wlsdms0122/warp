(test 1)
(name "two-fields-bound-to-one-name-refuse")
(note "The `remote` arm binds both `host` and `port` to `x`, one name introduced two ways in one arm, so the load refuses it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (parameter target (type App.Target))
    (returns Int)
    (body
      (switch target
        (case local
          (then
            (return 0)))
        (case remote
          (bind host x)
          (bind port x)
          (then
            (return 1)))))))
(arguments (argument target (struct App.Target.remote (field host "a") (field port 8080))))
(expect (refuses load))
