(test 1)
(name "a-switch-spells-as-text")
(note "A switch breaks by place with its subject on its first line, then the arms by case name and the `default`. An arm breaks by place as a `then` does, so one holding an empty `(then)` breaks too, and keeps its `bind`s by field name before its `then`. An empty `(then)` and `(default)` each write `[]`.")
(text "(warp 1)\n\n(enum App.Target\n  (case local)\n  (case none)\n  (case remote (field host String) (field port Int)))\n\n(procedure entry\n  (access public)\n  (parameter t (type App.Target))\n  (returns Int)\n  (body\n    (switch t\n      (case local\n        (then))\n      (case remote\n        (bind host h)\n        (bind port p)\n        (then\n          (return p)))\n      (default))\n    (return 0)))\n")
(expect (spells (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" (dictionary (entry "switch" (dictionary (entry "cases" (dictionary (entry "local" (dictionary (entry "then" (array)))) (entry "remote" (dictionary (entry "binds" (dictionary (entry "host" "h") (entry "port" "p"))) (entry "then" (array (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "ref" "p")))))))))))) (entry "default" (array)) (entry "of" (dictionary (entry "ref" "t")))))))) (dictionary (entry "value" (dictionary (entry "return" 0)))))) (entry "parameters" (array (dictionary (entry "name" "t") (entry "type" "App.Target")))) (entry "returns" "Int"))))) (entry "types" (dictionary (entry "App.Target" (dictionary (entry "enum" (dictionary (entry "local" (dictionary)) (entry "none" (dictionary)) (entry "remote" (dictionary (entry "host" "String") (entry "port" "Int"))))))))) (entry "warp" 1))))
