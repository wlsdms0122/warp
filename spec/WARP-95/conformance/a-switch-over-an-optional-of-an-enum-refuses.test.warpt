(test 1)
(name "a-switch-over-an-optional-of-an-enum-refuses")
(note "An `of` whose reading is no enum refuses at the build, and an Optional of an enum is none. `light` reads `App.Light?`, and an unwrap has to say there is an enum first.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type (optional App.Light)))
    (returns Int)
    (body
      (switch light
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2)))))))
(arguments (argument light (struct App.Light.red)))
(expect (refuses build))
