(test 1)
(name "a-write-every-way-of-a-switch-makes-reads-unconditional-after-it")
(note "Each arm of a switch is a way, and there is no other, since the switch handles every case. Both arms write `kept`, so after the switch it holds an `Int` on every way, and returning it where `Int` is declared builds.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (var kept)
      (switch light
        (case green
          (then
            (set kept 1)))
        (case red
          (then
            (set kept 2))))
      (return kept))))
(arguments (argument light (struct App.Light.red)))
(expect (answers 2))
