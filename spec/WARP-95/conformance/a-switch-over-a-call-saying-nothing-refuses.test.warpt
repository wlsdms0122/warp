(test 1)
(name "a-switch-over-a-call-saying-nothing-refuses")
(note "What `of` takes apart is an operand, read rather than run, as what an unwrap takes apart is. `App.pick` says nothing of itself, so the call there refuses at the build.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure App.pick
    (returns App.Light)
    (body
      (return (case red))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (switch
        (call App.pick)
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2)))))))
(expect (refuses build))
