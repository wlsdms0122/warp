(test 1)
(name "the-object-of-a-switch-binding-what-a-case-carries")
(note "A switch is operation 17: what it takes apart, the enum's name as a string, and an arm per case ascending, each with its binds as field and slot. What it takes apart is lowered first, and the bound `p` takes the next slot before its arm's `then` is walked. The switch stands on its enum by name, and on no entry of `typeNumbering`.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter t (type App.Target))
    (returns Int)
    (body
      (switch t
        (case local
          (then
            (return 0)))
        (case remote
          (bind port p)
          (then
            (return p)))))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false) (array 1 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"b510b7f766eec065007b2e04b8109c616bb204025856a24b82ff3010cb2e9548")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 1 0) (array 0 0) (array 13 0 (array 1)) (array 1 1) (array 13 0 (array 3)) (array 17 0 "App.Target" (array (array "local" (array) (array (array (array) 2))) (array "remote" (array (array "port" 1)) (array (array (array) 4)))) (array)))) (entry "rows" (array (array "entry" (array (array (array "t" (array 2))) 3 (array 1 (array)) 1 1 (array) (array)) 2 (array 0 (array (array (array) 5)) (array 2 (array 0) (array) (array) (array) (array "t" "p")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 6) (array 4) (array 14 "App.Target") (array 4))) (entry "types" (array (array "App.Target" (array 20 (array (array "local" (array)) (array "remote" (array (array "host" 0) (array "port" 1)))))))) (entry "valueTable" (array (array 2 0))) (entry "variables" (array)))))
