(test 1)
(name "a-bound-name-may-take-the-spelling-of-a-name-around-the-switch")
(note "The procedure takes a parameter `p`, and the `remote` arm binds `port` to `p` as well. A bound name may take the spelling of a name around the switch, and inside the arm `p` is the bound one, so the arm returns 8080 and not 1.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure App.port
    (parameter p (type Int))
    (parameter target (type App.Target))
    (returns Int)
    (body
      (switch target
        (case local
          (then
            (return p)))
        (case remote
          (bind port p)
          (then
            (return p))))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.port 1 (case remote (field host "a") (field port 8080)))))))
(expect (answers 8080))
