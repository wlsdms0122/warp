(test 1)
(name "a-switch-over-never-refuses")
(note "An `of` whose reading is no enum refuses at the build, and `Never` is no enum: the build has no declaration to hold the arms to. `light` reads `Never`.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 0)))
  (procedure stop
    (parameter light (type Never))
    (returns Int)
    (body
      (switch light
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return 2)))))))
(expect (refuses build))
