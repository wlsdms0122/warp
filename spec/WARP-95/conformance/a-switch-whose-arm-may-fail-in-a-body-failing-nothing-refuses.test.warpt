(test 1)
(name "a-switch-whose-arm-may-fail-in-a-body-failing-nothing-refuses")
(note "A switch may fail with what its ways fail with. The `red` arm casts to `Int`, which may fail with `cast_refused`, and the entry declares no failure, so the build refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (parameter value)
    (returns Int)
    (body
      (switch light
        (case green
          (then
            (return 1)))
        (case red
          (then
            (return (as value Int))))))))
(arguments (argument light (struct App.Light.red)) (argument value 2))
(expect (refuses build))
