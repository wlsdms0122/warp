(test 1)
(name "a-switch-taking-a-name-refuses")
(note "A switch is a statement: it has no value and takes no name, the way a conditional does. A `let` naming one refuses at the load.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (let word
        (switch light
          (case green
            (then))
          (case red
            (then))))
      (return 0))))
(arguments (argument light (struct App.Light.red)))
(expect (refuses load))
