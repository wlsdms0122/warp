(test 1)
(name "a-bound-name-read-after-its-arm-refuses")
(note "A bound name is read from the first statement of its arm's `then` to its end and nowhere after. The return after the switch reads `p`, which is not there, so the load refuses it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (parameter target (type App.Target))
    (returns Int)
    (body
      (switch target
        (case local
          (then))
        (case remote
          (bind port p)
          (then)))
      (return p))))
(arguments (argument target (struct App.Target.remote (field host "a") (field port 8080))))
(expect (refuses load))
