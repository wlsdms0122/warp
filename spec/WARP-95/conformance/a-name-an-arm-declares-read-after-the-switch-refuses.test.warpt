(test 1)
(name "a-name-an-arm-declares-read-after-the-switch-refuses")
(note "A name an arm declares is read to the end of that body and nowhere after. The `green` arm declares `inner`, and the statement after the switch reads it, so the load refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (parameter light (type App.Light))
    (returns Int)
    (body
      (switch light
        (case green
          (then
            (var inner 1)))
        (case red
          (then
            (return 2))))
      (let read inner)
      (return read))))
(arguments (argument light (struct App.Light.green)))
(expect (refuses load))
