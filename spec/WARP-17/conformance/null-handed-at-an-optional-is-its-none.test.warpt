(test 1)
(name "null-handed-at-an-optional-is-its-none")
(note "An argument holding null was given, and a slot of an Optional takes it as its none, so `App.takes` returns null.")

(program
  (warp 1)
  (procedure App.takes
    (parameter x (type (optional Int)))
    (returns (optional Int))
    (body
      (return x)))
  (procedure entry
    (access public)
    (returns (optional Int))
    (body
      (return (call App.takes null)))))
(expect (answers null))
