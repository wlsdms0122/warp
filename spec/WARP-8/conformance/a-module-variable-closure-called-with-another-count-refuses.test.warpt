(test 1)
(name "a-module-variable-closure-called-with-another-count-refuses")
(note "`f` declares the procedure type taking one `Int`, and starts at a closure of that type. A call handing `f` two arguments where its declared type takes one refuses at the build.")

(program
  (warp 1)
  (var f
    (type (procedure (parameters Int) (returns Int)))
    (closure
      (parameter x (type Int))
      (returns Int)
      (body
        (return x))))
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let a (apply f 1 2))
      (return a))))
(expect (refuses build))
