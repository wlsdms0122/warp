(test 1)
(name "a-constant-reading-other-than-a-constant-refuses")
(note "A constant sees no scope, so the only names it may read are the other constants its module declares. `limit` names a parameter of a procedure, which is a name that exists nowhere a constant can look. What a constant may see is a fact about the module and needs nothing linked to decide, so it is refused on the way in rather than left for the build.")

(program
  (warp 1)
  (const doubled limit)
  (procedure entry
    (access public)
    (parameter limit (type Int))
    (returns Int)
    (body
      (return doubled))))
(expect (refuses load))
