(test 1)
(name "a-list-holding-a-closure-that-may-fail-where-its-elements-fail-with-nothing-refuses")
(note "The list literal is written where `take` declares a list of const procedures failing with nothing, so each closure in it is read at that element type. The second may fail with `aborted`, more than the element type says, so the argument is refused at the build.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return
        (call take
          (array
            (closure
              (const)
              (parameter x (type Int))
              (returns Int)
              (body
                (return x)))
            (closure
              (const)
              (parameter x (type Int))
              (returns Int)
              (failing aborted)
              (body
                (return (call Standard.Control.abort "no")))))))))
  (procedure take
    (parameter steps (type (array (procedure (const) (parameters Int) (returns Int)))))
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
