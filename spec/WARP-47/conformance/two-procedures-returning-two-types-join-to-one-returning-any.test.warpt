(test 1)
(name "two-procedures-returning-two-types-join-to-one-returning-any")
(note "Two procedures taking the same positions and returning two types join to one returning `Any`. The list of a closure returning `Int` and one returning `String` reads as a list of `() -> Any`, which fills `Result` with `Any`, and each closure stands where `() -> Any` is asked.")

(program
  (warp 1)
  (import Standard.Concurrent.all)
  (procedure entry
    (access public)
    (isolated)
    (returns (array Any))
    (failing (anything))
    (body
      (return
        (call Standard.Concurrent.all
          (array
            (closure
              (isolated)
              (returns Int)
              (body
                (return 1)))
            (closure
              (isolated)
              (returns String)
              (body
                (return "a")))))))))
(expect (answers (array 1 "a")))
