(test 1)
(name "an-integer-literal-beside-a-name-holding-a-double-in-a-list-is-the-double")
(note "`d` holds a `Double`, and `[1, d]` is written where `Array<Any>` is declared. A name's reading stands beside the literal as a literal does, so `1` is `1.0`.")

(program
  (warp 1)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns String)
    (body
      (let d (type Double) 2.5)
      (let xs (type (array Any)) (array 1 d))
      (return (call Standard.Text.text xs)))))
(expect (answers "[1.0,2.5]"))
