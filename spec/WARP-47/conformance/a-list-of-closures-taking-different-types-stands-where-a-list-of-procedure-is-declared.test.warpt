(test 1)
(name "a-list-of-closures-taking-different-types-stands-where-a-list-of-procedure-is-declared")
(note "One closure takes `Int` and the other `String`, so the two join to `Procedure` and `fs` reads `Array<Procedure>`, which stands where `ps` declares it. A join reading `Any` would stand there only through a cast.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let fs
        (array
          (closure
            (parameter x (type Int))
            (returns Int)
            (body
              (return x)))
          (closure
            (parameter x (type String))
            (returns Int)
            (body
              (return 1)))))
      (let ps (type (array Procedure)) fs)
      (return (call Standard.Collection.count ps)))))
(expect (answers 2))
