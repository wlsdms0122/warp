(test 1)
(name "a-value-name-ending-in-a-line-break-refuses")
(note "A value's name is an identifier, which holds no white space, a line break included, so a statement named with one at its end refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let `a\n` 1)
      (return 1))))
(expect (refuses load))
