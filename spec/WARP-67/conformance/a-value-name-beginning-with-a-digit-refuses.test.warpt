(test 1)
(name "a-value-name-beginning-with-a-digit-refuses")
(note "An identifier begins with a letter or `_`, so a statement named `1x` refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let `1x` 1)
      (return 1))))
(expect (refuses load))
