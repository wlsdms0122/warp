(test 1)
(name "a-value-name-holding-a-space-refuses")
(note "A value's name is an identifier, which holds no white space, so a statement named `first name` refuses at the load.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let `first name` 1)
      (return 1))))
(expect (refuses load))
