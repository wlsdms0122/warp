(test 1)
(name "a-struct-type-field-holding-a-hyphen-refuses")
(note "A field of a struct type is called by a value's name, an identifier, so a field named `content-type` refuses at the load. A key that is no identifier is a dictionary's key.")

(program
  (warp 1)
  (struct App.Request
    (field content-type String))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
