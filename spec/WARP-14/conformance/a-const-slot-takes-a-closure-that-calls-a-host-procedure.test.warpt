(test 1)
(name "a-const-slot-takes-a-closure-that-calls-a-host-procedure")
(note "A slot asking a `const` procedure type takes a closure whose body sends only const procedures, and a native procedure says which it is.")

(vocabulary
  (procedure App.yes
    (const)
    (isolated)
    (returns Bool)
    (answers true)))

(program
  (warp 1)
  (import App.yes)
  (import Standard.Logic.and)
  (procedure entry
    (access public)
    (const)
    (returns Bool)
    (failing (anything))
    (body
      (return
        (call Standard.Logic.and
          (array
            (closure
              (const)
              (isolated)
              (returns Bool)
              (body
                (return (call App.yes))))))))))
(expect (answers true))
