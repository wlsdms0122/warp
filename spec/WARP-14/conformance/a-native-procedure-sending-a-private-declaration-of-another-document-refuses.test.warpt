(test 1)
(name "a-native-procedure-sending-a-private-declaration-of-another-document-refuses")
(note "A `private` declaration is named from its own document alone, and a native procedure whose declared sends reach one of another document refuses at the build. `App.tell` declares a send to `K.hidden`, which a document beside the program declares `private`.")

(documents
  (document
    (warp 1)
    (procedure K.hidden
      (access private)
      (returns Int)
      (body
        (return 1)))))

(vocabulary
  (import K.hidden)
  (procedure App.tell
    (returns Int)
    (answers 1)
    (sends K.hidden)))

(program
  (warp 1)
  (import App.tell)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.tell)))))
(expect (refuses build))
