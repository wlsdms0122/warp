(test 1)
(name "a-const-native-procedure-sending-one-not-declared-const-refuses")
(note "A native procedure's sends are held to the rest of what it said. `App.seat` declares itself const and isolated and declares a send to `App.clock`, which is isolated and does not declare itself const, so the build refuses `App.seat`.")

(vocabulary
  (procedure App.clock
    (isolated)
    (returns Int)
    (answers 7))
  (procedure App.seat
    (const)
    (isolated)
    (returns Int)
    (answers 7)
    (sends App.clock)))

(program
  (warp 1)
  (import App.seat)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.seat)))))
(expect (refuses build))
