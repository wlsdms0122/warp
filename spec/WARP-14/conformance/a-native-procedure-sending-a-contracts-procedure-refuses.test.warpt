(test 1)
(name "a-native-procedure-sending-a-contracts-procedure-refuses")
(note "A send names the declaration it reaches, and which declaration satisfies a contract's procedure is a call's to say, by the type that fills `Self`. `App.tell` declares a send to `App.Named.name`, a contract's procedure, so the build refuses it.")

(vocabulary
  (contract App.Named
    (procedure name
      (parameter of (type Self))
      (returns String)))
  (procedure App.tell
    (returns String)
    (answers "thing")
    (sends App.Named.name)))

(program
  (warp 1)
  (import App.tell)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call App.tell)))))
(expect (refuses build))
