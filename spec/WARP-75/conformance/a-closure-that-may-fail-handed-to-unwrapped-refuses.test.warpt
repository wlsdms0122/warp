(test 1)
(name "a-closure-that-may-fail-handed-to-unwrapped-refuses")
(note "Standard.Optional.unwrapped takes an else that fails with nothing, and the closure handed says it may fail with aborted, so the call refuses at the build where it is handed. An else that may fail is handed to tryUnwrapped.")

(program
  (warp 1)
  (import Standard.Control.abort)
  (import Standard.Optional.unwrapped)
  (procedure entry
    (access public)
    (returns Int)
    (failing (anything))
    (body
      (let none (type (optional Int)) null)
      (return
        (call Standard.Optional.unwrapped none
          (closure
            (const)
            (isolated)
            (returns Int)
            (failing aborted)
            (body
              (call Standard.Control.abort "none"))))))))
(expect (refuses build))
