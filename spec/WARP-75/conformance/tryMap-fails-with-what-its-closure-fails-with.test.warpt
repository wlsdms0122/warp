(test 1)
(name "tryMap-fails-with-what-its-closure-fails-with")
(note "`Standard.Collection.tryMap` takes a procedure that may fail and touches nothing, so it may fail with anything and is `isolated`: an isolated body hands it a closure that aborts on the third element, and the catch reads the failure.")

(program
  (warp 1)
  (import Standard.Collection.tryMap)
  (import Standard.Comparable.lessThan)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns (optional String))
    (body
      (var failed)
      (let caught
        (try
          (body
            (call Standard.Collection.tryMap
              (array 1 2 3)
              (closure
                (const)
                (isolated)
                (parameter x (type Int))
                (returns Int)
                (failing aborted)
                (body
                  (conditional
                    (when (call Standard.Comparable.lessThan 2 x))
                    (then
                      (call Standard.Control.abort "too big")))
                  (return x)))))
          (catch
            (set failed (path caught (field type))))))
      (return failed))))
(expect (answers "aborted"))
