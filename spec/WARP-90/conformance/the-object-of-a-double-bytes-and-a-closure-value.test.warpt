(test 1)
(name "the-object-of-a-double-bytes-and-a-closure-value")
(note "A double and bytes stand in `valueTable` as tags 3 and 5 carrying the value. A module variable starting at a closure literal writes its start as value tag 8: the identity of the document that wrote it, the declaration `[1, \"f\"]`, its number among that declaration's closures, and what it captured and what fills its type parameters, here nothing.")

(program
  (warp 1)
  (var f
    (type (procedure (parameters) (returns Int)))
    (closure
      (returns Int)
      (body
        (return 1))))
  (procedure entry
    (access public)
    (returns (array Any))
    (failing (anything))
    (body
      (return (array 1.5 x"6869" (apply f))))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"2583e3c71b67c559dc49dce3e13e325864dee9e8e255335499b1b183117067d9")) (entry "importedClaims" (array)) (entry "lifted" (array (array (array (array) 2 (array 1 (array)) 0 0 (array) (array)) 0 (array 0 (array (array (array) 7)) (array 0 (array) (array) (array) (array) (array)))))) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array (array (array 1 "f") 1)))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 0 1) (array 1 0) (array 5 2 (array)) (array 2 (array 0 1 3)) (array 13 0 (array 4)) (array 0 2) (array 13 0 (array 6)))) (entry "rows" (array (array "entry" (array (array) 1 (array 0) 0 0 (array) (array)) 2 (array 0 (array (array (array) 5)) (array 1 (array) (array (array 0 0)) (array) (array) (array "f")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 0) (array 7 0) (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 3 1.5) (array 5 x"6869") (array 2 1) (array 8 x"2583e3c71b67c559dc49dce3e13e325864dee9e8e255335499b1b183117067d9" (array 1 "f") 0 (array) (array)))) (entry "variables" (array (array "f" 3))))))
