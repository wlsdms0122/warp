(test 1)
(name "the-object-of-a-closure-value-holding-what-it-captured-and-what-fills-its-type-parameter")
(note "A constant folded to a closure that captured writes it as value tag 8, its captures as `[slot, value]` in slot order and the *type* that fills each type parameter of the declaration that wrote it, here what `App.make` captured, `b` and `a`, and `T` filled by `String`.")

(documents
  (document
    (warp 1)
    (procedure App.make
      (access public)
      (const)
      (isolated)
      (parameter a (type (some T)))
      (parameter b (type Int))
      (returns (procedure (const) (isolated) (parameters) (returns (array Any))))
      (body
        (return
          (closure
            (const)
            (isolated)
            (returns (array Any))
            (body
              (return (array b a)))))))))

(program
  (warp 1)
  (import App.make)
  (const f (call App.make "x" 2))
  (procedure entry
    (access public)
    (returns (array Any))
    (failing (anything))
    (body
      (return (apply f)))))
(expect (builds (dictionary (entry "addressTable" (array)) (entry "claims" (array)) (entry "constants" (array "f")) (entry "contracts" (array)) (entry "dependencies" (array x"fe8967d126cc8f473d30d1a264a15e13854b0a55cd6c0ff1cd9101bdd8076e48")) (entry "document" (array x"5bc2ee09f3f20af5450f101f5f27cd60fb71b041154a8ca3f4233d8950ecd22e")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array "App.make") (array))) (entry "object" 1) (entry "operationTable" (array (array 0 2) (array 5 0 (array)) (array 13 0 (array 1)))) (entry "rows" (array (array "entry" (array (array) 1 (array 0) 0 0 (array) (array)) 2 (array 0 (array (array (array) 2)) (array 0 (array) (array) (array) (array) (array)))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 0) (array 7 0) (array 6))) (entry "types" (array)) (entry "valueTable" (array (array 2 2) (array 4 "x") (array 8 x"cef93aaf55d2c02f65c73d0cab6a8621138a82f3419d29afe6c25be8e9738ada" (array 0 "App.make") 0 (array (array 0 0) (array 1 1)) (array (array "T" 2))))) (entry "variables" (array)))))
