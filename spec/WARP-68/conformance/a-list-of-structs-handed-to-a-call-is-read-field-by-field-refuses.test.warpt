(test 1)
(name "a-list-of-structs-handed-to-a-call-is-read-field-by-field-refuses")
(note "`App.g` takes a list of structs whose field `a` is an int and is handed two structs, one whose `a` is a string. Each struct is held to the struct type by the fields it names, so the string refuses at the build.")

(program
  (warp 1)
  (struct App.A
    (field a Int))
  (procedure App.g
    (parameter ps (type (array App.A)))
    (returns Int)
    (body
      (return 0)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let i 1)
      (let t "s")
      (let r (call App.g (array (struct (field a i)) (struct (field a t)))))
      (return r))))
(expect (refuses build))
