(test 1)
(name "a-variable-a-generic-loop-declines-with-where-a-break-meets-it-at-its-optional-refuses")
(note "`y` reads `some T` where the condition declines the loop and `Null` where the round that wrote `null` breaks, so past the loop it reads `some T?`. A value of `some T` may be a none, which would have to become its some to stand there, so the build refuses.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (some T)))
    (parameter c (type Bool))
    (returns (optional (some T)))
    (body
      (var y x)
      (loop
        (while c)
        (body
          (set y null)
          (break)))
      (return y)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
