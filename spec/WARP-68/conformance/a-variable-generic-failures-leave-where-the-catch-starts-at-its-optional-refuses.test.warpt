(test 1)
(name "a-variable-generic-failures-leave-where-the-catch-starts-at-its-optional-refuses")
(note "`y` reads `Null` where the first cast fails and `some T` where the second does, so the catch starts with it reading `some T?`. A value of `some T` may be a none, which would have to become its some to stand there, so the build refuses.")

(program
  (warp 1)
  (procedure App.f
    (parameter x (type (some T)))
    (parameter v)
    (returns (optional (some T)))
    (body
      (var y)
      (try
        (body
          (let first (as v Int))
          (set y x)
          (let second (as v Int)))
        (catch
          (return y)))
      (return y)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
