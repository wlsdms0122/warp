(test 1)
(name "a-closure-from-a-generic-body-is-the-procedure-type-its-maker-filled")
(note "`App.mk` returns a closure taking its own `some T`, and the call of it with 5 fills `T` with `Int`. The closure holds that, so held as `Any` it is a value of `(Int) -> Int`, the cast to that type takes it, and applying it to 4 answers 4.")

(program
  (warp 1)
  (procedure App.mk
    (parameter x (type (some T)))
    (returns (procedure (parameters (some T)) (returns (some T))))
    (body
      (return
        (closure
          (parameter y (type (some T)))
          (returns (some T))
          (body
            (return y))))))
  (procedure entry
    (access public)
    (returns Int)
    (failing cast_refused)
    (body
      (let a (type Any) (call App.mk 5))
      (let f (as a (procedure (parameters Int) (returns Int))))
      (return (apply f 4)))))
(expect (answers 4))
