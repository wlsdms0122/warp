(test 1)
(name "a-parameter-handed-in-place-holding-dictionaries-of-lists-of-a-parameter-takes-dictionaries-of-an-empty-list-and-of-it")
(note "App.g writes a list of two dictionary literals into xs, a list of dictionaries of lists of T handed in place, one holding `[]` under `k` and one holding `[x]` there, where x is its own some T. The two dictionaries are taken entry by entry, and the empty list beside the list of x holds no element, so the literal is a value of Array<Dictionary<String, Array<some T>>>.")

(program
  (warp 1)
  (procedure App.g
    (parameter xs (type (inout (array (dictionary String (array (some T)))))))
    (parameter x (type (some T)))
    (returns Int)
    (body
      (set xs (array (dictionary (entry "k" (array))) (dictionary (entry "k" (array x)))))
      (return 0)))
  (procedure entry
    (access public)
    (returns (array (dictionary String (array String))))
    (body
      (var s (type (array (dictionary String (array String)))) (array (dictionary (entry "k" (array "a")))))
      (call App.g s "b")
      (return s))))
(expect (answers (array (dictionary (entry "k" (array))) (dictionary (entry "k" (array "b"))))))
