(test 1)
(name "a-generic-return-value-of-any-refuses")
(note "App.gen returns some T, and its body returns a variable declared Any. A body does not know what filled its parameter, so a reading of Any is no value of it, and the return value refuses at the build.")

(program
  (warp 1)
  (import Standard.Text.uppercased)
  (procedure App.gen
    (parameter x (type (some T)))
    (returns (some T))
    (body
      (var y (type Any) 5)
      (return y)))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let r (call App.gen "s"))
      (let u (call Standard.Text.uppercased r))
      (return u))))
(expect (refuses build))
