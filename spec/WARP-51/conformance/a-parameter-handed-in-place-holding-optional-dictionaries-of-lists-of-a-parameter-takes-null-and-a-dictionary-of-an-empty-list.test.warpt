(test 1)
(name "a-parameter-handed-in-place-holding-optional-dictionaries-of-lists-of-a-parameter-takes-null-and-a-dictionary-of-an-empty-list")
(note "App.g writes a list of null and a dictionary literal holding `[]` under `k` into xs, a list of Optionals of dictionaries of lists of T, handed in place. Null beside the dictionary is its Optional, and the empty list in the dictionary holds no element, so the literal is a value of Array<Dictionary<String, Array<some T>>?>.")

(program
  (warp 1)
  (procedure App.g
    (parameter xs (type (inout (array (optional (dictionary String (array (some T))))))))
    (returns Int)
    (body
      (set xs (array null (dictionary (entry "k" (array)))))
      (return 0)))
  (procedure entry
    (access public)
    (returns (array (optional (dictionary String (array String)))))
    (body
      (var s (type (array (optional (dictionary String (array String))))) (array (dictionary (entry "k" (array "a")))))
      (call App.g s)
      (return s))))
(expect (answers (array null (dictionary (entry "k" (array))))))
