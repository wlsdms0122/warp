(test 1)
(name "a-list-literal-of-names-holding-lists-handed-at-a-bounded-parameter-refuses")
(note "`App.f` bounds `T` by `App.M`, which `Int` and `String` conform to, and takes `Array<Array<some T>>`. The literal `[xs, ys]` handed there holds two names, each a list of booleans. What each name reads as stands at the parameter by its elements, so `T` reads `Bool`, which does not conform to `App.M`, and the call refuses at the build.")

(program
  (warp 1)
  (contract App.M)
  (extension
    (head Int)
    (satisfies App.M))
  (extension
    (head String)
    (satisfies App.M))
  (procedure App.f
    (parameter gs (type (array (array (some T App.M)))))
    (returns Int)
    (body
      (return 0)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let xs (type (array Bool)) (array true))
      (let ys (type (array Bool)) (array false))
      (let r (call App.f (array xs ys)))
      (return r))))
(expect (refuses build))
