(test 1)
(name "a-call-filling-a-parameter-from-a-variable-held-in-place-takes-a-value-of-that-parameter")
(note "App.gen takes a list of its own some T in place and a some T, and appends the one to the other through Standard.Collection.append. Both are T, so the call takes them, and the list is returned with the value added.")

(program
  (warp 1)
  (import Standard.Collection.append)
  (contract App.Real)
  (extension
    (head Double)
    (satisfies App.Real))
  (procedure App.gen
    (parameter xs (type (inout (array (some T App.Real)))))
    (parameter y (type (some T)))
    (returns Int)
    (body
      (call Standard.Collection.append xs y)
      (return 0)))
  (procedure entry
    (access public)
    (returns (array Double))
    (body
      (var ns (array 1.5))
      (let r (call App.gen ns 2.5))
      (return ns))))
(expect (answers (array 1.5 2.5)))
