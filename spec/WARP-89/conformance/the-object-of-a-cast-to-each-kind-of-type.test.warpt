(test 1)
(name "the-object-of-a-cast-to-each-kind-of-type")
(note "A cast writes its type as a lowered type: `Bool`, `Double` and `Null` as tags 3, 5 and 2, an array as 7, a dictionary as 8, an Optional as 13, and a procedure type as 10 whose parameter handed in place is `inout`, 12.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter p)
    (returns (array Any))
    (body
      (let a (as? p Bool))
      (let b (as? p Double))
      (let c (as? p Null))
      (let d (as? p (array Int)))
      (let e (as? p (dictionary String Int)))
      (let g (as? p (optional Int)))
      (let h (as? p (procedure (parameters (inout Int)) (returns Int))))
      (return (array a b c d e g h)))))
