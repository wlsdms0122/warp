(test 1)
(name "count-of-a-number-refuses")
(note "count takes what conforms to Standard.Collection: a string, a list, a dictionary. No such claim holds for a number, so a call handing one refuses at the build, where the call is judged against the declaration.")

(program
  (warp 1)
  (import Standard.Collection.count)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call Standard.Collection.count 1)))))
(expect (refuses build))
