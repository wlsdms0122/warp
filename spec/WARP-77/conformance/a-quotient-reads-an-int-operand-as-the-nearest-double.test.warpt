(test 1)
(name "a-quotient-reads-an-int-operand-as-the-nearest-double")
(note "The quotient is binary64's own: an `Int` operand reads as the `Double` nearest it first. 9007199254740993 reads as 9007199254740992.0, and the division rounds once more. Two implementations must spell the same quotient bit for bit.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.dividedBy 9007199254740993 3)))))
(expect (answers 3002399751580330.5))
