(test 1)
(name "arithmetic-divides-to-a-double")
(note "Division returns a `Double`. An integer divided by an integer may return something that is not an integer, so the return type does not depend on the operands.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.dividedBy 7 2)))))
(expect (answers 3.5))
