(test 1)
(name "arithmetic-divide-by-zero-refuses")
(note "Division by zero refuses at the run. Both operands read as Double, and in binary64 1.0 divided by 0.0 is infinity, a value no document carries, so returning it would put something in a program no later check could talk about.")

(program
  (warp 1)
  (import Standard.Numeric.dividedBy)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.dividedBy 1 0)))))
(expect (refuses run))
