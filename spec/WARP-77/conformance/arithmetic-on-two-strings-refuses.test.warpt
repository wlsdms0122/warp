(test 1)
(name "arithmetic-on-two-strings-refuses")
(note "plus declares one parameter for both sides, so two strings agree, and agreement is not conforming. Int and Double conform to Numeric, and String is a reading the build can refuse.")

(program
  (warp 1)
  (import Standard.Numeric.plus)
  (procedure entry
    (access public)
    (returns String)
    (body
      (return (call Standard.Numeric.plus "a" "b")))))
(expect (refuses build))
