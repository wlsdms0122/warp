(test 1)
(name "a-double-remainder-by-zero-refuses")
(note "remainder refuses a zero divisor at the run for Double as for Int: 5.5 remainder 0.0.")

(program
  (warp 1)
  (import Standard.Numeric.remainder)
  (procedure entry
    (access public)
    (returns Double)
    (body
      (return (call Standard.Numeric.remainder 5.5 0.0)))))
(expect (refuses run))
