(test 1)
(name "minus-and-times-compose-as-written")
(note "minus and times return the type they were given, and compose the way the program wrote them.")

(program
  (warp 1)
  (import Standard.Numeric.minus)
  (import Standard.Numeric.times)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let difference (call Standard.Numeric.minus 10 4))
      (return (call Standard.Numeric.times difference 3)))))
(expect (answers 18))
