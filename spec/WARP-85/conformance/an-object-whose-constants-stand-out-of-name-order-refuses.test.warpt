(test 1)
(name "an-object-whose-constants-stand-out-of-name-order-refuses")
(note "The constants an object declares stand by spelling in name order, none twice. An object listing `step` before `alpha` is refused where it is read.")
(object (dictionary (entry "addressTable" (array (array 0 (array) false) (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array "step" "alpha")) (entry "contracts" (array)) (entry "dependencies" (array)) (entry "document" (array x"1a593a85b70164500ba8ac74978e47eabbf423444b4f706c2268a90cb969ccd7")) (entry "importedClaims" (array)) (entry "lifted" (array)) (entry "loweredTypeTable" (array)) (entry "members" (array)) (entry "numbering" (array (array) (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 1 1) (array 13 0 (array 1)))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array)) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 2 0)) 0) (array (array) 2)) (array 1 (array) (array (array 0 0)) (array) (array) (array "total")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array)) (entry "typeTable" (array (array 4))) (entry "types" (array)) (entry "valueTable" (array (array 2 1) (array 2 0))) (entry "variables" (array (array "total" 1)))))
(expect (refuses load))
