(test 1)
(name "the-object-of-an-imported-claim")
(note "An object lists the claims its document imports, by the type and the contract, so what it stands on is read off the object.")

(documents
  (document
    (warp 1)
    (contract App.Describable
      (procedure describe
        (parameter of (type Self))
        (returns String))))
  (document
    (warp 1)
    (struct T.Card
      (field rank Int)
      (procedure describe
        (const)
        (isolated)
        (parameter of (type T.Card))
        (returns String)
        (body
          (return "card")))))
  (document
    (warp 1)
    (import App.Describable)
    (import T.Card)
    (extension
      (head T.Card)
      (satisfies App.Describable))))

(program
  (warp 1)
  (import App.Describable.describe)
  (import T.Card)
  (import T.Card App.Describable)
  (procedure entry
    (access public)
    (returns String)
    (failing cast_refused)
    (body
      (let card (as (struct (field rank 1)) T.Card))
      (return (call App.Describable.describe card)))))
(expect (builds (dictionary (entry "addressTable" (array (array 0 (array) false))) (entry "claims" (array)) (entry "constants" (array)) (entry "contracts" (array)) (entry "dependencies" (array x"6f6fbb11ee3c3720ace4cb324d1c77d124baec84f280405ae75a899662ec87e3" x"757a2b507657376cbcf08ea4aeaa838514e2a0e5505a4493e7e9c3ce9310f215" x"c5b9cefd6deb6a82a2bcb6de9536ee1752e13061200244384afe3476b67e8b50")) (entry "document" (array x"fcf641a231940fe6447dcaf639f47d478c24a8003135b9696ea8eaaeb47c473e")) (entry "importedClaims" (array (array "T.Card" "App.Describable"))) (entry "lifted" (array)) (entry "loweredTypeTable" (array (array 14 0) (array 14 0))) (entry "members" (array)) (entry "numbering" (array (array "App.Describable.describe") (array))) (entry "object" 1) (entry "operationTable" (array (array 0 0) (array 3 (array (array "T.Card" (array "rank")) (array 0))) (array 6 1 0 false) (array 12 (array "App.Describable" "describe" (array 1) (array 1 0) (array))) (array 13 0 (array 3)))) (entry "rows" (array (array "entry" (array (array) 0 (array 1 (array "cast_refused")) 0 0 (array) (array)) 2 (array 0 (array (array (array (array 0 0)) 2) (array (array) 4)) (array 1 (array) (array) (array) (array) (array "card")))))) (entry "typeMembers" (array)) (entry "typeNumbering" (array "T.Card")) (entry "typeTable" (array (array 6))) (entry "types" (array)) (entry "valueTable" (array (array 2 1))) (entry "variables" (array)))))
