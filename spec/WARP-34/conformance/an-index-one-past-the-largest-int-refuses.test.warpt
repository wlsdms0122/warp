(test 1)
(name "an-index-one-past-the-largest-int-refuses")
(note "Between the brackets an integer is one an `Int` holds, and 9223372036854775808 is one past the largest, so the path refuses at the load.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "d") (entry "type" "Dictionary<Int, String>") (entry "value" (dictionary (entry "dictionary" (array (array 1 "a")))))) (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "ref" "d[9223372036854775808]")))))))) (entry "returns" "String"))))) (entry "warp" 1)))
(expect (refuses load))
