(test 1)
(name "indexing-an-optional-without-the-optional-bracket-refuses")
(note "An Optional holds its none or a some of the declared array, and a plain index reads an array that is there. Indexing through an Optional takes `?[`. The build refuses the spelling that pretends otherwise.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (parameter items (type (optional (array String))))
    (returns Any)
    (body
      (return (path items (index 0))))))
(expect (refuses build))
