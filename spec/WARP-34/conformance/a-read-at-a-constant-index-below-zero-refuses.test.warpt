(test 1)
(name "a-read-at-a-constant-index-below-zero-refuses")
(note "`K` folds to -1, an integer below zero, which is no position in any list, so `d[K]` refuses at the build.")

(program
  (warp 1)
  (const K -1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (var d (type (array Int)) (array 1))
      (return (path d (index K))))))
(expect (refuses build))
