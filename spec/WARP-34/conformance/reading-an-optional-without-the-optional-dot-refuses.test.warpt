(test 1)
(name "reading-an-optional-without-the-optional-dot-refuses")
(note "An Optional holds its none or a some of the declared value, and a plain dot reads a value that is there. Reading through an Optional takes `?.`. The build refuses the spelling that pretends otherwise.")

(program
  (warp 1)
  (struct Task
    (field name String))
  (procedure entry
    (access public)
    (parameter task (type (optional Task)))
    (returns Any)
    (body
      (return (path task (field name))))))
(expect (refuses build))
