(test 1)
(name "an-optional-only-the-optional-of-conforms-at-an-optional-of-the-contract-is-its-some")
(note "Only the claim about every Optional says a type conforms to `App.Described`, so `Int` does not and `Int?` does. An `Int?` handed where `App.Described?` is declared is a value of the contract, the Optional's some, and reaches the Optional's row.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (optional (some W)))
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (optional (some W))))
      (returns String)
      (body
        (return "an optional"))))
  (procedure App.show
    (parameter p (type (optional App.Described)))
    (returns String)
    (body
      (let x
        (unwrap p
          (then
            (return (call App.Described.describe x)))))
      (return "none")))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let five (type (optional Int)) 5)
      (return (call App.show five)))))
(expect (answers "an optional"))
