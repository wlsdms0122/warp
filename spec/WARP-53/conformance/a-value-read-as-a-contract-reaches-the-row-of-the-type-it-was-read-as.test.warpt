(test 1)
(name "a-value-read-as-a-contract-reaches-the-row-of-the-type-it-was-read-as")
(note "`b` is read as `App.Box<Int?>` and written into a name read as `App.Maker`, so the value is held beside that type, though the box it holds, holding 5, is an instance of `App.Box<Int>`. The call through the contract picks `App.Box.make` by the type held and fills its `T` with `Int?`, so the closure it makes is a value of `(Int?) -> Int?`, the cast to that type takes it, and applying it to 7 answers 7.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (satisfies App.Maker)
    (field item (some T))
    (procedure make
      (parameter of (type (named App.Box (some T))))
      (returns Any)
      (body
        (return
          (closure
            (parameter y (type (some T)))
            (returns (some T))
            (body
              (return y)))))))
  (contract App.Maker
    (procedure make
      (parameter of (type Self))
      (returns Any)))
  (procedure entry
    (access public)
    (returns (optional Int))
    (failing cast_refused)
    (body
      (let b (type (named App.Box (optional Int))) (struct (field item 5)))
      (let p (type App.Maker) b)
      (let g (as (call App.Maker.make p) (procedure (parameters (optional Int)) (returns (optional Int)))))
      (return (apply g 7)))))
(expect (answers 7))
