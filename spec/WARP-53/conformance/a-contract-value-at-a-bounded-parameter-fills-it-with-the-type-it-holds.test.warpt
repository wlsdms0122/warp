(test 1)
(name "a-contract-value-at-a-bounded-parameter-fills-it-with-the-type-it-holds")
(note "`p` is read as `App.Maker` and holds `App.Box<Int?>`. Handed to `App.via` where `some T: App.Maker` stands alone, it fills `T` with the type it holds, so the call through the contract inside the body picks `App.Box.make` with its `T` as `Int?`, the cast to `(Int?) -> Int?` takes the closure, and applying it to 7 answers 7.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (satisfies App.Maker)
    (field item (some T))
    (procedure make
      (parameter of (type (named App.Box (some T))))
      (returns Any)
      (body
        (return
          (closure
            (parameter y (type (some T)))
            (returns (some T))
            (body
              (return y)))))))
  (contract App.Maker
    (procedure make
      (parameter of (type Self))
      (returns Any)))
  (procedure App.via
    (parameter x (type (some T App.Maker)))
    (returns Any)
    (body
      (return (call App.Maker.make x))))
  (procedure entry
    (access public)
    (returns (optional Int))
    (failing cast_refused)
    (body
      (let b (type (named App.Box (optional Int))) (struct (field item 5)))
      (let p (type App.Maker) b)
      (let g (as (call App.via p) (procedure (parameters (optional Int)) (returns (optional Int)))))
      (return (apply g 7)))))
(expect (answers 7))
