(test 1)
(name "a-type-parameter-named-self-refuses")
(note "`Self` is the type conforming to a contract, read as such in that contract's procedures, so no type parameter takes its name. `some Self` is refused where the document is read.")

(program
  (warp 1)
  (contract App.Ordered
    (procedure before
      (parameter lhs (type Self))
      (parameter rhs (type Self))
      (returns Bool)))
  (procedure entry
    (access public)
    (parameter x (type (some Self)))
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
