(test 1)
(name "a-box-of-an-optional-fills-a-bounded-parameter-inside-it")
(note "A box of `Int?` handed where `App.Box<some T: Hashable>` is declared fills `T` with `Int?`, one type, which conforms to `Hashable` by the language's claim about every Optional of what does, so the call builds and answers the null the box holds.")

(documents
  (document
    (warp 1)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (procedure App.get
      (access public)
      (parameter b (type (named App.Box (some T Hashable))))
      (returns (some T))
      (body
        (return (path b (field item)))))))

(program
  (warp 1)
  (import App.Box)
  (import App.get)
  (procedure entry
    (access public)
    (returns (optional Int))
    (body
      (let b (type (named App.Box (optional Int))) (struct (field item null)))
      (return (call App.get b)))))
(expect (answers null))
