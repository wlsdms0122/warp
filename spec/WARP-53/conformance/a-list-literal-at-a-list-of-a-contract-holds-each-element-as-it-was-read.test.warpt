(test 1)
(name "a-list-literal-at-a-list-of-a-contract-holds-each-element-as-it-was-read")
(note "The list literal is written where a list of `App.Maker` is declared, so its element is held beside what it was read as, `App.Box<Int?>`. The call through the contract on the element picks `App.Box.make` by that type and fills `T` with `Int?`, the cast to `(Int?) -> Int?` takes the closure, and applying it to 7 answers 7.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (satisfies App.Maker)
    (field item (some T))
    (procedure make
      (parameter of (type (named App.Box (some T))))
      (returns Any)
      (body
        (return
          (closure
            (parameter y (type (some T)))
            (returns (some T))
            (body
              (return y)))))))
  (contract App.Maker
    (procedure make
      (parameter of (type Self))
      (returns Any)))
  (procedure entry
    (access public)
    (returns (optional Int))
    (failing cast_refused)
    (body
      (let b (type (named App.Box (optional Int))) (struct (field item 5)))
      (let xs (type (array App.Maker)) (array b))
      (let g (as (call App.Maker.make (path xs (index 0))) (procedure (parameters (optional Int)) (returns (optional Int)))))
      (return (apply g 7)))))
(expect (answers 7))
