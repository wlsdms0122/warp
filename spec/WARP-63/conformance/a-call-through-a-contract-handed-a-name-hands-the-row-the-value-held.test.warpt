(test 1)
(name "a-call-through-a-contract-handed-a-name-hands-the-row-the-value-held")
(note "`p` is read as `App.Described` from an `Int?` none and handed by its name to a call through the contract. The row of `Int?` is picked by the type `p` holds and is handed the none `p` holds, so its unwrap takes the none's way.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (optional (some W)))
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (optional (some W))))
      (returns String)
      (body
        (let x
          (unwrap of
            (then
              (return "some"))))
        (return "none"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let nothing (type (optional Int)) null)
      (let p (type App.Described) nothing)
      (return (call App.Described.describe p)))))
(expect (answers "none"))
