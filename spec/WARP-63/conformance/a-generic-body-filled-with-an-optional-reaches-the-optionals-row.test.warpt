(test 1)
(name "a-generic-body-filled-with-an-optional-reaches-the-optionals-row")
(note "`App.tell` calls `App.Described.describe` on its `some T`. Handed a reading of `Int?`, the call fills `T` with `Int?`, so the call through the contract inside it reaches the row of the claim about every Optional, `some W?`, though the value it holds is `5`.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a number"))))
  (extension
    (head (optional (some W)))
    (satisfies App.Described)
    (procedure describe
      (parameter of (type (optional (some W))))
      (returns String)
      (body
        (return "an optional"))))
  (procedure App.tell
    (parameter it (type (some T App.Described)))
    (returns String)
    (body
      (return (call App.Described.describe it))))
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (let maybe (type (optional Int)) 5)
      (let first (call App.tell maybe))
      (let second (call App.tell 5))
      (return (array first second)))))
(expect (answers (array "an optional" "a number")))
