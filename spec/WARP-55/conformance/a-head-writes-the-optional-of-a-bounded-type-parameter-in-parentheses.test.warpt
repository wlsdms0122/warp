(test 1)
(name "a-head-writes-the-optional-of-a-bounded-type-parameter-in-parentheses")
(note "A bound runs to the end of a type's spelling, so the Optional of `some W: App.Described` is written `(some W: App.Described)?`, the parentheses grouping the type parameter and its bound. The head reads every Optional of what conforms to `App.Described`, and `Int` does, so a reading of `Int?` reaches `Optional.label`.")

(program
  (warp 1)
  (contract App.Described
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (optional (some W App.Described)))
    (procedure label
      (parameter it (type (optional (some W))))
      (returns String)
      (body
        (return "an optional"))))
  (extension
    (head Int)
    (satisfies App.Described)
    (procedure describe
      (parameter of (type Int))
      (returns String)
      (body
        (return "a number"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let maybe (type (optional Int)) 5)
      (return (call Optional.label maybe)))))
(expect (answers "an optional"))
