(test 1)
(name "a-value-outside-a-head-bounding-its-parameter-refuses")
(note "A box of App.Plain is no box of something that conforms to `Hashable`, so `App.Box<some T: Hashable>` does not take it and the call handing it where App.Describable is asked refuses at the build.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (struct App.Plain
    (field x Int))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some T Hashable)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box App.Plain)) (struct (field item (struct (field x 1)))))
      (return (call App.Describable.describe b)))))
(expect (refuses build))
