(test 1)
(name "a-box-of-null-from-outside-is-taken-by-a-hashable-head")
(note "A box holding null arrives where `some C: Lib.Container` is declared. What it reads as is a box of `Null`, which conforms to Hashable, so the head takes it.")

(documents
  (document
    (warp 1)
    (contract Lib.Container
      (type Item)
      (procedure first
        (parameter of (type Self))
        (returns Self.Item)))
    (procedure Lib.firstOf
      (access public)
      (parameter c (type (some C Lib.Container)))
      (returns (some C.Item))
      (body
        (return (call Lib.Container.first c)))))
  (document
    (warp 1)
    (import Lib.Container)
    (struct App.Box
      (typeParameter T)
      (field item (some T)))
    (struct App.Plain
      (field x Int))
    (extension
      (head (named App.Box (some T Hashable)))
      (satisfies Lib.Container)
      (type Item (some T))
      (procedure first
        (access public)
        (parameter of (type (named App.Box (some T))))
        (returns (some T))
        (body
          (return (path of (field item))))))))

(program
  (warp 1)
  (import Lib.Container)
  (import Lib.Container.first)
  (procedure entry
    (access public)
    (parameter c (type (some C Lib.Container)))
    (returns (some C.Item))
    (body
      (return (call Lib.Container.first c)))))
(arguments (argument c (struct App.Box (field item null))))
(expect (answers null))
