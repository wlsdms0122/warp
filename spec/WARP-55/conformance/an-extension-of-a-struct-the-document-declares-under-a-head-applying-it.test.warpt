(test 1)
(name "an-extension-of-a-struct-the-document-declares-under-a-head-applying-it")
(note "A struct's declaration gives what every value of it has, and what holds for some of its values is written in an extension under a head applying it, in the document that declares it too.")

(program
  (warp 1)
  (struct App.Box
    (typeParameter T)
    (field item (some T)))
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head (named App.Box (some T Hashable)))
    (satisfies App.Describable)
    (procedure describe
      (parameter of (type (named App.Box (some T))))
      (returns String)
      (body
        (return "box"))))
  (procedure entry
    (access public)
    (returns String)
    (body
      (let b (type (named App.Box String)) (struct (field item "a")))
      (return (call App.Describable.describe b)))))
(expect (answers "box"))
