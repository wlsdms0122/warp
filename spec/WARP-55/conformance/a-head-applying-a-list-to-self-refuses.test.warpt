(test 1)
(name "a-head-applying-a-list-to-self-refuses")
(note "Each type an `applied` head holds is written as a head writes it, with no `some T.Item`, `Self` or mark. `Array<Self>` writes `Self` inside the head, so the key has a part the head grammar does not let it have, and the load refuses it.")

(program
  (warp 1)
  (contract App.Marked)
  (extension
    (head (array Self))
    (satisfies App.Marked))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
