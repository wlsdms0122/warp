(test 1)
(name "a-constant-folding-from-a-procedure-only-a-later-document-declares-refuses")
(note "The documents of a link stand in an order where what each one's constants fold from is declared before it. The constant `n` of the first document folds from `Ring.b`, which only the document laid after it declares, so the build refuses.")

(documents
  (document
    (warp 1)
    (import Ring.b)
    (const n (call Ring.b))
    (procedure Ring.a
      (returns Int)
      (body
        (return n))))
  (document
    (warp 1)
    (procedure Ring.b
      (const)
      (returns Int)
      (body
        (return 1)))))

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
