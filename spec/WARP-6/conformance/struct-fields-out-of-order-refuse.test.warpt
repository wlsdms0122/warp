(test 1)
(name "struct-fields-out-of-order-refuse")
(note "Writers are canonical: a struct's fields ascend by their names' UTF-8 bytes. A reader that sorted them instead would give one document two byte spellings, and what a signature was checked against could differ from what the reader went on to read.")
(bytes x"57415250010903412e50020162030201610302")
(expect (refuses load))
