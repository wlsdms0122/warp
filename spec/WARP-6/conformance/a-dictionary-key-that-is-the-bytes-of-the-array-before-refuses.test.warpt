(test 1)
(name "a-dictionary-key-that-is-the-bytes-of-the-array-before-refuses")
(note "An array and the bytes of its numbers are one value and stand at one place in the key order. Written array first, the two ascend by their tags, and only sameness refuses the second.")
(bytes x"574152500107020601030203020801010304")
(expect (refuses load))
