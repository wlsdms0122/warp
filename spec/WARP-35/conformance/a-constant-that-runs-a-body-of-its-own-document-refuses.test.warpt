(test 1)
(name "a-constant-that-runs-a-body-of-its-own-document-refuses")
(note "A constant folds from the language's procedures and from bodies the link has already resolved. A body its own document declares is still being resolved beside the constants it may read, so a constant that runs one is a cycle with no start, and is refused at the build.")

(program
  (warp 1)
  (const seven (call helper))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return seven)))
  (procedure helper
    (const)
    (returns Int)
    (body
      (return 7))))
(expect (refuses build))
