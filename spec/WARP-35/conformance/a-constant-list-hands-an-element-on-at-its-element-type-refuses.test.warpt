(test 1)
(name "a-constant-list-hands-an-element-on-at-its-element-type-refuses")
(note "A list's elements share one element type, the join of every element's, so `k[0]` reads as that type whatever its own closure was. One element does not declare `const`, so the element type is not `const`, and handing `k[0]` where `map` asks a `const` procedure refuses at the build. A struct's fields keep their own types.")

(program
  (warp 1)
  (import Standard.Collection.map)
  (const k
    (array
      (closure
        (const)
        (isolated)
        (parameter x (type Int))
        (returns Int)
        (body
          (return x)))
      (closure
        (isolated)
        (parameter x (type Int))
        (returns Int)
        (body
          (return x)))))
  (procedure entry
    (access public)
    (returns (array Int))
    (failing (anything))
    (body
      (return (call Standard.Collection.map (array 1) (path k (index 0)))))))
(expect (refuses build))
