(test 1)
(name "a-constant-dictionary-read-through-the-optional-bracket-at-a-key-it-does-not-hold-folds-to-the-none")
(note "The path is headed by a constant and its key is written, so it folds at the build. `digits` holds no entry under `\"7\"`, and `?[` expects that absence, so the path folds to the none.")

(program
  (warp 1)
  (const digits (dictionary (entry "0" 0) (entry "1" 1)))
  (procedure entry
    (access public)
    (returns (optional Int))
    (body
      (return (path digits (index? "7"))))))
(expect (answers null))
