(test 1)
(name "a-case-literal-cast-to-its-enum-reaches-any")
(note "A cast is a place, so the literal under `as App.Target` is read as `App.Target` and takes the spelling `App.Target.local`. The cast's value stands at `Any`, where the entry returns it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (returns Any)
    (failing cast_refused)
    (body
      (return (as (case local) App.Target)))))
(expect (answers (struct App.Target.local)))
