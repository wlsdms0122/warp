(test 1)
(name "a-case-field-writing-a-bound-refuses")
(note "An enum bounds its type parameters in `typeParameters`, as a struct does. The field writes `some T: Hashable`, a bound where no name is introduced, so the load refuses it.")

(program
  (warp 1)
  (enum App.Slot
    (typeParameter T)
    (case empty)
    (case full (field item (some T Hashable))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
