(test 1)
(name "a-constant-written-as-a-case-literal-refuses")
(note "A constant declares no type, so its expression is no place that reads an enum. The case literal there has no enum to be, so the build refuses it.")

(program
  (warp 1)
  (const light (case red))
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
