(test 1)
(name "a-case-carrying-nothing-is-handed-to-the-host-as-a-struct-with-no-field")
(note "A case that carries nothing is a struct under its spelling with no field. The entry returns a `local`, so the host receives `App.Target.local` and nothing in it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (returns App.Target)
    (body
      (return (case local)))))
(expect (answers (struct App.Target.local)))
