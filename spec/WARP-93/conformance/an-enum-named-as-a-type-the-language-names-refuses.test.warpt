(test 1)
(name "an-enum-named-as-a-type-the-language-names-refuses")
(note "`Int` is a word the language writes itself, a name it gives its own type, so no document declares a type under it. An enum declared as `Int` refuses at the load.")

(program
  (warp 1)
  (enum Int
    (case one)
    (case zero))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
