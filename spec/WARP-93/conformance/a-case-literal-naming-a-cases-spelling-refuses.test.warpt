(test 1)
(name "a-case-literal-naming-a-cases-spelling-refuses")
(note "Where a value stands a `case` node is a case literal, and its name is one identifier. `(case App.Light.red)` writes the spelling where the name stands, which is no case's name, so the load refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns App.Light)
    (body
      (return (case App.Light.red)))))
(expect (refuses load))
