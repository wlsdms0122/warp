(test 1)
(name "a-struct-declared-under-a-cases-spelling-refuses")
(note "`App.Light.red` is the spelling of the case `red`, a name of the namespace types and contracts share, so no type is declared under it. One document declaring a struct there shows it alone, and the load refuses.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (struct App.Light.red
    (field shade Int))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
