(test 1)
(name "a-case-literal-spells-as-bytes")
(note "The document of `a-case-literal-spells-as-text` in the binary. A case literal is a dictionary of one entry under the key `case`, so the binary carries nothing new for it, and the names the text reads stand here in bytes.")
(bytes x"")
(expect (spells (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "let" "a") (entry "type" "App.Target") (entry "value" (dictionary (entry "case" (dictionary (entry "local" (dictionary))))))) (dictionary (entry "value" (dictionary (entry "return" (dictionary (entry "case" (dictionary (entry "remote" (dictionary (entry "port" 8080)))))))))))) (entry "returns" "App.Target"))))) (entry "types" (dictionary (entry "App.Target" (dictionary (entry "enum" (dictionary (entry "local" (dictionary)) (entry "remote" (dictionary (entry "port" "Int"))))))))) (entry "warp" 1))))
