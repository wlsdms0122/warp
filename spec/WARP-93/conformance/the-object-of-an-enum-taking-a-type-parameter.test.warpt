(test 1)
(name "the-object-of-an-enum-taking-a-type-parameter")
(note "An enum taking a type parameter writes its cases under tag 20 and then its type parameters' names and their bounds, as tag 9 does, and a mention applying it writes the types after its name, tag 14. The case literal's layout is the case's spelling, with nothing of what the enum is applied to.")

(program
  (warp 1)
  (enum App.Maybe
    (typeParameter T)
    (case empty)
    (case full (field value (some T))))
  (procedure App.wrap
    (const)
    (isolated)
    (parameter x (type (some T)))
    (returns (named App.Maybe (some T)))
    (body
      (return (case full (field value x)))))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns (named App.Maybe Int))
    (body
      (return (call App.wrap 3)))))
