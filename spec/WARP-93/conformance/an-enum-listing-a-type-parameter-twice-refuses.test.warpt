(test 1)
(name "an-enum-listing-a-type-parameter-twice-refuses")
(note "An enum lists each of its type parameters once, as a struct does. `App.Slot` lists `T` twice, one name introduced two ways, so the load refuses it.")

(program
  (warp 1)
  (enum App.Slot
    (typeParameter T)
    (typeParameter T)
    (case empty)
    (case full (field item (some T))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
