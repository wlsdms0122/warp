(test 1)
(name "a-case-field-named-beginning-with-a-digit-refuses")
(note "A case's field is named as a struct's field is, by one identifier, and an identifier does not begin with a digit. `2fa` is no identifier, so the load refuses the enum.")

(program
  (warp 1)
  (enum App.Login
    (case code (field `2fa` Int))
    (case password))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
