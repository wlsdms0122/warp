(test 1)
(name "a-case-literal-short-of-a-field-refuses")
(note "A case literal writes exactly the fields its case carries. `remote` carries `host` and `port`, and the literal writes `host` alone, so the build refuses it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (returns App.Target)
    (body
      (return (case remote (field host "a"))))))
(expect (refuses build))
