(test 1)
(name "a-case-literal-naming-a-case-its-enum-does-not-declare-refuses")
(note "The literal is read as `App.Light`, the type the entry returns, and the build judges it there. `App.Light` declares `green` and `red` and no `blue`, so the build refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure entry
    (access public)
    (returns App.Light)
    (body
      (return (case blue)))))
(expect (refuses build))
