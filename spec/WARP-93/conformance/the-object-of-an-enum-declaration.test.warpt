(test 1)
(name "the-object-of-an-enum-declaration")
(note "An enum is written in `types` under tag 20, its cases ascending by name and each case's fields ascending by name, a case carrying nothing as an empty list. A slot of the enum is a declared name, tag 14, as a struct's slot is.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (parameter t (type App.Target))
    (returns Int)
    (body
      (return 1))))
