(test 1)
(name "a-member-spelled-like-a-case-is-a-member")
(note "A procedure stands in the first namespace and a case's spelling in the second, so the member `red` of `App.Light`, spelled `App.Light.red` beside the case `red`, is a member like any other. Called with a `green`, it returns 7.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red)
    (procedure red
      (parameter of (type App.Light))
      (returns Int)
      (body
        (return 7))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.Light.red (case green))))))
(expect (answers 7))
