(test 1)
(name "a-contract-declared-under-a-cases-spelling-refuses")
(note "`App.Light.red` is the spelling of the case `red`, a name of the namespace types and contracts share, so no contract is declared under it. One document declaring a contract there shows it alone, and the load refuses.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (contract App.Light.red
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
