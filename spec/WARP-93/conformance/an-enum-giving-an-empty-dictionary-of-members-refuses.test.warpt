(test 1)
(name "an-enum-giving-an-empty-dictionary-of-members-refuses")
(note "An enum giving itself no member writes no `procedures`, so `procedures: {}` says it a second way, and the load refuses it.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "returns" "Int"))))) (entry "types" (dictionary (entry "App.Light" (dictionary (entry "enum" (dictionary (entry "red" (dictionary)))) (entry "procedures" (dictionary)))))) (entry "warp" 1)))
(expect (refuses load))
