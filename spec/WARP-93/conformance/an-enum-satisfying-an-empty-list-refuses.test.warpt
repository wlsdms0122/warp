(test 1)
(name "an-enum-satisfying-an-empty-list-refuses")
(note "An enum adopting no contract writes no `satisfies`, so `satisfies: []` says it a second way, and the load refuses it.")

(program
  (warp 1)
  (enum App.Light
    (satisfies)
    (case red))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
