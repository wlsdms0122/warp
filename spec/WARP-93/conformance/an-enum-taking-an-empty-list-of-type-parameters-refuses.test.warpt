(test 1)
(name "an-enum-taking-an-empty-list-of-type-parameters-refuses")
(note "An enum taking no type parameter writes no `typeParameters`, so `typeParameters: []` says it a second way, and the load refuses it.")
(tree (dictionary (entry "imports" (array)) (entry "procedures" (dictionary (entry "entry" (dictionary (entry "access" "public") (entry "body" (array (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "returns" "Int"))))) (entry "types" (dictionary (entry "App.Light" (dictionary (entry "enum" (dictionary (entry "red" (dictionary)))) (entry "typeParameters" (array)))))) (entry "warp" 1)))
(expect (refuses load))
