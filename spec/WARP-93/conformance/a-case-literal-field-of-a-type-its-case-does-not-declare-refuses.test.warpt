(test 1)
(name "a-case-literal-field-of-a-type-its-case-does-not-declare-refuses")
(note "Each field of a case literal is held to its type as a struct literal's field is. `port` is declared `Int`, and the literal writes a string there, so the build refuses it.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote (field host String) (field port Int)))
  (procedure entry
    (access public)
    (returns App.Target)
    (body
      (return (case remote (field host "a") (field port "8080"))))))
(expect (refuses build))
