(test 1)
(name "a-value-of-an-enum-spells-as-bytes")
(note "A value of an enum is a struct, tag `0x09`, under its case's spelling, so `remote` of `App.Target` is written under the name `App.Target.remote` and its fields as any struct's. The binary carries nothing new for an enum.")
(bytes x"574152500109114170702e5461726765742e72656d6f74650204686f737405016104706f727403a07e")
(expect (spells (struct App.Target.remote (field host "a") (field port 8080))))
