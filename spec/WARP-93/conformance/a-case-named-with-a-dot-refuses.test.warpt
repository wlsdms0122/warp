(test 1)
(name "a-case-named-with-a-dot-refuses")
(note "A case is named by one identifier, as a member is. `remote.tls` is two identifiers joined by a dot, so the load refuses the enum.")

(program
  (warp 1)
  (enum App.Target
    (case local)
    (case remote.tls))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
