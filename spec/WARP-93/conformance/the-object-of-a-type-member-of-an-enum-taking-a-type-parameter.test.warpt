(test 1)
(name "the-object-of-a-type-member-of-an-enum-taking-a-type-parameter")
(note "`App.Box` takes `T` and gives `App.Container` the type member `Item` as `some T`. `typeMembers` writes `Item` under the bare head `App.Box`, in the enum's own type parameter `T`, as it writes a struct's.")

(program
  (warp 1)
  (enum App.Box
    (typeParameter T)
    (satisfies App.Container)
    (case full (field value (some T)))
    (type Item (some T))
    (procedure first
      (const)
      (isolated)
      (parameter of (type (named App.Box (some T))))
      (returns (some T))
      (body
        (switch of
          (case full
            (bind value v)
            (then
              (return v)))))))
  (contract App.Container
    (type Item)
    (procedure first
      (parameter of (type Self))
      (returns Self.Item)))
  (procedure entry
    (access public)
    (const)
    (isolated)
    (returns Int)
    (body
      (return 1))))
