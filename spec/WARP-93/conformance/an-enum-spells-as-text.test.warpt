(test 1)
(name "an-enum-spells-as-text")
(note "An enum is laid out as a declaration, its parts in the writer's order: type parameters, claims, cases, type members, members. Each case stands on one line with its fields, and reads as one entry of `enum`.")
(text "(warp 1)\n\n(enum App.Target\n  (typeParameter T)\n  (satisfies App.Shown)\n  (case local)\n  (case remote (field port (some T)))\n  (type Item Int)\n  (procedure show\n    (parameter of (type (named App.Target (some T))))\n    (returns Int)\n    (body\n      (return 1))))\n\n(contract App.Shown\n  (type Item)\n  (procedure show\n    (parameter of (type Self))\n    (returns Int)))\n")
(expect (spells (dictionary (entry "contracts" (dictionary (entry "App.Shown" (dictionary (entry "procedures" (dictionary (entry "show" (dictionary (entry "parameters" (array (dictionary (entry "name" "of") (entry "type" "Self")))) (entry "returns" "Int"))))) (entry "types" (array "Item")))))) (entry "imports" (array)) (entry "types" (dictionary (entry "App.Target" (dictionary (entry "enum" (dictionary (entry "local" (dictionary)) (entry "remote" (dictionary (entry "port" "some T"))))) (entry "procedures" (dictionary (entry "show" (dictionary (entry "body" (array (dictionary (entry "value" (dictionary (entry "return" 1)))))) (entry "parameters" (array (dictionary (entry "name" "of") (entry "type" "App.Target<some T>")))) (entry "returns" "Int"))))) (entry "satisfies" (array "App.Shown")) (entry "typeParameters" (array "T")) (entry "types" (dictionary (entry "Item" "Int"))))))) (entry "warp" 1))))
