(test 1)
(name "the-keys-of-a-dictionary-keyed-by-an-enum-stand-in-the-key-order")
(note "A dictionary holds its keys in the key order, and orders structs by name and then field by field. So `ace` comes before both `rank` values, and `rank` carrying 1 before `rank` carrying 2, whatever order the literal writes them in.")

(program
  (warp 1)
  (import Standard.Collection.keys)
  (enum App.Card
    (satisfies Hashable)
    (case ace)
    (case rank (field n Int)))
  (procedure entry
    (access public)
    (returns (array App.Card))
    (body
      (let counts (type (dictionary App.Card Int)) (dictionary (entry (case rank (field n 2)) 1) (entry (case ace) 2) (entry (case rank (field n 1)) 3)))
      (return (call Standard.Collection.keys counts)))))
(expect (answers (array (struct App.Card.ace) (struct App.Card.rank (field n 1)) (struct App.Card.rank (field n 2)))))
