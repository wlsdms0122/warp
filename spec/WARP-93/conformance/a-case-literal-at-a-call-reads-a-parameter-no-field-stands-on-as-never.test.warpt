(test 1)
(name "a-case-literal-at-a-call-reads-a-parameter-no-field-stands-on-as-never")
(note "The literal is handed where `App.Result<some T, some E>` is declared. Its field `error` fills `E` with `String`, and no field stands on `T`, so the literal reads `T` as `Never`, which joins with the `Int` fallback to fill `T` with `Int`.")

(program
  (warp 1)
  (enum App.Result
    (typeParameter T)
    (typeParameter E)
    (case failure (field error (some E)))
    (case success (field value (some T))))
  (procedure App.valueOr
    (parameter result (type (named App.Result (some T) (some E))))
    (parameter fallback (type (some T)))
    (returns (some T))
    (body
      (switch result
        (case failure
          (then
            (return fallback)))
        (case success
          (bind value v)
          (then
            (return v))))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return (call App.valueOr (case failure (field error "x")) 7)))))
(expect (answers 7))
