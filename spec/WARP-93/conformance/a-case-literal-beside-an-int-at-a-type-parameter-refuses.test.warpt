(test 1)
(name "a-case-literal-beside-an-int-at-a-type-parameter-refuses")
(note "`App.second` takes two values of `some T`, and the call hands it `1` and a case literal. `1` fills `T` with `Int`, which is no enum, so the literal is written where no enum is read and the build refuses it.")

(program
  (warp 1)
  (enum App.Light
    (case green)
    (case red))
  (procedure App.second
    (parameter a (type (some T)))
    (parameter b (type (some T)))
    (returns (some T))
    (body
      (return b)))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (let x (call App.second 1 (case red)))
      (return 1))))
(expect (refuses build))
