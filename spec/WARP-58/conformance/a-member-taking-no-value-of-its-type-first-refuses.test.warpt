(test 1)
(name "a-member-taking-no-value-of-its-type-first-refuses")
(note "A member takes a value of its type first, under the type's bare name as under a head applying it. `make` takes a string and no `App.Box`, so it is no member of the box and refuses at the load: a procedure taking no value of a type is declared under `procedures`.")

(program
  (warp 1)
  (struct App.Box
    (field v Int)
    (procedure make
      (parameter from (type String))
      (returns App.Box)
      (body
        (return (struct (field v 1))))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses load))
