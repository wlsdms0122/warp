(test 1)
(name "an-extension-giving-a-contract-members-refuses")
(note "An extension gives a type what it gives it, and `App.Describable` is a contract, no type a value is an instance of: the build refuses the extension whatever it gives.")

(program
  (warp 1)
  (contract App.Describable
    (procedure describe
      (parameter of (type Self))
      (returns String)))
  (extension
    (head App.Describable)
    (procedure m
      (parameter of (type App.Describable))
      (returns Int)
      (body
        (return 7))))
  (procedure entry
    (access public)
    (returns Int)
    (body
      (return 1))))
(expect (refuses build))
