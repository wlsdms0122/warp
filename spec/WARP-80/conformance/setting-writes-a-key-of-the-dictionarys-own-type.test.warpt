(test 1)
(name "setting-writes-a-key-of-the-dictionarys-own-type")
(note "setting's key is of the dictionary's own key type, so a dictionary keyed by integers takes an integer there and returns the dictionary with the entry made in the key order.")

(program
  (warp 1)
  (import Standard.Collection.setting)
  (procedure entry
    (access public)
    (returns (dictionary Int String))
    (body
      (return (call Standard.Collection.setting (dictionary (entry 3 "c") (entry 1 "a")) 2 "b")))))
(expect (answers (dictionary (entry 1 "a") (entry 2 "b") (entry 3 "c"))))
