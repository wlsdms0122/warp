(test 1)
(name "setting-a-key-of-another-type-than-the-dictionarys-refuses")
(note "setting reads the dictionary's keys and the key it writes as one type: string keys beside an integer fill that type two ways, and the call refuses at the build.")

(program
  (warp 1)
  (import Standard.Collection.setting)
  (procedure entry
    (access public)
    (returns (dictionary String Int))
    (body
      (return (call Standard.Collection.setting (dictionary (entry "a" 1)) 2 3)))))
(expect (refuses build))
