(test 1)
(name "dropping-an-end-of-nothing-returns-nothing")
(note "Over nothing, dropFirst and dropLast return nothing: a list holding nothing, rather than a refusal.")

(program
  (warp 1)
  (import Standard.Collection.dropFirst)
  (import Standard.Collection.dropLast)
  (procedure entry
    (access public)
    (returns (array (array Int)))
    (body
      (let items (type (array Int)) (array))
      (return (array (call Standard.Collection.dropFirst items) (call Standard.Collection.dropLast items))))))
(expect (answers (array (array) (array))))
