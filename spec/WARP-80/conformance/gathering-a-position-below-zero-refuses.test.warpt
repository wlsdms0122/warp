(test 1)
(name "gathering-a-position-below-zero-refuses")
(note "A position the collection does not hold refuses at the run, and -1 is just below the first.")

(program
  (warp 1)
  (import Standard.Collection.gathering)
  (procedure entry
    (access public)
    (parameter at (type (array Int)))
    (returns (array Int))
    (body
      (return (call Standard.Collection.gathering (array 1 2) at)))))
(arguments (argument at (array -1)))
(expect (refuses run))
