(test 1)
(name "sorted-keeps-ties-in-the-order-they-arrived")
(note "sorted keeps elements of which neither orders before the other in the order they arrived. 0.0 and -0.0 tie under lessThan and text tells them apart, so each arrival order comes back as it was.")

(program
  (warp 1)
  (import Standard.Collection.sorted)
  (import Standard.Text.text)
  (procedure entry
    (access public)
    (returns (array String))
    (body
      (let up (type (array Double)) (array 0.0 -0.0))
      (let down (type (array Double)) (array -0.0 0.0))
      (return (array (call Standard.Text.text (call Standard.Collection.sorted up)) (call Standard.Text.text (call Standard.Collection.sorted down)))))))
(expect (answers (array "[0.0,-0.0]" "[-0.0,0.0]")))
