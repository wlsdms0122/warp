(test 1)
(name "a-statement-after-a-conditional-both-of-whose-arms-leave-refuses")
(note "The leave rules reach through structure: a conditional both of whose arms leave never finishes, so nothing may follow it and no name may bind it.")

(program
  (warp 1)
  (procedure entry
    (access public)
    (returns Int)
    (body
      (conditional
        (when true)
        (then
          (return 1))
        (else
          (return 2)))
      (let after 3)
      (return after))))
(expect (refuses load))
