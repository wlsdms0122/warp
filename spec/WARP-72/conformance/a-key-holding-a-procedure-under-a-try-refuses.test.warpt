(test 1)
(name "a-key-holding-a-procedure-under-a-try-refuses")
(note "The key `[f]` holds a procedure, which is no key, so making the dictionary stops the run. The abort after it makes the try one a run may reach, and no catch holds a refusal, so the run refuses rather than answering \"rescued\".")

(program
  (warp 1)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (var tried)
      (let f
        (closure
          (returns Int)
          (body
            (return 1))))
      (let k (type (array Any)) (array f))
      (try
        (body
          (let v (type (dictionary (array Any) Int)) (dictionary (entry k 1)))
          (call Standard.Control.abort "after"))
        (catch
          (set tried "rescued")))
      (return tried))))
(expect (refuses run))
