(test 1)
(name "a-value-a-door-does-not-take-under-a-try-refuses")
(note "`App.h` declares it returns `Int` and hands back a string, which its door does not take, so the run stops there. The abort after it makes the try one a run may reach, and no catch holds a refusal, so the run refuses rather than answering \"rescued\".")

(vocabulary
  (procedure App.h
    (const)
    (isolated)
    (returns Int)
    (answers "s")))

(program
  (warp 1)
  (import App.h)
  (import Standard.Control.abort)
  (procedure entry
    (access public)
    (returns Any)
    (body
      (var tried)
      (try
        (body
          (let v (call App.h))
          (call Standard.Control.abort "after"))
        (catch
          (set tried "rescued")))
      (return tried))))
(expect (refuses run))
