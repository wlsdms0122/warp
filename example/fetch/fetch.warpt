(warp 1)
(import IO.write)
(import JSON.parse)
(import Net.Response)
(import Net.get)
(import Standard.Collection.count)
(import Standard.Collection.keys)
(import Standard.Logic.equal)
(import Standard.Text.joined)
(import Standard.Text.text)
(procedure fetch.describe (access private) (parameter of (type Net.Response)) (returns Int) (failing cast_refused) (body (call IO.write (call Standard.Text.joined (array "status " (call Standard.Text.text (path of (field status))) "\n") "")) (let kind (path of (field headers) (index? "content-type"))) (conditional (when (call Standard.Logic.equal kind null)) (then (call IO.write (call Standard.Text.joined (array "no content type" "\n") ""))) (else (call IO.write (call Standard.Text.joined (array "content type " (as kind String) "\n") "")))) (let read (try (body (let parsed (call JSON.parse (path of (field body)))) (call fetch.summarize parsed)) (catch (call IO.write (call Standard.Text.joined (array "body is not JSON: " (path read (field message)) "\n") ""))))) (return 0)))
(procedure fetch.main (access public) (parameter url (type String)) (returns Int) (body (var outcome) (let caught (try (body (let response (call Net.get url null)) (set outcome (call fetch.describe response))) (catch (call IO.write (call Standard.Text.joined (array "no response from " url ": " (path caught (field message)) "\n") "")) (set outcome 1)))) (return outcome)))
(procedure fetch.summarize (access private) (parameter of) (failing cast_refused) (body (conditional (when (call Standard.Logic.equal of null)) (then (call IO.write (call Standard.Text.joined (array "JSON null" "\n") "")))) (let object (as? of (dictionary String Any))) (conditional (when (call Standard.Logic.equal object null)) (then) (else (call IO.write (call Standard.Text.joined (array "JSON object with keys " (call Standard.Text.joined (call Standard.Collection.keys (as object (dictionary String Any))) ", ") "\n") "")))) (let list (as? of (array Any))) (conditional (when (call Standard.Logic.equal list null)) (then) (else (call IO.write (call Standard.Text.joined (array "JSON array of " (call Standard.Text.text (call Standard.Collection.count (as list (array Any)))) "\n") ""))))))
