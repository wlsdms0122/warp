(warp 1)
(import Standard.Comparable.lessThan)
(import Standard.Concurrent.all)
(import Standard.Concurrent.first)
(import Standard.Control.abort)
(import Standard.Text.text)
(struct f.Answer (field allFailed String) (field first Any))
(procedure entry (access public) (returns f.Answer) (failing aborted cast_refused concurrent_failed) (body (var tried) (let caught (attempt (body (let every (call Standard.Concurrent.all (array (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                        (return (call f.piece 5)))) (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                                                                                                       (return (call f.piece 1))))))) (set tried "all answered")) (rescue (set tried (call Standard.Text.text (path caught (field message))))))) (return (struct (field allFailed tried) (field first (call Standard.Concurrent.first (array (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 (return (call f.piece 1)))) (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                (return (call f.piece 9)))))))))))
(procedure f.piece (access private) (isolated) (parameter n (type Int)) (returns Int) (failing aborted) (body (conditional (when (call Standard.Comparable.lessThan n 2)) (then (call Standard.Control.abort "piece failed"))) (return n)))
