(warp 1)
(import Standard.Logic.equal)
(import Standard.Numeric.minus)
(import even.is)

(procedure odd.is
  (parameter n (type Int))
  (returns Bool)
  (body
    (conditional
      (when (call Standard.Logic.equal n 0))
      (then
        (return false)))
    (return (call even.is (call Standard.Numeric.minus n 1)))))
