(warp 1)
(import Standard.Collection.map)
(import Standard.Numeric.plus)

(procedure entry
  (access public)
  (returns Int)
  (failing (anything))
  (body
    (var seen 0)
    (let mapped
      (call Standard.Collection.map
        (array 1 2)
        (closure
          (parameter item (type Int))
          (returns Int)
          (body
            (set seen (call Standard.Numeric.plus seen item))
            (return item)))))
    (return seen)))
