(warp 1)
(import Standard.Collection.appending)
(import Standard.Comparable.lessThan)
(import Standard.Control.abort)
(import Standard.Logic.equal)
(import Standard.Numeric.plus)
(import Standard.Text.joined)
(struct fail.Answer (field answers (array Int)) (field caught String) (field found Int))
(procedure entry (access public) (returns fail.Answer) (body (var caught) (let failed (attempt (body (call Standard.Control.abort "on purpose")) (rescue (set caught (call Standard.Text.joined (array (path failed (field type)) ":" (path failed (field message))) ""))))) (var answers (type (array Int)) (array)) (var i 0) (let walk (loop (while (call Standard.Comparable.lessThan i 5)) (body (set answers (call Standard.Collection.appending answers (call fail.safely i))) (set i (call Standard.Numeric.plus i 1))))) (return (struct (field answers answers) (field caught caught) (field found (call fail.firstRefused))))))
(procedure fail.firstRefused (access private) (returns Int) (body (let found (loop (while true) (body (var hit) (attempt (body (let v (call fail.risky (path found (field index)))) (set hit v)) (rescue (return (path found (field index)))))))) (return -1)))
(procedure fail.risky (access private) (const) (parameter n (type Int)) (returns Int) (failing aborted) (body (conditional (when (call Standard.Logic.equal n 3)) (then (call Standard.Control.abort "three is refused"))) (return (call Standard.Numeric.plus n 10))))
(procedure fail.safely (access private) (const) (parameter n (type Int)) (returns Int) (body (var tried) (attempt (body (let got (call fail.risky n)) (set tried got)) (rescue (set tried -1))) (return tried)))
