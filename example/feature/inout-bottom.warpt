(warp 1)
(import Standard.Collection.append)
(import Standard.Numeric.plus)

(procedure ib.add
  (parameter into (type (inout (array Int))))
  (parameter value (type Int))
  (body
    (call Standard.Collection.append into value)))

(procedure ib.bump
  (parameter count (type (inout Int)))
  (body
    (set count (call Standard.Numeric.plus count 1))))

(procedure ib.twoWays
  (parameter a (type (inout Int)))
  (parameter b (type (inout Int)))
  (returns Int)
  (body
    (set a (call Standard.Numeric.plus a 1))
    (return b)))
