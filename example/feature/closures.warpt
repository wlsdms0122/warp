(warp 1)
(import Standard.Collection.appending)
(import Standard.Collection.count)
(import Standard.Comparable.lessThan)
(import Standard.Numeric.plus)
(import Standard.Numeric.times)

(const double
  (closure
    (parameter of (type Int))
    (returns Int)
    (body
      (return (call Standard.Numeric.times of 2)))))

(struct fn.Answer
  (field applied (array Int))
  (field count Int)
  (field doubled Int))

(procedure entry
  (access public)
  (returns fn.Answer)
  (failing (anything))
  (body
    (var count 0)
    (let tick
      (closure
        (body
          (set count (call Standard.Numeric.plus count 1)))))
    (apply tick)
    (apply tick)
    (apply tick)
    (let addFive (call fn.adder 5))
    (let steps (array addFive double))
    (var applied (type (array Int)) (array))
    (let walk
      (loop
        (while (call Standard.Comparable.lessThan (path walk (field index)) (call Standard.Collection.count steps)))
        (body
          (let step (path steps (index (path walk (field index)))))
          (let got (apply step 10))
          (set applied (call Standard.Collection.appending applied got)))))
    (let doubled (apply double 21))
    (return (struct (field applied applied) (field count count) (field doubled doubled)))))

(procedure fn.adder
  (access private)
  (parameter by (type Int))
  (returns (procedure (parameters Int) (returns Int)))
  (body
    (return (closure
        (parameter of (type Int))
        (returns Int)
        (body
          (return (call Standard.Numeric.plus of by)))))))

(procedure fn.applyTen
  (access private)
  (parameter f (type (procedure (parameters Int) (returns Int))))
  (returns Int)
  (body
    (let got (apply f 10))
    (return got)))
