(warp 1)
(import Standard.Collection.keys)
(import Standard.Concurrent.all)
(import Standard.Concurrent.allKeyed)
(import Standard.Control.abort)
(import chk.positive)
(struct app.Answer (field badMessage String) (field badType String) (field byIndex (array Int)) (field fine Int) (field pieces (array String)) (field type String))
(procedure entry (access public) (returns app.Answer) (failing (anything)) (body (var type (type String) "") (var pieces (type (array String)) (array)) (var badType (type String) "") (var badMessage (type String) "") (var byIndex (type (array Int)) (array)) (let tried (try (body (call Standard.Concurrent.allKeyed (dictionary (entry "good" (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                                                                                                                                                                           (return (call chk.positive 1))))) (entry "bad" (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             (return (call chk.positive -5))))) (entry "worse" (closure (isolated) (failing aborted) (body (call Standard.Control.abort "on purpose"))))))) (catch (let failures (as (path tried (field details) (index "failures")) (dictionary String Any))) (let bad (as (path failures (index "bad")) Failure)) (set type (path tried (field type))) (set pieces (call Standard.Collection.keys failures)) (set badType (path bad (field type))) (set badMessage (path bad (field message)))))) (let indexed (try (body (call Standard.Concurrent.all (array (closure (isolated) (returns Int) (body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  (return 1))) (closure (isolated) (returns Int) (failing aborted) (body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  (return (call chk.positive -1))))))) (catch (set byIndex (call Standard.Collection.keys (as (path indexed (field details) (index "failures")) (dictionary Int Any))))))) (return (struct (field badMessage badMessage) (field badType badType) (field byIndex byIndex) (field fine (call chk.positive 3)) (field pieces pieces) (field type type)))))
