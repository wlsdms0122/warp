(warp 1)
(import Standard.Numeric.times)
(const base 6)

(const sevenTimes
  (closure
    (parameter of (type Int))
    (returns Int)
    (body
      (return (call Standard.Numeric.times of 7)))))

(procedure k.twice
  (const)
  (parameter of (type Int))
  (returns Int)
  (body
    (return (call Standard.Numeric.times of 2))))
