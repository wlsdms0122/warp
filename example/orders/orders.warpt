(warp 1)
(import File.read)
(import File.write)
(import IO.write)
(import JSON.parse)
(import JSON.text)
(import Net.post)
(import Standard.Collection.appending)
(import Standard.Collection.count)
(import Standard.Comparable.lessThan)
(import Standard.Control.abort)
(import Standard.Logic.equal)
(import Standard.Numeric.plus)
(import Standard.Numeric.times)
(import Standard.Text.joined)
(import Standard.Text.text)
(import money.format)
(import money.sum)
(struct orders.Line (field cents Int) (field qty Int) (field sku String))
(struct orders.Summary (field lines Int) (field skipped Int) (field totalCents Int))
(procedure orders.checked (access private) (parameter of) (returns orders.Line) (failing aborted cast_refused) (body (let raw (as of (dictionary String Any))) (let line (as (struct (field cents (as (path raw (index? "cents")) Int)) (field qty (as (path raw (index? "qty")) Int)) (field sku (as (path raw (index? "sku")) String))) orders.Line)) (conditional (when (call Standard.Comparable.lessThan (path line (field qty)) 1)) (then (call Standard.Control.abort (call Standard.Text.joined (array (path line (field sku)) " has no quantity") "")))) (conditional (when (call Standard.Comparable.lessThan (path line (field cents)) 0)) (then (call Standard.Control.abort (call Standard.Text.joined (array (path line (field sku)) " has a negative price") "")))) (return line)))
(procedure orders.main (access public) (parameter path (type String)) (parameter server (type String)) (returns Int) (failing cast_refused file_failed json_failed net_failed) (body (let stored (call File.read path)) (conditional (when (call Standard.Logic.equal stored null)) (then (call IO.write (call Standard.Text.joined (array "no file at " path "\n") "")) (return 1))) (let raw (as (call JSON.parse (as stored String)) (array Any))) (var lines (type (array orders.Line)) (array)) (var problems (type (array String)) (array)) (var i (type Int) 0) (loop (while (call Standard.Comparable.lessThan i (call Standard.Collection.count raw))) (body (let checked (try (body (let line (call orders.checked (path raw (index i)))) (set lines (call Standard.Collection.appending lines line))) (catch (set problems (call Standard.Collection.appending problems (path checked (field message))))))) (set i (call Standard.Numeric.plus i 1)))) (var p (type Int) 0) (loop (while (call Standard.Comparable.lessThan p (call Standard.Collection.count problems))) (body (call IO.write (call Standard.Text.joined (array "skipped: " (path problems (index p)) "\n") "")) (set p (call Standard.Numeric.plus p 1)))) (var amounts (type (array Int)) (array)) (var j (type Int) 0) (loop (while (call Standard.Comparable.lessThan j (call Standard.Collection.count lines))) (body (set amounts (call Standard.Collection.appending amounts (call Standard.Numeric.times (path lines (index j) (field cents)) (path lines (index j) (field qty))))) (set j (call Standard.Numeric.plus j 1)))) (let total (call money.sum amounts)) (let summary (as (struct (field lines (call Standard.Collection.count lines)) (field skipped (call Standard.Collection.count problems)) (field totalCents total)) orders.Summary)) (let response (call Net.post (call Standard.Text.joined (array server "/orders") "") (call JSON.text summary) (dictionary (entry "content-type" "application/json")))) (conditional (when (call Standard.Logic.equal (path response (field status)) 201)) (then) (else (call IO.write (call Standard.Text.joined (array "server answered " (call Standard.Text.text (path response (field status))) "\n") "")) (return 2))) (let answer (as (call JSON.parse (path response (field body))) (dictionary String Any))) (let receipt (call Standard.Text.joined (array "order " (call Standard.Text.text (as (path answer (index "id")) Int)) ": " (call Standard.Text.text (call Standard.Collection.count lines)) " lines, " (call money.format total)) "")) (call File.write "receipt.txt" (call Standard.Text.joined (array receipt "\n") "")) (call IO.write (call Standard.Text.joined (array receipt "\n") "")) (return 0)))
