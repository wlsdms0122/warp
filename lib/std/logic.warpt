warpt 1
{
  description "Negation, difference, choosing and the connectives, written from equality."
  imports [
    "std.collection.count"
    "std.logic.equal"
    "std.math.lessThan"
  ]
  procedures {
    "std.logic.and" {
      body [
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "side"
                  value {
                    ref "conditions[walk.index]"
                  }
                }
                {
                  let "answered"
                  value {
                    call {
                      procedure {
                        ref "side"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return false
                          }
                        }
                      ]
                      when {
                        call {
                          arguments [
                            {
                              ref "answered"
                            }
                          ]
                          procedure "std.logic.not"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "conditions"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Whether every one answers true, asked until one does not."
      parameters [
        {
          name "conditions"
          type {
            array {
              "const procedure" {
                returns "bool"
              }
            }
          }
        }
      ]
      result true
      returns "bool"
    }
    "std.logic.not" {
      description "The opposite of a truth."
      parameters [
        {
          name "value"
          type "bool"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "value"
            }
            false
          ]
          procedure "std.logic.equal"
        }
      }
      returns "bool"
    }
    "std.logic.notEqual" {
      description "Whether two values differ."
      parameters [
        {
          name "lhs"
          type "any"
        }
        {
          name "rhs"
          type "any"
        }
      ]
      result {
        call {
          arguments [
            {
              call {
                arguments [
                  {
                    ref "lhs"
                  }
                  {
                    ref "rhs"
                  }
                ]
                procedure "std.logic.equal"
              }
            }
            false
          ]
          procedure "std.logic.equal"
        }
      }
      returns "bool"
    }
    "std.logic.or" {
      body [
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "side"
                  value {
                    ref "conditions[walk.index]"
                  }
                }
                {
                  let "answered"
                  value {
                    call {
                      procedure {
                        ref "side"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return true
                          }
                        }
                      ]
                      when {
                        ref "answered"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "conditions"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Whether one answers true, asked until one does."
      parameters [
        {
          name "conditions"
          type {
            array {
              "const procedure" {
                returns "bool"
              }
            }
          }
        }
      ]
      result false
      returns "bool"
    }
    "std.logic.select" {
      body [
        {
          value {
            conditional {
              then [
                {
                  let "taken"
                  value {
                    call {
                      procedure {
                        ref "then"
                      }
                    }
                  }
                }
                {
                  value {
                    return {
                      ref "taken"
                    }
                  }
                }
              ]
              when {
                ref "condition"
              }
            }
          }
        }
        {
          let "left"
          value {
            call {
              procedure {
                ref "else"
              }
            }
          }
        }
      ]
      description "The value one of two sides answers, chosen by a truth."
      parameters [
        {
          name "condition"
          type "bool"
        }
        {
          name "then"
          type {
            "const procedure" {
              returns "some Answer"
            }
          }
        }
        {
          name "else"
          type {
            "const procedure" {
              returns "some Answer"
            }
          }
        }
      ]
      result {
        ref "left"
      }
      returns "some Answer"
    }
  }
  warp 1
}
