warpt 1
{
  description "Scanning text, written from its characters."
  imports [
    "std.collection.appending"
    "std.collection.count"
    "std.control.abort"
    "std.logic.equal"
    "std.logic.not"
    "std.math.lessThan"
    "std.math.minus"
    "std.math.plus"
    "std.text.characters"
    "std.text.joined"
  ]
  procedures {
    "std.text.contains" {
      body [
        {
          let "held"
          value {
            call {
              of {
                ref "of"
              }
              procedure "std.text.characters"
            }
          }
        }
        {
          let "wanted"
          value {
            call {
              of {
                ref "value"
              }
              procedure "std.text.characters"
            }
          }
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  value true
                  var "same"
                }
                {
                  let "probe"
                  value {
                    loop {
                      body [
                        {
                          let "at"
                          value {
                            call {
                              arguments {
                                value {
                                  ref "probe.index"
                                }
                              }
                              of {
                                ref "walk.index"
                              }
                              procedure "std.math.plus"
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "same"
                                  value false
                                }
                                {
                                  value {
                                    break null
                                  }
                                }
                              ]
                              when {
                                call {
                                  of {
                                    call {
                                      arguments {
                                        value {
                                          ref "wanted[probe.index]"
                                        }
                                      }
                                      of {
                                        ref "held[at]"
                                      }
                                      procedure "std.logic.equal"
                                    }
                                  }
                                  procedure "std.logic.not"
                                }
                              }
                            }
                          }
                        }
                      ]
                      while {
                        call {
                          arguments {
                            value {
                              call {
                                of {
                                  ref "wanted"
                                }
                                procedure "std.collection.count"
                              }
                            }
                          }
                          of {
                            ref "probe.index"
                          }
                          procedure "std.math.lessThan"
                        }
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return true
                          }
                        }
                      ]
                      when {
                        ref "same"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        arguments {
                          value 1
                        }
                        of {
                          call {
                            arguments {
                              value {
                                call {
                                  of {
                                    ref "wanted"
                                  }
                                  procedure "std.collection.count"
                                }
                              }
                            }
                            of {
                              call {
                                of {
                                  ref "held"
                                }
                                procedure "std.collection.count"
                              }
                            }
                            procedure "std.math.minus"
                          }
                        }
                        procedure "std.math.plus"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Whether a string holds another inside it."
      parameters [
        {
          name "of"
          type "string"
        }
        {
          name "value"
          type "string"
        }
      ]
      receiver "of"
      result false
      returns "bool"
    }
    "std.text.replacing" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    call {
                      of "replacing asks an empty piece"
                      procedure "std.control.abort"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments {
                    value ""
                  }
                  of {
                    ref "value"
                  }
                  procedure "std.logic.equal"
                }
              }
            }
          }
        }
      ]
      description "Every occurrence of a piece swapped for another."
      parameters [
        {
          name "of"
          type "string"
        }
        {
          name "value"
          type "string"
        }
        {
          name "with"
          type "string"
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "with"
            }
          }
          of {
            call {
              arguments {
                value {
                  ref "value"
                }
              }
              of {
                ref "of"
              }
              procedure "std.text.split"
            }
          }
          procedure "std.text.joined"
        }
      }
      returns "string"
    }
    "std.text.split" {
      body [
        {
          let "held"
          value {
            call {
              of {
                ref "of"
              }
              procedure "std.text.characters"
            }
          }
        }
        {
          let "heldCount"
          value {
            call {
              of {
                ref "held"
              }
              procedure "std.collection.count"
            }
          }
        }
        {
          let "wanted"
          value {
            call {
              of {
                ref "value"
              }
              procedure "std.text.characters"
            }
          }
        }
        {
          let "wantedCount"
          value {
            call {
              of {
                ref "wanted"
              }
              procedure "std.collection.count"
            }
          }
        }
        {
          value {
            conditional {
              then [
                {
                  value {
                    call {
                      of "split asks an empty separator"
                      procedure "std.control.abort"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments {
                    value 0
                  }
                  of {
                    ref "wantedCount"
                  }
                  procedure "std.logic.equal"
                }
              }
            }
          }
        }
        {
          value []
          var "pieces"
        }
        {
          value []
          var "current"
        }
        {
          value 0
          var "at"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  value {
                    call {
                      of {
                        call {
                          arguments {
                            value {
                              call {
                                arguments {
                                  value {
                                    ref "wantedCount"
                                  }
                                }
                                of {
                                  ref "at"
                                }
                                procedure "std.math.plus"
                              }
                            }
                          }
                          of {
                            ref "heldCount"
                          }
                          procedure "std.math.lessThan"
                        }
                      }
                      procedure "std.logic.not"
                    }
                  }
                  var "matched"
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          let "probe"
                          value {
                            loop {
                              body [
                                {
                                  let "offset"
                                  value {
                                    call {
                                      arguments {
                                        value {
                                          ref "probe.index"
                                        }
                                      }
                                      of {
                                        ref "at"
                                      }
                                      procedure "std.math.plus"
                                    }
                                  }
                                }
                                {
                                  value {
                                    conditional {
                                      then [
                                        {
                                          set "matched"
                                          value false
                                        }
                                        {
                                          value {
                                            break null
                                          }
                                        }
                                      ]
                                      when {
                                        call {
                                          of {
                                            call {
                                              arguments {
                                                value {
                                                  ref "wanted[probe.index]"
                                                }
                                              }
                                              of {
                                                ref "held[offset]"
                                              }
                                              procedure "std.logic.equal"
                                            }
                                          }
                                          procedure "std.logic.not"
                                        }
                                      }
                                    }
                                  }
                                }
                              ]
                              while {
                                call {
                                  arguments {
                                    value {
                                      ref "wantedCount"
                                    }
                                  }
                                  of {
                                    ref "probe.index"
                                  }
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                      ]
                      when {
                        ref "matched"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      else [
                        {
                          set "current"
                          value {
                            call {
                              arguments {
                                value {
                                  ref "held[at]"
                                }
                              }
                              of {
                                ref "current"
                              }
                              procedure "std.collection.appending"
                            }
                          }
                        }
                        {
                          set "at"
                          value {
                            call {
                              arguments {
                                value 1
                              }
                              of {
                                ref "at"
                              }
                              procedure "std.math.plus"
                            }
                          }
                        }
                      ]
                      then [
                        {
                          set "pieces"
                          value {
                            call {
                              arguments {
                                value {
                                  call {
                                    of {
                                      ref "current"
                                    }
                                    procedure "std.text.joined"
                                  }
                                }
                              }
                              of {
                                ref "pieces"
                              }
                              procedure "std.collection.appending"
                            }
                          }
                        }
                        {
                          set "current"
                          value []
                        }
                        {
                          set "at"
                          value {
                            call {
                              arguments {
                                value {
                                  ref "wantedCount"
                                }
                              }
                              of {
                                ref "at"
                              }
                              procedure "std.math.plus"
                            }
                          }
                        }
                      ]
                      when {
                        ref "matched"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      ref "heldCount"
                    }
                  }
                  of {
                    ref "at"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The text cut on a separator."
      parameters [
        {
          name "of"
          type "string"
        }
        {
          name "value"
          type "string"
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              call {
                of {
                  ref "current"
                }
                procedure "std.text.joined"
              }
            }
          }
          of {
            ref "pieces"
          }
          procedure "std.collection.appending"
        }
      }
      returns "array<string>"
    }
    "std.text.startsWith" {
      body [
        {
          let "held"
          value {
            call {
              of {
                ref "of"
              }
              procedure "std.text.characters"
            }
          }
        }
        {
          let "wanted"
          value {
            call {
              of {
                ref "value"
              }
              procedure "std.text.characters"
            }
          }
        }
        {
          value {
            conditional {
              then [
                {
                  value {
                    return false
                  }
                }
              ]
              when {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "wanted"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    call {
                      of {
                        ref "held"
                      }
                      procedure "std.collection.count"
                    }
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return false
                          }
                        }
                      ]
                      when {
                        call {
                          of {
                            call {
                              arguments {
                                value {
                                  ref "wanted[walk.index]"
                                }
                              }
                              of {
                                ref "held[walk.index]"
                              }
                              procedure "std.logic.equal"
                            }
                          }
                          procedure "std.logic.not"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "wanted"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Whether a string begins with another."
      parameters [
        {
          name "of"
          type "string"
        }
        {
          name "value"
          type "string"
        }
      ]
      receiver "of"
      result true
      returns "bool"
    }
  }
  warp 1
}
