warpt 1
{
  description "Reading a collection by walking it, written from its count and its index."
  imports [
    "std.Comparable"
    "std.collection.appending"
    "std.collection.count"
    "std.collection.gathering"
    "std.collection.keys"
    "std.logic.equal"
    "std.math.lessThan"
    "std.math.minus"
    "std.math.plus"
  ]
  procedures {
    "std.collection.append" {
      body [
        {
          set "array"
          value {
            call {
              arguments [
                {
                  ref "array"
                }
                {
                  ref "element"
                }
              ]
              procedure "std.collection.appending"
            }
          }
        }
      ]
      description "Writes one element onto the end of the array a variable holds, in place."
      parameters [
        {
          name "array"
          type "inout array<some Element>"
        }
        {
          name "element"
          type "some Element"
        }
      ]
      result null
      returns "null"
    }
    "std.collection.contains" {
      body [
        {
          value false
          var "found"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  value {
                    conditional {
                      then [
                        {
                          set "found"
                          value true
                        }
                        {
                          value {
                            break null
                          }
                        }
                      ]
                      when {
                        call {
                          arguments [
                            {
                              ref "array[walk.index]"
                            }
                            {
                              ref "element"
                            }
                          ]
                          procedure "std.logic.equal"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "array"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Whether an array holds a value."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
        {
          name "element"
          type "some Element"
        }
      ]
      result {
        ref "found"
      }
      returns "bool"
    }
    "std.collection.dropFirst" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  set "places"
                  value {
                    call {
                      arguments [
                        {
                          ref "places"
                        }
                        {
                          call {
                            arguments [
                              {
                                ref "walk.index"
                              }
                              1
                            ]
                            procedure "std.math.plus"
                          }
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                {
                                  ref "array"
                                }
                              ]
                              procedure "std.collection.count"
                            }
                          }
                          1
                        ]
                        procedure "std.math.minus"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements after the first."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "array"
            }
            {
              ref "places"
            }
          ]
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.dropLast" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  set "places"
                  value {
                    call {
                      arguments [
                        {
                          ref "places"
                        }
                        {
                          ref "walk.index"
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            call {
                              arguments [
                                {
                                  ref "array"
                                }
                              ]
                              procedure "std.collection.count"
                            }
                          }
                          1
                        ]
                        procedure "std.math.minus"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements before the last."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "array"
            }
            {
              ref "places"
            }
          ]
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.filter" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "kept"
                  value {
                    call {
                      arguments [
                        {
                          ref "array[walk.index]"
                        }
                      ]
                      procedure {
                        ref "isIncluded"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          set "places"
                          value {
                            call {
                              arguments [
                                {
                                  ref "places"
                                }
                                {
                                  ref "walk.index"
                                }
                              ]
                              procedure "std.collection.appending"
                            }
                          }
                        }
                      ]
                      when {
                        ref "kept"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "array"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements a procedure answers true for."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
        {
          name "isIncluded"
          type {
            "const procedure" {
              parameters [
                "some Element"
              ]
              returns "bool"
            }
          }
        }
      ]
      result {
        call {
          arguments [
            {
              ref "array"
            }
            {
              ref "places"
            }
          ]
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.first" {
      description "The first element, or nothing."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
      ]
      result {
        ref "array[0]"
      }
      returns "some Element"
    }
    "std.collection.last" {
      body [
        {
          let "at"
          value {
            call {
              arguments [
                {
                  call {
                    arguments [
                      {
                        ref "array"
                      }
                    ]
                    procedure "std.collection.count"
                  }
                }
                1
              ]
              procedure "std.math.minus"
            }
          }
        }
      ]
      description "The last element, or nothing."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
      ]
      result {
        ref "array[at]"
      }
      returns "some Element"
    }
    "std.collection.map" {
      body [
        {
          value []
          var "answers"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "answered"
                  value {
                    call {
                      arguments [
                        {
                          ref "array[walk.index]"
                        }
                      ]
                      procedure {
                        ref "transform"
                      }
                    }
                  }
                }
                {
                  set "answers"
                  value {
                    call {
                      arguments [
                        {
                          ref "answers"
                        }
                        {
                          ref "answered"
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "array"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Each element answered by a procedure, in order."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
        {
          name "transform"
          type {
            "const procedure" {
              parameters [
                "some Element"
              ]
              returns "some Answer"
            }
          }
        }
      ]
      result {
        ref "answers"
      }
      returns "array<some Answer>"
    }
    "std.collection.prepending" {
      body [
        {
          let "back"
          value {
            call {
              arguments [
                {
                  ref "array"
                }
              ]
              procedure "std.collection.reversed"
            }
          }
        }
        {
          let "grown"
          value {
            call {
              arguments [
                {
                  ref "back"
                }
                {
                  ref "element"
                }
              ]
              procedure "std.collection.appending"
            }
          }
        }
      ]
      description "The elements with one more at the front."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
        {
          name "element"
          type "some Element"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "grown"
            }
          ]
          procedure "std.collection.reversed"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.reduce" {
      body [
        {
          value {
            ref "initialResult"
          }
          var "carried"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "answered"
                  value {
                    call {
                      arguments [
                        {
                          ref "carried"
                        }
                        {
                          ref "array[walk.index]"
                        }
                      ]
                      procedure {
                        ref "nextPartialResult"
                      }
                    }
                  }
                }
                {
                  set "carried"
                  value {
                    ref "answered"
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "array"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements folded into one, starting from a value."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
        {
          name "initialResult"
          type "some Carried"
        }
        {
          name "nextPartialResult"
          type {
            "const procedure" {
              parameters [
                "some Carried"
                "some Element"
              ]
              returns "some Carried"
            }
          }
        }
      ]
      result {
        ref "carried"
      }
      returns "some Carried"
    }
    "std.collection.reversed" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  set "places"
                  value {
                    call {
                      arguments [
                        {
                          ref "places"
                        }
                        {
                          call {
                            arguments [
                              {
                                call {
                                  arguments [
                                    {
                                      ref "array"
                                    }
                                  ]
                                  procedure "std.collection.count"
                                }
                              }
                              {
                                call {
                                  arguments [
                                    {
                                      ref "walk.index"
                                    }
                                    1
                                  ]
                                  procedure "std.math.plus"
                                }
                              }
                            ]
                            procedure "std.math.minus"
                          }
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "array"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements back to front."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "array"
            }
            {
              ref "places"
            }
          ]
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.sorted" {
      body [
        {
          let "total"
          value {
            call {
              arguments [
                {
                  ref "array"
                }
              ]
              procedure "std.collection.count"
            }
          }
        }
        {
          value []
          var "ranks"
        }
        {
          let "outer"
          value {
            loop {
              body [
                {
                  value 0
                  var "rank"
                }
                {
                  let "inner"
                  value {
                    loop {
                      body [
                        {
                          value true
                          var "tie"
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "rank"
                                  value {
                                    call {
                                      arguments [
                                        {
                                          ref "rank"
                                        }
                                        1
                                      ]
                                      procedure "std.math.plus"
                                    }
                                  }
                                }
                                {
                                  set "tie"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments [
                                    {
                                      ref "array[inner.index]"
                                    }
                                    {
                                      ref "array[outer.index]"
                                    }
                                  ]
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "tie"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments [
                                    {
                                      ref "array[outer.index]"
                                    }
                                    {
                                      ref "array[inner.index]"
                                    }
                                  ]
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  value {
                                    conditional {
                                      then [
                                        {
                                          set "rank"
                                          value {
                                            call {
                                              arguments [
                                                {
                                                  ref "rank"
                                                }
                                                1
                                              ]
                                              procedure "std.math.plus"
                                            }
                                          }
                                        }
                                      ]
                                      when {
                                        call {
                                          arguments [
                                            {
                                              ref "inner.index"
                                            }
                                            {
                                              ref "outer.index"
                                            }
                                          ]
                                          procedure "std.math.lessThan"
                                        }
                                      }
                                    }
                                  }
                                }
                              ]
                              when {
                                ref "tie"
                              }
                            }
                          }
                        }
                      ]
                      while {
                        call {
                          arguments [
                            {
                              ref "inner.index"
                            }
                            {
                              ref "total"
                            }
                          ]
                          procedure "std.math.lessThan"
                        }
                      }
                    }
                  }
                }
                {
                  set "ranks"
                  value {
                    call {
                      arguments [
                        {
                          ref "ranks"
                        }
                        {
                          ref "rank"
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "outer.index"
                    }
                    {
                      ref "total"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
        {
          value []
          var "places"
        }
        {
          let "pick"
          value {
            loop {
              body [
                {
                  let "scan"
                  value {
                    loop {
                      body [
                        {
                          value true
                          var "same"
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "same"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments [
                                    {
                                      ref "ranks[scan.index]"
                                    }
                                    {
                                      ref "pick.index"
                                    }
                                  ]
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "same"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments [
                                    {
                                      ref "pick.index"
                                    }
                                    {
                                      ref "ranks[scan.index]"
                                    }
                                  ]
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "places"
                                  value {
                                    call {
                                      arguments [
                                        {
                                          ref "places"
                                        }
                                        {
                                          ref "scan.index"
                                        }
                                      ]
                                      procedure "std.collection.appending"
                                    }
                                  }
                                }
                              ]
                              when {
                                ref "same"
                              }
                            }
                          }
                        }
                      ]
                      while {
                        call {
                          arguments [
                            {
                              ref "scan.index"
                            }
                            {
                              ref "total"
                            }
                          ]
                          procedure "std.math.lessThan"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "pick.index"
                    }
                    {
                      ref "total"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        Element "std.Comparable"
      }
      description "The elements in order, for numbers or for strings."
      parameters [
        {
          name "array"
          type "array<some Element>"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "array"
            }
            {
              ref "places"
            }
          ]
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.values" {
      body [
        {
          let "names"
          value {
            call {
              arguments [
                {
                  ref "dictionary"
                }
              ]
              procedure "std.collection.keys"
            }
          }
        }
        {
          value []
          var "held"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "name"
                  value {
                    ref "names[walk.index]"
                  }
                }
                {
                  set "held"
                  value {
                    call {
                      arguments [
                        {
                          ref "held"
                        }
                        {
                          ref "dictionary[name]"
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "names"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "What a record holds, by its names in order."
      parameters [
        {
          name "dictionary"
          type "dictionary<some Entry>"
        }
      ]
      result {
        ref "held"
      }
      returns "array<some Entry>"
    }
  }
  warp 1
}
