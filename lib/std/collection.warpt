warpt 1
{
  description "Reading a collection by walking it, written from its count and its index."
  imports [
    "std.Comparable"
    "std.collection.appending"
    "std.collection.count"
    "std.collection.gathering"
    "std.collection.keys"
    "std.logic.equal"
    "std.math.lessThan"
    "std.math.minus"
    "std.math.plus"
  ]
  procedures {
    "std.collection.append" {
      body [
        {
          set "to"
          value {
            call {
              arguments {
                value {
                  ref "value"
                }
              }
              of {
                ref "to"
              }
              procedure "std.collection.appending"
            }
          }
        }
      ]
      description "Writes one element onto the end of the array a variable holds, in place."
      parameters [
        {
          name "to"
          type "inout array<some Element>"
        }
        {
          name "value"
          type "some Element"
        }
      ]
      receiver "to"
      result null
      returns "null"
    }
    "std.collection.contains" {
      body [
        {
          value false
          var "found"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  value {
                    conditional {
                      then [
                        {
                          set "found"
                          value true
                        }
                        {
                          value {
                            break null
                          }
                        }
                      ]
                      when {
                        call {
                          arguments {
                            value {
                              ref "value"
                            }
                          }
                          of {
                            ref "of[walk.index]"
                          }
                          procedure "std.logic.equal"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "of"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Whether an array holds a value."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
        {
          name "value"
          type "some Element"
        }
      ]
      receiver "of"
      result {
        ref "found"
      }
      returns "bool"
    }
    "std.collection.dropFirst" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  set "places"
                  value {
                    call {
                      arguments {
                        value {
                          call {
                            arguments {
                              value 1
                            }
                            of {
                              ref "walk.index"
                            }
                            procedure "std.math.plus"
                          }
                        }
                      }
                      of {
                        ref "places"
                      }
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        arguments {
                          value 1
                        }
                        of {
                          call {
                            of {
                              ref "of"
                            }
                            procedure "std.collection.count"
                          }
                        }
                        procedure "std.math.minus"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements after the first."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "places"
            }
          }
          of {
            ref "of"
          }
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.dropLast" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  set "places"
                  value {
                    call {
                      arguments {
                        value {
                          ref "walk.index"
                        }
                      }
                      of {
                        ref "places"
                      }
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        arguments {
                          value 1
                        }
                        of {
                          call {
                            of {
                              ref "of"
                            }
                            procedure "std.collection.count"
                          }
                        }
                        procedure "std.math.minus"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements before the last."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "places"
            }
          }
          of {
            ref "of"
          }
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.filter" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "kept"
                  value {
                    apply {
                      arguments [
                        {
                          ref "of[walk.index]"
                        }
                      ]
                      procedure {
                        ref "value"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          set "places"
                          value {
                            call {
                              arguments {
                                value {
                                  ref "walk.index"
                                }
                              }
                              of {
                                ref "places"
                              }
                              procedure "std.collection.appending"
                            }
                          }
                        }
                      ]
                      when {
                        ref "kept"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "of"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements a procedure answers true for."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
        {
          name "value"
          type {
            "const procedure" {
              parameters [
                "some Element"
              ]
              returns "bool"
            }
          }
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "places"
            }
          }
          of {
            ref "of"
          }
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.first" {
      description "The first element, or nothing."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
      ]
      receiver "of"
      result {
        ref "of[0]"
      }
      returns "some Element"
    }
    "std.collection.last" {
      body [
        {
          let "at"
          value {
            call {
              arguments {
                value 1
              }
              of {
                call {
                  of {
                    ref "of"
                  }
                  procedure "std.collection.count"
                }
              }
              procedure "std.math.minus"
            }
          }
        }
      ]
      description "The last element, or nothing."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
      ]
      receiver "of"
      result {
        ref "of[at]"
      }
      returns "some Element"
    }
    "std.collection.map" {
      body [
        {
          value []
          var "answers"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "answered"
                  value {
                    apply {
                      arguments [
                        {
                          ref "of[walk.index]"
                        }
                      ]
                      procedure {
                        ref "value"
                      }
                    }
                  }
                }
                {
                  set "answers"
                  value {
                    call {
                      arguments {
                        value {
                          ref "answered"
                        }
                      }
                      of {
                        ref "answers"
                      }
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "of"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Each element answered by a procedure, in order."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
        {
          name "value"
          type {
            "const procedure" {
              parameters [
                "some Element"
              ]
              returns "some Answer"
            }
          }
        }
      ]
      receiver "of"
      result {
        ref "answers"
      }
      returns "array<some Answer>"
    }
    "std.collection.prepending" {
      body [
        {
          let "back"
          value {
            call {
              of {
                ref "of"
              }
              procedure "std.collection.reversed"
            }
          }
        }
        {
          let "grown"
          value {
            call {
              arguments {
                value {
                  ref "value"
                }
              }
              of {
                ref "back"
              }
              procedure "std.collection.appending"
            }
          }
        }
      ]
      description "The elements with one more at the front."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
        {
          name "value"
          type "some Element"
        }
      ]
      receiver "of"
      result {
        call {
          of {
            ref "grown"
          }
          procedure "std.collection.reversed"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.reduce" {
      body [
        {
          value {
            ref "from"
          }
          var "carried"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "answered"
                  value {
                    apply {
                      arguments [
                        {
                          ref "carried"
                        }
                        {
                          ref "of[walk.index]"
                        }
                      ]
                      procedure {
                        ref "value"
                      }
                    }
                  }
                }
                {
                  set "carried"
                  value {
                    ref "answered"
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "of"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements folded into one, starting from a value."
      parameters [
        {
          name "from"
          type "some Carried"
        }
        {
          name "of"
          type "array<some Element>"
        }
        {
          name "value"
          type {
            "const procedure" {
              parameters [
                "some Carried"
                "some Element"
              ]
              returns "some Carried"
            }
          }
        }
      ]
      receiver "of"
      result {
        ref "carried"
      }
      returns "some Carried"
    }
    "std.collection.reversed" {
      body [
        {
          value []
          var "places"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  set "places"
                  value {
                    call {
                      arguments {
                        value {
                          call {
                            arguments {
                              value {
                                call {
                                  arguments {
                                    value 1
                                  }
                                  of {
                                    ref "walk.index"
                                  }
                                  procedure "std.math.plus"
                                }
                              }
                            }
                            of {
                              call {
                                of {
                                  ref "of"
                                }
                                procedure "std.collection.count"
                              }
                            }
                            procedure "std.math.minus"
                          }
                        }
                      }
                      of {
                        ref "places"
                      }
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "of"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "The elements back to front."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "places"
            }
          }
          of {
            ref "of"
          }
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.sorted" {
      body [
        {
          let "total"
          value {
            call {
              of {
                ref "of"
              }
              procedure "std.collection.count"
            }
          }
        }
        {
          value []
          var "ranks"
        }
        {
          let "outer"
          value {
            loop {
              body [
                {
                  value 0
                  var "rank"
                }
                {
                  let "inner"
                  value {
                    loop {
                      body [
                        {
                          value true
                          var "tie"
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "rank"
                                  value {
                                    call {
                                      arguments {
                                        value 1
                                      }
                                      of {
                                        ref "rank"
                                      }
                                      procedure "std.math.plus"
                                    }
                                  }
                                }
                                {
                                  set "tie"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments {
                                    value {
                                      ref "of[outer.index]"
                                    }
                                  }
                                  of {
                                    ref "of[inner.index]"
                                  }
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "tie"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments {
                                    value {
                                      ref "of[inner.index]"
                                    }
                                  }
                                  of {
                                    ref "of[outer.index]"
                                  }
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  value {
                                    conditional {
                                      then [
                                        {
                                          set "rank"
                                          value {
                                            call {
                                              arguments {
                                                value 1
                                              }
                                              of {
                                                ref "rank"
                                              }
                                              procedure "std.math.plus"
                                            }
                                          }
                                        }
                                      ]
                                      when {
                                        call {
                                          arguments {
                                            value {
                                              ref "outer.index"
                                            }
                                          }
                                          of {
                                            ref "inner.index"
                                          }
                                          procedure "std.math.lessThan"
                                        }
                                      }
                                    }
                                  }
                                }
                              ]
                              when {
                                ref "tie"
                              }
                            }
                          }
                        }
                      ]
                      while {
                        call {
                          arguments {
                            value {
                              ref "total"
                            }
                          }
                          of {
                            ref "inner.index"
                          }
                          procedure "std.math.lessThan"
                        }
                      }
                    }
                  }
                }
                {
                  set "ranks"
                  value {
                    call {
                      arguments {
                        value {
                          ref "rank"
                        }
                      }
                      of {
                        ref "ranks"
                      }
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      ref "total"
                    }
                  }
                  of {
                    ref "outer.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
        {
          value []
          var "places"
        }
        {
          let "pick"
          value {
            loop {
              body [
                {
                  let "scan"
                  value {
                    loop {
                      body [
                        {
                          value true
                          var "same"
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "same"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments {
                                    value {
                                      ref "pick.index"
                                    }
                                  }
                                  of {
                                    ref "ranks[scan.index]"
                                  }
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "same"
                                  value false
                                }
                              ]
                              when {
                                call {
                                  arguments {
                                    value {
                                      ref "ranks[scan.index]"
                                    }
                                  }
                                  of {
                                    ref "pick.index"
                                  }
                                  procedure "std.math.lessThan"
                                }
                              }
                            }
                          }
                        }
                        {
                          value {
                            conditional {
                              then [
                                {
                                  set "places"
                                  value {
                                    call {
                                      arguments {
                                        value {
                                          ref "scan.index"
                                        }
                                      }
                                      of {
                                        ref "places"
                                      }
                                      procedure "std.collection.appending"
                                    }
                                  }
                                }
                              ]
                              when {
                                ref "same"
                              }
                            }
                          }
                        }
                      ]
                      while {
                        call {
                          arguments {
                            value {
                              ref "total"
                            }
                          }
                          of {
                            ref "scan.index"
                          }
                          procedure "std.math.lessThan"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      ref "total"
                    }
                  }
                  of {
                    ref "pick.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        Element "std.Comparable"
      }
      description "The elements in order, for numbers or for strings."
      parameters [
        {
          name "of"
          type "array<some Element>"
        }
      ]
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "places"
            }
          }
          of {
            ref "of"
          }
          procedure "std.collection.gathering"
        }
      }
      returns "array<some Element>"
    }
    "std.collection.values" {
      body [
        {
          let "names"
          value {
            call {
              of {
                ref "of"
              }
              procedure "std.collection.keys"
            }
          }
        }
        {
          value []
          var "held"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "name"
                  value {
                    ref "names[walk.index]"
                  }
                }
                {
                  set "held"
                  value {
                    call {
                      arguments {
                        value {
                          ref "of[name]"
                        }
                      }
                      of {
                        ref "held"
                      }
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments {
                    value {
                      call {
                        of {
                          ref "names"
                        }
                        procedure "std.collection.count"
                      }
                    }
                  }
                  of {
                    ref "walk.index"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "What a record holds, by its names in order."
      parameters [
        {
          name "of"
          type "dictionary<some Entry>"
        }
      ]
      receiver "of"
      result {
        ref "held"
      }
      returns "array<some Entry>"
    }
  }
  warp 1
}
