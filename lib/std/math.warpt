warpt 1
{
  description "Ordering the other way round, choosing between two, and dropping a sign. Written from lessThan."
  imports [
    "std.math.lessThan"
    "std.math.minus"
  ]
  procedures {
    "std.math.absolute" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    return {
                      call {
                        arguments {
                          value {
                            ref "of"
                          }
                        }
                        of 0
                        procedure "std.math.minus"
                      }
                    }
                  }
                }
              ]
              when {
                call {
                  arguments {
                    value 0
                  }
                  of {
                    ref "of"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        N "std.Numeric"
      }
      description "The number without its sign."
      parameters {
        of "some N"
      }
      receiver "of"
      result {
        ref "of"
      }
      returns "some N"
    }
    "std.math.greaterThan" {
      bounds {
        T "std.Comparable"
      }
      description "Whether this one is larger, by the one order."
      parameters {
        of "some T"
        value "some T"
      }
      receiver "of"
      result {
        call {
          arguments {
            value {
              ref "of"
            }
          }
          of {
            ref "value"
          }
          procedure "std.math.lessThan"
        }
      }
      returns "bool"
    }
    "std.math.max" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    return {
                      ref "value"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments {
                    value {
                      ref "value"
                    }
                  }
                  of {
                    ref "of"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        T "std.Comparable"
      }
      description "The larger of two of a kind, by the one order."
      parameters {
        of "some T"
        value "some T"
      }
      receiver "of"
      result {
        ref "of"
      }
      returns "some T"
    }
    "std.math.min" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    return {
                      ref "of"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments {
                    value {
                      ref "value"
                    }
                  }
                  of {
                    ref "of"
                  }
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        T "std.Comparable"
      }
      description "The smaller of two of a kind, by the one order."
      parameters {
        of "some T"
        value "some T"
      }
      receiver "of"
      result {
        ref "value"
      }
      returns "some T"
    }
  }
  warp 1
}
