warpt 1
{
  description "Ordering the other way round, choosing between two, and dropping a sign. Written from lessThan."
  imports [
    "std.Comparable"
    "std.Numeric"
    "std.math.lessThan"
    "std.math.minus"
  ]
  procedures {
    "std.math.absolute" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    return {
                      ref "number"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments [
                    0
                    {
                      ref "number"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        N "std.Numeric"
      }
      description "The number without its sign."
      parameters [
        {
          name "number"
          type "some N"
        }
      ]
      result {
        call {
          arguments [
            0
            {
              ref "number"
            }
          ]
          procedure "std.math.minus"
        }
      }
      returns "some N"
    }
    "std.math.greaterThan" {
      bounds {
        T "std.Comparable"
      }
      description "Whether this one is larger, by the one order."
      parameters [
        {
          name "lhs"
          type "some T"
        }
        {
          name "rhs"
          type "some T"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "rhs"
            }
            {
              ref "lhs"
            }
          ]
          procedure "std.math.lessThan"
        }
      }
      returns "bool"
    }
    "std.math.max" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    return {
                      ref "lhs"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments [
                    {
                      ref "rhs"
                    }
                    {
                      ref "lhs"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        T "std.Comparable"
      }
      description "The larger of two of a kind, by the one order."
      parameters [
        {
          name "lhs"
          type "some T"
        }
        {
          name "rhs"
          type "some T"
        }
      ]
      result {
        ref "rhs"
      }
      returns "some T"
    }
    "std.math.min" {
      body [
        {
          value {
            conditional {
              then [
                {
                  value {
                    return {
                      ref "rhs"
                    }
                  }
                }
              ]
              when {
                call {
                  arguments [
                    {
                      ref "rhs"
                    }
                    {
                      ref "lhs"
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      bounds {
        T "std.Comparable"
      }
      description "The smaller of two of a kind, by the one order."
      parameters [
        {
          name "lhs"
          type "some T"
        }
        {
          name "rhs"
          type "some T"
        }
      ]
      result {
        ref "lhs"
      }
      returns "some T"
    }
  }
  warp 1
}
