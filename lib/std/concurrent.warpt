warpt 1
{
  description "Running one closure once per element, written from the fan-out that runs a list of them."
  imports [
    "std.collection.appending"
    "std.collection.count"
    "std.concurrent.all"
    "std.math.lessThan"
  ]
  procedures {
    "std.concurrent.map" {
      body [
        {
          value []
          var "pieces"
        }
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "item"
                  value {
                    ref "over[walk.index]"
                  }
                }
                {
                  let "index"
                  value {
                    ref "walk.index"
                  }
                }
                {
                  let "piece"
                  value {
                    closure {
                      body [
                        {
                          let "answered"
                          value {
                            apply {
                              arguments [
                                {
                                  ref "item"
                                }
                                {
                                  ref "index"
                                }
                              ]
                              procedure {
                                ref "by"
                              }
                            }
                          }
                        }
                      ]
                      result {
                        ref "answered"
                      }
                    }
                  }
                }
                {
                  set "pieces"
                  value {
                    call {
                      arguments [
                        {
                          ref "pieces"
                        }
                        {
                          ref "piece"
                        }
                      ]
                      procedure "std.collection.appending"
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "over"
                          }
                        ]
                        procedure "std.collection.count"
                      }
                    }
                  ]
                  procedure "std.math.lessThan"
                }
              }
            }
          }
        }
      ]
      description "Each element answered by a procedure, run at once, in the collection's order."
      parameters [
        {
          name "over"
          type "array<some Element>"
        }
        {
          name "by"
          type {
            "isolated procedure" {
              parameters [
                "some Element"
                "int"
              ]
              returns "some Answer"
            }
          }
        }
      ]
      result {
        call {
          arguments [
            {
              ref "pieces"
            }
          ]
          procedure "std.concurrent.all"
        }
      }
      returns "array<some Answer>"
    }
  }
  warp 1
}
