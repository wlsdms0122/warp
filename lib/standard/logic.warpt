warpt 1
{
  description "Negation, difference, choosing and the connectives, written from equality."
  imports [
    "Standard.Collection.count"
    "Standard.Comparable.lessThan"
    "Standard.Logic.equal"
  ]
  procedures {
    "Standard.Logic.and" {
      body [
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "side"
                  value {
                    ref "conditions[walk.index]"
                  }
                }
                {
                  let "answered"
                  value {
                    call {
                      procedure {
                        ref "side"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return false
                          }
                        }
                      ]
                      when {
                        call {
                          arguments [
                            {
                              ref "answered"
                            }
                          ]
                          procedure "Standard.Logic.not"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "conditions"
                          }
                        ]
                        procedure "Standard.Collection.count"
                      }
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      const true
      description "Whether every one answers true, asked until one does not."
      isolated true
      parameters [
        {
          name "conditions"
          type "Array<const isolated () -> Bool>"
        }
      ]
      result true
      returns "Bool"
    }
    "Standard.Logic.not" {
      const true
      description "The opposite of a truth."
      isolated true
      parameters [
        {
          name "value"
          type "Bool"
        }
      ]
      result {
        call {
          arguments [
            {
              ref "value"
            }
            false
          ]
          procedure "Standard.Logic.equal"
        }
      }
      returns "Bool"
    }
    "Standard.Logic.notEqual" {
      const true
      description "Whether two values differ."
      isolated true
      parameters [
        {
          name "lhs"
        }
        {
          name "rhs"
        }
      ]
      result {
        call {
          arguments [
            {
              call {
                arguments [
                  {
                    ref "lhs"
                  }
                  {
                    ref "rhs"
                  }
                ]
                procedure "Standard.Logic.equal"
              }
            }
            false
          ]
          procedure "Standard.Logic.equal"
        }
      }
      returns "Bool"
    }
    "Standard.Logic.or" {
      body [
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "side"
                  value {
                    ref "conditions[walk.index]"
                  }
                }
                {
                  let "answered"
                  value {
                    call {
                      procedure {
                        ref "side"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return true
                          }
                        }
                      ]
                      when {
                        ref "answered"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "conditions"
                          }
                        ]
                        procedure "Standard.Collection.count"
                      }
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      const true
      description "Whether one answers true, asked until one does."
      isolated true
      parameters [
        {
          name "conditions"
          type "Array<const isolated () -> Bool>"
        }
      ]
      result false
      returns "Bool"
    }
    "Standard.Logic.select" {
      body [
        {
          value {
            conditional {
              then [
                {
                  let "taken"
                  value {
                    call {
                      procedure {
                        ref "then"
                      }
                    }
                  }
                }
                {
                  value {
                    return {
                      ref "taken"
                    }
                  }
                }
              ]
              when {
                ref "condition"
              }
            }
          }
        }
        {
          let "left"
          value {
            call {
              procedure {
                ref "else"
              }
            }
          }
        }
      ]
      const true
      description "The value one of two sides answers, chosen by a truth."
      isolated true
      parameters [
        {
          name "condition"
          type "Bool"
        }
        {
          name "then"
          type "const isolated () -> some Answer"
        }
        {
          name "else"
          type "const isolated () -> some Answer"
        }
      ]
      result {
        ref "left"
      }
      returns "some Answer"
    }
    "Standard.Logic.tryAnd" {
      body [
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "side"
                  value {
                    ref "conditions[walk.index]"
                  }
                }
                {
                  let "answered"
                  value {
                    call {
                      procedure {
                        ref "side"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return false
                          }
                        }
                      ]
                      when {
                        call {
                          arguments [
                            {
                              ref "answered"
                            }
                          ]
                          procedure "Standard.Logic.not"
                        }
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "conditions"
                          }
                        ]
                        procedure "Standard.Collection.count"
                      }
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      const true
      description "Whether every one of sides that may fail answers true, asked until one does not."
      failing "anything"
      isolated true
      parameters [
        {
          name "conditions"
          type "Array<const isolated () throws -> Bool>"
        }
      ]
      result true
      returns "Bool"
    }
    "Standard.Logic.tryOr" {
      body [
        {
          let "walk"
          value {
            loop {
              body [
                {
                  let "side"
                  value {
                    ref "conditions[walk.index]"
                  }
                }
                {
                  let "answered"
                  value {
                    call {
                      procedure {
                        ref "side"
                      }
                    }
                  }
                }
                {
                  value {
                    conditional {
                      then [
                        {
                          value {
                            return true
                          }
                        }
                      ]
                      when {
                        ref "answered"
                      }
                    }
                  }
                }
              ]
              while {
                call {
                  arguments [
                    {
                      ref "walk.index"
                    }
                    {
                      call {
                        arguments [
                          {
                            ref "conditions"
                          }
                        ]
                        procedure "Standard.Collection.count"
                      }
                    }
                  ]
                  procedure "Standard.Comparable.lessThan"
                }
              }
            }
          }
        }
      ]
      const true
      description "Whether one of sides that may fail answers true, asked until one does."
      failing "anything"
      isolated true
      parameters [
        {
          name "conditions"
          type "Array<const isolated () throws -> Bool>"
        }
      ]
      result false
      returns "Bool"
    }
    "Standard.Logic.trySelect" {
      body [
        {
          value {
            conditional {
              then [
                {
                  let "taken"
                  value {
                    call {
                      procedure {
                        ref "then"
                      }
                    }
                  }
                }
                {
                  value {
                    return {
                      ref "taken"
                    }
                  }
                }
              ]
              when {
                ref "condition"
              }
            }
          }
        }
        {
          let "left"
          value {
            call {
              procedure {
                ref "else"
              }
            }
          }
        }
      ]
      const true
      description "The value one of two sides that may fail answers, chosen by a truth."
      failing "anything"
      isolated true
      parameters [
        {
          name "condition"
          type "Bool"
        }
        {
          name "then"
          type "const isolated () throws -> some Answer"
        }
        {
          name "else"
          type "const isolated () throws -> some Answer"
        }
      ]
      result {
        ref "left"
      }
      returns "some Answer"
    }
  }
  warp 1
}
